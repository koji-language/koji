{
    "name": "koji",
    "displayName": "Koji",
    "description": "Syntax highlighting for the Koji programming language",
    "version": "0.1.0",
    "publisher": "koji-language",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/koji-language/koji"
    },
    "engines": {
        "vscode": "^1.60.0"
    },
    "categories": ["Programming Languages"],
    "contributes": {
        "languages": [
            {
                "id": "koji",
                "aliases": ["Koji", "koji"],
                "extensions": [".kj"],
                "configuration": "./language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "koji",
                "scopeName": "source.koji",
                "path": "./syntaxes/koji.tmLanguage.json"
            }
        ]
    }
}
