type Product = {
    id: int
    name: string
    price: decimal
}

type Dictionary = Map[string, string]

function describe(product: Product): string {
    return `${product.name} (${product.id}) - ${product.price}`
}

immut translations: Dictionary = [

    'hello': 'olá',
    'world': 'mundo'
]

print(describe({ id: 1, name: 'Pen', price: 2.5 }))
print(translations['hello'])

immut label: string = match (translations.length()) {
    0 => 'empty'
    n if (n < 3) => 'small'
    _ => 'large'
}

print(label)
