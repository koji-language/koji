// The `cli` module: the arguments of a program of the command line, read as its options and
// arguments declare them, with the help made from them (see doc/standard-library/cli.md).
//
//     immut command = cli.command('greet', 'Greets someone.')
//         .flag('-l, --loud', 'Shout the greeting')
//         .option('-t, --times <n>', 'How many times', '1')
//         .argument('<name>', 'Who to greet')
//     immut parsed = cli.parse(command)
//
// A declaration is written as a help shows it: `-l, --loud` (a flag), `-t, --times <n>` (an option
// with a value), `<name>` (an argument), `[name]` (one that may be left out), `<names...>` (the
// arguments left, at least one; `[names...]`, any).

import system

// What kind of value a declaration takes.
type Kind = {
    Flag
    Text
    Number
}

type Declared = {
    long: string
    short: string
    placeholder: string
    help: string
    kind: Kind
    fallback: string
}

type Positional = {
    name: string
    help: string
    required: boolean
    many: boolean
}

// A command: its options, its arguments and its subcommands.
export opaque type Command = {
    name: string
    description: string
    versionText: string
    options: Declared[]
    positionals: Positional[]
    subcommands: Command[]
}

// What the arguments of a command were: the values of its options and arguments, and the
// subcommand chosen.
export opaque type Parsed = {
    commandName: string
    flags: Set[string]
    values: Map[string, string]
    lists: Map[string, string[]]
    declared: Command
}

// Why the arguments were not read: `--help` or `--version` (the text to show), or a mistake.
export type CliError = {
    Help(text: string)
    Version(text: string)
    Invalid(message: string)
}

function CliError.display(self): string {
    return match (self) {
        Help(text) => text
        Version(text) => text
        Invalid(message) => message
    }
}

// A command named `name` (the name of the program, or of a subcommand), described in its help.
export function command(name: string, description: string): Command {
    return { name: name, description: description, versionText: '', options: [], positionals: [], subcommands: [] }
}

// `-l, --loud`: an option without a value, true when it is given.
function Command.flag(self, spec: string, help: string): Command {
    return self.declare(spec, help, Flag, '')
}

// `-o, --output <file>`: an option with a value, `fallback` when it is not given ('' for none).
function Command.option(self, spec: string, help: string, fallback: string): Command {
    return self.declare(spec, help, Text, fallback)
}

// `-n, --times <n>`: an option whose value is an int, `fallback` when it is not given.
function Command.number(self, spec: string, help: string, fallback: int): Command {
    return self.declare(spec, help, Number, `${fallback}`)
}

// `<name>`, `[name]`, `<names...>` or `[names...]`: an argument, in the order declared.
function Command.argument(self, spec: string, help: string): Command {
    immut required = spec.startsWith('<') and spec.endsWith('>')
    immut optional = spec.startsWith('[') and spec.endsWith(']')

    if (not required and not optional) { panic(`'${spec}' is not an argument: write '<name>', '[name]', '<names...>' or '[names...]'`) }

    mut name = spec[1..spec.length() - 1]
    immut many = name.endsWith('...')

    if (many) { name = name[..name.length() - 3] }

    if (name == '' or not isName(name)) { panic(`'${spec}' is not an argument: its name is letters, digits, '-' and '_'`) }

    for each in self.positionals {
        if (each.many) { panic(`'${spec}' comes after '${each.name}...', which takes the arguments left`) }

        if (not each.required and required) { panic(`'${spec}' is required, so it cannot come after '[${each.name}]'`) }
    }

    mut changed = self
    changed.positionals.push({ name: name, help: help, required: required, many: many })
    return changed
}

// A subcommand (`git add`): its own options and arguments, after its name.
function Command.subcommand(self, sub: Command): Command {
    mut changed = self
    changed.subcommands.push(sub)
    return changed
}

// The version that `--version` shows.
function Command.version(self, version: string): Command {
    mut changed = self
    changed.versionText = version
    return changed
}

function Command.declare(self, spec: string, help: string, kind: Kind, fallback: string): Command {
    mut long = ''
    mut short = ''
    mut placeholder = ''

    for part in spec.split(' ') {
        immut word = part.trim().replace(',', '')

        if (word == '') { continue }

        if (word.startsWith('--') and word.length() > 2 and isName(word[2..])) {
            long = word[2..]
            continue
        }

        if (word.startsWith('-') and word.length() == 2 and isName(word[1..])) {
            short = word[1..]
            continue
        }

        if (word.startsWith('<') and word.endsWith('>') and word.length() > 2) {
            placeholder = word
            continue
        }

        panic(`'${spec}' is not an option: write '-l, --loud' for a flag, '-t, --times <n>' for an option with a value`)
    }

    if (long == '') { panic(`'${spec}' has no long name ('--name')`) }

    if (kind == Flag and placeholder != '') { panic(`'${spec}' is a flag: it has no value ('${placeholder}')`) }

    if (kind != Flag and placeholder == '') { panic(`'${spec}' takes a value: write it after the name ('--${long} <value>')`) }

    for each in self.options {
        if (each.long == long or (short != '' and each.short == short)) { panic(`'${spec}' is declared twice`) }
    }

    if (long == 'help' or short == 'h' or long == 'version') { panic(`'${spec}': --help, -h and --version are made by the module`) }

    mut changed = self
    changed.options.push({ long: long, short: short, placeholder: placeholder, help: help, kind: kind, fallback: fallback })
    return changed
}

function isName(text: string): boolean {
    for c in text {
        immut letter = (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z') or (c >= '0' and c <= '9')

        if (not (letter or c == '-' or c == '_')) { return false }
    }

    return text != ''
}

// Reading

// The arguments of the program, read as `command` declares them. `--help` shows the help and
// `--version` the version, and the program ends; a mistake is shown with how to get the help, and
// the program ends with the code 2.
export function parse(command: Command): Parsed {
    return match (parseArgs(command, system.args())) {
        Ok(parsed) => parsed
        Err(Help(text)) => {
            print(text)
            system.exit(0)
        }
        Err(Version(text)) => {
            print(text)
            system.exit(0)
        }
        Err(Invalid(message)) => {
            printError(message)
            system.exit(2)
        }
    }
}

// The arguments given (without the name of the program), read as `command` declares them.
export function parseArgs(command: Command, args: string[]): Result[Parsed, CliError] {
    mut parsed: Parsed = { commandName: '', flags: Set.from([]), values: [:], lists: [:], declared: command }
    readInto(command, command.name, args, mut parsed)?
    return Ok(parsed)
}

function readInto(command: Command, path: string, args: string[], mut parsed: Parsed): Result[void, CliError] {
    mut positionals: string[] = []
    mut onlyArguments = false
    mut i = 0

    while (i < args.length()) {
        immut arg = args[i]
        i += 1

        if (onlyArguments or arg == '-' or not arg.startsWith('-')) {
            // The first argument may be a subcommand, which reads the rest.
            if (positionals.length() == 0 and command.subcommands.length() > 0 and not onlyArguments) {
                immut sub = match (subcommandNamed(command, arg)) {
                    Some(found) => found
                    None => return Err(Invalid(mistake(path, `unknown command '${arg}'${suggestion(arg, subcommandNames(command))}`)))
                }
                parsed.commandName = if (parsed.commandName == '') { sub.name } else { `${parsed.commandName} ${sub.name}` }
                readInto(sub, `${path} ${sub.name}`, args[i..], mut parsed)?
                setDefaults(command, mut parsed)
                return Ok()
            }

            positionals.push(arg)
            continue
        }

        if (arg == '--') {
            onlyArguments = true
            continue
        }

        if (arg == '--help' or arg == '-h') { return Err(Help(helpOf(command, path))) }

        if (arg == '--version' and command.versionText != '') { return Err(Version(`${path} ${command.versionText}`)) }

        // `--name`, `--name=value`, `--name value`.
        if (arg.startsWith('--')) {
            immut equals = match (arg.indexOf('=')) {
                Some(at) => at
                None => arg.length()
            }
            immut long = arg[2..equals]
            immut option = match (optionLong(command, long)) {
                Some(found) => found
                None => return Err(Invalid(mistake(path, `unknown option '--${long}'${suggestion('--' + long, optionNames(command))}`)))
            }

            if (option.kind == Flag) {
                if (equals < arg.length()) { return Err(Invalid(mistake(path, `'--${long}' takes no value`))) }

                parsed.flags.add(option.long)
                continue
            }

            mut value = ''

            if (equals < arg.length()) {
                value = arg[equals + 1..]
            } else {
                if (i >= args.length()) { return Err(Invalid(mistake(path, `'--${long}' needs a value (${option.placeholder})`))) }

                value = args[i]
                i += 1
            }

            store(option, value, path, mut parsed)?
            continue
        }

        // `-l`, `-lv` (flags together), `-t 3`, `-t3`.
        mut at = 1

        while (at < arg.length()) {
            immut short = arg[at..at + 1]
            at += 1
            immut option = match (optionShort(command, short)) {
                Some(found) => found
                None => return Err(Invalid(mistake(path, `unknown option '-${short}'${suggestion('-' + short, optionNames(command))}`)))
            }

            if (option.kind == Flag) {
                parsed.flags.add(option.long)
                continue
            }

            mut value = arg[at..]
            at = arg.length()

            if (value == '') {
                if (i >= args.length()) { return Err(Invalid(mistake(path, `'-${short}' needs a value (${option.placeholder})`))) }

                value = args[i]
                i += 1
            }

            store(option, value, path, mut parsed)?
        }
    }

    // The arguments, in order: the last may take those left.
    mut next = 0

    for each in command.positionals {
        if (each.many) {
            immut rest = positionals[minOf(next, positionals.length())..]

            if (each.required and rest.length() == 0) { return Err(Invalid(mistake(path, `missing <${each.name}...>`))) }

            parsed.lists[each.name] = rest
            next = positionals.length()
            continue
        }

        if (next < positionals.length()) {
            parsed.values[each.name] = positionals[next]
            next += 1
            continue
        }

        if (each.required) { return Err(Invalid(mistake(path, `missing <${each.name}>`))) }
    }

    if (next < positionals.length()) {
        immut extra = positionals[next]
        return Err(Invalid(mistake(path, `unexpected argument '${extra}'`)))
    }

    if (command.subcommands.length() > 0 and parsed.commandName == '' and command.positionals.length() == 0) {
        return Err(Invalid(mistake(path, `a command is needed: ${subcommandNames(command).join(', ')}`)))
    }

    setDefaults(command, mut parsed)
    return Ok()
}

function minOf(a: int, b: int): int {
    if (a < b) { return a }

    return b
}

// The value of an option, checked for its kind.
function store(option: Declared, value: string, path: string, mut parsed: Parsed): Result[void, CliError] {
    if (option.kind == Number) {
        match (int(value)) {
            Ok(_) => {}
            Err(_) => return Err(Invalid(mistake(path, `'--${option.long}' needs an integer, found '${value}'`)))
        }
    }

    parsed.values[option.long] = value
    return Ok()
}

// The options not given take their fallbacks.
function setDefaults(command: Command, mut parsed: Parsed) {
    for each in command.options {
        if (each.kind != Flag and not parsed.values.has(each.long)) { parsed.values[each.long] = each.fallback }
    }

    for each in command.positionals {
        if (each.many and not parsed.lists.has(each.name)) { parsed.lists[each.name] = [] }

        if (not each.many and not parsed.values.has(each.name)) { parsed.values[each.name] = '' }
    }
}

function optionLong(command: Command, long: string): Option[Declared] {
    for each in command.options {
        if (each.long == long) { return Some(each) }
    }

    return None
}

function optionShort(command: Command, short: string): Option[Declared] {
    for each in command.options {
        if (each.short == short) { return Some(each) }
    }

    return None
}

function subcommandNamed(command: Command, name: string): Option[Command] {
    for each in command.subcommands {
        if (each.name == name) { return Some(each) }
    }

    return None
}

function optionNames(command: Command): string[] {
    mut names = ['--help']

    for each in command.options {
        names.push(`--${each.long}`)
    }

    if (command.versionText != '') { names.push('--version') }

    return names
}

function subcommandNames(command: Command): string[] {
    mut names: string[] = []

    for each in command.subcommands {
        names.push(each.name)
    }

    return names
}

// A mistake, with how to get the help.
function mistake(path: string, message: string): string {
    return `${path}: ${message}\nRun '${path} --help' for help.`
}

// ` (did you mean '--loud'?)` when a name is close to what was written.
function suggestion(written: string, names: string[]): string {
    mut best = ''
    mut bestDistance = 3

    for name in names {
        immut distance = editDistance(written, name)

        if (distance < bestDistance) {
            best = name
            bestDistance = distance
        }
    }

    if (best == '') { return '' }

    return ` (did you mean '${best}'?)`
}

// The edits (a character added, removed or changed) from one text to the other.
function editDistance(a: string, b: string): int {
    immut first = a.chars()
    immut second = b.chars()
    mut previous: int[] = []

    for j in range(second.length() + 1) {
        previous.push(j)
    }

    for i in range(1, first.length() + 1) {
        mut current = [i]

        for j in range(1, second.length() + 1) {
            immut cost = if (first[i - 1] == second[j - 1]) { 0 } else { 1 }
            current.push(minOf(minOf(previous[j] + 1, current[j - 1] + 1), previous[j - 1] + cost))
        }

        previous = current
    }

    return previous[second.length()]
}

// The help

function helpOf(command: Command, path: string): string {
    mut usage = `Usage: ${path} [options]`

    if (command.subcommands.length() > 0) { usage += ' <command>' }

    for each in command.positionals {
        immut dots = if (each.many) { '...' } else { '' }
        usage += if (each.required) { ` <${each.name}${dots}>` } else { ` [${each.name}${dots}]` }
    }

    mut text = ''

    if (command.description != '') { text += `${command.description}\n\n` }

    text += `${usage}\n`
    mut rows: string[][] = []

    if (command.positionals.length() > 0) {
        for each in command.positionals {
            immut dots = if (each.many) { '...' } else { '' }
            immut written = if (each.required) { `<${each.name}${dots}>` } else { `[${each.name}${dots}]` }
            rows.push([written, each.help])
        }
    }

    mut commands: string[][] = []

    for each in command.subcommands {
        commands.push([each.name, firstLine(each.description)])
    }

    mut options: string[][] = []

    for each in command.options {
        immut short = if (each.short != '') { `-${each.short}, ` } else { '    ' }
        immut value = if (each.placeholder != '') { ` ${each.placeholder}` } else { '' }
        immut fallback = if (each.kind != Flag and each.fallback != '') { ` (default: ${each.fallback})` } else { '' }
        options.push([`${short}--${each.long}${value}`, `${each.help}${fallback}`])
    }

    options.push(['-h, --help', 'Show this help'])

    if (command.versionText != '') { options.push(['    --version', 'Show the version']) }

    // The descriptions in one column.
    mut width = 0

    for row in rows + commands + options {
        if (row[0].length() > width) { width = row[0].length() }
    }

    if (rows.length() > 0) { text += `\nArguments:\n${table(rows, width)}` }

    if (commands.length() > 0) { text += `\nCommands:\n${table(commands, width)}` }

    text += `\nOptions:\n${table(options, width)}`
    return text.trim()
}

function table(rows: string[][], width: int): string {
    mut text = ''

    for row in rows {
        mut line = `  ${row[0]}`

        if (row[1] != '') {
            while (line.length() < width + 4) {
                line += ' '
            }

            line += row[1]
        }

        text += `${line}\n`
    }

    return text
}

function firstLine(text: string): string {
    return match (text.indexOf('\n')) {
        Some(at) => text[..at]
        None => text
    }
}

// The values

// Whether the flag `name` (its long name) was given.
function Parsed.flag(self, name: string): boolean {
    self.check(name, 'flag')
    return self.flags.has(name)
}

// The value of the option or argument `name`: what was given, or its fallback ('' for an argument
// left out).
function Parsed.value(self, name: string): string {
    return match (self.values.get(name)) {
        Some(found) => found
        None => panic(`'${name}' is not an option nor an argument of the command`)
    }
}

// The value of an option declared with `number`.
function Parsed.number(self, name: string): int {
    self.check(name, 'number')
    return match (int(self.value(name))) {
        Ok(found) => found
        Err(_) => panic(`the fallback of '--${name}' is not an integer`)
    }
}

// The arguments of `<names...>` or `[names...]`.
function Parsed.list(self, name: string): string[] {
    return match (self.lists.get(name)) {
        Some(found) => found
        None => panic(`'${name}' is not an argument '<${name}...>' of the command`)
    }
}

// The subcommand chosen ('' for none; `remote add` for one inside another).
function Parsed.command(self): string {
    return self.commandName
}

// Whether `name` is declared as a flag (or a number) in the command or its subcommands.
function Parsed.check(self, name: string, kind: string) {
    if (not declaresKind(self.declared, name, kind)) { panic(`'${name}' is not a ${kind} of the command`) }
}

function declaresKind(command: Command, name: string, kind: string): boolean {
    for each in command.options {
        if (each.long == name) {
            return match (each.kind) {
                Flag => kind == 'flag'
                Number => kind == 'number'
                Text => false
            }
        }
    }

    for sub in command.subcommands {
        if (declaresKind(sub, name, kind)) { return true }
    }

    return false
}
