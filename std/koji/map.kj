// `koji:map`: maps and sets, in the library of the runtime written in Koji (C calls these functions
// by their names). The entries keep the order in which their keys were added, and a table of
// positions finds a key by its hash (open addressing, at most half full); a set is a map without
// values. Like lists, two variables share a map until one of them changes it.
//
// A map is a block of 9 words: its count of references (first, as the prelude counts them), the
// types of its keys and of its values (none for a set), the address of its entries, their number
// (fifth, as the prelude reads it), the entries the block holds, the address of the table, the
// slots it has (a power of two, or none) and 64 less their bits (the shift of `startOf`). An entry is 5 words: the key and the value in two words
// each (a decimal takes both), and the hash of the key, so that the table is built again without
// hashing the keys. A slot of the table is the position of an entry plus one, or 0 for none.

import { Address, CInt, CSize, Location, Never, U128, distance, isNull, lowWord, nullAddress, offset, panicAt, read, wide, wordProduct, write } from 'koji:unsafe'
import { newList } from 'koji:list'

extern function koji_memory_take(words: int): Address
extern function koji_memory_give(block: Address, words: int)
extern function koji_memory_resize(block: Address, words: int, newWords: int): Address
extern function koji_element_size(element: Address): int
extern function koji_element_counted(element: Address): boolean
extern function koji_element_retain(element: Address, slot: Address)
extern function koji_element_release(element: Address, slot: Address)
extern function koji_element_repr(element: Address, slot: Address): string
extern function koji_element_equal(element: Address, a: Address, b: Address): boolean
extern function koji_element_hash(element: Address, slot: Address): int
extern function memcpy(target: Address, source: Address, size: CSize): Address
extern function memmove(target: Address, source: Address, size: CSize): Address
extern function memset(target: Address, value: CInt, size: CSize): Address

immut mapWords = 9
immut entryWords = 5
// A large odd number: the high bits of a hash times it depend on all the bits of the hash (an int
// is its own hash).
// (0x9E3779B97F4A7C15, written as the int of the same bits.)
immut spread = -0x61C8864680B583EB

function keyType(map: Address): Address {
    immut element: Address = read(map, 8)
    return element
}

function valueType(map: Address): Address {
    immut element: Address = read(map, 16)
    return element
}

function entriesOf(map: Address): Address {
    immut entries: Address = read(map, 24)
    return entries
}

function countOf(map: Address): int {
    immut count: int = read(map, 32)
    return count
}

function tableOf(map: Address): Address {
    immut table: Address = read(map, 48)
    return table
}

function slotsOf(map: Address): int {
    immut slots: int = read(map, 56)
    return slots
}

// The key of the entry `index`; its value is 16 bytes further, and its hash 32.
function entryAt(map: Address, index: int): Address {
    return offset(entriesOf(map), index * entryWords * 8)
}

function hashAt(map: Address, index: int): int {
    immut hash: int = read(entryAt(map, index), 32)
    return hash
}

function newMap(key: Address, value: Address): Address {
    immut map = koji_memory_take(mapWords)
    write(map, 0, 1)
    write(map, 8, key)
    write(map, 16, value)
    write(map, 24, nullAddress())
    write(map, 32, 0)
    write(map, 40, 0)
    write(map, 48, nullAddress())
    write(map, 56, 0)
    write(map, 64, 0)
    return map
}

// Adds a reference to the key and the value of an entry.
function retainEntry(map: Address, index: int) {
    immut entry = entryAt(map, index)
    koji_element_retain(keyType(map), entry)

    if (not isNull(valueType(map))) { koji_element_retain(valueType(map), offset(entry, 16)) }
}

function releaseEntry(map: Address, index: int) {
    immut entry = entryAt(map, index)
    koji_element_release(keyType(map), entry)

    if (not isNull(valueType(map))) { koji_element_release(valueType(map), offset(entry, 16)) }
}

// A copy of `block` (`words` of them), or none.
function copyBlock(block: Address, words: int): Address {
    if (words == 0) { return nullAddress() }

    immut copy = koji_memory_take(words)
    memcpy(copy, block, words * 8)
    return copy
}

// The map in `variable`, made its own (copied when another variable shares it).
function unshared(variable: Address): Address {
    immut map: Address = read(variable, 0)
    immut references: int = read(map, 0)

    if (references == 1) { return map }

    immut count = countOf(map)
    immut copy = newMap(keyType(map), valueType(map))
    write(copy, 24, copyBlock(entriesOf(map), count * entryWords))
    write(copy, 32, count)
    write(copy, 40, count)
    write(copy, 48, copyBlock(tableOf(map), slotsOf(map)))
    write(copy, 56, slotsOf(map))
    write(copy, 64, shiftOf(map))
    mut index = 0

    while (index < count) {
        retainEntry(copy, index)
        index += 1
    }

    write(map, 0, references - 1)
    write(variable, 0, copy)
    return copy
}

function shiftOf(map: Address): int {
    immut shift: int = read(map, 64)
    return shift
}

// The first slot of the table to look at for `hash`: the high bits of the hash times `spread`.
function startOf(hash: int, shift: int, slots: int): int {
    immut product = lowWord(wordProduct(wide(hash, 0), wide(spread, 0)))
    return (product >> shift) & (slots - 1)
}

// The position of the entry of `key`, or -1.
function find(map: Address, key: Address, hash: int): int {
    immut slots = slotsOf(map)

    if (slots == 0) { return -1 }

    immut table = tableOf(map)
    immut element = keyType(map)
    immut entries = entriesOf(map)
    mut slot = startOf(hash, shiftOf(map), slots)

    while (true) {
        immut position: int = read(table, slot * 8)

        if (position == 0) { return -1 }

        immut entry = offset(entries, (position - 1) * entryWords * 8)
        immut found: int = read(entry, 32)

        if (found == hash and koji_element_equal(element, entry, key)) { return position - 1 }

        slot = (slot + 1) & (slots - 1)
    }

    return -1
}

function positionOf(map: Address, key: Address): int {
    return find(map, key, koji_element_hash(keyType(map), key))
}

// Puts the entry `index` in the table, which has room for it.
function place(map: Address, index: int) {
    immut slots = slotsOf(map)
    immut table = tableOf(map)
    mut slot = startOf(hashAt(map, index), shiftOf(map), slots)

    while (true) {
        immut position: int = read(table, slot * 8)

        if (position == 0) { break }

        slot = (slot + 1) & (slots - 1)
    }

    write(table, slot * 8, index + 1)
}

// The table again, at least twice as large as the entries (8 slots at least).
function rebuild(map: Address) {
    immut count = countOf(map)
    mut slots = 8
    mut shift = 61

    while (slots < count * 2) {
        slots = slots * 2
        shift -= 1
    }

    // The same block when it has the same size (after a removal).
    mut table = tableOf(map)

    if (slotsOf(map) != slots) {
        if (slotsOf(map) > 0) { koji_memory_give(table, slotsOf(map)) }

        table = koji_memory_take(slots)
    }

    memset(table, 0, slots * 8)
    write(map, 48, table)
    write(map, 56, slots)
    write(map, 64, shift)
    immut entries = entriesOf(map)
    immut mask = slots - 1
    mut index = 0

    while (index < count) {
        immut hash: int = read(entries, index * (entryWords * 8) + 32)
        mut slot = startOf(hash, shift, slots)

        while (true) {
            immut position: int = read(table, slot * 8)

            if (position == 0) { break }

            slot = (slot + 1) & mask
        }

        write(table, slot * 8, index + 1)
        index += 1
    }
}

// Puts a value of the generated code at `value` (its bytes, the rest of the two words 0) at
// `slot`.
function putValue(slot: Address, value: Address, element: Address) {
    write(slot, 0, 0)
    write(slot, 8, 0)
    memcpy(slot, value, koji_element_size(element))
}

// Adds an entry, whose key is not in the map (the entries grow as Rust's vectors grow).
function add(map: Address, key: Address, value: Address, hash: int) {
    immut count = countOf(map)
    immut capacity: int = read(map, 40)

    if (count == capacity) {
        immut grown = if (capacity == 0) { 4 } else { capacity * 2 }
        write(map, 24, if (capacity == 0) { koji_memory_take(grown * entryWords) } else { koji_memory_resize(entriesOf(map), capacity * entryWords, grown * entryWords) })
        write(map, 40, grown)
    }

    immut entry = entryAt(map, count)
    putValue(entry, key, keyType(map))

    if (isNull(valueType(map))) {
        write(entry, 16, 0)
        write(entry, 24, 0)
    } else {
        putValue(offset(entry, 16), value, valueType(map))
    }

    write(entry, 32, hash)
    write(map, 32, count + 1)

    if ((count + 1) * 2 > slotsOf(map)) {
        rebuild(map)
    } else {
        place(map, count)
    }

    retainEntry(map, count)
}

function missing(map: Address, key: Address, here: Location): Never {
    panicAt(here, `key ${koji_element_repr(keyType(map), key)} not found`)
}

// A new empty map (`value` is none for a set).
extern function koji_map_new(key: Address, value: Address): Address {
    return newMap(key, value)
}

// Releases the entries of a map without references and frees it.
extern function koji_map_free(map: Address) {
    immut count = countOf(map)
    mut index = 0

    if (koji_element_counted(keyType(map)) or (not isNull(valueType(map)) and koji_element_counted(valueType(map)))) {
        while (index < count) {
            releaseEntry(map, index)
            index += 1
        }
    }

    immut capacity: int = read(map, 40)

    if (capacity > 0) { koji_memory_give(entriesOf(map), capacity * entryWords) }

    if (slotsOf(map) > 0) { koji_memory_give(tableOf(map), slotsOf(map)) }

    koji_memory_give(map, mapWords)
}

// `map[key]`: the slot of the value (a panic when the key is missing).
extern function koji_map_get(map: Address, key: Address, here: Location): Address {
    immut index = positionOf(map, key)

    if (index < 0) { missing(map, key, here) }

    return offset(entryAt(map, index), 16)
}

// The slot of the value of `key`, or none (`map.get(key)`).
extern function koji_map_find(map: Address, key: Address): Address {
    immut index = positionOf(map, key)

    if (index < 0) { return nullAddress() }

    return offset(entryAt(map, index), 16)
}

// `key in map`, `set.has(item)`.
extern function koji_map_contains(map: Address, key: Address): boolean {
    return positionOf(map, key) >= 0
}

// The slot of the value of `key`, to change it in place (`groups['a'].push(1)`).
extern function koji_map_slot(variable: Address, key: Address, here: Location): Address {
    immut map = unshared(variable)
    immut index = positionOf(map, key)

    if (index < 0) { missing(map, key, here) }

    return offset(entryAt(map, index), 16)
}

// `map[key] = value` (adds or replaces), or `set.add(item)` with no value.
extern function koji_map_set(variable: Address, key: Address, value: Address) {
    immut map = unshared(variable)
    immut hash = koji_element_hash(keyType(map), key)
    immut index = find(map, key, hash)

    if (index < 0) {
        add(map, key, value, hash)
        return
    }

    immut element = valueType(map)

    if (isNull(element)) { return }

    immut slot = offset(entryAt(map, index), 16)
    koji_element_release(element, slot)
    putValue(slot, value, element)
    koji_element_retain(element, slot)
}

// `map.remove(key)`: copies the value to `out` (the caller now holds it), or false when the key is
// missing. For a set, `out` is ignored.
extern function koji_map_remove(variable: Address, key: Address, out: Address): boolean {
    immut map = unshared(variable)
    immut index = positionOf(map, key)

    if (index < 0) { return false }

    immut entry = entryAt(map, index)
    koji_element_release(keyType(map), entry)

    if (not isNull(valueType(map))) { memcpy(out, offset(entry, 16), koji_element_size(valueType(map))) }

    immut count = countOf(map)
    unplace(map, index)
    memmove(entry, offset(entry, entryWords * 8), (count - index - 1) * entryWords * 8)
    write(map, 32, count - 1)
    return true
}

// Takes the entry `index` out of the table: the entries after it in its run move back so that a
// search finds them (linear probing), and the positions after `index` come down by one, as the
// entries do.
function unplace(map: Address, index: int) {
    immut slots = slotsOf(map)
    immut table = tableOf(map)
    immut shift = shiftOf(map)
    immut mask = slots - 1
    immut entries = entriesOf(map)
    mut hole = startOf(hashAt(map, index), shift, slots)

    while (true) {
        immut position: int = read(table, hole * 8)

        if (position == index + 1) { break }

        hole = (hole + 1) & mask
    }

    mut next = (hole + 1) & mask

    while (true) {
        immut position: int = read(table, next * 8)

        if (position == 0) { break }

        immut hash: int = read(entries, (position - 1) * (entryWords * 8) + 32)
        immut home = startOf(hash, shift, slots)

        // It may fill the hole when the hole is between its first slot and where it is.
        if (((next - home) & mask) >= ((next - hole) & mask)) {
            write(table, hole * 8, position)
            hole = next
        }

        next = (next + 1) & mask
    }

    write(table, hole * 8, 0)
    mut slot = 0

    while (slot < slots) {
        immut position: int = read(table, slot * 8)

        if (position > index + 1) { write(table, slot * 8, position - 1) }

        slot += 1
    }
}

// The keys (`map.keys()`, the items of a set), or the values (`map.values()`), in the order their
// keys were added.
function column(map: Address, values: boolean): Address {
    immut element = if (values) { valueType(map) } else { keyType(map) }
    immut count = countOf(map)
    immut list = newList(element, count)
    immut stride: int = read(list, 16)
    immut items: Address = read(list, 24)
    mut index = 0

    while (index < count) {
        immut slot = offset(items, index * stride * 8)
        memcpy(slot, offset(entryAt(map, index), if (values) { 16 } else { 0 }), stride * 8)
        koji_element_retain(element, slot)
        index += 1
    }

    write(list, 32, count)
    return list
}

extern function koji_map_keys(map: Address): Address {
    return column(map, false)
}

extern function koji_map_values(map: Address): Address {
    return column(map, true)
}

// `Set.from(list)`.
extern function koji_set_from_list(list: Address): Address {
    immut element: Address = read(list, 8)
    immut stride: int = read(list, 16)
    immut items: Address = read(list, 24)
    immut length: int = read(list, 32)
    immut set = newMap(element, nullAddress())
    // The variable that holds the set, which `koji_map_set` takes.
    immut variable = koji_memory_take(1)
    write(variable, 0, set)
    mut index = 0

    while (index < length) {
        koji_map_set(variable, offset(items, index * stride * 8), nullAddress())
        index += 1
    }

    immut made: Address = read(variable, 0)
    koji_memory_give(variable, 1)
    return made
}

// Maps with the same entries, in any order.
extern function koji_map_equal(a: Address, b: Address): boolean {
    if (distance(a, b) == 0) { return true }

    immut count = countOf(a)

    if (countOf(b) != count) { return false }

    immut element = valueType(a)
    mut index = 0

    while (index < count) {
        immut entry = entryAt(a, index)
        immut other = positionOf(b, entry)

        if (other < 0) { return false }

        if (not isNull(element) and not koji_element_equal(element, offset(entry, 16), offset(entryAt(b, other), 16))) { return false }

        index += 1
    }

    return true
}

// A hash that does not depend on the order of the entries: the sum of the hashes of the keys times
// 31 plus the hashes of the values, in 64 bits.
extern function koji_map_hash(map: Address): int {
    immut count = countOf(map)
    immut element = valueType(map)
    immut mask = wide(-1, 0)
    mut total: U128 = 0
    mut index = 0

    while (index < count) {
        immut entry = entryAt(map, index)
        immut valueHash = if (isNull(element)) { 0 } else { koji_element_hash(element, offset(entry, 16)) }
        total = (total + wordProduct(wide(koji_element_hash(keyType(map), entry), 0), wide(31, 0)) + wide(valueHash, 0)) & mask
        index += 1
    }

    return lowWord(total)
}

// `['Ana': 30]`, `[:]` or `Set(['a', 'b'])`.
extern function koji_map_repr(map: Address): string {
    immut count = countOf(map)
    immut element = valueType(map)

    if (isNull(element)) {
        mut text = 'Set(['
        mut index = 0

        while (index < count) {
            if (index > 0) { text += ', ' }

            text += koji_element_repr(keyType(map), entryAt(map, index))
            index += 1
        }

        return text + '])'
    }

    if (count == 0) { return '[:]' }

    mut text = '['
    mut index = 0

    while (index < count) {
        if (index > 0) { text += ', ' }

        immut entry = entryAt(map, index)
        text += koji_element_repr(keyType(map), entry)
        text += ': '
        text += koji_element_repr(element, offset(entry, 16))
        index += 1
    }

    return text + ']'
}
