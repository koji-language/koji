// `koji:core`: methods of strings written in Koji. The compiler calls the function of a method's
// name with the string first (`text.trim()` is `trim(text)`), and the `Location` of the call last
// when it may panic. Programs cannot import it. It has no top-level variables: it is never
// initialized.

import { Address, CInt, CSize, Location, U128, allocate, blankString, charOfCode, distance, free, leadingZeros, listItems, lowWord, newString, nullAddress, offset, panicAt, read, reserve, setListLength, stringBytes, stringSize, wide, wideToFloat, write } from 'koji:unsafe'

// The C library: `memcmp` compares bytes, `memmem` finds bytes among others (the address of the
// first match, or 0).
extern function memcmp(a: Address, b: Address, size: CSize): CInt
extern function memmem(haystack: Address, haystackSize: CSize, needle: Address, needleSize: CSize): Address
extern function strlen(text: Address): CSize
extern function strtod(text: Address, end: Address): float
extern function memcpy(target: Address, source: Address, size: CSize): Address
// A line of the standard input, from the library (std/koji/output.kj).
extern function koji_read_line(prompt: string, here: Location, status: Address): string
// The decimal of a text, from the library (std/koji/decimal.kj).
extern function koji_decimal_parse(text: string, status: Address): decimal

// Without the white space at both ends (as Unicode defines white space).
export function trim(text: string): string {
    immut bytes = stringBytes(text)
    immut size = stringSize(text)
    immut start = spaceEnd(bytes, 0, size)
    immut end = spaceStart(bytes, start, size)

    if (start == 0 and end == size) { return text }

    return copyBytes(bytes, start, end)
}

// The first byte from `start` that is not white space.
function spaceEnd(bytes: Address, start: int, size: int): int {
    mut at = start

    while (at < size) {
        immut b: byte = read(bytes, at)

        if (b < 0x80) {
            if (not isSpace(int(b))) { return at }

            at += 1
            continue
        }

        immut width = widthAt(bytes, at)

        if (not isSpace(codeAt(bytes, at, width))) { return at }

        at += width
    }

    return at
}

// The end of the bytes before `end` without the white space at their end, down to `start`.
function spaceStart(bytes: Address, start: int, end: int): int {
    mut at = end

    while (at > start) {
        immut b: byte = read(bytes, at - 1)

        if (b < 0x80) {
            if (not isSpace(int(b))) { return at }

            at -= 1
            continue
        }

        mut last = at - 1

        while (isContinuation(bytes, last)) {
            last -= 1
        }

        if (not isSpace(codeAt(bytes, last, at - last))) { return at }

        at = last
    }

    return at
}

// A new string of the bytes from `start` to `end` of a string (whole characters, so UTF-8).
function copyBytes(bytes: Address, start: int, end: int): string {
    immut copy = blankString(end - start, end - start)
    memcpy(stringBytes(copy), offset(bytes, start), end - start)
    return copy
}

function startsWith(text: string, prefix: string): boolean {
    immut size = stringSize(prefix)

    if (size > stringSize(text)) { return false }

    return memcmp(stringBytes(text), stringBytes(prefix), size) == 0
}

function endsWith(text: string, suffix: string): boolean {
    immut size = stringSize(suffix)
    immut start = stringSize(text) - size

    if (start < 0) { return false }

    return memcmp(offset(stringBytes(text), start), stringBytes(suffix), size) == 0
}

// The position of the first `part`, in characters (like indexing and `length()`).
function indexOf(text: string, part: string): Option[int] {
    immut bytes = stringBytes(text)
    immut found = find(text, part, 0)

    if (found < 0) { return None }

    mut characters = 0

    for i in range(found) {
        if (not isContinuation(bytes, i)) { characters += 1 }
    }

    return Some(characters)
}

// The parts of `text` between the separators.
function split(text: string, separator: string, here: Location): string[] {
    if (stringSize(separator) == 0) { panicAt(here, 'split() separator cannot be empty') }

    immut bytes = stringBytes(text)
    mut parts: string[] = []
    mut start = 0

    while (true) {
        immut found = find(text, separator, start)

        if (found < 0) { break }

        parts.push(newString(offset(bytes, start), found - start))
        start = found + stringSize(separator)
    }

    parts.push(newString(offset(bytes, start), stringSize(text) - start))
    return parts
}

// `text` with `new` in the place of each `old`.
function replace(text: string, old: string, new: string, here: Location): string {
    if (stringSize(old) == 0) { panicAt(here, 'replace() needs a non-empty text to replace') }

    mut found = find(text, old, 0)

    if (found < 0) { return text }

    immut bytes = stringBytes(text)
    mut replaced = ''
    mut start = 0

    while (found >= 0) {
        replaced += newString(offset(bytes, start), found - start)
        replaced += new
        start = found + stringSize(old)
        found = find(text, old, start)
    }

    replaced += newString(offset(bytes, start), stringSize(text) - start)
    return replaced
}

// The byte where `part` first is in `text`, from the byte `start`, or -1.
function find(text: string, part: string, start: int): int {
    immut bytes = stringBytes(text)
    immut found = memmem(offset(bytes, start), stringSize(text) - start, stringBytes(part), stringSize(part))

    // Not found: the address 0, before the bytes.
    immut position = distance(bytes, found)
    return if (position < 0) { -1 } else { position }
}

// The bytes of UTF-8 that continue a character (`10xxxxxx`).
function isContinuation(bytes: Address, at: int): boolean {
    immut b: byte = read(bytes, at)
    return (b & 0xC0) == 0x80
}

// The bytes of the character that starts at `at`.
function widthAt(bytes: Address, at: int): int {
    immut b: byte = read(bytes, at)

    if (b < 0x80) { return 1 }

    if (b < 0xE0) { return 2 }

    if (b < 0xF0) { return 3 }

    return 4
}

// The code of the character of `width` bytes at `at`.
function codeAt(bytes: Address, at: int, width: int): int {
    immut first: byte = read(bytes, at)

    if (width == 1) { return int(first) }

    mut code = int(first & (0x7F >> byte(width)))

    for i in range(1, width) {
        immut next: byte = read(bytes, at + i)
        code = (code << 6) | int(next & 0x3F)
    }

    return code
}

// White space, as Unicode defines it (`White_Space`).
function isSpace(code: int): boolean {
    if (code <= 0x20) { return code == 0x20 or (code >= 0x09 and code <= 0x0D) }

    if (code < 0x85) { return false }

    if (code < 0x1680) { return code == 0x85 or code == 0xA0 }

    if (code >= 0x2000 and code <= 0x200A) { return true }

    return code == 0x1680 or code == 0x2028 or code == 0x2029 or code == 0x202F or code == 0x205F or code == 0x3000
}

// A string of bytes that may not be UTF-8 (from the system): each invalid sequence becomes
// U+FFFD, as long as the longest start of a valid one (as Unicode recommends).
export function textOf(bytes: Address, size: int): string {
    mut out = ''
    mut start = 0
    mut at = 0

    while (at < size) {
        immut valid = validAt(bytes, at, size)

        if (valid > 0) {
            at += valid
            continue
        }

        // `-valid` bytes are not a character.
        if (at > start) { out += newString(offset(bytes, start), at - start) }

        out += '�'
        at -= valid
        start = at
    }

    if (start == 0) { return newString(bytes, size) }

    if (at > start) { out += newString(offset(bytes, start), at - start) }

    return out
}

// Whether the bytes are UTF-8.
export function isUtf8(bytes: Address, size: int): boolean {
    mut at = 0

    while (at < size) {
        immut valid = validAt(bytes, at, size)

        if (valid < 0) { return false }

        at += valid
    }

    return true
}

// The bytes of the valid character at `at`, or minus those of the longest start of one there
// (at least one byte).
function validAt(bytes: Address, at: int, size: int): int {
    immut first = byteAt(bytes, at, size)

    if (first < 0x80) { return 1 }

    // The second byte, with its range for the first one (no overlong forms, no surrogates, nothing
    // beyond U+10FFFF).
    mut width = 0
    mut low = 0x80
    mut high = 0xBF

    if (first >= 0xC2 and first <= 0xDF) { width = 2 }

    if (first >= 0xE0 and first <= 0xEF) { width = 3 }

    if (first >= 0xF0 and first <= 0xF4) { width = 4 }

    if (width == 0) { return -1 }

    if (first == 0xE0) { low = 0xA0 }

    if (first == 0xED) { high = 0x9F }

    if (first == 0xF0) { low = 0x90 }

    if (first == 0xF4) { high = 0x8F }

    immut second = byteAt(bytes, at + 1, size)

    if (second < low or second > high) { return -1 }

    for i in range(2, width) {
        immut next = byteAt(bytes, at + i, size)

        if (next < 0x80 or next > 0xBF) { return -i }
    }

    return width
}

// The byte at `at`, or -1 past the end.
function byteAt(bytes: Address, at: int, size: int): int {
    if (at >= size) { return -1 }

    immut b: byte = read(bytes, at)
    return int(b)
}

// For the modules that call the C library.

// A copy of `text` as a string of C, to free (`text` has no NUL: see `hasNul`).
export function cString(text: string): Address {
    immut size = stringSize(text)
    immut copy = allocate(size + 1)
    immut bytes = stringBytes(text)

    for i in range(size) {
        immut b: byte = read(bytes, i)
        write(copy, i, b)
    }

    immut end: byte = 0
    write(copy, size, end)
    return copy
}

// A string of C, as text (invalid UTF-8 becomes U+FFFD).
export function cText(address: Address): string {
    return textOf(address, strlen(address))
}

// Whether `text` has a NUL, which a string of C cannot hold.
export function hasNul(text: string): boolean {
    immut bytes = stringBytes(text)

    for i in range(stringSize(text)) {
        if (byteAt(bytes, i, stringSize(text)) == 0) { return true }
    }

    return false
}

// The characters of a string (`text.chars()`, and `for c in text`).
function chars(text: string): char[] {
    immut bytes = stringBytes(text)
    immut size = stringSize(text)
    mut found: char[] = []
    // A character per byte at most (exact for ASCII), written in place: a word each.
    reserve(found, size)
    mut slot = listItems(found)
    mut count = 0
    mut at = 0

    while (at < size) {
        immut first: byte = read(bytes, at)

        if (first < 0x80) {
            write(slot, 0, int(first))
            at += 1
        } else {
            immut width = widthAt(bytes, at)
            write(slot, 0, codeAt(bytes, at, width))
            at += width
        }

        slot = offset(slot, 8)
        count += 1
    }

    setListLength(found, count)
    return found
}

// `char(code)`: the character with that code, or `None` (above U+10FFFF, or a surrogate).
function charOf(code: int): Option[char] {
    if (code < 0 or code > 0x10FFFF or (code >= 0xD800 and code <= 0xDFFF)) { return None }

    return Some(charOfCode(code))
}

// The numbers of text (`int(text)`, `float(text)`, `decimal(text)`), with white space around.

// An optional sign, then decimal digits.
function intOf(text: string): Result[int, ParseError] {
    immut bytes = stringBytes(text)
    immut size = stringSize(text)
    immut start = spaceEnd(bytes, 0, size)
    immut end = spaceStart(bytes, start, size)
    mut at = start
    mut negative = false

    if (at < end) {
        immut sign: byte = read(bytes, at)

        if (sign == 43 or sign == 45) {
            negative = sign == 45
            at += 1
        }
    }

    if (at == end) { return Err(InvalidNumber(text)) }

    // The digits, while they fit (up to 2^63, for the most negative int).
    mut value = 0
    mut overflow = false
    immut lastDigit = if (negative) { 8 } else { 7 }

    while (at < end) {
        immut b: byte = read(bytes, at)

        if (b < 48 or b > 57) { return Err(InvalidNumber(text)) }

        immut digit = int(b) - 48

        if (value < -922337203685477580 or (value == -922337203685477580 and digit > lastDigit)) { overflow = true }

        if (not overflow) {
            // Negative while it is built, so that -2^63 fits.
            value = value * 10 - digit
        }

        at += 1
    }

    if (overflow) { return Err(OutOfRange(text)) }

    return Ok(if (negative) { value } else { -value })
}

// Decimal notation (as Rust reads floats; no `nan` or `inf`), or hexadecimal after `0x`.
function floatOf(text: string): Result[float, ParseError] {
    immut bytes = stringBytes(text)
    immut size = stringSize(text)
    immut start = spaceEnd(bytes, 0, size)
    immut end = spaceStart(bytes, start, size)
    mut first = start

    while (first < end and (byteAt(bytes, first, end) == 43 or byteAt(bytes, first, end) == 45)) {
        first += 1
    }

    if (byteAt(bytes, first, end) == 48 and byteAt(bytes, first + 1, end) == 120) {
        mut code = 0
        // The trimmed text is an argument, which lives while it is read.
        immut value = hexFloat(copyBytes(bytes, start, end), mut code)

        if (code == 1) { return Err(InvalidNumber(text)) }

        if (code == 2) { return Err(OutOfRange(text)) }

        return Ok(value)
    }

    mut value = float(0)
    immut status = decimalFloat(bytes, start, end, mut value)

    if (status == 1) { return Err(InvalidNumber(text)) }

    if (status == 2) { return Err(OutOfRange(text)) }

    return Ok(value)
}

// The float of the bytes from `start` to `end` in decimal notation: 0, or 1 when they are not in
// it, or 2 when it is beyond a float. Exact without `strtod` when the digits fit in 2^53 and the
// power of 10 is a float too (Clinger's fast path).
function decimalFloat(bytes: Address, start: int, end: int, mut value: float): int {
    mut at = start
    mut negative = false

    if (at < end and isSign(byteAt(bytes, at, end))) {
        negative = byteAt(bytes, at, end) == 45
        at += 1
    }

    // The significant digits, while there are at most 18 of them (they fit in an int).
    mut digits = 0
    mut count = 0
    mut lost = false
    // The power of 10 of the last digit kept.
    mut scale = 0
    mut whole = 0

    while (at < end and isDigit(byteAt(bytes, at, end))) {
        keepDigit(byteAt(bytes, at, end) - 48, mut digits, mut count, mut lost, mut scale, false)
        whole += 1
        at += 1
    }

    mut fraction = 0

    if (byteAt(bytes, at, end) == 46) {
        at += 1

        while (at < end and isDigit(byteAt(bytes, at, end))) {
            keepDigit(byteAt(bytes, at, end) - 48, mut digits, mut count, mut lost, mut scale, true)
            fraction += 1
            at += 1
        }
    }

    if (whole == 0 and fraction == 0) { return 1 }

    mut power = 0

    if (byteAt(bytes, at, end) == 101 or byteAt(bytes, at, end) == 69) {
        at += 1
        mut negativePower = false

        if (at < end and isSign(byteAt(bytes, at, end))) {
            negativePower = byteAt(bytes, at, end) == 45
            at += 1
        }

        if (not (at < end and isDigit(byteAt(bytes, at, end)))) { return 1 }

        while (at < end and isDigit(byteAt(bytes, at, end))) {
            if (power < 100000) { power = power * 10 + byteAt(bytes, at, end) - 48 }

            at += 1
        }

        if (negativePower) { power = -power }
    }

    if (at != end) { return 1 }

    immut exponent = power + scale

    if (not lost and digits <= 9007199254740992 and exponent >= -22 and exponent <= 22) {
        immut mantissa = float(digits)
        immut tens = tenTo(if (exponent < 0) { -exponent } else { exponent })
        immut exact = if (exponent < 0) { mantissa / tens } else { mantissa * tens }
        value = if (negative) { -exact } else { exact }
        return 0
    }

    // `strtod` reads a string of C: a copy, with a 0 at its end.
    immut copy = allocate(end - start + 1)
    memcpy(copy, offset(bytes, start), end - start)
    immut zero: byte = 0
    write(copy, end - start, zero)
    value = strtod(copy, nullAddress())
    free(copy)
    immut largest = float(1.7976931348623157e308)

    if (value > largest or value < -largest) { return 2 }

    return 0
}

// One more digit of a decimal number: kept while there are at most 18 significant ones (and their
// power of 10 follows), or else `lost` when it is not 0.
function keepDigit(digit: int, mut digits: int, mut count: int, mut lost: boolean, mut scale: int, inFraction: boolean) {
    if (count < 18) {
        digits = digits * 10 + digit

        if (digits != 0) { count += 1 }

        if (inFraction) { scale -= 1 }

        return
    }

    if (digit != 0) { lost = true }

    if (not inFraction) { scale += 1 }
}

function isDigit(b: int): boolean {
    return b >= 48 and b <= 57
}

// 10^n, exactly, for n up to 22.
function tenTo(n: int): float {
    mut result = float(1)

    for i in range(n) {
        result = result * float(10)
    }

    return result
}

function isSign(b: int): boolean {
    return b == 43 or b == 45
}

// A float written in hexadecimal (`0x1.8p1`, `-0xff`, `0x1p-1074`), rounded to the nearest float
// (half to even) when it has more digits than a float holds. `code` is 1 for a text that is not
// one, 2 for one too large.
function hexFloat(text: string, mut code: int): float {
    immut chars = text.chars()
    mut at = 0
    mut negative = false

    if (at < chars.length() and chars[at] == '-') {
        negative = true
        at += 1
    } else {
        if (at < chars.length() and chars[at] == '+') { at += 1 }
    }

    if (at + 1 >= chars.length() or chars[at] != '0' or (chars[at + 1] != 'x' and chars[at + 1] != 'X')) {
        code = 1
        return float(0)
    }

    at += 2
    // The power of 2, after `p`.
    mut end = chars.length()
    mut power = 0

    for i in range(at, chars.length()) {
        if (end == chars.length() and (chars[i] == 'p' or chars[i] == 'P')) { end = i }
    }

    if (end < chars.length()) {
        match (intOf(text[end + 1..])) {
            Ok(value) => power = if (value < -100000) { -100000 } else { if (value > 100000) { 100000 } else { value } }
            Err(_) => {
                code = 1
                return float(0)
            }
        }

        // `intOf` takes white space and a `+`, which Rust's reading of an int takes too, but not
        // white space.
        if (trim(text[end + 1..]) != text[end + 1..]) {
            code = 1
            return float(0)
        }
    }

    mut point = end

    for i in range(at, end) {
        if (point == end and chars[i] == '.') { point = i }
    }

    if (point == at and (point == end or point + 1 == end)) {
        code = 1
        return float(0)
    }

    // value = mantissa * 2^exponent (+ a nonzero part below the last bit of the mantissa when
    // sticky); the first 30 significant hexadecimal digits are kept exactly.
    mut mantissa: U128 = 0
    mut kept = 0
    mut sticky = false
    mut exponent = power

    for i in range(at, end) {
        if (i == point) { continue }

        immut digit = hexValue(chars[i])

        if (digit < 0) {
            code = 1
            return float(0)
        }

        immut inFraction = i > point

        if (kept < 30) {
            if (mantissa != 0 or digit != 0) { kept += 1 }

            mantissa = (mantissa << 4) | wide(digit, 0)

            if (inFraction) { exponent -= 4 }
        } else {
            if (digit != 0) { sticky = true }

            if (not inFraction) { exponent += 4 }
        }
    }

    immut sign = if (negative) { float(-1) } else { float(1) }

    if (mantissa == 0) { return sign * float(0) }

    // The exponent of the leading bit, and the bits a float keeps: 53, fewer when subnormal.
    immut bits = 128 - leadingZeros(mantissa)
    immut leading = exponent + bits - 1

    if (leading > 1023) {
        code = 2
        return float(0)
    }

    immut precision = if (leading < -1022) { 53 - (-1022 - leading) } else { 53 }
    immut shift = bits - precision
    mut keptBits = mantissa
    mut scale = exponent

    if (shift > 0) {
        immut dropped = if (shift >= 128) { mantissa } else { mantissa & ((wide(1, 0) << wide(shift, 0)) - 1) }
        immut half = if (shift > 128) { wide(0, 0) } else { wide(1, 0) << wide(shift - 1, 0) }
        keptBits = if (shift >= 128) { wide(0, 0) } else { mantissa >> wide(shift, 0) }
        immut up = dropped > half or (dropped == half and (sticky or (keptBits & 1) == 1))

        if (up) { keptBits = keptBits + 1 }

        scale += shift
    }

    // Rounded up to 2^1024: too large.
    if (keptBits != 0 and 128 - leadingZeros(keptBits) + scale > 1024) {
        code = 2
        return float(0)
    }

    // keptBits * 2^scale is a float: exact in two halves.
    return sign * wideToFloat(keptBits) * powerOfTwo(scale / 2) * powerOfTwo(scale - scale / 2)
}

function hexValue(c: char): int {
    immut code = c.code()

    if (code >= 48 and code <= 57) { return code - 48 }

    if (code >= 97 and code <= 102) { return code - 87 }

    if (code >= 65 and code <= 70) { return code - 55 }

    return -1
}

// 2^n by squaring, as the `powi` of C compilers.
function powerOfTwo(n: int): float {
    mut result = float(1)
    mut base = float(2)
    mut left = if (n < 0) { -n } else { n }

    while (left > 0) {
        if ((left & 1) == 1) { result = result * base }

        left = left / 2

        if (left > 0) { base = base * base }
    }

    return if (n < 0) { float(1) / result } else { result }
}

// `input()` and `input(prompt)`: a line of the standard input without its line break, or `None`
// at its end.
function readLine(here: Location): Option[string] {
    return readLineAfter('', here)
}

function readLineAfter(prompt: string, here: Location): Option[string] {
    immut status = allocate(8)
    write(status, 0, 0)
    immut line = koji_read_line(prompt, here, status)
    immut ended: int = read(status, 0)
    free(status)

    if (ended == 1) { return None }

    return Some(line)
}

function decimalOf(text: string): Result[decimal, ParseError] {
    immut status = allocate(8)
    immut value = koji_decimal_parse(text, status)
    immut code: int = read(status, 0)
    free(status)

    if (code == 1) { return Err(InvalidNumber(text)) }

    if (code == 2) { return Err(OutOfRange(text)) }

    return Ok(value)
}
