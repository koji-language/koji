// `koji:x25519`: the Diffie-Hellman function X25519 of RFC 7748 (the key exchange of TLS 1.3), in
// the library of the runtime written in Koji. As TweetNaCl computes it: a number modulo 2^255 - 19
// is 16 limbs of 16 bits (ints, at an address of 128 bytes), whose products and their sums fit an int;
// the Montgomery ladder swaps its points with masks, so that nothing depends on the bits of the
// secret scalar (no branch, no address).

import { Address, CSize, allocate, free, offset, read, write } from 'koji:unsafe'

extern function memcpy(target: Address, source: Address, size: CSize): Address

function limb(f: Address, i: int): int {
    immut value: int = read(f, i * 8)
    return value
}

function setLimb(f: Address, i: int, value: int) {
    write(f, i * 8, value)
}

function byteAt(bytes: Address, i: int): int {
    immut b: byte = read(bytes, i)
    return int(b)
}

function newElement(): Address {
    immut f = allocate(128)

    for i in range(16) {
        setLimb(f, i, 0)
    }

    return f
}

// o = a + b, o = a - b (limb by limb; the carries come later).
function add(o: Address, a: Address, b: Address) {
    for i in range(16) {
        setLimb(o, i, limb(a, i) + limb(b, i))
    }
}

function subtract(o: Address, a: Address, b: Address) {
    for i in range(16) {
        setLimb(o, i, limb(a, i) - limb(b, i))
    }
}

// The limbs back to 16 bits, the carry of the last one folded in times 38 (2^256 = 38).
function carry(o: Address) {
    for i in range(16) {
        immut value = limb(o, i) + (1 << 16)
        immut c = value >> 16
        setLimb(o, i, value - (c << 16))

        if (i < 15) {
            setLimb(o, i + 1, limb(o, i + 1) + c - 1)
        } else {
            setLimb(o, 0, limb(o, 0) + 38 * (c - 1))
        }
    }
}

// o = a * b (o may be a or b), through `t` (31 ints).
function multiply(o: Address, a: Address, b: Address, t: Address) {
    for i in range(31) {
        setLimb(t, i, 0)
    }

    for i in range(16) {
        immut x = limb(a, i)

        for j in range(16) {
            setLimb(t, i + j, limb(t, i + j) + x * limb(b, j))
        }
    }

    for i in range(15) {
        setLimb(t, i, limb(t, i) + 38 * limb(t, i + 16))
    }

    for i in range(16) {
        setLimb(o, i, limb(t, i))
    }

    carry(o)
    carry(o)
}

// Swaps p and q when `bit` is 1, with a mask: the same operations either way.
function swap(p: Address, q: Address, bit: int) {
    immut mask = 0 - bit

    for i in range(16) {
        immut t = mask & (limb(p, i) ^ limb(q, i))
        setLimb(p, i, limb(p, i) ^ t)
        setLimb(q, i, limb(q, i) ^ t)
    }
}

// The 32 bytes (little-endian) of n reduced modulo 2^255 - 19.
function pack(out: Address, n: Address, t: Address) {
    immut m = newElement()
    memcpy(t, n, 128)
    carry(t)
    carry(t)
    carry(t)

    for j in range(2) {
        setLimb(m, 0, limb(t, 0) - 0xFFED)

        for i in range(1, 15) {
            setLimb(m, i, limb(t, i) - 0xFFFF - ((limb(m, i - 1) >> 16) & 1))
            setLimb(m, i - 1, limb(m, i - 1) & 0xFFFF)
        }

        setLimb(m, 15, limb(t, 15) - 0x7FFF - ((limb(m, 14) >> 16) & 1))
        immut borrow = (limb(m, 15) >> 16) & 1
        setLimb(m, 14, limb(m, 14) & 0xFFFF)
        swap(t, m, 1 - borrow)
    }

    for i in range(16) {
        write(out, 2 * i, byte(limb(t, i) & 0xFF))
        write(out, 2 * i + 1, byte((limb(t, i) >> 8) & 0xFF))
    }

    free(m)
}

// o = 1 / i, as i^(p - 2).
function invert(o: Address, i: Address, t: Address) {
    immut c = newElement()
    memcpy(c, i, 128)
    mut a = 253

    while (a >= 0) {
        multiply(c, c, c, t)

        if (a != 2 and a != 4) { multiply(c, c, i, t) }

        a -= 1
    }

    memcpy(o, c, 128)
    free(c)
}

// X25519 of the scalar (32 bytes, clamped here) and the u-coordinate of a point (32 bytes), at
// `out` (32 bytes).
export function x25519(out: Address, scalar: Address, point: Address) {
    immut z = allocate(32)
    memcpy(z, scalar, 32)
    write(z, 31, byte((byteAt(scalar, 31) & 127) | 64))
    write(z, 0, byte(byteAt(scalar, 0) & 248))
    immut x = newElement()

    for i in range(16) {
        setLimb(x, i, byteAt(point, 2 * i) + (byteAt(point, 2 * i + 1) << 8))
    }

    setLimb(x, 15, limb(x, 15) & 0x7FFF)
    immut a = newElement()
    immut b = newElement()
    immut c = newElement()
    immut d = newElement()
    immut e = newElement()
    immut f = newElement()
    immut constant = newElement()
    immut t = allocate(31 * 8)
    setLimb(constant, 0, 0xDB41)
    setLimb(constant, 1, 1)
    memcpy(b, x, 128)
    setLimb(a, 0, 1)
    setLimb(d, 0, 1)
    mut i = 254

    while (i >= 0) {
        immut bit = (byteAt(z, i >> 3) >> (i & 7)) & 1
        swap(a, b, bit)
        swap(c, d, bit)
        add(e, a, c)
        subtract(a, a, c)
        add(c, b, d)
        subtract(b, b, d)
        multiply(d, e, e, t)
        multiply(f, a, a, t)
        multiply(a, c, a, t)
        multiply(c, b, e, t)
        add(e, a, c)
        subtract(a, a, c)
        multiply(b, a, a, t)
        subtract(c, d, f)
        multiply(a, c, constant, t)
        add(a, a, d)
        multiply(c, c, a, t)
        multiply(a, d, f, t)
        multiply(d, b, x, t)
        multiply(b, e, e, t)
        swap(a, b, bit)
        swap(c, d, bit)
        i -= 1
    }

    invert(c, c, t)
    multiply(a, a, c, t)
    pack(out, a, t)

    for each in [x, a, b, c, d, e, f, constant, t, z] {
        free(each)
    }
}

// The public key of a secret one: X25519 of the scalar and the base point (u = 9).
export function x25519Base(out: Address, scalar: Address) {
    immut base = allocate(32)

    for i in range(32) {
        write(base, i, byte(if (i == 0) { 9 } else { 0 }))
    }

    x25519(out, scalar, base)
    free(base)
}

// For C (the tests of the library).
extern function koji_x25519(out: Address, scalar: Address, point: Address) {
    x25519(out, scalar, point)
}
