// The tables of powers of 5 of Ryu (std/koji/decimal.kj): written by bootstrap/ryu.rs (do not
// edit). Records of 32 hexadecimal digits, the high 64 bits of a number of 128 bits first.

// 5^i in its first 125 bits, for i below 326.
export immut powersOfFive = ''

// 2^(bits of 5^i - 1 + 125) / 5^i + 1, for i below 342.
export immut inversePowersOfFive = ''
