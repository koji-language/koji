// `koji:record`: the records (the values of declared types: objects and the variants of sum types,
// `Option` and `Result` among them), in the library of the runtime written in Koji (C calls these
// functions by their names). A record is 3 words, its count of references, its type (a
// `KojiRecordType`) and its variant, then the words of its fields (runtime/prelude.h, which makes
// records, sets and reads their fields and counts their references inline). Two variables share a
// record until one of them changes it.

import { Address, CSize, U128, distance, isNull, lowWord, offset, read, wide, write } from 'koji:unsafe'
import { cText } from 'koji:core'
import { isAlphabetic, isNumeric, mixed } from 'koji:text'

extern function koji_memory_take(words: int): Address
extern function koji_memory_give(block: Address, words: int)
extern function koji_element_size(element: Address): int
extern function koji_element_retain(element: Address, slot: Address)
extern function koji_element_release(element: Address, slot: Address)
extern function koji_element_repr(element: Address, slot: Address): string
extern function koji_element_text(element: Address, slot: Address): string
extern function koji_element_equal(element: Address, a: Address, b: Address): boolean
extern function koji_element_hash(element: Address, slot: Address): int
extern function koji_record_words(record: Address): int
extern function koji_record_field_count(record: Address): int
extern function koji_record_field_type(record: Address, index: int): Address
extern function koji_record_field_slot(record: Address, index: int): Address
extern function koji_record_field_name(record: Address, index: int): Address
extern function koji_record_variant_name(record: Address): Address
extern function koji_record_type_name(record: Address): Address
extern function koji_record_opaque(record: Address): boolean
extern function koji_record_shown(record: Address): string
extern function memcpy(target: Address, source: Address, size: CSize): Address
// The text of a string as written in code (std/koji/text.kj).
extern function koji_string_repr(text: string): string

function tagOf(record: Address): int {
    immut tag: int = read(record, 16)
    return tag
}

// The record in `variable`, made its own (copied when another variable shares it).
function unshared(variable: Address): Address {
    immut record: Address = read(variable, 0)
    immut references: int = read(record, 0)

    if (references == 1) { return record }

    immut words = koji_record_words(record)
    immut copy = koji_memory_take(3 + words)
    immut description: Address = read(record, 8)
    write(copy, 0, 1)
    write(copy, 8, description)
    write(copy, 16, tagOf(record))
    memcpy(offset(copy, 24), offset(record, 24), words * 8)

    for index in range(koji_record_field_count(copy)) {
        koji_element_retain(koji_record_field_type(copy, index), koji_record_field_slot(copy, index))
    }

    write(record, 0, references - 1)
    write(variable, 0, copy)
    return copy
}

// Makes the record in `variable` its own, for the generated code that changes a field in place (it
// calls this only when the record is shared).
extern function koji_record_unshare(variable: Address) {
    unshared(variable)
}

// The slot of a field, to change what it holds in place (`people[0].tags.push('a')`).
extern function koji_record_slot(variable: Address, index: CSize): Address {
    return koji_record_field_slot(unshared(variable), index)
}

// `record.field = value`.
extern function koji_record_set(variable: Address, index: CSize, value: Address) {
    immut record = unshared(variable)
    immut field = koji_record_field_type(record, index)
    immut slot = koji_record_field_slot(record, index)
    immut size = koji_element_size(field)
    // Read first: `value` may be inside the old value of the field.
    immut kept = koji_memory_take(2)
    memcpy(kept, value, size)
    koji_element_release(field, slot)
    memcpy(slot, kept, size)
    koji_memory_give(kept, 2)
    koji_element_retain(field, slot)
}

extern function koji_record_equal(a: Address, b: Address): boolean {
    if (distance(a, b) == 0) { return true }

    if (tagOf(a) != tagOf(b)) { return false }

    for index in range(koji_record_field_count(a)) {
        if (not koji_element_equal(koji_record_field_type(a, index), koji_record_field_slot(a, index), koji_record_field_slot(b, index))) { return false }
    }

    return true
}

// The value as written in code: `{ x: 1, y: 2 }`, `Some(1)`, `None`.
extern function koji_record_repr(record: Address): string {
    if (koji_record_opaque(record)) { return koji_record_shown(record) }

    immut count = koji_record_field_count(record)
    immut variant = koji_record_variant_name(record)

    if (isNull(variant)) {
        if (count == 0) { return '{}' }

        mut text = '{ '

        for index in range(count) {
            if (index > 0) { text += ', ' }

            immut name = cText(koji_record_field_name(record, index))
            text += if (isIdentifier(name)) { name } else { koji_string_repr(name) }
            text += ': '
            text += fieldRepr(record, index)
        }

        return text + ' }'
    }

    mut text = cText(variant)

    if (count == 0) { return text }

    text += '('

    for index in range(count) {
        if (index > 0) { text += ', ' }

        text += fieldRepr(record, index)
    }

    return text + ')'
}

function fieldRepr(record: Address, index: int): string {
    return koji_element_repr(koji_record_field_type(record, index), koji_record_field_slot(record, index))
}

// A name as code writes it: a letter or `_`, then letters, digits and `_` (as Unicode has them).
function isIdentifier(name: string): boolean {
    mut first = true

    for c in name {
        immut code = c.code()
        immut allowed = c == '_' or isAlphabetic(code) or (not first and isNumeric(code))

        if (not allowed) { return false }

        first = false
    }

    return not first
}

// The text `print` shows: a readable message for an error of the standard library (`'x' is not a
// valid number`), the text of an opaque type, or else the value as written in code.
extern function koji_record_display(record: Address): string {
    if (koji_record_opaque(record)) { return koji_record_shown(record) }

    immut variant = koji_record_variant_name(record)

    if (not isNull(variant)) {
        immut typeName = koji_record_type_name(record)

        if (not isNull(typeName)) {
            immut message = errorMessage(cText(typeName), cText(variant), record)

            if (message != '') { return message }
        }
    }

    return koji_record_repr(record)
}

// The message of an error of the standard library, from the texts of its fields, or '' for another
// value (`ParseError`, which the compiler declares; the errors of the modules written in Koji have
// `display` methods).
function errorMessage(typeName: string, variant: string, record: Address): string {
    if (typeName != 'ParseError') { return '' }

    return match (variant) {
        'InvalidNumber' => `'${fieldText(record, 0)}' is not a valid number`
        'OutOfRange' => `'${fieldText(record, 0)}' is out of range`
        _ => ''
    }
}

// The text of a field, as `print` shows it ('' for a field the variant does not have).
function fieldText(record: Address, index: int): string {
    if (index >= koji_record_field_count(record)) { return '' }

    return koji_element_text(koji_record_field_type(record, index), koji_record_field_slot(record, index))
}

// A hash of the variant and the fields.
extern function koji_record_hash(record: Address): int {
    mut hash = mixed(0, wide(tagOf(record), 0))

    for index in range(koji_record_field_count(record)) {
        hash = mixed(hash, wide(koji_element_hash(koji_record_field_type(record, index), koji_record_field_slot(record, index)), 0))
    }

    return lowWord(hash)
}
