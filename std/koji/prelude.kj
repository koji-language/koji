// `koji:prelude`: the part of the runtime that runtime/prelude.h writes in C for the C backend, in
// Koji for the library the native backend builds (`kojic library`, which alone has this module):
// the pool, records made and read, lists and maps read, the arithmetic the generated code leaves
// to the runtime, and the functions of the descriptions of the items of each built-in type (the
// descriptions themselves, and the functions that call through the address of another, are
// machine code the backend writes, compiler/native.kj). C and the generated code call these
// functions by their names. The threads of the runtime run machine code the backend writes (no Koji
// runs on them); here, on the thread of the program, their pipes are made, the threads started and
// given their jobs, and the clock started and stopped (see "The threads of the runtime" in
// doc/design.md).
//
// A string is 3 words (its references, its length, its capacity) then its bytes; a list 6 (its
// references, the description of its items, the words of an item, its items, its length, the
// words of its block); a map has its references in its first word and its length in its fifth; a
// record is 3 words (its references, its type, its variant) then its fields, and the type of a
// record (KojiRecordType) has its name, its number of variants, its variants (6 words each: the
// name, the number of fields, their names, their descriptions, their types of records, where each
// field starts) and the functions that free and show it.

import system
import { Address, CInt, CSize, CVariadic, Location, Never, U128, blankString, charOfCode, decimalHigh, decimalLow, decimalOf, distance, highWord, isNull, leadingZeros, lowWord, nullAddress, offset, panicAt, read, stringBytes, wide, wordProduct, write } from 'koji:unsafe'

extern function memcpy(target: Address, source: Address, size: CSize): Address
extern function poll(fds: Address, count: CSize, timeout: CInt): CInt
extern function pipe(fds: Address): CInt
extern function fcntl(fd: CInt, command: CInt, argument: CVariadic): CInt
extern function pthread_create(thread: Address, attributes: Address, start: Address, argument: Address): CInt
extern function pthread_detach(thread: int): CInt
extern function systemRead(fd: CInt, bytes: Address, size: CSize): int from 'read'
extern function systemWrite(fd: CInt, bytes: Address, size: CSize): int from 'write'
extern function koji_system_errno(): CInt

// The library written in Koji (by these names, with the types of C).
extern function koji_pool_refill(words: CSize): Address
extern function koji_pool_free(block: Address, words: CSize)
extern function koji_pool_resize(block: Address, words: CSize, newWords: CSize): Address
extern function koji_list_index_panic(index: int, length: int, here: Location): Never
extern function koji_string_from_int(value: int): string
extern function koji_string_from_float(value: float): string
extern function koji_string_from_decimal(value: decimal): string
extern function koji_string_from_bool(value: boolean): string
extern function koji_string_from_char(c: char): string
extern function koji_char_repr(c: char): string
extern function koji_string_repr(text: Address): string
extern function koji_string_equal(a: Address, b: Address): boolean
extern function koji_string_compare(a: Address, b: Address): CInt
extern function koji_string_hash(text: Address): int
extern function koji_string_free(text: Address)
extern function koji_list_repr(list: Address): string
extern function koji_list_equal(a: Address, b: Address): boolean
extern function koji_list_hash(list: Address): int
extern function koji_list_free(list: Address)
extern function koji_record_repr(record: Address): string
extern function koji_record_equal(a: Address, b: Address): boolean
extern function koji_record_hash(record: Address): int
extern function koji_map_repr(map: Address): string
extern function koji_map_equal(a: Address, b: Address): boolean
extern function koji_map_hash(map: Address): int
extern function koji_map_free(map: Address)
extern function koji_closure_repr(closure: Address): string
extern function koji_closure_equal(a: Address, b: Address): boolean
extern function koji_closure_free(closure: Address)
extern function koji_decimal_compare(a: decimal, b: decimal): CInt
extern function koji_decimal_hash(value: decimal): int
extern function koji_decimal_add(a: decimal, b: decimal, here: Location): decimal

// Machine code of the backend (compiler/native.kj).
extern function koji_pool_heads(): Address
extern function koji_pool_is_off(): boolean
extern function koji_element_retain(element: Address, slot: Address)
extern function koji_record_release(record: Address)
// The state of the threads (7 words: the pipe of the jobs, the pipe of the jobs done, whether the
// clock ticks, the pipe that wakes it; -1 for no pipe), and the code of the threads.
extern function koji_threads_place(): Address
extern function koji_helper_code(): Address
extern function koji_ticker_code(): Address

// The pool (std/koji/memory.kj has the rest): a block of `words` words from the list of its size,
// or a new chunk; a block back to its list (or to the system).
immut pooled = 16

extern function koji_pool_take(words: CSize): Address {
    if (words <= pooled) {
        immut heads = koji_pool_heads()
        immut block: Address = read(heads, words * 8)

        if (not isNull(block)) {
            immut next: Address = read(block, 0)
            write(heads, words * 8, next)
            return block
        }
    }

    return koji_pool_refill(words)
}

extern function koji_pool_give(block: Address, words: CSize) {
    if (words > pooled or koji_pool_is_off()) {
        koji_pool_free(block, words)
        return
    }

    immut heads = koji_pool_heads()
    immut next: Address = read(heads, words * 8)
    write(block, 0, next)
    write(heads, words * 8, block)
}

extern function koji_memory_take(words: int): Address {
    return koji_pool_take(words)
}

extern function koji_memory_give(block: Address, words: int) {
    koji_pool_give(block, words)
}

extern function koji_memory_resize(block: Address, words: int, newWords: int): Address {
    return koji_pool_resize(block, words, newWords)
}

// Records.

// The variant of a record (its description: 6 words).
extern function koji_variant_of(record: Address): Address {
    immut kind: Address = read(record, 8)
    immut variants: Address = read(kind, 16)
    immut tag: int = read(record, 16)
    return offset(variants, tag * 48)
}

// The words of the fields of a variant: where the field after the last one would start, or one for
// each field.
extern function koji_variant_words(variant: Address): int {
    immut count: int = read(variant, 8)
    immut starts: Address = read(variant, 40)

    if (isNull(starts)) { return count }

    immut words: int = read(starts, count * 8)
    return words
}

// A new record of variant `tag`, of `words` words of fields, with one reference and its fields zero
// (the generated code writes them next).
extern function koji_record_make(kind: Address, tag: CSize, words: CSize): Address {
    immut record = koji_pool_take(3 + words)
    write(record, 0, 1)
    write(record, 8, kind)
    write(record, 16, tag)

    for word in range(words) {
        write(record, 24 + word * 8, 0)
    }

    return record
}

extern function koji_record_new(kind: Address, tag: CSize): Address {
    immut variants: Address = read(kind, 16)
    return koji_record_make(kind, tag, koji_variant_words(offset(variants, tag * 48)))
}

// The slot of a field.
extern function koji_record_get(record: Address, index: CSize): Address {
    immut starts: Address = read(koji_variant_of(record), 40)

    if (isNull(starts)) { return offset(record, 24 + index * 8) }

    immut start: int = read(starts, index * 8)
    return offset(record, 24 + start * 8)
}

// Sets a field of a new record, with a reference of its own to the value.
extern function koji_record_init(record: Address, index: CSize, value: Address) {
    immut fields: Address = read(koji_variant_of(record), 24)
    immut field: Address = read(fields, index * 8)
    immut slot = koji_record_get(record, index)
    immut size: int = read(field, 0)
    memcpy(slot, value, size)
    koji_element_retain(field, slot)
}

extern function koji_record_tag(record: Address): int {
    immut tag: int = read(record, 16)
    return tag
}

extern function koji_record_words(record: Address): int {
    return koji_variant_words(koji_variant_of(record))
}

extern function koji_record_field_count(record: Address): int {
    immut count: int = read(koji_variant_of(record), 8)
    return count
}

extern function koji_record_field_type(record: Address, index: int): Address {
    immut types: Address = read(koji_variant_of(record), 24)
    immut field: Address = read(types, index * 8)
    return field
}

extern function koji_record_field_slot(record: Address, index: int): Address {
    return koji_record_get(record, index)
}

extern function koji_record_field_name(record: Address, index: int): Address {
    immut names: Address = read(koji_variant_of(record), 16)
    immut name: Address = read(names, index * 8)
    return name
}

// The name of the variant (0 for an object type), and of the type.
extern function koji_record_variant_name(record: Address): Address {
    immut name: Address = read(koji_variant_of(record), 0)
    return name
}

extern function koji_record_type_name(record: Address): Address {
    immut kind: Address = read(record, 8)
    immut name: Address = read(kind, 0)
    return name
}

// Whether the type shows its values by its `display` method.
extern function koji_record_opaque(record: Address): boolean {
    immut kind: Address = read(record, 8)
    immut display: Address = read(kind, 32)
    return not isNull(display)
}

// Lists and maps.

extern function koji_list_length(list: Address): int {
    immut length: int = read(list, 32)
    return length
}

// The slot of the item at `index` (of `words` words), to read it.
extern function koji_list_at(list: Address, index: int, words: CSize, here: Location): Address {
    immut length: int = read(list, 32)

    if (index < 0 or index >= length) { koji_list_index_panic(index, length, here) }

    immut items: Address = read(list, 24)
    return offset(items, index * words * 8)
}

extern function koji_list_get(list: Address, index: int, here: Location): Address {
    immut stride: int = read(list, 16)
    return koji_list_at(list, index, stride, here)
}

extern function koji_map_length(map: Address): int {
    immut length: int = read(map, 32)
    return length
}

// Arithmetic.

// `base ** exponent` of bytes.
extern function koji_byte_pow(base: byte, exponent: byte, here: Location): byte {
    mut result = 1

    for i in range(int(exponent)) {
        result *= int(base)

        if (result > 255) { panicAt(here, 'byte overflow') }
    }

    return byte(result)
}

// A division of U128 that the generated code leaves to the runtime (a divisor of two words, or one
// above the high word of the dividend; see compiler/native.kj): bit by bit, as long division.
extern function koji_u128_div(a: U128, b: U128, here: Location): U128 {
    return divided(a, b, here, false)
}

extern function koji_u128_rem(a: U128, b: U128, here: Location): U128 {
    return divided(a, b, here, true)
}

function divided(a: U128, b: U128, here: Location, remainder: boolean): U128 {
    immut zero: U128 = 0

    if (b == zero) { panicAt(here, 'division by zero') }

    if (a < b) { return if (remainder) { a } else { zero } }

    immut one: U128 = 1
    immut shift = leadingZeros(b) - leadingZeros(a)
    mut divisor = b << wide(shift, 0)
    mut rest = a
    mut quotient = zero

    for i in range(shift + 1) {
        quotient = quotient << one

        if (rest >= divisor) {
            rest = rest - divisor
            quotient = quotient + one
        }

        divisor = divisor >> one
    }

    return if (remainder) { rest } else { quotient }
}

extern function koji_u128_to_string(value: U128): string {
    immut ten: U128 = 10
    immut zero: U128 = 0
    mut count = 1
    mut rest = value / ten

    while (rest != zero) {
        count += 1
        rest = rest / ten
    }

    immut text = blankString(count, count)
    immut bytes = stringBytes(text)
    rest = value
    mut at = count - 1

    while (at >= 0) {
        immut quotient = rest / ten
        write(bytes, at, byte(48 + lowWord(rest - quotient * ten)))
        rest = quotient
        at -= 1
    }

    return text
}

// The float nearest a U128: its 64 high bits from the first one set, with a bit for those below
// (so that the rounding is that of the whole number), then scaled.
extern function koji_unsafe_wide_to_float(value: U128): float {
    if (highWord(value) == 0) { return unsignedFloat(lowWord(value)) }

    immut shift = 64 - leadingZeros(value)
    immut top = lowWord(value >> wide(shift, 0))
    immut below = lowWord(value) & if (shift == 64) { -1 } else { ~(-1 << shift) }
    immut sticky = if (below != 0) { 1 } else { 0 }
    immut two = float(2)
    mut scale = float(1)

    for i in range(shift) {
        scale *= two
    }

    return unsignedFloat(top | sticky) * scale
}

// The float nearest a word read as unsigned.
function unsignedFloat(word: int): float {
    if (word >= 0) { return float(word) }

    // Halved, keeping the last bit for the rounding.
    immut half = (word >> 1) & 0x7FFFFFFFFFFFFFFF | word & 1
    return float(half) * float(2)
}

// `a + b` of decimals: here when both have the same exponent and sign and the sum keeps 34 digits,
// otherwise in std/koji/decimal.kj.
extern function koji_decimal_plus(a: decimal, b: decimal, here: Location): decimal {
    immut mask = (1 << 49) - 1
    immut high = decimalHigh(a)

    if ((high & ~mask) == (decimalHigh(b) & ~mask)) {
        immut sum = wide(decimalLow(a), high & mask) + wide(decimalLow(b), decimalHigh(b) & mask)
        immut limit = wordProduct(wide(10000000000000000, 0), wide(1000000000000000000, 0))

        if (sum < limit) { return decimalOf(lowWord(sum), high & ~mask | highWord(sum)) }
    }

    return koji_decimal_add(a, b, here)
}

// The system and the program.

// Whether a write to `fd` would not wait (poll: POLLOUT at once).
extern function koji_output_ready(fd: int): boolean {
    // struct pollfd: the descriptor (4 bytes), the events (2), the events that came (2).
    immut place = koji_pool_take(1)
    write(place, 0, fd & 0xFFFFFFFF | 4 << 32)
    immut answer = poll(place, 1, 0)
    immut events: int = read(place, 0)
    immut ready = answer == 1 and (events >> 48) & 4 != 0
    koji_pool_give(place, 1)
    return ready
}

// `kojic test`: the number of the test to run, the last argument of the executable (taken from the
// arguments the program sees: `count` is that of main, the address of a C int), or -1.
extern function koji_test_argument(count: Address, values: Address): int {
    immut arguments: char = read(count, 0)
    immut total = arguments.code()

    if (total < 2) { return -1 }

    immut last: Address = read(values, (total - 1) * 8)
    mut number = 0
    mut at = 0

    while (true) {
        immut digit: byte = read(last, at)

        if (digit < 48 or digit > 57) { break }

        number = number * 10 + int(digit) - 48
        at += 1
    }

    write(count, 0, charOfCode(total - 1))
    return number
}

// The functions of the descriptions of items (koji_element_int and the others, which the backend
// writes): the text as written in code, equality, order, hash, and for the counted ones a
// reference more or less; the slot of an item is its address.

function order(less: boolean, greater: boolean): CInt {
    return if (less) { -1 } else { if (greater) { 1 } else { 0 } }
}

extern function koji_repr_int(slot: Address): string {
    immut value: int = read(slot, 0)
    return koji_string_from_int(value)
}

extern function koji_equal_int(a: Address, b: Address): boolean {
    immut x: int = read(a, 0)
    immut y: int = read(b, 0)
    return x == y
}

extern function koji_compare_int(a: Address, b: Address): CInt {
    immut x: int = read(a, 0)
    immut y: int = read(b, 0)
    return order(x < y, x > y)
}

extern function koji_hash_int(slot: Address): int {
    immut value: int = read(slot, 0)
    return value
}

extern function koji_repr_float(slot: Address): string {
    immut value: float = read(slot, 0)
    return koji_string_from_float(value)
}

extern function koji_equal_float(a: Address, b: Address): boolean {
    immut x: float = read(a, 0)
    immut y: float = read(b, 0)
    return x == y
}

extern function koji_compare_float(a: Address, b: Address): CInt {
    immut x: float = read(a, 0)
    immut y: float = read(b, 0)
    return order(x < y, x > y)
}

// Its bits (0.0 and -0.0 are equal: both 0).
extern function koji_hash_float(slot: Address): int {
    immut value: float = read(slot, 0)
    immut bits: int = read(slot, 0)
    return if (value != float(0)) { bits } else { 0 }
}

function decimalAt(slot: Address): decimal {
    immut low: int = read(slot, 0)
    immut high: int = read(slot, 8)
    return decimalOf(low, high)
}

extern function koji_repr_decimal(slot: Address): string {
    return koji_string_from_decimal(decimalAt(slot))
}

extern function koji_equal_decimal(a: Address, b: Address): boolean {
    return koji_decimal_compare(decimalAt(a), decimalAt(b)) == 0
}

extern function koji_compare_decimal(a: Address, b: Address): CInt {
    return koji_decimal_compare(decimalAt(a), decimalAt(b))
}

extern function koji_hash_decimal(slot: Address): int {
    return koji_decimal_hash(decimalAt(slot))
}

function wideAt(slot: Address): U128 {
    immut low: int = read(slot, 0)
    immut high: int = read(slot, 8)
    return wide(low, high)
}

extern function koji_repr_u128(slot: Address): string {
    return koji_u128_to_string(wideAt(slot))
}

extern function koji_equal_u128(a: Address, b: Address): boolean {
    return wideAt(a) == wideAt(b)
}

extern function koji_compare_u128(a: Address, b: Address): CInt {
    immut x = wideAt(a)
    immut y = wideAt(b)
    return order(x < y, x > y)
}

// The low word by the golden ratio (0x9E3779B97F4A7C15, wrapping around), then the high word.
extern function koji_hash_u128(slot: Address): int {
    immut low: int = read(slot, 0)
    immut high: int = read(slot, 8)
    return lowWord(wordProduct(wide(low, 0), wide(-7046029254386353131, 0))) ^ high
}

extern function koji_repr_bool(slot: Address): string {
    immut value: boolean = read(slot, 0)
    return koji_string_from_bool(value)
}

extern function koji_equal_bool(a: Address, b: Address): boolean {
    immut x: boolean = read(a, 0)
    immut y: boolean = read(b, 0)
    return x == y
}

// Booleans compare as equal: a sort keeps their order.
extern function koji_compare_bool(a: Address, b: Address): CInt {
    return 0
}

extern function koji_hash_bool(slot: Address): int {
    immut value: boolean = read(slot, 0)
    return if (value) { 1 } else { 0 }
}

extern function koji_repr_char(slot: Address): string {
    immut value: char = read(slot, 0)
    return koji_char_repr(value)
}

extern function koji_equal_char(a: Address, b: Address): boolean {
    immut x: char = read(a, 0)
    immut y: char = read(b, 0)
    return x == y
}

extern function koji_compare_char(a: Address, b: Address): CInt {
    immut x: char = read(a, 0)
    immut y: char = read(b, 0)
    return order(x < y, x > y)
}

extern function koji_hash_char(slot: Address): int {
    immut value: char = read(slot, 0)
    return value.code()
}

extern function koji_display_char(slot: Address): string {
    immut value: char = read(slot, 0)
    return koji_string_from_char(value)
}

extern function koji_repr_byte(slot: Address): string {
    immut value: byte = read(slot, 0)
    return koji_string_from_int(int(value))
}

extern function koji_equal_byte(a: Address, b: Address): boolean {
    immut x: byte = read(a, 0)
    immut y: byte = read(b, 0)
    return x == y
}

extern function koji_compare_byte(a: Address, b: Address): CInt {
    immut x: byte = read(a, 0)
    immut y: byte = read(b, 0)
    return order(x < y, x > y)
}

extern function koji_hash_byte(slot: Address): int {
    immut value: byte = read(slot, 0)
    return int(value)
}

// The counted values: the address in the slot (0 for none), its count of references the first word.

function retained(slot: Address) {
    immut value: Address = read(slot, 0)

    if (isNull(value)) { return }

    immut references: int = read(value, 0)
    write(value, 0, references + 1)
}

// Whether the last reference to the value in the slot went (the value is to be freed).
function released(slot: Address): boolean {
    immut value: Address = read(slot, 0)

    if (isNull(value)) { return false }

    immut references: int = read(value, 0)
    write(value, 0, references - 1)
    return references == 1
}

function at(slot: Address): Address {
    immut value: Address = read(slot, 0)
    return value
}

extern function koji_retain_string(slot: Address) {
    retained(slot)
}

extern function koji_release_string(slot: Address) {
    if (released(slot)) { koji_string_free(at(slot)) }
}

extern function koji_repr_string(slot: Address): string {
    return koji_string_repr(at(slot))
}

extern function koji_equal_string(a: Address, b: Address): boolean {
    return koji_string_equal(at(a), at(b))
}

extern function koji_compare_string(a: Address, b: Address): CInt {
    return koji_string_compare(at(a), at(b))
}

extern function koji_hash_string(slot: Address): int {
    return koji_string_hash(at(slot))
}

// The string itself, with a reference more.
extern function koji_display_string(slot: Address): Address {
    retained(slot)
    return at(slot)
}

extern function koji_retain_list(slot: Address) {
    retained(slot)
}

extern function koji_release_list(slot: Address) {
    if (released(slot)) { koji_list_free(at(slot)) }
}

extern function koji_repr_list(slot: Address): string {
    return koji_list_repr(at(slot))
}

extern function koji_equal_list(a: Address, b: Address): boolean {
    return koji_list_equal(at(a), at(b))
}

extern function koji_hash_list(slot: Address): int {
    return koji_list_hash(at(slot))
}

extern function koji_retain_record(slot: Address) {
    retained(slot)
}

extern function koji_release_record(slot: Address) {
    koji_record_release(at(slot))
}

extern function koji_repr_record(slot: Address): string {
    return koji_record_repr(at(slot))
}

extern function koji_equal_record(a: Address, b: Address): boolean {
    return koji_record_equal(at(a), at(b))
}

extern function koji_hash_record(slot: Address): int {
    return koji_record_hash(at(slot))
}

extern function koji_retain_map(slot: Address) {
    retained(slot)
}

extern function koji_release_map(slot: Address) {
    if (released(slot)) { koji_map_free(at(slot)) }
}

extern function koji_repr_map(slot: Address): string {
    return koji_map_repr(at(slot))
}

extern function koji_equal_map(a: Address, b: Address): boolean {
    return koji_map_equal(at(a), at(b))
}

extern function koji_hash_map(slot: Address): int {
    return koji_map_hash(at(slot))
}

extern function koji_retain_closure(slot: Address) {
    retained(slot)
}

extern function koji_release_closure(slot: Address) {
    if (released(slot)) { koji_closure_free(at(slot)) }
}

extern function koji_repr_closure(slot: Address): string {
    return koji_closure_repr(at(slot))
}

extern function koji_equal_closure(a: Address, b: Address): boolean {
    return koji_closure_equal(at(a), at(b))
}

// Its address.
extern function koji_hash_closure(slot: Address): int {
    immut value: int = read(slot, 0)
    return value
}

// The `void` of `Ok(void)`: no bytes, one value.
extern function koji_repr_void(slot: Address): string {
    return 'void'
}

extern function koji_equal_void(a: Address, b: Address): boolean {
    return true
}

extern function koji_hash_void(slot: Address): int {
    return 0
}

// The threads of the runtime.

// A pipe whose ends do not go to the programs a program runs, at the words `at` and `at + 1` of the
// state: whether the system made it.
function closedPipe(state: Address, at: int): boolean {
    immut ends = koji_pool_take(1)
    immut made = pipe(ends) == 0
    // Two ints of C.
    immut both: int = read(ends, 0)
    koji_pool_give(ends, 1)

    if (not made) { return false }

    immut first = both & 0xFFFFFFFF
    immut second = (both >> 32) & 0xFFFFFFFF
    // F_SETFD, FD_CLOEXEC
    fcntl(first, 2, 1)
    fcntl(second, 2, 1)
    write(state, at * 8, first)
    write(state, at * 8 + 8, second)
    return true
}

// A new thread running `code` with the state: whether the system made it.
function started(code: Address, state: Address): boolean {
    immut thread = koji_pool_take(1)
    immut made = pthread_create(thread, nullAddress(), code, state) == 0

    if (made) {
        immut id: int = read(thread, 0)
        pthread_detach(id)
    }

    koji_pool_give(thread, 1)
    return made
}

// Writes a word (its first `size` bytes) to `fd`, again when a signal stops the write.
function written(fd: int, word: int, size: int) {
    immut place = koji_pool_take(1)
    write(place, 0, word)

    while (systemWrite(fd, place, size) < 0 and koji_system_errno() == 4) {}

    koji_pool_give(place, 1)
}

// Makes the pipes of the jobs: the end the jobs done come from, which reads without waiting, or -1.
extern function koji_helpers_start(): int {
    immut state = koji_threads_place()

    if (not closedPipe(state, 0) or not closedPipe(state, 2)) { return -1 }

    immut done: int = read(state, 16)
    immut nonblocking = if (system.os == system.Linux) { 0x800 } else { 0x4 }
    // F_SETFL, with F_GETFL
    fcntl(done, 4, fcntl(done, 3, 0) | nonblocking)
    return done
}

// One more thread that helps: whether the system made it.
extern function koji_helpers_add(): boolean {
    return started(koji_helper_code(), koji_threads_place())
}

extern function koji_helpers_submit(job: Address) {
    immut fd: int = read(koji_threads_place(), 8)
    // The address of the job, as a word.
    written(fd, distance(nullAddress(), job), 8)
}

// The jobs done (their addresses at `out`, at most `capacity`), without waiting: how many.
extern function koji_helpers_finished(out: Address, capacity: int): int {
    immut fd: int = read(koji_threads_place(), 16)
    immut got = systemRead(fd, out, capacity * 8)
    return if (got <= 0) { 0 } else { got / 8 }
}

// Starts or stops the clock of preemption: whether the system could start it.
extern function koji_ticks(on: boolean): boolean {
    immut state = koji_threads_place()
    immut wake: int = read(state, 40)

    if (wake < 0) {
        if (not on) { return true }

        if (not closedPipe(state, 5)) { return false }

        write(state, 32, 1)
        return started(koji_ticker_code(), state)
    }

    immut ticking: int = read(state, 32)

    // Stopped: a byte wakes it.
    if (on and ticking == 0) {
        write(state, 32, 1)
        immut fd: int = read(state, 48)
        written(fd, 1, 1)
    }

    if (not on) { write(state, 32, 0) }

    return true
}
