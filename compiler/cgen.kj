// The C code generator of the Koji compiler: turns the IR into one C file, which a C compiler
// links with the runtime library (runtime/). `generate` gives the text of `kojic dump c`.

import { IrExtern, Ty, Operand, Place, Step, Target, IrField, IrRecord, StdArg, Instruction, Terminator, IrFunction, IrProgram, isManaged, itemOf, stringDebug, floatDebug } from 'ir.kj'
import { preludeLines } from 'prelude.kj'
import { borrowedParams, borrowedLocals, constantGlobals } from 'borrow.kj'
import { lastUses } from 'liveness.kj'
import { StackRecords, stackRecords } from 'escape.kj'

type Generator = {
    program: IrProgram
    // The lines of the C file.
    out: string[]
    // The file of the function being generated, and its name escaped for C (see `location`).
    file: string
    escapedFile: string
    // For each function, which parameters are borrowed, and the globals that never change once
    // they have their value (borrow.kj).
    borrowed: boolean[][]
    constants: boolean[]
    // The functions always inlined.
    smalls: boolean[]
    // The borrowed locals of the function being generated: its borrowed parameters, and the
    // locals that only read their fields (borrow.kj).
    current: boolean[]
    // The locals each instruction of the function being generated reads for the last time
    // (liveness.kj), and the position of the instruction being generated.
    live: int[][][]
    block: int
    position: int
    // For each function, the locals whose record is on its stack (escape.kj), and for those of
    // the function being generated, their variant.
    stacks: StackRecords[]
    stack: Map[int, int]
    // The lines that release the locals of the function being generated, at each `return`.
    releases: string[]
    // `string(c)` not written, since the next instruction appends `c` instead (or -1), and `c`.
    charLocal: int
    charValue: string
}

function cType(ty: Ty): string {
    return match (ty) {
        IntTy => 'int64_t'
        FloatTy => 'double'
        DecimalTy => 'KojiDecimal'
        BoolTy => 'bool'
        CharTy => 'uint32_t'
        ByteTy => 'uint8_t'
        StrTy => 'KojiString *'
        ListTy(_) => 'KojiList *'
        RecordTy(_) => 'KojiRecord *'
        MapTy(_, _) => 'KojiMap *'
        SetTy(_) => 'KojiMap *'
        FunctionTy(_, _) => 'KojiClosure *'
        FileTy => 'KojiFile *'
        VoidTy => 'void'
    }
}

// The runtime's name for the values of a managed type (`string` in `koji_string_retain`).
function kind(ty: Ty): Option[string] {
    return match (ty) {
        StrTy => Some('string')
        ListTy(_) => Some('list')
        RecordTy(_) => Some('record')
        MapTy(_, _) => Some('map')
        SetTy(_) => Some('map')
        FunctionTy(_, _) => Some('closure')
        FileTy => Some('file')
        _ => None
    }
}

// `expression` (borrowed) with a new reference, for a managed type.
function share(ty: Ty, expression: string): string {
    return match (kind(ty)) {
        Some(name) => `koji_${name}_share(${expression})`
        None => expression
    }
}

// The function that adds a reference to a value of a managed type.
function retain(ty: Ty): Option[string] {
    return match (kind(ty)) {
        Some(name) => Some(`koji_${name}_retain`)
        None => None
    }
}

function release(ty: Ty): Option[string] {
    return match (kind(ty)) {
        Some(name) => Some(`koji_${name}_release`)
        None => None
    }
}

// The 8-byte words a value takes in a record, a list or a map: two for a decimal.
function words(ty: Ty): int {
    return match (ty) {
        DecimalTy => 2
        _ => 1
    }
}

function hasWideField(fields: IrField[]): boolean {
    for field in fields {
        if (words(field.ty) > 1) { return true }
    }

    return false
}

// The description of the items of a list (`koji_element_int`, ...).
function elementType(ty: Ty): string {
    return match (ty) {
        IntTy => '&koji_element_int'
        FloatTy => '&koji_element_float'
        DecimalTy => '&koji_element_decimal'
        BoolTy => '&koji_element_bool'
        CharTy => '&koji_element_char'
        ByteTy => '&koji_element_byte'
        StrTy => '&koji_element_string'
        ListTy(_) => '&koji_element_list'
        RecordTy(_) => '&koji_element_record'
        MapTy(_, _) => '&koji_element_map'
        SetTy(_) => '&koji_element_map'
        FunctionTy(_, _) => '&koji_element_closure'
        FileTy => '&koji_element_file'
        VoidTy => '&koji_element_void'
    }
}

// The UTF-8 bytes of a character.
function utf8(c: char): int[] {
    immut code = c.code()

    if (code < 128) { return [code] }

    if (code < 2048) { return [192 + code / 64, 128 + code % 64] }

    if (code < 65536) { return [224 + code / 4096, 128 + code / 64 % 64, 128 + code % 64] }

    return [240 + code / 262144, 128 + code / 4096 % 64, 128 + code / 64 % 64, 128 + code % 64]
}

function byteLength(text: string): int {
    mut length = 0

    for c in text {
        immut code = c.code()
        length += if (code < 128) { 1 } else { utf8(c).length() }
    }

    return length
}

// A byte as three octal digits (`\042`).
function octal(byte: int): string {
    return `\\${byte / 64}${byte / 8 % 8}${byte % 8}`
}

// A C string literal with the bytes of `text`.
function cString(text: string): string {
    return `"${escaped(text)}"`
}

// The bytes of `text` in a C string literal: a printable ASCII character as it is, but `"`,
// `\` and `?`; the others as octal escapes.
function escaped(text: string): string {
    mut literal = ''

    for c in text {
        immut code = c.code()

        if (code >= 32 and code <= 126 and code != 34 and code != 92 and code != 63) {
            literal += string(c)
            continue
        }

        for byte in utf8(c) {
            literal += octal(byte)
        }
    }

    return literal
}

function functionName(id: int): string {
    return `koji_f${id}`
}

function Generator.externOf(self, name: string): Option[IrExtern] {
    for found in self.program.externs {
        if (found.name == name) { return Some(found) }
    }

    return None
}

function Generator.line(mut self, text: string) {
    self.out.push(text)
}

// The C source of `program`, line by line.
export function generate(program: IrProgram): string[] {
    mut generator: Generator = { program: program, out: [], file: '', escapedFile: '', borrowed: borrowedParams(program), constants: constantGlobals(program), smalls: smallFunctions(program), current: [], live: [], block: 0, position: 0, stacks: stackRecords(program), stack: [:], releases: [], charLocal: -1, charValue: '' }
    generator.generateProgram()
    return generator.out
}

function Generator.generateProgram(mut self) {
    for text in preludeLines {
        self.line(text)
    }

    self.line('')
    immut strings = self.program.strings

    // `used`: gcc keeps the constant of a function it removed, so that the string it holds is not
    // lost.
    for id in range(strings.length()) {
        self.line(`static KojiString *koji_s${id} __attribute__((used)); // ${stringDebug(strings[id])}`)
    }

    // The C functions that `extern` declarations name.
    for found in self.program.externs {
        immut params = if (found.params.length() == 0) { 'void' } else { found.params.join(', ') }
        self.line(`${found.returns} ${found.name}(${params});`)
    }

    self.records()
    immut globals = self.program.globals

    for id in range(globals.length()) {
        self.line(`static ${cType(globals[id].ty)} koji_g${id}; // ${globals[id].name}`)
    }

    self.line('')
    immut functions = self.program.functions

    for id in range(functions.length()) {
        self.line(`${signature(id, functions[id], self.smalls[id])};`)
    }

    // How the runtime shows a value of an opaque type: with its `display` method, or by its name.
    for id in range(self.program.records.length()) {
        immut record = self.program.records[id]

        if (not record.opaque) { continue }

        match (record.display) {
            Some(code) => self.line(`static KojiString *koji_display_${id}(const KojiRecord *record) { return ${functionName(code)}((KojiRecord *)record); }`)
            None => {
                immut text = `<${record.name}>`
                self.line(`static KojiString *koji_display_${id}(const KojiRecord *record) { (void)record; return koji_string_new(${cString(text)}, ${byteLength(text)}); }`)
            }
        }
    }

    for id in range(functions.length()) {
        self.line('')
        self.emitFunction(id, functions[id])
    }

    self.line('')
    self.line('int main(int argc, char **argv) {')
    self.line('    koji_init(argc, (const char *const *)argv);')

    for id in range(strings.length()) {
        self.line(`    koji_s${id} = koji_string_new(${cString(strings[id])}, ${byteLength(strings[id])});`)
    }

    self.line(`    ${functionName(self.program.main)}();`)
    self.line('    return 0;')
    self.line('}')
}

// The descriptions of the declared types, for the runtime.
function Generator.records(mut self) {
    immut records = self.program.records

    // Declared first: a field can be of a record declared later.
    for id in range(records.length()) {
        self.line(`static const KojiRecordType koji_record_${id};`)
        self.line(`static void koji_free_${id}(KojiRecord *record);`)

        if (records[id].opaque) { self.line(`static KojiString *koji_display_${id}(const KojiRecord *record);`) }
    }

    for id in range(records.length()) {
        immut record = records[id]
        self.line(`// ${record.name}`)

        for index in range(record.variants.length()) {
            immut fields = record.variants[index].fields

            if (fields.length() == 0) { continue }

            mut names: string[] = []
            mut types: string[] = []
            mut nested: string[] = []

            for field in fields {
                names.push(cString(field.name))
                types.push(elementType(field.ty))
                nested.push(match (field.ty) {
                    RecordTy(inner) => `&koji_record_${inner}`
                    _ => 'NULL'
                })
            }

            self.line(`static const char *const koji_record_${id}_${index}_names[] = { ${names.join(', ')} };`)
            self.line(`static const KojiElementType *const koji_record_${id}_${index}_types[] = { ${types.join(', ')} };`)
            self.line(`static const KojiRecordType *const koji_record_${id}_${index}_records[] = { ${nested.join(', ')} };`)

            // A field of two words (a decimal) moves the ones after it.
            if (hasWideField(fields)) {
                mut offsets: string[] = []
                mut word = 0

                for field in fields {
                    offsets.push(string(word))
                    word += words(field.ty)
                }

                offsets.push(string(word))
                self.line(`static const size_t koji_record_${id}_${index}_offsets[] = { ${offsets.join(', ')} };`)
            }
        }

        mut variants: string[] = []

        for index in range(record.variants.length()) {
            immut variant = record.variants[index]
            immut name = match (variant.name) {
                Some(text) => cString(text)
                None => 'NULL'
            }

            if (variant.fields.length() == 0) {
                variants.push(`{ ${name}, 0, NULL, NULL, NULL, NULL }`)
            } else {
                immut prefix = `koji_record_${id}_${index}`
                immut offsets = if (hasWideField(variant.fields)) { `${prefix}_offsets` } else { 'NULL' }
                variants.push(`{ ${name}, ${variant.fields.length()}, ${prefix}_names, ${prefix}_types, ${prefix}_records, ${offsets} }`)
            }
        }

        self.line(`static const KojiVariantType koji_record_${id}_variants[] = { ${variants.join(', ')} };`)
        // The name without type arguments (`Result`, `MathError`).
        immut base = record.name.split('[')[0]
        immut shown = if (record.opaque) { `koji_display_${id}` } else { 'NULL' }
        self.line(`static const KojiRecordType koji_record_${id} = { ${cString(base)}, ${record.variants.length()}, koji_record_${id}_variants, koji_free_${id}, ${shown} };`)
    }

    for id in range(records.length()) {
        self.freeFunction(id)
    }
}

// The function that frees a record of type `id`: it releases each field where its variant puts
// it, and gives the memory back.
function Generator.freeFunction(mut self, id: int) {
    immut variants = self.program.records[id].variants
    self.line(`static void koji_free_${id}(KojiRecord *record) {`)
    self.line('    switch (record->tag) {')

    for index in range(variants.length()) {
        self.line(`    case ${index}:`)
        mut word = 0

        for field in variants[index].fields {
            match (release(field.ty)) {
                Some(name) => self.line(`        ${name}(*(${cType(field.ty)} *)&record->words[${word}]);`)
                None => {}
            }

            word += words(field.ty)
        }

        self.line(`        koji_pool_give(record, ${3 + word});`)
        self.line('        return;')
    }

    self.line('    }')
    self.line('}')
}

// The words the fields of a variant take.
function variantWords(fields: IrField[]): int {
    mut total = 0

    for field in fields {
        total += words(field.ty)
    }

    return total
}

function signature(id: int, routine: IrFunction, inlined: boolean): string {
    mut params: string[] = []

    for param in range(routine.params) {
        params.push(`${cType(routine.locals[param].ty)} l${param}`)
    }

    // A `mut` parameter gives its final value back through `out<n>`.
    for param in range(routine.writeback.length()) {
        if (routine.writeback[param]) { params.push(`${cType(routine.locals[param].ty)} *out${param}`) }
    }

    immut list = if (params.length() == 0) { 'void' } else { params.join(', ') }
    immut inline = if (inlined) { 'KOJI_INLINE' } else { 'static' }
    return `${inline} ${cType(routine.returns)} ${functionName(id)}(${list}) /* ${routine.name} */`
}

// The functions of a few instructions that call no other ones but such functions (`Lexer.at`,
// `Lexer.advance`): inlined where they are called. The C compiler does not always do it by itself,
// in the large functions of a program. A function's size counts the instructions of the small
// ones it calls, so inlining stays bounded. Until nothing changes, so a recursive function is
// never one of them.
function smallFunctions(program: IrProgram): boolean[] {
    mut sizes: int[] = []

    for routine in program.functions {
        sizes.push(-1)
    }

    mut changed = true

    while (changed) {
        changed = false

        for id in range(program.functions.length()) {
            if (sizes[id] >= 0) { continue }

            immut size = inlinedSize(program.functions[id], sizes)

            if (size >= 0) {
                sizes[id] = size
                changed = true
            }
        }
    }

    mut smalls: boolean[] = []

    for size in sizes {
        smalls.push(size >= 0)
    }

    return smalls
}

// The instructions of the function with those of the small functions it calls, or -1 when it is
// not small (`sizes`: those of the small functions found so far, -1 for the others).
function inlinedSize(routine: IrFunction, sizes: int[]): int {
    if (routine.blocks.length() > 4) { return -1 }

    mut count = 0

    for block in routine.blocks {
        for instruction in block.instructions {
            count += 1

            match (instruction) {
                CallIns(_, callee, _, _, _) => {
                    if (sizes[callee] < 0) { return -1 }

                    count += sizes[callee]
                }
                CallClosureIns(_, _, _, _) => return -1
                _ => {}
            }
        }
    }

    return if (count <= 16) { count } else { -1 }
}

function Generator.location(self, line: int): string {
    if (line == 0) { return `"${self.escapedFile}"` }

    return `"${self.escapedFile}:${line}"`
}

function Generator.emitFunction(mut self, id: int, routine: IrFunction) {
    self.file = routine.file
    self.escapedFile = escaped(routine.file)
    self.line(`${signature(id, routine, self.smalls[id])} {`)

    // A parameter the function only reads is borrowed: the caller keeps it alive (borrow.kj).
    // Another one gets a reference of its own, since the function changes it or moves it out. A
    // `mut` parameter is given its own reference by the caller (see `CallIns`).
    self.current = borrowedLocals(routine, self.borrowed[id], self.constants)

    for param in range(routine.params) {
        if (param < routine.writeback.length() and routine.writeback[param]) { continue }

        if (self.current[param]) { continue }

        match (retain(routine.locals[param].ty)) {
            Some(name) => self.line(`    ${name}(l${param});`)
            None => {}
        }
    }

    for local in range(routine.params, routine.locals.length()) {
        immut info = routine.locals[local]
        immut initial = match (info.ty) {
            StrTy => 'NULL'
            ListTy(_) => 'NULL'
            RecordTy(_) => 'NULL'
            BoolTy => 'false'
            FloatTy => '0.0'
            DecimalTy => '{0}'
            _ => '0'
        }
        immut comment = match (info.name) {
            Some(name) => ` // ${name}`
            None => ''
        }
        self.line(`    ${cType(info.ty)} l${local} = ${initial};${comment}`)
    }

    // The memory of the records on the stack (escape.kj).
    self.stack = [:]

    for block in routine.blocks {
        for instruction in block.instructions {
            match (instruction) {
                RecordNewIns(dest, variant, _) if (self.stacks[id].records.has(dest)) => {
                    self.stack[dest] = variant
                    immut fields = self.program.records[recordId(routine.locals[dest].ty)].variants[variant].fields
                    self.line(`    uint64_t s${dest}[${3 + variantWords(fields)}];`)
                }
                _ => {}
            }
        }
    }

    // An alias of a record on the stack is borrowed from it.
    for alias in self.stacks[id].aliases {
        self.current[alias] = true
    }

    self.releases = self.localReleases(routine)
    self.live = lastUses(routine)

    for block in range(routine.blocks.length()) {
        self.line(`b${block}:;`)
        self.block = block

        for position in range(routine.blocks[block].instructions.length()) {
            self.position = position
            self.instruction(routine, routine.blocks[block].instructions[position])
            self.dropDead(routine)
        }

        self.terminator(routine, routine.blocks[block].terminator)
    }

    self.line('}')
}

function operand(value: Operand): string {
    return match (value) {
        LocalOp(id) => `l${id}`
        GlobalOp(id) => `koji_g${id}`
        IntOp(value) => if (value == -9223372036854775807 - 1) { 'INT64_MIN' } else { `INT64_C(${value})` }
        FloatOp(value) => floatDebug(value)
        DecimalOp(negative, high, low, exponent) => decimalConstant(negative, high, low, exponent)
        BoolOp(value) => string(value)
        CharOp(value) => `UINT32_C(${value.code()})`
        StrOp(id) => `koji_s${id}`
        LocationOp(place) => `(int64_t)(intptr_t)"${escaped(place)}"`
    }
}

// A decimal constant: its bits, computed by the C compiler.
function decimalConstant(negative: boolean, high: int, low: int, exponent: int): string {
    return `koji_decimal_literal(${negative}, INT64_C(${high}), INT64_C(${low}), ${exponent})`
}

function place(where: Place): string {
    return match (where) {
        LocalPlace(id) => `l${id}`
        GlobalPlace(id) => `koji_g${id}`
    }
}

function Generator.placeType(self, routine: IrFunction, where: Place): Ty {
    return match (where) {
        LocalPlace(id) => routine.locals[id].ty
        GlobalPlace(id) => self.program.globals[id].ty
    }
}

// `dest = expression`, where `expression` gives a new reference for a managed type.
function Generator.set(mut self, dest: string, ty: Ty, expression: string) {
    match (ty) {
        StrTy => self.line(`    koji_string_set(&${dest}, ${expression});`)
        VoidTy => self.line(`    ${dest} = ${expression};`)
        _ => {
            match (kind(ty)) {
                Some(name) => self.line(`    koji_${name}_set_variable(&${dest}, ${expression});`)
                None => self.line(`    ${dest} = ${expression};`)
            }
        }
    }
}

// The variable that holds the value of `target`, as a `void **` (each step copies a shared list
// or record before giving the slot inside it).
function Generator.path(self, target: Target, line: int): string {
    mut variable = `(void **)&${place(target.root)}`

    for step in target.path {
        variable = match (step) {
            IndexStep(index) => `(void **)koji_list_slot((KojiList **)${variable}, ${operand(index)}, ${self.location(line)})`
            FieldStep(field) => `(void **)koji_record_slot((KojiRecord **)${variable}, ${field})`
            KeyStep(key) => `(void **)koji_map_slot((KojiMap **)${variable}, ${address(key)}, ${self.location(line)})`
        }
    }

    return variable
}

// Writes `value` (a C variable that owns its value) to `target`, giving up its reference.
function Generator.store(mut self, target: Target, ty: Ty, value: string, line: int) {
    if (target.path.length() == 0) {
        self.set(place(target.root), ty, value)
        return
    }

    immut container: Target = { root: target.root, path: target.path[..target.path.length() - 1] }
    immut call = match (target.path[target.path.length() - 1]) {
        IndexStep(index) => `koji_list_set((KojiList **)${self.path(container, line)}, ${operand(index)}, &${value}, ${self.location(line)})`
        FieldStep(field) => `koji_record_set((KojiRecord **)${self.path(container, line)}, ${field}, &${value})`
        KeyStep(key) => `koji_map_set((KojiMap **)${self.path(container, line)}, ${address(key)}, &${value})`
    }
    self.line(`    ${call};`)

    match (release(ty)) {
        Some(name) => self.line(`    ${name}(${value});`)
        None => {}
    }
}

// The variable that holds the list of `target`, as a `KojiList **`.
function Generator.target(self, target: Target, line: int): string {
    return `(KojiList **)${self.path(target, line)}`
}

// The address of an operand that is a local or a global (a key kept in a local), or of a compound
// literal for a constant.
function address(value: Operand): string {
    return match (value) {
        LocalOp(_) => `&${operand(value)}`
        GlobalOp(_) => `&${operand(value)}`
        IntOp(_) => `&(int64_t){ ${operand(value)} }`
        FloatOp(_) => `&(double){ ${operand(value)} }`
        DecimalOp(_, _, _, _) => `(KojiDecimal[]){ ${operand(value)} }`
        BoolOp(_) => `&(bool){ ${operand(value)} }`
        CharOp(_) => `&(uint32_t){ ${operand(value)} }`
        StrOp(_) => `&(KojiString *){ ${operand(value)} }`
        LocationOp(_) => `&(int64_t){ ${operand(value)} }`
    }
}

// Calls `call`, where `VALUE` is the address of `value` (the callee makes its own copy).
function Generator.withAddress(mut self, ty: Ty, value: Operand, call: string) {
    self.line(`    { ${cType(ty)} value = ${operand(value)}; ${call.replace('VALUE', '&value')}; }`)
}

function Generator.operandType(self, routine: IrFunction, value: Operand): Ty {
    return match (value) {
        LocalOp(id) => routine.locals[id].ty
        GlobalOp(id) => self.program.globals[id].ty
        IntOp(_) => IntTy
        FloatOp(_) => FloatTy
        DecimalOp(_, _, _, _) => DecimalTy
        BoolOp(_) => BoolTy
        CharOp(_) => CharTy
        StrOp(_) => StrTy
        LocationOp(_) => IntTy
    }
}

function unaryExpression(op: string, value: string, location: string): string {
    return match (op) {
        'IntNeg' => `koji_int_neg(${value}, ${location})`
        'FloatNeg' => `-(${value})`
        'Not' => `!(${value})`
        'BitNot' => `~(${value})`
        'ByteNot' => `(uint8_t)~(${value})`
        'ByteToInt' => `(int64_t)(${value})`
        'IntToByte' => `koji_int_to_byte(${value}, ${location})`
        'ByteToStr' => `koji_string_from_int((int64_t)(${value}))`
        'IntToFloat' => `(double)${value}`
        'DecimalNeg' => `koji_decimal_neg(${value})`
        'IntToDecimal' => `koji_decimal_from_int(${value})`
        'FloatToDecimal' => `koji_decimal_from_float(${value})`
        'DecimalToFloat' => `koji_decimal_to_float(${value}, ${location})`
        'DecimalToInt' => `koji_decimal_to_int(${value}, 3, ${location})`
        'DecimalToStr' => `koji_string_from_decimal(${value})`
        'IntToStr' => `koji_string_from_int(${value})`
        'FloatToStr' => `koji_string_from_float(${value})`
        'BoolToStr' => `koji_string_from_bool(${value})`
        'CharToStr' => `koji_string_from_char(${value})`
        'FileToStr' => `koji_file_repr(${value})`
        'CharRepr' => `koji_char_repr(${value})`
        'CharCode' => `(int64_t)${value}`
        'ListToStr' => `koji_list_repr(${value})`
        'StrLength' => `koji_string_length(${value})`
        'StrRepr' => `koji_string_repr(${value})`
        'ListLength' => `koji_list_length(${value})`
        'RecordToStr' => `koji_record_display(${value})`
        'RecordRepr' => `koji_record_repr(${value})`
        'RecordTag' => `koji_record_tag(${value})`
        'MapLength' => `koji_map_length(${value})`
        'MapToStr' => `koji_map_repr(${value})`
        'MapKeys' => `koji_map_keys(${value})`
        'MapValues' => `koji_map_values(${value})`
        'SetFromList' => `koji_set_from_list(${value})`
        _ => `koji_closure_repr(${value})`
    }
}

// The C operator of a comparison (`Less` is `<`).
function symbol(comparison: string): string {
    return match (comparison) {
        'Equal' => '=='
        'NotEqual' => '!='
        'Less' => '<'
        'LessEqual' => '<='
        'Greater' => '>'
        _ => '>='
    }
}

// `IntCompare(Less)`: the operation and its comparison.
type Operation = {
    name: string
    comparison: string
}

function operation(op: string): Operation {
    mut found: Operation = { name: op, comparison: '' }

    match (op.indexOf('(')) {
        Some(open) => found = { name: op[..open], comparison: op[open + 1..op.length() - 1] }
        None => {}
    }

    return found
}

function Generator.binary(self, op: string, left: string, right: string, line: int): string {
    immut location = self.location(line)
    immut parts = operation(op)

    return match (parts.name) {
        'IntAdd' => `koji_int_add(${left}, ${right}, ${location})`
        'IntSub' => `koji_int_sub(${left}, ${right}, ${location})`
        'IntMul' => `koji_int_mul(${left}, ${right}, ${location})`
        'IntDiv' => `koji_int_div(${left}, ${right}, ${location})`
        'IntRem' => `koji_int_rem(${left}, ${right}, ${location})`
        'IntPow' => `koji_int_pow(${left}, ${right}, ${location})`
        'BitAnd' => `(${left} & ${right})`
        'BitOr' => `(${left} | ${right})`
        'BitXor' => `(${left} ^ ${right})`
        'ShiftLeft' => `koji_shift_left(${left}, ${right}, ${location})`
        'ShiftRight' => `koji_shift_right(${left}, ${right}, ${location})`
        'FloatAdd' => `koji_float_check(${left} + ${right}, ${location})`
        'FloatSub' => `koji_float_check(${left} - ${right}, ${location})`
        'FloatMul' => `koji_float_check(${left} * ${right}, ${location})`
        'FloatDiv' => `koji_float_div(${left}, ${right}, ${location})`
        'FloatRem' => `koji_float_rem(${left}, ${right}, ${location})`
        'FloatPow' => `koji_float_pow(${left}, ${right}, ${location})`
        'DecimalAdd' => `koji_decimal_plus(${left}, ${right}, ${location})`
        'DecimalSub' => `koji_decimal_sub(${left}, ${right}, ${location})`
        'DecimalMul' => `koji_decimal_mul(${left}, ${right}, ${location})`
        'DecimalDiv' => `koji_decimal_div(${left}, ${right}, ${location})`
        'DecimalRem' => `koji_decimal_rem(${left}, ${right}, ${location})`
        'DecimalPow' => `koji_decimal_pow(${left}, ${right}, ${location})`
        'DecimalPower' => `koji_decimal_power(${left}, ${right}, ${location})`
        'DecimalCompare' => `(koji_decimal_compare(${left}, ${right}) ${symbol(parts.comparison)} 0)`
        name if (name in ['IntCompare', 'FloatCompare', 'BoolCompare', 'CharCompare', 'ByteCompare']) => `(${left} ${symbol(parts.comparison)} ${right})`
        // Bytes: the arithmetic panics outside 0 to 255; the bits stay in 8 bits.
        'ByteAdd' => `koji_byte_add(${left}, ${right}, ${location})`
        'ByteSub' => `koji_byte_sub(${left}, ${right}, ${location})`
        'ByteMul' => `koji_byte_mul(${left}, ${right}, ${location})`
        'ByteDiv' => `koji_byte_div(${left}, ${right}, ${location})`
        'ByteRem' => `koji_byte_rem(${left}, ${right}, ${location})`
        'BytePow' => `koji_byte_pow(${left}, ${right}, ${location})`
        'ByteAnd' => `(uint8_t)(${left} & ${right})`
        'ByteOr' => `(uint8_t)(${left} | ${right})`
        'ByteXor' => `(uint8_t)(${left} ^ ${right})`
        'ByteShiftLeft' => `koji_byte_shift_left(${left}, ${right}, ${location})`
        'ByteShiftRight' => `koji_byte_shift_right(${left}, ${right}, ${location})`
        'StrCompare' => {
            match (parts.comparison) {
                'Equal' => `koji_string_equal(${left}, ${right})`
                'NotEqual' => `!koji_string_equal(${left}, ${right})`
                comparison => `(koji_string_compare(${left}, ${right}) ${symbol(comparison)} 0)`
            }
        }
        'StrConcat' => `koji_string_concat(${left}, ${right})`
        'StrRepeat' => `koji_string_repeat(${left}, ${right})`
        'StrContains' => `koji_string_contains(${right}, ${left})`
        'StrContainsChar' => `koji_string_contains_char(${right}, ${left})`
        'ListConcat' => `koji_list_concat(${left}, ${right})`
        'ListCompare' => if (parts.comparison == 'NotEqual') { `!koji_list_equal(${left}, ${right})` } else { `koji_list_equal(${left}, ${right})` }
        'MapCompare' => if (parts.comparison == 'NotEqual') { `!koji_map_equal(${left}, ${right})` } else { `koji_map_equal(${left}, ${right})` }
        'RecordCompare' => if (parts.comparison == 'NotEqual') { `!koji_record_equal(${left}, ${right})` } else { `koji_record_equal(${left}, ${right})` }
        _ => `koji_list_join(${left}, ${right})`
    }
}

// The positions of `Some` and `None` in an `Option` record.
type OptionVariants = {
    some: int
    none: int
}

function Generator.optionVariants(self, option: int): OptionVariants {
    mut some = 0
    mut none = 0
    immut variants = self.program.records[option].variants

    for i in range(variants.length()) {
        if (variants[i].name == Some('Some')) { some = i }

        if (variants[i].name == Some('None')) { none = i }
    }

    return { some: some, none: none }
}

// The address of field `field` of the record `record` (of type `ty`): where its variant puts it,
// known here when no variant has a field of two words (each field is at its index) or when the
// type has one variant; otherwise the runtime reads it from the description of the variant.
function Generator.fieldSlot(self, ty: Ty, record: string, field: int): string {
    immut variants = self.program.records[recordId(ty)].variants
    mut wide = false

    for variant in variants {
        if (hasWideField(variant.fields)) { wide = true }
    }

    if (not wide) { return `&${record}->words[${field}]` }

    if (variants.length() == 1) {
        mut word = 0

        for index in range(field) {
            word += words(variants[0].fields[index].ty)
        }

        return `&${record}->words[${word}]`
    }

    return `koji_record_get(${record}, ${field})`
}

function recordId(ty: Ty): int {
    return match (ty) {
        RecordTy(id) => id
        _ => 0
    }
}

function Generator.setLocal(mut self, routine: IrFunction, dest: int, expression: string) {
    self.set(`l${dest}`, routine.locals[dest].ty, expression)
}

// `dest = expression`, or the expression as a statement without a destination.
function Generator.result(mut self, routine: IrFunction, dest: Option[int], expression: string) {
    match (dest) {
        Some(local) => self.setLocal(routine, local, expression)
        None => self.line(`    ${expression};`)
    }
}

function Generator.instruction(mut self, routine: IrFunction, instruction: Instruction) {
    match (instruction) {
        CopyIns(dest, value) => {
            immut ty = self.placeType(routine, dest)

            // A borrowed local (borrow.kj), or an alias of a record on the stack (escape.kj): the
            // value, without a reference of its own.
            match (dest) {
                LocalPlace(local) if (self.current[local] and local >= routine.params) => {
                    self.line(`    l${local} = ${operand(value)};`)
                    return
                }
                _ => {}
            }

            // Read for the last time: the reference moves, without retaining and releasing.
            match (self.movable(routine, value)) {
                Some(local) if (dest != LocalPlace(local)) => {
                    self.set(place(dest), ty, `l${local}`)
                    self.line(`    l${local} = NULL;`)
                    return
                }
                _ => {}
            }

            self.set(place(dest), ty, share(ty, operand(value)))
        }
        UnaryIns(dest, op, value, line) => {
            // `text += string(c)`: the next instruction appends the char, without a string for it.
            if (op == 'CharToStr' and self.appendsChar(routine, dest)) {
                self.charLocal = dest
                self.charValue = operand(value)
                return
            }

            self.setLocal(routine, dest, unaryExpression(op, operand(value), self.location(line)))
        }
        BinaryIns(dest, op, left, right, line) => {
            mut expression = ''

            match (op) {
                'MapContains' => expression = `koji_map_contains(${operand(right)}, ${address(left)})`
                'ListIndexOf' => {
                    immut item = itemOf(self.operandType(routine, left))
                    expression = `({ ${cType(item)} item = ${operand(right)}; koji_list_index_of(${operand(left)}, &item); })`
                }
                // The item needs an address.
                'ListContains' => {
                    immut item = itemOf(self.operandType(routine, right))
                    expression = `({ ${cType(item)} item = ${operand(left)}; koji_list_contains(${operand(right)}, &item); })`
                }
                // `text + more` where `text` is read for the last time: the runtime adds to it in
                // place when no one else sees it.
                'StrConcat' => {
                    match (self.movable(routine, left)) {
                        Some(local) if (left != right and dest != local and right == LocalOp(self.charLocal)) => {
                            self.charLocal = -1
                            self.setLocal(routine, dest, `koji_string_append_char(l${local}, ${self.charValue})`)
                            self.line(`    l${local} = NULL;`)
                            return
                        }
                        Some(local) if (left != right and dest != local) => {
                            self.setLocal(routine, dest, `koji_string_append(l${local}, ${operand(right)})`)
                            self.line(`    l${local} = NULL;`)
                            return
                        }
                        _ => expression = self.binary(op, operand(left), operand(right), line)
                    }
                }
                // Against a record on the stack, whose variant is known: its tag, then its fields.
                name if (operation(name).name == 'RecordCompare' and operation(name).comparison in ['Equal', 'NotEqual']) => {
                    immut inline = match (left) {
                        LocalOp(local) if (self.stack.has(local)) => self.stackEqual(routine, operand(right), local)
                        _ => match (right) {
                            LocalOp(local) if (self.stack.has(local)) => self.stackEqual(routine, operand(left), local)
                            _ => None
                        }
                    }

                    expression = match (inline) {
                        Some(test) => if (operation(op).comparison == 'NotEqual') { `!${test}` } else { test }
                        None => self.binary(op, operand(left), operand(right), line)
                    }
                }
                _ => expression = self.binary(op, operand(left), operand(right), line)
            }

            self.setLocal(routine, dest, expression)
        }
        CallIns(dest, callee, args, writebacks, line) => {
            mut values: string[] = []
            // A global given to a borrowed parameter: the function may change the global, so the
            // caller keeps the value alive with a reference of its own during the call.
            mut kept: string[] = []

            for i in range(args.length()) {
                match (args[i]) {
                    GlobalOp(global) if (not self.constants[global] and i < self.borrowed[callee].length() and self.borrowed[callee][i]) => {
                        kept.push(`kept${i}`)
                        values.push(`kept${i}`)
                    }
                    _ => values.push(operand(args[i]))
                }
            }

            // In a C block of their own: the names are reused by the next call.
            if (kept.length() > 0) {
                self.line('    {')

                for i in range(args.length()) {
                    if (`kept${i}` in kept) {
                        immut ty = self.operandType(routine, args[i])
                        self.line(`    ${cType(ty)} kept${i} = ${share(ty, operand(args[i]))};`)
                    }
                }
            }

            // The final values of the `mut` parameters, owned by the caller after the call (in a C
            // block: the names are reused by the next call).
            if (writebacks.length() > 0) { self.line('    {') }

            for writeback in writebacks {
                immut param = writeback.param
                immut ty = self.operandType(routine, args[param])

                // The function owns the value of a `mut` parameter. When the argument is a local
                // variable (not used by another argument), the variable gives it its reference for
                // the call, so that the function changes the value in place instead of copying it;
                // otherwise the function gets a reference of its own.
                if (isManaged(ty)) {
                    mut given = false

                    match (args[param]) {
                        LocalOp(local) => {
                            immut sameRoot = writeback.target.root == LocalPlace(local) and writeback.target.path.length() == 0
                            mut alone = true

                            for i in range(args.length()) {
                                if (i != param and args[i] == LocalOp(local)) { alone = false }
                            }

                            if (sameRoot and alone) {
                                self.line(`    ${cType(ty)} given${param} = l${local};`)
                                self.line(`    l${local} = NULL;`)
                                values[param] = `given${param}`
                                given = true
                            }
                        }
                        _ => {}
                    }

                    if (not given) { values[param] = share(ty, values[param]) }
                }

                immut initial = if (isManaged(ty)) { 'NULL' } else { if (ty == DecimalTy) { '{0}' } else { '0' } }
                self.line(`    ${cType(ty)} back${param} = ${initial};`)
                values.push(`&back${param}`)
            }

            self.result(routine, dest, `${functionName(callee)}(${values.join(', ')})`)

            for writeback in writebacks {
                immut ty = self.operandType(routine, args[writeback.param])
                self.store(writeback.target, ty, `back${writeback.param}`, line)
            }

            if (writebacks.length() > 0) { self.line('    }') }

            for i in range(args.length()) {
                if (`kept${i}` in kept) {
                    match (release(self.operandType(routine, args[i]))) {
                        Some(name) => self.line(`    ${name}(kept${i});`)
                        None => {}
                    }
                }
            }

            if (kept.length() > 0) { self.line('    }') }
        }
        ListNewIns(dest, items) => {
            immut ty = routine.locals[dest].ty
            immut element = itemOf(ty)
            self.set(`l${dest}`, ty, `koji_list_new(${elementType(element)}, ${items.length()})`)

            for item in items {
                self.withAddress(element, item, `koji_list_push(&l${dest}, VALUE)`)
            }
        }
        ListGetIns(dest, list, index, line) => {
            immut ty = routine.locals[dest].ty
            immut item = `*(${cType(ty)} const *)koji_list_get(${operand(list)}, ${operand(index)}, ${self.location(line)})`

            // Borrowed: the list keeps the item alive (borrow.kj).
            if (self.current[dest]) {
                self.line(`    l${dest} = ${item};`)
                return
            }

            self.set(`l${dest}`, ty, share(ty, item))
        }
        // In place when the list is not shared and the index is in it; the runtime copies the
        // list, or panics, otherwise.
        ListSetIns(list, index, value, line) => {
            immut ty = self.operandType(routine, value)
            immut c = cType(ty)
            immut moved = match (self.movable(routine, value)) {
                Some(local) if (not targetReads(list, local) and LocalOp(local) != index) => Some(local)
                _ => None
            }
            immut fresh = match (moved) {
                Some(local) => `l${local}`
                None => share(ty, operand(value))
            }
            self.line(`    { ${c} fresh = ${fresh}; int64_t at = ${operand(index)};`)

            match (moved) {
                Some(local) => self.line(`    l${local} = NULL;`)
                None => {}
            }

            self.line(`    KojiList **variable = ${self.target(list, line)}; KojiList *items = *variable;`)
            match (release(ty)) {
                Some(name) => {
                    self.line(`    if (items->references == 1 && (uint64_t)at < items->length) { ${c} *slot = (${c} *)&items->items[at * ${words(ty)}]; ${c} old = *slot; *slot = fresh; ${name}(old); }`)
                    self.line(`    else { koji_list_set(variable, at, &fresh, ${self.location(line)}); ${name}(fresh); } }`)
                }
                None => {
                    self.line(`    if (items->references == 1 && (uint64_t)at < items->length) *(${c} *)&items->items[at * ${words(ty)}] = fresh;`)
                    self.line(`    else koji_list_set(variable, at, &fresh, ${self.location(line)}); }`)
                }
            }
        }
        // In place when the list is not shared and has room; the runtime grows it otherwise.
        ListPushIns(list, value, line) => {
            immut ty = self.operandType(routine, value)
            immut c = cType(ty)
            self.line(`    { ${c} fresh = ${share(ty, operand(value))}; KojiList **variable = ${self.target(list, line)}; KojiList *items = *variable;`)
            // A bool or a char does not fill its word: the rest is zero, as the runtime writes it.
            immut clear = if (ty == BoolTy or ty == CharTy or ty == ByteTy) { 'items->items[items->length] = 0; ' } else { '' }
            self.line(`    if (items->references == 1 && (items->length + 1) * ${words(ty)} <= items->capacity) { ${clear}*(${c} *)&items->items[items->length * ${words(ty)}] = fresh; items->length++; }`)

            match (release(ty)) {
                Some(name) => self.line(`    else { koji_list_push(variable, &fresh); ${name}(fresh); } }`)
                None => self.line('    else koji_list_push(variable, &fresh); }')
            }
        }
        ListInsertIns(list, index, value, line) => {
            immut ty = self.operandType(routine, value)
            self.withAddress(ty, value, `koji_list_insert(${self.target(list, line)}, ${operand(index)}, VALUE, ${self.location(line)})`)
        }
        ListSortIns(list, line) => self.line(`    koji_list_sort(${self.target(list, line)});`)
        ListSliceIns(dest, list, start, end, line) => {
            immut first = match (start) {
                Some(bound) => `true, ${operand(bound)}`
                None => 'false, 0'
            }
            immut last = match (end) {
                Some(bound) => `true, ${operand(bound)}`
                None => 'false, 0'
            }
            self.setLocal(routine, dest, `koji_list_slice(${operand(list)}, ${first}, ${last}, ${self.location(line)})`)
        }
        RecordNewIns(dest, variant, fields) => {
            immut ty = routine.locals[dest].ty
            immut record = recordId(ty)
            immut fieldTypes = self.program.records[record].variants[variant].fields

            // On the stack: the fields of the record built before are released.
            if (self.stack.has(dest)) {
                self.releaseFields(routine, dest)
                self.line(`    l${dest} = koji_record_at(s${dest}, &koji_record_${record}, ${variant}, ${variantWords(fieldTypes)});`)
            } else {
                self.set(`l${dest}`, ty, `koji_record_make(&koji_record_${record}, ${variant}, ${variantWords(fieldTypes)})`)
            }

            // Each field is written in place, at the word the variant puts it; a value read for the
            // last time (and by one field only) moves into it.
            mut word = 0

            for index in range(fields.length()) {
                if (index >= fieldTypes.length()) { break }

                immut fieldType = fieldTypes[index].ty
                immut offset = word
                word += words(fieldType)

                if (fieldType == VoidTy) { continue }

                immut value = fields[index]
                mut count = 0

                for other in fields {
                    if (other == value) { count += 1 }
                }

                immut slot = `*(${cType(fieldType)} *)&l${dest}->words[${offset}]`

                match (self.movable(routine, value)) {
                    Some(local) if (count == 1 and local != dest) => {
                        self.line(`    ${slot} = l${local};`)
                        self.line(`    l${local} = NULL;`)
                    }
                    _ => self.line(`    ${slot} = ${share(fieldType, operand(value))};`)
                }
            }
        }
        FieldGetIns(dest, record, field) => {
            immut ty = routine.locals[dest].ty
            immut value = `*(${cType(ty)} const *)${self.fieldSlot(self.operandType(routine, record), operand(record), field)}`

            // Borrowed: the record keeps the value alive (borrow.kj).
            if (self.current[dest]) {
                self.line(`    l${dest} = ${value};`)
                return
            }

            self.set(`l${dest}`, ty, share(ty, value))
        }
        // In place: the record is copied first only when it is shared; the new value is written,
        // then the old one released (the new one may be computed from it).
        FieldSetIns(record, field, value, line) => {
            immut ty = self.operandType(routine, value)
            immut c = cType(ty)
            // The value is taken before the record is unshared: `r.next = r` keeps the old record.
            immut moved = match (self.movable(routine, value)) {
                Some(local) if (not targetReads(record, local)) => Some(local)
                _ => None
            }
            immut fresh = match (moved) {
                Some(local) => `l${local}`
                None => share(ty, operand(value))
            }
            self.line(`    { ${c} fresh = ${fresh};`)

            match (moved) {
                Some(local) => self.line(`    l${local} = NULL;`)
                None => {}
            }

            self.line(`    KojiRecord **variable = (KojiRecord **)${self.path(record, line)};`)
            self.line(`    if ((*variable)->references > 1) koji_record_unshare(variable);`)

            // A variable itself: its type, so the place of the field, is known.
            immut slot = if (record.path.length() == 0) { self.fieldSlot(self.placeType(routine, record.root), '(*variable)', field) } else { `koji_record_get(*variable, ${field})` }
            self.line(`    ${c} *slot = (${c} *)${slot};`)
            self.line(`    ${c} old = *slot;`)
            self.line(`    *slot = fresh;`)

            match (release(ty)) {
                Some(name) => self.line(`    ${name}(old); }`)
                None => self.line('    (void)old; }')
            }
        }
        ListRemoveIns(dest, list, index, line) => {
            immut option = recordId(routine.locals[dest].ty)
            immut positions = self.optionVariants(option)
            immut itemType = self.program.records[option].variants[positions.some].fields[0].ty
            immut remove = match (index) {
                Some(position) => `koji_list_remove(${self.target(list, line)}, ${operand(position)}, &item)`
                None => `koji_list_pop(${self.target(list, line)}, &item)`
            }
            // The list gives its reference to the item; the record takes its own.
            immut releaseItem = match (release(itemType)) {
                Some(name) => ` ${name}(item);`
                None => ''
            }
            self.line(`    { ${cType(itemType)} item; KojiRecord *option; if (${remove}) { option = koji_record_new(&koji_record_${option}, ${positions.some}); koji_record_init(option, 0, &item);${releaseItem} } else { option = koji_record_new(&koji_record_${option}, ${positions.none}); } koji_record_set_variable(&l${dest}, option); }`)
        }
        StdCallIns(dest, name, args) => {
            mut values: string[] = []

            for arg in args {
                values.push(match (arg) {
                    ValueArg(value) => operand(value)
                    ModeArg(mode) => string(mode)
                    RecordArg(record) => `&koji_record_${record}`
                    ElementArg(ty) => elementType(ty)
                    LocationArg(line) => self.location(line)
                    PlaceArg(value) => `(const char *)(intptr_t)${operand(value)}`
                    NullArg => 'NULL'
                })
            }

            // A C function of an `extern` declaration: an `Address` is a `void *` for it.
            match (self.externOf(name)) {
                Some(found) => {
                    for i in range(values.length()) {
                        if (i >= found.params.length()) { continue }

                        if (found.params[i] == 'const void *') { values[i] = `(const void *)(intptr_t)${values[i]}` }

                        if (found.params[i] == 'const char *') { values[i] = `(const char *)(intptr_t)${values[i]}` }
                    }

                    immut call = `${name}(${values.join(', ')})`
                    self.result(routine, dest, if (found.returns == 'void *') { `(int64_t)(intptr_t)${call}` } else { call })
                    return
                }
                None => {}
            }

            self.result(routine, dest, `${name}(${values.join(', ')})`)
        }
        TakeIns(dest, source) => {
            self.set(`l${dest}`, routine.locals[dest].ty, place(source))
            self.line(`    ${place(source)} = NULL;`)
        }
        DropIns(value, dropper) => {
            immut name = match (release(self.placeType(routine, value))) {
                Some(found) => found
                None => ''
            }
            immut variable = place(value)
            self.line(`    if (${variable}) { ${functionName(dropper)}(${variable}); ${name}(${variable}); ${variable} = NULL; }`)
        }
        MakeClosureIns(dest, code, environment) => {
            immut captured = match (environment) {
                Some(value) => `koji_record_share(${operand(value)})`
                None => 'NULL'
            }
            immut name = cString(self.program.functions[code].name)
            self.setLocal(routine, dest, `koji_closure_new((const void *)${functionName(code)}, ${captured}, ${name})`)
        }
        CallClosureIns(dest, closure, args, _) => {
            mut params: Ty[] = []
            mut returns = VoidTy

            match (self.operandType(routine, closure)) {
                FunctionTy(types, returned) => {
                    params = types
                    returns = returned
                }
                _ => {}
            }

            mut types = ['KojiRecord *']

            for param in params {
                types.push(cType(param))
            }

            immut callee = operand(closure)
            mut values = [`koji_closure_environment(${callee})`]

            for arg in args {
                values.push(operand(arg))
            }

            self.result(routine, dest, `((${cType(returns)} (*)(${types.join(', ')}))koji_closure_code(${callee}))(${values.join(', ')})`)
        }
        ListSortByIns(list, comparison, line) => {
            mut before = 'int'

            match (self.operandType(routine, comparison)) {
                FunctionTy(params, _) => {
                    before = match (params[0]) {
                        IntTy => 'int'
                        FloatTy => 'float'
                        DecimalTy => 'decimal'
                        BoolTy => 'bool'
                        CharTy => 'char'
                        ByteTy => 'byte'
                        StrTy => 'string'
                        ListTy(_) => 'list'
                        RecordTy(_) => 'record'
                        _ => 'map'
                    }
                }
                _ => {}
            }

            self.line(`    koji_list_sort_by(${self.target(list, line)}, ${operand(comparison)}, koji_before_${before});`)
        }
        MapNewIns(dest, entries) => {
            immut ty = routine.locals[dest].ty
            mut keyType = VoidTy
            mut valueType = VoidTy

            match (ty) {
                MapTy(key, value) => {
                    keyType = key
                    valueType = value
                }
                _ => {}
            }

            self.set(`l${dest}`, ty, `koji_map_new(${elementType(keyType)}, ${elementType(valueType)})`)

            for entry in entries {
                self.line(`    { ${cType(keyType)} key = ${operand(entry.key)}; ${cType(valueType)} value = ${operand(entry.value)}; koji_map_set(&l${dest}, &key, &value); }`)
            }
        }
        MapGetIns(dest, map, key, line) => {
            immut ty = routine.locals[dest].ty
            immut value = `*(${cType(ty)} const *)koji_map_get(${operand(map)}, ${address(key)}, ${self.location(line)})`
            self.set(`l${dest}`, ty, share(ty, value))
        }
        MapLookupIns(dest, map, key) => {
            immut option = recordId(routine.locals[dest].ty)
            immut positions = self.optionVariants(option)
            self.line(`    { const void *found = koji_map_find(${operand(map)}, ${address(key)}); KojiRecord *option = koji_record_new(&koji_record_${option}, found ? ${positions.some} : ${positions.none}); if (found) koji_record_init(option, 0, found); koji_record_set_variable(&l${dest}, option); }`)
        }
        MapSetIns(target, key, value, line) => {
            immut map = `(KojiMap **)${self.path(target, line)}`

            match (value) {
                Some(stored) => {
                    immut ty = self.operandType(routine, stored)
                    self.withAddress(ty, stored, `koji_map_set(${map}, ${address(key)}, VALUE)`)
                }
                None => self.line(`    koji_map_set(${map}, ${address(key)}, NULL);`)
            }
        }
        MapRemoveIns(dest, target, key, line) => {
            immut map = `(KojiMap **)${self.path(target, line)}`

            match (routine.locals[dest].ty) {
                RecordTy(option) => {
                    immut positions = self.optionVariants(option)
                    immut valueType = self.program.records[option].variants[positions.some].fields[0].ty
                    immut releaseValue = match (release(valueType)) {
                        Some(name) => ` ${name}(value);`
                        None => ''
                    }
                    self.line(`    { ${cType(valueType)} value; KojiRecord *option; if (koji_map_remove(${map}, ${address(key)}, &value)) { option = koji_record_new(&koji_record_${option}, ${positions.some}); koji_record_init(option, 0, &value);${releaseValue} } else { option = koji_record_new(&koji_record_${option}, ${positions.none}); } koji_record_set_variable(&l${dest}, option); }`)
                }
                _ => self.line(`    l${dest} = koji_map_remove(${map}, ${address(key)}, NULL);`)
            }
        }
        FailIns(message, line) => self.line(`    koji_fail(${self.location(line)}, ${operand(message)});`)
        PrintIns(value, line) => self.line(`    koji_print(${operand(value)}, ${self.location(line)});`)
        RangeCheckIns(step, line) => {
            self.line(`    if (${operand(step)} == 0) koji_panic(${self.location(line)}, "range() step cannot be 0");`)
        }
        RangeNextIns(hasValue, value, next, end, step, done) => {
            self.line(`    l${hasValue} = koji_range_next(&l${next}, ${operand(end)}, ${operand(step)}, &l${done}, &l${value});`)
        }
    }
}

// Releases the values the function owns (before it returns).
// The local of `value` when this instruction reads it for the last time and owns it (not a
// borrowed or a `mut` parameter, of a managed type): its reference can move.
// The target is reached through the local (its root, or a key or index of its path).
function targetReads(target: Target, local: int): boolean {
    match (target.root) {
        LocalPlace(id) => if (id == local) { return true }
        GlobalPlace(_) => {}
    }

    for part in target.path {
        immut step = match (part) {
            IndexStep(index) => index
            KeyStep(key) => key
            FieldStep(_) => continue
        }

        if (step == LocalOp(local)) { return true }
    }

    return false
}

// Releases the values the current instruction read for the last time, instead of at the end of
// the function: a list or a map no one else sees can then change in place (`self.ids[key] = id`
// after `self.ids.get(key)`). Not a borrowed local, a record on the stack (its fields are
// released with it), or a `mut` parameter, which goes back to the caller.
function Generator.dropDead(mut self, routine: IrFunction) {
    for local in self.live[self.block][self.position] {
        if (self.current[local] or self.stack.has(local)) { continue }

        if (local < routine.writeback.length() and routine.writeback[local]) { continue }

        match (release(routine.locals[local].ty)) {
            Some(name) => self.line(`    ${name}(l${local}); l${local} = NULL;`)
            None => {}
        }
    }
}

// Whether the instruction after the current one appends the string `local` (read for the last
// time) to a string it can add to in place (see `StrConcat`).
function Generator.appendsChar(mut self, routine: IrFunction, local: int): boolean {
    immut instructions = routine.blocks[self.block].instructions

    if (self.position + 1 >= instructions.length()) { return false }

    match (instructions[self.position + 1]) {
        BinaryIns(dest, 'StrConcat', left, LocalOp(right), _) if (right == local and left != LocalOp(local)) => {
            if (not (local in self.live[self.block][self.position + 1])) { return false }

            self.position += 1
            immut moved = self.movable(routine, left)
            self.position -= 1

            return match (moved) {
                Some(found) => found != dest
                None => false
            }
        }
        _ => return false
    }
}

function Generator.movable(self, routine: IrFunction, value: Operand): Option[int] {
    immut local = match (value) {
        LocalOp(id) => id
        _ => return None
    }

    if (not isManaged(routine.locals[local].ty)) { return None }

    // A borrowed local is not the function's to give away.
    if (self.current[local]) { return None }

    if (local < routine.writeback.length() and routine.writeback[local]) { return None }

    if (not (local in self.live[self.block][self.position])) { return None }

    return Some(local)
}

// `other == local`, for a record on the stack: the same tag, and fields equal one by one, when
// they are ints, bools, chars or strings (None otherwise: the runtime compares them).
function Generator.stackEqual(self, routine: IrFunction, other: string, local: int): Option[string] {
    immut variant = self.stack[local]
    immut fields = self.program.records[recordId(routine.locals[local].ty)].variants[variant].fields
    mut tests = [`(${other})->tag == ${variant}`]
    mut word = 0

    for field in fields {
        immut c = cType(field.ty)
        immut mine = `*(${c} *)&l${local}->words[${word}]`
        immut theirs = `*(${c} *)&(${other})->words[${word}]`

        match (field.ty) {
            IntTy => tests.push(`${mine} == ${theirs}`)
            BoolTy => tests.push(`${mine} == ${theirs}`)
            CharTy => tests.push(`${mine} == ${theirs}`)
            ByteTy => tests.push(`${mine} == ${theirs}`)
            StrTy => tests.push(`koji_string_equal(${mine}, ${theirs})`)
            VoidTy => {}
            _ => return None
        }

        word += words(field.ty)
    }

    return Some(`(${tests.join(' && ')})`)
}

// Releases the fields of the record on the stack in `local`, if it was built.
function Generator.releaseFields(mut self, routine: IrFunction, local: int) {
    match (self.fieldReleases(routine, local)) {
        Some(text) => self.line(text)
        None => {}
    }
}

function Generator.fieldReleases(self, routine: IrFunction, local: int): Option[string] {
    immut fields = self.program.records[recordId(routine.locals[local].ty)].variants[self.stack[local]].fields
    mut releases: string[] = []
    mut word = 0

    for field in fields {
        match (release(field.ty)) {
            Some(name) => releases.push(`${name}(*(${cType(field.ty)} *)&l${local}->words[${word}]);`)
            None => {}
        }

        word += words(field.ty)
    }

    if (releases.length() == 0) { return None }

    return Some(`    if (l${local}) { ${releases.join(' ')} }`)
}

// The lines that release the locals of the function (written at each `return`).
function Generator.localReleases(self, routine: IrFunction): string[] {
    mut lines: string[] = []

    for id in range(routine.locals.length()) {
        // A borrowed local is not the function's to release.
        if (self.current[id]) { continue }

        // A record on the stack has only its fields to release.
        if (self.stack.has(id)) {
            match (self.fieldReleases(routine, id)) {
                Some(text) => lines.push(text)
                None => {}
            }

            continue
        }

        match (release(routine.locals[id].ty)) {
            Some(name) => lines.push(`    ${name}(l${id});`)
            None => {}
        }
    }

    return lines
}

function Generator.releaseLocals(mut self, routine: IrFunction) {
    for text in self.releases {
        self.line(text)
    }
}

function Generator.terminator(mut self, routine: IrFunction, terminator: Terminator) {
    match (terminator) {
        GotoT(block) => self.line(`    goto b${block};`)
        BranchT(condition, thenBlock, elseBlock) => self.line(`    if (${operand(condition)}) goto b${thenBlock}; else goto b${elseBlock};`)
        ReturnT(value) => {
            // The `mut` parameters give their final values back: they move out, unless the value
            // returned is one of them.
            for param in range(routine.writeback.length()) {
                if (not routine.writeback[param]) { continue }

                immut local = `l${param}`
                immut ty = routine.locals[param].ty

                if (isManaged(ty) and value != Some(LocalOp(param))) {
                    self.line(`    *out${param} = ${local};`)
                    self.line(`    ${local} = NULL;`)
                } else {
                    self.line(`    *out${param} = ${share(ty, local)};`)
                }
            }

            match (value) {
                // The result is computed before the locals are released: it may be one of them.
                Some(returned) => {
                    // A local returned moves out of the function, which ends.
                    immut owned = match (returned) {
                        LocalOp(local) => isManaged(routine.locals[local].ty) and not self.current[local] and not (local < routine.writeback.length() and routine.writeback[local])
                        _ => false
                    }

                    if (owned) {
                        self.line(`    { ${cType(routine.returns)} result = ${operand(returned)};`)
                        self.line(`    ${operand(returned)} = NULL;`)
                        self.releaseLocals(routine)
                        self.line('    return result; }')
                        return
                    }

                    self.line(`    { ${cType(routine.returns)} result = ${share(routine.returns, operand(returned))};`)
                    self.releaseLocals(routine)
                    self.line('    return result; }')
                }
                None => {
                    self.releaseLocals(routine)
                    self.line('    return;')
                }
            }
        }
        UnreachableT => self.line(`    koji_panic(${cString(self.file)}, "the function ended without returning a value");`)
    }
}
