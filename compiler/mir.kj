// The machine IR (see "A machine IR between the IR and the processors" in doc/design.md): what the
// native backend generates for a function, knowing no processor. Values are in virtual registers
// (words or floats, unbounded in number), which the register allocator (regalloc.kj) gives
// registers of the processor or slots of the frame; an emitter (x64.kj) encodes the instructions.

// A value an instruction reads: a virtual register, or a constant of a word.
export type MValue = {
    MReg(id: int)
    MImm(value: int)
}

// Where a load or a store reads or writes memory.
export type MAddress = {
    // [register + offset]
    MBase(base: int, offset: int)
    // [base + index * scale + offset], scale 1, 2, 4 or 8.
    MIndexed(base: int, index: int, scale: int, offset: int)
    // A slot of the frame (its number), plus an offset.
    MSlot(slot: int, offset: int)
    // A symbol, or a section of the object (`.rodata`, `.data`, `.bss`), plus an offset.
    MSymbol(name: string, offset: int)
    // A text of the constants of the object, ended by 0 (the place of a call, for its panics).
    MText(text: string)
    // The code of a function of the program (its number), for its address.
    MCode(id: int)
    // The word of the table of the linker (the GOT) that holds the address of a symbol of a library
    // (a variable of C).
    MGot(name: string)
}

export type MCallee = {
    // A function of the program (its number in the IR).
    MFunction(id: int)
    // A function of another object (the runtime library, C), by its name.
    MExternal(name: string)
    // One of C that takes as many arguments as it is given after its `fixed` ones (on x86-64, al
    // tells how many are in vector registers; on arm64 for macOS, those after go on the stack). On
    // Windows, every function of C is called as one, by the convention of Windows.
    MVariadic(name: string, fixed: int)
    // The code at the address in a register.
    MIndirect(value: MValue)
}

// The conditions of comparisons: signed (`lt`, `le`, `gt`, `ge`), unsigned (`b`, `be`, `a`, `ae`),
// and `eq`, `ne`; between floats, `lt`, `le`, `gt`, `ge`, `eq`, `ne` as numbers.
export type MInstruction = {
    MMove(dest: int, value: MValue)
    // A load of 1, 4 or 8 bytes, zero-extended.
    MLoad(dest: int, at: MAddress, width: int)
    MStore(at: MAddress, value: MValue, width: int)
    MAddressOf(dest: int, at: MAddress)
    // `add`, `sub`, `mul`, `and`, `or`, `xor`, `shl`, `sar`, `shr` (by a constant or a register),
    // `div`, `rem` (signed); `check` is the panic of an overflow (a signed one; for `div` and `rem`
    // the overflow of int.min / -1), or -1. On floats: `fadd`, `fsub`, `fmul`, `fdiv`, `check` the
    // panic of a result that is not finite (a float has no infinity).
    MBinary(dest: int, op: string, left: MValue, right: MValue, check: int)
    // `neg` (checked like an operation), `not` (of the bits), `sext32` (the low 32 bits
    // sign-extended: an `int` of C); `fneg`, `itof` (an int to the nearest
    // float), `ftoi` (a float truncated to an int), `fcheck` (a copy of a float that panics with
    // `check` when it is not finite).
    MUnary(dest: int, op: string, value: MValue, check: int)
    // 1 when the condition holds between the values, else 0.
    MSet(dest: int, condition: string, left: MValue, right: MValue)
    // A call by the convention of the system; the classes of the registers are those of the
    // function (`MFunction.floats`).
    MCall(callee: MCallee, args: MValue[], results: int[])
    // The panic `panic` when the condition holds.
    MPanicIf(condition: string, left: MValue, right: MValue, panic: int)
    // The check of the task that ran long (KOJI_PREEMPT), a call when the flag is set: it keeps
    // every register (the emitter saves those alive).
    MPreempt
    // An operation on values of two words (low, high: a U128): `add`, `sub`, `mul` (modulo 2^128),
    // `shl`, `shr` (by the low word of `right`, 0 to 127), the results `dests` (low, high); `below`,
    // `aboveEqual` (unsigned comparisons), 1 or 0 in the one of `dests`; `product` (the 128 bits of
    // the product of the low words); `zeros` (the zeros before the first bit set, 128 for none).
    MWide(dests: int[], op: string, left: MValue[], right: MValue[])
    // An instruction of the processor `koji:unsafe` names: `bswap` (the bytes of a word reversed),
    // `aesAvailable` (AES-NI, PCLMULQDQ and SSSE3), `aesRound`, `aesLastRound` (of a state and a key
    // of two words each), `carryless` (the product of two words without carries, two words),
    // `floatControl` (the controls of the floats, written at the address given), `valgrind` (a
    // request at the address given, `otherwise` its answer when not under valgrind).
    MMachine(dests: int[], op: string, args: MValue[])
    // The arguments of the next call (their positions) that start a value of two words: by the
    // convention, one that does not fit whole in the registers goes on the stack whole; those of
    // `aligned` (U128) start at an even register on arm64.
    MPairs(starts: int[], aligned: int[])
    // A reference more to the value at the address (none for 0): its first word counts them.
    MRetain(value: MValue)
    // A reference less, the last one freeing the value (koji_<kind>_free; a record by its type),
    // which keeps every register like MPreempt.
    MRelease(value: MValue, kind: string)
}

export type MTerminator = {
    MJump(target: int)
    MBranch(condition: string, left: MValue, right: MValue, thenBlock: int, elseBlock: int)
    MReturn(values: MValue[])
    MUnreachable
    // To `targets[value]` for a value from 0 to their number less one, else to `otherwise` (a table
    // of jumps).
    MSwitch(value: MValue, targets: int[], otherwise: int)
}

export type MBlock = {
    instructions: MInstruction[]
    terminator: MTerminator
}

// A panic of a check: where (the text of its place) and what.
export type MPanic = {
    location: string
    message: string
}

export type MFunctionCode = {
    name: string
    // The virtual registers of the parameters, in order (a value of two words is two).
    params: int[]
    // For each virtual register, whether it holds a float.
    floats: boolean[]
    blocks: MBlock[]
    // The bytes of each slot of the frame.
    slots: int[]
    panics: MPanic[]
    // The classes of the results (floats or words), for the return.
    results: boolean[]
    // The parameters (their positions in `params`) that start a value of two words, and those of
    // them aligned on 16 bytes (see `MPairs`).
    pairs: int[]
    aligned: int[]
    // The blocks rarely run (panics, slow paths): their calls save the registers alive across them
    // themselves, so that the allocator does not count them (see `allocate`).
    cold: boolean[]
}

// The text of a function of the machine IR (`kojic dump mir`).
export function mirText(code: MFunctionCode): string[] {
    mut lines: string[] = []
    mut params: string[] = []

    for param in code.params {
        params.push(registerText(param, code))
    }

    lines.push(`function ${code.name}(${params.join(', ')})`)

    for i in range(code.slots.length()) {
        lines.push(`    slot s${i}: ${code.slots[i]} bytes`)
    }

    for i in range(code.blocks.length()) {
        lines.push(`  b${i}:`)

        for instruction in code.blocks[i].instructions {
            lines.push(`    ${instructionText(instruction, code)}`)
        }

        lines.push(`    ${terminatorText(code.blocks[i].terminator, code)}`)
    }

    return lines
}

function registerText(id: int, code: MFunctionCode): string {
    return if (id < code.floats.length() and code.floats[id]) { `f${id}` } else { `r${id}` }
}

function valueText(value: MValue, code: MFunctionCode): string {
    return match (value) {
        MReg(id) => registerText(id, code)
        MImm(number) => string(number)
    }
}

function addressText(at: MAddress, code: MFunctionCode): string {
    return match (at) {
        MBase(base, offset) => `[${registerText(base, code)} + ${offset}]`
        MIndexed(base, index, scale, offset) => `[${registerText(base, code)} + ${registerText(index, code)} * ${scale} + ${offset}]`
        MSlot(slot, offset) => `[s${slot} + ${offset}]`
        MSymbol(name, offset) => `[${name} + ${offset}]`
        MText(text) => `[text '${text}']`
        MCode(id) => `[f${id}]`
        MGot(name) => `[got ${name}]`
    }
}

function instructionText(instruction: MInstruction, code: MFunctionCode): string {
    return match (instruction) {
        MMove(dest, value) => `${registerText(dest, code)} = ${valueText(value, code)}`
        MLoad(dest, at, width) => `${registerText(dest, code)} = load${width} ${addressText(at, code)}`
        MStore(at, value, width) => `store${width} ${addressText(at, code)}, ${valueText(value, code)}`
        MAddressOf(dest, at) => `${registerText(dest, code)} = address ${addressText(at, code)}`
        MBinary(dest, op, left, right, check) => `${registerText(dest, code)} = ${op} ${valueText(left, code)}, ${valueText(right, code)}${checkText(check)}`
        MUnary(dest, op, value, check) => `${registerText(dest, code)} = ${op} ${valueText(value, code)}${checkText(check)}`
        MSet(dest, condition, left, right) => `${registerText(dest, code)} = set ${condition} ${valueText(left, code)}, ${valueText(right, code)}`
        MCall(callee, args, results) => {
            mut values: string[] = []

            for arg in args {
                values.push(valueText(arg, code))
            }

            mut written: string[] = []

            for result in results {
                written.push(registerText(result, code))
            }

            immut target = match (callee) {
                MFunction(id) => `f${id}`
                MExternal(name) => name
                MVariadic(name, fixed) => `${name}(${fixed}...)`
                MIndirect(value) => `*${valueText(value, code)}`
            }
            immut prefix = if (written.length() > 0) { `${written.join(', ')} = ` } else { '' }
            `${prefix}call ${target}(${values.join(', ')})`
        }
        MPanicIf(condition, left, right, panic) => `panic p${panic} if ${condition} ${valueText(left, code)}, ${valueText(right, code)}`
        MPreempt => 'preempt'
        MWide(dests, op, left, right) => {
            mut written: string[] = []

            for dest in dests {
                written.push(registerText(dest, code))
            }

            mut read: string[] = []

            for value in left + right {
                read.push(valueText(value, code))
            }

            `${written.join(', ')} = wide ${op} ${read.join(', ')}`
        }
        MPairs(starts, aligned) => `pairs ${starts} ${aligned}`
        MMachine(dests, op, args) => {
            mut written: string[] = []

            for dest in dests {
                written.push(registerText(dest, code))
            }

            mut read: string[] = []

            for value in args {
                read.push(valueText(value, code))
            }

            `${written.join(', ')} = machine ${op} ${read.join(', ')}`
        }
        MRetain(value) => `retain ${valueText(value, code)}`
        MRelease(value, kind) => `release ${kind} ${valueText(value, code)}`
    }
}

function checkText(check: int): string {
    return if (check >= 0) { ` (panic p${check})` } else { '' }
}

function terminatorText(terminator: MTerminator, code: MFunctionCode): string {
    return match (terminator) {
        MJump(target) => `jump b${target}`
        MBranch(condition, left, right, thenBlock, elseBlock) => `branch ${condition} ${valueText(left, code)}, ${valueText(right, code)}, b${thenBlock}, b${elseBlock}`
        MReturn(values) => {
            mut texts: string[] = []

            for value in values {
                texts.push(valueText(value, code))
            }

            `return ${texts.join(', ')}`
        }
        MUnreachable => 'unreachable'
        MSwitch(value, targets, otherwise) => {
            mut names: string[] = []

            for target in targets {
                names.push(`b${target}`)
            }

            `switch ${valueText(value, code)}, [${names.join(', ')}], b${otherwise}`
        }
    }
}

// What an emitter (x64.kj, a64.kj) gives for a function: its bytes, with the relocations, the calls of
// other functions of the program and the texts that the object holds (native.kj puts them in it).

// A relocation of the code: at an offset, to a symbol or a section, of a kind of ELF.
export type EmittedRelocation = {
    at: int
    symbol: string
    kind: int
    addend: int
}

// A call of a function of the program (its number), or a reference to a text of the constants:
// where, and the kind of the relocation (0 on x86-64: a displacement of 32 bits from its end, which
// native.kj patches).
export type EmittedUse = {
    at: int
    target: int
    kind: int
}

export type EmittedText = {
    at: int
    text: string
    kind: int
}

export type Emitted = {
    code: byte[]
    relocations: EmittedRelocation[]
    calls: EmittedUse[]
    texts: EmittedText[]
}
