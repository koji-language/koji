// Borrowed parameters: a parameter whose value the function only reads is borrowed from the caller,
// which keeps it alive during the call, so the function neither retains nor releases it. Only the
// value of a global could die during the call (the function may change the global): the caller
// keeps a reference of its own to a global it passes (see `CallIns` in cgen.kj).
//
// A local is borrowed the same way when it is only given values read from something that stays
// as it is during the call (a borrowed parameter, such a local, or a global that never changes):
// a field, an item of a list, or the value itself. What it was read from keeps the value alive
// (see `FieldGetIns`, `ListGetIns` and `CopyIns` in cgen.kj).

import { Ty, Operand, Place, Target, Instruction, IrFunction, IrProgram, isManaged } from 'ir.kj'

// For each function, which of its parameters are borrowed.
export function borrowedParams(program: IrProgram): boolean[][] {
    // A function called through a closure is called by code that does not know it: its
    // parameters are owned, as before.
    mut closures: Set[int] = Set.from([])

    for routine in program.functions {
        for block in routine.blocks {
            for instruction in block.instructions {
                match (instruction) {
                    MakeClosureIns(_, code, _) => closures.add(code)
                    _ => {}
                }
            }
        }
    }

    mut result: boolean[][] = []

    for id in range(program.functions.length()) {
        immut routine = program.functions[id]

        if (closures.has(id)) {
            result.push(owned(routine.params))
            continue
        }

        immut changed = changedLocals(routine)
        mut borrowed: boolean[] = []

        for param in range(routine.params) {
            immut written = param < routine.writeback.length() and routine.writeback[param]
            borrowed.push(isManaged(routine.locals[param].ty) and not written and not changed.has(param))
        }

        result.push(borrowed)
    }

    return result
}

// The globals that never change once they have their value: given it by one copy (their
// declaration), and never changed, moved or dropped after.
export function constantGlobals(program: IrProgram): boolean[] {
    mut copies: int[] = []
    mut changed: boolean[] = []

    for global in program.globals {
        copies.push(0)
        changed.push(false)
    }

    for routine in program.functions {
        for block in routine.blocks {
            for instruction in block.instructions {
                match (instruction) {
                    CopyIns(GlobalPlace(id), _) => copies[id] += 1
                    _ => {
                        for id in changedGlobals(instruction) {
                            changed[id] = true
                        }
                    }
                }
            }
        }
    }

    mut result: boolean[] = []

    for id in range(program.globals.length()) {
        result.push(copies[id] == 1 and not changed[id])
    }

    return result
}

// The globals an instruction changes in place, moves out or drops.
function changedGlobals(instruction: Instruction): int[] {
    immut targets: Target[] = match (instruction) {
        CallIns(_, _, _, writebacks, _) => {
            mut found: Target[] = []

            for writeback in writebacks {
                found.push(writeback.target)
            }

            found
        }
        ListSetIns(list, _, _, _) => [list]
        ListPushIns(list, _, _) => [list]
        ListInsertIns(list, _, _, _) => [list]
        ListSortIns(list, _) => [list]
        FieldSetIns(record, _, _, _) => [record]
        ListRemoveIns(_, list, _, _) => [list]
        ListSortByIns(list, _, _) => [list]
        MapSetIns(map, _, _, _) => [map]
        MapRemoveIns(_, map, _, _) => [map]
        _ => []
    }
    mut found: int[] = []

    for target in targets {
        match (target.root) {
            GlobalPlace(id) => found.push(id)
            LocalPlace(_) => {}
        }
    }

    match (instruction) {
        TakeIns(_, GlobalPlace(id)) => found.push(id)
        DropIns(GlobalPlace(id), _) => found.push(id)
        _ => {}
    }

    return found
}

// For each local of the function, whether it is borrowed: the borrowed parameters `params`, and
// the locals only given values read (a field, an item, the value) from a borrowed one or from a
// global of `constants`.
export function borrowedLocals(routine: IrFunction, params: boolean[], constants: boolean[]): boolean[] {
    mut flags: boolean[] = []

    for local in range(routine.locals.length()) {
        flags.push(local < params.length() and params[local])
    }

    // The instructions that change each local, those that read for it from a local (its source)
    // and those that read for it from a global that never changes.
    mut writes: int[] = []
    mut reads: int[] = []
    mut sources: int[][] = []

    for local in range(routine.locals.length()) {
        writes.push(0)
        reads.push(0)
        sources.push([])
    }

    for block in routine.blocks {
        for instruction in block.instructions {
            for local in changes(instruction) {
                writes[local] += 1
            }

            immut read: Option[Read] = match (instruction) {
                FieldGetIns(dest, origin, _) => Some({ dest: dest, origin: origin })
                ListGetIns(dest, origin, _, _) => Some({ dest: dest, origin: origin })
                CopyIns(LocalPlace(dest), origin) => Some({ dest: dest, origin: origin })
                _ => None
            }

            match (read) {
                Some(found) => {
                    match (found.origin) {
                        LocalOp(source) if (source != found.dest) => {
                            reads[found.dest] += 1
                            sources[found.dest].push(source)
                        }
                        GlobalOp(id) if (constants[id]) => reads[found.dest] += 1
                        _ => {}
                    }
                }
                None => {}
            }
        }
    }

    // Until nothing changes: a local whose every source is borrowed is borrowed.
    mut changed = true

    while (changed) {
        changed = false

        for local in range(routine.params, routine.locals.length()) {
            if (flags[local] or not isManaged(routine.locals[local].ty)) { continue }

            if (reads[local] == 0 or writes[local] != reads[local]) { continue }

            mut all = true

            for source in sources[local] {
                if (not flags[source]) { all = false }
            }

            if (all) {
                flags[local] = true
                changed = true
            }
        }
    }

    return flags
}

// A value read for a local, and what it is read from.
type Read = {
    dest: int
    origin: Operand
}

function owned(count: int): boolean[] {
    mut flags: boolean[] = []

    for i in range(count) {
        flags.push(false)
    }

    return flags
}

// The locals an instruction of the function writes, changes in place, moves out or drops.
function changedLocals(routine: IrFunction): Set[int] {
    mut changed: Set[int] = Set.from([])

    for block in routine.blocks {
        for instruction in block.instructions {
            for local in changes(instruction) {
                changed.add(local)
            }
        }
    }

    return changed
}

function changes(instruction: Instruction): int[] {
    return match (instruction) {
        CopyIns(dest, _) => placeLocal(dest)
        UnaryIns(dest, _, _, _) => [dest]
        BinaryIns(dest, _, _, _, _) => [dest]
        CallIns(dest, _, _, writebacks, _) => {
            mut locals = optional(dest)

            for writeback in writebacks {
                for local in targetLocal(writeback.target) {
                    locals.push(local)
                }
            }

            locals
        }
        ListNewIns(dest, _) => [dest]
        ListGetIns(dest, _, _, _) => [dest]
        ListSetIns(list, _, _, _) => targetLocal(list)
        ListPushIns(list, _, _) => targetLocal(list)
        ListInsertIns(list, _, _, _) => targetLocal(list)
        ListSortIns(list, _) => targetLocal(list)
        ListSliceIns(dest, _, _, _, _) => [dest]
        RecordNewIns(dest, _, _) => [dest]
        FieldGetIns(dest, _, _) => [dest]
        FieldSetIns(record, _, _, _) => targetLocal(record)
        ListRemoveIns(dest, list, _, _) => [dest] + targetLocal(list)
        StdCallIns(dest, _, _) => optional(dest)
        TakeIns(dest, source) => [dest] + placeLocal(source)
        DropIns(value, _) => placeLocal(value)
        MakeClosureIns(dest, _, _) => [dest]
        CallClosureIns(dest, _, _, _) => optional(dest)
        ListSortByIns(list, _, _) => targetLocal(list)
        MapNewIns(dest, _) => [dest]
        MapGetIns(dest, _, _, _) => [dest]
        MapLookupIns(dest, _, _) => [dest]
        MapSetIns(map, _, _, _) => targetLocal(map)
        MapRemoveIns(dest, map, _, _) => [dest] + targetLocal(map)
        FailIns(_, _) => []
        PrintIns(_, _) => []
        RangeNextIns(hasValue, value, next, _, _, done) => [hasValue, value, next, done]
        RangeCheckIns(_, _) => []
    }
}

function optional(dest: Option[int]): int[] {
    return match (dest) {
        Some(local) => [local]
        None => []
    }
}

function placeLocal(where: Place): int[] {
    return match (where) {
        LocalPlace(id) => [id]
        GlobalPlace(_) => []
    }
}

function targetLocal(target: Target): int[] {
    return placeLocal(target.root)
}
