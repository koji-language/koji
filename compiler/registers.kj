// Which locals of a function the native backend keeps in registers (native.kj): those of one word
// read and written most, a use in a loop counting ten times as much (a loop of loops, a hundred),
// whose address is never taken (a list or a map changed in place, a part of a value changed through
// a `mut` parameter: the runtime is given the place of the variable).

import { Place, Target, Instruction, IrFunction } from 'ir.kj'
import { uses, defs, terminatorUses, successors } from 'liveness.kj'

// The locals to keep in registers, the most used first: at most `count`, of those that `oneWord`
// marks, used at least `least` times.
export function registerLocals(routine: IrFunction, oneWord: boolean[], count: int, least: int): int[] {
    immut blocks = routine.blocks.length()
    immut locals = routine.locals.length()
    mut addressed: boolean[] = []
    mut weight: int[] = []
    // Where each local is written and read (a block and a position in it: the terminator is after
    // the instructions), and how many times.
    mut writes: int[] = []
    mut reads: int[] = []
    mut writtenAt: int[] = []
    mut readAt: int[] = []

    for local in range(locals) {
        addressed.push(false)
        weight.push(0)
        writes.push(0)
        reads.push(0)
        writtenAt.push(-1)
        readAt.push(-1)
    }

    // The depth of loops of each block: a jump back from a block to an earlier one (or itself)
    // makes a loop of the blocks between them.
    mut depth: int[] = []

    for block in range(blocks) {
        depth.push(0)
    }

    for block in range(blocks) {
        for target in successors(routine.blocks[block].terminator) {
            if (target > block) { continue }

            for inside in range(target, block + 1) {
                depth[inside] += 1
            }
        }
    }

    for block in range(blocks) {
        mut each = 1

        for level in range(if (depth[block] > 2) { 2 } else { depth[block] }) {
            each *= 10
        }

        immut instructions = routine.blocks[block].instructions

        for position in range(instructions.length()) {
            immut instruction = instructions[position]
            immut at = block * 1000000 + position

            for local in uses(instruction) {
                weight[local] += each
                reads[local] += 1
                readAt[local] = at
            }

            for local in defs(instruction) {
                weight[local] += each
                writes[local] += 1
                writtenAt[local] = at
            }

            for local in addressedBy(instruction) {
                addressed[local] = true
            }
        }

        for local in terminatorUses(routine.blocks[block].terminator) {
            weight[local] += each
            reads[local] += 1
            readAt[local] = block * 1000000 + instructions.length()
        }
    }

    // A value read once, by the instruction after the one that writes it, is still in a register
    // then (native.kj forwards it): a register of its own would not help.
    for local in range(routine.params, locals) {
        if (writes[local] == 1 and reads[local] == 1 and readAt[local] == writtenAt[local] + 1) { weight[local] = 0 }
    }

    // The most used first.
    mut chosen: int[] = []
    mut taken: boolean[] = []

    for local in range(locals) {
        taken.push(not oneWord[local] or addressed[local] or weight[local] < least)
    }

    while (chosen.length() < count) {
        mut best = -1

        for local in range(locals) {
            if (taken[local]) { continue }

            if (best < 0 or weight[local] > weight[best]) { best = local }
        }

        if (best < 0) { break }

        taken[best] = true
        chosen.push(best)
    }

    return chosen
}

// The locals whose place an instruction gives the runtime.
function addressedBy(instruction: Instruction): int[] {
    mut found: int[] = []

    match (instruction) {
        ListNewIns(dest, _) => found.push(dest)
        MapNewIns(dest, _) => found.push(dest)
        ListSetIns(list, _, _, _) => root(list, mut found)
        ListPushIns(list, _, _) => root(list, mut found)
        ListInsertIns(list, _, _, _) => root(list, mut found)
        ListSortIns(list, _) => root(list, mut found)
        FieldSetIns(record, _, _, _) => root(record, mut found)
        ListRemoveIns(_, list, _, _) => root(list, mut found)
        ListSortByIns(list, _, _) => root(list, mut found)
        MapSetIns(map, _, _, _) => root(map, mut found)
        MapRemoveIns(_, map, _, _) => root(map, mut found)
        // A part of a variable given to a `mut` parameter (a variable alone comes back as a value).
        CallIns(_, _, _, writebacks, _) => {
            for writeback in writebacks {
                if (writeback.target.path.length() > 0) { root(writeback.target, mut found) }
            }
        }
        _ => {}
    }

    return found
}

function root(target: Target, mut found: int[]) {
    match (target.root) {
        LocalPlace(id) => found.push(id)
        GlobalPlace(_) => {}
    }
}
