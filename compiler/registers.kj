// Which locals of a function the native backend keeps in registers (native.kj): those of one word
// read and written most, a use in a loop counting ten times as much (a loop of loops, a hundred),
// whose address is never taken (the list or map of a literal, which the runtime fills in place),
// nor dropped or taken (which read a local that may be empty). Locals alive at different times share a register: each has a
// range of positions of the function (its instructions in order, each block's terminator after
// them) from the first to the last where it is alive, by the usual analysis of liveness over the
// blocks; the most used are given a register first, one that no range given it overlaps.

import { Place, Target, Instruction, IrFunction } from 'ir.kj'
import { uses, defs, terminatorUses, successors } from 'liveness.kj'

// The range of positions where each local is alive (-1 for none), and the first and last positions
// of each block.
export type Ranges = {
    first: int[]
    last: int[]
    starts: int[]
    ends: int[]
}

// How much each local would gain from a register (-1: it cannot have one): of those that `oneWord`
// marks, used at least `least` times.
export function registerWeights(routine: IrFunction, oneWord: boolean[], least: int): int[] {
    immut blocks = routine.blocks.length()
    immut locals = routine.locals.length()
    mut addressed: boolean[] = []
    mut weight: int[] = []
    // Where each local is written and read (a block and a position in it: the terminator is after
    // the instructions), and how many times.
    mut writes: int[] = []
    mut reads: int[] = []
    mut writtenAt: int[] = []
    mut readAt: int[] = []

    for local in range(locals) {
        addressed.push(false)
        weight.push(0)
        writes.push(0)
        reads.push(0)
        writtenAt.push(-1)
        readAt.push(-1)
    }

    // The depth of loops of each block: a jump back from a block to an earlier one (or itself)
    // makes a loop of the blocks between them.
    mut depth: int[] = []

    for block in range(blocks) {
        depth.push(0)
    }

    for block in range(blocks) {
        for target in successors(routine.blocks[block].terminator) {
            if (target > block) { continue }

            for inside in range(target, block + 1) {
                depth[inside] += 1
            }
        }
    }

    for block in range(blocks) {
        mut each = 1

        for level in range(if (depth[block] > 2) { 2 } else { depth[block] }) {
            each *= 10
        }

        immut instructions = routine.blocks[block].instructions

        for position in range(instructions.length()) {
            immut instruction = instructions[position]
            immut at = block * 1000000 + position

            for local in uses(instruction) {
                weight[local] += each
                reads[local] += 1
                readAt[local] = at
            }

            for local in defs(instruction) {
                weight[local] += each
                writes[local] += 1
                writtenAt[local] = at
            }

            for local in addressedBy(instruction) {
                addressed[local] = true
            }
        }

        for local in terminatorUses(routine.blocks[block].terminator) {
            weight[local] += each
            reads[local] += 1
            readAt[local] = block * 1000000 + instructions.length()
        }
    }

    // A value read once, by the instruction after the one that writes it, is still in a register
    // then (native.kj forwards it): a register of its own would not help.
    for local in range(routine.params, locals) {
        if (writes[local] == 1 and reads[local] == 1 and readAt[local] == writtenAt[local] + 1) { weight[local] = 0 }
    }

    mut result: int[] = []

    for local in range(locals) {
        result.push(if (not oneWord[local] or addressed[local] or weight[local] < least) { -1 } else { weight[local] })
    }

    return result
}

// The locals alive at the start of each block (sets of bits: see `has`).
export function liveAtBlocks(routine: IrFunction): int[][] {
    return liveness(routine).first
}

// The ranges of the locals (see above).
export function liveRanges(routine: IrFunction): Ranges {
    immut sets = liveness(routine)
    immut liveIn = sets.first
    immut liveOut = sets.second
    immut blocks = routine.blocks.length()
    immut locals = routine.locals.length()
    mut starts: int[] = []
    mut ends: int[] = []
    mut position = 0

    for block in routine.blocks {
        starts.push(position)
        position += block.instructions.length()
        ends.push(position)
        position += 1
    }

    mut ranges: Ranges = { first: [], last: [], starts: starts, ends: ends }

    for local in range(locals) {
        ranges.first.push(-1)
        ranges.last.push(-1)
    }

    for block in range(blocks) {
        for local in members(liveIn[block]) {
            extend(mut ranges, local, starts[block])
        }

        for local in members(liveOut[block]) {
            extend(mut ranges, local, ends[block])
        }

        immut instructions = routine.blocks[block].instructions

        for index in range(instructions.length()) {
            for local in uses(instructions[index]) {
                extend(mut ranges, local, starts[block] + index)
            }

            for local in defs(instructions[index]) {
                extend(mut ranges, local, starts[block] + index)
            }
        }

        for local in terminatorUses(routine.blocks[block].terminator) {
            extend(mut ranges, local, ends[block])
        }
    }

    return ranges
}

type Sets = {
    first: int[][]
    second: int[][]
}

// The locals alive at the start and at the end of each block.
function liveness(routine: IrFunction): Sets {
    immut blocks = routine.blocks.length()
    immut locals = routine.locals.length()
    immut size = (locals + 63) / 64
    // For each block, the locals it reads before writing them, and those it writes (sets of bits).
    mut empty: int[] = []

    for word in range(size) {
        empty.push(0)
    }

    mut reads: int[][] = []
    mut writes: int[][] = []

    for block in routine.blocks {
        mut read = empty
        mut written = empty

        for instruction in block.instructions {
            for local in uses(instruction) {
                if (not has(written, local)) { add(mut read, local) }
            }

            for local in defs(instruction) {
                add(mut written, local)
            }
        }

        for local in terminatorUses(block.terminator) {
            if (not has(written, local)) { add(mut read, local) }
        }

        reads.push(read)
        writes.push(written)
    }

    // Alive at the start of a block: read there first, or alive at its end and not written there.
    mut liveIn: int[][] = []
    mut liveOut: int[][] = []

    for block in range(blocks) {
        liveIn.push(empty)
        liveOut.push(empty)
    }

    mut changed = true

    while (changed) {
        changed = false
        mut block = blocks - 1

        while (block >= 0) {
            mut out = empty

            for next in successors(routine.blocks[block].terminator) {
                for word in range(size) {
                    out[word] = out[word] | liveIn[next][word]
                }
            }

            mut entering = empty

            for word in range(size) {
                entering[word] = reads[block][word] | (out[word] & ~writes[block][word])
            }

            if (entering != liveIn[block] or out != liveOut[block]) {
                liveIn[block] = entering
                liveOut[block] = out
                changed = true
            }

            block -= 1
        }
    }

    return { first: liveIn, second: liveOut }
}

// Widens the range of a local to a position.
export function extend(mut ranges: Ranges, local: int, position: int) {
    if (ranges.first[local] < 0 or position < ranges.first[local]) { ranges.first[local] = position }

    if (position > ranges.last[local]) { ranges.last[local] = position }
}

// For each local, the register it is given (an index below `count`), or -1: the heaviest first,
// each in the first register that no range given it overlaps.
export function assignRegisters(weights: int[], ranges: Ranges, count: int): int[] {
    immut locals = weights.length()
    mut order: int[] = []

    for local in range(locals) {
        if (weights[local] >= 0 and ranges.first[local] >= 0) { order.push(local) }
    }

    order.sortBy((a, b) => weights[a] > weights[b])
    mut given: int[] = []

    for local in range(locals) {
        given.push(-1)
    }

    // The ranges given to each register.
    mut firsts: int[][] = []
    mut lasts: int[][] = []

    for register in range(count) {
        firsts.push([])
        lasts.push([])
    }

    for local in order {
        for register in range(count) {
            mut free = true

            for i in range(firsts[register].length()) {
                if (ranges.first[local] <= lasts[register][i] and firsts[register][i] <= ranges.last[local]) {
                    free = false
                    break
                }
            }

            if (free) {
                given[local] = register
                firsts[register].push(ranges.first[local])
                lasts[register].push(ranges.last[local])
                break
            }
        }
    }

    return given
}

export function has(set: int[], member: int): boolean {
    return (set[member / 64] >> (member % 64)) & 1 == 1
}

function add(mut set: int[], member: int) {
    set[member / 64] = set[member / 64] | (1 << (member % 64))
}

function members(set: int[]): int[] {
    mut found: int[] = []

    for word in range(set.length()) {
        if (set[word] == 0) { continue }

        for bit in range(64) {
            if ((set[word] >> bit) & 1 == 1) { found.push(64 * word + bit) }
        }
    }

    return found
}

// The locals whose place an instruction gives the runtime.
function addressedBy(instruction: Instruction): int[] {
    mut found: int[] = []

    match (instruction) {
        ListNewIns(dest, _) => found.push(dest)
        MapNewIns(dest, _) => found.push(dest)
        // A local that may be empty is read.
        TakeIns(_, LocalPlace(source)) => found.push(source)
        DropIns(LocalPlace(source), _) => found.push(source)
        _ => {}
    }

    return found
}

function root(target: Target, mut found: int[]) {
    match (target.root) {
        LocalPlace(id) => found.push(id)
        GlobalPlace(_) => {}
    }
}
