// Inlining for the native backend (native.kj): a call of a small function (`inlinable` finds them:
// `Lexer.at`, `Parser.current`) is replaced by the blocks of the function, its
// locals new locals of the caller. A parameter the function never changes is its argument itself
// (a local, a constant, or a global that never changes), with no reference of its own: the caller
// reads it where the function did, so it stays alive until then (liveness.kj), and a value changed
// in place after (`self.advance()` after `self.at(0)`) is not shared. Another parameter is a copy of
// its argument, and the result a copy into the destination, so the references are those of any
// copy. A `mut` parameter given a local that gets its value back (`self.advance()`, with `mut
// self`) is that local itself: the function changes it in place, as the call would. Only a
// function of the same file is inlined (the messages of its panics name the file of the function
// generated).

import { Ty, Operand, Place, Step, Target, StdArg, Writeback, MapEntry, Instruction, Terminator, IrBlock, IrFunction, IrProgram, isManaged } from 'ir.kj'
import { changes, constantGlobals } from 'borrow.kj'
import { uses, terminatorUses, successors } from 'liveness.kj'
import { addBit, removeBit, hasBit, liveness } from 'bits.kj'
import { Platformed, foldFor, platformGlobals, readsSystem } from 'target.kj'
import system

// The locals of the callee in the caller: from `base`, but the parameters given as operands.
type Names = {
    base: int
    given: Option[Operand][]
    // For each parameter, the local of the caller it is (a `mut` one), or -1.
    aliases: int[]
}

// The limits of a function inlined: its blocks, and its instructions with those of the functions
// it calls (inlined in it first).
immut inlinedBlocks = 8
immut inlinedSize = 40

// The functions small enough to inline: they call no others but small ones, so a recursive function is never one of them.
function inlinable(program: IrProgram, blocks: int, most: int): boolean[] {
    mut sizes: int[] = []

    for routine in program.functions {
        sizes.push(-1)
    }

    mut changed = true

    while (changed) {
        changed = false

        for id in range(program.functions.length()) {
            if (sizes[id] >= 0) { continue }

            immut routine = program.functions[id]

            if (routine.blocks.length() > blocks) { continue }

            mut count = 0
            mut fits = true

            for block in routine.blocks {
                for instruction in block.instructions {
                    count += 1

                    match (instruction) {
                        CallIns(_, callee, _, _, _) => {
                            if (sizes[callee] < 0) { fits = false }

                            count += sizes[callee]
                        }
                        CallClosureIns(_, _, _, _) => fits = false
                        // The address of the bytes of a string or the items of a list does not keep it
                        // alive: a parameter must live until the function returns, which inlined it
                        // would not (it would be released at its last read).
                        StdCallIns(_, name, _) => {
                            if (name == 'koji_unsafe_string_bytes' or name == 'koji_unsafe_list_items') { fits = false }
                        }
                        _ => {}
                    }
                }
            }

            if (fits and count <= most) {
                sizes[id] = count
                changed = true
            }
        }
    }

    mut result: boolean[] = []

    for size in sizes {
        result.push(size >= 0)
    }

    return result
}

// The platform the native backend compiles for (see target.kj): the one it runs on, or
// the one KOJI_TARGET names (`x64`, `arm64`, `macos-x64`, `macos-arm64`, `windows-x64`): the system times 3 plus the processor.
export function targetPlatform(): int {
    return match (system.env('KOJI_TARGET')) {
        Some(name) => match (name) {
            'arm64' => 1
            'macos-x64' => 3
            'macos-arm64' => 4
            'windows-x64' => 6
            _ => 0
        }
        // The system and the processor it runs on.
        None => match (system.os) {
            Windows => 6
            MacOS => if (system.architecture == system.Arm64) { 4 } else { 3 }
            _ => if (system.architecture == system.Arm64) { 1 } else { 0 }
        }
    }
}

// The function on one system (target.kj): its branches on `system.os` go one way, and the blocks no
// longer reached are empty (their code, and the functions of C it calls, are not generated).
function forSystem(routine: IrFunction, globals: Platformed, platform: int): IrFunction {
    if (not readsSystem(routine, globals)) { return routine }

    immut folded = foldFor(routine, globals, platform)
    mut result = routine

    for block in range(routine.blocks.length()) {
        if (not folded.reached[block]) {
            result.blocks[block] = { instructions: [], terminator: UnreachableT }
            continue
        }

        if (folded.goes[block] >= 0) { result.blocks[block] = { instructions: routine.blocks[block].instructions, terminator: GotoT(folded.goes[block]) } }
    }

    // The comparisons with `system.os` and `system.architecture` and their tags, known: constants
    // (so that a function that runs before the modules do, `koji_init`, reads nothing of them).
    for block in range(result.blocks.length()) {
        if (not folded.reached[block]) { continue }

        mut kept: Instruction[] = []

        for instruction in result.blocks[block].instructions {
            immut dest = match (instruction) {
                BinaryIns(id, _, _, _, _) => id
                UnaryIns(id, _, _, _) => id
                _ => -1
            }

            if (dest >= 0 and dest < folded.flags.length()) {
                match (folded.flags[dest]) {
                    Some(flag) => {
                        kept.push(CopyIns(LocalPlace(dest), BoolOp(flag)))
                        continue
                    }
                    None => {}
                }

                match (folded.numbers[dest]) {
                    Some(number) => {
                        kept.push(CopyIns(LocalPlace(dest), IntOp(number)))
                        continue
                    }
                    None => {}
                }
            }

            kept.push(instruction)
        }

        result.blocks[block] = { instructions: kept, terminator: result.blocks[block].terminator }
    }

    // What they compared and nothing else reads: the global read, the variant made, left out.
    mut reads: int[] = []

    for local in result.locals {
        reads.push(0)
    }

    for each in result.blocks {
        for instruction in each.instructions {
            for local in uses(instruction) {
                reads[local] += 1
            }
        }

        for local in terminatorUses(each.terminator) {
            reads[local] += 1
        }
    }

    for block in range(result.blocks.length()) {
        mut kept: Instruction[] = []

        for instruction in result.blocks[block].instructions {
            immut unread = match (instruction) {
                RecordNewIns(dest, _, fields) => fields.length() == 0 and reads[dest] == 0
                CopyIns(LocalPlace(dest), GlobalOp(id)) => (id == globals.system or id == globals.architecture) and reads[dest] == 0
                _ => false
            }

            if (not unread) { kept.push(instruction) }
        }

        result.blocks[block] = { instructions: kept, terminator: result.blocks[block].terminator }
    }

    return result
}

// The program with the calls of small functions inlined.
export function inlineSmall(program: IrProgram): IrProgram {
    immut smalls = inlinable(program, inlinedBlocks, inlinedSize)
    mut inlinable: boolean[] = []

    for id in range(program.functions.length()) {
        immut routine = program.functions[id]
        mut fits = smalls[id] and id != program.main

        for param in range(routine.params) {
            if (routine.locals[param].ty == VoidTy) { fits = false }
        }

        inlinable.push(fits)
    }

    // The small functions first (with their own calls inlined), then the others: the small ones
    // call only small ones, never themselves.
    mut done: IrFunction[] = []
    mut ready: boolean[] = []

    for routine in program.functions {
        done.push(routine)
        ready.push(false)
    }

    immut constants = constantGlobals(program)

    for id in range(program.functions.length()) {
        prepare(program, inlinable, constants, id, mut done, mut ready)
    }

    mut simplified: IrFunction[] = []

    for routine in done {
        simplified.push(simplify(forSystem(routine, platformGlobals(program), targetPlatform())))
    }

    mut result = program
    result.functions = simplified
    return result
}

// The blocks of the function merged where one only goes to the next, which nothing else goes to (the
// return of an inlined function); then a value read only by the copy right after it is written to
// the copy's destination (`t = a < b; d = t` is `d = a < b`, the result of an inlined function).
export function simplify(given: IrFunction): IrFunction {
    mut routine = given
    immut count = routine.blocks.length()
    mut predecessors: int[] = []

    for block in range(count) {
        predecessors.push(0)
    }

    for block in routine.blocks {
        for next in successors(block.terminator) {
            predecessors[next] += 1
        }
    }

    for block in range(count) {
        while (true) {
            immut next = match (routine.blocks[block].terminator) {
                GotoT(target) => target
                _ => -1
            }

            // A jump back to a block before `next` stays a jump back from a later block (as native.kj
            // checks for preemption on them).
            if (next <= block or predecessors[next] != 1) { break }

            mut back = false

            for target in successors(routine.blocks[next].terminator) {
                if (target <= next and target > block) { back = true }
            }

            if (back) { break }

            immut merged: IrBlock = { instructions: routine.blocks[block].instructions + routine.blocks[next].instructions, terminator: routine.blocks[next].terminator }
            routine.blocks[block] = merged
            routine.blocks[next] = { instructions: [], terminator: UnreachableT }
            predecessors[next] = 0
        }
    }

    routine = folded(routine)

    for round in range(2) {
        routine = knownThreaded(routine)
        routine = threaded(routine)
        routine = threaded(routine)
    }

    routine = deadCopies(routine)

    routine = propagated(propagated(routine))
    // Again, for what propagating the copies made known.
    routine = threaded(retargeted(knownThreaded(routine)))
    routine = deadCopies(retargeted(routine))

    // How many times each local is written and read.
    mut writes: int[] = []
    mut reads: int[] = []

    for local in routine.locals {
        writes.push(0)
        reads.push(0)
    }

    for block in routine.blocks {
        for instruction in block.instructions {
            for local in changes(instruction) {
                writes[local] += 1
            }

            for local in uses(instruction) {
                reads[local] += 1
            }
        }

        for local in terminatorUses(block.terminator) {
            reads[local] += 1
        }
    }

    routine = products(routine, reads, writes)

    // A branch on the negation of a value, which only the branch reads, branches on the value the
    // other way.
    for block in range(routine.blocks.length()) {
        immut instructions = routine.blocks[block].instructions

        if (instructions.length() == 0) { continue }

        match (routine.blocks[block].terminator) {
            BranchT(LocalOp(condition), thenBlock, elseBlock) if (condition >= routine.params and reads[condition] == 1 and writes[condition] == 1) => {
                match (instructions[instructions.length() - 1]) {
                    UnaryIns(written, 'Not', value, _) if (written == condition) => {
                        routine.blocks[block] = { instructions: instructions[0..instructions.length() - 1], terminator: BranchT(value, elseBlock, thenBlock) }
                        reads[condition] = 0
                    }
                    _ => {}
                }
            }
            _ => {}
        }
    }

    for block in range(routine.blocks.length()) {
        mut instructions = routine.blocks[block].instructions
        mut kept: Instruction[] = []
        mut position = 0

        while (position < instructions.length()) {
            if (position + 1 < instructions.length()) {
                match (instructions[position + 1]) {
                    CopyIns(LocalPlace(dest), LocalOp(temporary)) if (temporary >= routine.params and temporary != dest and writes[temporary] == 1 and reads[temporary] == 1 and routine.locals[temporary].ty == routine.locals[dest].ty and (not (dest in uses(instructions[position])) or arithmetic(instructions[position], routine))) => {
                        match (writing(instructions[position], temporary, dest)) {
                            Some(rewritten) => {
                                kept.push(rewritten)
                                position += 2
                                continue
                            }
                            None => {}
                        }
                    }
                    _ => {}
                }
            }

            kept.push(instructions[position])
            position += 1
        }

        routine.blocks[block] = { instructions: kept, terminator: routine.blocks[block].terminator }
    }

    return laidOut(routine)
}

// The copies into locals of no references that nothing reads after them (by liveness over the
// blocks): `t = a; branch a, ...` where every path writes `t` again before reading it. Not those
// into `mut` parameters, whose final values go back to the caller.
function deadCopies(given: IrFunction): IrFunction {
    mut routine = given
    immut count = routine.blocks.length()
    immut words = (routine.locals.length() + 63) / 64
    mut none: int[] = []

    for word in range(words) {
        none.push(0)
    }

    // For each block, the locals it reads before writing them, and those it writes (bits).
    mut reads: int[][] = []
    mut writes: int[][] = []

    for block in range(count) {
        mut read = none
        mut written = none
        immut instructions = routine.blocks[block].instructions

        for local in terminatorUses(routine.blocks[block].terminator) {
            addBit(mut read, local)
        }

        mut at = instructions.length() - 1

        while (at >= 0) {
            for local in changes(instructions[at]) {
                addBit(mut written, local)
                removeBit(mut read, local)
            }

            for local in uses(instructions[at]) {
                addBit(mut read, local)
            }

            at -= 1
        }

        reads.push(read)
        writes.push(written)
    }

    mut following: int[][] = []

    for block in routine.blocks {
        following.push(successors(block.terminator))
    }

    immut liveOut = liveness(reads, writes, following, words).out

    for block in range(count) {
        mut live = liveOut[block]

        for local in terminatorUses(routine.blocks[block].terminator) {
            addBit(mut live, local)
        }

        immut instructions = routine.blocks[block].instructions
        mut kept: Instruction[] = []
        mut removed = false
        mut at = instructions.length() - 1

        while (at >= 0) {
            immut instruction = instructions[at]
            immut dead = match (instruction) {
                CopyIns(LocalPlace(dest), _) => not hasBit(live, dest) and not isManaged(routine.locals[dest].ty) and not (dest < routine.writeback.length() and routine.writeback[dest])
                _ => false
            }

            if (dead) {
                removed = true
            } else {
                kept.push(instruction)

                for local in changes(instruction) {
                    removeBit(mut live, local)
                }

                for local in uses(instruction) {
                    addBit(mut live, local)
                }
            }

            at -= 1
        }

        if (not removed) { continue }

        mut ordered: Instruction[] = []
        mut back = kept.length() - 1

        while (back >= 0) {
            ordered.push(kept[back])
            back -= 1
        }

        routine.blocks[block] = { instructions: ordered, terminator: routine.blocks[block].terminator }
    }

    return routine
}




// A branch to a block of copies that branches on a value known on that edge (the condition of the
// branch, or a copy of it, or a constant copied): the edge goes to a block of its own with those
// copies, which goes where that branch would (`a or b` of functions inlined: `t = a; branch a, x,
// y` then `y: u = t; branch t, ...`). The copies left unread go afterwards (`threaded`).
// The jumps to an empty block that only jumps go where it goes; a branch on a copy just made, on
// what it copies (the copy is left to `deadCopies`).
function retargeted(given: IrFunction): IrFunction {
    mut routine = given

    for block in range(routine.blocks.length()) {
        immut instructions = routine.blocks[block].instructions

        if (instructions.length() > 0) {
            match (routine.blocks[block].terminator) {
                BranchT(LocalOp(condition), thenBlock, elseBlock) => {
                    match (instructions[instructions.length() - 1]) {
                        CopyIns(LocalPlace(dest), LocalOp(source)) if (dest == condition and source != condition) => {
                            routine.blocks[block] = { instructions: instructions, terminator: BranchT(LocalOp(source), thenBlock, elseBlock) }
                        }
                        _ => {}
                    }
                }
                _ => {}
            }
        }

        immut ending = match (routine.blocks[block].terminator) {
            GotoT(next) => GotoT(throughEmpty(routine.blocks, next))
            BranchT(condition, thenBlock, elseBlock) => BranchT(condition, throughEmpty(routine.blocks, thenBlock), throughEmpty(routine.blocks, elseBlock))
            other => other
        }

        if (ending != routine.blocks[block].terminator) { routine.blocks[block] = { instructions: routine.blocks[block].instructions, terminator: ending } }
    }

    return routine
}

// Where a jump to `target` ends up through empty blocks that only jump (8 at most).
function throughEmpty(blocks: IrBlock[], target: int): int {
    mut place = target
    mut steps = 0

    while (steps < 8 and blocks[place].instructions.length() == 0) {
        match (blocks[place].terminator) {
            GotoT(next) if (next != place) => place = next
            _ => break
        }

        steps += 1
    }

    return place
}

function knownThreaded(given: IrFunction): IrFunction {
    // First, the jumps through empty blocks.
    mut routine = retargeted(given)
    immut count = routine.blocks.length()

    for block in range(count) {
        immut ending = routine.blocks[block].terminator

        // A jump to a block of a few copies that branches: those copies here, and the branch.
        match (ending) {
            GotoT(next) if (next != block and routine.blocks[next].instructions.length() <= 2) => {
                match (routine.blocks[next].terminator) {
                    BranchT(LocalOp(_), _, _) => {
                        mut plain = true

                        for copy in routine.blocks[next].instructions {
                            match (copy) {
                                CopyIns(LocalPlace(_), LocalOp(_)) => {}
                                _ => plain = false
                            }
                        }

                        if (plain) {
                            routine.blocks[block] = { instructions: routine.blocks[block].instructions + routine.blocks[next].instructions, terminator: routine.blocks[next].terminator }
                            continue
                        }
                    }
                    _ => {}
                }
            }
            _ => {}
        }

        immut condition = match (routine.blocks[block].terminator) {
            BranchT(LocalOp(local), _, _) => local
            _ => continue
        }
        immut instructions = routine.blocks[block].instructions
        mut targets = successors(ending)

        for side in [0, 1] {
            immut next = targets[side]

            if (next == block or targets[0] == targets[1]) { continue }

            immut copies = routine.blocks[next].instructions

            if (copies.length() > 4) { continue }

            immut again = match (routine.blocks[next].terminator) {
                BranchT(LocalOp(local), _, _) => local
                _ => continue
            }
            // What is known on the edge: the condition, and the copies of it after it was written.
            mut known: Map[int, boolean] = [:]
            known[condition] = side == 0

            for instruction in instructions {
                match (instruction) {
                    CopyIns(LocalPlace(dest), LocalOp(source)) if (source == condition and dest != condition) => known[dest] = side == 0
                    other => {
                        immut written = changes(other)

                        // The condition written again: the copies before are of another value.
                        if (condition in written) {
                            known = [:]
                            known[condition] = side == 0
                        }

                        for local in written {
                            if (local != condition) { known.remove(local) }
                        }
                    }
                }
            }

            mut plain = true

            for copy in copies {
                match (copy) {
                    CopyIns(LocalPlace(dest), LocalOp(source)) => {
                        match (known.get(source)) {
                            Some(value) => known[dest] = value
                            None => known.remove(dest)
                        }
                    }
                    CopyIns(LocalPlace(dest), BoolOp(value)) => known[dest] = value
                    _ => plain = false
                }
            }

            if (not plain) { continue }

            match (known.get(again)) {
                Some(value) => {
                    immut destinations = successors(routine.blocks[next].terminator)
                    routine.blocks.push({ instructions: copies, terminator: GotoT(if (value) { destinations[0] } else { destinations[1] }) })
                    targets[side] = routine.blocks.length() - 1
                }
                None => {}
            }
        }

        routine.blocks[block] = { instructions: instructions, terminator: BranchT(LocalOp(condition), targets[0], targets[1]) }
    }

    return routine
}

// The copies into a local written only by them, of no references, replaced by what they copy where
// the local is read: a constant; a local never changed; or a local written once earlier in the same
// block, when every read of the copy follows in that block.
function propagated(given: IrFunction): IrFunction {
    mut routine = given
    immut count = routine.locals.length()
    mut writes: int[] = []
    mut reads: int[] = []
    mut definedIn: int[] = []
    mut definedAt: int[] = []

    for local in range(count) {
        writes.push(0)
        reads.push(0)
        definedIn.push(-1)
        definedAt.push(-1)
    }

    for block in range(routine.blocks.length()) {
        immut instructions = routine.blocks[block].instructions

        for position in range(instructions.length()) {
            for local in changes(instructions[position]) {
                writes[local] += 1
                definedIn[local] = block
                definedAt[local] = position
            }

            for local in uses(instructions[position]) {
                reads[local] += 1
            }
        }

        for local in terminatorUses(routine.blocks[block].terminator) {
            reads[local] += 1
        }
    }

    mut replaced: Option[Operand][] = []

    for local in range(count) {
        replaced.push(None)
    }

    mut any = false

    for block in range(routine.blocks.length()) {
        immut instructions = routine.blocks[block].instructions

        for position in range(instructions.length()) {
            match (instructions[position]) {
                CopyIns(LocalPlace(dest), value) if (dest >= routine.params and writes[dest] == 1 and not isManaged(routine.locals[dest].ty)) => {
                    immut fits = match (value) {
                        IntOp(_) => routine.locals[dest].ty == IntTy
                        BoolOp(_) => routine.locals[dest].ty == BoolTy
                        CharOp(_) => routine.locals[dest].ty == CharTy
                        LocalOp(source) => source != dest and routine.locals[source].ty == routine.locals[dest].ty and (writes[source] == 0 or (writes[source] == 1 and definedIn[source] == block and definedAt[source] < position and readsAfter(routine.blocks[block], position, dest) == reads[dest]))
                        _ => false
                    }

                    if (fits) {
                        replaced[dest] = Some(value)
                        any = true
                    }
                }
                _ => {}
            }
        }
    }

    if (not any) { return given }

    immut names: Names = { base: 0, given: replaced, aliases: [] }
    mut blocks: IrBlock[] = []

    for each in routine.blocks {
        mut kept: Instruction[] = []

        for instruction in each.instructions {
            match (instruction) {
                CopyIns(LocalPlace(dest), _) if (replaced[dest] is Some) => continue
                _ => kept.push(renamed(instruction, names))
            }
        }

        immut ending = match (each.terminator) {
            BranchT(condition, thenBlock, elseBlock) => BranchT(operand(condition, names), thenBlock, elseBlock)
            ReturnT(Some(value)) => ReturnT(Some(operand(value, names)))
            _ => each.terminator
        }
        blocks.push({ instructions: kept, terminator: ending })
    }

    // A local replaced but still read (not as a value of an instruction): the function as it was.
    for each in blocks {
        for instruction in each.instructions {
            for local in uses(instruction) {
                if (replaced[local] is Some) { return given }
            }
        }

        for local in terminatorUses(each.terminator) {
            if (replaced[local] is Some) { return given }
        }
    }

    routine.blocks = blocks
    return routine
}

// How many times the instructions of a block after `position`, and its terminator, read `local`.
function readsAfter(block: IrBlock, position: int, local: int): int {
    mut found = 0

    for at in range(position + 1, block.instructions.length()) {
        for each in uses(block.instructions[at]) {
            if (each == local) { found += 1 }
        }
    }

    for each in terminatorUses(block.terminator) {
        if (each == local) { found += 1 }
    }

    return found
}

// The negations of constants folded (`-1` is `IntNeg 1` in the IR), `x + 0`, and the checks of
// constant steps of ranges dropped.
function folded(given: IrFunction): IrFunction {
    mut routine = given

    for block in range(routine.blocks.length()) {
        mut instructions = routine.blocks[block].instructions
        mut changed = false

        // The check of a constant step of a range that is not 0 checks nothing.
        mut kept: Instruction[] = []

        for instruction in instructions {
            match (instruction) {
                RangeCheckIns(IntOp(step), _) if (step != 0) => changed = true
                _ => kept.push(instruction)
            }
        }

        instructions = kept

        for position in range(instructions.length()) {
            match (instructions[position]) {
                UnaryIns(dest, 'IntNeg', IntOp(number), _) if (number != -9223372036854775807 - 1) => {
                    instructions[position] = CopyIns(LocalPlace(dest), IntOp(-number))
                    changed = true
                }
                // `x + 0` and `x - 0` (an offset of 0 from an inlined `self.at(0)`).
                BinaryIns(dest, op, left, IntOp(0), _) if (op == 'IntAdd' or op == 'IntSub') => {
                    instructions[position] = CopyIns(LocalPlace(dest), left)
                    changed = true
                }
                _ => {}
            }
        }

        if (changed) { routine.blocks[block] = { instructions: instructions, terminator: routine.blocks[block].terminator } }
    }

    return routine
}

// `lowWord(wordProduct(wide(a, x), wide(b, y)))` of `koji:unsafe`, each value read once, in one block:
// `IntMulWrapping a, b`, the product of two words wrapping around (which the native backend computes
// without the words of U128 in the frame).
function products(given: IrFunction, reads: int[], writes: int[]): IrFunction {
    mut routine = given

    for block in range(routine.blocks.length()) {
        mut instructions = routine.blocks[block].instructions
        mut removed: boolean[] = []

        for instruction in instructions {
            removed.push(false)
        }

        mut changed = false

        for position in range(instructions.length()) {
            match (instructions[position]) {
                StdCallIns(Some(dest), 'koji_unsafe_low_word', args) if (args.length() == 1) => {
                    immut product = definedBefore(instructions, position, args[0], 'koji_unsafe_word_product', reads, writes)

                    if (product < 0) { continue }

                    immut factors = match (instructions[product]) {
                        StdCallIns(_, _, given) => given
                        _ => []
                    }

                    if (factors.length() != 2) { continue }

                    immut first = definedBefore(instructions, product, factors[0], 'koji_unsafe_wide', reads, writes)
                    immut second = definedBefore(instructions, product, factors[1], 'koji_unsafe_wide', reads, writes)

                    if (first < 0 or second < 0 or first == second) { continue }

                    immut a = lowOf(instructions[first])
                    immut b = lowOf(instructions[second])

                    // The low words are not changed before the product is read.
                    if (changedBetween(instructions, first, position, a) or changedBetween(instructions, second, position, b)) { continue }

                    instructions[position] = BinaryIns(dest, 'IntMulWrapping', a, b, 0)
                    removed[product] = true
                    removed[first] = true
                    removed[second] = true
                    changed = true
                }
                _ => {}
            }
        }

        if (changed) {
            mut kept: Instruction[] = []

            for position in range(instructions.length()) {
                if (not removed[position]) { kept.push(instructions[position]) }
            }

            routine.blocks[block] = { instructions: kept, terminator: routine.blocks[block].terminator }
        }
    }

    return routine
}

// The position before `before` of the call of `name` that writes the local of `arg`, written and
// read once, or -1.
function definedBefore(instructions: Instruction[], before: int, arg: StdArg, name: string, reads: int[], writes: int[]): int {
    immut local = match (arg) {
        ValueArg(LocalOp(id)) => id
        _ => return -1
    }

    if (reads[local] != 1 or writes[local] != 1) { return -1 }

    mut position = before - 1

    while (position >= 0) {
        match (instructions[position]) {
            StdCallIns(Some(written), called, _) if (written == local) => return if (called == name) { position } else { -1 }
            _ => {}
        }

        position -= 1
    }

    return -1
}

// The low word given to `wide`.
function lowOf(instruction: Instruction): Operand {
    return match (instruction) {
        StdCallIns(_, _, args) => match (args[0]) {
            ValueArg(value) => value
            _ => IntOp(0)
        }
        _ => IntOp(0)
    }
}

function changedBetween(instructions: Instruction[], start: int, end: int, value: Operand): boolean {
    immut local = match (value) {
        LocalOp(id) => id
        _ => return false
    }

    for position in range(start + 1, end) {
        if (local in changes(instructions[position])) { return true }
    }

    return false
}

// The branches of a function made shorter, once (`simplify` repeats it, as each change may allow
// another): a branch on a constant is a jump; a branch on a local just copied branches on what was
// copied; a jump to an empty block that branches on the local the jumping block wrote last branches
// itself, on what it wrote (`l1 = l4; goto b8` where b8 is `branch l1, b5, b6`: the `and` of a
// condition); a branch to an empty block that branches on the same condition goes where that one
// would; a branch in a block reached only from a branch on the same local, which it does not
// change, goes the way that one went. Then the blocks nothing reaches are emptied, and the copies
// into locals nothing reads (of no references) removed.
function threaded(given: IrFunction): IrFunction {
    mut routine = given
    immut count = routine.blocks.length()

    for block in range(count) {
        immut instructions = routine.blocks[block].instructions
        immut last = instructions.length() - 1

        match (routine.blocks[block].terminator) {
            BranchT(BoolOp(value), thenBlock, elseBlock) => {
                routine.blocks[block] = { instructions: instructions, terminator: GotoT(if (value) { thenBlock } else { elseBlock }) }
            }
            BranchT(LocalOp(condition), thenBlock, elseBlock) if (last >= 0) => {
                match (instructions[last]) {
                    CopyIns(LocalPlace(written), value) if (written == condition and copiedCondition(value, condition)) => {
                        routine.blocks[block] = { instructions: instructions, terminator: BranchT(value, thenBlock, elseBlock) }
                    }
                    _ => {}
                }
            }
            GotoT(next) if (last >= 0 and routine.blocks[next].instructions.length() == 0) => {
                match (routine.blocks[next].terminator) {
                    BranchT(LocalOp(condition), thenBlock, elseBlock) => {
                        match (instructions[last]) {
                            CopyIns(LocalPlace(written), value) if (written == condition and copiedCondition(value, condition)) => {
                                routine.blocks[block] = { instructions: instructions, terminator: BranchT(value, thenBlock, elseBlock) }
                            }
                            _ => {}
                        }
                    }
                    _ => {}
                }
            }
            _ => {}
        }
    }

    for block in range(count) {
        match (routine.blocks[block].terminator) {
            BranchT(LocalOp(condition), thenBlock, elseBlock) => {
                immut instructions = routine.blocks[block].instructions
                immut thenTarget = match (routine.blocks[thenBlock].terminator) {
                    BranchT(LocalOp(again), target, _) if (sameCondition(instructions, condition, again) and routine.blocks[thenBlock].instructions.length() == 0 and thenBlock != block) => target
                    _ => thenBlock
                }
                immut elseTarget = match (routine.blocks[elseBlock].terminator) {
                    BranchT(LocalOp(again), _, target) if (sameCondition(instructions, condition, again) and routine.blocks[elseBlock].instructions.length() == 0 and elseBlock != block) => target
                    _ => elseBlock
                }
                routine.blocks[block] = { instructions: routine.blocks[block].instructions, terminator: BranchT(LocalOp(condition), thenTarget, elseTarget) }
            }
            _ => {}
        }
    }

    // The blocks reaching each one.
    mut sources: int[][] = []

    for block in range(count) {
        sources.push([])
    }

    for block in range(count) {
        for next in successors(routine.blocks[block].terminator) {
            sources[next].push(block)
        }
    }

    for block in range(count) {
        match (routine.blocks[block].terminator) {
            BranchT(LocalOp(condition), thenBlock, elseBlock) if (sources[block].length() == 1 and sources[block][0] != block and not writesLocal(routine.blocks[block].instructions, condition)) => {
                match (routine.blocks[sources[block][0]].terminator) {
                    BranchT(LocalOp(again), before, after) if (again == condition and before != after) => {
                        if (before == block) { routine.blocks[block] = { instructions: routine.blocks[block].instructions, terminator: GotoT(thenBlock) } }

                        if (after == block) { routine.blocks[block] = { instructions: routine.blocks[block].instructions, terminator: GotoT(elseBlock) } }
                    }
                    _ => {}
                }
            }
            _ => {}
        }
    }

    mut reachable: boolean[] = []

    for block in range(count) {
        reachable.push(false)
    }

    mut pending: int[] = [0]
    reachable[0] = true

    while (pending.length() > 0) {
        immut current = match (pending.pop()) {
            Some(block) => block
            None => break
        }

        for next in successors(routine.blocks[current].terminator) {
            if (not reachable[next]) {
                reachable[next] = true
                pending.push(next)
            }
        }
    }

    mut reads: int[] = []

    for local in routine.locals {
        reads.push(0)
    }

    for block in range(count) {
        if (not reachable[block]) {
            routine.blocks[block] = { instructions: [], terminator: UnreachableT }
            continue
        }

        for instruction in routine.blocks[block].instructions {
            for local in uses(instruction) {
                reads[local] += 1
            }
        }

        for local in terminatorUses(routine.blocks[block].terminator) {
            reads[local] += 1
        }
    }

    for block in range(count) {
        mut kept: Instruction[] = []
        mut removed = false

        for instruction in routine.blocks[block].instructions {
            match (instruction) {
                CopyIns(LocalPlace(dest), _) if (dest >= routine.params and reads[dest] == 0 and not isManaged(routine.locals[dest].ty)) => {
                    removed = true
                    continue
                }
                _ => {}
            }

            kept.push(instruction)
        }

        if (removed) { routine.blocks[block] = { instructions: kept, terminator: routine.blocks[block].terminator } }
    }

    return routine
}

// Whether a branch on `condition`, just given `value`, may branch on `value` instead.
function copiedCondition(value: Operand, condition: int): boolean {
    return match (value) {
        BoolOp(_) => true
        LocalOp(other) => other != condition
        _ => false
    }
}

// Whether `again` has the value of `condition` after the instructions of a block: it is the same
// local, or the last instruction copied one into the other.
function sameCondition(instructions: Instruction[], condition: int, again: int): boolean {
    if (again == condition) { return true }

    if (instructions.length() == 0) { return false }

    return match (instructions[instructions.length() - 1]) {
        CopyIns(LocalPlace(written), LocalOp(value)) => written == again and value == condition
        _ => false
    }
}

function writesLocal(instructions: Instruction[], local: int): boolean {
    for instruction in instructions {
        if (local in changes(instruction)) { return true }
    }

    return false
}

// The blocks in reverse postorder of a walk from the first one: a block comes after all those that
// go to it but by a jump back, so only a loop jumps back (where the native backend checks for
// preemption), and every loop does (a cycle cannot only go forward). The walk takes the first of
// where a block goes last, so that it comes right after the block when nothing else goes to it:
// more jumps go to the next block, which needs no instruction.
function laidOut(routine: IrFunction): IrFunction {
    immut count = routine.blocks.length()

    if (count == 0) { return routine }

    mut placed: boolean[] = []

    for block in range(count) {
        placed.push(false)
    }

    // The walk: the blocks being visited, with how many of the successors of each are visited.
    mut postorder: int[] = []
    mut stack: int[] = [0]
    mut visited: int[] = [0]
    placed[0] = true

    while (stack.length() > 0) {
        immut top = stack.length() - 1
        immut current = stack[top]
        immut next = successors(routine.blocks[current].terminator)

        if (visited[top] < next.length()) {
            // The successors from the last to the first.
            immut target = next[next.length() - 1 - visited[top]]
            visited[top] += 1

            if (not placed[target]) {
                placed[target] = true
                stack.push(target)
                visited.push(0)
            }

            continue
        }

        postorder.push(current)
        stack.pop()
        visited.pop()
    }

    mut order: int[] = []
    mut back = postorder.length() - 1

    while (back >= 0) {
        order.push(postorder[back])
        back -= 1
    }

    // The blocks nothing reaches, at the end.
    for block in range(count) {
        if (not placed[block]) { order.push(block) }
    }

    mut position: int[] = []

    for block in range(count) {
        position.push(0)
    }

    for i in range(count) {
        position[order[i]] = i
    }

    mut result = routine
    mut blocks: IrBlock[] = []

    for old in order {
        immut each = routine.blocks[old]
        immut ending = match (each.terminator) {
            GotoT(target) => GotoT(position[target])
            BranchT(condition, thenBlock, elseBlock) => BranchT(condition, position[thenBlock], position[elseBlock])
            _ => each.terminator
        }
        blocks.push({ instructions: each.instructions, terminator: ending })
    }

    result.blocks = blocks
    return result
}

// Whether an instruction computes a value of no references from its operands (which it reads
// before writing its result, so it may write one of them: `i = i + 1`).
function arithmetic(instruction: Instruction, routine: IrFunction): boolean {
    return match (instruction) {
        UnaryIns(dest, _, _, _) => not isManaged(routine.locals[dest].ty)
        BinaryIns(dest, _, _, _, _) => not isManaged(routine.locals[dest].ty)
        _ => false
    }
}

// The instruction writing `dest` instead of `temporary` (when it writes that one only).
function writing(instruction: Instruction, temporary: int, dest: int): Option[Instruction] {
    return match (instruction) {
        UnaryIns(written, op, value, line) if (written == temporary) => Some(UnaryIns(dest, op, value, line))
        BinaryIns(written, op, left, right, line) if (written == temporary) => Some(BinaryIns(dest, op, left, right, line))
        CallIns(Some(written), callee, args, writebacks, line) if (written == temporary) => Some(CallIns(Some(dest), callee, args, writebacks, line))
        ListGetIns(written, list, index, line) if (written == temporary) => Some(ListGetIns(dest, list, index, line))
        FieldGetIns(written, record, field) if (written == temporary) => Some(FieldGetIns(dest, record, field))
        StdCallIns(Some(written), name, args) if (written == temporary) => Some(StdCallIns(Some(dest), name, args))
        CallClosureIns(Some(written), closure, args, line) if (written == temporary) => Some(CallClosureIns(Some(dest), closure, args, line))
        _ => None
    }
}

function prepare(program: IrProgram, inlinable: boolean[], constants: boolean[], id: int, mut done: IrFunction[], mut ready: boolean[]) {
    if (ready[id]) { return }

    ready[id] = true

    // The callees first (a small function calls only small ones, so this ends).
    for block in program.functions[id].blocks {
        for instruction in block.instructions {
            match (instruction) {
                CallIns(_, callee, _, _, _) if (inlinable[callee] and not ready[callee]) => prepare(program, inlinable, constants, callee, mut done, mut ready)
                _ => {}
            }
        }
    }

    done[id] = inlineCalls(done[id], inlinable, constants, done)
}

// A function with the calls of the inlinable functions of its file replaced by their blocks.
function inlineCalls(routine: IrFunction, inlinable: boolean[], constants: boolean[], bodies: IrFunction[]): IrFunction {
    mut result = routine
    mut block = 0

    // The blocks of a callee come after the call, so this reaches them and the rest too.
    while (block < result.blocks.length()) {
        mut position = 0

        while (position < result.blocks[block].instructions.length()) {
            match (result.blocks[block].instructions[position]) {
                CallIns(dest, callee, args, writebacks, _) if (inlinable[callee] and bodies[callee].file == routine.file and aliasable(bodies[callee], args, writebacks, dest)) => {
                    splice(mut result, block, position, dest, bodies[callee], args, constants)
                    // The rest of the block moved to a new one.
                    break
                }
                _ => {}
            }

            position += 1
        }

        block += 1
    }

    return result
}

// Whether each `mut` parameter of the call is given a local that gets the value back, and nothing
// else reads that local in the call (so the function can change it in place).
function aliasable(callee: IrFunction, args: Operand[], writebacks: Writeback[], dest: Option[int]): boolean {
    for writeback in writebacks {
        if (writeback.target.path.length() > 0) { return false }

        immut local = match (writeback.target.root) {
            LocalPlace(id) => id
            GlobalPlace(_) => return false
        }

        if (args[writeback.param] != LocalOp(local) or dest == Some(local)) { return false }

        for i in range(args.length()) {
            if (i != writeback.param and args[i] == LocalOp(local)) { return false }
        }
    }

    // Every `mut` parameter gets its value back.
    for param in range(callee.params) {
        if (param < callee.writeback.length() and callee.writeback[param]) {
            mut found = false

            for writeback in writebacks {
                if (writeback.param == param) { found = true }
            }

            if (not found) { return false }
        }
    }

    return true
}

// The local of the caller that a local of the callee is.
function mapped(names: Names, id: int): int {
    if (id < names.aliases.length() and names.aliases[id] >= 0) { return names.aliases[id] }

    return names.base + id
}

// Replaces the call at `position` of `block`: the block ends there and goes to the blocks of the
// callee, whose returns go to a new block with the rest of the instructions; these come right
// after it, before the blocks that followed it (so a jump back is still a loop, as native.kj
// counts them).
function splice(mut routine: IrFunction, block: int, position: int, dest: Option[int], callee: IrFunction, args: Operand[], constants: boolean[]) {
    immut first = block + 1
    immut rest = first + callee.blocks.length()
    immut shift = callee.blocks.length() + 1
    immut instructions = routine.blocks[block].instructions
    mut changed: Set[int] = Set.from([])

    for each in callee.blocks {
        for instruction in each.instructions {
            for local in changes(instruction) {
                changed.add(local)
            }
        }
    }

    mut names: Names = { base: routine.locals.length(), given: [], aliases: [] }

    for param in range(callee.params) {
        immut fixed = match (args[param]) {
            GlobalOp(id) => constants[id]
            _ => true
        }
        immut written = param < callee.writeback.length() and callee.writeback[param]

        names.given.push(if (fixed and not written and not changed.has(param)) { Some(args[param]) } else { None })
        names.aliases.push(if (written) {
            match (args[param]) {
                LocalOp(local) => local
                _ => -1
            }
        } else { -1 })
    }

    for local in callee.locals {
        routine.locals.push(local)
    }

    mut before = instructions[..position]

    for param in range(callee.params) {
        if (names.given[param] is None and names.aliases[param] < 0) { before.push(CopyIns(place(LocalPlace(param), names), args[param])) }
    }

    immut after: IrBlock = { instructions: instructions[position + 1..], terminator: shifted(routine.blocks[block].terminator, block, shift) }
    mut blocks: IrBlock[] = []

    for each in routine.blocks[..block] {
        blocks.push({ instructions: each.instructions, terminator: shifted(each.terminator, block, shift) })
    }

    blocks.push({ instructions: before, terminator: GotoT(first) })

    for each in callee.blocks {
        mut moved: Instruction[] = []

        for instruction in each.instructions {
            moved.push(renamed(instruction, names))
        }

        immut ending = match (each.terminator) {
            GotoT(target) => GotoT(first + target)
            BranchT(condition, thenBlock, elseBlock) => BranchT(operand(condition, names), first + thenBlock, first + elseBlock)
            ReturnT(value) => {
                match (value) {
                    Some(given) => {
                        match (dest) {
                            Some(local) => moved.push(CopyIns(LocalPlace(local), operand(given, names)))
                            None => {}
                        }
                    }
                    None => {}
                }

                GotoT(rest)
            }
            UnreachableT => UnreachableT
        }

        blocks.push({ instructions: moved, terminator: ending })
    }

    blocks.push(after)

    for each in routine.blocks[block + 1..] {
        blocks.push({ instructions: each.instructions, terminator: shifted(each.terminator, block, shift) })
    }

    routine.blocks = blocks
}

// A terminator of the caller once `shift` blocks come after `block`.
function shifted(terminator: Terminator, block: int, shift: int): Terminator {
    return match (terminator) {
        GotoT(target) => GotoT(moved(target, block, shift))
        BranchT(condition, thenBlock, elseBlock) => BranchT(condition, moved(thenBlock, block, shift), moved(elseBlock, block, shift))
        _ => terminator
    }
}

function moved(target: int, block: int, shift: int): int {
    return if (target > block) { target + shift } else { target }
}

// The locals of an instruction of the callee as locals of the caller (from `base`).
function renamed(instruction: Instruction, names: Names): Instruction {
    return match (instruction) {
        CopyIns(dest, value) => CopyIns(place(dest, names), operand(value, names))
        UnaryIns(dest, op, value, line) => UnaryIns(mapped(names, dest), op, operand(value, names), line)
        BinaryIns(dest, op, left, right, line) => BinaryIns(mapped(names, dest), op, operand(left, names), operand(right, names), line)
        CallIns(dest, callee, args, writebacks, line) => {
            mut backs: Writeback[] = []

            for writeback in writebacks {
                backs.push({ param: writeback.param, target: target(writeback.target, names) })
            }

            CallIns(local(dest, names), callee, operands(args, names), backs, line)
        }
        ListNewIns(dest, items) => ListNewIns(mapped(names, dest), operands(items, names))
        ListGetIns(dest, list, index, line) => ListGetIns(mapped(names, dest), operand(list, names), operand(index, names), line)
        ListSetIns(list, index, value, line) => ListSetIns(target(list, names), operand(index, names), operand(value, names), line)
        ListPushIns(list, value, line) => ListPushIns(target(list, names), operand(value, names), line)
        ListInsertIns(list, index, value, line) => ListInsertIns(target(list, names), operand(index, names), operand(value, names), line)
        ListSortIns(list, line) => ListSortIns(target(list, names), line)
        ListSliceIns(dest, list, start, end, line) => ListSliceIns(mapped(names, dest), operand(list, names), optional(start, names), optional(end, names), line)
        RecordNewIns(dest, variant, fields) => RecordNewIns(mapped(names, dest), variant, operands(fields, names))
        FieldGetIns(dest, record, field) => FieldGetIns(mapped(names, dest), operand(record, names), field)
        FieldSetIns(record, field, value, line) => FieldSetIns(target(record, names), field, operand(value, names), line)
        ListRemoveIns(dest, list, index, line) => ListRemoveIns(mapped(names, dest), target(list, names), optional(index, names), line)
        StdCallIns(dest, name, args) => {
            mut given: StdArg[] = []

            for arg in args {
                given.push(match (arg) {
                    ValueArg(value) => ValueArg(operand(value, names))
                    PlaceArg(value) => PlaceArg(operand(value, names))
                    _ => arg
                })
            }

            StdCallIns(local(dest, names), name, given)
        }
        TakeIns(dest, source) => TakeIns(mapped(names, dest), place(source, names))
        DropIns(value, dropper) => DropIns(place(value, names), dropper)
        MakeClosureIns(dest, code, environment) => MakeClosureIns(mapped(names, dest), code, optional(environment, names))
        CallClosureIns(dest, closure, args, line) => CallClosureIns(local(dest, names), operand(closure, names), operands(args, names), line)
        ListSortByIns(list, comparison, line) => ListSortByIns(target(list, names), operand(comparison, names), line)
        MapNewIns(dest, entries) => {
            mut moved: MapEntry[] = []

            for entry in entries {
                moved.push({ key: operand(entry.key, names), value: operand(entry.value, names) })
            }

            MapNewIns(mapped(names, dest), moved)
        }
        MapGetIns(dest, map, key, line) => MapGetIns(mapped(names, dest), operand(map, names), operand(key, names), line)
        MapLookupIns(dest, map, key) => MapLookupIns(mapped(names, dest), operand(map, names), operand(key, names))
        MapSetIns(map, key, value, line) => MapSetIns(target(map, names), operand(key, names), optional(value, names), line)
        MapRemoveIns(dest, map, key, line) => MapRemoveIns(mapped(names, dest), target(map, names), operand(key, names), line)
        FailIns(message, line) => FailIns(operand(message, names), line)
        PrintIns(value, line) => PrintIns(operand(value, names), line)
        RangeNextIns(hasValue, value, next, end, step, done) => RangeNextIns(mapped(names, hasValue), mapped(names, value), mapped(names, next), operand(end, names), operand(step, names), mapped(names, done))
        RangeCheckIns(step, line) => RangeCheckIns(operand(step, names), line)
    }
}

function operand(value: Operand, names: Names): Operand {
    return match (value) {
        LocalOp(id) => {
            if (id < names.given.length()) {
                match (names.given[id]) {
                    Some(given) => return given
                    None => {}
                }
            }

            LocalOp(mapped(names, id))
        }
        _ => value
    }
}

function operands(values: Operand[], names: Names): Operand[] {
    mut moved: Operand[] = []

    for value in values {
        moved.push(operand(value, names))
    }

    return moved
}

function optional(value: Option[Operand], names: Names): Option[Operand] {
    return match (value) {
        Some(given) => Some(operand(given, names))
        None => None
    }
}

function local(dest: Option[int], names: Names): Option[int] {
    return match (dest) {
        Some(id) => Some(mapped(names, id))
        None => None
    }
}

function place(where: Place, names: Names): Place {
    return match (where) {
        LocalPlace(id) => LocalPlace(mapped(names, id))
        GlobalPlace(_) => where
    }
}

function target(where: Target, names: Names): Target {
    mut steps: Step[] = []

    for step in where.path {
        steps.push(match (step) {
            IndexStep(index) => IndexStep(operand(index, names))
            KeyStep(key) => KeyStep(operand(key, names))
            FieldStep(_) => step
        })
    }

    return { root: place(where.root, names), path: steps }
}
