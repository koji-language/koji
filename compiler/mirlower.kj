// The lowering of the IR to the machine IR (mir.kj): the semantics of Koji decided once for every
// processor. Values are of one word (ints, booleans, chars, bytes, floats, and the references of
// strings, lists, records, maps and closures) or of two (decimals and U128: a pair of virtual
// registers); the functions of the library that the C backend writes inline (the memory of
// `koji:unsafe`, the pool, the accessors) are written inline here too, the instructions of the
// processor that `koji:unsafe` names as `MMachine`.
//
// The references are counted as in the other backends (see "Reference counting" in
// doc/design.md): a function owns a reference to each managed local but the borrowed ones
// (borrow.kj), retains a parameter when it starts, releases a local once read for the last time
// (liveness.kj) or when it is given another value, moves a value read for the last time instead of
// retaining it, and releases the locals it still holds when it returns. Which locals may hold a
// reference at each point is known (`held`): only those are released, and a local held where
// paths meet is set to none at the end of the paths where it is not.

import { Ty, Operand, Place, Target, Step, Instruction, Terminator, IrFunction, IrProgram, StdArg, isManaged, itemOf, tyText } from 'ir.kj'
import { MValue, MAddress, MCallee, MInstruction, MTerminator, MBlock, MPanic, MFunctionCode } from 'mir.kj'
import { lastUses, defs, uses, terminatorUses, successors, targetReads } from 'liveness.kj'
import { addBit, removeBit, hasBit, bitMembers } from 'bits.kj'
import { borrowedLocals, changes } from 'borrow.kj'
import { floatWord, decimalBits } from 'constants.kj'
import { targetPlatform } from 'inline.kj'

// What the lowering needs to know of the object: the offsets of the globals (in .bss), of the
// string literals and of the descriptions of the records (in .data), the borrowed parameters of
// each function, and the globals that never change.
export type MirContext = {
    globals: int[]
    strings: int[]
    records: int[]
    borrowed: boolean[][]
    constants: boolean[]
    // The globals each function may see (globals.kj).
    seen: Set[int][]
}

// The values of one word of no references: ints, booleans, chars, bytes and floats.
function scalar(ty: Ty): boolean {
    return ty == IntTy or ty == BoolTy or ty == CharTy or ty == ByteTy or ty == FloatTy or ty == VoidTy
}

// The values of one word: scalars, and references (strings, lists, records, maps, sets, closures).
function word(ty: Ty): boolean {
    return scalar(ty) or isManaged(ty)
}

// The runtime's name for the values of a managed type (`koji_string_free`), or ''.
function kindOf(ty: Ty): string {
    return match (ty) {
        StrTy => 'string'
        ListTy(_) => 'list'
        RecordTy(_) => 'record'
        MapTy(_, _) => 'map'
        SetTy(_) => 'map'
        FunctionTy(_, _) => 'closure'
        _ => ''
    }
}

// Why the machine IR does not lower the function `id` ('' when it does): the error of the native
// backend for an instruction it does not know.
export function mirRefusal(program: IrProgram, id: int): string {
    immut routine = program.functions[id]

    for local in routine.locals {
        if (not oneOrTwo(local.ty)) { return `a local of ${tyText(local.ty)}` }
    }

    if (not oneOrTwo(routine.returns) and routine.returns != VoidTy) { return `a result of ${tyText(routine.returns)}` }



    for block in routine.blocks {
        // The first block starts the function only (its locals set to none there).
        if (0 in successors(block.terminator)) { return 'a jump to the first block' }

        for instruction in block.instructions {
            if (not lowered(program, instruction)) { return kindText(instruction) }

            if (widened(program, routine, instruction) and not wideLowered(program, routine, instruction)) { return `${kindText(instruction)} of two words` }
        }

        immut ending = match (block.terminator) {
            BranchT(condition, _, _) => simpleOperand(program, condition)
            ReturnT(Some(value)) => simpleOperand(program, value)
            _ => true
        }

        if (not ending) { return 'an operand of a terminator' }
    }

    return ''
}

// Values of one word, or of two (a decimal, a U128: a pair of virtual registers).
function oneOrTwo(ty: Ty): boolean {
    return word(ty) or wideType(ty)
}

// Whether an instruction reads or writes a value of two words.
function widened(program: IrProgram, routine: IrFunction, instruction: Instruction): boolean {
    for local in uses(instruction) + defs(instruction) {
        if (wideType(routine.locals[local].ty)) { return true }
    }

    match (instruction) {
        CopyIns(GlobalPlace(id), _) => {
            if (wideType(program.globals[id].ty)) { return true }
        }
        _ => {}
    }

    immut operands = operandsOf(instruction)

    for operand in operands {
        match (operand) {
            DecimalOp(_, _, _, _) => return true
            GlobalOp(id) => {
                if (wideType(program.globals[id].ty)) { return true }
            }
            _ => {}
        }
    }

    return false
}

// The operands an instruction reads (those of its targets too).
function operandsOf(instruction: Instruction): Operand[] {
    mut found: Operand[] = []

    match (instruction) {
        CopyIns(_, value) => found.push(value)
        UnaryIns(_, _, value, _) => found.push(value)
        BinaryIns(_, _, left, right, _) => found = [left, right]
        CallIns(_, _, args, writebacks, _) => {
            found = args

            for each in writebacks {
                found = found + stepOperands(each.target)
            }
        }
        ListNewIns(_, items) => found = items
        ListGetIns(_, list, index, _) => found = [list, index]
        ListSetIns(list, index, value, _) => found = stepOperands(list) + [index, value]
        ListPushIns(list, value, _) => found = stepOperands(list) + [value]
        ListInsertIns(list, index, value, _) => found = stepOperands(list) + [index, value]
        ListSortIns(list, _) => found = stepOperands(list)
        ListSliceIns(_, list, _, _, _) => found.push(list)
        RecordNewIns(_, _, fields) => found = fields
        FieldGetIns(_, record, _) => found.push(record)
        FieldSetIns(record, _, value, _) => found = stepOperands(record) + [value]
        ListRemoveIns(_, list, _, _) => found = stepOperands(list)
        StdCallIns(_, _, args) => {
            for arg in args {
                match (arg) {
                    ValueArg(value) => found.push(value)
                    PlaceArg(value) => found.push(value)
                    _ => {}
                }
            }
        }
        MapNewIns(_, entries) => {
            for entry in entries {
                found.push(entry.key)
                found.push(entry.value)
            }
        }
        MapGetIns(_, map, key, _) => found = [map, key]
        MapLookupIns(_, map, key) => found = [map, key]
        MapSetIns(map, key, value, _) => {
            found = stepOperands(map) + [key]

            match (value) {
                Some(given) => found.push(given)
                None => {}
            }
        }
        MapRemoveIns(_, map, key, _) => found = stepOperands(map) + [key]
        CallClosureIns(_, closure, args, _) => found = [closure] + args
        _ => {}
    }

    return found
}

function stepOperands(target: Target): Operand[] {
    mut found: Operand[] = []

    for step in target.path {
        match (step) {
            IndexStep(index) => found.push(index)
            KeyStep(key) => found.push(key)
            FieldStep(_) => {}
        }
    }

    return found
}

immut wideUnaries = ['U128Not', 'IntToU128', 'U128ToStr', 'DecimalNeg', 'IntToDecimal', 'FloatToDecimal', 'DecimalToFloat', 'DecimalToInt', 'DecimalToStr']

// The instructions on values of two words the machine IR lowers.
function wideLowered(program: IrProgram, routine: IrFunction, instruction: Instruction): boolean {
    return match (instruction) {
        CopyIns(_, _) => true
        UnaryIns(_, op, _, _) => op in wideUnaries
        BinaryIns(_, op, _, _, _) => op.startsWith('U128') or op.startsWith('Decimal') or op in ['ListContains', 'MapContains', 'ListIndexOf']
        CallIns(_, _, _, _, _) => true
        StdCallIns(_, _, _) => true
        CallClosureIns(_, _, _, _) => true
        FieldGetIns(_, _, _) => true
        RecordNewIns(_, _, _) => true
        ListGetIns(_, _, _, _) => true
        ListNewIns(_, _) => true
        ListPushIns(_, _, _) => true
        ListSetIns(_, _, _, _) => true
        ListInsertIns(_, _, _, _) => true
        ListRemoveIns(_, _, _, _) => true
        FieldSetIns(_, _, _, _) => true
        MapNewIns(_, _) => true
        MapGetIns(_, _, _, _) => true
        MapLookupIns(_, _, _) => true
        MapSetIns(_, _, _, _) => true
        MapRemoveIns(_, _, _, _) => true
        _ => false
    }
}

// The `mut` parameters of a function (each given the address where its final value goes).
function mutCount(routine: IrFunction): int {
    mut count = 0

    for writeback in routine.writeback {
        if (writeback) { count += 1 }
    }

    return count
}

// A variable, or a place inside one (its steps of simple operands).
function simpleTarget(program: IrProgram, target: Target): boolean {
    match (target.root) {
        GlobalPlace(id) => {
            if (not word(program.globals[id].ty)) { return false }
        }
        _ => {}
    }

    for step in target.path {
        immut fine = match (step) {
            IndexStep(index) => simpleOperand(program, index)
            KeyStep(key) => simpleOperand(program, key)
            FieldStep(_) => true
        }

        if (not fine) { return false }
    }

    return true
}

function simpleOperand(program: IrProgram, operand: Operand): boolean {
    return match (operand) {
        LocalOp(_) => true
        IntOp(_) => true
        BoolOp(_) => true
        CharOp(_) => true
        FloatOp(_) => true
        StrOp(_) => true
        LocationOp(_) => true
        DecimalOp(_, _, _, _) => true
        GlobalOp(id) => oneOrTwo(program.globals[id].ty)
        _ => false
    }
}

immut unaries = ['IntNeg', 'Not', 'BitNot', 'ByteNot', 'CharCode', 'ByteToInt', 'CodeToChar', 'IntToByte', 'FloatNeg', 'IntToFloat', 'FloatTruncate']
immut binaries = ['IntAdd', 'IntSub', 'IntMul', 'IntDiv', 'IntRem', 'IntMulWrapping', 'BitAnd', 'BitOr', 'BitXor', 'ByteAnd', 'ByteOr', 'ByteXor', 'ByteAdd', 'ByteSub', 'ByteMul', 'FloatAdd', 'FloatSub', 'FloatMul', 'FloatDiv', 'FloatRem', 'FloatPow']

// The operations of one value done by a function of the library.
immut unaryHelpers: Map[string, string] = [
    'ByteToStr': 'koji_string_from_int',
    'IntToStr': 'koji_string_from_int',
    'FloatToStr': 'koji_string_from_float',
    'BoolToStr': 'koji_string_from_bool',
    'CharToStr': 'koji_string_from_char',
    'CharRepr': 'koji_char_repr',
    'ListToStr': 'koji_list_repr',
    'StrLength': 'koji_string_length',
    'StrRepr': 'koji_string_repr',
    'RecordToStr': 'koji_record_display',
    'RecordRepr': 'koji_record_repr',
    'MapLength': 'koji_map_length',
    'MapToStr': 'koji_map_repr',
    'MapKeys': 'koji_map_keys',
    'MapValues': 'koji_map_values',
    'SetFromList': 'koji_set_from_list',
    'ClosureToStr': 'koji_closure_repr'
]

// The operations of two values done by a function of the library: those after `placed` are also
// given the place of the instruction, for their panics.
immut binaryHelpers: Map[string, string] = [
    'StrConcat': 'koji_string_concat',
    'StrRepeat': 'koji_string_repeat',
    'ListConcat': 'koji_list_concat',
    'ListJoin': 'koji_list_join',
    'IntPow': 'koji_int_pow',
    'BytePow': 'koji_byte_pow'
]
immut placed = ['IntPow', 'BytePow']
// Done inline, checked.
immut checkedBinaries = ['ShiftLeft', 'ShiftRight', 'ByteDiv', 'ByteRem', 'ByteShiftLeft', 'ByteShiftRight']

// A word of a value read inline (the accessors of the prelude): its offset (an address inside the
// value for a negative one).
immut accessors: Map[string, int] = ['koji_list_length': 32, 'koji_record_tag': 16, 'koji_unsafe_string_size': 8, 'koji_unsafe_string_bytes': -24, 'koji_unsafe_list_items': 24, 'koji_unsafe_string_references': 0, 'koji_unsafe_string_capacity': 16, 'koji_element_size': 0]

// The memory of `koji:unsafe`, inline: the widths of its reads and writes.
immut memoryWidths: Map[string, int] = ['koji_unsafe_read_int': 8, 'koji_unsafe_read_float': 8, 'koji_unsafe_read_bool': 1, 'koji_unsafe_read_byte': 1, 'koji_unsafe_read_char': 4, 'koji_unsafe_write_int': 8, 'koji_unsafe_write_float': 8, 'koji_unsafe_write_bool': 1, 'koji_unsafe_write_byte': 1, 'koji_unsafe_write_char': 4]

// The instructions of the processor `koji:unsafe` names (`MMachine`).
immut machineInstructions: Map[string, string] = ['koji_unsafe_reverse_bytes': 'bswap', 'koji_aes_available': 'aesAvailable', 'koji_unsafe_aes_round': 'aesRound', 'koji_unsafe_aes_last_round': 'aesLastRound', 'koji_unsafe_carryless_product': 'carryless', 'koji_unsafe_float_control': 'floatControl', 'koji_unsafe_valgrind': 'valgrind']

// The functions of `koji:unsafe` and of the pool the machine IR writes itself (see `libraryCall`).
immut inlineLibrary = ['koji_unsafe_switch_stacks', 'koji_unsafe_task_entry', 'koji_unsafe_wide', 'koji_unsafe_low_word', 'koji_unsafe_high_word', 'koji_unsafe_word_product', 'koji_unsafe_decimal_low', 'koji_unsafe_decimal_high', 'koji_unsafe_decimal_of', 'koji_unsafe_leading_zeros', 'koji_unsafe_offset', 'koji_unsafe_distance', 'koji_unsafe_allocate', 'koji_unsafe_free', 'koji_unsafe_new_string', 'koji_unsafe_blank_string', 'koji_unsafe_set_string_size', 'koji_unsafe_set_list_length', 'koji_pool_heads', 'koji_pool_is_off', 'koji_memory_take', 'koji_pool_take', 'koji_memory_give', 'koji_pool_give', 'koji_record_field_count', 'koji_record_field_type', 'koji_record_field_slot', 'koji_record_get', 'koji_element_counted', 'koji_element_retain', 'koji_element_release']

function lowered(program: IrProgram, instruction: Instruction): boolean {
    return match (instruction) {
        CopyIns(dest, value) => simpleOperand(program, value) and match (dest) {
            LocalPlace(_) => true
            GlobalPlace(id) => oneOrTwo(program.globals[id].ty)
        }
        UnaryIns(_, op, value, _) => (op in unaries or op in wideUnaries or unaryHelpers.has(op) or op == 'ListLength' or op == 'RecordTag') and simpleOperand(program, value)
        BinaryIns(_, op, left, right, _) => simpleOperand(program, left) and simpleOperand(program, right) and (op in binaries or comparison(op) != '' or op in checkedBinaries or binaryHelpers.has(op) or op.startsWith('U128') or op.startsWith('Decimal') or objectComparison(op) != '' or op in ['StrContains', 'StrContainsChar', 'ListContains', 'MapContains', 'ListIndexOf'])
        CallIns(_, callee, args, writebacks, _) => {
            if (not mirLowersSignature(program, callee)) { return false }

            for arg in args {
                if (not simpleOperand(program, arg)) { return false }
            }

            for writeback in writebacks {
                if (not simpleTarget(program, writeback.target)) { return false }
            }

            true
        }
        StdCallIns(dest, name, args) => lowersLibraryCall(program, dest, name, args)
        TakeIns(_, source) => match (source) {
            LocalPlace(_) => true
            GlobalPlace(id) => word(program.globals[id].ty)
        }
        FieldGetIns(_, record, _) => simpleOperand(program, record)
        RecordNewIns(_, _, fields) => {
            for field in fields {
                if (not simpleOperand(program, field)) { return false }
            }

            true
        }
        ListNewIns(_, items) => {
            for item in items {
                if (not simpleOperand(program, item)) { return false }
            }

            true
        }
        ListGetIns(_, list, index, _) => simpleOperand(program, list) and simpleOperand(program, index)
        ListPushIns(list, value, _) => simpleTarget(program, list) and simpleOperand(program, value)
        ListInsertIns(list, index, value, _) => simpleTarget(program, list) and simpleOperand(program, index) and simpleOperand(program, value)
        ListSortIns(list, _) => simpleTarget(program, list)
        ListRemoveIns(_, list, index, _) => simpleTarget(program, list) and match (index) {
            Some(position) => simpleOperand(program, position)
            None => true
        }
        ListSliceIns(_, list, start, end, _) => {
            for bound in [start, end] {
                match (bound) {
                    Some(value) => {
                        if (not simpleOperand(program, value)) { return false }
                    }
                    None => {}
                }
            }

            simpleOperand(program, list)
        }
        MapNewIns(_, entries) => {
            for entry in entries {
                if (not simpleOperand(program, entry.key) or not simpleOperand(program, entry.value)) { return false }
            }

            true
        }
        MapGetIns(_, map, key, _) => simpleOperand(program, map) and simpleOperand(program, key)
        MapLookupIns(_, map, key) => simpleOperand(program, map) and simpleOperand(program, key)
        MapSetIns(map, key, value, _) => simpleTarget(program, map) and simpleOperand(program, key) and match (value) {
            Some(given) => simpleOperand(program, given)
            None => true
        }
        MapRemoveIns(_, map, key, _) => simpleTarget(program, map) and simpleOperand(program, key)
        ListSetIns(list, index, value, _) => simpleTarget(program, list) and simpleOperand(program, index) and simpleOperand(program, value)
        FieldSetIns(record, _, value, _) => simpleTarget(program, record) and simpleOperand(program, value)
        MakeClosureIns(_, _, environment) => match (environment) {
            Some(value) => simpleOperand(program, value)
            None => true
        }
        CallClosureIns(_, closure, args, _) => {
            for arg in args {
                if (not simpleOperand(program, arg)) { return false }
            }

            simpleOperand(program, closure)
        }
        ListSortByIns(list, comparison, _) => simpleTarget(program, list) and simpleOperand(program, comparison)
        DropIns(place, _) => match (place) {
            LocalPlace(_) => true
            GlobalPlace(id) => word(program.globals[id].ty)
        }
        PrintIns(value, _) => simpleOperand(program, value)
        FailIns(value, _) => simpleOperand(program, value)
        RangeNextIns(_, _, _, end, step, _) => simpleOperand(program, end) and simpleOperand(program, step)
        RangeCheckIns(step, _) => simpleOperand(program, step)
        _ => false
    }
}

// A call of a function of the library that the machine IR makes: one it writes inline, or a call
// (a job for one of a foreign block that blocks).
function lowersLibraryCall(program: IrProgram, dest: Option[int], name: string, args: StdArg[]): boolean {
    if (accessors.has(name) or memoryWidths.has(name) or name in inlineLibrary) { return true }

    if (name in inlineLibrary or machineInstructions.has(name) or name in ['koji_list_shared_get', 'koji_list_shared_set']) { return true }

    // A job of a function that blocks: of 6 words at most, of a result of one word.
    for each in program.externs {
        if (each.name == name and each.blocking and (args.length() > 6 or each.returns == 'double')) { return false }
    }

    for arg in args {
        match (arg) {
            ValueArg(value) => {
                if (not simpleOperand(program, value)) { return false }
            }
            PlaceArg(value) => {
                if (not simpleOperand(program, value)) { return false }
            }
            _ => {}
        }
    }

    return true
}

// A function with parameters and a result the machine IR passes (words).
function mirLowersSignature(program: IrProgram, id: int): boolean {
    immut routine = program.functions[id]

    for param in range(routine.params) {
        if (not oneOrTwo(routine.locals[param].ty)) { return false }
    }

    return oneOrTwo(routine.returns) or routine.returns == VoidTy
}

// A shift by a constant from 0 to 63 (the others go through the library).
function shift(op: string, right: Operand): boolean {
    if (op != 'ShiftLeft' and op != 'ShiftRight') { return false }

    return match (right) {
        IntOp(count) => count >= 0 and count < 64
        _ => false
    }
}

// The condition of a comparison of scalars (`IntCompare(Less)`), or ''.
function comparison(op: string): string {
    for name in ['IntCompare(', 'BoolCompare(', 'CharCompare(', 'ByteCompare(', 'FloatCompare('] {
        if (op.startsWith(name)) { return conditionOf(op[name.length()..op.length() - 1]) }
    }

    return ''
}

function conditionOf(name: string): string {
    return match (name) {
        'Equal' => 'eq'
        'NotEqual' => 'ne'
        'Less' => 'lt'
        'LessEqual' => 'le'
        'Greater' => 'gt'
        'GreaterEqual' => 'ge'
        _ => ''
    }
}

// The condition of a comparison of strings, lists, maps or records (by the library), or ''.
function objectComparison(op: string): string {
    if (op.startsWith('StrCompare(')) { return conditionOf(op['StrCompare('.length()..op.length() - 1]) }

    for name in ['ListCompare(', 'MapCompare(', 'RecordCompare('] {
        if (op.startsWith(name)) {
            immut condition = conditionOf(op[name.length()..op.length() - 1])
            return if (condition == 'eq' or condition == 'ne') { condition } else { '' }
        }
    }

    return ''
}

// The address of the variable of a target (see `Lowering.variable`), and the local in a slot.
type Variable = {
    address: int
    slot: int
    root: int
}

type Lowering = {
    program: IrProgram
    routine: IrFunction
    context: MirContext
    floats: boolean[]
    blocks: MBlock[]
    current: MInstruction[]
    panics: MPanic[]
    // The panic of each place and message, by `place|message`.
    panicIndex: Map[string, int]
    reads: int[]
    // For each local, whether the function owns its references (managed, not borrowed), and
    // whether it may hold one now.
    owned: boolean[]
    held: int[]
    // The locals each instruction reads for the last time (liveness.kj), and where the lowering is.
    live: int[][][]
    block: int
    position: int
    // The locals a `TakeIns` empties, set to none when the function starts (see `step`).
    emptied: boolean[]
    // For each local of two words, the virtual register of its high word (the low one is the
    // local's), or -1.
    highs: int[]
    // For each local, the variant of the record it holds when it is only compared (see
    // `tagOnlyLocals`), or -1.
    tagOnly: int[]
    // The `mut` parameters: theirs is the reference the caller gives (never released nor moved
    // out but to the address where their final values go, in `outs`, when the function returns).
    writeback: boolean[]
    outs: int[]
    slots: int[]
    slotsUsed: int
    // For each block after those of the IR, the block of the IR it continues (-2 less it when cold).
    owners: int[]
    // The char whose string the next instruction adds (see `charAdded`).
    charValue: MValue
    // The block of the machine IR being written: that of the block of the IR (the same number), or
    // one after them that goes on with it or that an instruction branches to (`newBlock`).
    piece: int
}

// The machine IR of the function `id` (which `mirLowers`); `preemptible` tells whether it checks
// for preemption (where it starts when it calls, and at the jumps back of its loops).
export function lowerMir(program: IrProgram, id: int, context: MirContext, preemptible: boolean): MFunctionCode {
    immut routine = program.functions[id]
    immut borrowed = borrowedLocals(routine, context.borrowed[id], context.constants)
    mut floats: boolean[] = []
    mut reads: int[] = []
    mut owned: boolean[] = []
    mut emptied: boolean[] = []
    mut writeback: boolean[] = []

    for local in range(routine.locals.length()) {
        immut ty = routine.locals[local].ty
        immut given = local < routine.writeback.length() and routine.writeback[local]
        floats.push(ty == FloatTy)
        reads.push(0)
        owned.push(isManaged(ty) and (given or not borrowed[local]))
        emptied.push(false)
        writeback.push(given)
    }

    for block in routine.blocks {
        for instruction in block.instructions {
            for local in uses(instruction) {
                reads[local] += 1
            }

            match (instruction) {
                TakeIns(_, LocalPlace(source)) => emptied[source] = true
                DropIns(LocalPlace(source), _) => emptied[source] = true
                _ => {}
            }
        }

        for local in terminatorUses(block.terminator) {
            reads[local] += 1
        }
    }

    // The records of a variant without fields only compared: never made (their variant is known).
    immut tagOnly = tagOnlyLocals(program, routine)

    for local in range(routine.locals.length()) {
        if (tagOnly[local] >= 0) { owned[local] = false }
    }

    mut self: Lowering = { program: program, routine: routine, context: context, floats: floats, blocks: [], current: [], panics: [], panicIndex: [:], reads: reads, owned: owned, held: [], live: lastUses(routine), block: 0, position: 0, emptied: emptied, tagOnly: tagOnly, highs: [], writeback: writeback, outs: [], slots: [], slotsUsed: 0, owners: [], charValue: MImm(0), piece: 0 }
    // The high words of the locals of two words, each in a virtual register of its own.
    for local in range(routine.locals.length()) {
        self.highs.push(if (wideType(routine.locals[local].ty)) { self.temporary() } else { -1 })
    }

    mut params: int[] = []
    mut pairs: int[] = []
    mut aligned: int[] = []

    for param in range(routine.params) {
        if (routine.locals[param].ty == U128Ty) { aligned.push(params.length()) }

        if (self.highs[param] >= 0) { pairs.push(params.length()) }

        params.push(param)

        if (self.highs[param] >= 0) { params.push(self.highs[param]) }
    }

    for param in range(routine.params) {
        if (writeback[param]) {
            immut out = self.temporary()
            self.outs.push(out)
            params.push(out)
        } else {
            self.outs.push(-1)
        }
    }

    for block in routine.blocks {
        self.blocks.push({ instructions: [], terminator: MUnreachable })
    }

    immut heldIn = self.heldAtBlocks()
    immut calls = makesCalls(routine)

    for block in range(routine.blocks.length()) {
        self.startPiece(block)
        self.block = block
        self.held = heldIn[block]

        if (block == 0) {
            // A reference of its own to each parameter it owns; the locals a `TakeIns` empties,
            // none (they may be read before they are written).
            for param in range(routine.params) {
                if (owned[param] and not writeback[param]) { self.current.push(MRetain(MReg(param))) }
            }

            for local in range(routine.params, routine.locals.length()) {
                if (owned[local] and emptied[local]) { self.current.push(MMove(local, MImm(0))) }
            }

            if (preemptible and calls) { self.current.push(MPreempt) }
        }

        immut instructions = routine.blocks[block].instructions

        for position in range(instructions.length()) {
            self.position = position
            self.slotsUsed = 0
            self.instruction(instructions[position])
            self.step(mut self.held, instructions[position], block, position, true)
        }

        self.position = instructions.length()
        immut terminator = routine.blocks[block].terminator
        immut back = match (terminator) {
            GotoT(target) => target <= block
            BranchT(_, thenBlock, elseBlock) => thenBlock <= block or elseBlock <= block
            _ => false
        }

        if (back and preemptible) { self.current.push(MPreempt) }

        immut ending = self.terminator(terminator)

        // The locals held where the paths from here meet others that hold them: none here.
        mut wanted = self.held
        immut following = successors(terminator)

        for word in range(wanted.length()) {
            mut merged = 0

            for next in following {
                merged = merged | heldIn[next][word]
            }

            wanted[word] = merged & ~self.held[word]
        }

        for local in bitMembers(wanted) {
            if (owned[local]) { self.current.push(MMove(local, MImm(0))) }
        }

        self.endPiece(ending)
    }

    immut order = self.layout()
    return { name: routine.name, params: params, floats: self.floats, blocks: self.ordered(order), cold: self.coldOrdered(order), slots: self.slots, panics: self.panics, results: if (routine.returns == VoidTy) { [] } else { if (wideType(routine.returns)) { [false, false] } else { [routine.returns == FloatTy] } }, pairs: pairs, aligned: aligned }
}

function Lowering.tagOf(self, operand: Operand): int {
    return match (operand) {
        LocalOp(local) => self.tagOnly[local]
        _ => -1
    }
}

// The locals (not parameters) written once, by a record of a variant without fields, and only
// compared (`==`, `!=`): their variants, or -1.
function tagOnlyLocals(program: IrProgram, routine: IrFunction): int[] {
    immut count = routine.locals.length()
    mut variants: int[] = []
    mut writes: int[] = []
    mut compared: boolean[] = []

    for local in range(count) {
        variants.push(-1)
        writes.push(0)
        compared.push(true)
    }

    for block in routine.blocks {
        for instruction in block.instructions {
            for local in changes(instruction) {
                writes[local] += 1
            }

            match (instruction) {
                RecordNewIns(dest, variant, _) => {
                    mut empty = true

                    for field in program.records[recordOf(routine.locals[dest].ty)].variants[variant].fields {
                        if (field.ty != VoidTy) { empty = false }
                    }

                    if (empty) { variants[dest] = variant }
                }
                _ => {}
            }

            immut comparison = match (instruction) {
                BinaryIns(_, op, _, _, _) => op == 'RecordCompare(Equal)' or op == 'RecordCompare(NotEqual)'
                _ => false
            }

            if (not comparison) {
                for local in uses(instruction) {
                    compared[local] = false
                }
            }
        }

        for local in terminatorUses(block.terminator) {
            compared[local] = false
        }
    }

    mut result: int[] = []

    for local in range(count) {
        result.push(if (local >= routine.params and writes[local] == 1 and compared[local]) { variants[local] } else { -1 })
    }

    return result
}

// The words of an operand (one or two) in a new slot of the frame: its address.
function Lowering.operandInSlot(mut self, operand: Operand): MValue {
    immut words = self.words(operand)
    immut slot = self.sizedSlot(8 * words.length())

    for i in range(words.length()) {
        self.current.push(MStore(MSlot(slot, 8 * i), words[i], 8))
    }

    return self.addressOf(MSlot(slot, 0))
}

// A value in a new slot of the frame: its address (for the library, which takes items and keys so).
function Lowering.inSlot(mut self, value: MValue): MValue {
    immut slot = self.slot()
    self.current.push(MStore(MSlot(slot, 0), value, 8))
    return self.addressOf(MSlot(slot, 0))
}

// An `Option` into `dest`: `Some` of the value at `source` when `found` is not 0, else `None`. With
// `copied` (a slot, or -1), the value there holds a reference of its own, released once in the
// record (which retains it).
function Lowering.optionFrom(mut self, dest: int, found: MValue, source: MValue, copied: int) {
    immut option = recordOf(self.routine.locals[dest].ty)
    immut variants = self.program.records[option].variants
    mut some = 0
    mut none = 1

    for i in range(variants.length()) {
        if (variants[i].fields.length() > 0) { some = i } else { none = i }
    }

    immut itemType = variants[some].fields[0].ty
    immut target = self.resultOf(dest)
    immut present = self.newBlock()
    immut absent = self.newBlock()
    immut done = self.newBlock()
    self.endPiece(MBranch('eq', found, MImm(0), absent, present))
    self.startPiece(present)

    if (itemType == VoidTy) {
        immut description = self.addressOf(MSymbol('.data', self.context.records[option]))
        self.current.push(MCall(MExternal('koji_record_new'), [description, MImm(some)], [target]))
    } else {
        // The item first (a reference of its own, unless it was moved out to `copied`), then the
        // record from the pool, as `RecordNewIns` makes it.
        immut address = self.register(source)
        immut low = self.temporary()
        immut wide = wideType(itemType)
        immut width = match (itemType) {
            BoolTy => 1
            ByteTy => 1
            CharTy => 4
            _ => 8
        }
        self.current.push(MLoad(low, MBase(address, 0), width))
        immut high = self.temporary()

        if (wide) { self.current.push(MLoad(high, MBase(address, 8), 8)) }

        if (copied < 0 and isManaged(itemType)) { self.current.push(MRetain(MReg(low))) }

        self.newOption(target, option, some, if (wide) { [MReg(low), MReg(high)] } else { [MReg(low)] })
    }

    self.endPiece(MJump(done))
    self.startPiece(absent)
    self.newOption(target, option, none, [])
    self.endPiece(MJump(done))
    self.startPiece(done)
    self.setResult(dest, target)
}

// A record of the pool with its words (its variant has fields of 1 or 2 words).
function Lowering.newOption(mut self, target: int, record: int, variant: int, words: MValue[]) {
    self.poolTake(target, 3 + words.length())
    immut description = self.addressOf(MSymbol('.data', self.context.records[record]))
    self.current.push(MStore(MBase(target, 0), MImm(1), 8))
    self.current.push(MStore(MBase(target, 8), description, 8))
    self.current.push(MStore(MBase(target, 16), MImm(variant), 8))

    for i in range(words.length()) {
        self.current.push(MStore(MBase(target, 24 + 8 * i), words[i], 8))
    }
}

// An operation on decimals (by the library) or U128 (inline, but divisions and shifts by a count).
function Lowering.wideBinary(mut self, dest: int, op: string, left: Operand, right: Operand, line: int) {
    immut first = self.words(left)
    immut second = self.words(right)

    if (op.startsWith('U128Compare(')) {
        immut condition = conditionOf(op['U128Compare('.length()..op.length() - 1])

        if (condition == 'eq' or condition == 'ne') {
            immut low = self.temporary()
            immut high = self.temporary()
            self.current.push(MBinary(low, 'xor', first[0], second[0], -1))
            self.current.push(MBinary(high, 'xor', first[1], second[1], -1))
            self.current.push(MBinary(low, 'or', MReg(low), MReg(high), -1))
            self.current.push(MSet(dest, condition, MReg(low), MImm(0)))
            return
        }

        // a > b is b < a, a <= b is b >= a.
        immut swapped = condition == 'gt' or condition == 'le'
        immut below = condition == 'lt' or condition == 'gt'
        self.current.push(MWide([dest], if (below) { 'below' } else { 'aboveEqual' }, if (swapped) { second } else { first }, if (swapped) { first } else { second }))
        return
    }

    if (op.startsWith('DecimalCompare(')) {
        immut condition = conditionOf(op['DecimalCompare('.length()..op.length() - 1])
        immut order = self.temporary()
        self.current.push(MCall(MExternal('koji_decimal_compare'), first + second, [order]))
        self.current.push(MUnary(order, 'sext32', MReg(order), -1))
        self.current.push(MSet(dest, condition, MReg(order), MImm(0)))
        return
    }

    immut dests = self.registersOf(dest)

    match (op) {
        'U128Add' => self.current.push(MWide(dests, 'add', first, second))
        'U128Sub' => self.current.push(MWide(dests, 'sub', first, second))
        'U128Mul' => self.current.push(MWide(dests, 'mul', first, second))
        other if (other == 'U128And' or other == 'U128Or' or other == 'U128Xor') => {
            immut operation = match (other) {
                'U128And' => 'and'
                'U128Or' => 'or'
                _ => 'xor'
            }
            self.current.push(MBinary(dests[0], operation, first[0], second[0], -1))
            self.current.push(MBinary(dests[1], operation, first[1], second[1], -1))
        }
        // By a count of 0 to 127 (another panics, as the library does).
        other if (other == 'U128ShiftLeft' or other == 'U128ShiftRight') => {
            immut wrong = self.panic(line, 'shift of a U128 out of range (0 to 127)')
            self.current.push(MPanicIf('ne', second[1], MImm(0), wrong))
            self.current.push(MPanicIf('a', second[0], MImm(127), wrong))
            self.current.push(MWide(dests, if (other == 'U128ShiftLeft') { 'shl' } else { 'shr' }, first, [second[0]]))
        }
        // Decimals, and the divisions of U128: the library, told where the instruction is.
        other => {
            immut helper = match (other) {
                'U128Div' => 'koji_u128_div'
                'U128Rem' => 'koji_u128_rem'
                'DecimalAdd' => 'koji_decimal_plus'
                'DecimalSub' => 'koji_decimal_sub'
                'DecimalMul' => 'koji_decimal_mul'
                'DecimalDiv' => 'koji_decimal_div'
                'DecimalRem' => 'koji_decimal_rem'
                'DecimalPow' => 'koji_decimal_pow'
                _ => 'koji_decimal_power'
            }
            immut place = self.addressOf(MText(self.location(line)))
            self.callLibrary(helper, first + second + [place], Some(dest), false)
        }
    }
}

// The value an instruction puts somewhere with a reference of its own: moved when it is read for
// the last time (`movedBy`), else retained.
function Lowering.taken(mut self, instruction: Instruction, operand: Operand): MValue {
    match (operand) {
        LocalOp(local) if (local in self.movedBy(instruction, self.block, self.position)) => return MReg(local)
        _ => {}
    }

    immut value = self.value(operand)

    if (isManaged(self.operandType(operand))) { self.current.push(MRetain(value)) }

    return value
}

// The type of the value at a target: that of its variable, then of each step.
function Lowering.targetType(self, target: Target): Ty {
    mut ty = match (target.root) {
        LocalPlace(local) => self.routine.locals[local].ty
        GlobalPlace(global) => self.program.globals[global].ty
    }

    for step in target.path {
        ty = match (step) {
            IndexStep(_) => itemOf(ty)
            FieldStep(field) => match (ty) {
                // The fields of a record of one variant (a path only goes through those).
                RecordTy(id) => self.program.records[id].variants[0].fields[field].ty
                _ => VoidTy
            }
            KeyStep(_) => match (ty) {
                MapTy(_, value) => value
                _ => VoidTy
            }
        }
    }

    return ty
}

// The local of a target that is a local itself (no path), or -1.
function directLocal(target: Target): int {
    return match (target.root) {
        LocalPlace(local) if (target.path.length() == 0) => local
        _ => -1
    }
}

// On a slow path, the address of the variable of a target (see `directLocal`): a local put in a
// slot of the frame (`variable.slot`, read back by the caller after the library), or the address
// already known.
function Lowering.slowVariable(mut self, direct: int, mut variable: Variable): MValue {
    if (direct < 0) { return MReg(variable.address) }

    variable.slot = self.slot()
    self.current.push(MStore(MSlot(variable.slot, 0), MReg(direct), 8))
    return self.addressOf(MSlot(variable.slot, 0))
}

// The value at a target, unshared (copied by `unshare` of the library when another reference sees
// it): a local itself when it is not shared (through a slot only to copy it).
function Lowering.unshared(mut self, target: Target, line: int, unshare: string): int {
    immut own = self.temporary()

    match (target.root) {
        LocalPlace(local) if (target.path.length() == 0) => {
            immut count = self.temporary()
            self.current.push(MLoad(count, MBase(local, 0), 8))
            immut alone = self.newBlock()
            immut copy = self.coldBlock()
            self.endPiece(MBranch('gt', MReg(count), MImm(1), copy, alone))
            self.startPiece(copy)
            immut slot = self.slot()
            self.current.push(MStore(MSlot(slot, 0), MReg(local), 8))
            immut address = self.addressOf(MSlot(slot, 0))
            self.current.push(MCall(MExternal(unshare), [address], []))
            self.current.push(MLoad(local, MSlot(slot, 0), 8))
            self.endPiece(MJump(alone))
            self.startPiece(alone)
            self.current.push(MMove(own, MReg(local)))
            return own
        }
        _ => {}
    }

    immut variable = self.variable(target, line)
    immut shared = self.temporary()
    self.current.push(MLoad(shared, MBase(variable.address, 0), 8))
    immut count = self.temporary()
    self.current.push(MLoad(count, MBase(shared, 0), 8))
    immut alone = self.newBlock()
    immut copy = self.coldBlock()
    self.endPiece(MBranch('gt', MReg(count), MImm(1), copy, alone))
    self.startPiece(copy)
    self.current.push(MCall(MExternal(unshare), [MReg(variable.address)], []))
    self.endPiece(MJump(alone))
    self.startPiece(alone)
    self.current.push(MLoad(own, MBase(variable.address, 0), 8))
    self.closeVariable(variable)
    return own
}

// The address of the variable of a target (a `void **`, as the library takes it): a local is put
// in a slot of the frame for the instruction (read back by `closeVariable`: the library may have
// copied the value), a global is in .bss; each step copies a shared list, record or map before
// giving the place inside it.
function Lowering.variable(mut self, target: Target, line: int): Variable {
    mut root = -1
    mut slot = -1
    mut address = self.temporary()

    match (target.root) {
        LocalPlace(local) => {
            root = local
            slot = self.slot()
            self.current.push(MStore(MSlot(slot, 0), MReg(local), 8))
            self.current.push(MAddressOf(address, MSlot(slot, 0)))
        }
        GlobalPlace(global) => self.current.push(MAddressOf(address, MSymbol('.bss', self.context.globals[global])))
    }

    for step in target.path {
        immut next = self.temporary()

        match (step) {
            IndexStep(index) => {
                immut at = self.value(index)
                immut where = self.addressOf(MText(self.location(line)))
                self.current.push(MCall(MExternal('koji_list_slot'), [MReg(address), at, where], [next]))
            }
            FieldStep(field) => self.current.push(MCall(MExternal('koji_record_slot'), [MReg(address), MImm(field)], [next]))
            KeyStep(key) => {
                immut place = self.operandInSlot(key)
                immut where = self.addressOf(MText(self.location(line)))
                self.current.push(MCall(MExternal('koji_map_slot'), [MReg(address), place, where], [next]))
            }
        }

        address = next
    }

    return { address: address, slot: slot, root: root }
}

function Lowering.closeVariable(mut self, variable: Variable) {
    if (variable.root >= 0) { self.current.push(MLoad(variable.root, MSlot(variable.slot, 0), 8)) }
}

// A value read from memory into the local `dest` (a field, an item): a boolean or a byte from its
// low byte, a char from its low 32 bits; a reference retained (the old one of `dest` released),
// but into a borrowed local.
function Lowering.loadItem(mut self, dest: int, at: MAddress) {
    immut ty = self.routine.locals[dest].ty

    // Two words.
    if (self.highs[dest] >= 0) {
        self.current.push(MLoad(dest, at, 8))
        immut after = match (at) {
            MBase(base, offset) => MBase(base, offset + 8)
            MIndexed(base, index, scale, offset) => MIndexed(base, index, scale, offset + 8)
            other => other
        }
        self.current.push(MLoad(self.highs[dest], after, 8))
        return
    }

    if (not self.owned[dest]) {
        immut width = match (ty) {
            BoolTy => 1
            ByteTy => 1
            CharTy => 4
            _ => 8
        }
        self.current.push(MLoad(dest, at, width))
        return
    }

    immut target = self.resultOf(dest)
    self.current.push(MLoad(target, at, 8))
    self.current.push(MRetain(MReg(target)))
    self.setResult(dest, target)
}

// A block of `size` words from the pool (KojiPool of the prelude) into `target`: the head of its
// list of free blocks of that size, else a refill (koji_pool_refill).
function Lowering.poolTake(mut self, target: int, size: int) {
    immut head = MSymbol('koji_pool', 8 * size)
    self.current.push(MLoad(target, head, 8))
    immut taken = self.newBlock()
    immut refill = self.coldBlock()
    immut next = self.newBlock()
    self.endPiece(MBranch('eq', MReg(target), MImm(0), refill, taken))
    self.startPiece(taken)
    immut rest = self.temporary()
    self.current.push(MLoad(rest, MBase(target, 0), 8))
    self.current.push(MStore(head, MReg(rest), 8))
    self.endPiece(MJump(next))
    self.startPiece(refill)
    self.current.push(MCall(MExternal('koji_pool_refill'), [MImm(size)], [target]))
    self.endPiece(MJump(next))
    self.startPiece(next)
}

// The number of the record of a type.
function recordOf(ty: Ty): int {
    return match (ty) {
        RecordTy(id) => id
        _ => 0
    }
}

// A value of two words (in records, lists and maps).
function wideType(ty: Ty): boolean {
    return ty == DecimalTy or ty == U128Ty
}

// A new slot of a word in the frame: its number.
// The slots live for one instruction only: the next one reuses them.
function Lowering.slot(mut self): int {
    return self.sizedSlot(8)
}

function Lowering.sizedSlot(mut self, bytes: int): int {
    if (self.slotsUsed == self.slots.length()) { self.slots.push(bytes) }

    if (self.slots[self.slotsUsed] < bytes) { self.slots[self.slotsUsed] = bytes }

    self.slotsUsed += 1
    return self.slotsUsed - 1
}

// A new block of the machine IR (after those of the IR): its number. It goes after the block of
// the IR it continues (see `ordered`).
function Lowering.newBlock(mut self): int {
    self.blocks.push({ instructions: [], terminator: MUnreachable })
    self.owners.push(self.block)
    return self.blocks.length() - 1
}

// A new block rarely run (a panic, a slow path): it goes after those of the block of the IR (not at
// the end of the function, so that the values it reads are not alive across the rest of it).
function Lowering.coldBlock(mut self): int {
    self.blocks.push({ instructions: [], terminator: MUnreachable })
    self.owners.push(-2 - self.block)
    return self.blocks.length() - 1
}

// The order of the code: each block of the IR, then those that continue it, then its cold ones (so
// that the ranges of the values alive in a loop stay short, and the jumps few).
function Lowering.layout(self): int[] {
    immut count = self.routine.blocks.length()
    mut pieces: int[][] = []

    for block in range(count) {
        pieces.push([block])
    }

    mut cold: int[][] = []

    for block in range(count) {
        cold.push([])
    }

    for id in range(count, self.blocks.length()) {
        immut owner = self.owners[id - count]

        if (owner < 0) {
            cold[-owner - 2].push(id)
        } else {
            pieces[owner].push(id)
        }
    }

    mut order: int[] = []

    for block in range(count) {
        order = order + pieces[block] + cold[block]
    }

    return order
}

// The blocks in the order of the code (`layout`), their jumps to the blocks there.
function Lowering.ordered(self, order: int[]): MBlock[] {
    mut place: int[] = []

    for id in range(self.blocks.length()) {
        place.push(0)
    }

    for i in range(order.length()) {
        place[order[i]] = i
    }

    mut blocks: MBlock[] = []

    for id in order {
        immut block = self.blocks[id]
        immut ending = match (block.terminator) {
            MJump(target) => MJump(place[target])
            MBranch(condition, left, right, thenBlock, elseBlock) => MBranch(condition, left, right, place[thenBlock], place[elseBlock])
            MSwitch(value, targets, otherwise) => {
                mut moved: int[] = []

                for target in targets {
                    moved.push(place[target])
                }

                MSwitch(value, moved, place[otherwise])
            }
            other => other
        }
        blocks.push({ instructions: block.instructions, terminator: ending })
    }

    return blocks
}

// Whether each block in the order of the code (`layout`) is cold.
function Lowering.coldOrdered(self, order: int[]): boolean[] {
    immut count = self.routine.blocks.length()
    mut cold: boolean[] = []

    for id in order {
        cold.push(id >= count and self.owners[id - count] < 0)
    }

    return cold
}

function Lowering.startPiece(mut self, block: int) {
    self.piece = block
    self.current = []
}

function Lowering.endPiece(mut self, terminator: MTerminator) {
    self.blocks[self.piece] = { instructions: self.current, terminator: terminator }
}

// The locals that may hold a reference at the start of each block (forwards over the blocks: see
// `step`), as sets of bits (64 locals a word). The parameters owned hold one from the start, and the
// locals a `TakeIns` empties.
function Lowering.heldAtBlocks(mut self): int[][] {
    immut routine = self.routine
    immut words = (routine.locals.length() + 63) / 64
    mut none: int[] = []
    mut all: int[] = []

    for word in range(words) {
        none.push(0)
        all.push(-1)
    }

    mut heldIn: int[][] = []

    for block in routine.blocks {
        heldIn.push(none)
    }

    mut entry = none

    for local in range(routine.locals.length()) {
        if (self.owned[local] and (local < routine.params or self.emptied[local])) { addBit(mut entry, local) }
    }

    heldIn[0] = entry
    // What each block does to them, once: those that hold one after it whatever held one before
    // (`given`), and those that hold one after it if they did before (`kept`); a local is held
    // after the block when it is given, or kept and held before.
    mut given: int[][] = []
    mut kept: int[][] = []
    mut following: int[][] = []

    for block in range(routine.blocks.length()) {
        mut low = none
        mut high = all
        immut instructions = routine.blocks[block].instructions

        for position in range(instructions.length()) {
            self.summarize(mut low, mut high, instructions[position], block, position)
        }

        given.push(low)
        kept.push(high)
        following.push(successors(routine.blocks[block].terminator))
    }

    mut changed = true
    mut held = none

    while (changed) {
        changed = false

        for block in range(routine.blocks.length()) {
            for word in range(words) {
                held[word] = given[block][word] | (heldIn[block][word] & kept[block][word])
            }

            for next in following[block] {
                mut grew = false

                for word in range(words) {
                    if (held[word] & ~heldIn[next][word] != 0) { grew = true }
                }

                if (grew) {
                    mut merged = heldIn[next]

                    for word in range(words) {
                        merged[word] = merged[word] | held[word]
                    }

                    heldIn[next] = merged
                    changed = true
                }
            }
        }
    }

    return heldIn
}





// `step` for the summaries of a block (see `heldAtBlocks`): what an instruction does to those that
// hold a reference after the instructions before it whatever held one (`low`), and to those that
// hold one if they did (`high`). Each local is either set, emptied or left as it was.
function Lowering.summarize(mut self, mut low: int[], mut high: int[], instruction: Instruction, block: int, position: int) {
    for moved in self.movedBy(instruction, block, position) {
        removeBit(mut low, moved)
        removeBit(mut high, moved)
    }

    match (instruction) {
        TakeIns(_, LocalPlace(source)) => {
            removeBit(mut low, source)
            removeBit(mut high, source)
        }
        DropIns(LocalPlace(source), _) => {
            removeBit(mut low, source)
            removeBit(mut high, source)
        }
        _ => {}
    }

    immut written = defs(instruction)

    if (not self.charAdded(block, position)) {
        for local in written {
            if (self.owned[local]) {
                addBit(mut low, local)
                addBit(mut high, local)
            }
        }
    }

    match (instruction) {
        CallIns(_, _, _, writebacks, _) => {
            for each in writebacks {
                match (each.target.root) {
                    LocalPlace(local) => {
                        if (self.owned[local]) {
                            addBit(mut low, local)
                            addBit(mut high, local)
                        }
                    }
                    _ => {}
                }
            }
        }
        _ => {}
    }

    for local in self.live[block][position] {
        if (not self.owned[local] or local in written or self.writeback[local]) { continue }

        removeBit(mut low, local)
        removeBit(mut high, local)
    }
}

// What an instruction does to the locals that hold references (`held`): the one it moves out
// holds none, those it writes hold one, and those it reads for the last time are released (with
// `emit`, in the code: and set to none when a `TakeIns` may read them again).
function Lowering.step(mut self, mut held: int[], instruction: Instruction, block: int, position: int, emit: boolean) {
    for moved in self.movedBy(instruction, block, position) {
        removeBit(mut held, moved)
    }

    match (instruction) {
        TakeIns(_, LocalPlace(source)) => removeBit(mut held, source)
        DropIns(LocalPlace(source), _) => removeBit(mut held, source)
        _ => {}
    }

    immut written = defs(instruction)

    // The string of a char added to the next instruction's is never made (see `charAdded`).
    if (not self.charAdded(block, position)) {
        for local in written {
            if (self.owned[local]) { addBit(mut held, local) }
        }
    }

    // The variables given the final values of `mut` arguments.
    match (instruction) {
        CallIns(_, _, _, writebacks, _) => {
            for each in writebacks {
                match (each.target.root) {
                    LocalPlace(local) => {
                        if (self.owned[local]) { addBit(mut held, local) }
                    }
                    _ => {}
                }
            }
        }
        _ => {}
    }

    for local in self.live[block][position] {
        if (not self.owned[local] or not hasBit(held, local) or local in written or self.writeback[local]) { continue }

        if (emit) {
            self.current.push(MRelease(MReg(local), kindOf(self.routine.locals[local].ty)))

            if (self.emptied[local]) { self.current.push(MMove(local, MImm(0))) }
        }

        removeBit(mut held, local)
    }
}

// The locals whose references an instruction moves out (read for the last time: a copy, a string
// added to in place, the fields of a new record that no other field reads).
function Lowering.movedBy(self, instruction: Instruction, block: int, position: int): int[] {
    immut found = match (instruction) {
        CopyIns(LocalPlace(dest), _) if (not self.owned[dest] and isManaged(self.routine.locals[dest].ty)) => -1
        CopyIns(dest, LocalOp(source)) if (dest != LocalPlace(source)) => self.movable(source, block, position)
        BinaryIns(dest, op, LocalOp(left), right, _) if ((op == 'StrConcat' or op == 'ListConcat') and right != LocalOp(left) and dest != left) => {
            if (self.writeback[left] and self.owned[left] and self.reassigned(left, dest, block, position)) { return [left] }

            self.movable(left, block, position)
        }
        CallIns(_, callee, args, writebacks, _) => {
            mut moved: int[] = []

            for writeback in writebacks {
                immut temporary = self.givenFromTarget(callee, args, writeback.param, writeback.target, block, position)

                if (temporary >= 0) { moved.push(temporary) }
            }

            return moved
        }
        FieldSetIns(record, _, LocalOp(local), _) if (not targetReads(record, local)) => self.movable(local, block, position)
        ListSetIns(list, index, LocalOp(local), _) if (not targetReads(list, local) and index != LocalOp(local)) => self.movable(local, block, position)
        RecordNewIns(dest, _, fields) => {
            mut moved: int[] = []

            for field in fields {
                match (field) {
                    LocalOp(local) if (local != dest and self.movable(local, block, position) >= 0) => {
                        mut count = 0

                        for other in fields {
                            if (other == field) { count += 1 }
                        }

                        if (count == 1) { moved.push(local) }
                    }
                    _ => {}
                }
            }

            return moved
        }
        _ => -1
    }

    return if (found >= 0) { [found] } else { [] }
}

// `f(mut self.code)`: the argument is a temporary read from a place inside a variable (a local, or
// a global the function does not see), for the last time. The place gives its reference for the
// call (it is empty meanwhile, and gets the value back after), so that the function changes the
// value in place instead of a copy; the temporary, which is not read again, gives its own back
// (see `CallIns`). Not when another argument reads the variable, the temporary or an index or a
// key of the path. The temporary, or -1.
function Lowering.givenFromTarget(self, callee: int, args: Operand[], param: int, target: Target, block: int, position: int): int {
    immut temporary = match (args[param]) {
        LocalOp(local) => local
        _ => return -1
    }
    immut root = match (target.root) {
        LocalPlace(local) => LocalOp(local)
        GlobalPlace(global) => if (self.context.seen[callee].has(global)) { return -1 } else { GlobalOp(global) }
    }

    if (target.path.length() == 0 or root == LocalOp(temporary) or not isManaged(self.routine.locals[temporary].ty)) { return -1 }

    if (not (temporary in self.live[block][position])) { return -1 }

    for i in range(args.length()) {
        if (i != param and (args[i] == root or args[i] == LocalOp(temporary))) { return -1 }

        match (args[i]) {
            LocalOp(other) if (i != param and targetReads(target, other)) => return -1
            _ => {}
        }
    }

    return temporary
}

// `text = text + string(c)`, `text` read for the last time: the instruction at `position` makes
// the string of the char, which only the next one reads, adding it to `text` (which it may change
// in place). Then the string is never made: the next one adds the char itself.
function Lowering.charAdded(self, block: int, position: int): boolean {
    immut instructions = self.routine.blocks[block].instructions

    if (position + 1 >= instructions.length()) { return false }

    immut local = match (instructions[position]) {
        UnaryIns(dest, 'CharToStr', _, _) => dest
        _ => return false
    }

    return match (instructions[position + 1]) {
        BinaryIns(dest, 'StrConcat', left, LocalOp(right), _) if (right == local and left != LocalOp(local)) => local in self.live[block][position + 1] and self.movedBy(instructions[position + 1], block, position + 1).length() > 0
        _ => false
    }
}

// The local, when its reference can move: owned, and read for the last time here; or -1.
// `x = x + more` on a `mut` parameter (`l = x + more`, then `x = l`): the parameter is given the
// new value at once, so its reference can go into the addition (it is written back at the end,
// which no other instruction may see emptied).
function Lowering.reassigned(self, local: int, dest: int, block: int, position: int): boolean {
    immut instructions = self.routine.blocks[block].instructions

    if (position + 1 >= instructions.length()) { return false }

    return match (instructions[position + 1]) {
        CopyIns(LocalPlace(target), LocalOp(value)) => target == local and value == dest
        _ => false
    }
}

function Lowering.movable(self, local: int, block: int, position: int): int {
    return if (self.owned[local] and not self.writeback[local] and local in self.live[block][position]) { local } else { -1 }
}

function makesCalls(routine: IrFunction): boolean {
    for block in routine.blocks {
        for instruction in block.instructions {
            match (instruction) {
                CallIns(_, _, _, _, _) => return true
                _ => {}
            }
        }
    }

    return false
}

function Lowering.temporary(mut self): int {
    self.floats.push(false)
    return self.floats.length() - 1
}

function Lowering.floatTemporary(mut self): int {
    self.floats.push(true)
    return self.floats.length() - 1
}

// The text of the place of an instruction (`main.kj:12`).
function Lowering.location(self, line: int): string {
    return if (line == 0) { self.routine.file } else { `${self.routine.file}:${line}` }
}

// A panic of the function: its place (the line of the instruction) and its message.
function Lowering.panic(mut self, line: int, message: string): int {
    immut location = self.location(line)
    immut key = `${location}|${message}`

    match (self.panicIndex.get(key)) {
        Some(index) => return index
        None => {}
    }

    self.panics.push({ location: location, message: message })
    self.panicIndex[key] = self.panics.length() - 1
    return self.panics.length() - 1
}

function Lowering.value(mut self, operand: Operand): MValue {
    return match (operand) {
        LocalOp(id) => MReg(id)
        IntOp(number) => MImm(number)
        BoolOp(flag) => MImm(if (flag) { 1 } else { 0 })
        CharOp(c) => MImm(c.code())
        // Its bits, in a register of floats (so that a call passes it as a float).
        FloatOp(number) => {
            immut constant = self.floatTemporary()
            self.current.push(MMove(constant, MImm(floatWord(number))))
            MReg(constant)
        }
        GlobalOp(id) => {
            immut loaded = if (self.program.globals[id].ty == FloatTy) { self.floatTemporary() } else { self.temporary() }
            self.current.push(MLoad(loaded, MSymbol('.bss', self.context.globals[id]), 8))
            MReg(loaded)
        }
        // A literal in .data (its count of references never reaches 0).
        StrOp(id) => self.addressOf(MSymbol('.data', self.context.strings[id]))
        LocationOp(where) => self.addressOf(MText(where))
        _ => MImm(0)
    }
}

// The words of an operand: one, or two for a decimal or a U128 (low, high).
function Lowering.words(mut self, operand: Operand): MValue[] {
    match (operand) {
        LocalOp(local) if (self.highs[local] >= 0) => return [MReg(local), MReg(self.highs[local])]
        GlobalOp(id) if (wideType(self.program.globals[id].ty)) => {
            immut low = self.temporary()
            immut high = self.temporary()
            self.current.push(MLoad(low, MSymbol('.bss', self.context.globals[id]), 8))
            self.current.push(MLoad(high, MSymbol('.bss', self.context.globals[id] + 8), 8))
            return [MReg(low), MReg(high)]
        }
        DecimalOp(negative, high, low, exponent) => {
            immut bits = decimalBits(negative, high, low, exponent)
            mut words = [0, 0]

            for i in range(16) {
                words[i / 8] = words[i / 8] | (int(bits[i]) << (8 * (i % 8)))
            }

            return [MImm(words[0]), MImm(words[1])]
        }
        _ => return [self.value(operand)]
    }
}

// The virtual registers a local is written to: one, or two (low, high).
function Lowering.registersOf(self, local: int): int[] {
    return if (self.highs[local] >= 0) { [local, self.highs[local]] } else { [local] }
}

function Lowering.setWords(mut self, local: int, words: MValue[]) {
    self.current.push(MMove(local, words[0]))

    if (words.length() > 1) { self.current.push(MMove(self.highs[local], words[1])) }
}

function Lowering.addressOf(mut self, at: MAddress): MValue {
    immut address = self.temporary()
    self.current.push(MAddressOf(address, at))
    return MReg(address)
}

// A value in a virtual register (a constant moved into one).
function Lowering.register(mut self, value: MValue): int {
    return match (value) {
        MReg(id) => id
        MImm(number) => {
            immut id = self.temporary()
            self.current.push(MMove(id, value))
            id
        }
    }
}

// Where an instruction writes the value of the local `dest`: itself, or a temporary when the
// local holds a reference until the new value is in (`setResult`).
function Lowering.resultOf(mut self, dest: int): int {
    if (self.owned[dest] and hasBit(self.held, dest)) { return self.temporary() }

    return dest
}

// The local `dest` given the value written in `target` (see `resultOf`): its old reference released.
function Lowering.setResult(mut self, dest: int, target: int) {
    if (target == dest) { return }

    self.current.push(MRelease(MReg(dest), kindOf(self.routine.locals[dest].ty)))
    self.current.push(MMove(dest, MReg(target)))
}

// A call of a function of the library whose result (if any) goes to `dest`, normalized as the type
// of the local says: a boolean or a byte in the low byte, a char in the low 32 bits; an `int` of C,
// sign-extended.
function Lowering.callLibrary(mut self, name: string, args: MValue[], dest: Option[int], cInt: boolean) {
    match (dest) {
        Some(local) if (self.highs[local] >= 0) => self.current.push(MCall(MExternal(name), args, self.registersOf(local)))
        Some(local) => {
            immut target = self.resultOf(local)
            self.current.push(MCall(MExternal(name), args, [target]))

            if (cInt) { self.current.push(MUnary(target, 'sext32', MReg(target), -1)) }

            match (self.routine.locals[local].ty) {
                BoolTy => self.current.push(MBinary(target, 'and', MReg(target), MImm(0xFF), -1))
                ByteTy => self.current.push(MBinary(target, 'and', MReg(target), MImm(0xFF), -1))
                CharTy => self.current.push(MBinary(target, 'and', MReg(target), MImm(0xFFFFFFFF), -1))
                _ => {}
            }

            self.setResult(local, target)
        }
        None => self.current.push(MCall(MExternal(name), args, []))
    }
}

// The value of an operand with a reference of its own: moved when read for the last time (see
// `movedBy`), else retained.
function Lowering.shared(mut self, operand: Operand): MValue {
    match (operand) {
        LocalOp(local) if (self.movable(local, self.block, self.position) >= 0) => return MReg(local)
        _ => {}
    }

    immut value = self.value(operand)
    self.current.push(MRetain(value))
    return value
}

function Lowering.operandType(self, operand: Operand): Ty {
    return match (operand) {
        LocalOp(id) => self.routine.locals[id].ty
        GlobalOp(id) => self.program.globals[id].ty
        StrOp(_) => StrTy
        FloatOp(_) => FloatTy
        DecimalOp(_, _, _, _) => DecimalTy
        _ => IntTy
    }
}

function Lowering.instruction(mut self, instruction: Instruction) {
    match (instruction) {
        CopyIns(LocalPlace(dest), value) if (self.highs[dest] >= 0) => self.setWords(dest, self.words(value))
        CopyIns(GlobalPlace(id), value) if (wideType(self.program.globals[id].ty)) => {
            immut words = self.words(value)
            self.current.push(MStore(MSymbol('.bss', self.context.globals[id]), words[0], 8))
            self.current.push(MStore(MSymbol('.bss', self.context.globals[id] + 8), words[1], 8))
        }
        CopyIns(LocalPlace(dest), value) => {
            immut ty = self.routine.locals[dest].ty

            // A borrowed local, or a value of no references: the value itself.
            if (not self.owned[dest]) {
                immut source = self.value(value)
                self.current.push(MMove(dest, source))
                return
            }

            if (value == LocalOp(dest)) { return }

            immut source = self.shared(value)

            if (hasBit(self.held, dest)) { self.current.push(MRelease(MReg(dest), kindOf(ty))) }

            self.current.push(MMove(dest, source))
        }
        CopyIns(GlobalPlace(id), value) => {
            immut at = MSymbol('.bss', self.context.globals[id])
            immut ty = self.program.globals[id].ty

            if (not isManaged(ty)) {
                immut source = self.value(value)
                self.current.push(MStore(at, source, 8))
                return
            }

            // The new value in, then the old one released.
            immut source = self.shared(value)
            immut old = self.temporary()
            self.current.push(MLoad(old, at, 8))
            self.current.push(MStore(at, source, 8))
            self.current.push(MRelease(MReg(old), kindOf(ty)))
        }
        TakeIns(dest, source) => {
            immut target = self.resultOf(dest)

            match (source) {
                LocalPlace(local) => {
                    self.current.push(MMove(target, MReg(local)))
                    self.current.push(MMove(local, MImm(0)))
                }
                GlobalPlace(id) => {
                    immut at = MSymbol('.bss', self.context.globals[id])
                    self.current.push(MLoad(target, at, 8))
                    self.current.push(MStore(at, MImm(0), 8))
                }
            }

            self.setResult(dest, target)
        }
        PrintIns(value, line) => {
            immut text = self.value(value)
            immut place = self.addressOf(MText(self.location(line)))
            self.current.push(MCall(MExternal('koji_print'), [text, place], []))
        }
        FailIns(value, line) => {
            immut message = self.value(value)
            immut place = self.addressOf(MText(self.location(line)))
            self.current.push(MCall(MExternal('koji_fail'), [place, message], []))
        }
        StdCallIns(dest, name, args) => self.libraryCall(dest, name, args)
        // A closure: its code, its environment (retained) and its name, for its text.
        MakeClosureIns(dest, code, environment) => {
            immut captured = match (environment) {
                Some(value) => {
                    immut record = self.value(value)
                    self.current.push(MRetain(record))
                    record
                }
                None => MImm(0)
            }
            immut address = self.addressOf(MCode(code))
            immut name = self.addressOf(MText(self.program.functions[code].name))
            self.callLibrary('koji_closure_new', [address, captured, name], Some(dest), false)
        }
        // The code of the closure (its word 1) called with its environment (its word 2) first.
        CallClosureIns(dest, closure, args, _) => {
            immut base = self.register(self.value(closure))
            immut code = self.temporary()
            immut environment = self.temporary()
            self.current.push(MLoad(code, MBase(base, 8), 8))
            self.current.push(MLoad(environment, MBase(base, 16), 8))
            mut values = [MReg(environment)]
            mut pairs: int[] = []
            mut aligned: int[] = []

            for arg in args {
                if (self.operandType(arg) == U128Ty) { aligned.push(values.length()) }

                if (wideType(self.operandType(arg))) { pairs.push(values.length()) }

                values = values + self.words(arg)
            }

            if (pairs.length() > 0) { self.current.push(MPairs(pairs, aligned)) }

            match (dest) {
                Some(local) if (self.highs[local] >= 0) => self.current.push(MCall(MIndirect(MReg(code)), values, self.registersOf(local)))
                Some(local) => {
                    immut target = self.resultOf(local)
                    self.current.push(MCall(MIndirect(MReg(code)), values, [target]))
                    self.setResult(local, target)
                }
                None => self.current.push(MCall(MIndirect(MReg(code)), values, []))
            }
        }
        ListSortByIns(list, comparison, line) => {
            immut kind = match (self.operandType(comparison)) {
                FunctionTy(params, _) => match (params[0]) {
                    IntTy => 'int'
                    FloatTy => 'float'
                    DecimalTy => 'decimal'
                    BoolTy => 'bool'
                    CharTy => 'char'
                    ByteTy => 'byte'
                    U128Ty => 'u128'
                    StrTy => 'string'
                    ListTy(_) => 'list'
                    RecordTy(_) => 'record'
                    _ => 'map'
                }
                _ => 'int'
            }
            immut compare = self.value(comparison)
            immut before = self.addressOf(MSymbol(`koji_before_${kind}`, 0))
            immut variable = self.variable(list, line)
            self.current.push(MCall(MExternal('koji_list_sort_by'), [MReg(variable.address), compare, before], []))
            self.closeVariable(variable)
        }
        // The value given to its function, then released (and none left), when there is one.
        DropIns(place, dropper) => {
            immut ty = match (place) {
                LocalPlace(local) => self.routine.locals[local].ty
                GlobalPlace(global) => self.program.globals[global].ty
            }
            immut value = match (place) {
                LocalPlace(local) => local
                GlobalPlace(global) => {
                    immut loaded = self.temporary()
                    self.current.push(MLoad(loaded, MSymbol('.bss', self.context.globals[global]), 8))
                    loaded
                }
            }
            immut drop = self.newBlock()
            immut done = self.newBlock()
            self.endPiece(MBranch('eq', MReg(value), MImm(0), done, drop))
            self.startPiece(drop)
            self.current.push(MCall(MFunction(dropper), [MReg(value)], []))

            if (isManaged(ty)) { self.current.push(MRelease(MReg(value), kindOf(ty))) }

            match (place) {
                LocalPlace(local) => self.current.push(MMove(local, MImm(0)))
                GlobalPlace(global) => self.current.push(MStore(MSymbol('.bss', self.context.globals[global]), MImm(0), 8))
            }

            self.endPiece(MJump(done))
            self.startPiece(done)
        }
        UnaryIns(dest, op, value, line) if (op in wideUnaries) => {
            immut words = self.words(value)

            match (op) {
                'U128Not' => {
                    self.current.push(MUnary(dest, 'not', words[0], -1))
                    self.current.push(MUnary(self.highs[dest], 'not', words[1], -1))
                }
                // Sign-extended, as C converts an int64_t.
                'IntToU128' => {
                    self.current.push(MMove(dest, words[0]))
                    self.current.push(MBinary(self.highs[dest], 'sar', words[0], MImm(63), -1))
                }
                'DecimalToFloat' => self.callLibrary('koji_decimal_to_float', words + [self.addressOf(MText(self.location(line)))], Some(dest), false)
                'DecimalToInt' => self.callLibrary('koji_decimal_to_int', words + [MImm(3), self.addressOf(MText(self.location(line)))], Some(dest), false)
                other => {
                    immut helper = match (other) {
                        'U128ToStr' => 'koji_u128_to_string'
                        'DecimalNeg' => 'koji_decimal_neg'
                        'IntToDecimal' => 'koji_decimal_from_int'
                        'FloatToDecimal' => 'koji_decimal_from_float'
                        _ => 'koji_string_from_decimal'
                    }
                    self.callLibrary(helper, words, Some(dest), false)
                }
            }
        }
        BinaryIns(dest, op, left, right, line) if (op.startsWith('U128') or op.startsWith('Decimal')) => self.wideBinary(dest, op, left, right, line)
        FieldGetIns(dest, record, field) => {
            immut base = self.register(self.value(record))
            immut variants = self.program.records[recordOf(self.operandType(record))].variants
            mut wide = false

            for variant in variants {
                for each in variant.fields {
                    if (wideType(each.ty)) { wide = true }
                }
            }

            mut at = MBase(base, 24 + 8 * field)

            if (wide and variants.length() > 1) {
                // Its place in the variant of the record (the library knows it).
                immut slot = self.temporary()
                self.current.push(MCall(MExternal('koji_record_get'), [MReg(base), MImm(field)], [slot]))
                at = MBase(slot, 0)
            } else {
                if (wide) {
                    mut word = 0

                    for index in range(field) {
                        word += if (wideType(variants[0].fields[index].ty)) { 2 } else { 1 }
                    }

                    at = MBase(base, 24 + 8 * word)
                }
            }

            self.loadItem(dest, at)
        }
        RecordNewIns(dest, variant, fields) => {
            immut record = recordOf(self.routine.locals[dest].ty)
            immut types = self.program.records[record].variants[variant].fields
            mut total = 0

            for each in types {
                total += if (wideType(each.ty)) { 2 } else { 1 }
            }

            // The values first (those moved, or retained), then the record, then the fields.
            immut moved = self.movedBy(instruction, self.block, self.position)
            mut values: MValue[] = []
            mut highs: MValue[] = []

            for index in range(fields.length()) {
                if (index >= types.length() or types[index].ty == VoidTy) {
                    values.push(MImm(0))
                    highs.push(MImm(0))
                    continue
                }

                if (wideType(types[index].ty)) {
                    immut words = self.words(fields[index])
                    values.push(words[0])
                    highs.push(words[1])
                    continue
                }

                highs.push(MImm(0))

                match (fields[index]) {
                    LocalOp(local) if (local in moved) => values.push(MReg(local))
                    other => {
                        immut value = self.value(other)

                        if (isManaged(types[index].ty)) { self.current.push(MRetain(value)) }

                        values.push(value)
                    }
                }
            }

            immut target = self.resultOf(dest)
            immut size = 3 + total

            if (size > 16) {
                immut description = self.addressOf(MSymbol('.data', self.context.records[record]))
                self.current.push(MCall(MExternal('koji_record_make'), [description, MImm(variant), MImm(total)], [target]))
            } else {
                self.poolTake(target, size)
                immut description = self.addressOf(MSymbol('.data', self.context.records[record]))
                self.current.push(MStore(MBase(target, 0), MImm(1), 8))
                self.current.push(MStore(MBase(target, 8), description, 8))
                self.current.push(MStore(MBase(target, 16), MImm(variant), 8))
            }

            mut word = 0
            mut written: boolean[] = []

            for index in range(total) {
                written.push(false)
            }

            for index in range(types.length()) {
                if (index < fields.length() and types[index].ty != VoidTy) {
                    self.current.push(MStore(MBase(target, 24 + 8 * word), values[index], 8))
                    written[word] = true

                    if (wideType(types[index].ty)) {
                        self.current.push(MStore(MBase(target, 32 + 8 * word), highs[index], 8))
                        written[word + 1] = true
                    }
                }

                word += if (wideType(types[index].ty)) { 2 } else { 1 }
            }

            if (size <= 16) {
                for index in range(total) {
                    if (not written[index]) { self.current.push(MStore(MBase(target, 24 + 8 * index), MImm(0), 8)) }
                }
            }

            self.setResult(dest, target)
        }
        // The value taken first (moved, or retained: `r.next = r` keeps the old record), then the
        // record unshared, then the field set, its old value released.
        // Of two words: both stored (the record unshared first).
        FieldSetIns(record, field, value, line) if (wideType(self.operandType(value))) => {
            immut words = self.words(value)
            immut own = self.unshared(record, line, 'koji_record_unshare')
            immut slot = self.temporary()
            self.current.push(MCall(MExternal('koji_record_get'), [MReg(own), MImm(field)], [slot]))
            self.current.push(MStore(MBase(slot, 0), words[0], 8))
            self.current.push(MStore(MBase(slot, 8), words[1], 8))
        }
        FieldSetIns(record, field, value, line) => {
            immut fresh = self.taken(instruction, value)
            immut own = self.unshared(record, line, 'koji_record_unshare')
            immut ty = self.operandType(value)
            immut variants = self.program.records[recordOf(self.targetType(record))].variants
            mut wide = false

            for variant in variants {
                for each in variant.fields {
                    if (wideType(each.ty)) { wide = true }
                }
            }

            mut at = MBase(own, 24 + 8 * field)

            if (wide) {
                immut slot = self.temporary()
                self.current.push(MCall(MExternal('koji_record_get'), [MReg(own), MImm(field)], [slot]))
                at = MBase(slot, 0)
            }

            if (isManaged(ty)) {
                immut old = self.temporary()
                self.current.push(MLoad(old, at, 8))
                self.current.push(MStore(at, fresh, 8))
                self.current.push(MRelease(MReg(old), kindOf(ty)))
            } else {
                self.current.push(MStore(at, fresh, 8))
            }
        }
        // In place when the list is not shared and has room (the runtime grows it otherwise).
        // Of two words: the library copies them from a slot.
        ListPushIns(list, value, line) if (wideType(self.operandType(value))) => {
            immut words = self.words(value)
            immut held = self.sizedSlot(16)
            self.current.push(MStore(MSlot(held, 0), words[0], 8))
            self.current.push(MStore(MSlot(held, 8), words[1], 8))
            immut place = self.addressOf(MSlot(held, 0))
            immut variable = self.variable(list, line)
            self.current.push(MCall(MExternal('koji_list_push'), [MReg(variable.address), place], []))
            self.closeVariable(variable)
        }
        ListPushIns(list, value, line) => {
            immut ty = self.operandType(value)
            immut fresh = self.value(value)

            if (isManaged(ty)) { self.current.push(MRetain(fresh)) }

            immut direct = directLocal(list)
            mut variable: Variable = { address: -1, slot: -1, root: -1 }
            mut items = direct

            if (direct < 0) {
                variable = self.variable(list, line)
                items = self.temporary()
                self.current.push(MLoad(items, MBase(variable.address, 0), 8))
            }

            immut count = self.temporary()
            self.current.push(MLoad(count, MBase(items, 0), 8))
            immut check = self.newBlock()
            immut fast = self.newBlock()
            immut slow = self.coldBlock()
            immut done = self.newBlock()
            self.endPiece(MBranch('ne', MReg(count), MImm(1), slow, check))
            self.startPiece(check)
            immut length = self.temporary()
            immut room = self.temporary()
            self.current.push(MLoad(length, MBase(items, 32), 8))
            self.current.push(MLoad(room, MBase(items, 40), 8))
            self.endPiece(MBranch('ge', MReg(length), MReg(room), slow, fast))
            self.startPiece(fast)
            immut slots = self.temporary()
            self.current.push(MLoad(slots, MBase(items, 24), 8))
            self.current.push(MStore(MIndexed(slots, length, 8, 0), fresh, 8))
            immut grown = self.temporary()
            self.current.push(MBinary(grown, 'add', MReg(length), MImm(1), -1))
            self.current.push(MStore(MBase(items, 32), MReg(grown), 8))
            self.endPiece(MJump(done))
            // The library retains the value it adds.
            self.startPiece(slow)
            immut held = self.slot()
            self.current.push(MStore(MSlot(held, 0), fresh, 8))
            immut place = self.addressOf(MSlot(held, 0))
            immut address = self.slowVariable(direct, mut variable)
            self.current.push(MCall(MExternal('koji_list_push'), [address, place], []))

            if (direct >= 0) { self.current.push(MLoad(direct, MSlot(variable.slot, 0), 8)) }

            if (isManaged(ty)) { self.current.push(MRelease(fresh, kindOf(ty))) }

            self.endPiece(MJump(done))
            self.startPiece(done)

            if (direct < 0) { self.closeVariable(variable) }
        }
        // In place when the list is not shared and the index is in it (the runtime copies the
        // list, or panics, otherwise).
        // Of two words: the library copies them from a slot.
        ListSetIns(list, index, value, line) if (wideType(self.operandType(value))) => {
            immut place = self.operandInSlot(value)
            immut at = self.value(index)
            immut variable = self.variable(list, line)
            immut where = self.addressOf(MText(self.location(line)))
            self.current.push(MCall(MExternal('koji_list_set'), [MReg(variable.address), at, place, where], []))
            self.closeVariable(variable)
        }
        ListSetIns(list, index, value, line) => {
            immut ty = self.operandType(value)
            immut fresh = self.taken(instruction, value)
            immut at = self.register(self.value(index))
            immut direct = directLocal(list)
            mut variable: Variable = { address: -1, slot: -1, root: -1 }
            mut items = direct

            if (direct < 0) {
                variable = self.variable(list, line)
                items = self.temporary()
                self.current.push(MLoad(items, MBase(variable.address, 0), 8))
            }

            immut count = self.temporary()
            self.current.push(MLoad(count, MBase(items, 0), 8))
            immut check = self.newBlock()
            immut fast = self.newBlock()
            immut slow = self.coldBlock()
            immut done = self.newBlock()
            self.endPiece(MBranch('ne', MReg(count), MImm(1), slow, check))
            self.startPiece(check)
            immut length = self.temporary()
            self.current.push(MLoad(length, MBase(items, 32), 8))
            self.endPiece(MBranch('ae', MReg(at), MReg(length), slow, fast))
            self.startPiece(fast)
            immut slots = self.temporary()
            self.current.push(MLoad(slots, MBase(items, 24), 8))

            if (isManaged(ty)) {
                immut old = self.temporary()
                self.current.push(MLoad(old, MIndexed(slots, at, 8, 0), 8))
                self.current.push(MStore(MIndexed(slots, at, 8, 0), fresh, 8))
                self.current.push(MRelease(MReg(old), kindOf(ty)))
            } else {
                self.current.push(MStore(MIndexed(slots, at, 8, 0), fresh, 8))
            }

            self.endPiece(MJump(done))
            // The library retains the value it sets.
            self.startPiece(slow)
            immut held = self.slot()
            self.current.push(MStore(MSlot(held, 0), fresh, 8))
            immut place = self.addressOf(MSlot(held, 0))
            immut where = self.addressOf(MText(self.location(line)))
            immut address = self.slowVariable(direct, mut variable)
            self.current.push(MCall(MExternal('koji_list_set'), [address, MReg(at), place, where], []))

            if (direct >= 0) { self.current.push(MLoad(direct, MSlot(variable.slot, 0), 8)) }

            if (isManaged(ty)) { self.current.push(MRelease(fresh, kindOf(ty))) }

            self.endPiece(MJump(done))
            self.startPiece(done)

            if (direct < 0) { self.closeVariable(variable) }
        }
        // The library retains the value it inserts.
        ListInsertIns(list, index, value, line) => {
            immut item = self.operandInSlot(value)
            immut at = self.value(index)
            immut variable = self.variable(list, line)
            immut where = self.addressOf(MText(self.location(line)))
            self.current.push(MCall(MExternal('koji_list_insert'), [MReg(variable.address), at, item, where], []))
            self.closeVariable(variable)
        }
        ListSortIns(list, line) => {
            immut variable = self.variable(list, line)
            self.current.push(MCall(MExternal('koji_list_sort'), [MReg(variable.address)], []))
            self.closeVariable(variable)
        }
        // The item removed (the list gives its reference) in an `Option`, or `None`.
        ListRemoveIns(dest, list, index, line) => {
            immut at = match (index) {
                Some(position) => self.value(position)
                None => MImm(0)
            }
            immut item = self.sizedSlot(16)
            immut place = self.addressOf(MSlot(item, 0))
            immut variable = self.variable(list, line)
            immut found = self.temporary()

            match (index) {
                Some(_) => self.current.push(MCall(MExternal('koji_list_remove'), [MReg(variable.address), at, place], [found]))
                None => self.current.push(MCall(MExternal('koji_list_pop'), [MReg(variable.address), place], [found]))
            }

            self.closeVariable(variable)
            self.current.push(MBinary(found, 'and', MReg(found), MImm(0xFF), -1))
            self.optionFrom(dest, MReg(found), place, item)
        }
        ListSliceIns(dest, list, start, end, line) => {
            mut args = [self.value(list)]

            for bound in [start, end] {
                match (bound) {
                    Some(value) => {
                        args.push(MImm(1))
                        args.push(self.value(value))
                    }
                    None => {
                        args.push(MImm(0))
                        args.push(MImm(0))
                    }
                }
            }

            args.push(self.addressOf(MText(self.location(line))))
            self.callLibrary('koji_list_slice', args, Some(dest), false)
        }
        // A new map, its entries set in it (the library retains them).
        MapNewIns(dest, entries) => {
            mut keyType = VoidTy
            mut valueType = VoidTy

            match (self.routine.locals[dest].ty) {
                MapTy(key, value) => {
                    keyType = key
                    valueType = value
                }
                SetTy(item) => keyType = item
                _ => {}
            }

            immut keys = self.addressOf(MSymbol(elementSymbol(keyType), 0))
            immut values = self.addressOf(MSymbol(elementSymbol(valueType), 0))
            immut target = self.resultOf(dest)
            self.current.push(MCall(MExternal('koji_map_new'), [keys, values], [target]))

            if (entries.length() > 0) {
                immut held = self.slot()
                self.current.push(MStore(MSlot(held, 0), MReg(target), 8))
                immut variable = self.addressOf(MSlot(held, 0))

                for entry in entries {
                    immut key = self.operandInSlot(entry.key)
                    immut value = self.operandInSlot(entry.value)
                    self.current.push(MCall(MExternal('koji_map_set'), [variable, key, value], []))
                }

                self.current.push(MLoad(target, MSlot(held, 0), 8))
            }

            self.setResult(dest, target)
        }
        MapGetIns(dest, map, key, line) => {
            immut found = self.value(map)
            immut place = self.operandInSlot(key)
            immut where = self.addressOf(MText(self.location(line)))
            immut slot = self.temporary()
            self.current.push(MCall(MExternal('koji_map_get'), [found, place, where], [slot]))
            self.loadItem(dest, MBase(slot, 0))
        }
        // The value of the key (its address, or 0) in an `Option`.
        MapLookupIns(dest, map, key) => {
            immut found = self.value(map)
            immut place = self.operandInSlot(key)
            immut slot = self.temporary()
            self.current.push(MCall(MExternal('koji_map_find'), [found, place], [slot]))
            self.optionFrom(dest, MReg(slot), MReg(slot), -1)
        }
        MapSetIns(map, key, value, line) => {
            immut place = self.operandInSlot(key)
            immut stored = match (value) {
                Some(given) => self.operandInSlot(given)
                None => MImm(0)
            }
            immut variable = self.variable(map, line)
            self.current.push(MCall(MExternal('koji_map_set'), [MReg(variable.address), place, stored], []))
            self.closeVariable(variable)
        }
        // The value removed in an `Option` (or whether there was one).
        MapRemoveIns(dest, map, key, line) => {
            immut place = self.operandInSlot(key)
            immut variable = self.variable(map, line)
            immut found = self.temporary()

            match (self.routine.locals[dest].ty) {
                RecordTy(_) => {
                    immut removed = self.sizedSlot(16)
                    immut address = self.addressOf(MSlot(removed, 0))
                    self.current.push(MCall(MExternal('koji_map_remove'), [MReg(variable.address), place, address], [found]))
                    self.closeVariable(variable)
                    self.current.push(MBinary(found, 'and', MReg(found), MImm(0xFF), -1))
                    self.optionFrom(dest, MReg(found), address, removed)
                }
                _ => {
                    self.current.push(MCall(MExternal('koji_map_remove'), [MReg(variable.address), place, MImm(0)], [found]))
                    self.closeVariable(variable)
                    immut target = self.resultOf(dest)
                    self.current.push(MBinary(target, 'and', MReg(found), MImm(0xFF), -1))
                    self.setResult(dest, target)
                }
            }
        }
        // A list with room for its items, which go in place (retained).
        ListNewIns(dest, items) => {
            immut item = itemOf(self.routine.locals[dest].ty)
            mut values: MValue[] = []

            // Items of two words take two (one after the other).
            for each in items {
                if (wideType(item)) {
                    values = values + self.words(each)
                    continue
                }

                immut value = self.value(each)

                if (isManaged(item)) { self.current.push(MRetain(value)) }

                values.push(value)
            }

            immut target = self.resultOf(dest)
            immut element = self.addressOf(MSymbol(elementSymbol(item), 0))
            self.current.push(MCall(MExternal('koji_list_new'), [element, MImm(items.length())], [target]))

            if (items.length() > 0) {
                immut slots = self.temporary()
                self.current.push(MLoad(slots, MBase(target, 24), 8))

                for index in range(values.length()) {
                    self.current.push(MStore(MBase(slots, 8 * index), values[index], 8))
                }

                self.current.push(MStore(MBase(target, 32), MImm(items.length()), 8))
            }

            self.setResult(dest, target)
        }
        // An item of a list: the index checked against its length (unsigned, so that a negative
        // one fails too), a panic that tells both.
        ListGetIns(dest, list, index, line) => {
            immut base = self.register(self.value(list))
            immut at = self.register(self.value(index))
            immut length = self.temporary()
            self.current.push(MLoad(length, MBase(base, 32), 8))
            immut next = self.newBlock()
            immut wrong = self.coldBlock()
            self.endPiece(MBranch('ae', MReg(at), MReg(length), wrong, next))
            self.startPiece(wrong)
            immut place = self.addressOf(MText(self.location(line)))
            self.current.push(MCall(MExternal('koji_list_index_panic'), [MReg(at), MReg(length), place], []))
            self.endPiece(MUnreachable)
            self.startPiece(next)
            immut slots = self.temporary()
            self.current.push(MLoad(slots, MBase(base, 24), 8))

            // An item of two words: at twice the index.
            if (self.highs[dest] >= 0) {
                immut twice = self.temporary()
                self.current.push(MBinary(twice, 'shl', MReg(at), MImm(1), -1))
                self.loadItem(dest, MIndexed(slots, twice, 8, 0))
                return
            }

            self.loadItem(dest, MIndexed(slots, at, 8, 0))
        }
        // Added by the next instruction (see `charAdded`).
        UnaryIns(_, 'CharToStr', value, _) if (self.charAdded(self.block, self.position)) => self.charValue = self.value(value)
        UnaryIns(dest, op, value, _) if (unaryHelpers.has(op) or op == 'ListLength' or op == 'RecordTag') => {
            immut source = self.value(value)

            // A word of the value.
            if (op == 'ListLength' or op == 'RecordTag') {
                immut base = self.register(source)
                self.current.push(MLoad(dest, MBase(base, if (op == 'ListLength') { 32 } else { 16 }), 8))
                return
            }

            immut helper = match (self.operandType(value)) {
                FunctionTy(_, _) => 'koji_closure_repr'
                _ => unaryHelpers[op]
            }
            self.callLibrary(helper, [source], Some(dest), false)
        }
        // Against a record of a variant without fields, never made: the variant of the other.
        BinaryIns(dest, op, left, right, _) if (op.startsWith('RecordCompare(') and (self.tagOf(left) >= 0 or self.tagOf(right) >= 0)) => {
            immut known = if (self.tagOf(left) >= 0) { self.tagOf(left) } else { self.tagOf(right) }
            immut other = if (self.tagOf(left) >= 0) { right } else { left }
            immut condition = objectComparison(op)

            if (self.tagOf(other) >= 0) {
                immut same = self.tagOf(other) == known
                self.current.push(MMove(dest, MImm(if (same == (condition == 'eq')) { 1 } else { 0 })))
                return
            }

            immut base = self.register(self.value(other))
            immut variant = self.temporary()
            self.current.push(MLoad(variant, MBase(base, 16), 8))
            self.current.push(MSet(dest, condition, MReg(variant), MImm(known)))
        }
        RecordNewIns(dest, _, _) if (self.tagOnly[dest] >= 0) => {}
        BinaryIns(dest, op, left, right, line) if (objectComparison(op) != '') => {
            immut first = self.value(left)
            immut second = self.value(right)
            immut condition = objectComparison(op)

            if (op.startsWith('StrCompare(') and condition != 'eq' and condition != 'ne') {
                immut order = self.temporary()
                self.current.push(MCall(MExternal('koji_string_compare'), [first, second], [order]))
                self.current.push(MUnary(order, 'sext32', MReg(order), -1))
                self.current.push(MSet(dest, condition, MReg(order), MImm(0)))
                return
            }

            immut helper = if (op.startsWith('StrCompare(')) { 'koji_string_equal' } else { if (op.startsWith('ListCompare(')) { 'koji_list_equal' } else { if (op.startsWith('MapCompare(')) { 'koji_map_equal' } else { 'koji_record_equal' } } }
            immut equal = self.temporary()
            self.current.push(MCall(MExternal(helper), [first, second], [equal]))
            self.current.push(MBinary(equal, 'and', MReg(equal), MImm(0xFF), -1))

            if (condition == 'ne') {
                self.current.push(MBinary(dest, 'xor', MReg(equal), MImm(1), -1))
            } else {
                self.current.push(MMove(dest, MReg(equal)))
            }
        }
        // `item in list`, `key in map` (the item or the key by its address), `list.indexOf(item)`.
        BinaryIns(dest, op, left, right, _) if (op == 'ListContains' or op == 'MapContains' or op == 'ListIndexOf') => {
            if (op == 'ListIndexOf') {
                immut list = self.value(left)
                immut item = self.operandInSlot(right)
                self.callLibrary('koji_list_index_of', [list, item], Some(dest), false)
            } else {
                immut item = self.operandInSlot(left)
                immut container = self.value(right)
                self.callLibrary(if (op == 'ListContains') { 'koji_list_contains' } else { 'koji_map_contains' }, [container, item], Some(dest), false)
            }
        }
        // `text in other` (its arguments the other way round).
        BinaryIns(dest, op, left, right, _) if (op == 'StrContains' or op == 'StrContainsChar') => {
            immut first = self.value(left)
            immut second = self.value(right)
            self.callLibrary(if (op == 'StrContains') { 'koji_string_contains' } else { 'koji_string_contains_char' }, [second, first], Some(dest), false)
        }
        // `text + more` where `text` is read for the last time: the library adds to it in place
        // when no one else sees it (it takes the reference of `text`).
        BinaryIns(dest, 'StrConcat', left, right, _) if (self.movedBy(instruction, self.block, self.position).length() > 0) => {
            immut first = self.value(left)

            // The char of the instruction before, whose string was never made: an ASCII one goes in
            // place when no one else sees `text` and its block has room; the library does the rest.
            if (self.position > 0 and self.charAdded(self.block, self.position - 1)) {
                immut text = self.register(first)
                immut code = self.register(self.charValue)
                immut target = self.resultOf(dest)
                immut ascii = self.newBlock()
                immut alone = self.newBlock()
                immut fast = self.newBlock()
                immut slow = self.coldBlock()
                immut done = self.newBlock()
                self.endPiece(MBranch('ae', MReg(code), MImm(0x80), slow, ascii))
                self.startPiece(ascii)
                immut count = self.temporary()
                self.current.push(MLoad(count, MBase(text, 0), 8))
                self.endPiece(MBranch('ne', MReg(count), MImm(1), slow, alone))
                self.startPiece(alone)
                immut size = self.temporary()
                immut room = self.temporary()
                self.current.push(MLoad(size, MBase(text, 8), 8))
                self.current.push(MLoad(room, MBase(text, 16), 8))
                self.endPiece(MBranch('ge', MReg(size), MReg(room), slow, fast))
                self.startPiece(fast)
                self.current.push(MStore(MIndexed(text, size, 1, 24), MReg(code), 1))
                immut grown = self.temporary()
                self.current.push(MBinary(grown, 'add', MReg(size), MImm(1), -1))
                self.current.push(MStore(MBase(text, 8), MReg(grown), 8))
                self.current.push(MMove(target, MReg(text)))
                self.endPiece(MJump(done))
                self.startPiece(slow)
                self.current.push(MCall(MExternal('koji_string_append_char'), [MReg(text), MReg(code)], [target]))
                self.endPiece(MJump(done))
                self.startPiece(done)
                self.setResult(dest, target)
                return
            }

            immut second = self.value(right)
            self.callLibrary('koji_string_append', [first, second], Some(dest), false)
        }
        // `items + more` where `items` is read for the last time: the same (`koji_list_append`).
        BinaryIns(dest, 'ListConcat', left, right, _) if (self.movedBy(instruction, self.block, self.position).length() > 0) => {
            immut first = self.value(left)
            immut second = self.value(right)
            self.callLibrary('koji_list_append', [first, second], Some(dest), false)
        }
        // A shift of an int by a count: checked (0 to 63, unsigned so that a negative one fails
        // too), the count in the message of the panic.
        BinaryIns(dest, op, left, right, line) if ((op == 'ShiftLeft' or op == 'ShiftRight') and not shift(op, right)) => {
            immut first = self.value(left)
            immut count = self.register(self.value(right))
            immut next = self.newBlock()
            immut wrong = self.coldBlock()
            self.endPiece(MBranch('a', MReg(count), MImm(63), wrong, next))
            self.startPiece(wrong)
            immut place = self.addressOf(MText(self.location(line)))
            self.current.push(MCall(MExternal('koji_panic_shift'), [place, MReg(count)], []))
            self.endPiece(MUnreachable)
            self.startPiece(next)
            self.current.push(MBinary(dest, if (op == 'ShiftLeft') { 'shl' } else { 'sar' }, first, MReg(count), -1))
        }
        BinaryIns(dest, op, left, right, line) if (op == 'ByteDiv' or op == 'ByteRem') => {
            immut first = self.value(left)
            immut second = self.value(right)
            immut zero = self.panic(line, 'division by zero')
            self.current.push(MPanicIf('eq', second, MImm(0), zero))
            self.current.push(MBinary(dest, if (op == 'ByteDiv') { 'div' } else { 'rem' }, first, second, -1))
        }
        // A shift of a byte by 0 to 7, keeping 8 bits.
        BinaryIns(dest, op, left, right, line) if (op == 'ByteShiftLeft' or op == 'ByteShiftRight') => {
            immut first = self.value(left)
            immut second = self.value(right)
            immut wrong = self.panic(line, 'shift of a byte out of range (0 to 7)')
            self.current.push(MPanicIf('a', second, MImm(7), wrong))

            if (op == 'ByteShiftLeft') {
                immut shifted = self.temporary()
                self.current.push(MBinary(shifted, 'shl', first, second, -1))
                self.current.push(MBinary(dest, 'and', MReg(shifted), MImm(0xFF), -1))
            } else {
                self.current.push(MBinary(dest, 'shr', first, second, -1))
            }
        }
        BinaryIns(dest, op, left, right, line) if (binaryHelpers.has(op)) => {
            immut first = self.value(left)
            immut second = self.value(right)
            mut args = [first, second]

            if (op in placed) { args.push(self.addressOf(MText(self.location(line)))) }

            self.callLibrary(binaryHelpers[op], args, Some(dest), false)
        }
        UnaryIns(dest, op, value, line) => {
            immut source = self.value(value)

            match (op) {
                'IntNeg' => {
                    immut overflow = self.panic(line, 'integer overflow')
                    self.current.push(MUnary(dest, 'neg', source, overflow))
                }
                'Not' => self.current.push(MBinary(dest, 'xor', source, MImm(1), -1))
                'BitNot' => self.current.push(MUnary(dest, 'not', source, -1))
                // The bits of a byte, in 8 bits.
                'ByteNot' => self.current.push(MBinary(dest, 'xor', source, MImm(0xFF), -1))
                // The same bits.
                'CharCode' => self.current.push(MMove(dest, source))
                'ByteToInt' => self.current.push(MMove(dest, source))
                // The low 32 bits.
                'CodeToChar' => self.current.push(MBinary(dest, 'and', source, MImm(0xFFFFFFFF), -1))
                'FloatNeg' => self.current.push(MUnary(dest, 'fneg', source, -1))
                'IntToFloat' => self.current.push(MUnary(dest, 'itof', source, -1))
                'FloatTruncate' => self.current.push(MUnary(dest, 'ftoi', source, -1))
                // Below 0 is above 255 as unsigned.
                _ => {
                    immut wrong = self.panic(line, 'the value is not a byte (0 to 255)')
                    self.current.push(MPanicIf('a', source, MImm(255), wrong))
                    self.current.push(MMove(dest, source))
                }
            }
        }
        BinaryIns(dest, op, left, right, line) => {
            immut first = self.value(left)
            immut second = self.value(right)
            immut condition = comparison(op)

            if (condition != '') {
                self.current.push(MSet(dest, condition, first, second))
                return
            }

            match (op) {
                'IntAdd' => {
                    immut overflow = self.panic(line, 'integer overflow')
                    self.current.push(MBinary(dest, 'add', first, second, overflow))
                }
                'IntSub' => {
                    immut overflow = self.panic(line, 'integer overflow')
                    self.current.push(MBinary(dest, 'sub', first, second, overflow))
                }
                'IntMul' => {
                    immut overflow = self.panic(line, 'integer overflow')
                    self.current.push(MBinary(dest, 'mul', first, second, overflow))
                }
                'IntMulWrapping' => self.current.push(MBinary(dest, 'mul', first, second, -1))
                // Floats: a result that is not finite panics (a float has no infinity).
                other if (other == 'FloatAdd' or other == 'FloatSub' or other == 'FloatMul') => {
                    immut overflow = self.panic(line, 'float overflow')
                    self.current.push(MBinary(dest, if (other == 'FloatAdd') { 'fadd' } else { if (other == 'FloatSub') { 'fsub' } else { 'fmul' } }, first, second, overflow))
                }
                other if (other == 'FloatDiv' or other == 'FloatRem') => {
                    immut zero = self.panic(line, 'division by zero')
                    immut overflow = self.panic(line, 'float overflow')
                    self.current.push(MPanicIf('eq', second, MImm(0), zero))

                    if (other == 'FloatDiv') {
                        self.current.push(MBinary(dest, 'fdiv', first, second, overflow))
                    } else {
                        // fmod of the library of C.
                        immut remainder = self.floatTemporary()
                        self.current.push(MCall(MExternal('fmod'), [first, second], [remainder]))
                        self.current.push(MUnary(dest, 'fcheck', MReg(remainder), overflow))
                    }
                }
                // koji_float_pow of the library (it panics itself, at the place of the call).
                'FloatPow' => {
                    immut place = self.temporary()
                    self.current.push(MAddressOf(place, MText(self.location(line))))
                    self.current.push(MCall(MExternal('koji_float_pow'), [first, second, MReg(place)], [dest]))
                }
                other if (other == 'IntDiv' or other == 'IntRem') => {
                    immut operation = if (other == 'IntDiv') { 'div' } else { 'rem' }

                    match (second) {
                        // Neither zero nor -1: nothing to check.
                        MImm(number) if (number != 0 and number != -1) => self.current.push(MBinary(dest, operation, first, second, -1))
                        _ => {
                            immut zero = self.panic(line, 'division by zero')
                            immut overflow = self.panic(line, 'integer overflow')
                            self.current.push(MPanicIf('eq', second, MImm(0), zero))
                            self.current.push(MBinary(dest, operation, first, second, overflow))
                        }
                    }
                }
                other if (other == 'BitAnd' or other == 'ByteAnd') => self.current.push(MBinary(dest, 'and', first, second, -1))
                other if (other == 'BitOr' or other == 'ByteOr') => self.current.push(MBinary(dest, 'or', first, second, -1))
                other if (other == 'BitXor' or other == 'ByteXor') => self.current.push(MBinary(dest, 'xor', first, second, -1))
                'ShiftLeft' => self.current.push(MBinary(dest, 'shl', first, second, -1))
                'ShiftRight' => self.current.push(MBinary(dest, 'sar', first, second, -1))
                // Bytes: the result of the words, outside 0 to 255 a panic.
                other => {
                    immut operation = match (other) {
                        'ByteAdd' => 'add'
                        'ByteSub' => 'sub'
                        _ => 'mul'
                    }
                    immut wrong = self.panic(line, 'byte overflow')
                    self.current.push(MBinary(dest, operation, first, second, -1))
                    self.current.push(MPanicIf('a', MReg(dest), MImm(255), wrong))
                }
            }
        }
        CallIns(dest, callee, args, writebacks, line) => {
            mut values: MValue[] = []
            // A global given to a borrowed parameter: the function may change the global, so the
            // caller keeps the value alive with a reference of its own during the call.
            mut kept: MValue[] = []
            mut kinds: string[] = []
            immut borrowed = self.context.borrowed[callee]

            // Where the words of each argument start.
            mut positions: int[] = []

            mut pairs: int[] = []
            mut aligned: int[] = []

            for i in range(args.length()) {
                positions.push(values.length())

                if (wideType(self.operandType(args[i]))) {
                    if (self.operandType(args[i]) == U128Ty) { aligned.push(values.length()) }

                    pairs.push(values.length())
                    values = values + self.words(args[i])
                    continue
                }

                immut value = self.value(args[i])

                match (args[i]) {
                    GlobalOp(global) if (isManaged(self.program.globals[global].ty) and not self.context.constants[global] and i < borrowed.length() and borrowed[i]) => {
                        self.current.push(MRetain(value))
                        kept.push(value)
                        kinds.push(kindOf(self.program.globals[global].ty))
                    }
                    _ => {}
                }

                values.push(value)
            }

            // The `mut` arguments: the function owns their values, and writes their final ones
            // at the addresses it is given (slots of the frame, none at first). A variable that
            // no other argument reads gives its reference for the call (so that the function
            // changes the value in place instead of a copy); another value is retained.
            mut backs: int[] = []
            mut given: int[] = []

            for writeback in writebacks {
                immut param = writeback.param
                immut twoWords = wideType(self.operandType(args[param]))
                immut slot = self.sizedSlot(if (twoWords) { 16 } else { 8 })
                backs.push(slot)

                if (twoWords) {
                    self.current.push(MStore(MSlot(slot, 0), MImm(0), 8))
                    self.current.push(MStore(MSlot(slot, 8), MImm(0), 8))
                    values.push(self.addressOf(MSlot(slot, 0)))
                    continue
                }

                // From a place inside a variable: taken out of it (and the temporary released).
                immut temporary = self.givenFromTarget(callee, args, param, writeback.target, self.block, self.position)

                if (temporary >= 0) {
                    immut variable = self.variable(writeback.target, line)
                    immut taken = self.temporary()
                    self.current.push(MLoad(taken, MBase(variable.address, 0), 8))
                    self.current.push(MStore(MBase(variable.address, 0), MImm(0), 8))
                    self.closeVariable(variable)

                    if (self.owned[temporary]) { self.current.push(MRelease(MReg(temporary), kindOf(self.routine.locals[temporary].ty))) }

                    values[positions[param]] = MReg(taken)
                    self.current.push(MStore(MSlot(slot, 0), MImm(0), 8))
                    values.push(self.addressOf(MSlot(slot, 0)))
                    continue
                }

                if (isManaged(self.operandType(args[param]))) {
                    mut alone = false

                    match (args[param]) {
                        // A global the function does not see, that no other argument reads.
                        GlobalOp(global) if (writeback.target.root == GlobalPlace(global) and writeback.target.path.length() == 0 and not self.context.seen[callee].has(global)) => {
                            alone = true

                            for i in range(args.length()) {
                                if (i != param and args[i] == GlobalOp(global)) { alone = false }
                            }

                            if (alone) { self.current.push(MStore(MSymbol('.bss', self.context.globals[global]), MImm(0), 8)) }
                        }
                        LocalOp(local) if (self.owned[local] and writeback.target.root == LocalPlace(local)) => {
                            alone = true

                            for i in range(args.length()) {
                                if (i != param and args[i] == LocalOp(local)) { alone = false }
                            }

                            if (alone) { given.push(local) }
                        }
                        _ => {}
                    }

                    if (not alone) { self.current.push(MRetain(values[positions[param]])) }
                }

                self.current.push(MStore(MSlot(slot, 0), MImm(0), 8))
                values.push(self.addressOf(MSlot(slot, 0)))
            }

            if (pairs.length() > 0) { self.current.push(MPairs(pairs, aligned)) }

            match (dest) {
                Some(local) if (self.highs[local] >= 0) => self.current.push(MCall(MFunction(callee), values, self.registersOf(local)))
                Some(local) => {
                    immut target = self.resultOf(local)
                    self.current.push(MCall(MFunction(callee), values, [target]))
                    self.setResult(local, target)
                }
                None => self.current.push(MCall(MFunction(callee), values, []))
            }

            // The final values into their variables (the old ones released, but those given), or
            // set in their places by the library (which retains them).
            for i in range(writebacks.length()) {
                immut target = writebacks[i].target
                immut root = target.root
                immut ty = self.targetType(target)
                immut back = if (ty == FloatTy) { self.floatTemporary() } else { self.temporary() }
                self.current.push(MLoad(back, MSlot(backs[i], 0), 8))

                // Two words, into a variable (or set by the library, which copies them).
                if (wideType(ty) and target.path.length() == 0) {
                    immut high = self.temporary()
                    self.current.push(MLoad(high, MSlot(backs[i], 8), 8))

                    match (root) {
                        LocalPlace(local) => self.setWords(local, [MReg(back), MReg(high)])
                        GlobalPlace(global) => {
                            self.current.push(MStore(MSymbol('.bss', self.context.globals[global]), MReg(back), 8))
                            self.current.push(MStore(MSymbol('.bss', self.context.globals[global] + 8), MReg(high), 8))
                        }
                    }

                    continue
                }

                if (target.path.length() > 0) {
                    immut container: Target = { root: root, path: target.path[0..target.path.length() - 1] }
                    immut variable = self.variable(container, line)

                    match (target.path[target.path.length() - 1]) {
                        IndexStep(index) => {
                            immut at = self.value(index)
                            immut where = self.addressOf(MText(self.location(line)))
                            self.current.push(MCall(MExternal('koji_list_set'), [MReg(variable.address), at, self.addressOf(MSlot(backs[i], 0)), where], []))
                        }
                        FieldStep(field) => self.current.push(MCall(MExternal('koji_record_set'), [MReg(variable.address), MImm(field), self.addressOf(MSlot(backs[i], 0))], []))
                        KeyStep(key) => {
                            immut place = self.operandInSlot(key)
                            self.current.push(MCall(MExternal('koji_map_set'), [MReg(variable.address), place, self.addressOf(MSlot(backs[i], 0))], []))
                        }
                    }

                    self.closeVariable(variable)

                    if (isManaged(ty)) { self.current.push(MRelease(MReg(back), kindOf(ty))) }

                    continue
                }

                match (root) {
                    LocalPlace(local) => {
                        if (self.owned[local] and hasBit(self.held, local) and not (local in given)) { self.current.push(MRelease(MReg(local), kindOf(ty))) }

                        self.current.push(MMove(local, MReg(back)))
                    }
                    GlobalPlace(global) => {
                        immut at = MSymbol('.bss', self.context.globals[global])

                        if (isManaged(ty)) {
                            immut old = self.temporary()
                            self.current.push(MLoad(old, at, 8))
                            self.current.push(MStore(at, MReg(back), 8))
                            self.current.push(MRelease(MReg(old), kindOf(ty)))
                        } else {
                            self.current.push(MStore(at, MReg(back), 8))
                        }
                    }
                }
            }

            for i in range(kept.length()) {
                self.current.push(MRelease(kept[i], kinds[i]))
            }
        }
        // One step of a range by 1 or -1: whether there is an item (`next` before the end), the
        // item, and the next one. Once past the end, the item and the next one are read no more.
        RangeCheckIns(step, line) => {
            immut zero = self.panic(line, 'range() step cannot be 0')
            immut value = self.value(step)
            self.current.push(MPanicIf('eq', value, MImm(0), zero))
        }
        // Another step: by its sign, `next` before the end; the item, and the next one, which
        // ends the range when it overflows (`done`).
        RangeNextIns(hasValue, item, next, end, step, done) if (step != IntOp(1) and step != IntOp(-1)) => {
            immut limit = self.value(end)
            immut by = self.register(self.value(step))
            immut check = self.newBlock()
            immut up = self.newBlock()
            immut down = self.newBlock()
            immut taking = self.newBlock()
            immut over = self.newBlock()
            immut store = self.newBlock()
            immut finish = self.newBlock()
            self.current.push(MMove(hasValue, MImm(0)))
            self.endPiece(MBranch('ne', MReg(done), MImm(0), finish, check))
            self.startPiece(check)
            self.endPiece(MBranch('lt', MReg(by), MImm(0), down, up))
            self.startPiece(up)
            self.endPiece(MBranch('ge', MReg(next), limit, finish, taking))
            self.startPiece(down)
            self.endPiece(MBranch('le', MReg(next), limit, finish, taking))
            self.startPiece(taking)
            self.current.push(MMove(item, MReg(next)))
            immut sum = self.temporary()
            immut left = self.temporary()
            immut right = self.temporary()
            self.current.push(MBinary(sum, 'add', MReg(next), MReg(by), -1))
            self.current.push(MBinary(left, 'xor', MReg(next), MReg(sum), -1))
            self.current.push(MBinary(right, 'xor', MReg(by), MReg(sum), -1))
            self.current.push(MBinary(left, 'and', MReg(left), MReg(right), -1))
            self.endPiece(MBranch('lt', MReg(left), MImm(0), over, store))
            self.startPiece(over)
            self.current.push(MMove(done, MImm(1)))
            self.endPiece(MJump(store))
            self.startPiece(store)
            self.current.push(MMove(next, MReg(sum)))
            self.current.push(MMove(hasValue, MImm(1)))
            self.endPiece(MJump(finish))
            self.startPiece(finish)
        }
        RangeNextIns(hasValue, item, next, end, step, _) => {
            immut limit = self.value(end)
            immut unit = match (step) {
                IntOp(number) => number
                _ => 1
            }
            // The comparison last (of the item, the value before the step), so that the branch
            // after it compares itself.
            self.current.push(MMove(item, MReg(next)))
            self.current.push(MBinary(next, 'add', MReg(next), MImm(unit), -1))
            self.current.push(MSet(hasValue, if (unit == 1) { 'lt' } else { 'gt' }, MReg(item), limit))
        }
        _ => {}
    }
}

function Lowering.terminator(mut self, terminator: Terminator): MTerminator {
    return match (terminator) {
        GotoT(target) => MJump(target)
        BranchT(BoolOp(flag), thenBlock, elseBlock) => MJump(if (flag) { thenBlock } else { elseBlock })
        BranchT(condition, thenBlock, elseBlock) => {
            // A comparison just made, which only the branch reads: the branch compares (past the
            // releases after it, and the locals set to none, which it does not read).
            match (condition) {
                LocalOp(local) if (self.reads[local] == 1) => {
                    mut at = self.current.length() - 1
                    mut emptied: int[] = []

                    while (at >= 0) {
                        match (self.current[at]) {
                            MRelease(_, _) => at -= 1
                            MMove(id, MImm(0)) => {
                                emptied.push(id)
                                at -= 1
                            }
                            MSet(dest, kind, left, right) if (dest == local) => {
                                for id in emptied {
                                    if (left == MReg(id) or right == MReg(id)) { return MBranch('ne', MReg(local), MImm(0), thenBlock, elseBlock) }
                                }

                                self.current = self.current[0..at] + self.current[at + 1..self.current.length()]
                                return MBranch(kind, left, right, thenBlock, elseBlock)
                            }
                            _ => break
                        }
                    }
                }
                _ => {}
            }

            immut tested = self.value(condition)
            MBranch('ne', tested, MImm(0), thenBlock, elseBlock)
        }
        ReturnT(Some(value)) => {
            if (self.routine.returns == VoidTy) {
                self.releaseHeld()
                return MReturn([])
            }

            if (wideType(self.routine.returns)) {
                immut words = self.words(value)
                self.releaseHeld()
                return MReturn(words)
            }

            // The result is taken before the locals are released: it may be one of them, which
            // then moves out of the function.
            mut returned = MImm(0)

            if (isManaged(self.routine.returns)) {
                match (value) {
                    LocalOp(local) if (self.owned[local] and not self.writeback[local]) => {
                        returned = MReg(local)
                        removeBit(mut self.held, local)
                    }
                    _ => {
                        returned = self.value(value)
                        self.current.push(MRetain(returned))
                    }
                }
            } else {
                returned = self.value(value)
            }

            self.releaseHeld()
            MReturn([returned])
        }
        ReturnT(None) => {
            self.releaseHeld()
            MReturn([])
        }
        UnreachableT => MUnreachable
    }
}

// The final values of the `mut` parameters given back (their references move out: a result that is
// one of them has a reference of its own), then the references the function still holds, released.
function Lowering.releaseHeld(mut self) {
    for param in range(self.routine.params) {
        if (not self.writeback[param]) { continue }

        self.current.push(MStore(MBase(self.outs[param], 0), MReg(param), 8))

        if (self.highs[param] >= 0) { self.current.push(MStore(MBase(self.outs[param], 8), MReg(self.highs[param]), 8)) }
    }

    for local in bitMembers(self.held) {
        if (self.owned[local] and not self.writeback[local]) {
            self.current.push(MRelease(MReg(local), kindOf(self.routine.locals[local].ty)))
            removeBit(mut self.held, local)
        }
    }
}

// A call of a function of the standard library (or of a foreign block): its arguments of one
// word each, the descriptions of records and of items by their addresses.
function Lowering.libraryCall(mut self, dest: Option[int], name: string, args: StdArg[]) {
    mut values: MValue[] = []
    mut pairs: int[] = []
    mut aligned: int[] = []

    for arg in args {
        match (arg) {
            // A value of two words: both.
            ValueArg(given) if (wideType(self.operandType(given))) => {
                if (self.operandType(given) == U128Ty) { aligned.push(values.length()) }

                pairs.push(values.length())
                values = values + self.words(given)
                continue
            }
            _ => {}
        }

        immut value = match (arg) {
            ValueArg(given) => self.value(given)
            ModeArg(mode) => MImm(mode)
            RecordArg(record) => self.addressOf(MSymbol('.data', self.context.records[record]))
            ElementArg(ty) => self.addressOf(MSymbol(elementSymbol(ty), 0))
            LocationArg(line) => self.addressOf(MText(self.location(line)))
            PlaceArg(given) => self.value(given)
            NullArg => MImm(0)
        }
        values.push(value)
    }

    // A word of the value (an accessor of the prelude), or an address inside it.
    if (accessors.has(name)) {
        match (dest) {
            Some(local) => {
                immut base = self.register(values[0])
                immut offset = accessors[name]

                if (offset < 0) {
                    self.current.push(MBinary(local, 'add', MReg(base), MImm(-offset), -1))
                } else {
                    self.current.push(MLoad(local, MBase(base, offset), 8))
                }
            }
            None => {}
        }

        return
    }

    // Memory: at an address plus an offset (a constant one in the address).
    if (memoryWidths.has(name)) {
        immut base = self.register(values[0])
        immut at = match (values[1]) {
            MImm(offset) if (offset >= -2147483648 and offset <= 2147483647) => MBase(base, offset)
            other => MIndexed(base, self.register(other), 1, 0)
        }
        immut width = memoryWidths[name]

        if (name.startsWith('koji_unsafe_write_')) {
            self.current.push(MStore(at, values[2], width))
            return
        }

        match (dest) {
            Some(local) => self.current.push(MLoad(local, at, width))
            None => {}
        }

        return
    }

    if (name in inlineLibrary) {
        self.inlineLibrary(dest, name, values)
        return
    }

    // On arm64, the instructions of AES and PMULL as the system tells (getauxval(AT_HWCAP): bits 3
    // and 4).
    // On macOS and arm64 (Apple's processors), they always are.
    if (name == 'koji_aes_available' and targetPlatform() == 4) {
        match (dest) {
            Some(local) => self.current.push(MMove(local, MImm(1)))
            None => {}
        }

        return
    }

    if (name == 'koji_aes_available' and targetPlatform() == 1) {
        immut local = match (dest) {
            Some(found) => found
            None => return
        }
        immut capabilities = self.temporary()
        self.current.push(MCall(MExternal('getauxval'), [MImm(16)], [capabilities]))
        self.current.push(MBinary(capabilities, 'shr', MReg(capabilities), MImm(3), -1))
        self.current.push(MBinary(capabilities, 'and', MReg(capabilities), MImm(3), -1))
        self.current.push(MSet(local, 'eq', MReg(capabilities), MImm(3)))
        return
    }

    if (machineInstructions.has(name)) {
        immut op = machineInstructions[name]
        mut given = values

        // The words of the controls, or of the request (the request, two arguments, three
        // zeros), in a slot of the frame, at an address the instruction gets.
        if (op == 'floatControl') { given = [self.addressOf(MSlot(self.slot(), 0))] }

        if (op == 'valgrind') {
            immut words = self.sizedSlot(48)

            for i in range(6) {
                self.current.push(MStore(MSlot(words, 8 * i), if (i < 3) { values[i] } else { MImm(0) }, 8))
            }

            given = [self.addressOf(MSlot(words, 0)), values[3]]
        }

        immut results = match (dest) {
            Some(local) => self.registersOf(local)
            None => if (op == 'bswap' or op == 'aesAvailable' or op == 'floatControl' or op == 'valgrind') { [self.temporary()] } else { [self.temporary(), self.temporary()] }
        }
        self.current.push(MMachine(results, op, given))
        return
    }

    // The cells of std/task.kj: an item of a shared list, read or changed in place.
    if (name == 'koji_list_shared_get' or name == 'koji_list_shared_set') {
        immut local = match (dest) {
            Some(found) => found
            None => -1
        }
        immut item = if (name == 'koji_list_shared_get') { self.routine.locals[local].ty } else {
            match (args[2]) {
                ValueArg(given) => self.operandType(given)
                _ => IntTy
            }
        }
        immut size = if (wideType(item)) { 2 } else { 1 }

        if (name == 'koji_list_shared_get') {
            immut at = self.temporary()
            self.current.push(MCall(MExternal('koji_list_at'), [values[0], values[1], MImm(size), values[2]], [at]))
            self.loadItem(local, MBase(at, 0))
            return
        }

        immut fresh = values[2]

        if (isManaged(item)) { self.current.push(MRetain(fresh)) }

        immut at = self.temporary()
        self.current.push(MCall(MExternal('koji_list_at'), [values[0], values[1], MImm(size), values[values.length() - 1]], [at]))

        if (size == 2) {
            self.current.push(MStore(MBase(at, 0), values[2], 8))
            self.current.push(MStore(MBase(at, 8), values[3], 8))
            return
        }

        immut old = self.temporary()
        self.current.push(MLoad(old, MBase(at, 0), 8))
        self.current.push(MStore(MBase(at, 0), fresh, 8))

        if (isManaged(item)) { self.current.push(MRelease(MReg(old), kindOf(item))) }

        return
    }

    // A function of a foreign block that blocks: a job (KojiJob of the prelude) that a thread that
    // helps runs while other tasks are alive: the code of the job (its trampoline, made by
    // native.kj), the arguments, the rest zero; its result after.
    for each in self.program.externs {
        if (each.name == name and each.blocking) {
            immut job = self.sizedSlot(88)
            immut run = self.addressOf(MSymbol(`trampoline:${name}`, 0))
            self.current.push(MStore(MSlot(job, 0), run, 8))

            for i in range(10) {
                self.current.push(MStore(MSlot(job, 8 + 8 * i), if (i < values.length()) { values[i] } else { MImm(0) }, 8))
            }

            immut place = self.addressOf(MSlot(job, 0))
            self.callLibrary('koji_task_blocking', [place], dest, false)
            return
        }
    }

    mut symbol = name
    mut cInt = false
    mut variadic = false
    mut fixed = 0

    for each in self.program.externs {
        if (each.name == name) {
            symbol = each.symbol
            cInt = each.returns == 'int'
            variadic = '...' in each.params

            for i in range(each.params.length()) {
                if (each.params[i] == '...' and fixed == 0) { fixed = i }
            }
        }
    }

    if (pairs.length() > 0) { self.current.push(MPairs(pairs, aligned)) }

    if (variadic) {
        match (dest) {
            Some(local) => {
                immut target = self.resultOf(local)
                self.current.push(MCall(MVariadic(symbol, fixed), values, [target]))

                if (cInt) { self.current.push(MUnary(target, 'sext32', MReg(target), -1)) }

                self.setResult(local, target)
            }
            None => self.current.push(MCall(MVariadic(symbol, fixed), values, []))
        }

        return
    }

    self.callLibrary(symbol, values, dest, cInt)
}

// The functions of `koji:unsafe` and of the pool written inline (see `inlineLibrary`).
function Lowering.inlineLibrary(mut self, dest: Option[int], name: string, values: MValue[]) {
    // The words of a U128 or a decimal: made of two, one of them, the product of two low words,
    // the zeros before the first bit set.
    if (name in ['koji_unsafe_wide', 'koji_unsafe_decimal_of', 'koji_unsafe_low_word', 'koji_unsafe_high_word', 'koji_unsafe_decimal_low', 'koji_unsafe_decimal_high', 'koji_unsafe_word_product', 'koji_unsafe_leading_zeros']) {
        immut local = match (dest) {
            Some(found) => found
            None => return
        }

        match (name) {
            other if (other == 'koji_unsafe_wide' or other == 'koji_unsafe_decimal_of') => self.setWords(local, [values[0], values[1]])
            other if (other == 'koji_unsafe_low_word' or other == 'koji_unsafe_decimal_low') => self.current.push(MMove(local, values[0]))
            other if (other == 'koji_unsafe_high_word' or other == 'koji_unsafe_decimal_high') => self.current.push(MMove(local, values[1]))
            'koji_unsafe_word_product' => self.current.push(MWide(self.registersOf(local), 'product', [values[0]], [values[2]]))
            _ => self.current.push(MWide([local], 'zeros', values, []))
        }

        return
    }

    // The result, into its local (a temporary when there is none).
    immut result = match (dest) {
        Some(local) => self.resultOf(local)
        None => self.temporary()
    }

    match (name) {
        // The switch between stacks (see `runtimeCode` in native.kj), a call that saves the
        // registers it must.
        'koji_unsafe_switch_stacks' => self.current.push(MCall(MExternal('koji_task_switch'), [values[0], values[1]], []))
        'koji_unsafe_task_entry' => self.current.push(MAddressOf(result, MSymbol('koji_task_entry', 0)))
        'koji_unsafe_offset' => self.current.push(MBinary(result, 'add', values[0], values[1], -1))
        'koji_unsafe_distance' => self.current.push(MBinary(result, 'sub', values[1], values[0], -1))
        // The memory of the system, and a string of a copy of bytes.
        'koji_unsafe_allocate' => self.current.push(MCall(MExternal('malloc'), [values[0]], [result]))
        'koji_unsafe_free' => self.current.push(MCall(MExternal('free'), [values[0]], []))
        'koji_unsafe_new_string' => self.current.push(MCall(MExternal('koji_string_from_utf8'), [values[0], values[1]], [result]))
        'koji_unsafe_set_string_size' => self.current.push(MStore(MBase(self.register(values[0]), 8), values[1], 8))
        'koji_unsafe_set_list_length' => self.current.push(MStore(MBase(self.register(values[0]), 32), values[1], 8))
        'koji_pool_heads' => self.current.push(MAddressOf(result, MSymbol('koji_pool', 0)))
        'koji_pool_is_off' => self.current.push(MLoad(result, MSymbol('koji_pool_off', 0), 1))
        // A new string of `length` bytes to write, with room for `capacity`: a block of 3 + room / 8
        // words, the room the larger of the two rounded up to a word.
        'koji_unsafe_blank_string' => {
            immut length = self.register(values[0])
            immut room = self.temporary()
            immut larger = self.newBlock()
            immut next = self.newBlock()
            self.current.push(MMove(room, values[1]))
            self.endPiece(MBranch('lt', MReg(room), MReg(length), larger, next))
            self.startPiece(larger)
            self.current.push(MMove(room, MReg(length)))
            self.endPiece(MJump(next))
            self.startPiece(next)
            self.current.push(MBinary(room, 'add', MReg(room), MImm(7), -1))
            self.current.push(MBinary(room, 'and', MReg(room), MImm(-8), -1))
            immut words = self.temporary()
            self.current.push(MBinary(words, 'shr', MReg(room), MImm(3), -1))
            self.current.push(MBinary(words, 'add', MReg(words), MImm(3), -1))
            self.poolTakeAny(result, MReg(words))
            self.current.push(MStore(MBase(result, 0), MImm(1), 8))
            self.current.push(MStore(MBase(result, 8), MReg(length), 8))
            self.current.push(MStore(MBase(result, 16), MReg(room), 8))
        }
        other if (other == 'koji_memory_take' or other == 'koji_pool_take') => self.poolTakeAny(result, values[0])
        // A block back at the head of the list of its size, or koji_pool_free (large, or the pool
        // off).
        other if (other == 'koji_memory_give' or other == 'koji_pool_give') => {
            immut block = self.register(values[0])
            immut words = self.register(values[1])
            immut off = self.temporary()
            immut check = self.newBlock()
            immut give = self.newBlock()
            immut free = self.coldBlock()
            immut done = self.newBlock()
            self.endPiece(MBranch('a', MReg(words), MImm(16), free, check))
            self.startPiece(check)
            self.current.push(MLoad(off, MSymbol('koji_pool_off', 0), 1))
            self.endPiece(MBranch('ne', MReg(off), MImm(0), free, give))
            self.startPiece(give)
            immut heads = self.temporary()
            immut rest = self.temporary()
            self.current.push(MAddressOf(heads, MSymbol('koji_pool', 0)))
            self.current.push(MLoad(rest, MIndexed(heads, words, 8, 0), 8))
            self.current.push(MStore(MBase(block, 0), MReg(rest), 8))
            self.current.push(MStore(MIndexed(heads, words, 8, 0), MReg(block), 8))
            self.endPiece(MJump(done))
            self.startPiece(free)
            self.current.push(MCall(MExternal('koji_pool_free'), [MReg(block), MReg(words)], []))
            self.endPiece(MJump(done))
            self.startPiece(done)
        }
        // What the type of a record says of a field: its variant (the variants of the type + tag *
        // 48), then the number of its fields, the description of one, or its slot (from the
        // starts of the variant, or the index).
        other if (other in ['koji_record_field_count', 'koji_record_field_type', 'koji_record_field_slot', 'koji_record_get']) => {
            immut record = self.register(values[0])
            immut kind = self.temporary()
            immut variants = self.temporary()
            immut tag = self.temporary()
            immut variant = self.temporary()
            self.current.push(MLoad(kind, MBase(record, 8), 8))
            self.current.push(MLoad(variants, MBase(kind, 16), 8))
            self.current.push(MLoad(tag, MBase(record, 16), 8))
            self.current.push(MBinary(tag, 'mul', MReg(tag), MImm(48), -1))
            self.current.push(MBinary(variant, 'add', MReg(variants), MReg(tag), -1))

            if (other == 'koji_record_field_count') {
                self.current.push(MLoad(result, MBase(variant, 8), 8))
            } else {
                immut index = self.register(values[1])

                if (other == 'koji_record_field_type') {
                    immut types = self.temporary()
                    self.current.push(MLoad(types, MBase(variant, 24), 8))
                    self.current.push(MLoad(result, MIndexed(types, index, 8, 0), 8))
                } else {
                    immut starts = self.temporary()
                    immut word = self.temporary()
                    immut placed = self.newBlock()
                    immut next = self.newBlock()
                    self.current.push(MLoad(starts, MBase(variant, 40), 8))
                    self.current.push(MMove(word, MReg(index)))
                    self.endPiece(MBranch('eq', MReg(starts), MImm(0), next, placed))
                    self.startPiece(placed)
                    self.current.push(MLoad(word, MIndexed(starts, index, 8, 0), 8))
                    self.endPiece(MJump(next))
                    self.startPiece(next)
                    self.current.push(MAddressOf(result, MIndexed(record, word, 8, 24)))
                }
            }
        }
        // Whether the items hold references (a function to release them).
        'koji_element_counted' => {
            immut element = self.register(values[0])
            immut release = self.temporary()
            self.current.push(MLoad(release, MBase(element, 16), 8))
            self.current.push(MSet(result, 'ne', MReg(release), MImm(0)))
        }
        // The function that retains or releases the item in a slot, called when there is one.
        _ => {
            immut element = self.register(values[0])
            immut called = self.temporary()
            immut call = self.newBlock()
            immut done = self.newBlock()
            self.current.push(MLoad(called, MBase(element, if (name == 'koji_element_retain') { 8 } else { 16 }), 8))
            self.endPiece(MBranch('eq', MReg(called), MImm(0), done, call))
            self.startPiece(call)
            self.current.push(MCall(MIndirect(MReg(called)), [values[1]], []))
            self.endPiece(MJump(done))
            self.startPiece(done)
        }
    }

    match (dest) {
        Some(local) => self.setResult(local, result)
        None => {}
    }
}

// A block of `words` words (known or not) from the pool into `target`: the head of its list,
// else koji_pool_refill (for more than 16 words too).
function Lowering.poolTakeAny(mut self, target: int, words: MValue) {
    match (words) {
        MImm(size) if (size <= 16) => {
            self.poolTake(target, size)
            return
        }
        _ => {}
    }

    immut size = self.register(words)
    immut check = self.newBlock()
    immut taken = self.newBlock()
    immut refill = self.coldBlock()
    immut next = self.newBlock()
    self.endPiece(MBranch('a', MReg(size), MImm(16), refill, check))
    self.startPiece(check)
    immut heads = self.temporary()
    self.current.push(MAddressOf(heads, MSymbol('koji_pool', 0)))
    self.current.push(MLoad(target, MIndexed(heads, size, 8, 0), 8))
    self.endPiece(MBranch('eq', MReg(target), MImm(0), refill, taken))
    self.startPiece(taken)
    immut rest = self.temporary()
    self.current.push(MLoad(rest, MBase(target, 0), 8))
    self.current.push(MStore(MIndexed(heads, size, 8, 0), MReg(rest), 8))
    self.endPiece(MJump(next))
    self.startPiece(refill)
    self.current.push(MCall(MExternal('koji_pool_refill'), [MReg(size)], [target]))
    self.endPiece(MJump(next))
    self.startPiece(next)
}

// The description of the items of a type (KojiElementType of the prelude).
function elementSymbol(ty: Ty): string {
    return match (ty) {
        IntTy => 'koji_element_int'
        FloatTy => 'koji_element_float'
        DecimalTy => 'koji_element_decimal'
        BoolTy => 'koji_element_bool'
        CharTy => 'koji_element_char'
        ByteTy => 'koji_element_byte'
        U128Ty => 'koji_element_u128'
        StrTy => 'koji_element_string'
        ListTy(_) => 'koji_element_list'
        RecordTy(_) => 'koji_element_record'
        MapTy(_, _) => 'koji_element_map'
        SetTy(_) => 'koji_element_map'
        FunctionTy(_, _) => 'koji_element_closure'
        VoidTy => 'koji_element_void'
    }
}

// The kind of an instruction (and the operation or the function of the library), for the report.
function kindText(instruction: Instruction): string {
    return match (instruction) {
        CopyIns(_, _) => 'CopyIns'
        UnaryIns(_, op, _, _) => `UnaryIns ${op}`
        BinaryIns(_, op, _, _, _) => `BinaryIns ${op}`
        CallIns(_, _, _, writebacks, _) => if (writebacks.length() > 0) { 'CallIns with mut arguments' } else { 'CallIns' }
        ListNewIns(_, _) => 'ListNewIns'
        ListGetIns(_, _, _, _) => 'ListGetIns'
        ListSetIns(_, _, _, _) => 'ListSetIns'
        ListPushIns(_, _, _) => 'ListPushIns'
        ListInsertIns(_, _, _, _) => 'ListInsertIns'
        ListSortIns(_, _) => 'ListSortIns'
        ListSliceIns(_, _, _, _, _) => 'ListSliceIns'
        RecordNewIns(_, _, _) => 'RecordNewIns'
        FieldGetIns(_, _, _) => 'FieldGetIns'
        FieldSetIns(_, _, _, _) => 'FieldSetIns'
        ListRemoveIns(_, _, _, _) => 'ListRemoveIns'
        StdCallIns(_, name, _) => `StdCallIns ${name}`
        TakeIns(_, _) => 'TakeIns'
        DropIns(_, _) => 'DropIns'
        MakeClosureIns(_, _, _) => 'MakeClosureIns'
        CallClosureIns(_, _, _, _) => 'CallClosureIns'
        ListSortByIns(_, _, _) => 'ListSortByIns'
        MapNewIns(_, _) => 'MapNewIns'
        MapGetIns(_, _, _, _) => 'MapGetIns'
        MapLookupIns(_, _, _) => 'MapLookupIns'
        MapSetIns(_, _, _, _) => 'MapSetIns'
        MapRemoveIns(_, _, _, _) => 'MapRemoveIns'
        FailIns(_, _) => 'FailIns'
        PrintIns(_, _) => 'PrintIns'
        RangeNextIns(_, _, _, _, _, _) => 'RangeNextIns'
        RangeCheckIns(_, _) => 'RangeCheckIns'
    }
}
