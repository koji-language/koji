// `kojic lsp`: a server of the Language Server Protocol on the standard input and output, for
// editors: the errors of a file as it is edited (all of them, from the checker), the type of what
// is under the cursor, and where a name is declared. The messages are JSON-RPC, each after a header
// `Content-Length: <bytes>` and an empty line; the server keeps the text of the open files as the
// editor sends it (the whole text at each change).

import file
import json
import path
import system
import { Node, NodeKind, Span, Param, Arm, Pattern, Part, parse } from 'parser.kj'
import { Checked, Program, checkText } from 'checker.kj'
import { display } from 'types.kj'

// The text of each open file, by its URI.
mut documents: Map[string, string] = [:]

// Messages

// The next message, or `None` at the end of the input.
function readMessage(): Option[json.Json] {
    mut length = -1

    while (true) {
        immut line = match (input()) {
            Some(text) => text.trim()
            None => return None
        }

        if (line == '') {
            if (length >= 0) { break }

            continue
        }

        if (line.lower().startsWith('content-length:')) {
            length = match (int(line[15..].trim())) {
                Ok(found) => found
                Err(_) => -1
            }
        }
    }

    immut body = match (system.readInput(length)) {
        Some(text) => text
        None => return None
    }

    return match (json.parse(body)) {
        Ok(value) => Some(value)
        Err(_) => Some(json.Null)
    }
}

// The bytes of a text in UTF-8 (its length counts characters).
function utf8Size(text: string): int {
    mut size = 0

    for c in text {
        immut code = c.code()
        size += if (code < 0x80) { 1 } else { if (code < 0x800) { 2 } else { if (code < 0x10000) { 3 } else { 4 } } }
    }

    return size
}

function send(message: json.Json) {
    immut text = json.stringify(message)
    system.writeOutput(`Content-Length: ${utf8Size(text)}\r\n\r\n${text}`)
}

function respond(id: json.Json, result: json.Json) {
    send(json.Object(['jsonrpc': json.String('2.0'), 'id': id, 'result': result]))
}

function notify(method: string, params: json.Json) {
    send(json.Object(['jsonrpc': json.String('2.0'), 'method': json.String(method), 'params': params]))
}

// A field of fields of an object (`at(message, ['params', 'textDocument', 'uri'])`).
function at(value: json.Json, keys: string[]): Option[json.Json] {
    mut current = value

    for key in keys {
        current = match (json.get(current, key)) {
            Some(found) => found
            None => return None
        }
    }

    return Some(current)
}

function textAt(value: json.Json, keys: string[]): string {
    return match (at(value, keys)) {
        Some(found) => match (json.asString(found)) {
            Some(text) => text
            None => ''
        }
        None => ''
    }
}

function intAt(value: json.Json, keys: string[]): int {
    return match (at(value, keys)) {
        Some(found) => match (json.asInt(found)) {
            Some(number) => number
            None => 0
        }
        None => 0
    }
}

// Files and positions

// The value of a hexadecimal digit, or -1.
function hexDigit(c: char): int {
    immut code = c.code()

    if (code >= 48 and code <= 57) { return code - 48 }

    if (code >= 97 and code <= 102) { return code - 87 }

    if (code >= 65 and code <= 70) { return code - 55 }

    return -1
}

// The path of a `file://` URI (its `%XX` decoded, as UTF-8).
export function pathOfUri(uri: string): string {
    immut rest = if (uri.startsWith('file://')) { uri[7..] } else { uri }
    immut chars = rest.chars()
    mut text = ''
    mut bytes: int[] = []
    mut i = 0

    while (i < chars.length()) {
        if (chars[i] == '%' and i + 2 < chars.length() and hexDigit(chars[i + 1]) >= 0 and hexDigit(chars[i + 2]) >= 0) {
            bytes.push(hexDigit(chars[i + 1]) * 16 + hexDigit(chars[i + 2]))
            i += 3
            continue
        }

        text += decoded(bytes)
        bytes = []
        text += string(chars[i])
        i += 1
    }

    return text + decoded(bytes)
}

// The characters of UTF-8 bytes.
function decoded(bytes: int[]): string {
    mut text = ''
    mut i = 0

    while (i < bytes.length()) {
        immut b = bytes[i]
        immut size = if (b < 0x80) { 1 } else { if (b < 0xE0) { 2 } else { if (b < 0xF0) { 3 } else { 4 } } }
        mut code = if (size == 1) { b } else { if (size == 2) { b & 0x1F } else { if (size == 3) { b & 0x0F } else { b & 0x07 } } }

        for j in range(1, size) {
            if (i + j < bytes.length()) { code = (code << 6) | (bytes[i + j] & 0x3F) }
        }

        match (char(code)) {
            Some(c) => text += string(c)
            None => text += '\u{FFFD}'
        }

        i += size
    }

    return text
}

// The URI of a path: `file://`, the characters outside letters, digits and `/-._~` as `%XX`.
export function uriOfPath(name: string): string {
    mut text = 'file://'

    for c in name {
        immut code = c.code()
        immut plain = (code >= 48 and code <= 57) or (code >= 65 and code <= 90) or (code >= 97 and code <= 122) or '/-._~'.indexOf(string(c)) is Some

        if (plain) {
            text += string(c)
        } else {
            for b in utf8Bytes(code) {
                text += `%${hex2(b)}`
            }
        }
    }

    return text
}

function hex2(b: int): string {
    immut digits = '0123456789ABCDEF'
    return string(digits[b >> 4]) + string(digits[b & 15])
}

function utf8Bytes(code: int): int[] {
    if (code < 0x80) { return [code] }

    if (code < 0x800) { return [0xC0 | (code >> 6), 0x80 | (code & 0x3F)] }

    if (code < 0x10000) { return [0xE0 | (code >> 12), 0x80 | ((code >> 6) & 0x3F), 0x80 | (code & 0x3F)] }

    return [0xF0 | (code >> 18), 0x80 | ((code >> 12) & 0x3F), 0x80 | ((code >> 6) & 0x3F), 0x80 | (code & 0x3F)]
}

// A position of Koji (line and column from 1, in characters) in one of the protocol (line from 0,
// character in units of UTF-16), and back, on the lines of a text.
function lineOf(lines: string[], line: int): string {
    return if (line >= 1 and line <= lines.length()) { lines[line - 1] } else { '' }
}

function utf16Column(lines: string[], line: int, column: int): int {
    immut chars = lineOf(lines, line).chars()
    mut units = 0

    for i in range(column - 1) {
        units += if (i < chars.length() and chars[i].code() > 0xFFFF) { 2 } else { 1 }
    }

    return units
}

function kojiColumn(lines: string[], line: int, units: int): int {
    immut chars = lineOf(lines, line).chars()
    mut seen = 0
    mut column = 1

    while (seen < units and column - 1 < chars.length()) {
        seen += if (chars[column - 1].code() > 0xFFFF) { 2 } else { 1 }
        column += 1
    }

    return column + (units - seen)
}

function position(lines: string[], line: int, column: int): json.Json {
    return json.Object(['line': json.Int(if (line > 0) { line - 1 } else { 0 }), 'character': json.Int(utf16Column(lines, line, column))])
}

function rangeOf(lines: string[], span: Span): json.Json {
    return json.Object(['start': position(lines, span.line, span.column), 'end': position(lines, span.endLine, span.endColumn)])
}

// Diagnostics

// An error of the checker as the protocol has it: where (from the line, column and marks of its
// message) and what. An error of another file (an imported module) is shown on the first line,
// with that file named.
function diagnostic(error: string, name: string, lines: string[]): json.Json {
    immut errorLines = error.split('\n')
    immut first = errorLines[0]
    mut message = first
    mut span: Span = { line: 1, column: 1, endLine: 1, endColumn: 1 }
    immut colon = match (first.indexOf(': ')) {
        Some(found) => found
        None => -1
    }

    // `type error: lib.kj:3:16: message`.
    if (colon > 0) {
        immut rest = first[colon + 2..]
        immut parts = rest.split(': ')
        immut place = parts[0].split(':')

        if (place.length() >= 3) {
            immut fileName = place[..place.length() - 2].join(':')
            immut line = match (int(place[place.length() - 2])) {
                Ok(found) => found
                Err(_) => 0
            }
            immut column = match (int(place[place.length() - 1])) {
                Ok(found) => found
                Err(_) => 0
            }
            immut text = rest[parts[0].length() + 2..]

            if (line > 0 and column > 0 and fileName == name) {
                // The width of the marks of the last line of the message.
                mut width = 1

                if (errorLines.length() >= 3) {
                    width = 0

                    for c in errorLines[errorLines.length() - 1] {
                        if (c == '^') { width += 1 }
                    }
                }

                span = { line: line, column: column, endLine: line, endColumn: column + (if (width > 0) { width } else { 1 }) }
                message = `${first[..colon]}: ${text}`
            } else {
                message = first
            }
        }
    }

    return json.Object(['range': rangeOf(lines, span), 'severity': json.Int(1), 'source': json.String('kojic'), 'message': json.String(message)])
}

// The errors of a file, checked from the text the editor has.
function publishDiagnostics(uri: string) {
    immut text = match (documents.get(uri)) {
        Some(found) => found
        None => ''
    }
    immut name = pathOfUri(uri)
    immut lines = text.split('\n')
    mut found: json.Json[] = []

    if (documents.has(uri)) {
        for error in checkText(name, text).errors {
            found.push(diagnostic(error, name, lines))
        }
    }

    notify('textDocument/publishDiagnostics', json.Object(['uri': json.String(uri), 'diagnostics': json.Array(found)]))
}

// Nodes

// The nodes inside a node.
function children(node: Node): Node[] {
    mut out: Node[] = []

    match (node.kind) {
        Template(parts) => {
            for part in parts {
                match (part) {
                    Expression(value) => out.push(value)
                    Text(_) => {}
                }
            }
        }
        ListLiteral(items) => out = items
        MapLiteral(entries) => {
            for entry in entries {
                out.push(entry.key)
                out.push(entry.value)
            }
        }
        ObjectLiteral(entries) => {
            for entry in entries {
                out.push(entry.value)
            }
        }
        Unary(_, operand) => out.push(operand)
        Binary(_, left, right) => {
            out.push(left)
            out.push(right)
        }
        Call(callee, args) => {
            out.push(callee)

            for arg in args {
                out.push(arg)
            }
        }
        MutArg(place) => out.push(place)
        IndexNode(target, index) => {
            out.push(target)
            out.push(index)
        }
        Slice(target, start, end) => {
            out.push(target)

            for bound in [start, end] {
                match (bound) {
                    Some(value) => out.push(value)
                    None => {}
                }
            }
        }
        Member(object, _) => out.push(object)
        If(condition, thenBranch, elseBranch) => {
            out.push(condition)
            out.push(thenBranch)

            match (elseBranch) {
                Some(branch) => out.push(branch)
                None => {}
            }
        }
        Match(scrutinee, arms) => {
            out.push(scrutinee)

            for arm in arms {
                match (arm.guard) {
                    Some(guard) => out.push(guard)
                    None => {}
                }

                out.push(arm.body)
            }
        }
        Lambda(_, _, body) => out.push(body)
        Block(statements) => out = statements
        While(condition, body) => {
            out.push(condition)
            out.push(body)
        }
        For(_, _, iterable, body) => {
            out.push(iterable)
            out.push(body)
        }
        Return(value) => {
            match (value) {
                Some(found) => out.push(found)
                None => {}
            }
        }
        Assign(_, target, value) => {
            out.push(target)
            out.push(value)
        }
        VarDecl(_, _, value, _) => out.push(value)
        FunctionDecl(_, _, _, _, _, body) => out.push(body)
        Try(value) => out.push(value)
        Asserted(_, call) => out.push(call)
        Export(declaration, _) => out.push(declaration)
        ForC(declaration) => out.push(declaration)
        Located(_, statement) => out.push(statement)
        _ => {}
    }

    return out
}

// Whether a span holds the position (line and column of Koji).
function holds(span: Span, line: int, column: int): boolean {
    if (span.line == 0) { return false }

    if (line < span.line or line > span.endLine) { return false }

    if (line == span.line and column < span.column) { return false }

    if (line == span.endLine and column >= span.endColumn) { return false }

    return true
}

// The nodes from the outermost to the innermost that hold the position.
function pathTo(nodes: Node[], line: int, column: int, mut found: Node[]) {
    for node in nodes {
        immut inner = children(node)
        immut held = holds(node.span, line, column)

        if (held) { found.push(node) }

        // The nodes of an interpolation have no span of their own: their template holds them.
        if (held or node.span.line == 0) {
            immut before = found.length()
            pathTo(inner, line, column, mut found)

            if (held or found.length() > before) { return }
        }
    }
}

// Hover

function hover(id: json.Json, message: json.Json) {
    immut uri = textAt(message, ['params', 'textDocument', 'uri'])
    immut text = match (documents.get(uri)) {
        Some(found) => found
        None => {
            respond(id, json.Null)
            return
        }
    }
    immut lines = text.split('\n')
    immut line = intAt(message, ['params', 'position', 'line']) + 1
    immut column = kojiColumn(lines, line, intAt(message, ['params', 'position', 'character']))
    immut checked = checkText(pathOfUri(uri), text)

    if (checked.program.modules.length() == 0) {
        respond(id, json.Null)
        return
    }

    mut found: Node[] = []
    pathTo(checked.program.modules[0].statements, line, column, mut found)
    mut i = found.length() - 1

    // The innermost node with a type: a name shows its name too, and so does the name of a
    // declaration (`immut count = ...`), outside its value.
    while (i >= 0) {
        immut node = found[i]

        match (node.kind) {
            VarDecl(declared, _, value, _) => {
                if (not holds(value.span, line, column)) {
                    match (checked.program.tables.variableTypes.get(node.id)) {
                        Some(ty) => {
                            immut label = `${declared}: ${display(checked.program.table, ty)}`
                            immut contents = json.Object(['kind': json.String('markdown'), 'value': json.String(`\`\`\`koji\n${label}\n\`\`\``)])
                            respond(id, json.Object(['contents': contents, 'range': rangeOf(lines, node.span)]))
                            return
                        }
                        None => {}
                    }
                }
            }
            _ => {}
        }

        match (checked.program.tables.types.get(node.id)) {
            Some(ty) => {
                immut shown = display(checked.program.table, ty)
                immut label = match (node.kind) {
                    Name(name) => `${name}: ${shown}`
                    _ => shown
                }
                immut contents = json.Object(['kind': json.String('markdown'), 'value': json.String(`\`\`\`koji\n${label}\n\`\`\``)])
                respond(id, json.Object(['contents': contents, 'range': rangeOf(lines, node.span)]))
                return
            }
            None => {}
        }

        i -= 1
    }

    // A name whose type the checker did not keep (the target of an assignment): the type of the
    // variable it names.
    if (found.length() > 0) {
        match (found[found.length() - 1].kind) {
            Name(written) => {
                immut statements = checked.program.modules[0].statements
                immut place = orElse(localDeclaration(found, written, line, column, ''), topDeclaration(statements, written, ''))

                match (place) {
                    Some(declared) => {
                        match (declared.statement) {
                            Some(statement) => {
                                match (checked.program.tables.variableTypes.get(unwrapped(statement).id)) {
                                    Some(ty) => {
                                        immut label = `${written}: ${display(checked.program.table, ty)}`
                                        immut contents = json.Object(['kind': json.String('markdown'), 'value': json.String(`\`\`\`koji\n${label}\n\`\`\``)])
                                        respond(id, json.Object(['contents': contents, 'range': rangeOf(lines, found[found.length() - 1].span)]))
                                        return
                                    }
                                    None => {}
                                }
                            }
                            None => {}
                        }
                    }
                    None => {}
                }
            }
            _ => {}
        }
    }

    respond(id, json.Null)
}

// The statement inside `Located` and `Export`.
function unwrapped(node: Node): Node {
    return match (node.kind) {
        Located(_, inner) => unwrapped(inner)
        Export(inner, _) => unwrapped(inner)
        _ => node
    }
}

// Definition

// A declaration found: its file and where it is.
type Place = {
    file: string
    span: Span
    // The statement that declares it, when it is one (`immut count = ...`).
    statement: Option[Node]
}

// The name declared by a statement (a variable, a function, a type), if it is this one.
function declares(statement: Node, name: string): boolean {
    return match (statement.kind) {
        Located(_, inner) => declares(inner, name)
        Export(inner, _) => declares(inner, name)
        ForC(inner) => declares(inner, name)
        VarDecl(declared, _, _, _) => declared == name
        FunctionDecl(declared, owner, _, _, _, _) => declared == name and owner is None
        ExternDecl(declared, _, _) => declared == name
        TypeDecl(declared, _, _) => declared == name
        _ => false
    }
}

// Whether a list of parameters has the name.
function hasParam(params: Param[], name: string): boolean {
    for param in params {
        if (param.name == name) { return true }
    }

    return false
}

// Whether a pattern binds the name.
function binds(pattern: Pattern, name: string): boolean {
    return match (pattern) {
        Bind(bound) => bound == name
        VariantPattern(_, args) => {
            for arg in args {
                if (binds(arg, name)) { return true }
            }

            false
        }
        _ => false
    }
}

// The declaration of `name` seen from the innermost node of `found` (its enclosing nodes, from the
// innermost out): a variable declared before in a block, a parameter, a `for` variable, a binding of
// a `match` arm; then the top level of the file.
function localDeclaration(found: Node[], name: string, line: int, column: int, fileName: string): Option[Place] {
    mut i = found.length() - 1

    while (i >= 0) {
        immut node = found[i]

        match (node.kind) {
            Block(statements) => {
                mut best: Option[Place] = None

                for statement in statements {
                    immut before = statement.span.line < line or (statement.span.line == line and statement.span.column <= column)

                    if (before and declares(statement, name)) { best = Some({ file: fileName, span: statement.span, statement: Some(statement) }) }
                }

                match (best) {
                    Some(place) => return Some(place)
                    None => {}
                }
            }
            FunctionDecl(_, _, _, params, _, _) => {
                if (hasParam(params, name)) { return Some({ file: fileName, span: node.span, statement: None }) }
            }
            Lambda(params, _, _) => {
                if (hasParam(params, name)) { return Some({ file: fileName, span: node.span, statement: None }) }
            }
            For(variable, _, _, _) => {
                if (variable == name) { return Some({ file: fileName, span: node.span, statement: None }) }
            }
            Match(_, arms) => {
                for arm in arms {
                    if (binds(arm.pattern, name) and holds(arm.body.span, line, column)) { return Some({ file: fileName, span: arm.body.span, statement: None }) }
                }
            }
            _ => {}
        }

        i -= 1
    }

    return None
}

// A declaration at the top level of the statements of a file.
function topDeclaration(statements: Node[], name: string, fileName: string): Option[Place] {
    for statement in statements {
        if (declares(statement, name)) { return Some({ file: fileName, span: statement.span, statement: Some(statement) }) }
    }

    return None
}

// The declaration of a name taken from a module (`import { name } from 'lib.kj'`, `lib.name`):
// found in the file of the module.
function importedDeclaration(statements: Node[], name: string, moduleName: Option[string], fileName: string): Option[Place] {
    for statement in statements {
        immut inner = match (statement.kind) {
            Located(_, declared) => declared
            _ => statement
        }
        mut target: Option[string] = None

        match (inner.kind) {
            ImportNames(names, written) => {
                if (moduleName is None and name in names) { target = Some(written) }
            }
            ImportModule(alias, written) => {
                if (moduleName == Some(alias)) { target = Some(written) }
            }
            _ => {}
        }

        match (target) {
            Some(modulePath) => {
                // Only files: the standard library has no file here.
                if (not modulePath.endsWith('.kj')) { return None }

                immut directory = match (path.parent(fileName)) {
                    Some(found) => found
                    None => '.'
                }
                immut other = path.join(directory, modulePath)
                immut source = match (file.open(other, file.Read)) {
                    Ok(opened) => match (opened.read()) {
                        Ok(text) => text
                        Err(_) => return None
                    }
                    Err(_) => return None
                }

                return match (parse(source)) {
                    Ok(otherStatements) => topDeclaration(otherStatements, name, other)
                    Err(_) => None
                }
            }
            None => {}
        }
    }

    return None
}

// The first place found.
function orElse(first: Option[Place], second: Option[Place]): Option[Place] {
    return match (first) {
        Some(found) => Some(found)
        None => second
    }
}

function definition(id: json.Json, message: json.Json) {
    immut uri = textAt(message, ['params', 'textDocument', 'uri'])
    immut text = match (documents.get(uri)) {
        Some(found) => found
        None => {
            respond(id, json.Null)
            return
        }
    }
    immut lines = text.split('\n')
    immut line = intAt(message, ['params', 'position', 'line']) + 1
    immut column = kojiColumn(lines, line, intAt(message, ['params', 'position', 'character']))
    immut name = pathOfUri(uri)
    immut statements = match (parse(text)) {
        Ok(found) => found
        Err(_) => {
            respond(id, json.Null)
            return
        }
    }
    mut found: Node[] = []
    pathTo(statements, line, column, mut found)

    if (found.length() == 0) {
        respond(id, json.Null)
        return
    }

    immut innermost = found[found.length() - 1]
    mut place: Option[Place] = None

    match (innermost.kind) {
        Name(written) => {
            place = orElse(localDeclaration(found, written, line, column, name), topDeclaration(statements, written, name))
            place = orElse(place, importedDeclaration(statements, written, None, name))
        }
        // `lib.name`: in the module `lib`.
        Member(object, member) => {
            match (object.kind) {
                Name(moduleName) => place = importedDeclaration(statements, member, Some(moduleName), name)
                _ => {}
            }
        }
        _ => {}
    }

    match (place) {
        Some(declared) => {
            immut declaredLines = if (declared.file == name) { lines } else {
                match (file.open(declared.file, file.Read)) {
                    Ok(opened) => match (opened.read()) {
                        Ok(source) => source.split('\n')
                        Err(_) => []
                    }
                    Err(_) => []
                }
            }
            immut start: Span = { line: declared.span.line, column: declared.span.column, endLine: declared.span.line, endColumn: declared.span.column }
            respond(id, json.Object(['uri': json.String(uriOfPath(declared.file)), 'range': rangeOf(declaredLines, start)]))
        }
        None => respond(id, json.Null)
    }
}

// The server

// The answer to `initialize`: what the server does.
function capabilities(): json.Json {
    immut sync = json.Object(['openClose': json.Bool(true), 'change': json.Int(1), 'save': json.Bool(true)])
    return json.Object([
        'capabilities': json.Object(['textDocumentSync': sync, 'hoverProvider': json.Bool(true), 'definitionProvider': json.Bool(true)]),
        'serverInfo': json.Object(['name': json.String('kojic')])
    ])
}

export function serve() {
    mut shutDown = false

    while (true) {
        immut message = match (readMessage()) {
            Some(found) => found
            None => system.exit(if (shutDown) { 0 } else { 1 })
        }
        immut method = textAt(message, ['method'])
        immut id = match (json.get(message, 'id')) {
            Some(found) => found
            None => json.Null
        }
        immut uri = textAt(message, ['params', 'textDocument', 'uri'])

        match (method) {
            'initialize' => respond(id, capabilities())
            'shutdown' => {
                shutDown = true
                respond(id, json.Null)
            }
            'exit' => system.exit(if (shutDown) { 0 } else { 1 })
            'textDocument/didOpen' => {
                documents[uri] = textAt(message, ['params', 'textDocument', 'text'])
                publishDiagnostics(uri)
            }
            'textDocument/didChange' => {
                // The whole text (`change: 1`), in the last change.
                match (at(message, ['params', 'contentChanges'])) {
                    Some(Array(changes)) => {
                        if (changes.length() > 0) { documents[uri] = textAt(changes[changes.length() - 1], ['text']) }
                    }
                    _ => {}
                }

                publishDiagnostics(uri)
            }
            'textDocument/didSave' => publishDiagnostics(uri)
            'textDocument/didClose' => {
                documents.remove(uri)
                publishDiagnostics(uri)
            }
            'textDocument/hover' => hover(id, message)
            'textDocument/definition' => definition(id, message)
            _ => {
                // A request the server does not know: an error, as the protocol asks (a
                // notification is ignored).
                if (id != json.Null) {
                    immut error = json.Object(['code': json.Int(-32601), 'message': json.String(`unknown method '${method}'`)])
                    send(json.Object(['jsonrpc': json.String('2.0'), 'id': id, 'error': error]))
                }
            }
        }
    }
}
