// Which locals each instruction reads for the last time (liveness, by the usual backward analysis
// over the blocks of a function). A value read for the last time can be moved instead of copied
// (see `CopyIns`, `RecordNewIns` and `StrConcat` in cgen.kj).

import { Operand, Place, Target, Step, StdArg, Instruction, Terminator, IrFunction } from 'ir.kj'

// For each block, and each instruction in it, the locals it reads that are not read after it (by a
// later one, by the terminator or by another block).
export function lastUses(routine: IrFunction): int[][][] {
    immut count = routine.blocks.length()
    immut locals = routine.locals.length()
    // For each block, the blocks before it, and the locals it reads before writing them; for
    // each local, the blocks that read it so, and those that write it.
    mut predecessors: int[][] = []
    mut readFirst: int[][] = []
    mut writtenIn: int[][] = []

    for index in range(count) {
        predecessors.push([])
    }

    for local in range(locals) {
        readFirst.push([])
        writtenIn.push([])
    }

    // `seen[local] == stamp`: the local is in the set being built (a new stamp empties it).
    mut seen: int[] = []
    mut written: int[] = []

    for local in range(locals) {
        seen.push(-1)
        written.push(-1)
    }

    for index in range(count) {
        immut block = routine.blocks[index]

        for next in successors(block.terminator) {
            predecessors[next].push(index)
        }

        // Forwards: a local read before the block writes it is read first.
        for instruction in block.instructions {
            for local in uses(instruction) {
                if (written[local] != index and seen[local] != index) {
                    seen[local] = index
                    readFirst[local].push(index)
                }
            }

            for local in defs(instruction) {
                if (written[local] != index) {
                    written[local] = index
                    writtenIn[local].push(index)
                }
            }
        }

        for local in terminatorUses(block.terminator) {
            if (written[local] != index and seen[local] != index) {
                seen[local] = index
                readFirst[local].push(index)
            }
        }
    }

    // For each local, from the blocks that read it first, back through the blocks before them:
    // it is live at their end, and at their start unless they write it.
    mut liveOut: int[][] = []
    // `outStamp[block] == local`: the local is already live at the end of the block; `inStamp`,
    // at its start; `writes`, the block writes it.
    mut outStamp: int[] = []
    mut inStamp: int[] = []
    mut writes: int[] = []

    for index in range(count) {
        liveOut.push([])
        outStamp.push(-1)
        inStamp.push(-1)
        writes.push(-1)
    }

    for local in range(locals) {
        for index in writtenIn[local] {
            writes[index] = local
        }

        mut pending: int[] = []

        for index in readFirst[local] {
            inStamp[index] = local
            pending.push(index)
        }

        while (true) {
            immut index = match (pending.pop()) {
                Some(found) => found
                None => break
            }

            for before in predecessors[index] {
                if (outStamp[before] != local) {
                    outStamp[before] = local
                    liveOut[before].push(local)
                }

                if (writes[before] != local and inStamp[before] != local) {
                    inStamp[before] = local
                    pending.push(before)
                }
            }
        }
    }

    // Each block backwards, with the locals live after each instruction (`live[local]`, cleared
    // after the block through `set`).
    mut live: boolean[] = []

    for local in range(locals) {
        live.push(false)
    }

    mut result: int[][][] = []

    for index in range(count) {
        immut block = routine.blocks[index]
        mut set: int[] = []

        for local in liveOut[index] {
            live[local] = true
            set.push(local)
        }

        for local in terminatorUses(block.terminator) {
            live[local] = true
            set.push(local)
        }

        mut lasts: int[][] = []

        for i in range(block.instructions.length()) {
            lasts.push([])
        }

        for i in range(block.instructions.length()) {
            immut position = block.instructions.length() - 1 - i
            immut instruction = block.instructions[position]
            immut read = uses(instruction)
            mut last: int[] = []

            for local in read {
                if (not live[local] and not (local in last)) { last.push(local) }
            }

            lasts[position] = last

            for local in defs(instruction) {
                live[local] = false
            }

            for local in read {
                live[local] = true
                set.push(local)
            }
        }

        for local in set {
            live[local] = false
        }

        result.push(lasts)
    }

    return result
}

function successors(terminator: Terminator): int[] {
    return match (terminator) {
        GotoT(block) => [block]
        BranchT(_, thenBlock, elseBlock) => [thenBlock, elseBlock]
        ReturnT(_) => []
        UnreachableT => []
    }
}

// The locals a terminator reads.
function terminatorUses(terminator: Terminator): int[] {
    mut found: int[] = []

    match (terminator) {
        BranchT(condition, _, _) => operandLocal(condition, mut found)
        ReturnT(Some(value)) => operandLocal(value, mut found)
        _ => {}
    }

    return found
}

// The locals an instruction gives a whole new value (without reading the old one).
function defs(instruction: Instruction): int[] {
    return match (instruction) {
        CopyIns(dest, _) => placeLocal(dest)
        UnaryIns(dest, _, _, _) => [dest]
        BinaryIns(dest, _, _, _, _) => [dest]
        CallIns(dest, _, _, _, _) => optional(dest)
        ListNewIns(dest, _) => [dest]
        ListGetIns(dest, _, _, _) => [dest]
        ListSliceIns(dest, _, _, _, _) => [dest]
        RecordNewIns(dest, _, _) => [dest]
        FieldGetIns(dest, _, _) => [dest]
        ListRemoveIns(dest, _, _, _) => [dest]
        StdCallIns(dest, _, _) => optional(dest)
        TakeIns(dest, _) => [dest]
        MakeClosureIns(dest, _, _) => [dest]
        CallClosureIns(dest, _, _, _) => optional(dest)
        MapNewIns(dest, _) => [dest]
        MapGetIns(dest, _, _, _) => [dest]
        MapLookupIns(dest, _, _) => [dest]
        MapRemoveIns(dest, _, _, _) => [dest]
        RangeNextIns(hasValue, value, _, _, _, _) => [hasValue, value]
        _ => []
    }
}

// The locals an instruction reads (a value changed in place is read too).
function uses(instruction: Instruction): int[] {
    mut found: int[] = []

    match (instruction) {
        CopyIns(_, value) => operandLocal(value, mut found)
        UnaryIns(_, _, value, _) => operandLocal(value, mut found)
        BinaryIns(_, _, left, right, _) => {
            operandLocal(left, mut found)
            operandLocal(right, mut found)
        }
        CallIns(_, _, args, writebacks, _) => {
            for arg in args {
                operandLocal(arg, mut found)
            }

            for writeback in writebacks {
                targetLocals(writeback.target, mut found)
            }
        }
        ListNewIns(_, items) => {
            for item in items {
                operandLocal(item, mut found)
            }
        }
        ListGetIns(_, list, index, _) => {
            operandLocal(list, mut found)
            operandLocal(index, mut found)
        }
        ListSetIns(list, index, value, _) => {
            targetLocals(list, mut found)
            operandLocal(index, mut found)
            operandLocal(value, mut found)
        }
        ListPushIns(list, value, _) => {
            targetLocals(list, mut found)
            operandLocal(value, mut found)
        }
        ListInsertIns(list, index, value, _) => {
            targetLocals(list, mut found)
            operandLocal(index, mut found)
            operandLocal(value, mut found)
        }
        ListSortIns(list, _) => targetLocals(list, mut found)
        ListSliceIns(_, list, start, end, _) => {
            operandLocal(list, mut found)
            optionalOperand(start, mut found)
            optionalOperand(end, mut found)
        }
        RecordNewIns(_, _, fields) => {
            for field in fields {
                operandLocal(field, mut found)
            }
        }
        FieldGetIns(_, record, _) => operandLocal(record, mut found)
        FieldSetIns(record, _, value, _) => {
            targetLocals(record, mut found)
            operandLocal(value, mut found)
        }
        ListRemoveIns(_, list, index, _) => {
            targetLocals(list, mut found)
            optionalOperand(index, mut found)
        }
        StdCallIns(_, _, args) => {
            for arg in args {
                match (arg) {
                    ValueArg(value) => operandLocal(value, mut found)
                    _ => {}
                }
            }
        }
        TakeIns(_, source) => placeLocals(source, mut found)
        DropIns(value, _) => placeLocals(value, mut found)
        MakeClosureIns(_, _, environment) => optionalOperand(environment, mut found)
        CallClosureIns(_, closure, args, _) => {
            operandLocal(closure, mut found)

            for arg in args {
                operandLocal(arg, mut found)
            }
        }
        ListSortByIns(list, comparison, _) => {
            targetLocals(list, mut found)
            operandLocal(comparison, mut found)
        }
        MapNewIns(_, entries) => {
            for entry in entries {
                operandLocal(entry.key, mut found)
                operandLocal(entry.value, mut found)
            }
        }
        MapGetIns(_, map, key, _) => {
            operandLocal(map, mut found)
            operandLocal(key, mut found)
        }
        MapLookupIns(_, map, key) => {
            operandLocal(map, mut found)
            operandLocal(key, mut found)
        }
        MapSetIns(map, key, value, _) => {
            targetLocals(map, mut found)
            operandLocal(key, mut found)
            optionalOperand(value, mut found)
        }
        MapRemoveIns(_, map, key, _) => {
            targetLocals(map, mut found)
            operandLocal(key, mut found)
        }
        FailIns(message, _) => operandLocal(message, mut found)
        PrintIns(value, _) => operandLocal(value, mut found)
        // The state of the range is read and written at each step.
        RangeNextIns(_, _, next, end, step, done) => {
            found.push(next)
            found.push(done)
            operandLocal(end, mut found)
            operandLocal(step, mut found)
        }
        RangeCheckIns(step, _) => operandLocal(step, mut found)
    }

    return found
}

function operandLocal(value: Operand, mut found: int[]) {
    match (value) {
        LocalOp(id) => found.push(id)
        _ => {}
    }
}

function optionalOperand(value: Option[Operand], mut found: int[]) {
    match (value) {
        Some(operand) => operandLocal(operand, mut found)
        None => {}
    }
}

function placeLocals(where: Place, mut found: int[]) {
    match (where) {
        LocalPlace(id) => found.push(id)
        GlobalPlace(_) => {}
    }
}

// The root of a target and the operands of its path (indexes and keys).
function targetLocals(target: Target, mut found: int[]) {
    placeLocals(target.root, mut found)

    for part in target.path {
        match (part) {
            IndexStep(index) => operandLocal(index, mut found)
            KeyStep(key) => operandLocal(key, mut found)
            FieldStep(_) => {}
        }
    }
}

function placeLocal(where: Place): int[] {
    return match (where) {
        LocalPlace(id) => [id]
        GlobalPlace(_) => []
    }
}

function optional(dest: Option[int]): int[] {
    return match (dest) {
        Some(local) => [local]
        None => []
    }
}
