    '    *variable = value;',
    '    koji_map_release(old);',
    '}',
    '',
    'KOJI_INLINE KojiMap *koji_map_share(KojiMap *map) {',
    '    koji_map_retain(map);',
    '    return map;',
    '}',
    '',
    'KOJI_INLINE void koji_closure_set_variable(KojiClosure **variable, KojiClosure *value) {',
    '    KojiClosure *old = *variable;',
    '    *variable = value;',
    '    koji_closure_release(old);',
    '}',
    '',
    'KOJI_INLINE KojiClosure *koji_closure_share(KojiClosure *closure) {',
    '    koji_closure_retain(closure);',
    '    return closure;',
    '}',
    '',
    '/* The items of lists and the fields of records, by type. */',
    '',
    'static int32_t koji_order(bool less, bool greater) { return less ? -1 : greater ? 1 : 0; }',
    '',
    'static KojiString *koji_repr_int(const void *slot) { return koji_string_from_int(*(const int64_t *)slot); }',
    'static bool koji_equal_int(const void *a, const void *b) { return *(const int64_t *)a == *(const int64_t *)b; }',
    'static int32_t koji_compare_int(const void *a, const void *b) {',
    '    int64_t x = *(const int64_t *)a, y = *(const int64_t *)b;',
    '    return koji_order(x < y, x > y);',
    '}',
    'static uint64_t koji_hash_int(const void *slot) { return (uint64_t)*(const int64_t *)slot; }',
    'static const KojiElementType koji_element_int = {',
    '    sizeof(int64_t), NULL, NULL, koji_repr_int, koji_equal_int, koji_compare_int, koji_hash_int, NULL};',
    '',
    'static KojiString *koji_repr_float(const void *slot) { return koji_string_from_float(*(const double *)slot); }',
    'static bool koji_equal_float(const void *a, const void *b) { return *(const double *)a == *(const double *)b; }',
    'static int32_t koji_compare_float(const void *a, const void *b) {',
    '    double x = *(const double *)a, y = *(const double *)b;',
    '    return koji_order(x < y, x > y);',
    '}',
    'static uint64_t koji_hash_float(const void *slot) {',
    '    double value = *(const double *)slot;',
    '    uint64_t bits = 0;',
    '    if (value != 0.0) __builtin_memcpy(&bits, &value, sizeof bits); /* 0.0 and -0.0 are equal */',
    '    return bits;',
    '}',
    'static const KojiElementType koji_element_float = {',
    '    sizeof(double), NULL, NULL, koji_repr_float, koji_equal_float, koji_compare_float, koji_hash_float, NULL};',
    '',
    'static KojiString *koji_repr_decimal(const void *slot) { return koji_string_from_decimal(*(const KojiDecimal *)slot); }',
    'static bool koji_equal_decimal(const void *a, const void *b) {',
    '    return koji_decimal_compare(*(const KojiDecimal *)a, *(const KojiDecimal *)b) == 0;',
    '}',
    'static int32_t koji_compare_decimal(const void *a, const void *b) {',
    '    return koji_decimal_compare(*(const KojiDecimal *)a, *(const KojiDecimal *)b);',
    '}',
    'static uint64_t koji_hash_decimal(const void *slot) { return (uint64_t)koji_decimal_hash(*(const KojiDecimal *)slot); }',
    'static const KojiElementType koji_element_decimal = {',
    '    sizeof(KojiDecimal), NULL, NULL, koji_repr_decimal, koji_equal_decimal, koji_compare_decimal, koji_hash_decimal, NULL};',
    '',
    'static KojiString *koji_u128_to_string(KojiU128 value) {',
    '    char digits[40];',
    '    int at = 40;',
    '    do {',
    '        digits[--at] = (char)(\'0\' + (int)(value % 10));',
    '        value /= 10;',
    '    } while (value != 0);',
    '    return koji_string_new(digits + at, (size_t)(40 - at));',
    '}',
    'static KojiString *koji_repr_u128(const void *slot) { KojiU128 value; __builtin_memcpy(&value, slot, 16); return koji_u128_to_string(value); }',
    'static bool koji_equal_u128(const void *a, const void *b) { return __builtin_memcmp(a, b, 16) == 0; }',
    'static int32_t koji_compare_u128(const void *a, const void *b) {',
    '    KojiU128 x, y;',
    '    __builtin_memcpy(&x, a, 16);',
    '    __builtin_memcpy(&y, b, 16);',
    '    return x < y ? -1 : x > y;',
    '}',
    'static uint64_t koji_hash_u128(const void *slot) {',
    '    uint64_t words[2];',
    '    __builtin_memcpy(words, slot, 16);',
    '    return words[0] * 0x9E3779B97F4A7C15u ^ words[1];',
    '}',
    'static const KojiElementType koji_element_u128 = {',
    '    sizeof(KojiU128), NULL, NULL, koji_repr_u128, koji_equal_u128, koji_compare_u128, koji_hash_u128, NULL};',
    '',
    'static KojiString *koji_repr_bool(const void *slot) { return koji_string_from_bool(*(const bool *)slot); }',
    'static bool koji_equal_bool(const void *a, const void *b) { return *(const bool *)a == *(const bool *)b; }',
    '/* Booleans compare as equal: a sort keeps their order. */',
    'static int32_t koji_compare_bool(const void *a, const void *b) { (void)a; (void)b; return 0; }',
    'static uint64_t koji_hash_bool(const void *slot) { return *(const bool *)slot; }',
    'static const KojiElementType koji_element_bool = {',
    '    sizeof(bool), NULL, NULL, koji_repr_bool, koji_equal_bool, koji_compare_bool, koji_hash_bool, NULL};',
    '',
