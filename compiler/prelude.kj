    '    0, NULL, NULL, koji_repr_void, koji_equal_void, NULL, koji_hash_void, NULL};',
    '',
    '/* `items.sortBy(comparison)`: calls the comparison with two items of each C type. */',
    '#define KOJI_BEFORE(name, type)                                                                    \\',
    '    static bool koji_before_##name(const KojiClosure *c, const void *a, const void *b) {           \\',
    '        return ((bool (*)(KojiRecord *, type, type))koji_closure_code(c))(                        \\',
    '            koji_closure_environment(c), *(type const *)a, *(type const *)b);                      \\',
    '    }',
    'KOJI_BEFORE(int, int64_t)',
    'KOJI_BEFORE(float, double)',
    'KOJI_BEFORE(decimal, KojiDecimal)',
    'KOJI_BEFORE(bool, bool)',
    'KOJI_BEFORE(char, uint32_t)',
    'KOJI_BEFORE(byte, uint8_t)',
    'KOJI_BEFORE(u128, KojiU128)',
    'KOJI_BEFORE(string, KojiString *)',
    'KOJI_BEFORE(list, KojiList *)',
    'KOJI_BEFORE(record, KojiRecord *)',
    'KOJI_BEFORE(map, KojiMap *)',
    'KOJI_BEFORE(closure, KojiClosure *)',
    '',
    'KOJI_INLINE int64_t koji_int_add(int64_t a, int64_t b, const char *location) {',
    '    int64_t result;',
    '    if (__builtin_add_overflow(a, b, &result)) koji_panic(location, "integer overflow");',
    '    return result;',
    '}',
    '',
    'KOJI_INLINE int64_t koji_int_sub(int64_t a, int64_t b, const char *location) {',
    '    int64_t result;',
    '    if (__builtin_sub_overflow(a, b, &result)) koji_panic(location, "integer overflow");',
    '    return result;',
    '}',
    '',
    'KOJI_INLINE int64_t koji_int_mul(int64_t a, int64_t b, const char *location) {',
    '    int64_t result;',
    '    if (__builtin_mul_overflow(a, b, &result)) koji_panic(location, "integer overflow");',
    '    return result;',
    '}',
    '',
    '/* Truncates toward zero, like Go and Rust. */',
    'KOJI_INLINE int64_t koji_int_div(int64_t a, int64_t b, const char *location) {',
    '    if (b == 0) koji_panic(location, "division by zero");',
    '    if (a == INT64_MIN && b == -1) koji_panic(location, "integer overflow");',
    '    return a / b;',
    '}',
    '',
    '/* The remainder has the sign of the dividend. */',
    'KOJI_INLINE int64_t koji_int_rem(int64_t a, int64_t b, const char *location) {',
    '    if (b == 0) koji_panic(location, "division by zero");',
    '    if (a == INT64_MIN && b == -1) koji_panic(location, "integer overflow");',
    '    return a % b;',
    '}',
    '',
    'KOJI_INLINE int64_t koji_int_neg(int64_t a, const char *location) {',
    '    if (a == INT64_MIN) koji_panic(location, "integer overflow");',
    '    return -a;',
    '}',
    '',
    'KOJI_INLINE int64_t koji_shift_left(int64_t a, int64_t b, const char *location) {',
    '    if (b < 0 || b >= 64) koji_panic_shift(location, b);',
    '    return (int64_t)((uint64_t)a << b);',
    '}',
    '',
    'KOJI_INLINE int64_t koji_shift_right(int64_t a, int64_t b, const char *location) {',
    '    if (b < 0 || b >= 64) koji_panic_shift(location, b);',
    '    return a >> b;',
    '}',
    '',
    '/* Bytes: 0 to 255. Arithmetic outside of it panics, like that of ints; a shift keeps 8 bits. */',
    'KOJI_INLINE uint8_t koji_byte_check(int64_t result, const char *location) {',
    '    if (result < 0 || result > 255) koji_panic(location, "byte overflow");',
    '    return (uint8_t)result;',
    '}',
    '',
    'KOJI_INLINE uint8_t koji_int_to_byte(int64_t value, const char *location) {',
    '    if (value < 0 || value > 255) koji_panic(location, "the value is not a byte (0 to 255)");',
    '    return (uint8_t)value;',
    '}',
    '',
    'KOJI_INLINE uint8_t koji_byte_add(uint8_t a, uint8_t b, const char *location) { return koji_byte_check((int64_t)a + b, location); }',
    'KOJI_INLINE uint8_t koji_byte_sub(uint8_t a, uint8_t b, const char *location) { return koji_byte_check((int64_t)a - b, location); }',
    'KOJI_INLINE uint8_t koji_byte_mul(uint8_t a, uint8_t b, const char *location) { return koji_byte_check((int64_t)a * b, location); }',
    '',
    'KOJI_INLINE uint8_t koji_byte_div(uint8_t a, uint8_t b, const char *location) {',
    '    if (b == 0) koji_panic(location, "division by zero");',
    '    return a / b;',
    '}',
    '',
    'KOJI_INLINE uint8_t koji_byte_rem(uint8_t a, uint8_t b, const char *location) {',
    '    if (b == 0) koji_panic(location, "division by zero");',
    '    return a % b;',
    '}',
    '',
    'KOJI_INLINE uint8_t koji_byte_pow(uint8_t base, uint8_t exponent, const char *location) {',
    '    int64_t result = 1;',
    '    for (uint8_t i = 0; i < exponent; i++) result = koji_byte_check(result * base, location);',
    '    return (uint8_t)result;',
    '}',
    '',
    'KOJI_INLINE uint8_t koji_byte_shift_left(uint8_t a, uint8_t b, const char *location) {',
    '    if (b >= 8) koji_panic(location, "shift of a byte out of range (0 to 7)");',
    '    return (uint8_t)(a << b);',
    '}',
    '',
    'KOJI_INLINE uint8_t koji_byte_shift_right(uint8_t a, uint8_t b, const char *location) {',
    '    if (b >= 8) koji_panic(location, "shift of a byte out of range (0 to 7)");',
    '    return (uint8_t)(a >> b);',
    '}',
    '',
    '/* float has no infinity: a result that does not fit is a representation limit. */',
    'KOJI_INLINE double koji_float_check(double result, const char *location) {',
    '    if (!isfinite(result)) koji_panic(location, "float overflow");',
    '    return result;',
    '}',
    '',
    'KOJI_INLINE double koji_float_div(double a, double b, const char *location) {',
    '    if (b == 0.0) koji_panic(location, "division by zero");',
    '    return koji_float_check(a / b, location);',
    '}',
    '',
    'KOJI_INLINE double koji_float_rem(double a, double b, const char *location) {',
    '    if (b == 0.0) koji_panic(location, "division by zero");',
    '    return koji_float_check(fmod(a, b), location);',
    '}',
    '',
    '/* One step of `for i in range(...)`. */',
    'KOJI_INLINE bool koji_range_next(int64_t *next, int64_t end, int64_t step, bool *done,',
    '                                   int64_t *value) {',
    '    int64_t i = *next;',
    '    if (*done || !((step > 0 && i < end) || (step < 0 && i > end))) return false;',
    '    if (__builtin_add_overflow(i, step, next)) *done = true;',
    '    *value = i;',
    '    return true;',
    '}',
]
