    '    void (*free)(KojiRecord *record);',
    '    /* For an opaque type, the text of a value (its `display` method), which shows it inside other',
    '       values too; NULL for the others. */',
    '    KojiString *(*display)(const KojiRecord *record);',
    '};',
    '',
    '/* A record: the words of its fields follow it, in the same allocation, at the offsets of its',
    '   variant. It is made, its fields set and read, and its references counted here, inline; the rest',
    '   is in std/koji/record.kj. */',
    'struct KojiRecord {',
    '    size_t references;',
    '    const KojiRecordType *type;',
    '    size_t tag;',
    '    uint64_t words[];',
    '};',
    '',
    '/* A new record of variant `tag`, of `words` words of fields, with one reference and its fields',
    '   zero (the generated code writes them next), in `memory` (on the stack of a function, for a',
    '   record that never leaves it) or in a block of the pool. */',
    'KOJI_INLINE KojiRecord *koji_record_at(void *memory, const KojiRecordType *type, size_t tag, size_t words) {',
    '    KojiRecord *record = (KojiRecord *)memory;',
    '    record->references = 1;',
    '    record->type = type;',
    '    record->tag = tag;',
    '    for (size_t i = 0; i < words; i++) record->words[i] = 0;',
    '    return record;',
    '}',
    '',
    'KOJI_INLINE KojiRecord *koji_record_make(const KojiRecordType *type, size_t tag, size_t words) {',
    '    return koji_record_at(koji_pool_take(3 + words), type, tag, words);',
    '}',
    '',
    '/* The words of the fields of a variant. */',
    'KOJI_INLINE size_t koji_variant_words(const KojiVariantType *variant) {',
    '    return variant->field_offsets ? variant->field_offsets[variant->field_count] : variant->field_count;',
    '}',
    '',
    '/* A new record of variant `tag`, with its fields zero: the generated code sets them next. */',
    'KOJI_INLINE KojiRecord *koji_record_new(const KojiRecordType *type, size_t tag) {',
    '    return koji_record_make(type, tag, koji_variant_words(&type->variants[tag]));',
    '}',
    '',
    '/* Sets a field of a new record (with its own reference to the value). */',
    'KOJI_INLINE void koji_record_init(KojiRecord *record, size_t index, const void *value) {',
    '    const KojiVariantType *variant = &record->type->variants[record->tag];',
    '    const KojiElementType *field = variant->field_types[index];',
    '    void *slot = &record->words[variant->field_offsets ? variant->field_offsets[index] : index];',
    '    __builtin_memcpy(slot, value, field->size);',
    '    if (field->retain) field->retain(slot);',
    '}',
    '',
    '/* Copies the record in `variable` when it is shared, so that it can be changed in place. */',
    'void koji_record_unshare(const void *variable);',
    '',
    'KOJI_INLINE void koji_record_retain(const KojiRecord *record) {',
    '    if (record) ((KojiRecord *)record)->references++;',
    '}',
    '',
    '/* At the last reference, the fields are released and the record freed (by its type). NULL is',
    '   ignored. */',
    'KOJI_INLINE void koji_record_release(KojiRecord *record) {',
    '    if (record && --record->references == 0) record->type->free(record);',
    '}',
    '',
    'KOJI_INLINE int64_t koji_record_tag(const KojiRecord *record) { return (int64_t)record->tag; }',
    '',
    '/* The slot of a field, to read it. */',
    'KOJI_INLINE const void *koji_record_get(const KojiRecord *record, size_t index) {',
    '    const size_t *offsets = record->type->variants[record->tag].field_offsets;',
    '    return &record->words[offsets ? offsets[index] : index];',
    '}',
    '',
    'void *koji_record_slot(const void *variable, size_t index);',
    'void koji_record_set(const void *variable, size_t index, const void *value);',
    'bool koji_record_equal(const void *a, const void *b);',
    'KojiString *koji_record_repr(const void *record);',
    'KojiString *koji_record_display(const void *record);',
    'int64_t koji_record_hash(const void *record);',
    '',
    '/* For std/koji/record.kj, with the types of its `extern` declarations: what the type of a record',
    '   says of it. */',
    'KOJI_INLINE const KojiVariantType *koji_variant_of(const void *record) {',
    '    const KojiRecord *value = (const KojiRecord *)record;',
    '    return &value->type->variants[value->tag];',
    '}',
    'KOJI_INLINE int64_t koji_record_words(const void *record) { return (int64_t)koji_variant_words(koji_variant_of(record)); }',
    'KOJI_INLINE int64_t koji_record_field_count(const void *record) { return (int64_t)koji_variant_of(record)->field_count; }',
    'KOJI_INLINE void *koji_record_field_type(const void *record, int64_t index) {',
    '    return (void *)koji_variant_of(record)->field_types[index];',
    '}',
    'KOJI_INLINE void *koji_record_field_slot(const void *record, int64_t index) {',
    '    return (void *)koji_record_get((const KojiRecord *)record, (size_t)index);',
    '}',
    'KOJI_INLINE void *koji_record_field_name(const void *record, int64_t index) {',
    '    return (void *)koji_variant_of(record)->field_names[index];',
    '}',
    '/* The name of the variant, or NULL for an object type; the name of the type. */',
    'KOJI_INLINE void *koji_record_variant_name(const void *record) { return (void *)koji_variant_of(record)->name; }',
    'KOJI_INLINE void *koji_record_type_name(const void *record) { return (void *)((const KojiRecord *)record)->type->name; }',
    '/* An opaque type shows its values by its `display` method. */',
    'KOJI_INLINE bool koji_record_opaque(const void *record) { return ((const KojiRecord *)record)->type->display != NULL; }',
    'KOJI_INLINE KojiString *koji_record_shown(const void *record) {',
    '    return ((const KojiRecord *)record)->type->display((const KojiRecord *)record);',
    '}',
    'KOJI_INLINE void koji_record_drop(const void *record) { koji_record_release((KojiRecord *)record); }',
    '',
    'typedef struct KojiMap KojiMap;',
    '',
    '/* Maps and sets (std/koji/map.kj): the count of references is the first word of a map, and the',
    '   number of its entries the fifth. */',
    'void *koji_map_new(const void *key, const void *value);',
    'void koji_map_free(const void *map);',
    'KOJI_INLINE void koji_map_retain(const KojiMap *map) {',
    '    if (map) ++*(size_t *)map;',
    '}',
    'KOJI_INLINE void koji_map_release(KojiMap *map) {',
    '    if (map && --*(size_t *)map == 0) koji_map_free(map);',
    '}',
    'KOJI_INLINE int64_t koji_map_length(const KojiMap *map) { return ((const int64_t *)map)[4]; }',
    'void *koji_map_get(const void *map, const void *key, const char *location);',
    'void *koji_map_find(const void *map, const void *key);',
    'bool koji_map_contains(const void *map, const void *key);',
    'void *koji_map_slot(const void *variable, const void *key, const char *location);',
    'void koji_map_set(const void *variable, const void *key, const void *value);',
    'bool koji_map_remove(const void *variable, const void *key, const void *out);',
    'void *koji_map_keys(const void *map);',
    'void *koji_map_values(const void *map);',
    'void *koji_set_from_list(const void *list);',
    'bool koji_map_equal(const void *a, const void *b);',
    'int64_t koji_map_hash(const void *map);',
    'KojiString *koji_map_repr(const void *map);',
    '',
    'typedef struct KojiClosure KojiClosure;',
    '',
    '/* Closures (std/koji/closure.kj): 4 words, the count of references, the code, the environment (a',
    '   record of the captured values, or NULL) and the name of the function. */',
    'void *koji_closure_new(const void *code, const void *environment, const void *name);',
    'void koji_closure_free(const void *closure);',
    'KOJI_INLINE void koji_closure_retain(const KojiClosure *closure) {',
    '    if (closure) ++*(size_t *)closure;',
    '}',
    'KOJI_INLINE void koji_closure_release(KojiClosure *closure) {',
    '    if (closure && --*(size_t *)closure == 0) koji_closure_free(closure);',
    '}',
    'KOJI_INLINE const void *koji_closure_code(const KojiClosure *closure) { return ((const void *const *)closure)[1]; }',
    'KOJI_INLINE KojiRecord *koji_closure_environment(const KojiClosure *closure) { return ((KojiRecord *const *)closure)[2]; }',
    'KojiString *koji_closure_repr(const void *closure);',
    'bool koji_closure_equal(const void *a, const void *b);',
    '/* `items.sortBy(comparison)`: `call(comparison, a, b)` says whether `a` goes before `b` (the',
    '   generated code knows the type of the items). */',
    'void koji_list_sort_by(const void *variable, const void *comparison, const void *call);',
    'KOJI_INLINE bool koji_call_before(const void *call, const void *comparison, const void *a, const void *b) {',
    '    return ((bool (*)(const KojiClosure *, const void *, const void *))call)((const KojiClosure *)comparison, a, b);',
    '}',
    '',
    '/* For sockets and pipes. */',
    'int fcntl(int fd, int command, ...);',
    'int close(int fd);',
    '#if defined(__APPLE__) || defined(__FreeBSD__) || defined(__OpenBSD__) || defined(__NetBSD__)',
    '#define KOJI_O_NONBLOCK 0x4',
    '#else',
    '#define KOJI_O_NONBLOCK 0x800',
    '#endif',
    '/* Tasks (std/koji/task.kj): lightweight tasks on the one thread of a program, each on a stack of',
    '   its own, which the library switches between when a task waits (for another task, a timer or a',
    '   socket). What only C and the assembler can do is here: the switch between two stacks, the stacks,',
    '   the clock, and the poller of the system (epoll on Linux, kqueue on macOS and the BSDs). */',
    'int64_t koji_task_wait_fd(int64_t fd, bool write, int64_t deadline);',
    'void koji_task_main(int64_t task);',
    '/* Saves the registers that a call keeps (the ABI of the system) on the current stack, its top at',
    '   `save`, and goes on with the stack whose top is `to`, as saved by an earlier switch or made by',
    '   koji_task_stack_start: it returns when another switch comes back to this stack. */',
    'void koji_task_switch(const void *save, const void *to);',
    '#if defined(__APPLE__)',
    '#define KOJI_SYMBOL(name) "_" #name',
    '#define KOJI_FUNCTION(name) ".globl _" #name "\\n.p2align 4\\n_" #name ":\\n"',
    '#else',
    '#define KOJI_SYMBOL(name) #name',
    '#define KOJI_FUNCTION(name) ".globl " #name "\\n.type " #name ", @function\\n.p2align 4\\n" #name ":\\n"',
    '#endif',
    '/* Once, in the library: the code of a new task starts at koji_task_entry, which calls',
    '   koji_task_main(task) with the task that koji_task_stack_start left in a register the switch',
    '   restores (rbx, x19). */',
    '#if defined(KOJI_LIBRARY) && defined(__x86_64__)',
    '__asm__(".text\\n" KOJI_FUNCTION(koji_task_switch)',
    '        "pushq %rbp\\npushq %rbx\\npushq %r12\\npushq %r13\\npushq %r14\\npushq %r15\\n"',
    '        "subq $8, %rsp\\nstmxcsr (%rsp)\\nfnstcw 4(%rsp)\\n"',
    '        "movq %rsp, (%rdi)\\nmovq %rsi, %rsp\\n"',
    '        "ldmxcsr (%rsp)\\nfldcw 4(%rsp)\\naddq $8, %rsp\\n"',
    '        "popq %r15\\npopq %r14\\npopq %r13\\npopq %r12\\npopq %rbx\\npopq %rbp\\nret\\n"',
    '        KOJI_FUNCTION(koji_task_entry)',
    '        "movq %rbx, %rdi\\nandq $-16, %rsp\\ncall " KOJI_SYMBOL(koji_task_main) "\\nud2\\n");',
    '#elif defined(KOJI_LIBRARY) && defined(__aarch64__)',
    '__asm__(".text\\n" KOJI_FUNCTION(koji_task_switch)',
    '        "sub sp, sp, #176\\n"',
    '        "stp x19, x20, [sp, #0]\\nstp x21, x22, [sp, #16]\\nstp x23, x24, [sp, #32]\\n"',
    '        "stp x25, x26, [sp, #48]\\nstp x27, x28, [sp, #64]\\nstp x29, x30, [sp, #80]\\n"',
    '        "stp d8, d9, [sp, #96]\\nstp d10, d11, [sp, #112]\\nstp d12, d13, [sp, #128]\\nstp d14, d15, [sp, #144]\\n"',
    '        "mrs x9, fpcr\\nstr x9, [sp, #160]\\n"',
    '        "mov x9, sp\\nstr x9, [x0]\\nmov sp, x1\\n"',
    '        "ldr x9, [sp, #160]\\nmsr fpcr, x9\\n"',
    '        "ldp x19, x20, [sp, #0]\\nldp x21, x22, [sp, #16]\\nldp x23, x24, [sp, #32]\\n"',
    '        "ldp x25, x26, [sp, #48]\\nldp x27, x28, [sp, #64]\\nldp x29, x30, [sp, #80]\\n"',
    '        "ldp d8, d9, [sp, #96]\\nldp d10, d11, [sp, #112]\\nldp d12, d13, [sp, #128]\\nldp d14, d15, [sp, #144]\\n"',
    '        "add sp, sp, #176\\nret\\n"',
    '        KOJI_FUNCTION(koji_task_entry)',
    '        "mov x0, x19\\nbl " KOJI_SYMBOL(koji_task_main) "\\nbrk #1\\n");',
    '#endif',
    'void koji_task_entry(void);',
    '/* The instructions of the processor that koji:unsafe gives the library (see "Instructions of the',
    '   processor" in doc/design.md), as the C backend writes them: the switch between the stacks of two',
    '   tasks, where a new task starts, the control words of floating point, a request to valgrind. The',
    '   stacks themselves are std/koji/task.kj. */',
    'KOJI_INLINE void koji_unsafe_switch_stacks(int64_t save, int64_t to) { koji_task_switch((const void *)(intptr_t)save, (const void *)(intptr_t)to); }',
    'KOJI_INLINE int64_t koji_unsafe_task_entry(void) { return (int64_t)(intptr_t)koji_task_entry; }',
    '/* mxcsr, and the control word of x87 above it, on x86-64; fpcr on arm64. */',
    'KOJI_INLINE int64_t koji_unsafe_float_control(void) {',
    '#if defined(__x86_64__)',
    '    uint32_t mxcsr;',
    '    uint16_t control;',
    '    __asm__ volatile("stmxcsr %0" : "=m"(mxcsr));',
    '    __asm__ volatile("fnstcw %0" : "=m"(control));',
    '    return (int64_t)(mxcsr | (uint64_t)control << 32);',
    '#elif defined(__aarch64__)',
    '    uint64_t control;',
    '    __asm__ volatile("mrs %0, fpcr" : "=r"(control));',
    '    return (int64_t)control;',
    '#else',
    '    return 0;',
    '#endif',
    '}',
    '/* A request to valgrind, when the program runs under it (its "client requests", valgrind.h): a',
    '   sequence of instructions that changes nothing otherwise. Its answer, or `otherwise`. */',
    'KOJI_INLINE int64_t koji_unsafe_valgrind(int64_t request, int64_t first, int64_t second, int64_t otherwise) {',
    '    volatile uint64_t arguments[6] = { (uint64_t)request, (uint64_t)first, (uint64_t)second, 0, 0, 0 };',
    '    uint64_t answer = (uint64_t)otherwise;',
    '#if defined(__x86_64__)',
    '    __asm__ volatile("rolq $3, %%rdi; rolq $13, %%rdi; rolq $61, %%rdi; rolq $51, %%rdi; xchgq %%rbx, %%rbx"',
    '                     : "=d"(answer) : "a"(&arguments[0]), "0"(answer) : "cc", "memory");',
    '#elif defined(__aarch64__)',
    '    __asm__ volatile("mov x3, %1; mov x4, %2; ror x12, x12, #3; ror x12, x12, #13; ror x12, x12, #51; ror x12, x12, #61; orr x10, x10, x10; mov %0, x3"',
    '                     : "=r"(answer) : "r"(answer), "r"(&arguments[0]) : "cc", "memory", "x3", "x4");',
    '#endif',
    '    return (int64_t)answer;',
    '}',
    'struct koji_timespec {',
    '    int64_t seconds, nanoseconds;',
    '};',
    '/* By another name, which does not clash with the `extern` declarations of std/time.kj (for the thread',
    '   of the ticks, which runs no Koji). */',
    'int koji_nanosleep(const struct koji_timespec *request, struct koji_timespec *remaining) __asm__(KOJI_SYMBOL(nanosleep));',
    '/* The nanoseconds of a clock that only grows, and the poller of the sockets: std/koji/task.kj. */',
    'int64_t koji_monotonic_nanoseconds(void);',
    '',
    '/* Calls that block (reading a file, waiting for a program, finding the addresses of a host): while',
    '   other tasks are alive, a thread that helps runs the call, and the task waits for it as for a',
    '   socket; alone, a task makes the call itself. A job is the call: its function, its arguments, its',
    '   result and errno, and the task that waits for it (std/koji/task.kj reads `task` and `done`). The',
    '   helping threads run no Koji: they take jobs from a pipe and give them back through another, which',
    '   the poller watches, so they need no lock. */',
    'typedef struct KojiJob KojiJob;',
    'struct KojiJob {',
    '    void (*run)(KojiJob *job);',
    '    int64_t arguments[6];',
    '    int64_t result;',
    '    int64_t error;',
    '    int64_t task;',
    '    int64_t done;',
    '};',
    'bool koji_task_alone(void);',
    'void koji_task_offload(const void *job);',
    '/* The result of a job, with errno, made by a helping thread unless the task is alone. */',
    'KOJI_INLINE int64_t koji_task_blocking(KojiJob *job) {',
    '    if (koji_task_alone()) {',
    '        job->run(job);',
    '        return job->result;',
    '    }',
    '    koji_task_offload(job);',
    '    errno = (int)job->error;',
    '    return job->result;',
    '}',
    'int koji_c_pipe(int fds[2]) __asm__(KOJI_SYMBOL(pipe));',
    'long read(int fd, void *bytes, size_t size);',
    'long write(int fd, const void *bytes, size_t size);',
    'int pthread_create(uintptr_t *thread, const void *attributes, void *(*start)(void *), void *argument);',
    'int pthread_detach(uintptr_t thread);',
    '/* The two pipes: the jobs to run, and the jobs done. */',
    '#if defined(KOJI_LIBRARY)',
    'static int koji_jobs[2] = { -1, -1 }, koji_jobs_done[2] = { -1, -1 };',
    'static void *koji_helper(void *unused) {',
    '    (void)unused;',
    '    for (;;) {',
    '        KojiJob *job;',
    '        long got = read(koji_jobs[0], &job, sizeof job);',
    '        if (got != sizeof job) {',
    '            if (got < 0 && errno == EINTR) continue;',
    '            return NULL;',
    '        }',
    '        job->run(job);',
    '        job->error = errno;',
    '        while (write(koji_jobs_done[1], &job, sizeof job) < 0 && errno == EINTR) {}',
    '    }',
    '}',
    '/* Makes the pipes (closed in the programs a program runs): the end the jobs done come from, which',
    '   reads without waiting, or -1. */',
    'int64_t koji_helpers_start(void) {',
    '    if (koji_c_pipe(koji_jobs) != 0) return -1;',
    '    if (koji_c_pipe(koji_jobs_done) != 0) return -1;',
    '    for (int i = 0; i < 2; i++) {',
    '        fcntl(koji_jobs[i], 2 /* F_SETFD */, 1 /* FD_CLOEXEC */);',
    '        fcntl(koji_jobs_done[i], 2 /* F_SETFD */, 1 /* FD_CLOEXEC */);',
    '    }',
    '    fcntl(koji_jobs_done[0], 4 /* F_SETFL */, fcntl(koji_jobs_done[0], 3 /* F_GETFL */) | KOJI_O_NONBLOCK);',
    '    return koji_jobs_done[0];',
    '}',
    '/* One more helping thread: whether the system made it. */',
    'bool koji_helpers_add(void) {',
    '    uintptr_t thread;',
    '    if (pthread_create(&thread, NULL, koji_helper, NULL) != 0) return false;',
    '    pthread_detach(thread);',
    '    return true;',
    '}',
    'void koji_helpers_submit(const void *job) {',
    '    while (write(koji_jobs[1], &job, sizeof job) < 0 && errno == EINTR) {}',
    '}',
    '/* The jobs done (their addresses at `out`, at most `capacity`), without waiting: how many. */',
    'int64_t koji_helpers_finished(const void *out, int64_t capacity) {',
    '    long got = read(koji_jobs_done[0], (void *)out, (size_t)capacity * sizeof(KojiJob *));',
    '    return got <= 0 ? 0 : got / (long)sizeof(KojiJob *);',
    '}',
    '#endif',
    '',
    '/* Preemption: a task that runs long without waiting lets the others run. The generated code checks',
    '   `koji_preempt_flag` at the end of each turn of a loop and where a function that calls others',
    '   starts (cgen.kj); a thread of the library sets it every 10 ms while several tasks are alive, and',
    '   koji_task_preempt (std/koji/task.kj) then runs the tasks that are ready. */',
    'extern volatile int koji_preempt_flag;',
    'void koji_task_preempt(void);',
    '#define KOJI_PREEMPT()                                                                             \\',
    '    do {                                                                                           \\',
    '        if (__builtin_expect(koji_preempt_flag, 0)) koji_task_preempt();                           \\',
    '    } while (0)',
    '#if defined(KOJI_LIBRARY)',
    'volatile int koji_preempt_flag = 0;',
    'static volatile int koji_ticking = 0;',
    'static int koji_tick_pipe[2] = { -1, -1 };',
    'static void *koji_ticker(void *unused) {',
    '    (void)unused;',
    '    for (;;) {',
    '        /* Stopped: it waits for a byte of the pipe. */',
    '        if (!koji_ticking) {',
    '            char resumed;',
    '            if (read(koji_tick_pipe[0], &resumed, 1) < 0 && errno != EINTR) return NULL;',
    '            continue;',
    '        }',
    '        struct koji_timespec slice = { 0, 10000000 };',
    '        koji_nanosleep(&slice, NULL);',
    '        if (koji_ticking) koji_preempt_flag = 1;',
    '    }',
    '}',
    '/* Starts or stops the ticks: whether the system could start them. */',
    'bool koji_ticks(bool on) {',
    '    if (koji_tick_pipe[0] < 0) {',
    '        if (!on) return true;',
    '        if (koji_c_pipe(koji_tick_pipe) != 0) return false;',
    '        fcntl(koji_tick_pipe[0], 2 /* F_SETFD */, 1 /* FD_CLOEXEC */);',
    '        fcntl(koji_tick_pipe[1], 2 /* F_SETFD */, 1 /* FD_CLOEXEC */);',
    '        koji_ticking = 1;',
    '        uintptr_t thread;',
    '        if (pthread_create(&thread, NULL, koji_ticker, NULL) != 0) return false;',
    '        pthread_detach(thread);',
    '        return true;',
    '    }',
    '    if (on && !koji_ticking) {',
    '        char resume = 1;',
    '        koji_ticking = 1;',
    '        while (write(koji_tick_pipe[1], &resume, 1) < 0 && errno == EINTR) {}',
    '    }',
    '    if (!on) koji_ticking = 0;',
    '    return true;',
    '}',
    '#endif',
    '/* Clears the flag (koji_task_preempt). */',
    'KOJI_INLINE void koji_preempt_clear(void) { koji_preempt_flag = 0; }',
    '',
    '/* The calls that block, as jobs. By other names than the C library\'s, which the `extern`',
    '   declarations of the standard library use (with other types). */',
    '#if defined(__APPLE__) && defined(__x86_64__)',
    '#define KOJI_DIRECTORY_SYMBOL(name) __asm__("_" #name "$INODE64")',
    '#else',
    '#define KOJI_DIRECTORY_SYMBOL(name) __asm__(KOJI_SYMBOL(name))',
    '#endif',
    'long koji_c_getline(char **line, size_t *capacity, void *stream) __asm__(KOJI_SYMBOL(getline));',
    'size_t koji_c_fread(void *target, size_t size, size_t count, void *stream) __asm__(KOJI_SYMBOL(fread));',
    'int koji_c_waitpid(int pid, int *status, int options) __asm__(KOJI_SYMBOL(waitpid));',
    'int koji_c_poll(void *fds, size_t count, int timeout) __asm__(KOJI_SYMBOL(poll));',
    'void *koji_c_fopen(const char *path, const char *mode) __asm__(KOJI_SYMBOL(fopen));',
    'long koji_c_readv(int fd, const void *vectors, int count) __asm__(KOJI_SYMBOL(readv));',
    'long koji_c_writev(int fd, const void *vectors, int count) __asm__(KOJI_SYMBOL(writev));',
    'void *koji_c_opendir(const char *path) KOJI_DIRECTORY_SYMBOL(opendir);',
    'void *koji_c_readdir(void *directory) KOJI_DIRECTORY_SYMBOL(readdir);',
    'int koji_c_access(const char *path, int mode) __asm__(KOJI_SYMBOL(access));',
    'int koji_c_unlink(const char *path) __asm__(KOJI_SYMBOL(unlink));',
    'int koji_c_mkdir(const char *path, int mode) __asm__(KOJI_SYMBOL(mkdir));',
    '/* Whether a write to `fd` would not wait (poll: POLLOUT at once). */',
    'struct koji_pollfd {',
    '    int fd;',
    '    short events, revents;',
    '};',
    'KOJI_INLINE bool koji_output_ready(int64_t fd) {',
    '    struct koji_pollfd ready = { (int)fd, 4 /* POLLOUT */, 0 };',
    '    return koji_c_poll(&ready, 1, 0) == 1 && (ready.revents & 4) != 0;',
    '}',
    '',
    '/* The bits of a double in a word of a job, and back (the `blocking` functions of foreign blocks). */',
    'KOJI_INLINE int64_t koji_double_bits(double value) {',
    '    int64_t bits;',
    '    __builtin_memcpy(&bits, &value, sizeof bits);',
    '    return bits;',
    '}',
    'KOJI_INLINE double koji_bits_double(int64_t bits) {',
    '    double value;',
    '    __builtin_memcpy(&value, &bits, sizeof value);',
    '    return value;',
    '}',
    '#define KOJI_A(i) (job->arguments[i])',
    '#define KOJI_P(i) ((void *)(intptr_t)job->arguments[i])',
    '#define KOJI_JOB(...) KojiJob job = { NULL, { __VA_ARGS__ }, 0, 0, 0, 0 }',
    'static __attribute__((unused)) void koji_run_getline(KojiJob *job) { job->result = koji_c_getline((char **)KOJI_P(0), (size_t *)KOJI_P(1), KOJI_P(2)); }',
    'static __attribute__((unused)) void koji_run_fread(KojiJob *job) { job->result = (int64_t)koji_c_fread(KOJI_P(0), (size_t)KOJI_A(1), (size_t)KOJI_A(2), KOJI_P(3)); }',
    'static __attribute__((unused)) void koji_run_waitpid(KojiJob *job) { job->result = koji_c_waitpid((int)KOJI_A(0), (int *)KOJI_P(1), (int)KOJI_A(2)); }',
    'static __attribute__((unused)) void koji_run_poll(KojiJob *job) { job->result = koji_c_poll(KOJI_P(0), (size_t)KOJI_A(1), (int)KOJI_A(2)); }',
    'static __attribute__((unused)) void koji_run_fopen(KojiJob *job) { job->result = (int64_t)(intptr_t)koji_c_fopen((const char *)KOJI_P(0), (const char *)KOJI_P(1)); }',
    'static __attribute__((unused)) void koji_run_readv(KojiJob *job) { job->result = koji_c_readv((int)KOJI_A(0), KOJI_P(1), (int)KOJI_A(2)); }',
    'static __attribute__((unused)) void koji_run_writev(KojiJob *job) { job->result = koji_c_writev((int)KOJI_A(0), KOJI_P(1), (int)KOJI_A(2)); }',
    'static __attribute__((unused)) void koji_run_opendir(KojiJob *job) { job->result = (int64_t)(intptr_t)koji_c_opendir((const char *)KOJI_P(0)); }',
    'static __attribute__((unused)) void koji_run_readdir(KojiJob *job) { job->result = (int64_t)(intptr_t)koji_c_readdir(KOJI_P(0)); }',
    'static __attribute__((unused)) void koji_run_access(KojiJob *job) { job->result = koji_c_access((const char *)KOJI_P(0), (int)KOJI_A(1)); }',
    'static __attribute__((unused)) void koji_run_unlink(KojiJob *job) { job->result = koji_c_unlink((const char *)KOJI_P(0)); }',
    'static __attribute__((unused)) void koji_run_mkdir(KojiJob *job) { job->result = koji_c_mkdir((const char *)KOJI_P(0), (int)KOJI_A(1)); }',
    'KOJI_INLINE int64_t koji_blocking_getline(const void *line, const void *capacity, const void *stream) {',
    '    KOJI_JOB((int64_t)(intptr_t)line, (int64_t)(intptr_t)capacity, (int64_t)(intptr_t)stream);',
    '    job.run = koji_run_getline;',
    '    return koji_task_blocking(&job);',
    '}',
    'KOJI_INLINE size_t koji_blocking_fread(const void *target, size_t size, size_t count, const void *stream) {',
    '    KOJI_JOB((int64_t)(intptr_t)target, (int64_t)size, (int64_t)count, (int64_t)(intptr_t)stream);',
    '    job.run = koji_run_fread;',
    '    return (size_t)koji_task_blocking(&job);',
    '}',
    'KOJI_INLINE int koji_blocking_waitpid(int pid, const void *status, int options) {',
    '    KOJI_JOB(pid, (int64_t)(intptr_t)status, options);',
    '    job.run = koji_run_waitpid;',
    '    return (int)koji_task_blocking(&job);',
    '}',
    'KOJI_INLINE int koji_blocking_poll(const void *fds, size_t count, int timeout) {',
    '    KOJI_JOB((int64_t)(intptr_t)fds, (int64_t)count, timeout);',
    '    job.run = koji_run_poll;',
    '    return (int)koji_task_blocking(&job);',
    '}',
    'KOJI_INLINE void *koji_blocking_fopen(const void *path, const void *mode) {',
    '    KOJI_JOB((int64_t)(intptr_t)path, (int64_t)(intptr_t)mode);',
    '    job.run = koji_run_fopen;',
    '    return (void *)(intptr_t)koji_task_blocking(&job);',
    '}',
    'KOJI_INLINE int64_t koji_blocking_readv(int fd, const void *vectors, int count) {',
    '    KOJI_JOB(fd, (int64_t)(intptr_t)vectors, count);',
    '    job.run = koji_run_readv;',
    '    return koji_task_blocking(&job);',
    '}',
    'KOJI_INLINE int64_t koji_blocking_writev(int fd, const void *vectors, int count) {',
    '    KOJI_JOB(fd, (int64_t)(intptr_t)vectors, count);',
    '    job.run = koji_run_writev;',
    '    return koji_task_blocking(&job);',
    '}',
    'KOJI_INLINE void *koji_blocking_opendir(const void *path) {',
    '    KOJI_JOB((int64_t)(intptr_t)path);',
    '    job.run = koji_run_opendir;',
    '    return (void *)(intptr_t)koji_task_blocking(&job);',
    '}',
    'KOJI_INLINE void *koji_blocking_readdir(const void *directory) {',
    '    KOJI_JOB((int64_t)(intptr_t)directory);',
    '    job.run = koji_run_readdir;',
    '    return (void *)(intptr_t)koji_task_blocking(&job);',
    '}',
    'KOJI_INLINE int koji_blocking_access(const void *path, int mode) {',
    '    KOJI_JOB((int64_t)(intptr_t)path, mode);',
    '    job.run = koji_run_access;',
    '    return (int)koji_task_blocking(&job);',
    '}',
    'KOJI_INLINE int koji_blocking_unlink(const void *path) {',
    '    KOJI_JOB((int64_t)(intptr_t)path);',
    '    job.run = koji_run_unlink;',
    '    return (int)koji_task_blocking(&job);',
    '}',
    'KOJI_INLINE int koji_blocking_mkdir(const void *path, int mode) {',
    '    KOJI_JOB((int64_t)(intptr_t)path, mode);',
    '    job.run = koji_run_mkdir;',
    '    return (int)koji_task_blocking(&job);',
    '}',
    '',
    '/* Networking: std/koji/net.kj. */',
    '/* The instructions of AES and GHASH that koji:unsafe gives the library (koji:aes): AES-NI and',
    '   PCLMULQDQ on x86-64, the cryptographic extension of ARMv8 on arm64 (a round of aesenc is',
    '   aesmc(aese(state, 0)) ^ key there). Other processors, and those without the instructions, have',
    '   koji_aes_available() false and never call them. Functions of their own, once in the library: they',
    '   need instructions that the code around them may not have. */',
    'KojiU128 koji_unsafe_aes_round(KojiU128 state, KojiU128 key);',
    'KojiU128 koji_unsafe_aes_last_round(KojiU128 state, KojiU128 key);',
    'KojiU128 koji_unsafe_carryless_product(int64_t a, int64_t b);',
    'KOJI_INLINE int64_t koji_unsafe_reverse_bytes(int64_t word) { return (int64_t)__builtin_bswap64((uint64_t)word); }',
    '#if defined(KOJI_LIBRARY) && defined(__x86_64__)',
    'typedef long long koji_v2i __attribute__((vector_size(16)));',
    '#define KOJI_AES __attribute__((target("aes,pclmul")))',
    'KOJI_AES static inline koji_v2i koji_vector(KojiU128 value) { koji_v2i v; __builtin_memcpy(&v, &value, 16); return v; }',
    'KOJI_AES static inline KojiU128 koji_wide_of(koji_v2i v) { KojiU128 value; __builtin_memcpy(&value, &v, 16); return value; }',
    'KOJI_AES KojiU128 koji_unsafe_aes_round(KojiU128 state, KojiU128 key) { return koji_wide_of(__builtin_ia32_aesenc128(koji_vector(state), koji_vector(key))); }',
    'KOJI_AES KojiU128 koji_unsafe_aes_last_round(KojiU128 state, KojiU128 key) { return koji_wide_of(__builtin_ia32_aesenclast128(koji_vector(state), koji_vector(key))); }',
    'KOJI_AES KojiU128 koji_unsafe_carryless_product(int64_t a, int64_t b) {',
    '    return koji_wide_of(__builtin_ia32_pclmulqdq128((koji_v2i){a, 0}, (koji_v2i){b, 0}, 0));',
    '}',
    '#elif defined(KOJI_LIBRARY) && defined(__aarch64__)',
    '#include <arm_neon.h>',
    '#if defined(__APPLE__)',
    '/* Every processor of Apple on arm64 has the instructions: the target has them. */',
    '#define KOJI_AES',
    '#elif defined(__clang__)',
    '#define KOJI_AES __attribute__((target("aes")))',
    '#else',
    '#define KOJI_AES __attribute__((target("+crypto")))',
    '#endif',
    'KOJI_AES static inline uint8x16_t koji_vector(KojiU128 value) { uint8x16_t v; __builtin_memcpy(&v, &value, 16); return v; }',
    'KOJI_AES static inline KojiU128 koji_wide_of(uint8x16_t v) { KojiU128 value; __builtin_memcpy(&value, &v, 16); return value; }',
    'KOJI_AES KojiU128 koji_unsafe_aes_round(KojiU128 state, KojiU128 key) {',
    '    return koji_wide_of(veorq_u8(vaesmcq_u8(vaeseq_u8(koji_vector(state), vdupq_n_u8(0))), koji_vector(key)));',
    '}',
    'KOJI_AES KojiU128 koji_unsafe_aes_last_round(KojiU128 state, KojiU128 key) {',
    '    return koji_wide_of(veorq_u8(vaeseq_u8(koji_vector(state), vdupq_n_u8(0)), koji_vector(key)));',
    '}',
    'KOJI_AES KojiU128 koji_unsafe_carryless_product(int64_t a, int64_t b) {',
    '    poly128_t product = vmull_p64((poly64_t)a, (poly64_t)b);',
    '    KojiU128 value;',
    '    __builtin_memcpy(&value, &product, 16);',
    '    return value;',
    '}',
    '#elif defined(KOJI_LIBRARY)',
    'KojiU128 koji_unsafe_aes_round(KojiU128 state, KojiU128 key) { (void)key; return state; }',
    'KojiU128 koji_unsafe_aes_last_round(KojiU128 state, KojiU128 key) { (void)key; return state; }',
    'KojiU128 koji_unsafe_carryless_product(int64_t a, int64_t b) { (void)b; return (KojiU128)(uint64_t)a; }',
    '#endif',
    '',
    '/* Whether the processor has the instructions (and the system lets them run). */',
    'KOJI_INLINE bool koji_aes_available(void) {',
    '#if defined(__x86_64__)',
    '    unsigned int a = 1, b, c = 0, d;',
    '    __asm__("cpuid" : "+a"(a), "=b"(b), "+c"(c), "=d"(d));',
    '    return (c >> 25 & 1) && (c >> 1 & 1) && (c >> 9 & 1);',
    '#elif defined(__aarch64__) && defined(__APPLE__)',
    '    return true;',
    '#elif defined(__aarch64__) && defined(__linux__)',
    '    extern unsigned long getauxval(unsigned long);',
    '    return (getauxval(16) & 0x18) == 0x18;',
    '#elif defined(__aarch64__) && defined(__FreeBSD__)',
    '    extern int elf_aux_info(int, void *, int);',
    '    unsigned long hwcap = 0;',
    '    return elf_aux_info(25, &hwcap, sizeof hwcap) == 0 && (hwcap & 0x18) == 0x18;',
    '#else',
    '    return false;',
    '#endif',
    '}',
    '',
    '/* `kojic test`: the number of the test to run, the last argument of the executable (taken from the',
    '   arguments the program sees), or -1. Weak: one for the program and the library. */',
    '__attribute__((weak)) int64_t koji_test_selected = -1;',
    'KOJI_INLINE int64_t koji_test_argument(int *count, char **values) {',
    '    if (*count < 2) return -1;',
    '    int64_t number = 0;',
    '    for (const char *c = values[*count - 1]; *c >= \'0\' && *c <= \'9\'; c++) number = number * 10 + (*c - \'0\');',
    '    *count -= 1;',
    '    return number;',
    '}',
    'KOJI_INLINE int64_t koji_test_index(void) { return koji_test_selected; }',
    '',
    '/* The start of a program (std/koji/start.kj): the pool, the arguments, then the library. */',
    'void koji_init(int argc, const void *argv);',
    '',
    '/* The environment of the process, for std/system.kj (a variable of C). */',
    'extern char **environ;',
    'KOJI_INLINE void *koji_system_environment(void) { return (void *)environ; }',
    '',
    '/* The standard library: `panic` (std/koji/output.kj), `int(f)` (std/koji/numbers.kj), the methods',
    '   of strings (std/koji/text.kj). */',
    '_Noreturn void koji_std_panic(const KojiString *message, const char *location);',
    '_Noreturn void koji_std_assert(const KojiString *condition, const KojiString *message, const KojiString *details, const char *location);',
    'int64_t koji_std_float_to_int(double value, const char *location);',
    'KojiString *koji_std_string_upper(const KojiString *string);',
    'KojiString *koji_std_string_lower(const KojiString *string);',
    'bool koji_std_string_is(const KojiString *string, int32_t test);',
    '',
    'uint32_t koji_std_string_char_at(const KojiString *string, int64_t index, const char *location);',
    'KojiString *koji_std_string_slice(const KojiString *string, bool has_start, int64_t start, bool has_end, int64_t end,',
    '                                  const char *location);',
    '',
    '',
    '/* Output and panics (std/koji/output.kj), and the powers of numbers (std/koji/numbers.kj). */',
    '_Noreturn void koji_fail(const char *location, const KojiString *message);',
    'void koji_print(const KojiString *text, const char *location);',
    'void koji_print_error(const KojiString *text, const char *location);',
    '_Noreturn void koji_panic(const char *location, const void *message);',
    '_Noreturn void koji_panic_shift(const char *location, int64_t amount);',
    'int64_t koji_int_pow(int64_t base, int64_t exponent, const char *location);',
    'double koji_float_pow(double base, double exponent, const char *location);',
    '',
    'KojiDecimal koji_decimal_add(KojiDecimal a, KojiDecimal b, const char *location);',
    'KojiDecimal koji_decimal_sub(KojiDecimal a, KojiDecimal b, const char *location);',
    'KojiDecimal koji_decimal_mul(KojiDecimal a, KojiDecimal b, const char *location);',
    'KojiDecimal koji_decimal_div(KojiDecimal a, KojiDecimal b, const char *location);',
    'KojiDecimal koji_decimal_rem(KojiDecimal a, KojiDecimal b, const char *location);',
    'KojiDecimal koji_decimal_pow(KojiDecimal base, int64_t exponent, const char *location);',
    'KojiDecimal koji_decimal_power(KojiDecimal base, KojiDecimal exponent, const char *location);',
    'KojiDecimal koji_decimal_neg(KojiDecimal value);',
    'int32_t koji_decimal_compare(KojiDecimal a, KojiDecimal b);',
    'int64_t koji_decimal_hash(KojiDecimal value);',
    'KojiDecimal koji_decimal_from_int(int64_t value);',
    'KojiDecimal koji_decimal_from_float(double value);',
    'double koji_decimal_to_float(KojiDecimal value, const char *location);',
    'int64_t koji_decimal_to_int(KojiDecimal value, int32_t mode, const char *location);',
    'KojiDecimal koji_decimal_abs(KojiDecimal value);',
    'KojiDecimal koji_decimal_sqrt(KojiDecimal value);',
    '',
    '/* A decimal constant: coefficient = high * 10^17 + low, with the exponent the compiler chose. */',
    'KOJI_INLINE KojiDecimal koji_decimal_literal(bool negative, int64_t high, int64_t low, int32_t exponent) {',
    '    unsigned __int128 coefficient = (unsigned __int128)high * UINT64_C(100000000000000000) + (uint64_t)low;',
    '    KojiDecimal value = { (uint64_t)coefficient,',
    '                          (uint64_t)(coefficient >> 64) | (uint64_t)(exponent + 6176) << 49 | (uint64_t)negative << 63 };',
    '    return value;',
    '}',
    '',
    '/* `a + b`: in C when both have the same exponent and sign and the sum keeps 34 digits (amounts',
    '   of money, measures), otherwise in the runtime. */',
    'KOJI_INLINE KojiDecimal koji_decimal_plus(KojiDecimal a, KojiDecimal b, const char *location) {',
    '    const uint64_t mask = (UINT64_C(1) << 49) - 1;',
    '    if ((a.hi & ~mask) == (b.hi & ~mask)) {',
    '        unsigned __int128 x = (unsigned __int128)(a.hi & mask) << 64 | a.lo;',
    '        unsigned __int128 y = (unsigned __int128)(b.hi & mask) << 64 | b.lo;',
    '        unsigned __int128 sum = x + y;',
    '        const unsigned __int128 limit = (unsigned __int128)UINT64_C(10000000000000000) * UINT64_C(1000000000000000000);',
    '        if (sum < limit) {',
    '            KojiDecimal value = { (uint64_t)sum, (a.hi & ~mask) | (uint64_t)(sum >> 64) };',
    '            return value;',
    '        }',
    '    }',
    '    return koji_decimal_add(a, b, location);',
    '}',
    '',
    '/* Writes a string variable: the new value is already owned, the old one is released. */',
    'KOJI_INLINE void koji_string_set(KojiString **variable, KojiString *value) {',
    '    KojiString *old = *variable;',
    '    *variable = value;',
    '    koji_string_release(old);',
    '}',
    '',
    '/* A new reference to a string that is still owned elsewhere. */',
    'KOJI_INLINE KojiString *koji_string_share(KojiString *string) {',
    '    koji_string_retain(string);',
    '    return string;',
    '}',
    '',
    'KOJI_INLINE void koji_list_set_variable(KojiList **variable, KojiList *value) {',
    '    KojiList *old = *variable;',
    '    *variable = value;',
    '    koji_list_release(old);',
    '}',
    '',
    'KOJI_INLINE KojiList *koji_list_share(KojiList *list) {',
    '    koji_list_retain(list);',
    '    return list;',
    '}',
    '',
    'KOJI_INLINE void koji_record_set_variable(KojiRecord **variable, KojiRecord *value) {',
    '    KojiRecord *old = *variable;',
    '    *variable = value;',
    '    koji_record_release(old);',
    '}',
    '',
    'KOJI_INLINE KojiRecord *koji_record_share(KojiRecord *record) {',
    '    koji_record_retain(record);',
    '    return record;',
    '}',
    '',
    'KOJI_INLINE void koji_map_set_variable(KojiMap **variable, KojiMap *value) {',
    '    KojiMap *old = *variable;',
    '    *variable = value;',
    '    koji_map_release(old);',
    '}',
    '',
    'KOJI_INLINE KojiMap *koji_map_share(KojiMap *map) {',
    '    koji_map_retain(map);',
    '    return map;',
    '}',
    '',
    'KOJI_INLINE void koji_closure_set_variable(KojiClosure **variable, KojiClosure *value) {',
    '    KojiClosure *old = *variable;',
    '    *variable = value;',
    '    koji_closure_release(old);',
    '}',
    '',
    'KOJI_INLINE KojiClosure *koji_closure_share(KojiClosure *closure) {',
    '    koji_closure_retain(closure);',
    '    return closure;',
    '}',
    '',
    '/* The items of lists and the fields of records, by type. */',
    '',
    'static int32_t koji_order(bool less, bool greater) { return less ? -1 : greater ? 1 : 0; }',
    '',
    'static KojiString *koji_repr_int(const void *slot) { return koji_string_from_int(*(const int64_t *)slot); }',
    'static bool koji_equal_int(const void *a, const void *b) { return *(const int64_t *)a == *(const int64_t *)b; }',
    'static int32_t koji_compare_int(const void *a, const void *b) {',
    '    int64_t x = *(const int64_t *)a, y = *(const int64_t *)b;',
    '    return koji_order(x < y, x > y);',
    '}',
    'static uint64_t koji_hash_int(const void *slot) { return (uint64_t)*(const int64_t *)slot; }',
    'KOJI_SHARED const KojiElementType koji_element_int = {',
    '    sizeof(int64_t), NULL, NULL, koji_repr_int, koji_equal_int, koji_compare_int, koji_hash_int, NULL};',
    '',
    'static KojiString *koji_repr_float(const void *slot) { return koji_string_from_float(*(const double *)slot); }',
    'static bool koji_equal_float(const void *a, const void *b) { return *(const double *)a == *(const double *)b; }',
    'static int32_t koji_compare_float(const void *a, const void *b) {',
    '    double x = *(const double *)a, y = *(const double *)b;',
    '    return koji_order(x < y, x > y);',
    '}',
    'static uint64_t koji_hash_float(const void *slot) {',
    '    double value = *(const double *)slot;',
    '    uint64_t bits = 0;',
    '    if (value != 0.0) __builtin_memcpy(&bits, &value, sizeof bits); /* 0.0 and -0.0 are equal */',
    '    return bits;',
    '}',
    'KOJI_SHARED const KojiElementType koji_element_float = {',
    '    sizeof(double), NULL, NULL, koji_repr_float, koji_equal_float, koji_compare_float, koji_hash_float, NULL};',
    '',
    'static KojiString *koji_repr_decimal(const void *slot) { return koji_string_from_decimal(*(const KojiDecimal *)slot); }',
    'static bool koji_equal_decimal(const void *a, const void *b) {',
    '    return koji_decimal_compare(*(const KojiDecimal *)a, *(const KojiDecimal *)b) == 0;',
    '}',
    'static int32_t koji_compare_decimal(const void *a, const void *b) {',
    '    return koji_decimal_compare(*(const KojiDecimal *)a, *(const KojiDecimal *)b);',
    '}',
    'static uint64_t koji_hash_decimal(const void *slot) { return (uint64_t)koji_decimal_hash(*(const KojiDecimal *)slot); }',
    'KOJI_SHARED const KojiElementType koji_element_decimal = {',
    '    sizeof(KojiDecimal), NULL, NULL, koji_repr_decimal, koji_equal_decimal, koji_compare_decimal, koji_hash_decimal, NULL};',
    '',
    'KOJI_SHARED KojiString *koji_u128_to_string(KojiU128 value) {',
    '    char digits[40];',
    '    int at = 40;',
    '    do {',
    '        digits[--at] = (char)(\'0\' + (int)(value % 10));',
    '        value /= 10;',
    '    } while (value != 0);',
    '    return koji_string_new(digits + at, (size_t)(40 - at));',
    '}',
    'static KojiString *koji_repr_u128(const void *slot) { KojiU128 value; __builtin_memcpy(&value, slot, 16); return koji_u128_to_string(value); }',
    'static bool koji_equal_u128(const void *a, const void *b) { return __builtin_memcmp(a, b, 16) == 0; }',
    'static int32_t koji_compare_u128(const void *a, const void *b) {',
    '    KojiU128 x, y;',
    '    __builtin_memcpy(&x, a, 16);',
    '    __builtin_memcpy(&y, b, 16);',
    '    return x < y ? -1 : x > y;',
    '}',
    'static uint64_t koji_hash_u128(const void *slot) {',
    '    uint64_t words[2];',
    '    __builtin_memcpy(words, slot, 16);',
    '    return words[0] * 0x9E3779B97F4A7C15u ^ words[1];',
    '}',
    'KOJI_SHARED const KojiElementType koji_element_u128 = {',
    '    sizeof(KojiU128), NULL, NULL, koji_repr_u128, koji_equal_u128, koji_compare_u128, koji_hash_u128, NULL};',
    '',
    'static KojiString *koji_repr_bool(const void *slot) { return koji_string_from_bool(*(const bool *)slot); }',
    'static bool koji_equal_bool(const void *a, const void *b) { return *(const bool *)a == *(const bool *)b; }',
    '/* Booleans compare as equal: a sort keeps their order. */',
    'static int32_t koji_compare_bool(const void *a, const void *b) { (void)a; (void)b; return 0; }',
    'static uint64_t koji_hash_bool(const void *slot) { return *(const bool *)slot; }',
    'KOJI_SHARED const KojiElementType koji_element_bool = {',
    '    sizeof(bool), NULL, NULL, koji_repr_bool, koji_equal_bool, koji_compare_bool, koji_hash_bool, NULL};',
    '',
    'static KojiString *koji_repr_char(const void *slot) { return koji_char_repr(*(const uint32_t *)slot); }',
    'static bool koji_equal_char(const void *a, const void *b) { return *(const uint32_t *)a == *(const uint32_t *)b; }',
    'static int32_t koji_compare_char(const void *a, const void *b) {',
    '    uint32_t x = *(const uint32_t *)a, y = *(const uint32_t *)b;',
    '    return koji_order(x < y, x > y);',
    '}',
    'static uint64_t koji_hash_char(const void *slot) { return *(const uint32_t *)slot; }',
    'static KojiString *koji_display_char(const void *slot) { return koji_string_from_char(*(const uint32_t *)slot); }',
    'KOJI_SHARED const KojiElementType koji_element_char = {',
    '    sizeof(uint32_t), NULL, NULL, koji_repr_char, koji_equal_char, koji_compare_char, koji_hash_char,',
    '    koji_display_char};',
    '',
    'static KojiString *koji_repr_byte(const void *slot) { return koji_string_from_int(*(const uint8_t *)slot); }',
    'static bool koji_equal_byte(const void *a, const void *b) { return *(const uint8_t *)a == *(const uint8_t *)b; }',
    'static int32_t koji_compare_byte(const void *a, const void *b) {',
    '    uint8_t x = *(const uint8_t *)a, y = *(const uint8_t *)b;',
    '    return koji_order(x < y, x > y);',
    '}',
    'static uint64_t koji_hash_byte(const void *slot) { return *(const uint8_t *)slot; }',
    'KOJI_SHARED const KojiElementType koji_element_byte = {',
    '    sizeof(uint8_t), NULL, NULL, koji_repr_byte, koji_equal_byte, koji_compare_byte, koji_hash_byte, NULL};',
    '',
    'static void koji_retain_string(const void *slot) { koji_string_retain(*(KojiString *const *)slot); }',
    'static void koji_release_string(const void *slot) { koji_string_release(*(KojiString *const *)slot); }',
    'static KojiString *koji_repr_string(const void *slot) { return koji_string_repr(*(KojiString *const *)slot); }',
    'static bool koji_equal_string(const void *a, const void *b) {',
    '    return koji_string_equal(*(KojiString *const *)a, *(KojiString *const *)b);',
    '}',
    'static int32_t koji_compare_string(const void *a, const void *b) {',
    '    return koji_string_compare(*(KojiString *const *)a, *(KojiString *const *)b);',
    '}',
    'static uint64_t koji_hash_string(const void *slot) { return koji_string_hash(*(KojiString *const *)slot); }',
    'static KojiString *koji_display_string(const void *slot) { return koji_string_share(*(KojiString *const *)slot); }',
    'KOJI_SHARED const KojiElementType koji_element_string = {',
    '    sizeof(KojiString *), koji_retain_string, koji_release_string, koji_repr_string,',
