// The start of every C file the compiler generates: the lines of runtime/prelude.h, the
// declarations of the runtime. Generated: test/stages.rs checks that it is up to date, and
// rewrites it when run with KOJI_UPDATE_PRELUDE=1.

export immut preludeLines = [
    '/* The start of every C file generated by kojic: the runtime functions (implemented in Rust,',
    '   in the koji_runtime library) and the operators that panic. */',
    '',
    '#include <math.h>',
    '#include <stdbool.h>',
    '#include <stddef.h>',
    '#include <stdint.h>',
    '',
    '/* The small functions below are inlined where they are called. Left to its heuristics, gcc spends',
    '   most of its time (20 minutes for the compiler) weighing them in the large functions kojic',
    '   generates. */',
    '#define KOJI_INLINE static inline __attribute__((always_inline))',
    '',
    'typedef struct KojiString KojiString;',
    '',
    '/* A decimal (runtime/src/decimal.rs): 34 significant digits in two words, passed in registers.',
    '   `lo` is the low 64 bits of the coefficient; `hi` has its 49 high bits, then the exponent plus',
    '   6176 (14 bits), then the sign. It is not normalized: 1.50 may be 150e-2, so equality and',
    '   hashing go through the runtime. Zero is all zero bits. */',
    'typedef struct {',
    '    uint64_t lo, hi;',
    '} KojiDecimal;',
    '',
    '/* `U128` of `koji:unsafe`: in records and lists, on 8-byte words like a decimal. */',
    'typedef unsigned __int128 KojiU128 __attribute__((aligned(8)));',
    '',
    '/* A string (runtime/src/string.rs): its UTF-8 bytes follow it, in the same allocation. Its',
    '   references are counted here, inline. */',
    'struct KojiString {',
    '    size_t references;',
    '    size_t length;',
    '    size_t capacity;',
    '    char bytes[];',
    '};',
    '',
    'KojiString *koji_string_new(const char *bytes, size_t length);',
    'void koji_string_free(KojiString *string);',
    '',
    'KOJI_INLINE void koji_string_retain(const KojiString *string) {',
    '    if (string) ((KojiString *)string)->references++;',
    '}',
    '',
    '/* At the last reference, the runtime frees the string. NULL is ignored. */',
    'KOJI_INLINE void koji_string_release(KojiString *string) {',
    '    if (string && --string->references == 0) koji_string_free(string);',
    '}',
    'KojiString *koji_string_concat(const KojiString *a, const KojiString *b);',
    '/* `a + b`, taking the reference to `a`: adds to it in place when no one else sees it. */',
    'KojiString *koji_string_append(KojiString *a, const KojiString *b);',
    'KojiString *koji_string_append_char(KojiString *a, uint32_t code);',
    'KojiString *koji_string_repeat(const KojiString *string, int64_t count);',
    'bool koji_string_equal(const KojiString *a, const KojiString *b);',
    'int32_t koji_string_compare(const KojiString *a, const KojiString *b);',
    'KojiString *koji_string_from_int(int64_t value);',
    'KojiString *koji_string_from_float(double value);',
    'KojiString *koji_string_from_decimal(KojiDecimal value);',
    'KojiString *koji_string_from_bool(bool value);',
    '',
    'KojiString *koji_string_repr(const KojiString *string);',
    'KojiString *koji_string_from_char(uint32_t code);',
    'KojiString *koji_char_repr(uint32_t code);',
    'bool koji_string_contains_char(const KojiString *haystack, uint32_t code);',
    'int64_t koji_string_length(const KojiString *string);',
    'bool koji_string_contains(const KojiString *haystack, const KojiString *needle);',
    '',
    'typedef struct KojiList KojiList;',
    '',
    '/* How the generated code describes the items of a list (see runtime/src/list.rs). */',
    'typedef struct {',
    '    size_t size;',
    '    void (*retain)(const void *slot);',
    '    void (*release)(const void *slot);',
    '    KojiString *(*repr)(const void *slot);',
    '    bool (*equal)(const void *a, const void *b);',
    '    int32_t (*compare)(const void *a, const void *b);',
    '    uint64_t (*hash)(const void *slot);',
    '    KojiString *(*display)(const void *slot);',
    '} KojiElementType;',
    '',
    'KOJI_INLINE int64_t koji_element_size(const void *element) { return (int64_t)((const KojiElementType *)element)->size; }',
    '/* Whether its items have references to count (strings, lists, records...). */',
    'KOJI_INLINE bool koji_element_counted(const void *element) { return ((const KojiElementType *)element)->release != NULL; }',
    'KOJI_INLINE void koji_element_retain(const void *element, const void *slot) {',
    '    const KojiElementType *type = (const KojiElementType *)element;',
    '    if (type->retain) type->retain(slot);',
    '}',
    'KOJI_INLINE void koji_element_release(const void *element, const void *slot) {',
    '    const KojiElementType *type = (const KojiElementType *)element;',
    '    if (type->release) type->release(slot);',
    '}',
    'KOJI_INLINE KojiString *koji_element_repr(const void *element, const void *slot) {',
    '    return ((const KojiElementType *)element)->repr(slot);',
    '}',
    'KOJI_INLINE bool koji_element_equal(const void *element, const void *a, const void *b) {',
    '    return ((const KojiElementType *)element)->equal(a, b);',
    '}',
    'KOJI_INLINE bool koji_element_orderable(const void *element) { return ((const KojiElementType *)element)->compare != NULL; }',
    'KOJI_INLINE int koji_element_compare(const void *element, const void *a, const void *b) {',
    '    return ((const KojiElementType *)element)->compare(a, b);',
    '}',
    'KOJI_INLINE int64_t koji_element_hash(const void *element, const void *slot) {',
    '    return (int64_t)((const KojiElementType *)element)->hash(slot);',
    '}',
    '',
    '/* A list (runtime/src/list.rs): `items` holds `length` items of `stride` 8-byte words each. Its',
    '   items, its length and its references are read here, inline; the runtime does the rest. */',
    'struct KojiList {',
    '    size_t references;',
    '    const KojiElementType *element;',
    '    size_t stride;',
    '    uint64_t *items;',
    '    size_t length;',
    '    size_t capacity;',
    '};',
    '',
    'void *koji_list_new(const void *element, size_t capacity);',
    'void koji_list_free(const void *list);',
    '_Noreturn void koji_list_index_panic(int64_t index, int64_t length, const char *location);',
    '',
    'KOJI_INLINE void koji_list_retain(const KojiList *list) {',
    '    if (list) ((KojiList *)list)->references++;',
    '}',
    '',
    '/* At the last reference, the runtime releases the items and frees the list. NULL is ignored. */',
    'KOJI_INLINE void koji_list_release(KojiList *list) {',
    '    if (list && --list->references == 0) koji_list_free(list);',
    '}',
    '',
    'KOJI_INLINE int64_t koji_list_length(const KojiList *list) { return (int64_t)list->length; }',
    '',
    '/* The slot of the item at `index`, to read it. */',
    'KOJI_INLINE const void *koji_list_get(const KojiList *list, int64_t index, const char *location) {',
    '    if ((uint64_t)index >= list->length) koji_list_index_panic(index, (int64_t)list->length, location);',
    '    return &list->items[(size_t)index * list->stride];',
    '}',
    '',
    'void *koji_list_slot(const void *variable, int64_t index, const char *location);',
    'void koji_list_set(const void *variable, int64_t index, const void *value, const char *location);',
    'void koji_list_push(const void *variable, const void *value);',
    'void koji_list_reserve(const void *list, int64_t more);',
    'KOJI_INLINE int64_t koji_unsafe_list_items(const KojiList *list) { return (int64_t)(intptr_t)list->items; }',
    'KOJI_INLINE void koji_unsafe_set_list_length(KojiList *list, int64_t length) { list->length = (size_t)length; }',
    'void koji_list_insert(const void *variable, int64_t index, const void *value, const char *location);',
    'void koji_list_sort(const void *variable);',
    'void *koji_list_concat(const void *a, const void *b);',
    'void *koji_list_slice(const void *list, bool has_start, int64_t start, bool has_end, int64_t end,',
    '                     const char *location);',
    'bool koji_list_equal(const void *a, const void *b);',
    'bool koji_list_contains(const void *list, const void *value);',
    'KojiString *koji_list_repr(const void *list);',
    'KojiString *koji_list_join(const void *list, const KojiString *separator);',
    '',
    'int64_t koji_string_hash(const KojiString *string);',
    'int64_t koji_list_hash(const void *list);',
    '',
    'bool koji_list_pop(const void *variable, const void *out);',
    'bool koji_list_remove(const void *variable, int64_t index, const void *out);',
    'int64_t koji_list_index_of(const void *list, const void *value);',
    '',
    '/* The memory of records and strings (runtime/src/pool.rs): the first free block of each size, in',
    '   8-byte words up to 16, each free block holding the next one. */',
    'extern void *koji_pool[17];',
    '/* With KOJI_POOL=0, every block comes from the system and goes back to it (for valgrind). */',
    'extern bool koji_pool_off;',
    'void *koji_pool_refill(size_t words);',
    'void koji_pool_free(void *block, size_t words);',
    '',
    'KOJI_INLINE void *koji_pool_take(size_t words) {',
    '    void *block = words <= 16 ? koji_pool[words] : NULL;',
    '    if (!block) return koji_pool_refill(words);',
    '    koji_pool[words] = *(void **)block;',
    '    return block;',
    '}',
    '',
    'KOJI_INLINE void koji_pool_give(void *block, size_t words) {',
    '    if (words > 16 || koji_pool_off) {',
    '        koji_pool_free(block, words);',
    '        return;',
    '    }',
    '    *(void **)block = koji_pool[words];',
    '    koji_pool[words] = block;',
    '}',
    '',
    '/* For the library written in Koji (std/koji/list.kj), with the types of its `extern` declarations:',
    '   blocks of the pool, and the functions of the type of items. */',
    'void *koji_pool_resize(const void *block, size_t words, size_t new_words);',
    'KOJI_INLINE void *koji_memory_take(int64_t words) { return koji_pool_take((size_t)words); }',
    'KOJI_INLINE void koji_memory_give(const void *block, int64_t words) { koji_pool_give((void *)block, (size_t)words); }',
    'KOJI_INLINE void *koji_memory_resize(const void *block, int64_t words, int64_t new_words) {',
    '    return koji_pool_resize(block, (size_t)words, (size_t)new_words);',
    '}',
    '',
    '/* `koji:unsafe`, for the standard library: memory of the system, at addresses that the generated',
    '   code keeps as numbers. */',
    'void *malloc(size_t size);',
    'void free(void *pointer);',
    '',
    'KOJI_INLINE int64_t koji_unsafe_allocate(int64_t bytes) { return (int64_t)(intptr_t)malloc((size_t)bytes); }',
    'KOJI_INLINE void koji_unsafe_free(int64_t address) { free((void *)(intptr_t)address); }',
    'KOJI_INLINE int64_t koji_unsafe_offset(int64_t address, int64_t bytes) { return address + bytes; }',
    'KOJI_INLINE int64_t koji_unsafe_distance(int64_t from, int64_t to) { return to - from; }',
    '',
    '/* The prototypes of the `extern` functions have the types of Koji, which may differ from those',
    '   the compiler knows for a function of the C library (`strlen(const void *)`). */',
    '#if defined(__clang__)',
    '#define KOJI_EXTERNS_BEGIN                                                                         \\',
    '    _Pragma("clang diagnostic push") _Pragma("clang diagnostic ignored \\"-Wincompatible-library-redeclaration\\"")',
    '#define KOJI_EXTERNS_END _Pragma("clang diagnostic pop")',
    '#elif defined(__GNUC__)',
    '#define KOJI_EXTERNS_BEGIN                                                                         \\',
    '    _Pragma("GCC diagnostic push") _Pragma("GCC diagnostic ignored \\"-Wbuiltin-declaration-mismatch\\"")',
    '#define KOJI_EXTERNS_END _Pragma("GCC diagnostic pop")',
    '#else',
    '#define KOJI_EXTERNS_BEGIN',
    '#define KOJI_EXTERNS_END',
    '#endif',
    '#if defined(__APPLE__) && defined(__x86_64__)',
    '#define KOJI_INODE64(name) __asm__("_" #name "$INODE64")',
    '#else',
    '#define KOJI_INODE64(name)',
    '#endif',
    '',
    '_Noreturn void koji_panic(const char *location, const void *message);',
    '',
    '/* `U128`: its words, and the words of a decimal. */',
    'KOJI_INLINE KojiU128 koji_unsafe_wide(int64_t low, int64_t high) { return (KojiU128)(uint64_t)high << 64 | (uint64_t)low; }',
    'KOJI_INLINE int64_t koji_unsafe_low_word(KojiU128 value) { return (int64_t)(uint64_t)value; }',
    'KOJI_INLINE double koji_unsafe_wide_to_float(KojiU128 value) { return (double)value; }',
    'KOJI_INLINE KojiU128 koji_unsafe_word_product(KojiU128 a, KojiU128 b) { return (KojiU128)(uint64_t)a * (uint64_t)b; }',
    'KOJI_INLINE int64_t koji_unsafe_high_word(KojiU128 value) { return (int64_t)(uint64_t)(value >> 64); }',
    'KOJI_INLINE int64_t koji_unsafe_leading_zeros(KojiU128 value) {',
    '    uint64_t high = (uint64_t)(value >> 64), low = (uint64_t)value;',
    '    if (high != 0) return __builtin_clzll(high);',
    '    return low != 0 ? 64 + __builtin_clzll(low) : 128;',
    '}',
    'KOJI_INLINE int64_t koji_unsafe_decimal_low(KojiDecimal value) { return (int64_t)value.lo; }',
    'KOJI_INLINE int64_t koji_unsafe_decimal_high(KojiDecimal value) { return (int64_t)value.hi; }',
    'KOJI_INLINE KojiDecimal koji_unsafe_decimal_of(int64_t low, int64_t high) {',
    '    KojiDecimal value = { (uint64_t)low, (uint64_t)high };',
    '    return value;',
    '}',
    '/* A divisor of 64 bits: two instructions `div` on x86-64, a digit of 64 bits each (the generic',
    '   division is a call). */',
    '#if defined(__x86_64__)',
    'KOJI_INLINE uint64_t koji_u128_divide_word(uint64_t high, uint64_t low, uint64_t divisor, uint64_t *rest) {',
    '    uint64_t quotient;',
    '    __asm__("divq %4" : "=a"(quotient), "=d"(*rest) : "a"(low), "d"(high), "rm"(divisor));',
    '    return quotient;',
    '}',
    '#endif',
    'KOJI_INLINE KojiU128 koji_u128_div(KojiU128 a, KojiU128 b, const char *location) {',
    '    if (b == 0) koji_panic(location, "division by zero");',
    '#if defined(__x86_64__)',
    '    /* A constant divisor is the C compiler\'s: it may multiply instead. */',
    '    if (!__builtin_constant_p(b) && (uint64_t)(b >> 64) == 0) {',
    '        uint64_t high = (uint64_t)(a >> 64), divisor = (uint64_t)b, rest;',
    '        if (high < divisor) return koji_u128_divide_word(high, (uint64_t)a, divisor, &rest);',
    '        uint64_t top = high / divisor;',
    '        uint64_t bottom = koji_u128_divide_word(high % divisor, (uint64_t)a, divisor, &rest);',
    '        return (KojiU128)top << 64 | bottom;',
    '    }',
    '#endif',
    '    return a / b;',
    '}',
    'KOJI_INLINE KojiU128 koji_u128_rem(KojiU128 a, KojiU128 b, const char *location) {',
    '    if (b == 0) koji_panic(location, "division by zero");',
    '#if defined(__x86_64__)',
    '    if (!__builtin_constant_p(b) && (uint64_t)(b >> 64) == 0) {',
    '        uint64_t high = (uint64_t)(a >> 64), divisor = (uint64_t)b, rest;',
    '        koji_u128_divide_word(high < divisor ? high : high % divisor, (uint64_t)a, divisor, &rest);',
    '        return rest;',
    '    }',
    '#endif',
    '    return a % b;',
    '}',
    'KOJI_INLINE KojiU128 koji_u128_shift_left(KojiU128 a, KojiU128 b, const char *location) {',
    '    if (b > 127) koji_panic(location, "shift of a U128 out of range (0 to 127)");',
    '    return a << (int)b;',
    '}',
    'KOJI_INLINE KojiU128 koji_u128_shift_right(KojiU128 a, KojiU128 b, const char *location) {',
    '    if (b > 127) koji_panic(location, "shift of a U128 out of range (0 to 127)");',
    '    return a >> (int)b;',
    '}',
    '',
    '/* The bytes of a string, and a new string with a copy of UTF-8 bytes. */',
    'KOJI_INLINE int64_t koji_unsafe_string_bytes(const KojiString *string) { return (int64_t)(intptr_t)string->bytes; }',
    'KOJI_INLINE int64_t koji_unsafe_string_size(const KojiString *string) { return (int64_t)string->length; }',
    'KojiString *koji_string_from_utf8(const char *bytes, size_t length);',
    '/* A new string of `length` bytes to write, in a block of the pool that holds `capacity` (the whole',
    '   last word too), as runtime/src/string.rs makes them. */',
    'KOJI_INLINE KojiString *koji_unsafe_blank_string(int64_t length, int64_t capacity) {',
    '    size_t room = ((size_t)(capacity > length ? capacity : length) + 7) / 8 * 8;',
    '    KojiString *string = (KojiString *)koji_pool_take(3 + room / 8);',
    '    string->references = 1;',
    '    string->length = (size_t)length;',
    '    string->capacity = room;',
    '    return string;',
    '}',
    'KOJI_INLINE int64_t koji_unsafe_string_references(const KojiString *string) { return (int64_t)string->references; }',
    'KOJI_INLINE int64_t koji_unsafe_string_capacity(const KojiString *string) { return (int64_t)string->capacity; }',
    'KOJI_INLINE void koji_unsafe_set_string_size(const KojiString *string, int64_t length) {',
    '    ((KojiString *)string)->length = (size_t)length;',
    '}',
    'KOJI_INLINE KojiString *koji_unsafe_new_string(int64_t address, int64_t length) {',
    '    return koji_string_from_utf8((const char *)(intptr_t)address, (size_t)length);',
    '}',
    '',
    '/* `read` and `write` of each type, at `address + offset`: an int or an Address takes 8 bytes, a',
    '   float 8, a boolean 1, a char 4 and a byte 1. */',
    '#define KOJI_UNSAFE_MEMORY(name, type)                                                             \\',
    '    KOJI_INLINE type koji_unsafe_read_##name(int64_t address, int64_t offset) {                    \\',
    '        type value;                                                                                \\',
    '        __builtin_memcpy(&value, (const void *)(intptr_t)(address + offset), sizeof value);        \\',
    '        return value;                                                                              \\',
    '    }                                                                                              \\',
    '    KOJI_INLINE void koji_unsafe_write_##name(int64_t address, int64_t offset, type value) {       \\',
    '        __builtin_memcpy((void *)(intptr_t)(address + offset), &value, sizeof value);              \\',
    '    }',
    'KOJI_UNSAFE_MEMORY(int, int64_t)',
    'KOJI_UNSAFE_MEMORY(float, double)',
    'KOJI_UNSAFE_MEMORY(bool, bool)',
    'KOJI_UNSAFE_MEMORY(char, uint32_t)',
    'KOJI_UNSAFE_MEMORY(byte, uint8_t)',
    '',
    'typedef struct KojiRecord KojiRecord;',
    '',
    'typedef struct KojiRecordType KojiRecordType;',
    '',
    'typedef struct {',
    '    const char *name;',
    '    size_t field_count;',
    '    const char *const *field_names;',
    '    const KojiElementType *const *field_types;',
    '    const KojiRecordType *const *field_records;',
    '    /* Where each field starts, in 8-byte words, then the number of words; NULL when every field',
    '       takes one word (a decimal takes two). */',
    '    const size_t *field_offsets;',
    '} KojiVariantType;',
    '',
    'struct KojiRecordType {',
    '    const char *name;',
    '    size_t variant_count;',
    '    const KojiVariantType *variants;',
    '    /* Releases the fields of a record of the type and gives its memory back (generated for each',
    '       type, which knows where its fields are). */',
    '    void (*free)(KojiRecord *record);',
    '    /* For an opaque type, the text of a value (its `display` method), which shows it inside other',
    '       values too; NULL for the others. */',
    '    KojiString *(*display)(const KojiRecord *record);',
    '};',
    '',
    '/* A record (runtime/src/record.rs): the words of its fields follow it, in the same allocation, at',
    '   the offsets of its variant. Its fields, its tag and its references are read here, inline. */',
    'struct KojiRecord {',
    '    size_t references;',
    '    const KojiRecordType *type;',
    '    size_t tag;',
    '    uint64_t words[];',
    '};',
    '',
    'KojiRecord *koji_record_new(const KojiRecordType *type, size_t tag);',
    '',
    '/* A new record of variant `tag`, of `words` words of fields, with one reference and its fields',
    '   zero (the generated code writes them next), in `memory` (on the stack of a function, for a',
    '   record that never leaves it) or in a block of the pool. */',
    'KOJI_INLINE KojiRecord *koji_record_at(void *memory, const KojiRecordType *type, size_t tag, size_t words) {',
    '    KojiRecord *record = (KojiRecord *)memory;',
    '    record->references = 1;',
    '    record->type = type;',
    '    record->tag = tag;',
    '    for (size_t i = 0; i < words; i++) record->words[i] = 0;',
    '    return record;',
    '}',
    '',
    'KOJI_INLINE KojiRecord *koji_record_make(const KojiRecordType *type, size_t tag, size_t words) {',
    '    return koji_record_at(koji_pool_take(3 + words), type, tag, words);',
    '}',
    '',
    'void koji_record_init(KojiRecord *record, size_t index, const void *value);',
    'void koji_record_free(KojiRecord *record);',
    '/* Copies the record in `variable` when it is shared, so that it can be changed in place. */',
    'void koji_record_unshare(KojiRecord **variable);',
    '',
    'KOJI_INLINE void koji_record_retain(const KojiRecord *record) {',
    '    if (record) ((KojiRecord *)record)->references++;',
    '}',
    '',
    '/* At the last reference, the fields are released and the record freed (by its type). NULL is',
    '   ignored. */',
    'KOJI_INLINE void koji_record_release(KojiRecord *record) {',
    '    if (record && --record->references == 0) record->type->free(record);',
    '}',
    '',
    'KOJI_INLINE int64_t koji_record_tag(const KojiRecord *record) { return (int64_t)record->tag; }',
    '',
    '/* The slot of a field, to read it. */',
    'KOJI_INLINE const void *koji_record_get(const KojiRecord *record, size_t index) {',
    '    const size_t *offsets = record->type->variants[record->tag].field_offsets;',
    '    return &record->words[offsets ? offsets[index] : index];',
    '}',
