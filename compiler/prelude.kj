    'KOJI_INLINE KojiRecord *koji_record_share(KojiRecord *record) {',
    '    koji_record_retain(record);',
    '    return record;',
    '}',
    '',
    'KOJI_INLINE void koji_map_set_variable(KojiMap **variable, KojiMap *value) {',
