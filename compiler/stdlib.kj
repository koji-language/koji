// The modules of the standard library written in Koji (std/), which the compiler carries: `import
// json` compiles std/json.kj. Generated: test/stages.rs checks that it is up to date, and rewrites
// it when run with KOJI_UPDATE_STDLIB=1.

export immut kojiModules = ['datetime', 'file', 'http', 'json', 'math', 'path', 'regex', 'system', 'time']

// The source of the module `name` of the standard library (`koji:core` for an internal one).
export function stdSource(name: string): Option[string] {
    if (name == 'datetime') {
        return Some([
            '// The `datetime` module: dates and times in UTC, and their text (see',
            '// doc/standard-library/datetime.md). A timestamp is a number of seconds since 0000-01-01 00:00:00',
            '// UTC, the epoch of Koji, in the proleptic Gregorian calendar (see `time`).',
            '',
            'import time',
            'import math',
            '',
            '// The days from 0000-01-01 to 1970-01-01, where the computations of the calendar count from.',
            'immut unixDays = 719528',
            '',
            'export type DateTime = {',
            '    year: int',
            '    month: int',
            '    day: int',
            '    hour: int',
            '    minute: int',
            '    second: int',
            '}',
            '',
            '// `2025-04-20 14:30:00`.',
            'function DateTime.display(self): string {',
            '    return `${padded(self.year, 4)}-${padded(self.month, 2)}-${padded(self.day, 2)} ${padded(self.hour, 2)}:${padded(self.minute, 2)}:${padded(self.second, 2)}`',
            '}',
            '',
            'export type DateError = {',
            '    // The text does not follow the pattern.',
            '    PatternMismatch(text: string, pattern: string)',
            '    // A date that does not exist: `2025-02-30`.',
            '    InvalidDate(text: string)',
            '}',
            '',
            'function DateError.display(self): string {',
            '    return match (self) {',
            '        PatternMismatch(text, pattern) => `\'${text}\' does not match the pattern \'${pattern}\'`',
            '        InvalidDate(text) => `\'${text}\' is not a valid date`',
            '    }',
            '}',
            '',
            '// The current date and time.',
            'export function now(): DateTime {',
            '    return dateOf(math.floor(time.now()))',
            '}',
            '',
            '// The current date: `2025-04-20`.',
            'export function today(): string {',
            '    immut date = now()',
            '    return `${padded(date.year, 4)}-${padded(date.month, 2)}-${padded(date.day, 2)}`',
            '}',
            '',
            '// The date of `timestamp` as `pattern` writes it: `yyyy`, `mm`, `dd`, `hh`, `min` and `ss` (in any',
            '// case) are its parts, any other character stands for itself.',
            'export function format(timestamp: decimal, pattern: string): string {',
            '    immut date = dateOf(math.floor(timestamp))',
            '    mut out = \'\'',
            '',
            '    for token in tokens(pattern) {',
            '        out += match (token) {',
            '            Year => padded(date.year, 4)',
            '            Month => padded(date.month, 2)',
            '            Day => padded(date.day, 2)',
            '            Hour => padded(date.hour, 2)',
            '            Minute => padded(date.minute, 2)',
            '            Second => padded(date.second, 2)',
            '            Text(c) => string(c)',
            '        }',
            '    }',
            '',
            '    return out',
            '}',
            '',
            '// The timestamp of the date that `text` writes as `pattern` does (the parts it leaves out are',
            '// those of 1970-01-01 00:00:00).',
            'export function parse(text: string, pattern: string): Result[int, DateError] {',
            '    immut chars = text.chars()',
            '    mut position = 0',
            '    mut date: DateTime = { year: 1970, month: 1, day: 1, hour: 0, minute: 0, second: 0 }',
            '',
            '    for token in tokens(pattern) {',
            '        match (token) {',
            '            Text(c) => {',
            '                if (position >= chars.length() or chars[position] != c) { return Err(PatternMismatch(text, pattern)) }',
            '',
            '                position += 1',
            '                continue',
            '            }',
            '            _ => {}',
            '        }',
            '',
            '        immut width = if (token == Year) { 4 } else { 2 }',
            '        mut value = 0',
            '',
            '        for i in range(width) {',
            '            if (position >= chars.length() or chars[position] < \'0\' or chars[position] > \'9\') { return Err(PatternMismatch(text, pattern)) }',
            '',
            '            value = value * 10 + (chars[position].code() - 48)',
            '            position += 1',
            '        }',
            '',
            '        match (token) {',
            '            Year => date.year = value',
            '            Month => date.month = value',
            '            Day => date.day = value',
            '            Hour => date.hour = value',
            '            Minute => date.minute = value',
            '            _ => date.second = value',
            '        }',
            '    }',
            '',
            '    if (position != chars.length()) { return Err(PatternMismatch(text, pattern)) }',
            '',
            '    immut valid = date.month >= 1 and date.month <= 12 and date.day >= 1 and date.day <= daysInMonth(date.year, date.month) and date.hour < 24 and date.minute < 60 and date.second < 60',
            '',
            '    if (not valid) { return Err(InvalidDate(text)) }',
            '',
            '    return Ok((daysFromCivil(date.year, date.month, date.day) + unixDays) * 86400 + date.hour * 3600 + date.minute * 60 + date.second)',
            '}',
            '',
            '// The parts of a pattern.',
            'type Token = {',
            '    Year',
            '    Month',
            '    Day',
            '    Hour',
            '    Minute',
            '    Second',
            '    Text(c: char)',
            '}',
            '',
            'function tokens(pattern: string): Token[] {',
            '    immut chars = pattern.chars()',
            '    immut lower = pattern.lower().chars()',
            '    mut found: Token[] = []',
            '    mut i = 0',
            '',
            '    while (i < chars.length()) {',
            '        if (startsWith(lower, i, \'yyyy\')) {',
            '            found.push(Year)',
            '            i += 4',
            '            continue',
            '        }',
            '',
            '        if (startsWith(lower, i, \'min\')) {',
            '            found.push(Minute)',
            '            i += 3',
            '            continue',
            '        }',
            '',
            '        immut two = match (if (i + 1 < lower.length()) { `${lower[i]}${lower[i + 1]}` } else { \'\' }) {',
            '            \'mm\' => Some(Month)',
            '            \'dd\' => Some(Day)',
            '            \'hh\' => Some(Hour)',
            '            \'ss\' => Some(Second)',
            '            _ => None',
            '        }',
            '',
            '        match (two) {',
            '            Some(token) => {',
            '                found.push(token)',
            '                i += 2',
            '            }',
            '            None => {',
            '                found.push(Text(chars[i]))',
            '                i += 1',
            '            }',
            '        }',
            '    }',
            '',
            '    return found',
            '}',
            '',
            'function startsWith(chars: char[], start: int, word: string): boolean {',
            '    mut i = start',
            '',
            '    for c in word {',
            '        if (i >= chars.length() or chars[i] != c) { return false }',
            '',
            '        i += 1',
            '    }',
            '',
            '    return true',
            '}',
            '',
            '// The date and time of `timestamp`.',
            'function dateOf(timestamp: int): DateTime {',
            '    immut days = floorDiv(timestamp, 86400) - unixDays',
            '    immut seconds = timestamp - (days + unixDays) * 86400',
            '    immut civil = civilFromDays(days)',
            '    return { year: civil[0], month: civil[1], day: civil[2], hour: seconds / 3600, minute: seconds % 3600 / 60, second: seconds % 60 }',
            '}',
            '',
            '// The year, month and day of a number of days since 1970-01-01 (Howard Hinnant\'s algorithm).',
            'function civilFromDays(days: int): int[] {',
            '    immut z = days + 719468',
            '    immut era = floorDiv(z, 146097)',
            '    immut doe = z - era * 146097',
            '    immut yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365',
            '    immut y = yoe + era * 400',
            '    immut doy = doe - (365 * yoe + yoe / 4 - yoe / 100)',
            '    immut mp = (5 * doy + 2) / 153',
            '    immut d = doy - (153 * mp + 2) / 5 + 1',
            '    immut m = if (mp < 10) { mp + 3 } else { mp - 9 }',
            '    return [if (m <= 2) { y + 1 } else { y }, m, d]',
            '}',
            '',
            'function daysFromCivil(year: int, month: int, day: int): int {',
            '    immut y = if (month <= 2) { year - 1 } else { year }',
            '    immut era = floorDiv(y, 400)',
            '    immut yoe = y - era * 400',
            '    immut mp = (month + 9) % 12',
            '    immut doy = (153 * mp + 2) / 5 + day - 1',
            '    immut doe = yoe * 365 + yoe / 4 - yoe / 100 + doy',
            '    return era * 146097 + doe - 719468',
            '}',
            '',
            'function daysInMonth(year: int, month: int): int {',
            '    if (month == 2) {',
            '        immut leap = (year % 4 == 0 and year % 100 != 0) or year % 400 == 0',
            '        return if (leap) { 29 } else { 28 }',
            '    }',
            '',
            '    if (month == 4 or month == 6 or month == 9 or month == 11) { return 30 }',
            '',
            '    return 31',
            '}',
            '',
            '// `a / b` rounded down (for a positive `b`).',
            'function floorDiv(a: int, b: int): int {',
            '    immut quotient = a / b',
            '    return if (a % b < 0) { quotient - 1 } else { quotient }',
            '}',
            '',
            '// `n` with zeros before it, `width` characters in all (the sign counts): `-005`.',
            'function padded(n: int, width: int): string {',
            '    if (n < 0) { return `-${padded(-n, width - 1)}` }',
            '',
            '    immut digits = string(n)',
            '    return \'0\' * (width - digits.length()) + digits',
            '}',
        ].join('\n'))
    }

    if (name == 'file') {
        return Some([
            '// The `file` module: files and directories (see doc/standard-library/file.md). A `File` is',
            '// move-only: it is closed when it is dropped, and `close()` drops it.',
            '',
            'import system',
            'import { Address, CInt, CSize, Location, allocate, free, isNull, newString, offset, panicAt, read, stringBytes, stringSize, write } from \'koji:unsafe\'',
            'import { cString, cText, hasNul, isUtf8, textOf } from \'koji:core\'',
            '',
            '// The C library. A file is opened with `fopen` (which takes no variadic arguments, unlike',
            '// `open`), then read and written through its descriptor, without the buffers of `FILE`.',
            'extern function fopen(path: Address, mode: Address): Address',
            'extern function fclose(file: Address): CInt',
            'extern function fileno(file: Address): CInt',
            '// `read` and `write` of C, with one buffer (`read` and `write` are those of `koji:unsafe` here).',
            'extern function readv(fd: CInt, buffers: Address, count: CInt): int',
            'extern function writev(fd: CInt, buffers: Address, count: CInt): int',
            'extern function opendir(path: Address): Address',
            'extern function readdir(directory: Address): Address',
            'extern function closedir(directory: Address): CInt',
            'extern function access(path: Address, mode: CInt): CInt',
            'extern function unlink(path: Address): CInt',
            'extern function mkdir(path: Address, mode: CInt): CInt',
            'extern function strlen(text: Address): CSize',
            'extern function strerror(code: CInt): Address',
            'extern function realloc(memory: Address, size: CSize): Address',
            'extern function koji_system_errno(): CInt',
            '',
            'export type Mode = {',
            '    // Read.',
            '    Read',
            '    // Write (overwrites the content).',
            '    Write',
            '    // Write at the end.',
            '    Append',
            '}',
            '',
            'export type FileError = {',
            '    NotFound(path: string)',
            '    PermissionDenied(path: string)',
            '    IsDirectory(path: string)',
            '    // The content is not valid text.',
            '    InvalidUtf8(path: string)',
            '    // Any other failure of the operating system.',
            '    Io(path: string, message: string)',
            '}',
            '',
            'function FileError.display(self): string {',
            '    return match (self) {',
            '        NotFound(path) => `file \'${path}\' not found`',
            '        PermissionDenied(path) => `permission denied for \'${path}\'`',
            '        IsDirectory(path) => `\'${path}\' is a directory`',
            '        InvalidUtf8(path) => `file \'${path}\' is not valid UTF-8 text`',
            '        Io(path, message) => `cannot access \'${path}\': ${message}`',
            '    }',
            '}',
            '',
            '// An open file: its `FILE` of C, with the path and the mode it was opened with.',
            'export opaque type File = {',
            '    handle: Address',
            '    path: string',
            '    mode: Mode',
            '}',
            '',
            'function File.display(self): string {',
            '    return `<file \'${self.path}\'>`',
            '}',
            '',
            'function File.drop(mut self) {',
            '    fclose(self.handle)',
            '}',
            '',
            '// Opens the file at `path` in `mode`.',
            'export function open(path: string, mode: Mode): Result[File, FileError] {',
            '    if (hasNul(path)) { return Err(invalidPath(path)) }',
            '',
            '    immut cPath = cString(path)',
            '    // `e`: the descriptor is not given to the programs this one runs.',
            '    immut cMode = cString(match (mode) {',
            '        Read => \'re\'',
            '        Write => \'we\'',
            '        Append => \'ae\'',
            '    })',
            '    immut handle = fopen(cPath, cMode)',
            '    immut code = koji_system_errno()',
            '    free(cPath)',
            '    free(cMode)',
            '',
            '    if (isNull(handle)) { return Err(failure(path, code)) }',
            '',
            '    return Ok({ handle: handle, path: path, mode: mode })',
            '}',
            '',
            '// The whole content of the file, from where it is (the start, after `open`).',
            'function File.read(self, here: Location): Result[string, FileError] {',
            '    if (self.mode != Read) { panicAt(here, `file \'${self.path}\' was not opened for reading (Read)`) }',
            '',
            '    immut fd = fileno(self.handle)',
            '    mut capacity = 8192',
            '    mut buffer = allocate(capacity)',
            '    mut size = 0',
            '',
            '    while (true) {',
            '        if (capacity - size < 4096) {',
            '            capacity *= 2',
            '            buffer = realloc(buffer, capacity)',
            '        }',
            '',
            '        immut got = transfer(false, fd, offset(buffer, size), capacity - size)',
            '',
            '        if (got < 0) {',
            '            immut code = koji_system_errno()',
            '',
            '            // EINTR: a signal interrupted the read.',
            '            if (code == 4) { continue }',
            '',
            '            free(buffer)',
            '            return Err(failure(self.path, code))',
            '        }',
            '',
            '        if (got == 0) { break }',
            '',
            '        size += got',
            '    }',
            '',
            '    if (not isUtf8(buffer, size)) {',
            '        free(buffer)',
            '        return Err(InvalidUtf8(self.path))',
            '    }',
            '',
            '    immut text = newString(buffer, size)',
            '    free(buffer)',
            '    return Ok(text)',
            '}',
            '',
            '// Writes `text` to the file.',
            'function File.write(self, text: string, here: Location): Result[void, FileError] {',
            '    if (self.mode == Read) { panicAt(here, `file \'${self.path}\' was opened for reading; use Write or Append to write`) }',
            '',
            '    immut fd = fileno(self.handle)',
            '    immut bytes = stringBytes(text)',
            '    immut size = stringSize(text)',
            '    mut done = 0',
            '',
            '    while (done < size) {',
            '        immut put = transfer(true, fd, offset(bytes, done), size - done)',
            '',
            '        if (put < 0) {',
            '            immut code = koji_system_errno()',
            '',
            '            if (code == 4) { continue }',
            '',
            '            return Err(failure(self.path, code))',
            '        }',
            '',
            '        done += put',
            '    }',
            '',
            '    return Ok()',
            '}',
            '',
            '// Closes the file (dropping it closes it).',
            'function File.close(take self) {}',
            '',
            '// The names of the entries of the directory at `path`, sorted.',
            'export function list(path: string): Result[string[], FileError] {',
            '    if (hasNul(path)) { return Err(invalidPath(path)) }',
            '',
            '    immut cPath = cString(path)',
            '    immut directory = opendir(cPath)',
            '    immut code = koji_system_errno()',
            '    free(cPath)',
            '',
            '    if (isNull(directory)) { return Err(failure(path, code)) }',
            '',
            '    // Where `d_name` is in a `struct dirent`.',
            '    immut nameAt = match (system.os) {',
            '        MacOS => 21',
            '        _ => 19',
            '    }',
            '    mut names: string[] = []',
            '',
            '    while (true) {',
            '        immut entry = readdir(directory)',
            '',
            '        if (isNull(entry)) { break }',
            '',
            '        immut name = offset(entry, nameAt)',
            '        immut text = textOf(name, strlen(name))',
            '',
            '        if (text != \'.\' and text != \'..\') { names.push(text) }',
            '    }',
            '',
            '    closedir(directory)',
            '    names.sort()',
            '    return Ok(names)',
            '}',
            '',
            '// Whether a file or a directory is at `path`.',
            'export function exists(path: string): boolean {',
            '    if (hasNul(path)) { return false }',
            '',
            '    return reachable(path)',
            '}',
            '',
            '// Removes the file at `path` (not a directory).',
            'export function remove(path: string): Result[void, FileError] {',
            '    if (hasNul(path)) { return Err(invalidPath(path)) }',
            '',
            '    immut cPath = cString(path)',
            '    immut removed = unlink(cPath) == 0',
            '    immut code = koji_system_errno()',
            '    free(cPath)',
            '',
            '    if (not removed) { return Err(failure(path, code)) }',
            '',
            '    return Ok()',
            '}',
            '',
            '// Creates the directory at `path`, and the directories missing before it.',
            'export function createDir(path: string): Result[void, FileError] {',
            '    if (hasNul(path)) { return Err(invalidPath(path)) }',
            '',
            '    return createAll(path)',
            '}',
            '',
            '// As Rust\'s `create_dir_all`: a directory that already exists is no error.',
            'function createAll(path: string): Result[void, FileError] {',
            '    if (path == \'\') { return Ok() }',
            '',
            '    immut code = makeDirectory(path)',
            '',
            '    if (code == 0) { return Ok() }',
            '',
            '    // ENOENT: the directory before it is missing.',
            '    if (code != 2) {',
            '        if (isDirectory(path)) { return Ok() }',
            '',
            '        return Err(failure(path, code))',
            '    }',
            '',
            '    createAll(parentOf(path))?',
            '    immut again = makeDirectory(path)',
            '',
            '    if (again == 0 or isDirectory(path)) { return Ok() }',
            '',
            '    return Err(failure(path, again))',
            '}',
            '',
            '// `mkdir`: 0, or the error of the system.',
            'function makeDirectory(path: string): int {',
            '    immut cPath = cString(path)',
            '    immut made = mkdir(cPath, 0x1FF) == 0',
            '    immut code = koji_system_errno()',
            '    free(cPath)',
            '    return if (made) { 0 } else { code }',
            '}',
            '',
            '// The path without its last part (`a/b/` gives `a`, `a` gives `\'\'` and `/a` gives `/`).',
            'function parentOf(path: string): string {',
            '    immut bytes = stringBytes(path)',
            '    mut end = stringSize(path)',
            '',
            '    while (end > 1 and byteAt(bytes, end - 1) == 0x2F) {',
            '        end -= 1',
            '    }',
            '',
            '    while (end > 0 and byteAt(bytes, end - 1) != 0x2F) {',
            '        end -= 1',
            '    }',
            '',
            '    while (end > 1 and byteAt(bytes, end - 1) == 0x2F) {',
            '        end -= 1',
            '    }',
            '',
            '    return newString(bytes, end)',
            '}',
            '',
            'function isDirectory(path: string): boolean {',
            '    return reachable(`${path}/.`)',
            '}',
            '',
            '// `access(path, F_OK)`.',
            'function reachable(path: string): boolean {',
            '    immut cPath = cString(path)',
            '    immut found = access(cPath, 0) == 0',
            '    free(cPath)',
            '    return found',
            '}',
            '',
            '// The error of the system for `path` (`errno`).',
            'function failure(path: string, code: int): FileError {',
            '    // ENOENT; EPERM and EACCES; EISDIR.',
            '    if (code == 2) { return NotFound(path) }',
            '',
            '    if (code == 1 or code == 13) { return PermissionDenied(path) }',
            '',
            '    if (code == 21) { return IsDirectory(path) }',
            '',
            '    return Io(path, `${cText(strerror(code))} (os error ${code})`)',
            '}',
            '',
            '// A path with a NUL, which the system cannot take.',
            'function invalidPath(path: string): FileError {',
            '    return Io(path, \'file name contained an unexpected NUL byte\')',
            '}',
            '',
            '// `readv` or `writev` of one buffer: the bytes read or written, or -1.',
            'function transfer(writing: boolean, fd: int, at: Address, size: int): int {',
            '    immut vector = allocate(16)',
            '    write(vector, 0, at)',
            '    write(vector, 8, size)',
            '    immut done = if (writing) { writev(fd, vector, 1) } else { readv(fd, vector, 1) }',
            '    free(vector)',
            '    return done',
            '}',
            '',
            'function byteAt(bytes: Address, at: int): int {',
            '    immut b: byte = read(bytes, at)',
            '    return int(b)',
            '}',
        ].join('\n'))
    }

    if (name == 'http') {
        return Some([
            '// The `http` module: requests over HTTP/1.1 (see doc/standard-library/http.md), on sockets (the',
            '// inline functions of runtime/prelude.h that differ from one system to another); `https://` through',
            '// the client of TLS 1.3 of the library written in Koji (koji:tls). As the runtime in Rust did (with',
            '// `ureq`): at most 30 seconds to connect, 5 redirects (301, 302 and 303 become GET; 307 and 308 only',
            '// for a GET), a body of at most 10 MB read as UTF-8 (invalid bytes become U+FFFD).',
            '',
            'import { Address, CInt, CSize, allocate, free, offset, read, stringBytes, stringSize, write } from \'koji:unsafe\'',
            'import { cString, cText, isSpace, textOf } from \'koji:core\'',
            '',
            'extern function strerror(code: CInt): Address',
            'extern function memcpy(target: Address, source: Address, size: CSize): Address',
            'extern function koji_net_connect(host: Address, port: Address, seconds: int, code: Address): int',
            'extern function koji_net_dns_message(code: int): Address',
            'extern function koji_net_send(fd: int, bytes: Address, size: int): int',
            'extern function koji_net_receive(fd: int, bytes: Address, size: int): int',
            'extern function koji_net_close(fd: int)',
            'extern function koji_system_errno(): CInt',
            '// TLS (koji:tls): a session on a connected socket (a handle, or 0 with the problem at `problem`), its',
            '// data each way, the text of a problem and the error of the system of a failure of the connection.',
            'extern function koji_tls_connect(fd: int, host: string, problem: Address): int',
            'extern function koji_tls_send(handle: int, data: Address, size: int): int',
            'extern function koji_tls_receive(handle: int, out: Address, size: int): int',
            'extern function koji_tls_problem(handle: int): int',
            'extern function koji_tls_message(problem: int): string',
            'extern function koji_tls_errno(): int',
            'extern function koji_tls_close(handle: int)',
            '',
            '// The problems of koji:tls that are not of TLS: a failure of the connection, and the connection',
            '// closed without close_notify.',
            'immut tlsSystemError = 24',
            'immut tlsTruncated = 28',
            '',
            '// What `fill` gives for a problem of TLS: `tlsProblems - problem`.',
            'immut tlsProblems = -1048576',
            '',
            'export type Response = {',
            '    status: int',
            '    body: string',
            '}',
            '',
            'export type HttpError = {',
            '    InvalidUrl(url: string)',
            '    ConnectionFailed(url: string, message: string)',
            '    Timeout(url: string)',
            '    Tls(url: string, message: string)',
            '    InvalidResponse(url: string, message: string)',
            '}',
            '',
            'function HttpError.display(self): string {',
            '    return match (self) {',
            '        InvalidUrl(url) => `invalid URL \'${url}\'`',
            '        ConnectionFailed(url, message) => `cannot connect to \'${url}\': ${message}`',
            '        Timeout(url) => `the request to \'${url}\' timed out`',
            '        Tls(url, message) => `secure connection to \'${url}\' failed: ${message}`',
            '        InvalidResponse(url, message) => `invalid response from \'${url}\': ${message}`',
            '    }',
            '}',
            '',
            '// `get(url)`, `delete(url)`, `post(url, data)` and `put(url, data)`: a response with an error',
            '// status (404, 500...) is still a response.',
            'export function get(url: string): Result[Response, HttpError] {',
            '    return request(\'GET\', url, None)',
            '}',
            '',
            'export function delete(url: string): Result[Response, HttpError] {',
            '    return request(\'DELETE\', url, None)',
            '}',
            '',
            'export function post(url: string, data: string): Result[Response, HttpError] {',
            '    return request(\'POST\', url, Some(data))',
            '}',
            '',
            'export function put(url: string, data: string): Result[Response, HttpError] {',
            '    return request(\'PUT\', url, Some(data))',
            '}',
            '',
            '// A URL of HTTP: its host (without brackets for IPv6), port and target (path and query), the Host',
            '// header, and the URL as `ureq` showed it in its messages.',
            'type Url = {',
            '    secure: boolean',
            '    host: string',
            '    port: int',
            '    target: string',
            '    authority: string',
            '    text: string',
            '}',
            '',
            '// What a server answered.',
            'type Answer = {',
            '    status: int',
            '    location: Option[string]',
            '    body: string',
            '}',
            '',
            '// The most bytes of a body.',
            'immut bodyLimit = 10485760',
            '',
            '// A connection: its socket, and its session of TLS for `https://` (0 for none).',
            'type Connection = {',
            '    fd: int',
            '    tls: int',
            '}',
            '',
            'function close(connection: Connection) {',
            '    if (connection.tls > 0) { koji_tls_close(connection.tls) }',
            '',
            '    koji_net_close(connection.fd)',
            '}',
            '',
            'function request(method: string, url: string, body: Option[string]): Result[Response, HttpError] {',
            '    mut target = match (parseUrl(url)) {',
            '        Some(found) => found',
            '        None => return Err(InvalidUrl(url))',
            '    }',
            '',
            '    // A body is sent as JSON when it looks like JSON, otherwise as text; the type stays for the',
            '    // redirects, which send no body.',
            '    immut contentType = match (body) {',
            '        Some(text) => Some(if (looksLikeJson(text)) { \'application/json\' } else { \'text/plain; charset=utf-8\' })',
            '        None => None',
            '    }',
            '    mut currentMethod = method',
            '    mut currentBody = body',
            '    mut redirects = 0',
            '',
            '    while (true) {',
            '        immut answer = exchange(currentMethod, target, currentBody, contentType, url)?',
            '',
            '        if (answer.status < 300 or answer.status >= 399) { return Ok({ status: answer.status, body: answer.body }) }',
            '',
            '        if (redirects + 1 >= 5) { return Err(InvalidResponse(url, `${target.text}: Too Many Redirects: reached max redirects (5)`)) }',
            '',
            '        immut location = match (answer.location) {',
            '            Some(found) => found',
            '            None => return Ok({ status: answer.status, body: answer.body })',
            '        }',
            '        immut next = match (joinUrl(target, location)) {',
            '            Some(found) => found',
            '            None => return Err(InvalidUrl(url))',
            '        }',
            '',
            '        if (answer.status == 301 or answer.status == 302 or answer.status == 303) {',
            '            if (currentMethod != \'GET\') { currentMethod = \'GET\' }',
            '        } else {',
            '            if (not ((answer.status == 307 or answer.status == 308) and currentMethod == \'GET\')) { return Ok({ status: answer.status, body: answer.body }) }',
            '        }',
            '',
            '        target = next',
            '        currentBody = None',
            '        redirects += 1',
            '    }',
            '',
            '    return Err(InvalidUrl(url))',
            '}',
            '',
            '// Whether a body looks like JSON: `{` or `[` after the white space at its start.',
            'function looksLikeJson(text: string): boolean {',
            '    for c in text {',
            '        if (isSpace(c.code())) { continue }',
            '',
            '        return c == \'{\' or c == \'[\'',
            '    }',
            '',
            '    return false',
            '}',
            '',
            '// One request, and what the server answered.',
            'function exchange(method: string, target: Url, body: Option[string], contentType: Option[string], url: string): Result[Answer, HttpError] {',
            '    immut codePlace = allocate(8)',
            '    immut host = cString(target.host)',
            '    immut port = cString(`${target.port}`)',
            '    immut fd = koji_net_connect(host, port, 30, codePlace)',
            '    immut code: int = read(codePlace, 0)',
            '    free(codePlace)',
            '    free(host)',
            '    free(port)',
            '',
            '    if (fd == -1) { return Err(ConnectionFailed(url, `${target.text}: Dns Failed: resolve dns name \'${target.host}:${target.port}\': failed to lookup address information: ${cText(koji_net_dns_message(code))}`)) }',
            '',
            '    if (fd == -2) { return Err(ConnectionFailed(url, `${target.text}: Connection Failed: Connect error: ${systemMessage(code)}`)) }',
            '',
            '    if (fd == -3) { return Err(Timeout(url)) }',
            '',
            '    mut connection: Connection = { fd: fd, tls: 0 }',
            '',
            '    if (target.secure) {',
            '        immut problemPlace = allocate(8)',
            '        immut handle = koji_tls_connect(fd, target.host, problemPlace)',
            '        immut problem: int = read(problemPlace, 0)',
            '        free(problemPlace)',
            '',
            '        if (handle == 0) {',
            '            koji_net_close(fd)',
            '',
            '            if (problem == tlsSystemError) { return Err(ConnectionFailed(url, `${target.text}: Network Error: ${systemMessage(koji_tls_errno())}`)) }',
            '',
            '            return Err(Tls(url, `${target.text}: ${koji_tls_message(problem)}`))',
            '        }',
            '',
            '        connection.tls = handle',
            '    }',
            '',
            '    mut text = `${method} ${target.target} HTTP/1.1\\r\\nHost: ${target.authority}\\r\\nUser-Agent: koji\\r\\nAccept: */*\\r\\n`',
            '',
            '    match (contentType) {',
            '        Some(kind) => text += `Content-Type: ${kind}\\r\\n`',
            '        None => {}',
            '    }',
            '',
            '    match (body) {',
            '        Some(data) => text += `Content-Length: ${stringSize(data)}\\r\\n`',
            '        None => {}',
            '    }',
            '',
            '    text += \'Connection: close\\r\\n\\r\\n\'',
            '',
            '    match (body) {',
            '        Some(data) => text += data',
            '        None => {}',
            '    }',
            '',
            '    immut sent = sendAll(connection, text)',
            '',
            '    if (sent != 0) {',
            '        close(connection)',
            '        return Err(ConnectionFailed(url, `${target.text}: Network Error: ${systemMessage(sent)}`))',
            '    }',
            '',
            '    immut answer = receive(connection, target, url)',
            '    close(connection)',
            '    return answer',
            '}',
            '',
            '// Sends all the bytes of `text`: 0, or the error of the system.',
            'function sendAll(connection: Connection, text: string): int {',
            '    immut bytes = stringBytes(text)',
            '    immut size = stringSize(text)',
            '    immut fd = connection.fd',
            '    mut done = 0',
            '',
            '    if (connection.tls > 0) {',
            '        if (koji_tls_send(connection.tls, bytes, size) < 0) { return koji_tls_errno() }',
            '',
            '        return 0',
            '    }',
            '',
            '    while (done < size) {',
            '        immut put = koji_net_send(fd, offset(bytes, done), size - done)',
            '',
            '        if (put < 0) {',
            '            immut code = koji_system_errno()',
            '',
            '            if (code == 4) { continue }',
            '',
            '            return code',
            '        }',
            '',
            '        done += put',
            '    }',
            '',
            '    return 0',
            '}',
            '',
            '// The text of an error of the system, as Rust shows it.',
            'function systemMessage(code: int): string {',
            '    return `${cText(strerror(code))} (os error ${code})`',
            '}',
            '',
            '// The error of a failed read (`got`, below 0: -errno, or a problem of TLS).',
            'function readFailure(got: int, target: Url, url: string): HttpError {',
            '    if (got <= tlsProblems) {',
            '        immut problem = tlsProblems - got',
            '',
            '        if (problem != tlsSystemError) { return Tls(url, `${target.text}: ${koji_tls_message(problem)}`) }',
            '',
            '        return InvalidResponse(url, systemMessage(koji_tls_errno()))',
            '    }',
            '',
            '    return InvalidResponse(url, systemMessage(-got))',
            '}',
            '',
            '// Reads the answer of the server: the status line and the headers, then the body (by its length,',
            '// in chunks, or until the server closes the connection).',
            'function receive(connection: Connection, target: Url, url: string): Result[Answer, HttpError] {',
            '    mut buffer = allocate(16384)',
            '    mut capacity = 16384',
            '    mut size = 0',
            '    mut headerEnd = -1',
            '    mut closed = false',
            '    // Closed without close_notify (TLS): the end of a body whose size is known all the same.',
            '    mut truncated = false',
            '',
            '    // The headers.',
            '    while (headerEnd < 0) {',
            '        mut got = fill(connection, mut buffer, mut size, mut capacity)',
            '',
            '        if (got == tlsProblems - tlsTruncated) { got = 0 }',
            '',
            '        if (got < 0) {',
            '            free(buffer)',
            '            return Err(readFailure(got, target, url))',
            '        }',
            '',
            '        if (got == 0) {',
            '            free(buffer)',
            '            return Err(InvalidResponse(url, `${target.text}: Bad Status: the server closed the connection before answering`))',
            '        }',
            '',
            '        headerEnd = findHeaderEnd(buffer, size)',
            '    }',
            '',
            '    immut head = textOf(buffer, headerEnd)',
            '    immut lines = head.split(\'\\r\\n\')',
            '    immut statusLine = lines[0]',
            '',
            '    if (not statusLine.startsWith(\'HTTP/\') or statusLine.length() < 12 or statusLine[8] != \' \') {',
            '        free(buffer)',
            '        return Err(InvalidResponse(url, `${target.text}: Bad Status: ${statusLine}`))',
            '    }',
            '',
            '    immut status = match (int(statusLine[9..12])) {',
            '        Ok(number) => number',
            '        Err(_) => {',
            '            free(buffer)',
            '            return Err(InvalidResponse(url, `${target.text}: Bad Status: ${statusLine}`))',
            '        }',
            '    }',
            '    mut length = -1',
            '    mut chunked = false',
            '    mut location: Option[string] = None',
            '',
            '    for i in range(1, lines.length()) {',
            '        immut line = lines[i]',
            '',
            '        match (line.indexOf(\':\')) {',
            '            Some(colon) => {',
            '                immut name = line[..colon].trim().lower()',
            '                immut value = line[colon + 1..].trim()',
            '',
            '                if (name == \'content-length\') {',
            '                    match (int(value)) {',
            '                        Ok(number) => length = number',
            '                        Err(_) => {}',
            '                    }',
            '                }',
            '',
            '                if (name == \'transfer-encoding\' and value.lower().endsWith(\'chunked\')) { chunked = true }',
            '',
            '                if (name == \'location\' and location is None) { location = Some(value) }',
            '            }',
            '            None => {}',
            '        }',
            '    }',
            '',
            '    immut start = headerEnd + 4',
            '    // No body: an informational answer, 204 and 304.',
            '    immut empty = status < 200 or status == 204 or status == 304',
            '',
            '    if (empty) {',
            '        free(buffer)',
            '        return Ok({ status: status, location: location, body: \'\' })',
            '    }',
            '',
            '    // The body: its bytes, from `start`, then decoded (chunks) into a block of their own.',
            '    while (true) {',
            '        if (size - start > bodyLimit + 2 * 1048576 and not chunked) { break }',
            '',
            '        if (not chunked and length >= 0 and size - start >= length) { break }',
            '',
            '        if (chunked and chunksComplete(buffer, start, size)) { break }',
            '',
            '        immut got = fill(connection, mut buffer, mut size, mut capacity)',
            '',
            '        if (got == tlsProblems - tlsTruncated) {',
            '            closed = true',
            '            truncated = true',
            '            break',
            '        }',
            '',
            '        if (got < 0) {',
            '            free(buffer)',
            '            return Err(readFailure(got, target, url))',
            '        }',
            '',
            '        if (got == 0) {',
            '            closed = true',
            '            break',
            '        }',
            '    }',
            '',
            '    mut bodySize = if (length >= 0 and not chunked) { minOf(length, size - start) } else { size - start }',
            '',
            '    immut incomplete = if (chunked) { not chunksComplete(buffer, start, size) } else { length >= 0 and size - start < length }',
            '',
            '    if (incomplete and closed) {',
            '        free(buffer)',
            '        return Err(InvalidResponse(url, \'response body closed before all bytes were read\'))',
            '    }',
            '',
            '    // A body that ends with the connection, cut without close_notify: perhaps not all of it.',
            '    if (truncated and not chunked and length < 0) {',
            '        free(buffer)',
            '        return Err(Tls(url, `${target.text}: ${koji_tls_message(tlsTruncated)}`))',
            '    }',
            '',
            '    if (chunked) { bodySize = decodeChunks(buffer, start, size) }',
            '',
            '    if (bodySize > bodyLimit) {',
            '        free(buffer)',
            '        return Err(InvalidResponse(url, \'response too big for into_string\'))',
            '    }',
            '',
            '    immut text = textOf(offset(buffer, start), bodySize)',
            '    free(buffer)',
            '    return Ok({ status: status, location: location, body: text })',
            '}',
            '',
            'function minOf(a: int, b: int): int {',
            '    return if (a < b) { a } else { b }',
            '}',
            '',
            '// Reads more bytes into `buffer` (`size` of them, in a block of `capacity`), which grows: their',
            '// number, 0 at the end of the connection, -errno, or `tlsProblems - problem` for a problem of TLS.',
            'function fill(connection: Connection, mut buffer: Address, mut size: int, mut capacity: int): int {',
            '    if (capacity - size < 4096) {',
            '        immut grown = allocate(capacity * 2)',
            '        memcpy(grown, buffer, size)',
            '        free(buffer)',
            '        buffer = grown',
            '        capacity = capacity * 2',
            '    }',
            '',
            '    if (connection.tls > 0) {',
            '        immut got = koji_tls_receive(connection.tls, offset(buffer, size), capacity - size)',
            '',
            '        if (got < 0) { return tlsProblems - koji_tls_problem(connection.tls) }',
            '',
            '        size += got',
            '        return got',
            '    }',
            '',
            '    while (true) {',
            '        immut got = koji_net_receive(connection.fd, offset(buffer, size), capacity - size)',
            '',
            '        if (got >= 0) {',
            '            size += got',
            '            return got',
            '        }',
            '',
            '        immut code = koji_system_errno()',
            '',
            '        if (code != 4) { return -code }',
            '    }',
            '',
            '    return 0',
            '}',
            '',
            'function byteAt(bytes: Address, at: int): int {',
            '    immut b: byte = read(bytes, at)',
            '    return int(b)',
            '}',
            '',
            '// Where the headers end (the empty line), or -1.',
            'function findHeaderEnd(bytes: Address, size: int): int {',
            '    for at in range(size - 3) {',
            '        if (byteAt(bytes, at) == 13 and byteAt(bytes, at + 1) == 10 and byteAt(bytes, at + 2) == 13 and byteAt(bytes, at + 3) == 10) { return at }',
            '    }',
            '',
            '    return -1',
            '}',
            '',
            '// The size of a chunk from its line at `at` (hexadecimal digits, then extensions after `;`), and',
            '// where its bytes start in `dataStart`; -1 when the line is not complete.',
            'function chunkSize(bytes: Address, at: int, size: int, mut dataStart: int): int {',
            '    mut end = at',
            '',
            '    while (end + 1 < size and not (byteAt(bytes, end) == 13 and byteAt(bytes, end + 1) == 10)) {',
            '        end += 1',
            '    }',
            '',
            '    if (end + 1 >= size) { return -1 }',
            '',
            '    mut value = 0',
            '    mut i = at',
            '',
            '    while (i < end) {',
            '        immut b = byteAt(bytes, i)',
            '        immut digit = if (b >= 48 and b <= 57) { b - 48 } else { if (b >= 97 and b <= 102) { b - 87 } else { if (b >= 65 and b <= 70) { b - 55 } else { -1 } } }',
            '',
            '        if (digit < 0) { break }',
            '',
            '        value = value * 16 + digit',
            '        i += 1',
            '    }',
            '',
            '    dataStart = end + 2',
            '    return value',
            '}',
            '',
            '// Whether all the chunks (to the one of size 0 and the empty line after the trailers) are there.',
            'function chunksComplete(bytes: Address, start: int, size: int): boolean {',
            '    mut at = start',
            '',
            '    while (true) {',
            '        mut dataStart = 0',
            '        immut count = chunkSize(bytes, at, size, mut dataStart)',
            '',
            '        if (count < 0) { return false }',
            '',
            '        if (count == 0) {',
            '            // The trailers, then an empty line.',
            '            mut line = dataStart',
            '',
            '            while (true) {',
            '                if (line + 1 >= size) { return false }',
            '',
            '                if (byteAt(bytes, line) == 13 and byteAt(bytes, line + 1) == 10) { return true }',
            '',
            '                mut end = line',
            '',
            '                while (end + 1 < size and not (byteAt(bytes, end) == 13 and byteAt(bytes, end + 1) == 10)) {',
            '                    end += 1',
            '                }',
            '',
            '                if (end + 1 >= size) { return false }',
            '',
            '                line = end + 2',
            '            }',
            '        }',
            '',
            '        if (dataStart + count + 2 > size) { return false }',
            '',
            '        at = dataStart + count + 2',
            '    }',
            '',
            '    return false',
            '}',
            '',
            '// Puts the bytes of the chunks one after the other from `start`: their size.',
            'function decodeChunks(bytes: Address, start: int, size: int): int {',
            '    mut at = start',
            '    mut written = 0',
            '',
            '    while (true) {',
            '        mut dataStart = 0',
            '        immut count = chunkSize(bytes, at, size, mut dataStart)',
            '',
            '        if (count <= 0) { return written }',
            '',
            '        immut available = minOf(count, size - dataStart)',
            '        memcpy(offset(bytes, start + written), offset(bytes, dataStart), available)',
            '        written += available',
            '',
            '        if (available < count) { return written }',
            '',
            '        at = dataStart + count + 2',
            '    }',
            '',
            '    return written',
            '}',
            '',
            '// URLs, as the WHATWG standard reads those of HTTP: the scheme and the host in lower case, the',
            '// default port left out, `/` for an empty path, the fragment dropped, and the bytes that cannot be',
            '// in a path or a query written as `%XX`.',
            'function parseUrl(given: string): Option[Url] {',
            '    immut url = trimControls(given)',
            '    mut at = 0',
            '    immut chars = url.chars()',
            '',
            '    // The scheme: a letter, then letters, digits, `+`, `-` and `.`, then `:`.',
            '    if (chars.length() == 0 or not isLetter(chars[0])) { return None }',
            '',
            '    while (at < chars.length() and chars[at] != \':\') {',
            '        immut c = chars[at]',
            '',
            '        if (not (isLetter(c) or (c >= \'0\' and c <= \'9\') or c == \'+\' or c == \'-\' or c == \'.\')) { return None }',
            '',
            '        at += 1',
            '    }',
            '',
            '    if (at == chars.length()) { return None }',
            '',
            '    immut scheme = url[..at].lower()',
            '',
            '    if (scheme != \'http\' and scheme != \'https\') { return None }',
            '',
            '    at += 1',
            '',
            '    while (at < chars.length() and (chars[at] == \'/\' or chars[at] == \'\\\\\')) {',
            '        at += 1',
            '    }',
            '',
            '    mut authorityEnd = at',
            '',
            '    while (authorityEnd < chars.length() and not endsAuthority(chars[authorityEnd])) {',
            '        authorityEnd += 1',
            '    }',
            '',
            '    mut authority = url[at..authorityEnd]',
            '',
            '    // A user and a password are not sent.',
            '    match (lastIndexOf(authority, \'@\')) {',
            '        Some(sign) => authority = authority[sign + 1..]',
            '        None => {}',
            '    }',
            '',
            '    immut secure = scheme == \'https\'',
            '    immut defaultPort = if (secure) { 443 } else { 80 }',
            '    mut host = authority',
            '    mut port = defaultPort',
            '    mut portText = \'\'',
            '',
            '    if (authority.startsWith(\'[\')) {',
            '        immut close = match (authority.indexOf(\']\')) {',
            '            Some(found) => found',
            '            None => return None',
            '        }',
            '        host = authority[1..close]',
            '        immut rest = authority[close + 1..]',
            '',
            '        if (rest != \'\') {',
            '            if (not rest.startsWith(\':\')) { return None }',
            '',
            '            portText = rest[1..]',
            '        }',
            '    } else {',
            '        match (lastIndexOf(authority, \':\')) {',
            '            Some(colon) => {',
            '                host = authority[..colon]',
            '                portText = authority[colon + 1..]',
            '            }',
            '            None => {}',
            '        }',
            '    }',
            '',
            '    if (portText != \'\') {',
            '        for c in portText {',
            '            if (c < \'0\' or c > \'9\') { return None }',
            '        }',
            '',
            '        if (portText.length() > 5) { return None }',
            '',
            '        port = match (int(portText)) {',
            '            Ok(number) => number',
            '            Err(_) => return None',
            '        }',
            '',
            '        if (port > 65535) { return None }',
            '    }',
            '',
            '    host = host.lower()',
            '',
            '    if (host == \'\') { return None }',
            '',
            '    for c in host {',
            '        if (forbiddenInHost(c)) { return None }',
            '    }',
            '',
            '    // The path (`\\` is `/` in a URL of HTTP), then the query, without the fragment.',
            '    mut pathEnd = authorityEnd',
            '',
            '    while (pathEnd < chars.length() and chars[pathEnd] != \'?\' and chars[pathEnd] != \'#\') {',
            '        pathEnd += 1',
            '    }',
            '',
            '    mut path = normalizedPath(encoded(url[authorityEnd..pathEnd].replace(\'\\\\\', \'/\'), false))',
            '',
            '    if (path == \'\') { path = \'/\' }',
            '',
            '    mut query = \'\'',
            '',
            '    if (pathEnd < chars.length() and chars[pathEnd] == \'?\') {',
            '        mut queryEnd = pathEnd',
            '',
            '        while (queryEnd < chars.length() and chars[queryEnd] != \'#\') {',
            '            queryEnd += 1',
            '        }',
            '',
            '        query = encoded(url[pathEnd..queryEnd], true)',
            '    }',
            '',
            '    immut shownHost = if (host.indexOf(\':\') is Some) { `[${host}]` } else { host }',
            '    immut hostAndPort = if (port == defaultPort) { shownHost } else { `${shownHost}:${port}` }',
            '    return Some({ secure: secure, host: host, port: port, target: path + query, authority: hostAndPort, text: `${scheme}://${hostAndPort}${path}${query}` })',
            '}',
            '',
            '// The characters that end the host and the port of a URL.',
            'function endsAuthority(c: char): boolean {',
            '    return c == \'/\' or c == \'\\\\\' or c == \'?\' or c == \'#\'',
            '}',
            '',
            '// The characters a host cannot have.',
            'function forbiddenInHost(c: char): boolean {',
            '    return c.code() <= 0x20 or c == \'#\' or c == \'%\' or c == \'/\' or c == \'<\' or c == \'>\' or c == \'?\' or c == \'@\' or c == \'\\\\\' or c == \'^\' or c == \'|\'',
            '}',
            '',
            'function isLetter(c: char): boolean {',
            '    return (c >= \'a\' and c <= \'z\') or (c >= \'A\' and c <= \'Z\')',
            '}',
            '',
            '// Without the control characters and spaces at both ends.',
            'function trimControls(text: string): string {',
            '    immut chars = text.chars()',
            '    mut start = 0',
            '    mut end = chars.length()',
            '',
            '    while (start < end and chars[start].code() <= 0x20) {',
            '        start += 1',
            '    }',
            '',
            '    while (end > start and chars[end - 1].code() <= 0x20) {',
            '        end -= 1',
            '    }',
            '',
            '    return text[start..end]',
            '}',
            '',
            'function lastIndexOf(text: string, c: char): Option[int] {',
            '    immut chars = text.chars()',
            '    mut i = chars.length() - 1',
            '',
            '    while (i >= 0) {',
            '        if (chars[i] == c) { return Some(i) }',
            '',
            '        i -= 1',
            '    }',
            '',
            '    return None',
            '}',
            '',
            '// `text` with the characters that cannot be in a path (or a query) as `%XX` of their UTF-8 bytes.',
            'function encoded(text: string, inQuery: boolean): string {',
            '    mut out = \'\'',
            '',
            '    for c in text {',
            '        immut code = c.code()',
            '        immut kept = code > 0x20 and code < 0x7F and c != \'"\' and c != \'<\' and c != \'>\' and c != \'`\' and (inQuery or (c != \'{\' and c != \'}\')) and not (inQuery and c == \'\\\'\')',
            '',
            '        if (kept) {',
            '            out += string(c)',
            '            continue',
            '        }',
            '',
            '        for b in utf8Of(c) {',
            '            out += \'%\' + hexByte(b)',
            '        }',
            '    }',
            '',
            '    return out',
            '}',
            '',
            'function hexByte(b: int): string {',
            '    immut digits = \'0123456789ABCDEF\'',
            '    return digits[b / 16..b / 16 + 1] + digits[b % 16..b % 16 + 1]',
            '}',
            '',
            'function utf8Of(c: char): int[] {',
            '    immut code = c.code()',
            '',
            '    if (code < 0x80) { return [code] }',
            '',
            '    if (code < 0x800) { return [0xC0 | (code >> 6), 0x80 | (code & 0x3F)] }',
            '',
            '    if (code < 0x10000) { return [0xE0 | (code >> 12), 0x80 | ((code >> 6) & 0x3F), 0x80 | (code & 0x3F)] }',
            '',
            '    return [0xF0 | (code >> 18), 0x80 | ((code >> 12) & 0x3F), 0x80 | ((code >> 6) & 0x3F), 0x80 | (code & 0x3F)]',
            '}',
            '',
            '// A path without its segments `.` and `..` (as `%2e` too).',
            'function normalizedPath(path: string): string {',
            '    if (path == \'\') { return \'\' }',
            '',
            '    immut parts = path.split(\'/\')',
            '    mut kept: string[] = []',
            '',
            '    for i in range(1, parts.length()) {',
            '        immut part = parts[i].lower()',
            '        immut last = i == parts.length() - 1',
            '',
            '        if (part == \'.\' or part == \'%2e\') {',
            '            if (last) { kept.push(\'\') }',
            '',
            '            continue',
            '        }',
            '',
            '        if (part == \'..\' or part == \'.%2e\' or part == \'%2e.\' or part == \'%2e%2e\') {',
            '            if (kept.length() > 0) { kept.pop() }',
            '',
            '            if (last) { kept.push(\'\') }',
            '',
            '            continue',
            '        }',
            '',
            '        kept.push(parts[i])',
            '    }',
            '',
            '    return \'/\' + kept.join(\'/\')',
            '}',
            '',
            '// The URL of a redirect: `location` against the URL it came from.',
            'function joinUrl(base: Url, location: string): Option[Url] {',
            '    immut trimmed = trimControls(location)',
            '    immut scheme = if (base.secure) { \'https\' } else { \'http\' }',
            '',
            '    if (hasScheme(trimmed)) { return parseUrl(trimmed) }',
            '',
            '    if (trimmed.startsWith(\'//\') or trimmed.startsWith(\'\\\\\\\\\')) { return parseUrl(`${scheme}:${trimmed}`) }',
            '',
            '    immut origin = `${scheme}://${base.authority}`',
            '',
            '    if (trimmed.startsWith(\'/\') or trimmed.startsWith(\'\\\\\')) { return parseUrl(origin + trimmed) }',
            '',
            '    immut path = match (base.target.indexOf(\'?\')) {',
            '        Some(question) => base.target[..question]',
            '        None => base.target',
            '    }',
            '',
            '    if (trimmed.startsWith(\'?\')) { return parseUrl(origin + path + trimmed) }',
            '',
            '    if (trimmed.startsWith(\'#\') or trimmed == \'\') { return parseUrl(origin + base.target) }',
            '',
            '    immut directory = match (lastIndexOf(path, \'/\')) {',
            '        Some(slash) => path[..slash + 1]',
            '        None => \'/\'',
            '    }',
            '    return parseUrl(origin + directory + trimmed)',
            '}',
            '',
            'function hasScheme(text: string): boolean {',
            '    immut chars = text.chars()',
            '',
            '    if (chars.length() == 0 or not isLetter(chars[0])) { return false }',
            '',
            '    for c in chars {',
            '        if (c == \':\') { return true }',
            '',
            '        if (not (isLetter(c) or (c >= \'0\' and c <= \'9\') or c == \'+\' or c == \'-\' or c == \'.\')) { return false }',
            '    }',
            '',
            '    return false',
            '}',
        ].join('\n'))
    }

    if (name == 'json') {
        return Some([
            '// The `json` module: JSON text to `Json` values and back (see doc/standard-library/json.md).',
            '',
            '// A JSON value. A number without `.`, `e` or `E` is an `Int`; the others are `Decimal`, exactly as',
            '// written (rounded beyond 34 significant digits).',
            'export type Json = {',
            '    Null',
            '    Bool(value: boolean)',
            '    Int(value: int)',
            '    Decimal(value: decimal)',
            '    String(value: string)',
            '    Array(items: Json[])',
            '    Object(fields: Map[string, Json])',
            '}',
            '',
            '// The fields of an object, in the order they first appear.',
            'export type JsonObject = Map[string, Json]',
            '',
            'export type JsonError = {',
            '    Syntax(message: string, line: int, column: int)',
            '    // An integer too large for an int.',
            '    NumberOutOfRange(text: string, line: int, column: int)',
            '}',
            '',
            'function JsonError.display(self): string {',
            '    return match (self) {',
            '        Syntax(message, line, column) => `invalid JSON at line ${line}, column ${column}: ${message}`',
            '        NumberOutOfRange(text, line, column) => `the number ${text} at line ${line}, column ${column} is too large`',
            '    }',
            '}',
            '',
            '// Why a text is not JSON, and where (a position in its characters).',
            'type Failure = {',
            '    BadSyntax(message: string, position: int)',
            '    BadNumber(text: string, position: int)',
            '}',
            '',
            'type Parser = {',
            '    chars: char[]',
            '    position: int',
            '}',
            '',
            '// The `Json` value that `text` writes.',
            'export function parse(text: string): Result[Json, JsonError] {',
            '    mut parser: Parser = { chars: text.chars(), position: 0 }',
            '',
            '    match (parser.value()) {',
            '        Ok(value) => {',
            '            parser.skipWhitespace()',
            '',
            '            if (parser.position == parser.chars.length()) { return Ok(value) }',
            '',
            '            return Err(located(parser.chars, BadSyntax(\'unexpected character after the JSON value\', parser.position)))',
            '        }',
            '        Err(failure) => return Err(located(parser.chars, failure))',
            '    }',
            '}',
            '',
            '// The error of a failure, with the line and column of its position.',
            'function located(chars: char[], failure: Failure): JsonError {',
            '    immut position = match (failure) {',
            '        BadSyntax(_, at) => at',
            '        BadNumber(_, at) => at',
            '    }',
            '    immut end = if (position < chars.length()) { position } else { chars.length() }',
            '    mut line = 1',
            '    mut column = 1',
            '',
            '    for i in range(end) {',
            '        if (chars[i] == \'\\n\') {',
            '            line += 1',
            '            column = 1',
            '        } else {',
            '            column += 1',
            '        }',
            '    }',
            '',
            '    return match (failure) {',
            '        BadSyntax(message, _) => Syntax(message, line, column)',
            '        BadNumber(text, _) => NumberOutOfRange(text, line, column)',
            '    }',
            '}',
            '',
            'function Parser.syntax(self, message: string): Failure {',
            '    return BadSyntax(message, self.position)',
            '}',
            '',
            '// The character at the position, if there is one.',
            'function Parser.current(self): Option[char] {',
            '    if (self.position < self.chars.length()) { return Some(self.chars[self.position]) }',
            '',
            '    return None',
            '}',
            '',
            'function Parser.at(self, c: char): boolean {',
            '    return self.position < self.chars.length() and self.chars[self.position] == c',
            '}',
            '',
            'function Parser.skipWhitespace(mut self) {',
            '    while (self.position < self.chars.length() and string(self.chars[self.position]).isSpace()) {',
            '        self.position += 1',
            '    }',
            '}',
            '',
            'function Parser.expect(mut self, c: char): Result[void, Failure] {',
            '    self.skipWhitespace()',
            '',
            '    if (not self.at(c)) { return Err(self.syntax(`expected \'${c}\'`)) }',
            '',
            '    self.position += 1',
            '    return Ok()',
            '}',
            '',
            'function Parser.literal(mut self, word: string, value: Json): Result[Json, Failure] {',
            '    for c in word {',
            '        if (not self.at(c)) { return Err(self.syntax(\'invalid literal\')) }',
            '',
            '        self.position += 1',
            '    }',
            '',
            '    return Ok(value)',
            '}',
            '',
            'function Parser.value(mut self): Result[Json, Failure] {',
            '    self.skipWhitespace()',
            '',
            '    immut c = match (self.current()) {',
            '        Some(found) => found',
            '        None => return Err(self.syntax(\'unexpected end of input\'))',
            '    }',
            '',
            '    if (c == \'{\') { return self.object() }',
            '',
            '    if (c == \'[\') { return self.array() }',
            '',
            '    if (c == \'"\') { return Ok(String(self.string()?)) }',
            '',
            '    if (c == \'t\') { return self.literal(\'true\', Bool(true)) }',
            '',
            '    if (c == \'f\') { return self.literal(\'false\', Bool(false)) }',
            '',
            '    if (c == \'n\') { return self.literal(\'null\', Null) }',
            '',
            '    if (c == \'-\' or (c >= \'0\' and c <= \'9\')) { return self.number() }',
            '',
            '    return Err(self.syntax(`unexpected character \'${c}\'`))',
            '}',
            '',
            '// An object; a repeated key keeps its first position and its last value, like a map.',
            'function Parser.object(mut self): Result[Json, Failure] {',
            '    self.position += 1',
            '    mut fields: JsonObject = [:]',
            '    self.skipWhitespace()',
            '',
            '    if (self.at(\'}\')) {',
            '        self.position += 1',
            '        return Ok(Object(fields))',
            '    }',
            '',
            '    while (true) {',
            '        self.skipWhitespace()',
            '        immut key = self.string()?',
            '        self.expect(\':\')?',
            '        fields[key] = self.value()?',
            '        self.skipWhitespace()',
            '',
            '        if (self.at(\',\')) {',
            '            self.position += 1',
            '            continue',
            '        }',
            '',
            '        if (self.at(\'}\')) {',
            '            self.position += 1',
            '            return Ok(Object(fields))',
            '        }',
            '',
            '        return Err(self.syntax("expected \',\' or \'}\'"))',
            '    }',
            '',
            '    return Ok(Object(fields))',
            '}',
            '',
            'function Parser.array(mut self): Result[Json, Failure] {',
            '    self.position += 1',
            '    mut items: Json[] = []',
            '    self.skipWhitespace()',
            '',
            '    if (self.at(\']\')) {',
            '        self.position += 1',
            '        return Ok(Array(items))',
            '    }',
            '',
            '    while (true) {',
            '        items.push(self.value()?)',
            '        self.skipWhitespace()',
            '',
            '        if (self.at(\',\')) {',
            '            self.position += 1',
            '            continue',
            '        }',
            '',
            '        if (self.at(\']\')) {',
            '            self.position += 1',
            '            return Ok(Array(items))',
            '        }',
            '',
            '        return Err(self.syntax("expected \',\' or \']\'"))',
            '    }',
            '',
            '    return Ok(Array(items))',
            '}',
            '',
            'function Parser.number(mut self): Result[Json, Failure] {',
            '    immut start = self.position',
            '    mut text = \'\'',
            '',
            '    while (self.position < self.chars.length() and isNumberChar(self.chars[self.position])) {',
            '        text += string(self.chars[self.position])',
            '        self.position += 1',
            '    }',
            '',
            '    if (not jsonNumber(text)) { return Err(BadSyntax(`invalid number \'${text}\'`, start)) }',
            '',
            '    if (not (\'.\' in text or \'e\' in text or \'E\' in text)) {',
            '        return match (int(text)) {',
            '            Ok(value) => Ok(Int(value))',
            '            Err(_) => Err(BadNumber(text, start))',
            '        }',
            '    }',
            '',
            '    return match (decimal(text)) {',
            '        Ok(value) => Ok(Decimal(value))',
            '        Err(OutOfRange(_)) => Err(BadNumber(text, start))',
            '        Err(_) => Err(BadSyntax(`invalid number \'${text}\'`, start))',
            '    }',
            '}',
            '',
            'function isNumberChar(c: char): boolean {',
            '    return (c >= \'0\' and c <= \'9\') or c == \'-\' or c == \'+\' or c == \'.\' or c == \'e\' or c == \'E\'',
            '}',
            '',
            '// Whether `text` is a number by the grammar of JSON:',
            '// `-? (0 | [1-9][0-9]*) (. [0-9]+)? ([eE] [+-]? [0-9]+)?`.',
            'function jsonNumber(text: string): boolean {',
            '    immut chars = text.chars()',
            '    mut i = 0',
            '',
            '    if (i < chars.length() and chars[i] == \'-\') { i += 1 }',
            '',
            '    immut first = i',
            '    i = digitsFrom(chars, i)',
            '',
            '    if (i == first or (chars[first] == \'0\' and i - first > 1)) { return false }',
            '',
            '    if (i < chars.length() and chars[i] == \'.\') {',
            '        immut fraction = i + 1',
            '        i = digitsFrom(chars, fraction)',
            '',
            '        if (i == fraction) { return false }',
            '    }',
            '',
            '    if (i < chars.length() and (chars[i] == \'e\' or chars[i] == \'E\')) {',
            '        i += 1',
            '',
            '        if (i < chars.length() and (chars[i] == \'+\' or chars[i] == \'-\')) { i += 1 }',
            '',
            '        immut exponent = i',
            '        i = digitsFrom(chars, exponent)',
            '',
            '        if (i == exponent) { return false }',
            '    }',
            '',
            '    return i == chars.length()',
            '}',
            '',
            '// The position after the digits from `start`.',
            'function digitsFrom(chars: char[], start: int): int {',
            '    mut i = start',
            '',
            '    while (i < chars.length() and chars[i] >= \'0\' and chars[i] <= \'9\') {',
            '        i += 1',
            '    }',
            '',
            '    return i',
            '}',
            '',
            'function Parser.string(mut self): Result[string, Failure] {',
            '    if (not self.at(\'"\')) { return Err(self.syntax(\'expected a string\')) }',
            '',
            '    self.position += 1',
            '    mut out = \'\'',
            '',
            '    while (true) {',
            '        immut c = match (self.current()) {',
            '            Some(found) => found',
            '            None => return Err(self.syntax(\'unterminated string\'))',
            '        }',
            '',
            '        if (c == \'"\') {',
            '            self.position += 1',
            '            return Ok(out)',
            '        }',
            '',
            '        if (c != \'\\\\\') {',
            '            out += string(c)',
            '            self.position += 1',
            '            continue',
            '        }',
            '',
            '        self.position += 1',
            '        immut escaped = self.current()',
            '        self.position += 1',
            '',
            '        match (escaped) {',
            '            Some(\'n\') => out += \'\\n\'',
            '            Some(\'t\') => out += \'\\t\'',
            '            Some(\'r\') => out += \'\\r\'',
            '            Some(\'b\') => out += string(charOf(8))',
            '            Some(\'f\') => out += string(charOf(12))',
            '            Some(\'u\') => out += string(self.unicodeEscape()?)',
            '            Some(other) => out += string(other)',
            '            None => return Err(self.syntax(\'unterminated string\'))',
            '        }',
            '    }',
            '',
            '    return Ok(out)',
            '}',
            '',
            '// The character of `\\uXXXX` (the `\\u` read), with the low half of a surrogate pair after it.',
            'function Parser.unicodeEscape(mut self): Result[char, Failure] {',
            '    immut code = self.hex4()?',
            '',
            '    if (code >= 55296 and code < 56320 and self.at(\'\\\\\') and self.position + 1 < self.chars.length() and self.chars[self.position + 1] == \'u\') {',
            '        self.position += 2',
            '        immut low = self.hex4()?',
            '        return Ok(charOf(65536 + (code - 55296) * 1024 + (low - 56320)))',
            '    }',
            '',
            '    return Ok(charOf(code))',
            '}',
            '',
            '// The character with `code`, or U+FFFD if there is none.',
            'function charOf(code: int): char {',
            '    return match (char(code)) {',
            '        Some(c) => c',
            '        None => match (char(65533)) {',
            '            Some(replacement) => replacement',
            '            None => \' \'',
            '        }',
            '    }',
            '}',
            '',
            '// Four hexadecimal digits.',
            'function Parser.hex4(mut self): Result[int, Failure] {',
            '    mut text = \'\'',
            '    mut value = 0',
            '    mut valid = true',
            '',
            '    for i in range(4) {',
            '        if (self.position + i >= self.chars.length()) {',
            '            valid = false',
            '            break',
            '        }',
            '',
            '        immut c = self.chars[self.position + i]',
            '        text += string(c)',
            '',
            '        match (\'0123456789abcdef\'.indexOf(string(c).lower())) {',
            '            Some(digit) => value = value * 16 + digit',
            '            None => valid = false',
            '        }',
            '    }',
            '',
            '    if (not valid) { return Err(self.syntax(`invalid escape \'\\\\u${text}\'`)) }',
            '',
            '    self.position += 4',
            '    return Ok(value)',
            '}',
            '',
            '// The JSON text of `value`. A `Decimal` always has a point or an exponent, so that it is read back',
            '// as a decimal.',
            'export function stringify(value: Json): string {',
            '    mut out = \'\'',
            '    write(value, mut out)',
            '    return out',
            '}',
            '',
            'function write(value: Json, mut out: string) {',
            '    match (value) {',
            '        Null => out += \'null\'',
            '        Bool(flag) => out += string(flag)',
            '        Int(number) => out += string(number)',
            '        Decimal(number) => {',
            '            immut text = string(number)',
            '            out += text',
            '',
            '            if (not (\'.\' in text or \'e\' in text)) { out += \'.0\' }',
            '        }',
            '        String(text) => writeString(text, mut out)',
            '        Array(items) => {',
            '            out += \'[\'',
            '',
            '            for i in range(items.length()) {',
            '                if (i > 0) { out += \',\' }',
            '',
            '                write(items[i], mut out)',
            '            }',
            '',
            '            out += \']\'',
            '        }',
            '        Object(fields) => {',
            '            out += \'{\'',
            '            mut first = true',
            '',
            '            for key in fields.keys() {',
            '                if (not first) { out += \',\' }',
            '',
            '                first = false',
            '                writeString(key, mut out)',
            '                out += \':\'',
            '                write(fields[key], mut out)',
            '            }',
            '',
            '            out += \'}\'',
            '        }',
            '    }',
            '}',
            '',
            '// A string in JSON, with its escapes.',
            'function writeString(text: string, mut out: string) {',
            '    out += \'"\'',
            '',
            '    for c in text {',
            '        if (c == \'"\') {',
            '            out += \'\\\\"\'',
            '        } else {',
            '            if (c == \'\\\\\') {',
            '                out += \'\\\\\\\\\'',
            '            } else {',
            '                out += escape(c)',
            '            }',
            '        }',
            '    }',
            '',
            '    out += \'"\'',
            '}',
            '',
            'function escape(c: char): string {',
            '    if (c == \'\\n\') { return \'\\\\n\' }',
            '',
            '    if (c == \'\\r\') { return \'\\\\r\' }',
            '',
            '    if (c == \'\\t\') { return \'\\\\t\' }',
            '',
            '    immut code = c.code()',
            '',
            '    if (code < 32) { return `\\\\u00${\'0123456789abcdef\'[code / 16]}${\'0123456789abcdef\'[code % 16]}` }',
            '',
            '    return string(c)',
            '}',
            '',
            '// The field `key` of an object, or `None`.',
            'export function get(value: Json, key: string): Option[Json] {',
            '    return match (value) {',
            '        Object(fields) => fields.get(key)',
            '        _ => None',
            '    }',
            '}',
            '',
            'export function asString(value: Json): Option[string] {',
            '    return match (value) {',
            '        String(text) => Some(text)',
            '        _ => None',
            '    }',
            '}',
            '',
            'export function asInt(value: Json): Option[int] {',
            '    return match (value) {',
            '        Int(number) => Some(number)',
            '        _ => None',
            '    }',
            '}',
            '',
            '// The number of a `Decimal`, or of an `Int` (many writers write `3.0` as `3`).',
            'export function asDecimal(value: Json): Option[decimal] {',
            '    return match (value) {',
            '        Decimal(number) => Some(number)',
            '        Int(number) => Some(decimal(number))',
            '        _ => None',
            '    }',
            '}',
            '',
            'export function asBool(value: Json): Option[boolean] {',
            '    return match (value) {',
            '        Bool(flag) => Some(flag)',
            '        _ => None',
            '    }',
            '}',
        ].join('\n'))
    }

    if (name == 'math') {
        return Some([
            '// The `math` module: mathematical functions and constants (see doc/standard-library/math.md).',
            '// `abs`, `sqrt`, `pow`, `floor`, `ceil` and `round` take an int, a decimal or a float: the compiler',
            '// checks their arguments and calls the function below for their type (`math.abs(-2)` is',
            '// `absInt(-2, here)`), with the place of the call, where their panics are.',
            '',
            'import { CInt, Location, panicAt } from \'koji:unsafe\'',
            '',
            '// The functions of C (`libm`) for floats.',
            'extern function fabs(x: float): float',
            'extern function sqrt(x: float): float',
            'extern function pow(base: float, exponent: float): float',
            'extern function floor(x: float): float',
            'extern function ceil(x: float): float',
            'extern function round(x: float): float',
            '',
            '// The decimals of the runtime, and the conversions to an int that panic at `here`: `mode` is 0 to',
            '// round down, 1 up and 2 to the nearest.',
            'extern function koji_decimal_abs(value: decimal): decimal',
            'extern function koji_decimal_sqrt(value: decimal): decimal',
            'extern function koji_decimal_power(base: decimal, exponent: decimal, here: Location): decimal',
            'extern function koji_decimal_to_int(value: decimal, mode: CInt, here: Location): int',
            'extern function koji_std_float_to_int(value: float, here: Location): int',
            '',
            '// π and e, with 34 digits.',
            'export immut pi = 3.141592653589793238462643383279503',
            'export immut e = 2.718281828459045235360287471352662',
            '',
            'export type MathError = {',
            '    // The result exists only in the complex numbers: `sqrt(-1)`.',
            '    Complex',
            '    // An indeterminate form (no function returns it yet).',
            '    Indeterminate',
            '    // The result is infinite: `pow(0, -1)`.',
            '    Infinite',
            '}',
            '',
            'function MathError.display(self): string {',
            '    return match (self) {',
            '        Complex => \'the result is not a real number (it is complex)\'',
            '        Indeterminate => \'the result is indeterminate\'',
            '        Infinite => \'the result is infinite\'',
            '    }',
            '}',
            '',
            '// The largest float, beyond which a result does not fit.',
            'immut largestFloat = float(1.7976931348623157e308)',
            '',
            'function absInt(value: int, here: Location): int {',
            '    if (value >= 0) { return value }',
            '',
            '    if (value < -9223372036854775807) { panicAt(here, \'integer overflow\') }',
            '',
            '    return -value',
            '}',
            '',
            'function absFloat(value: float, here: Location): float {',
            '    return fabs(value)',
            '}',
            '',
            'function absDecimal(value: decimal, here: Location): decimal {',
            '    return koji_decimal_abs(value)',
            '}',
            '',
            '// The root of an int is a decimal, correctly rounded.',
            'function sqrtDecimal(value: decimal, here: Location): Result[decimal, MathError] {',
            '    if (value < 0) { return Err(Complex) }',
            '',
            '    return Ok(koji_decimal_sqrt(value))',
            '}',
            '',
            'function sqrtFloat(value: float, here: Location): Result[float, MathError] {',
            '    if (value < 0) { return Err(Complex) }',
            '',
            '    return Ok(sqrt(value))',
            '}',
            '',
            '// `pow(0, 0)` is 1, the value of the expression (only the limit form is indeterminate).',
            'function powDecimal(base: decimal, exponent: decimal, here: Location): Result[decimal, MathError] {',
            '    if (base == 0 and exponent < 0) { return Err(Infinite) }',
            '',
            '    if (base < 0 and not isInt(exponent)) { return Err(Complex) }',
            '',
            '    return Ok(koji_decimal_power(base, exponent, here))',
            '}',
            '',
            'function powFloat(base: float, exponent: float, here: Location): Result[float, MathError] {',
            '    if (base < 0 and floor(exponent) != exponent) { return Err(Complex) }',
            '',
            '    if (base == 0 and exponent < 0) { return Err(Infinite) }',
            '',
            '    immut power = pow(base, exponent)',
            '',
            '    if (power > largestFloat or power < -largestFloat) { panicAt(here, \'float overflow\') }',
            '',
            '    return Ok(power)',
            '}',
            '',
            'function floorDecimal(value: decimal, here: Location): int {',
            '    return koji_decimal_to_int(value, 0, here)',
            '}',
            '',
            'function ceilDecimal(value: decimal, here: Location): int {',
            '    return koji_decimal_to_int(value, 1, here)',
            '}',
            '',
            '// Halfway cases away from zero: `round(2.5)` is 3.',
            'function roundDecimal(value: decimal, here: Location): int {',
            '    return koji_decimal_to_int(value, 2, here)',
            '}',
            '',
            'function floorFloat(value: float, here: Location): int {',
            '    return koji_std_float_to_int(floor(value), here)',
            '}',
            '',
            'function ceilFloat(value: float, here: Location): int {',
            '    return koji_std_float_to_int(ceil(value), here)',
            '}',
            '',
            'function roundFloat(value: float, here: Location): int {',
            '    return koji_std_float_to_int(round(value), here)',
            '}',
            '',
            '// Whether `value` is an int (an exponent that a negative base can take).',
            'function isInt(value: decimal): boolean {',
            '    if (value < -9223372036854775807 or value > 9223372036854775807) { return false }',
            '',
            '    return decimal(int(value)) == value',
            '}',
        ].join('\n'))
    }

    if (name == 'path') {
        return Some([
            '// The `path` module: paths as text, without the disk (see doc/standard-library/path.md). A path is',
            '// a sequence of parts separated by `/`; repeated separators and `.` after the first part count for',
            '// nothing (`a//b/./c` is `a/b/c`), and a path that starts with `/` starts at the root.',
            '',
            '// `base` followed by `part`, with a separator between them; an absolute `part` replaces `base`.',
            'export function join(base: string, part: string): string {',
            '    if (part.startsWith(\'/\')) { return part }',
            '',
            '    if (base == \'\' or base.endsWith(\'/\')) { return base + part }',
            '',
            '    return `${base}/${part}`',
            '}',
            '',
            '// The directory that contains `path`: `.` for a name alone; the root has none.',
            'export function parent(path: string): Option[string] {',
            '    immut chars = path.chars()',
            '    immut end = trimmedEnd(chars, chars.length())',
            '',
            '    if (end == 0 or (end == 1 and chars[0] == \'/\')) { return None }',
            '',
            '    immut start = partStart(chars, end)',
            '    immut before = trimmedEnd(chars, start)',
            '',
            '    if (before == 0) { return Some(\'.\') }',
            '',
            '    return Some(path[..before])',
            '}',
            '',
            '// The last part of `path`, if it is a name (not the root, `.` or `..`).',
            'export function name(path: string): Option[string] {',
            '    immut chars = path.chars()',
            '    immut end = trimmedEnd(chars, chars.length())',
            '',
            '    if (end == 0 or (end == 1 and chars[0] == \'/\')) { return None }',
            '',
            '    immut start = partStart(chars, end)',
            '    immut last = path[start..end]',
            '',
            '    if (last == \'.\' or last == \'..\') { return None }',
            '',
            '    return Some(last)',
            '}',
            '',
            '// The name without its extension (`.bashrc` has none).',
            'export function stem(path: string): Option[string] {',
            '    return match (name(path)) {',
            '        Some(found) => {',
            '            immut dot = lastDot(found)',
            '',
            '            if (dot <= 0) { return Some(found) }',
            '',
            '            Some(found[..dot])',
            '        }',
            '        None => None',
            '    }',
            '}',
            '',
            '// The extension of the name, without the dot (`\'\'` for `a.`).',
            'export function extension(path: string): Option[string] {',
            '    return match (name(path)) {',
            '        Some(found) => {',
            '            immut dot = lastDot(found)',
            '',
            '            if (dot <= 0) { return None }',
            '',
            '            Some(found[dot + 1..])',
            '        }',
            '        None => None',
            '    }',
            '}',
            '',
            '// Whether `path` starts at the root.',
            'export function isAbsolute(path: string): boolean {',
            '    return path.startsWith(\'/\')',
            '}',
            '',
            '// The end of `chars[..end]` without the separators and the `.` parts that end it (but the root,',
            '// and a `.` that starts the path).',
            'function trimmedEnd(chars: char[], end: int): int {',
            '    mut at = end',
            '',
            '    while (at > 0) {',
            '        if (chars[at - 1] == \'/\' and at > 1) {',
            '            at -= 1',
            '            continue',
            '        }',
            '',
            '        if (chars[at - 1] == \'.\' and at > 1 and chars[at - 2] == \'/\') {',
            '            at -= 1',
            '            continue',
            '        }',
            '',
            '        break',
            '    }',
            '',
            '    return at',
            '}',
            '',
            '// Where the part that ends at `end` starts: after the separator before it.',
            'function partStart(chars: char[], end: int): int {',
            '    mut at = end',
            '',
            '    while (at > 0 and chars[at - 1] != \'/\') {',
            '        at -= 1',
            '    }',
            '',
            '    return at',
            '}',
            '',
            '// The position of the last `.` of `text`, or -1.',
            'function lastDot(text: string): int {',
            '    mut found = -1',
            '    mut position = 0',
            '',
            '    for c in text {',
            '        if (c == \'.\') { found = position }',
            '',
            '        position += 1',
            '    }',
            '',
            '    return found',
            '}',
        ].join('\n'))
    }

    if (name == 'regex') {
        return Some([
            '// The `regex` module: regular expressions (see doc/standard-library/regex.md). A pattern is parsed',
            '// into a tree, compiled into a program for a Pike machine (a Thompson automaton run with one',
            '// thread per state), and matched in a time proportional to the length of the text: no',
            '// backtracking. The first match is the leftmost one, and among those the one that the pattern',
            '// prefers (the first branch of `|`, the longest repetition unless it is lazy).',
            '',
            '// A compiled regular expression: built by `compile` only.',
            'export opaque type Regex = {',
            '    pattern: string',
            '    program: Instruction[]',
            '    // The capture groups, the whole match being group 0, and the names of the named ones.',
            '    groups: int',
            '    names: Map[string, int]',
            '    // The program can only match at the start of the text (`^...`, `\\A...`).',
            '    anchored: boolean',
            '    // The instructions that can read the first character of a match, when every match reads one',
            '    // (`prefilter`): a search skips the positions where none of them matches.',
            '    firsts: Instruction[]',
            '    prefilter: boolean',
            '}',
            '',
            '// A match: its text and its positions in characters (`end` excluded).',
            'export type Match = {',
            '    value: string',
            '    start: int',
            '    end: int',
            '}',
            '',
            'export type RegexError = {',
            '    // The syntax is wrong: `(abc`.',
            '    InvalidPattern(pattern: string, message: string)',
            '    // Valid, but not supported: look-around, backreferences.',
            '    Unsupported(pattern: string, message: string)',
            '    // Too large to compile: `a{1000}{1000}`.',
            '    TooLarge(pattern: string)',
            '}',
            '',
            'function RegexError.display(self): string {',
            '    return match (self) {',
            '        InvalidPattern(pattern, message) => `invalid regular expression \'${pattern}\': ${message}`',
            '        Unsupported(pattern, message) => `unsupported regular expression \'${pattern}\': ${message}`',
            '        TooLarge(pattern) => `regular expression \'${pattern}\' is too large`',
            '    }',
            '}',
            '',
            'function Regex.display(self): string {',
            '    return `<regex \'${self.pattern}\'>`',
            '}',
            '',
            '// The tree of a pattern.',
            'type Node = {',
            '    Empty',
            '    // A character, compared without case when `fold`.',
            '    Literal(c: char, fold: boolean)',
            '    // `.`: any character, or any but a line break.',
            '    Dot(all: boolean)',
            '    Set(set: CharClass, fold: boolean)',
            '    Look(kind: int)',
            '    Capture(index: int, inner: Node)',
            '    Concat(items: Node[])',
            '    Alternate(items: Node[])',
            '    // `max` -1 for no limit.',
            '    Repeat(inner: Node, min: int, max: int, greedy: boolean)',
            '}',
            '',
            '// The assertions (`Look`).',
            'immut startText = 0',
            'immut endText = 1',
            'immut startLine = 2',
            'immut endLine = 3',
            'immut wordBoundary = 4',
            'immut notWordBoundary = 5',
            'immut wordStart = 6',
            'immut wordEnd = 7',
            '',
            '// A set of characters (`[a-z]`, `\\d`): ranges of codes, classes of Unicode, and their unions,',
            '// intersections, differences and complements.',
            'type CharClass = {',
            '    Ranges(ranges: CharRange[])',
            '    Category(kind: int)',
            '    Union(items: CharClass[])',
            '    Intersect(left: CharClass, right: CharClass)',
            '    Subtract(left: CharClass, right: CharClass)',
            '    Either(left: CharClass, right: CharClass)',
            '    Complement(inner: CharClass)',
            '}',
            '',
            'type CharRange = {',
            '    low: int',
            '    high: int',
            '}',
            '',
            '// The classes of Unicode (`Category`).',
            'immut digitClass = 0',
            'immut wordClass = 1',
            'immut spaceClass = 2',
            'immut letterClass = 3',
            'immut upperClass = 4',
            'immut lowerClass = 5',
            'immut numberClass = 6',
            '',
            '// The instructions of the machine.',
            'type Instruction = {',
            '    // Consumes a character equal to `c` (without case when `fold`: `c` is lowercase).',
            '    CharIns(c: char, fold: boolean)',
            '    AnyIns(all: boolean)',
            '    SetIns(set: CharClass, fold: boolean)',
            '    // Continues at both, `first` preferred.',
            '    SplitIns(first: int, second: int)',
            '    JumpIns(target: int)',
            '    SaveIns(slot: int)',
            '    LookIns(kind: int)',
            '    MatchIns',
            '}',
            '',
            '// The modes of `(?imsxU)`.',
            'type Flags = {',
            '    fold: boolean',
            '    multiline: boolean',
            '    dotAll: boolean',
            '    extended: boolean',
            '    lazy: boolean',
            '}',
            '',
            'type Parser = {',
            '    pattern: string',
            '    chars: char[]',
            '    position: int',
            '    groups: int',
            '    names: Map[string, int]',
            '}',
            '',
            '// The most instructions a program may have.',
            'immut largest = 500000',
            '',
            '// The regular expression `pattern`, compiled.',
            'export function compile(pattern: string): Result[Regex, RegexError] {',
            '    mut parser: Parser = { pattern: pattern, chars: pattern.chars(), position: 0, groups: 1, names: [:] }',
            '    mut flags: Flags = { fold: false, multiline: false, dotAll: false, extended: false, lazy: false }',
            '    immut tree = parser.alternation(mut flags, 0)?',
            '',
            '    if (parser.position < parser.chars.length()) { return Err(parser.invalid(\'unopened group\')) }',
            '',
            '    if (size(tree) > largest) { return Err(TooLarge(pattern)) }',
            '',
            '    mut program: Instruction[] = [SaveIns(0)]',
            '    emit(tree, mut program)',
            '    program.push(SaveIns(1))',
            '    program.push(MatchIns)',
            '    mut firsts: Instruction[] = []',
            '    immut prefilter = firstInstructions(program, mut firsts)',
            '    return Ok({',
            '        pattern: pattern, program: program, groups: parser.groups, names: parser.names, anchored: startsAnchored(tree),',
            '        firsts: firsts, prefilter: prefilter',
            '    })',
            '}',
            '',
            '// The instructions that read the first character of a match, in `firsts`; false when a match can',
            '// read none (it is empty, or starts with an assertion).',
            'function firstInstructions(program: Instruction[], mut firsts: Instruction[]): boolean {',
            '    mut seen: boolean[] = []',
            '',
            '    for i in range(program.length()) {',
            '        seen.push(false)',
            '    }',
            '',
            '    mut pending = [0]',
            '',
            '    while (true) {',
            '        immut pc = match (pending.pop()) {',
            '            Some(found) => found',
            '            None => break',
            '        }',
            '',
            '        if (seen[pc]) { continue }',
            '',
            '        seen[pc] = true',
            '',
            '        match (program[pc]) {',
            '            JumpIns(target) => pending.push(target)',
            '            SplitIns(first, second) => {',
            '                pending.push(first)',
            '                pending.push(second)',
            '            }',
            '            SaveIns(_) => pending.push(pc + 1)',
            '            LookIns(_) => return false',
            '            MatchIns => return false',
            '            other => firsts.push(other)',
            '        }',
            '    }',
            '',
            '    return true',
            '}',
            '',
            '// Parsing',
            '',
            'function Parser.invalid(self, message: string): RegexError {',
            '    return InvalidPattern(self.pattern, message)',
            '}',
            '',
            'function Parser.unsupported(self, message: string): RegexError {',
            '    return Unsupported(self.pattern, message)',
            '}',
            '',
            'function Parser.done(self): boolean {',
            '    return self.position >= self.chars.length()',
            '}',
            '',
            'function Parser.peek(self): char {',
            '    return self.chars[self.position]',
            '}',
            '',
            'function Parser.at(self, c: char): boolean {',
            '    return self.position < self.chars.length() and self.chars[self.position] == c',
            '}',
            '',
            '// Spaces and `#` comments, in the extended mode `(?x)`.',
            'function Parser.skipExtended(mut self, flags: Flags) {',
            '    if (not flags.extended) { return }',
            '',
            '    while (not self.done()) {',
            '        immut c = self.peek()',
            '',
            '        if (c == \'#\') {',
            '            while (not self.done() and self.peek() != \'\\n\') {',
            '                self.position += 1',
            '            }',
            '',
            '            continue',
            '        }',
            '',
            '        if (not isSpace(c)) { return }',
            '',
            '        self.position += 1',
            '    }',
            '}',
            '',
            '// `a|b|c` until `)` (inside a group, `depth` > 0) or the end.',
            'function Parser.alternation(mut self, mut flags: Flags, depth: int): Result[Node, RegexError] {',
            '    mut branches = [self.concatenation(mut flags, depth)?]',
            '',
            '    while (self.at(\'|\')) {',
            '        self.position += 1',
            '        branches.push(self.concatenation(mut flags, depth)?)',
            '    }',
            '',
            '    if (branches.length() == 1) { return Ok(branches[0]) }',
            '',
            '    return Ok(Alternate(branches))',
            '}',
            '',
            'function Parser.concatenation(mut self, mut flags: Flags, depth: int): Result[Node, RegexError] {',
            '    mut items: Node[] = []',
            '',
            '    while (true) {',
            '        self.skipExtended(flags)',
            '',
            '        if (self.done() or self.at(\'|\')) { break }',
            '',
            '        if (self.at(\')\')) {',
            '            if (depth == 0) { return Err(self.invalid(\'unopened group\')) }',
            '',
            '            break',
            '        }',
            '',
            '        immut c = self.peek()',
            '',
            '        if (c == \'*\' or c == \'+\' or c == \'?\' or c == \'{\') {',
            '            if (items.length() == 0) { return Err(self.invalid(\'repetition operator missing expression\')) }',
            '',
            '            immut last = items.pop()',
            '',
            '            match (last) {',
            '                Some(node) => items.push(self.repetition(node, flags)?)',
            '                None => {}',
            '            }',
            '',
            '            continue',
            '        }',
            '',
            '        match (self.atom(mut flags, depth)?) {',
            '            Some(node) => items.push(node)',
            '            None => {}',
            '        }',
            '    }',
            '',
            '    if (items.length() == 0) { return Ok(Empty) }',
            '',
            '    if (items.length() == 1) { return Ok(items[0]) }',
            '',
            '    return Ok(Concat(items))',
            '}',
            '',
            '// `*`, `+`, `?` or `{n,m}` after `node`, and `?` for a lazy one.',
            'function Parser.repetition(mut self, node: Node, flags: Flags): Result[Node, RegexError] {',
            '    immut c = self.peek()',
            '    self.position += 1',
            '    mut min = 0',
            '    mut max = -1',
            '',
            '    if (c == \'+\') { min = 1 }',
            '',
            '    if (c == \'?\') { max = 1 }',
            '',
            '    if (c == \'{\') {',
            '        min = self.decimal()?',
            '        max = min',
            '',
            '        if (self.at(\',\')) {',
            '            self.position += 1',
            '            max = -1',
            '',
            '            if (not self.at(\'}\')) { max = self.decimal()? }',
            '        }',
            '',
            '        if (not self.at(\'}\')) { return Err(self.invalid(\'unclosed counted repetition\')) }',
            '',
            '        self.position += 1',
            '',
            '        if (max != -1 and min > max) { return Err(self.invalid(\'invalid repetition count range, the start must be <= the end\')) }',
            '    }',
            '',
            '    mut greedy = not flags.lazy',
            '',
            '    if (self.at(\'?\')) {',
            '        self.position += 1',
            '        greedy = not greedy',
            '    }',
            '',
            '    return Ok(Repeat(node, min, max, greedy))',
            '}',
            '',
            'function Parser.decimal(mut self): Result[int, RegexError] {',
            '    mut value = 0',
            '    mut digits = 0',
            '',
            '    while (not self.done() and self.peek() >= \'0\' and self.peek() <= \'9\') {',
            '        value = value * 10 + (self.peek().code() - 48)',
            '        digits += 1',
            '        self.position += 1',
            '',
            '        if (value > 4294967295) { return Err(self.invalid(\'repetition quantifier expects a valid decimal\')) }',
            '    }',
            '',
            '    if (digits == 0) {',
            '        if (self.done()) { return Err(self.invalid(\'unclosed counted repetition\')) }',
            '',
            '        return Err(self.invalid(\'repetition quantifier expects a valid decimal\'))',
            '    }',
            '',
            '    return Ok(value)',
            '}',
            '',
            '// One element: a character, a class, a group, an assertion. `None` for a group that only sets',
            '// flags (`(?i)`).',
            'function Parser.atom(mut self, mut flags: Flags, depth: int): Result[Option[Node], RegexError] {',
            '    immut c = self.peek()',
            '    self.position += 1',
            '',
            '    if (c == \'(\') { return self.group(mut flags, depth) }',
            '',
            '    if (c == \'[\') { return Ok(Some(Set(self.charClass()?, flags.fold))) }',
            '',
            '    if (c == \'.\') { return Ok(Some(Dot(flags.dotAll))) }',
            '',
            '    if (c == \'^\') { return Ok(Some(Look(if (flags.multiline) { startLine } else { startText }))) }',
            '',
            '    if (c == \'$\') { return Ok(Some(Look(if (flags.multiline) { endLine } else { endText }))) }',
            '',
            '    if (c == \'\\\\\') { return Ok(Some(self.escape(flags)?)) }',
            '',
            '    return Ok(Some(literal(c, flags.fold)))',
            '}',
            '',
            'function literal(c: char, fold: boolean): Node {',
            '    if (fold and lowered(c) != uppered(c)) { return Literal(lowered(c), true) }',
            '',
            '    return Literal(c, false)',
            '}',
            '',
            'function Parser.group(mut self, mut flags: Flags, depth: int): Result[Option[Node], RegexError] {',
            '    if (not self.at(\'?\')) {',
            '        immut index = self.groups',
            '        self.groups += 1',
            '        return Ok(Some(Capture(index, self.groupBody(flags, depth)?)))',
            '    }',
            '',
            '    self.position += 1',
            '',
            '    if (self.done()) { return Err(self.invalid(\'unclosed group\')) }',
            '',
            '    immut c = self.peek()',
            '',
            '    if (c == \'=\' or c == \'!\') { return Err(self.unsupported(\'look-around, including look-ahead and look-behind, is not supported\')) }',
            '',
            '    if (c == \'<\' and self.position + 1 < self.chars.length() and (self.chars[self.position + 1] == \'=\' or self.chars[self.position + 1] == \'!\')) {',
            '        return Err(self.unsupported(\'look-around, including look-ahead and look-behind, is not supported\'))',
            '    }',
            '',
            '    if (c == \'P\' and self.position + 1 < self.chars.length() and self.chars[self.position + 1] == \'=\') {',
            '        return Err(self.unsupported(\'backreferences are not supported\'))',
            '    }',
            '',
            '    // `(?P<name>...)` or `(?<name>...)`.',
            '    if (c == \'<\' or (c == \'P\' and self.position + 1 < self.chars.length() and self.chars[self.position + 1] == \'<\')) {',
            '        self.position += if (c == \'P\') { 2 } else { 1 }',
            '        immut name = self.groupName()?',
            '',
            '        if (self.names.has(name)) { return Err(self.invalid(\'duplicate capture group name\')) }',
            '',
            '        immut index = self.groups',
            '        self.groups += 1',
            '        self.names[name] = index',
            '        return Ok(Some(Capture(index, self.groupBody(flags, depth)?)))',
            '    }',
            '',
            '    // Flags, for the rest of the group (`(?i)`) or for a group of their own (`(?i:...)`).',
            '    mut changed = flags',
            '    mut negated = false',
            '',
            '    while (true) {',
            '        if (self.done()) { return Err(self.invalid(\'expected flag but got end of regex\')) }',
            '',
            '        immut flag = self.peek()',
            '        self.position += 1',
            '',
            '        if (flag == \')\') {',
            '            flags = changed',
            '            return Ok(None)',
            '        }',
            '',
            '        if (flag == \':\') { return Ok(Some(self.groupBody(changed, depth)?)) }',
            '',
            '        if (flag == \'-\') {',
            '            negated = true',
            '            continue',
            '        }',
            '',
            '        immut value = not negated',
            '',
            '        match (flag) {',
            '            \'i\' => changed.fold = value',
            '            \'m\' => changed.multiline = value',
            '            \'s\' => changed.dotAll = value',
            '            \'x\' => changed.extended = value',
            '            \'U\' => changed.lazy = value',
            '            \'u\' => {}',
            '            \'R\' => {}',
            '            _ => return Err(self.invalid(\'unrecognized flag\'))',
            '        }',
            '    }',
            '',
            '    return Ok(None)',
            '}',
            '',
            '// The pattern of a group, until its `)`; its flags end with it.',
            'function Parser.groupBody(mut self, flags: Flags, depth: int): Result[Node, RegexError] {',
            '    mut inner = flags',
            '    immut body = self.alternation(mut inner, depth + 1)?',
            '',
            '    if (not self.at(\')\')) { return Err(self.invalid(\'unclosed group\')) }',
            '',
            '    self.position += 1',
            '    return Ok(body)',
            '}',
            '',
            'function Parser.groupName(mut self): Result[string, RegexError] {',
            '    mut name = \'\'',
            '',
            '    while (true) {',
            '        if (self.done()) { return Err(self.invalid(\'unclosed capture group name\')) }',
            '',
            '        immut c = self.peek()',
            '        self.position += 1',
            '',
            '        if (c == \'>\') { break }',
            '',
            '        immut first = name == \'\'',
            '        immut valid = c == \'_\' or isAsciiLetter(c) or (not first and ((c >= \'0\' and c <= \'9\') or c == \'.\' or c == \'[\' or c == \']\'))',
            '',
            '        if (not valid) { return Err(self.invalid(\'invalid capture group character\')) }',
            '',
            '        name += string(c)',
            '    }',
            '',
            '    if (name == \'\') { return Err(self.invalid(\'empty capture group name\')) }',
            '',
            '    return Ok(name)',
            '}',
            '',
            '// After `\\`, outside a class.',
            'function Parser.escape(mut self, flags: Flags): Result[Node, RegexError] {',
            '    if (self.done()) { return Err(self.invalid(\'incomplete escape sequence, reached end of pattern prematurely\')) }',
            '',
            '    immut c = self.peek()',
            '',
            '    if (c >= \'1\' and c <= \'9\') { return Err(self.unsupported(\'backreferences are not supported\')) }',
            '',
            '    match (c) {',
            '        \'b\' => {',
            '            self.position += 1',
            '            return Ok(Look(wordBoundary))',
            '        }',
            '        \'B\' => {',
            '            self.position += 1',
            '            return Ok(Look(notWordBoundary))',
            '        }',
            '        \'A\' => {',
            '            self.position += 1',
            '            return Ok(Look(startText))',
            '        }',
            '        \'z\' => {',
            '            self.position += 1',
            '            return Ok(Look(endText))',
            '        }',
            '        \'<\' => {',
            '            self.position += 1',
            '            return Ok(Look(wordStart))',
            '        }',
            '        \'>\' => {',
            '            self.position += 1',
            '            return Ok(Look(wordEnd))',
            '        }',
            '        _ => {}',
            '    }',
            '',
            '    match (self.classEscape()?) {',
            '        Some(set) => return Ok(Set(set, flags.fold))',
            '        None => {}',
            '    }',
            '',
            '    return Ok(literal(self.escapedChar()?, flags.fold))',
            '}',
            '',
            '// `\\d`, `\\w`, `\\s`, `\\p{...}` and their complements, if the escape is one (after `\\`).',
            'function Parser.classEscape(mut self): Result[Option[CharClass], RegexError] {',
            '    immut c = self.peek()',
            '    immut kind = match (c) {',
            '        \'d\' => digitClass',
            '        \'D\' => digitClass',
            '        \'w\' => wordClass',
            '        \'W\' => wordClass',
            '        \'s\' => spaceClass',
            '        \'S\' => spaceClass',
            '        \'p\' => -1',
            '        \'P\' => -1',
            '        _ => return Ok(None)',
            '    }',
            '    self.position += 1',
            '    immut negated = c == \'D\' or c == \'W\' or c == \'S\' or c == \'P\'',
            '    mut set = Category(kind)',
            '',
            '    if (kind == -1) { set = self.property()? }',
            '',
            '    if (negated) { return Ok(Some(Complement(set))) }',
            '',
            '    return Ok(Some(set))',
            '}',
            '',
            '// `{Letter}` or `L` after `\\p`.',
            'function Parser.property(mut self): Result[CharClass, RegexError] {',
            '    mut name = \'\'',
            '',
            '    if (self.at(\'{\')) {',
            '        self.position += 1',
            '',
            '        while (not self.at(\'}\')) {',
            '            if (self.done()) { return Err(self.invalid(\'Unicode escape not closed\')) }',
            '',
            '            name += string(self.peek())',
            '            self.position += 1',
            '        }',
            '',
            '        self.position += 1',
            '    } else {',
            '        if (self.done()) { return Err(self.invalid(\'Unicode escape not closed\')) }',
            '',
            '        name = string(self.peek())',
            '        self.position += 1',
            '    }',
            '',
            '    immut kind = match (name.lower().replace(\'_\', \'\').replace(\' \', \'\')) {',
            '        \'l\' => letterClass',
            '        \'letter\' => letterClass',
            '        \'alphabetic\' => letterClass',
            '        \'alpha\' => letterClass',
            '        \'lu\' => upperClass',
            '        \'uppercaseletter\' => upperClass',
            '        \'uppercase\' => upperClass',
            '        \'upper\' => upperClass',
            '        \'ll\' => lowerClass',
            '        \'lowercaseletter\' => lowerClass',
            '        \'lowercase\' => lowerClass',
            '        \'lower\' => lowerClass',
            '        \'n\' => numberClass',
            '        \'number\' => numberClass',
            '        \'nd\' => digitClass',
            '        \'decimalnumber\' => digitClass',
            '        \'digit\' => digitClass',
            '        \'whitespace\' => spaceClass',
            '        \'space\' => spaceClass',
            '        _ => -1',
            '    }',
            '',
            '    if (kind == -1) { return Err(self.unsupported(`the Unicode property \'${name}\' is not supported`)) }',
            '',
            '    return Ok(Category(kind))',
            '}',
            '',
            '// The character of an escape that stands for one (after `\\`).',
            'function Parser.escapedChar(mut self): Result[char, RegexError] {',
            '    immut c = self.peek()',
            '    self.position += 1',
            '',
            '    match (c) {',
            '        \'n\' => return Ok(\'\\n\')',
            '        \'t\' => return Ok(\'\\t\')',
            '        \'r\' => return Ok(\'\\r\')',
            '        \'f\' => return Ok(charOf(12))',
            '        \'v\' => return Ok(charOf(11))',
            '        \'a\' => return Ok(charOf(7))',
            '        \'x\' => return self.hexChar(2)',
            '        \'u\' => return self.hexChar(4)',
            '        \'U\' => return self.hexChar(8)',
            '        _ => {}',
            '    }',
            '',
            '    // Any ASCII character that is not a letter or a digit stands for itself.',
            '    immut code = c.code()',
            '',
            '    if (code < 128 and not isAsciiLetter(c) and not (c >= \'0\' and c <= \'9\') and code > 32) { return Ok(c) }',
            '',
            '    if (c == \' \') { return Ok(c) }',
            '',
            '    return Err(self.invalid(\'unrecognized escape sequence\'))',
            '}',
            '',
            '// `\\x41` (`digits` hexadecimal digits) or `\\x{1F600}`.',
            'function Parser.hexChar(mut self, digits: int): Result[char, RegexError] {',
            '    mut text = \'\'',
            '',
            '    if (self.at(\'{\')) {',
            '        self.position += 1',
            '',
            '        while (not self.at(\'}\')) {',
            '            if (self.done()) { return Err(self.invalid(\'unclosed hexadecimal literal\')) }',
            '',
            '            text += string(self.peek())',
            '            self.position += 1',
            '        }',
            '',
            '        self.position += 1',
            '',
            '        if (text == \'\') { return Err(self.invalid(\'empty hexadecimal literal\')) }',
            '    } else {',
            '        for i in range(digits) {',
            '            if (self.done()) { return Err(self.invalid(\'incomplete escape sequence, reached end of pattern prematurely\')) }',
            '',
            '            text += string(self.peek())',
            '            self.position += 1',
            '        }',
            '    }',
            '',
            '    mut value = 0',
            '',
            '    for digit in text {',
            '        match (\'0123456789abcdef\'.indexOf(string(digit).lower())) {',
            '            Some(found) => value = value * 16 + found',
            '            None => return Err(self.invalid(\'invalid hexadecimal digit\'))',
            '        }',
            '',
            '        if (value > 1114111) { return Err(self.invalid(\'hexadecimal literal is not a Unicode scalar value\')) }',
            '    }',
            '',
            '    return match (char(value)) {',
            '        Some(found) => Ok(found)',
            '        None => Err(self.invalid(\'hexadecimal literal is not a Unicode scalar value\'))',
            '    }',
            '}',
            '',
            '// A class `[...]` (after its `[`).',
            'function Parser.charClass(mut self): Result[CharClass, RegexError] {',
            '    mut negated = false',
            '',
            '    if (self.at(\'^\')) {',
            '        self.position += 1',
            '        negated = true',
            '    }',
            '',
            '    mut set = self.classUnion(true)?',
            '',
            '    while (true) {',
            '        if (self.done()) { return Err(self.invalid(\'unclosed character class\')) }',
            '',
            '        if (self.at(\']\')) {',
            '            self.position += 1',
            '            break',
            '        }',
            '',
            '        immut operator = self.classOperator()',
            '',
            '        if (operator == \'\') { return Err(self.invalid(\'unclosed character class\')) }',
            '',
            '        immut right = self.classUnion(false)?',
            '        set = match (operator) {',
            '            \'&&\' => Intersect(set, right)',
            '            \'--\' => Subtract(set, right)',
            '            _ => Either(set, right)',
            '        }',
            '    }',
            '',
            '    if (negated) { return Ok(Complement(set)) }',
            '',
            '    return Ok(set)',
            '}',
            '',
            '// `&&`, `--` or `~~` at the position (read), or `\'\'`.',
            'function Parser.classOperator(mut self): string {',
            '    if (self.position + 1 >= self.chars.length()) { return \'\' }',
            '',
            '    immut pair = `${self.chars[self.position]}${self.chars[self.position + 1]}`',
            '',
            '    if (pair == \'&&\' or pair == \'--\' or pair == \'~~\') {',
            '        self.position += 2',
            '        return pair',
            '    }',
            '',
            '    return \'\'',
            '}',
            '',
            '// The items of a class until `]` or an operator; a `]` first stands for itself.',
            'function Parser.classUnion(mut self, first: boolean): Result[CharClass, RegexError] {',
            '    mut ranges: CharRange[] = []',
            '    mut items: CharClass[] = []',
            '    mut start = first',
            '',
            '    while (true) {',
            '        if (self.done()) { return Err(self.invalid(\'unclosed character class\')) }',
            '',
            '        immut c = self.peek()',
            '',
            '        if (c == \']\' and not start) { break }',
            '',
            '        if (self.position + 1 < self.chars.length()) {',
            '            immut pair = `${c}${self.chars[self.position + 1]}`',
            '',
            '            if ((pair == \'&&\' or pair == \'--\' or pair == \'~~\') and not start) { break }',
            '        }',
            '',
            '        start = false',
            '',
            '        // `[:alpha:]`',
            '        if (c == \'[\' and self.position + 1 < self.chars.length() and self.chars[self.position + 1] == \':\') {',
            '            match (self.posixClass()) {',
            '                Some(set) => {',
            '                    items.push(set)',
            '                    continue',
            '                }',
            '                None => {}',
            '            }',
            '        }',
            '',
            '        if (c == \'[\') {',
            '            self.position += 1',
            '            items.push(self.charClass()?)',
            '            continue',
            '        }',
            '',
            '        immut low = match (self.classChar()?) {',
            '            ClassSet(set) => {',
            '                items.push(set)',
            '                continue',
            '            }',
            '            ClassChar(found) => found',
            '        }',
            '',
            '        // A range `a-z`; a `-` before `]` stands for itself.',
            '        if (self.at(\'-\') and self.position + 1 < self.chars.length() and self.chars[self.position + 1] != \']\' and self.chars[self.position + 1] != \'-\') {',
            '            self.position += 1',
            '',
            '            immut high = match (self.classChar()?) {',
            '                ClassChar(found) => found',
            '                ClassSet(_) => return Err(self.invalid(\'invalid character class range\'))',
            '            }',
            '',
            '            if (high.code() < low.code()) { return Err(self.invalid(\'invalid character class range, the start must be <= the end\')) }',
            '',
            '            ranges.push({ low: low.code(), high: high.code() })',
            '            continue',
            '        }',
            '',
            '        ranges.push({ low: low.code(), high: low.code() })',
            '    }',
            '',
            '    if (items.length() == 0) { return Ok(Ranges(ranges)) }',
            '',
            '    if (ranges.length() > 0) { items.push(Ranges(ranges)) }',
            '',
            '    if (items.length() == 1) { return Ok(items[0]) }',
            '',
            '    return Ok(Union(items))',
            '}',
            '',
            '// A character of a class, or a class escape (`\\d`).',
            'type ClassItem = {',
            '    ClassChar(c: char)',
            '    ClassSet(set: CharClass)',
            '}',
            '',
            'function Parser.classChar(mut self): Result[ClassItem, RegexError] {',
            '    immut c = self.peek()',
            '    self.position += 1',
            '',
            '    if (c != \'\\\\\') { return Ok(ClassChar(c)) }',
            '',
            '    if (self.done()) { return Err(self.invalid(\'incomplete escape sequence, reached end of pattern prematurely\')) }',
            '',
            '    match (self.classEscape()?) {',
            '        Some(set) => return Ok(ClassSet(set))',
            '        None => {}',
            '    }',
            '',
            '    immut escaped = self.peek()',
            '',
            '    if (escaped == \'b\') {',
            '        self.position += 1',
            '        return Ok(ClassChar(charOf(8)))',
            '    }',
            '',
            '    return Ok(ClassChar(self.escapedChar()?))',
            '}',
            '',
            '// `[:alpha:]` (ASCII) at the position, read if it is one.',
            'function Parser.posixClass(mut self): Option[CharClass] {',
            '    mut end = self.position + 2',
            '    mut name = \'\'',
            '',
            '    while (end < self.chars.length() and self.chars[end] != \':\') {',
            '        name += string(self.chars[end])',
            '        end += 1',
            '    }',
            '',
            '    if (end + 1 >= self.chars.length() or self.chars[end + 1] != \']\') { return None }',
            '',
            '    immut negated = name.startsWith(\'^\')',
            '    immut plain = if (negated) { name[1..] } else { name }',
            '    immut ranges: CharRange[] = match (plain) {',
            '        \'alnum\' => [span(\'0\', \'9\'), span(\'A\', \'Z\'), span(\'a\', \'z\')]',
            '        \'alpha\' => [span(\'A\', \'Z\'), span(\'a\', \'z\')]',
            '        \'ascii\' => [{ low: 0, high: 127 }]',
            '        \'blank\' => [span(\'\\t\', \'\\t\'), span(\' \', \' \')]',
            '        \'cntrl\' => [{ low: 0, high: 31 }, { low: 127, high: 127 }]',
            '        \'digit\' => [span(\'0\', \'9\')]',
            '        \'graph\' => [{ low: 33, high: 126 }]',
            '        \'lower\' => [span(\'a\', \'z\')]',
            '        \'print\' => [{ low: 32, high: 126 }]',
            '        \'punct\' => [{ low: 33, high: 47 }, { low: 58, high: 64 }, { low: 91, high: 96 }, { low: 123, high: 126 }]',
            '        \'space\' => [span(\'\\t\', \'\\r\'), span(\' \', \' \')]',
            '        \'upper\' => [span(\'A\', \'Z\')]',
            '        \'word\' => [span(\'0\', \'9\'), span(\'A\', \'Z\'), span(\'_\', \'_\'), span(\'a\', \'z\')]',
            '        \'xdigit\' => [span(\'0\', \'9\'), span(\'A\', \'F\'), span(\'a\', \'f\')]',
            '        _ => return None',
            '    }',
            '    self.position = end + 2',
            '',
            '    if (negated) { return Some(Complement(Ranges(ranges))) }',
            '',
            '    return Some(Ranges(ranges))',
            '}',
            '',
            'function span(low: char, high: char): CharRange {',
            '    return { low: low.code(), high: high.code() }',
            '}',
            '',
            '// Compiling',
            '',
            '// The instructions `node` compiles to (an upper bound, to refuse a pattern too large before',
            '// building it).',
            'function size(node: Node): int {',
            '    return match (node) {',
            '        Empty => 0',
            '        Capture(_, inner) => size(inner) + 2',
            '        Concat(items) => {',
            '            mut total = 0',
            '',
            '            for item in items {',
            '                total += size(item)',
            '',
            '                if (total > largest) { return total }',
            '            }',
            '',
            '            total',
            '        }',
            '        Alternate(items) => {',
            '            mut total = 0',
            '',
            '            for item in items {',
            '                total += size(item) + 2',
            '',
            '                if (total > largest) { return total }',
            '            }',
            '',
            '            total',
            '        }',
            '        Repeat(inner, min, max, _) => {',
            '            immut copies = if (max == -1) { min + 1 } else { max }',
            '            immut one = size(inner) + 2',
            '',
            '            if (copies > 0 and one > (largest + 1) / copies) { return largest + 1 }',
            '',
            '            one * copies',
            '        }',
            '        _ => 1',
            '    }',
            '}',
            '',
            'function emit(node: Node, mut program: Instruction[]) {',
            '    match (node) {',
            '        Empty => {}',
            '        Literal(c, fold) => program.push(CharIns(c, fold))',
            '        Dot(all) => program.push(AnyIns(all))',
            '        Set(set, fold) => program.push(SetIns(set, fold))',
            '        Look(kind) => program.push(LookIns(kind))',
            '        Capture(index, inner) => {',
            '            program.push(SaveIns(index * 2))',
            '            emit(inner, mut program)',
            '            program.push(SaveIns(index * 2 + 1))',
            '        }',
            '        Concat(items) => {',
            '            for item in items {',
            '                emit(item, mut program)',
            '            }',
            '        }',
            '        Alternate(items) => emitAlternation(items, 0, mut program)',
            '        Repeat(inner, min, max, greedy) => {',
            '            for i in range(min) {',
            '                emit(inner, mut program)',
            '            }',
            '',
            '            if (max == -1) {',
            '                emitStar(inner, greedy, mut program)',
            '                return',
            '            }',
            '',
            '            emitOptional(inner, max - min, greedy, mut program)',
            '        }',
            '    }',
            '}',
            '',
            '// `items[index] | items[index + 1] | ...`: each branch preferred to the ones after it.',
            'function emitAlternation(items: Node[], index: int, mut program: Instruction[]) {',
            '    if (index == items.length() - 1) {',
            '        emit(items[index], mut program)',
            '        return',
            '    }',
            '',
            '    immut split = program.length()',
            '    program.push(SplitIns(0, 0))',
            '    emit(items[index], mut program)',
            '    immut jump = program.length()',
            '    program.push(JumpIns(0))',
            '    immut next = program.length()',
            '    emitAlternation(items, index + 1, mut program)',
            '    program[split] = SplitIns(split + 1, next)',
            '    program[jump] = JumpIns(program.length())',
            '}',
            '',
            '// `inner*`.',
            'function emitStar(inner: Node, greedy: boolean, mut program: Instruction[]) {',
            '    immut split = program.length()',
            '    program.push(SplitIns(0, 0))',
            '    emit(inner, mut program)',
            '    program.push(JumpIns(split))',
            '    immut after = program.length()',
            '    program[split] = if (greedy) { SplitIns(split + 1, after) } else { SplitIns(after, split + 1) }',
            '}',
            '',
            '// `(inner(inner(...)?)?)?`, `count` times.',
            'function emitOptional(inner: Node, count: int, greedy: boolean, mut program: Instruction[]) {',
            '    mut splits: int[] = []',
            '',
            '    for i in range(count) {',
            '        splits.push(program.length())',
            '        program.push(SplitIns(0, 0))',
            '        emit(inner, mut program)',
            '    }',
            '',
            '    immut after = program.length()',
            '',
            '    for split in splits {',
            '        program[split] = if (greedy) { SplitIns(split + 1, after) } else { SplitIns(after, split + 1) }',
            '    }',
            '}',
            '',
            '// Whether every match of `node` starts at the start of the text.',
            'function startsAnchored(node: Node): boolean {',
            '    return match (node) {',
            '        Look(kind) => kind == startText',
            '        Capture(_, inner) => startsAnchored(inner)',
            '        Concat(items) => items.length() > 0 and startsAnchored(items[0])',
            '        Alternate(items) => {',
            '            for item in items {',
            '                if (not startsAnchored(item)) { return false }',
            '            }',
            '',
            '            true',
            '        }',
            '        Repeat(inner, min, _, _) => min > 0 and startsAnchored(inner)',
            '        _ => false',
            '    }',
            '}',
            '',
            '// Matching',
            '',
            '// A thread of the machine: where it is in the program, and the positions of the groups so far.',
            'type Thread = {',
            '    pc: int',
            '    slots: int[]',
            '}',
            '',
            '// The slots (start and end of each group, -1 when it did not match) of the first match of the',
            '// program in `chars` from `start`, if there is one.',
            'function Regex.search(self, chars: char[], start: int): Option[int[]] {',
            '    immut count = chars.length()',
            '    mut empty: int[] = []',
            '',
            '    for i in range(self.groups * 2) {',
            '        empty.push(-1)',
            '    }',
            '',
            '    // `seen[pc] == step`: the state is already in the list of the step.',
            '    mut seen: int[] = []',
            '',
            '    for i in range(self.program.length()) {',
            '        seen.push(-1)',
            '    }',
            '',
            '    mut current: Thread[] = []',
            '    mut found: Option[int[]] = None',
            '    mut position = start',
            '    mut step = 0',
            '',
            '    if (self.prefilter and not self.anchored) {',
            '        while (position < count and not self.canStart(chars[position])) {',
            '            position += 1',
            '        }',
            '',
            '        if (position >= count) { return None }',
            '    }',
            '',
            '    while (true) {',
            '        // A new thread at each position, after the others: they started earlier.',
            '        if (found is None and (not self.anchored or position == 0)) {',
            '            self.follow(mut current, mut seen, step, { pc: 0, slots: empty }, chars, position)',
            '        }',
            '',
            '        step += 1',
            '',
            '        // No thread here: the next position, unless a match is found or the text has ended.',
            '        if (current.length() == 0) {',
            '            if (found is Some or position >= count or self.anchored) { break }',
            '',
            '            position += 1',
            '',
            '            // Up to a character that a match can start with.',
            '            if (self.prefilter) {',
            '                while (position < count and not self.canStart(chars[position])) {',
            '                    position += 1',
            '                }',
            '',
            '                if (position >= count) { break }',
            '            }',
            '',
            '            continue',
            '        }',
            '',
            '        mut next: Thread[] = []',
            '',
            '        for thread in current {',
            '            immut instruction = self.program[thread.pc]',
            '',
            '            if (instruction is MatchIns) {',
            '                found = Some(thread.slots)',
            '                // The threads after this one are less preferred.',
            '                break',
            '            }',
            '',
            '            if (position < count and consumes(instruction, chars[position])) {',
            '                self.follow(mut next, mut seen, step, { pc: thread.pc + 1, slots: thread.slots }, chars, position + 1)',
            '            }',
            '        }',
            '',
            '        current = next',
            '',
            '        if (position >= count) { break }',
            '',
            '        position += 1',
            '    }',
            '',
            '    return found',
            '}',
            '',
            '// Adds `thread` to `list`, through the instructions that consume nothing, in the order of',
            '// preference. `seen` and `step` keep each state once per step.',
            'function Regex.follow(self, mut list: Thread[], mut seen: int[], step: int, thread: Thread, chars: char[], position: int) {',
            '    if (seen[thread.pc] == step) { return }',
            '',
            '    // Most often the next instruction reads a character: the thread waits for it.',
            '    if (readsChar(self.program[thread.pc])) {',
            '        seen[thread.pc] = step',
            '        list.push(thread)',
            '        return',
            '    }',
            '',
            '    mut pending: Thread[] = [thread]',
            '',
            '    while (true) {',
            '        immut current = match (pending.pop()) {',
            '            Some(found) => found',
            '            None => break',
            '        }',
            '',
            '        if (seen[current.pc] == step) { continue }',
            '',
            '        seen[current.pc] = step',
            '',
            '        match (self.program[current.pc]) {',
            '            JumpIns(target) => pending.push({ pc: target, slots: current.slots })',
            '            // The first is preferred: it is taken from the stack first.',
            '            SplitIns(first, second) => {',
            '                pending.push({ pc: second, slots: current.slots })',
            '                pending.push({ pc: first, slots: current.slots })',
            '            }',
            '            SaveIns(slot) => {',
            '                mut slots = current.slots',
            '                slots[slot] = position',
            '                pending.push({ pc: current.pc + 1, slots: slots })',
            '            }',
            '            LookIns(kind) => {',
            '                if (holds(kind, chars, position)) { pending.push({ pc: current.pc + 1, slots: current.slots }) }',
            '            }',
            '            _ => list.push(current)',
            '        }',
            '    }',
            '}',
            '',
            'function readsChar(instruction: Instruction): boolean {',
            '    return match (instruction) {',
            '        CharIns(_, _) => true',
            '        AnyIns(_) => true',
            '        SetIns(_, _) => true',
            '        _ => false',
            '    }',
            '}',
            '',
            'function Regex.canStart(self, c: char): boolean {',
            '    for instruction in self.firsts {',
            '        if (consumes(instruction, c)) { return true }',
            '    }',
            '',
            '    return false',
            '}',
            '',
            'function consumes(instruction: Instruction, c: char): boolean {',
            '    return match (instruction) {',
            '        CharIns(expected, fold) => if (fold) { lowered(c) == expected } else { c == expected }',
            '        AnyIns(all) => all or c != \'\\n\'',
            '        SetIns(set, fold) => {',
            '            if (contains(set, c)) { return true }',
            '',
            '            fold and (contains(set, lowered(c)) or contains(set, uppered(c)))',
            '        }',
            '        _ => false',
            '    }',
            '}',
            '',
            'function contains(set: CharClass, c: char): boolean {',
            '    return match (set) {',
            '        Ranges(ranges) => {',
            '            immut code = c.code()',
            '',
            '            for range in ranges {',
            '                if (code >= range.low and code <= range.high) { return true }',
            '            }',
            '',
            '            false',
            '        }',
            '        Category(kind) => inCategory(kind, c)',
            '        Union(items) => {',
            '            for item in items {',
            '                if (contains(item, c)) { return true }',
            '            }',
            '',
            '            false',
            '        }',
            '        Intersect(left, right) => contains(left, c) and contains(right, c)',
            '        Subtract(left, right) => contains(left, c) and not contains(right, c)',
            '        Either(left, right) => contains(left, c) != contains(right, c)',
            '        Complement(inner) => not contains(inner, c)',
            '    }',
            '}',
            '',
            '// The classes of Unicode, by the classifications of strings (exact for ASCII).',
            'function inCategory(kind: int, c: char): boolean {',
            '    immut code = c.code()',
            '',
            '    if (code < 128) {',
            '        return match (kind) {',
            '            0 => c >= \'0\' and c <= \'9\'',
            '            1 => isAsciiLetter(c) or (c >= \'0\' and c <= \'9\') or c == \'_\'',
            '            2 => c == \' \' or (code >= 9 and code <= 13)',
            '            3 => isAsciiLetter(c)',
            '            4 => c >= \'A\' and c <= \'Z\'',
            '            5 => c >= \'a\' and c <= \'z\'',
            '            _ => c >= \'0\' and c <= \'9\'',
            '        }',
            '    }',
            '',
            '    immut text = string(c)',
            '',
            '    return match (kind) {',
            '        0 => text.isNumeric()',
            '        1 => text.isAlphaNumeric()',
            '        2 => text.isSpace()',
            '        3 => text.isAlpha()',
            '        4 => text.isAlpha() and text.isUpper()',
            '        5 => text.isAlpha() and text.isLower()',
            '        _ => text.isNumeric()',
            '    }',
            '}',
            '',
            'function holds(kind: int, chars: char[], position: int): boolean {',
            '    immut count = chars.length()',
            '',
            '    if (kind == startText) { return position == 0 }',
            '',
            '    if (kind == endText) { return position == count }',
            '',
            '    if (kind == startLine) { return position == 0 or chars[position - 1] == \'\\n\' }',
            '',
            '    if (kind == endLine) { return position == count or chars[position] == \'\\n\' }',
            '',
            '    immut before = position > 0 and isWord(chars[position - 1])',
            '    immut after = position < count and isWord(chars[position])',
            '',
            '    if (kind == wordBoundary) { return before != after }',
            '',
            '    if (kind == notWordBoundary) { return before == after }',
            '',
            '    if (kind == wordStart) { return not before and after }',
            '',
            '    return before and not after',
            '}',
            '',
            'function isWord(c: char): boolean {',
            '    return inCategory(wordClass, c)',
            '}',
            '',
            '// The methods',
            '',
            '// Whether the pattern matches anywhere in `input`.',
            'function Regex.test(self, input: string): boolean {',
            '    return self.search(input.chars(), 0) is Some',
            '}',
            '',
            '// The first match.',
            'function Regex.find(self, input: string): Option[Match] {',
            '    immut chars = input.chars()',
            '',
            '    return match (self.search(chars, 0)) {',
            '        Some(slots) => Some(matchOf(chars, slots))',
            '        None => None',
            '    }',
            '}',
            '',
            'function matchOf(chars: char[], slots: int[]): Match {',
            '    return { value: piece(chars, slots[0], slots[1]), start: slots[0], end: slots[1] }',
            '}',
            '',
            '// The text of `chars[start..end]` (from the characters: slicing the string would count them from',
            '// its start each time).',
            'function piece(chars: char[], start: int, end: int): string {',
            '    mut text = \'\'',
            '',
            '    for i in range(start, end) {',
            '        text += string(chars[i])',
            '    }',
            '',
            '    return text',
            '}',
            '',
            '// Every match, one after the other: an empty match right after the end of the previous one is',
            '// skipped.',
            'function Regex.matches(self, chars: char[]): int[][] {',
            '    mut found: int[][] = []',
            '    mut position = 0',
            '    mut lastEnd = -1',
            '',
            '    while (position <= chars.length()) {',
            '        immut slots = match (self.search(chars, position)) {',
            '            Some(slots) => slots',
            '            None => break',
            '        }',
            '',
            '        if (slots[0] == slots[1] and slots[1] == lastEnd) {',
            '            position = slots[1] + 1',
            '            continue',
            '        }',
            '',
            '        found.push(slots)',
            '        position = slots[1]',
            '        lastEnd = slots[1]',
            '    }',
            '',
            '    return found',
            '}',
            '',
            '// Every match.',
            'function Regex.findAll(self, input: string): Match[] {',
            '    mut found: Match[] = []',
            '    immut chars = input.chars()',
            '',
            '    for slots in self.matches(chars) {',
            '        found.push(matchOf(chars, slots))',
            '    }',
            '',
            '    return found',
            '}',
            '',
            '// `input` with its first match replaced by `replacement`: `$1` or `${1}` is the text of a group,',
            '// `$name` or `${name}` that of a named group, `$$` a `$`.',
            'function Regex.replace(self, input: string, replacement: string): string {',
            '    immut chars = input.chars()',
            '',
            '    return match (self.search(chars, 0)) {',
            '        Some(slots) => piece(chars, 0, slots[0]) + self.expand(chars, slots, replacement) + piece(chars, slots[1], chars.length())',
            '        None => input',
            '    }',
            '}',
            '',
            '// `input` with every match replaced by `replacement`.',
            'function Regex.replaceAll(self, input: string, replacement: string): string {',
            '    mut out = \'\'',
            '    mut last = 0',
            '    immut chars = input.chars()',
            '',
            '    for slots in self.matches(chars) {',
            '        for i in range(last, slots[0]) {',
            '            out += string(chars[i])',
            '        }',
            '',
            '        out += self.expand(chars, slots, replacement)',
            '        last = slots[1]',
            '    }',
            '',
            '    for i in range(last, chars.length()) {',
            '        out += string(chars[i])',
            '    }',
            '',
            '    return out',
            '}',
            '',
            '// The pieces of `input` between its matches.',
            'function Regex.split(self, input: string): string[] {',
            '    mut pieces: string[] = []',
            '    mut last = 0',
            '    immut chars = input.chars()',
            '',
            '    for slots in self.matches(chars) {',
            '        pieces.push(piece(chars, last, slots[0]))',
            '        last = slots[1]',
            '    }',
            '',
            '    pieces.push(piece(chars, last, chars.length()))',
            '    return pieces',
            '}',
            '',
            '// `replacement` with its `$` references replaced by the groups of a match.',
            'function Regex.expand(self, input: char[], slots: int[], replacement: string): string {',
            '    immut chars = replacement.chars()',
            '    mut out = \'\'',
            '    mut i = 0',
            '',
            '    while (i < chars.length()) {',
            '        immut c = chars[i]',
            '        i += 1',
            '',
            '        if (c != \'$\' or i >= chars.length()) {',
            '            out += string(c)',
            '            continue',
            '        }',
            '',
            '        if (chars[i] == \'$\') {',
            '            out += \'$\'',
            '            i += 1',
            '            continue',
            '        }',
            '',
            '        mut name = \'\'',
            '',
            '        if (chars[i] == \'{\') {',
            '            mut end = i + 1',
            '',
            '            while (end < chars.length() and chars[end] != \'}\') {',
            '                end += 1',
            '            }',
            '',
            '            if (end >= chars.length()) {',
            '                out += \'$\'',
            '                continue',
            '            }',
            '',
            '            name = replacement[i + 1..end]',
            '            i = end + 1',
            '        } else {',
            '            while (i < chars.length() and (chars[i] == \'_\' or isAsciiLetter(chars[i]) or (chars[i] >= \'0\' and chars[i] <= \'9\'))) {',
            '                name += string(chars[i])',
            '                i += 1',
            '            }',
            '',
            '            if (name == \'\') {',
            '                out += \'$\'',
            '                continue',
            '            }',
            '        }',
            '',
            '        out += self.group(input, slots, name)',
            '    }',
            '',
            '    return out',
            '}',
            '',
            '// The text of the group `name` (a number or a name) of a match, or `\'\'`.',
            'function Regex.group(self, input: char[], slots: int[], name: string): string {',
            '    immut index = match (int(name)) {',
            '        Ok(number) => number',
            '        Err(_) => match (self.names.get(name)) {',
            '            Some(found) => found',
            '            None => return \'\'',
            '        }',
            '    }',
            '',
            '    if (index < 0 or index >= self.groups or slots[index * 2] < 0) { return \'\' }',
            '',
            '    return piece(input, slots[index * 2], slots[index * 2 + 1])',
            '}',
            '',
            '// Characters',
            '',
            'function isAsciiLetter(c: char): boolean {',
            '    return (c >= \'a\' and c <= \'z\') or (c >= \'A\' and c <= \'Z\')',
            '}',
            '',
            'function isSpace(c: char): boolean {',
            '    return inCategory(spaceClass, c)',
            '}',
            '',
            'function lowered(c: char): char {',
            '    if (c >= \'A\' and c <= \'Z\') { return charOf(c.code() + 32) }',
            '',
            '    if (c.code() < 128) { return c }',
            '',
            '    immut text = string(c).lower()',
            '    return if (text.length() == 1) { text.chars()[0] } else { c }',
            '}',
            '',
            'function uppered(c: char): char {',
            '    if (c >= \'a\' and c <= \'z\') { return charOf(c.code() - 32) }',
            '',
            '    if (c.code() < 128) { return c }',
            '',
            '    immut text = string(c).upper()',
            '    return if (text.length() == 1) { text.chars()[0] } else { c }',
            '}',
            '',
            'function charOf(code: int): char {',
            '    return match (char(code)) {',
            '        Some(c) => c',
            '        None => \' \'',
            '    }',
            '}',
        ].join('\n'))
    }

    if (name == 'system') {
        return Some([
            '// The `system` module: the command line, the environment, the exit code, other programs and the',
            '// operating system (see doc/standard-library/system.md). `exit` is checked by the compiler, which',
            '// calls `leave` here (a function of Koji cannot say that it never returns).',
            '',
            'import { Address, CInt, CSize, allocate, free, isNull, newString, nullAddress, offset, read, stringBytes, stringSize, write } from \'koji:unsafe\'',
            'import { cString, cText, hasNul, isUtf8, textOf } from \'koji:core\'',
            '',
            '// The C library.',
            'extern function strlen(text: Address): CSize',
            'extern function strerror(code: CInt): Address',
            'extern function getenv(name: Address): Address',
            'extern function uname(name: Address): CInt',
            'extern function exit(code: CInt)',
            'extern function posix_spawnp(pid: Address, file: Address, actions: Address, attributes: Address, arguments: Address, environment: Address): CInt',
            'extern function posix_spawn_file_actions_init(actions: Address): CInt',
            'extern function posix_spawn_file_actions_destroy(actions: Address): CInt',
            'extern function posix_spawn_file_actions_adddup2(actions: Address, fd: CInt, target: CInt): CInt',
            'extern function posix_spawn_file_actions_addclose(actions: Address, fd: CInt): CInt',
            'extern function posix_spawn_file_actions_addopen(actions: Address, fd: CInt, path: Address, flags: CInt, mode: CInt): CInt',
            'extern function waitpid(pid: CInt, status: Address, options: CInt): CInt',
            'extern function pipe(fds: Address): CInt',
            'extern function close(fd: CInt): CInt',
            '// `read` of C, with one buffer (`read` is that of `koji:unsafe` here).',
            'extern function readv(fd: CInt, buffers: Address, count: CInt): int',
            'extern function poll(fds: Address, count: CSize, timeout: CInt): CInt',
            'extern function realloc(memory: Address, size: CSize): Address',
            '',
            '// What the system gives in different ways: small inline functions of the prelude (runtime/prelude.h).',
            'extern function koji_system_argument_count(): int',
            'extern function koji_system_argument(index: int): Address',
            'extern function koji_system_errno(): CInt',
            'extern function koji_system_environment(): Address',
            'extern function koji_system_executable_into(buffer: Address, size: int): int',
            '',
            'export type OperatingSystem = {',
            '    Linux',
            '    MacOS',
            '    Windows',
            '    // Another system, by its name: \'freebsd\'.',
            '    Other(name: string)',
            '}',
            '',
            'export type SystemError = {',
            '    // There is no such program.',
            '    NotFound(command: string)',
            '    // It cannot be run.',
            '    PermissionDenied(command: string)',
            '    // Any other failure of the operating system.',
            '    Io(command: string, message: string)',
            '}',
            '',
            'function SystemError.display(self): string {',
            '    return match (self) {',
            '        NotFound(command) => `command \'${command}\' not found`',
            '        PermissionDenied(command) => `permission denied to run \'${command}\'`',
            '        Io(command, message) => `cannot run \'${command}\': ${message}`',
            '    }',
            '}',
            '',
            '// What a program printed, and its exit code (-1 if a signal stopped it).',
            'export type Output = {',
            '    status: int',
            '    stdout: string',
            '    stderr: string',
            '}',
            '',
            '// The operating system the program runs on.',
            'export immut os = systemNamed()',
            '',
            '// The command-line arguments of the program, after the program itself.',
            'export function args(): string[] {',
            '    mut found: string[] = []',
            '',
            '    for i in range(koji_system_argument_count()) {',
            '        found.push(cText(koji_system_argument(i)))',
            '    }',
            '',
            '    return found',
            '}',
            '',
            '// The value of the environment variable `name` (`None` if it is not set, or not UTF-8).',
            'export function env(name: string): Option[string] {',
            '    if (hasNul(name)) { return None }',
            '',
            '    immut cName = cString(name)',
            '    immut value = getenv(cName)',
            '    free(cName)',
            '',
            '    if (isNull(value)) { return None }',
            '',
            '    immut size = strlen(value)',
            '',
            '    if (not isUtf8(value, size)) { return None }',
            '',
            '    return Some(newString(value, size))',
            '}',
            '',
            '// The path of the executable of this program, or `None` where the system cannot tell it (read',
            '// once, as the system may say it no longer exists later).',
            'mut executableKnown: Option[string][] = []',
            '',
            'export function executable(): Option[string] {',
            '    if (executableKnown.length() == 0) { executableKnown.push(executablePath()) }',
            '',
            '    return executableKnown[0]',
            '}',
            '',
            'function executablePath(): Option[string] {',
            '    mut size = 4096',
            '',
            '    while (true) {',
            '        immut buffer = allocate(size)',
            '        immut length = koji_system_executable_into(buffer, size)',
            '',
            '        if (length >= 0) {',
            '            immut path = textOf(buffer, length)',
            '            free(buffer)',
            '            return Some(path)',
            '        }',
            '',
            '        free(buffer)',
            '',
            '        if (length == -1 or size >= 1048576) { return None }',
            '',
            '        size = size * 2',
            '    }',
            '',
            '    return None',
            '}',
            '',
            '// `system.exit(code)`: ends the program (a code beyond those of C is the nearest one).',
            'function leave(code: int) {',
            '    immut clamped = if (code > 2147483647) { 2147483647 } else { if (code < -2147483648) { -2147483648 } else { code } }',
            '    exit(clamped)',
            '}',
            '',
            '// Runs `command` with the terminal of this program and waits for it: its exit code.',
            'export function run(command: string, args: string[]): Result[int, SystemError] {',
            '    immut started = spawn(command, args, false)?',
            '    return Ok(wait(started.pid))',
            '}',
            '',
            '// Runs `command` and keeps what it prints (it reads nothing).',
            'export function capture(command: string, args: string[]): Result[Output, SystemError] {',
            '    immut started = spawn(command, args, true)?',
            '    immut printed = readBoth(started.stdout, started.stderr)',
            '    immut status = wait(started.pid)',
            '    return Ok({ status: status, stdout: printed[0], stderr: printed[1] })',
            '}',
            '',
            '// A program started, with the pipes of its outputs when they are kept.',
            'type Started = {',
            '    pid: int',
            '    stdout: int',
            '    stderr: int',
            '}',
            '',
            'function spawn(command: string, args: string[], captured: boolean): Result[Started, SystemError] {',
            '    if (hasNul(command)) { return Err(Io(command, \'nul byte found in provided data\')) }',
            '',
            '    for arg in args {',
            '        if (hasNul(arg)) { return Err(Io(command, \'nul byte found in provided data\')) }',
            '    }',
            '',
            '    // The arguments of C: the program, then `args`, then NULL.',
            '    immut argv = allocate((args.length() + 2) * 8)',
            '    write(argv, 0, cString(command))',
            '',
            '    for i in range(args.length()) {',
            '        write(argv, (i + 1) * 8, cString(args[i]))',
            '    }',
            '',
            '    write(argv, (args.length() + 1) * 8, nullAddress())',
            '',
            '    // The actions of the child: its outputs to the pipes, its input from /dev/null.',
            '    immut actions = allocate(256)',
            '    posix_spawn_file_actions_init(actions)',
            '    immut pipes = allocate(16)',
            '    mut stdout = -1',
            '    mut stderr = -1',
            '',
            '    if (captured) {',
            '        pipe(pipes)',
            '        pipe(offset(pipes, 8))',
            '        stdout = readInt32(pipes, 0)',
            '        stderr = readInt32(pipes, 8)',
            '        immut stdoutEnd = readInt32(pipes, 4)',
            '        immut stderrEnd = readInt32(pipes, 12)',
            '        immut devNull = cString(\'/dev/null\')',
            '        posix_spawn_file_actions_addopen(actions, 0, devNull, 0, 0)',
            '        free(devNull)',
            '        posix_spawn_file_actions_adddup2(actions, stdoutEnd, 1)',
            '        posix_spawn_file_actions_adddup2(actions, stderrEnd, 2)',
            '',
            '        for fd in [stdout, stderr, stdoutEnd, stderrEnd] {',
            '            posix_spawn_file_actions_addclose(actions, fd)',
            '        }',
            '    }',
            '',
            '    immut pid = allocate(8)',
            '    immut program: Address = read(argv, 0)',
            '    immut code = posix_spawnp(pid, program, actions, nullAddress(), argv, koji_system_environment())',
            '    posix_spawn_file_actions_destroy(actions)',
            '    free(actions)',
            '',
            '    for i in range(args.length() + 1) {',
            '        immut each: Address = read(argv, i * 8)',
            '        free(each)',
            '    }',
            '',
            '    free(argv)',
            '    immut started = readInt32(pid, 0)',
            '    free(pid)',
            '',
            '    if (captured) {',
            '        close(readInt32(pipes, 4))',
            '        close(readInt32(pipes, 12))',
            '    }',
            '',
            '    free(pipes)',
            '',
            '    if (code != 0) {',
            '        if (captured) {',
            '            close(stdout)',
            '            close(stderr)',
            '        }',
            '',
            '        return Err(failure(command, code))',
            '    }',
            '',
            '    return Ok({ pid: started, stdout: stdout, stderr: stderr })',
            '}',
            '',
            '// The error of a program that could not start, from the error of the system.',
            'function failure(command: string, code: int): SystemError {',
            '    // ENOENT; EPERM and EACCES.',
            '    if (code == 2) { return NotFound(command) }',
            '',
            '    if (code == 1 or code == 13) { return PermissionDenied(command) }',
            '',
            '    return Io(command, `${cText(strerror(code))} (os error ${code})`)',
            '}',
            '',
            '// Waits for the program `pid` to end: its exit code, or -1 if a signal stopped it.',
            'function wait(pid: int): int {',
            '    immut status = allocate(8)',
            '',
            '    // EINTR: a signal interrupted the wait.',
            '    while (waitpid(pid, status, 0) < 0 and koji_system_errno() == 4) {}',
            '',
            '    immut code = readInt32(status, 0)',
            '    free(status)',
            '',
            '    if ((code & 0x7F) != 0) { return -1 }',
            '',
            '    return (code >> 8) & 0xFF',
            '}',
            '',
            '// What the two pipes give until both end, read as they fill (a program blocks on a full pipe).',
            'function readBoth(stdout: int, stderr: int): string[] {',
            '    immut fds = allocate(16)',
            '    mut buffers = [allocate(4096), allocate(4096)]',
            '    mut sizes = [0, 0]',
            '    mut capacities = [4096, 4096]',
            '    mut open = [true, true]',
            '    immut pipes = [stdout, stderr]',
            '',
            '    while (open[0] or open[1]) {',
            '        // A `struct pollfd` for each open pipe: its fd, POLLIN and the events that happened.',
            '        mut count = 0',
            '        mut which: int[] = []',
            '',
            '        for i in range(2) {',
            '            if (not open[i]) { continue }',
            '',
            '            writeInt32(fds, count * 8, pipes[i])',
            '            writeInt32(fds, count * 8 + 4, 1)',
            '            which.push(i)',
            '            count += 1',
            '        }',
            '',
            '        if (poll(fds, count, -1) < 0) {',
            '            if (koji_system_errno() == 4) { continue }',
            '',
            '            break',
            '        }',
            '',
            '        for slot in range(count) {',
            '            // revents: 16 bits after `events`.',
            '            if (readInt32(fds, slot * 8 + 4) >> 16 == 0) { continue }',
            '',
            '            immut i = which[slot]',
            '',
            '            if (capacities[i] - sizes[i] < 4096) {',
            '                capacities[i] *= 2',
            '                buffers[i] = realloc(buffers[i], capacities[i])',
            '            }',
            '',
            '            // A `struct iovec`: where to read, and how much.',
            '            immut vector = allocate(16)',
            '            write(vector, 0, offset(buffers[i], sizes[i]))',
            '            write(vector, 8, capacities[i] - sizes[i])',
            '            immut got = readv(pipes[i], vector, 1)',
            '            free(vector)',
            '',
            '            if (got < 0 and koji_system_errno() == 4) { continue }',
            '',
            '            if (got <= 0) {',
            '                open[i] = false',
            '                close(pipes[i])',
            '                continue',
            '            }',
            '',
            '            sizes[i] += got',
            '        }',
            '    }',
            '',
            '    free(fds)',
            '    mut texts: string[] = []',
            '',
            '    for i in range(2) {',
            '        texts.push(textOf(buffers[i], sizes[i]))',
            '        free(buffers[i])',
            '    }',
            '',
            '    return texts',
            '}',
            '',
            '// The system, from the name `uname` gives (the first field of its record, on every system).',
            'function systemNamed(): OperatingSystem {',
            '    immut buffer = allocate(4096)',
            '    uname(buffer)',
            '    immut name = cText(buffer)',
            '    free(buffer)',
            '',
            '    return match (name) {',
            '        \'Linux\' => Linux',
            '        \'Darwin\' => MacOS',
            '        _ => Other(name.lower())',
            '    }',
            '}',
            '',
            '// The int of 32 bits of C at `address + at` (both systems are little-endian).',
            'function readInt32(address: Address, at: int): int {',
            '    mut value = 0',
            '',
            '    for i in range(4) {',
            '        immut b: byte = read(address, at + 3 - i)',
            '        value = (value << 8) | int(b)',
            '    }',
            '',
            '    return if (value >= 0x80000000) { value - 0x100000000 } else { value }',
            '}',
            '',
            'function writeInt32(address: Address, at: int, value: int) {',
            '    for i in range(4) {',
            '        write(address, at + i, byte((value >> (8 * i)) & 0xFF))',
            '    }',
            '}',
        ].join('\n'))
    }

    if (name == 'time') {
        return Some([
            '// The `time` module: the clocks of the system, and pauses (see doc/standard-library/time.md).',
            '// Times are in seconds, as decimals, exact to the nanosecond. A timestamp counts the seconds since',
            '// 0000-01-01 00:00:00 UTC, the epoch of Koji (in the proleptic Gregorian calendar).',
            '',
            'import math',
            'import system',
            'import { Address, CInt, allocate, free, read, write } from \'koji:unsafe\'',
            '',
            '// `int clock_gettime(clockid_t clock, struct timespec *time)` and',
            '// `int nanosleep(const struct timespec *request, struct timespec *remaining)`: a `timespec` is two',
            '// 8-byte words, seconds and nanoseconds.',
            'extern function clock_gettime(clock: CInt, time: Address): CInt',
            'extern function nanosleep(request: Address, remaining: Address): CInt',
            '',
            '// The seconds from 0000-01-01 to 1970-01-01, the epoch of Unix and of the clock of the system',
            '// (719,528 days).',
            'immut unixEpoch = 62167219200',
            '',
            '// The current time: the seconds since 0000-01-01 00:00:00 UTC. It follows the clock of the',
            '// system, which may be set back or forth.',
            'export function now(): decimal {',
            '    return clock(0) + unixEpoch',
            '}',
            '',
            '// A time that only grows, for durations: the difference of two is the time between them.',
            'export function monotonic(): decimal {',
            '    // `CLOCK_MONOTONIC` is 6 on macOS, 1 elsewhere.',
            '    immut id = match (system.os) {',
            '        MacOS => 6',
            '        _ => 1',
            '    }',
            '    return clock(id)',
            '}',
            '',
            '// Pauses for `seconds` (nothing for zero or less).',
            'export function sleep(seconds: decimal) {',
            '    if (seconds <= 0) { return }',
            '',
            '    immut whole = math.floor(seconds)',
            '    immut nanoseconds = math.floor((seconds - whole) * 1000000000)',
            '    immut request = allocate(16)',
            '    immut remaining = allocate(16)',
            '    write(request, 0, whole)',
            '    write(request, 8, nanoseconds)',
            '',
            '    // Interrupted by a signal, it goes on with what remains.',
            '    while (nanosleep(request, remaining) != 0) {',
            '        immut seconds: int = read(remaining, 0)',
            '        immut rest: int = read(remaining, 8)',
            '        write(request, 0, seconds)',
            '        write(request, 8, rest)',
            '    }',
            '',
            '    free(request)',
            '    free(remaining)',
            '}',
            '',
            '// The time of a clock of the system, in seconds.',
            'function clock(id: int): decimal {',
            '    immut time = allocate(16)',
            '    clock_gettime(id, time)',
            '    immut seconds: int = read(time, 0)',
            '    immut nanoseconds: int = read(time, 8)',
            '    free(time)',
            '    return decimal(seconds) + decimal(nanoseconds) / 1000000000',
            '}',
        ].join('\n'))
    }

    if (name == 'koji:aes') {
        return Some([
            '// `koji:aes`: the AEAD AES-GCM (FIPS 197, SP 800-38D) of TLS 1.3, with keys of 128 and 256 bits, in',
            '// the library of the runtime written in Koji. Only by the instructions of the processor (AES-NI and',
            '// PCLMULQDQ on x86-64, those of ARMv8 on arm64: small functions of the prelude, in C), which take',
            '// the same time whatever the key and the data are; without them `available()` is false and TLS',
            '// offers ChaCha20-Poly1305 alone (an AES by tables would let its times tell the key). Here the',
            '// counter blocks, the hash of the additional data, the ciphertext and their sizes, and the tag',
            '// (compared with no early exit).',
            '',
            'import { Address, CInt, CSize, allocate, free, nullAddress, offset, read, write } from \'koji:unsafe\'',
            '',
            'extern function memcpy(target: Address, source: Address, size: CSize): Address',
            'extern function memset(target: Address, value: CInt, size: CSize): Address',
            'extern function koji_aes_available(): boolean',
            'extern function koji_aes_expand(key: Address, size: int, schedule: Address)',
            'extern function koji_aes_ctr(schedule: Address, rounds: int, counter: Address, data: Address, out: Address, size: int)',
            'extern function koji_ghash_key(h: Address, table: Address)',
            'extern function koji_ghash(table: Address, state: Address, data: Address, size: int)',
            '',
            '// Whether this processor has the instructions.',
            'export function available(): boolean {',
            '    return koji_aes_available()',
            '}',
            '',
            '// A key made ready: its round keys and the powers of H (the block of zeros encrypted) for GHASH.',
            'export type AesKey = {',
            '    schedule: Address',
            '    rounds: int',
            '    table: Address',
            '}',
            '',
            '// The key of `size` bytes (16 or 32) at `key`, made ready (only when `available()`).',
            'export function keyOf(key: Address, size: int): AesKey {',
            '    immut schedule = allocate(240)',
            '    immut rounds = if (size == 16) { 10 } else { 14 }',
            '    koji_aes_expand(key, size, schedule)',
            '    immut h = allocate(16)',
            '    memset(h, 0, 16)',
            '    koji_aes_ctr(schedule, rounds, h, h, h, 16)',
            '    immut table = allocate(128)',
            '    koji_ghash_key(h, table)',
            '    memset(h, 0, 16)',
            '    free(h)',
            '    return { schedule: schedule, rounds: rounds, table: table }',
            '}',
            '',
            '// No key (for a connection whose suite is not AES).',
            'export function emptyKey(): AesKey {',
            '    return { schedule: nullAddress(), rounds: 0, table: nullAddress() }',
            '}',
            '',
            '// The memory of a key, cleared and given back.',
            'export function release(key: AesKey) {',
            '    memset(key.schedule, 0, 240)',
            '    memset(key.table, 0, 128)',
            '    free(key.schedule)',
            '    free(key.table)',
            '}',
            '',
            '// The counter block J0 + `step` of a nonce of 12 bytes (the nonce, then 1 + step as 4 big-endian',
            '// bytes), at `block`.',
            'function counterBlock(nonce: Address, step: int, block: Address) {',
            '    memcpy(block, nonce, 12)',
            '',
            '    for i in range(4) {',
            '        write(block, 12 + i, byte(((1 + step) >> (24 - 8 * i)) & 0xFF))',
            '    }',
            '}',
            '',
            '// The tag of the additional data and the ciphertext (`size` bytes at `data`) at `out`: GHASH over',
            '// both (each padded with zeros) and their sizes in bits, xored with the block J0 encrypted.',
            'function tag(key: AesKey, nonce: Address, aad: Address, aadSize: int, data: Address, size: int, out: Address) {',
            '    immut state = allocate(16)',
            '    memset(state, 0, 16)',
            '    koji_ghash(key.table, state, aad, aadSize)',
            '    koji_ghash(key.table, state, data, size)',
            '    immut sizes = allocate(16)',
            '',
            '    for i in range(8) {',
            '        write(sizes, i, byte(((aadSize * 8) >> (56 - 8 * i)) & 0xFF))',
            '        write(sizes, 8 + i, byte(((size * 8) >> (56 - 8 * i)) & 0xFF))',
            '    }',
            '',
            '    koji_ghash(key.table, state, sizes, 16)',
            '    immut block = allocate(16)',
            '    counterBlock(nonce, 0, block)',
            '    koji_aes_ctr(key.schedule, key.rounds, block, state, out, 16)',
            '    free(block)',
            '    free(sizes)',
            '    free(state)',
            '}',
            '',
            '// Seals the `size` bytes at `data` with `key` and `nonce` (12 bytes): the ciphertext and its tag of',
            '// 16 bytes at `out` (`size + 16` bytes).',
            'export function seal(key: AesKey, nonce: Address, aad: Address, aadSize: int, data: Address, size: int, out: Address) {',
            '    immut block = allocate(16)',
            '    counterBlock(nonce, 1, block)',
            '    koji_aes_ctr(key.schedule, key.rounds, block, data, out, size)',
            '    free(block)',
            '    tag(key, nonce, aad, aadSize, out, size, offset(out, size))',
            '}',
            '',
            '// Opens a ciphertext and its tag (`size` bytes, the last 16 the tag): its plaintext at `out`',
            '// (`size - 16` bytes), or false when the tag is not that of the ciphertext (nothing is written).',
            'export function open(key: AesKey, nonce: Address, aad: Address, aadSize: int, data: Address, size: int, out: Address): boolean {',
            '    if (size < 16) { return false }',
            '',
            '    immut length = size - 16',
            '    immut expected = allocate(16)',
            '    tag(key, nonce, aad, aadSize, data, length, expected)',
            '    mut difference = 0',
            '',
            '    for i in range(16) {',
            '        immut a: byte = read(expected, i)',
            '        immut b: byte = read(data, length + i)',
            '        difference = difference | (int(a) ^ int(b))',
            '    }',
            '',
            '    free(expected)',
            '',
            '    if (difference != 0) { return false }',
            '',
            '    immut block = allocate(16)',
            '    counterBlock(nonce, 1, block)',
            '    koji_aes_ctr(key.schedule, key.rounds, block, data, out, length)',
            '    free(block)',
            '    return true',
            '}',
            '',
            '// For C (the tests of the library): false when the processor has not the instructions.',
            'extern function koji_aes_gcm_seal(key: Address, keySize: CSize, nonce: Address, aad: Address, aadSize: CSize, data: Address, size: CSize, out: Address): boolean {',
            '    if (not available()) { return false }',
            '',
            '    immut ready = keyOf(key, keySize)',
            '    seal(ready, nonce, aad, aadSize, data, size, out)',
            '    release(ready)',
            '    return true',
            '}',
            '',
            'extern function koji_aes_gcm_open(key: Address, keySize: CSize, nonce: Address, aad: Address, aadSize: CSize, data: Address, size: CSize, out: Address): boolean {',
            '    if (not available()) { return false }',
            '',
            '    immut ready = keyOf(key, keySize)',
            '    immut good = open(ready, nonce, aad, aadSize, data, size, out)',
            '    release(ready)',
            '    return good',
            '}',
        ].join('\n'))
    }

    if (name == 'koji:bignum') {
        return Some([
            '// `koji:bignum`: numbers modulo an odd number of up to 8192 bits, by Montgomery\'s multiplication, in',
            '// the library of the runtime written in Koji: what the elliptic curves of NIST and RSA compute with.',
            '// A number is limbs of 64 bits, the lowest first (the bits of ints, at an address); a modulus keeps',
            '// its limbs, -1/p modulo 2^64 and R^2 modulo p (R = 2^(64 n)), and two numbers to work in (the',
            '// library has one thread: no operation allocates). Products are U128: a limb times a',
            '// limb plus two limbs fits 128 bits. Multiplying, adding and subtracting take the same steps',
            '// whatever the numbers are (the last subtraction is chosen with a mask).',
            '',
            'import { Address, CSize, U128, allocate, free, lowWord, offset, read, wide, wordProduct, write } from \'koji:unsafe\'',
            '',
            'extern function memcpy(target: Address, source: Address, size: CSize): Address',
            '',
            'export type Modulus = {',
            '    count: int',
            '    limbs: Address',
            '    inverse: int',
            '    squared: Address',
            '    sum: Address',
            '    difference: Address',
            '}',
            '',
            'export function limb(n: Address, i: int): int {',
            '    immut value: int = read(n, i * 8)',
            '    return value',
            '}',
            '',
            'export function setLimb(n: Address, i: int, value: int) {',
            '    write(n, i * 8, value)',
            '}',
            '',
            'function wordOf(n: Address, i: int): U128 {',
            '    return wide(limb(n, i), 0)',
            '}',
            '',
            '// A number of `count` limbs, zero.',
            'export function zeroNumber(count: int): Address {',
            '    immut n = allocate(count * 8 + 8)',
            '',
            '    for i in range(count + 1) {',
            '        setLimb(n, i, 0)',
            '    }',
            '',
            '    return n',
            '}',
            '',
            '// The number of the big-endian bytes at `bytes` (`size` of them), in `count` limbs (the bytes beyond',
            '// them are dropped).',
            'export function fromBytes(bytes: Address, size: int, count: int): Address {',
            '    immut n = zeroNumber(count)',
            '',
            '    for i in range(size) {',
            '        immut b: byte = read(bytes, size - 1 - i)',
            '        immut index = i / 8',
            '',
            '        if (index < count) { setLimb(n, index, limb(n, index) | (int(b) << (8 * (i % 8)))) }',
            '    }',
            '',
            '    return n',
            '}',
            '',
            '// The `size` big-endian bytes of a number of `count` limbs, at `out`.',
            'export function toBytes(n: Address, count: int, out: Address, size: int) {',
            '    for i in range(size) {',
            '        immut index = i / 8',
            '        immut value = if (index < count) { (limb(n, index) >> (8 * (i % 8))) & 0xFF } else { 0 }',
            '        write(out, size - 1 - i, byte(value))',
            '    }',
            '}',
            '',
            '// -1 / x modulo 2^64, for an odd x (Newton\'s iteration doubles the correct bits).',
            'function negativeInverse(x: int): int {',
            '    mut inverse = 1',
            '',
            '    for i in range(6) {',
            '        // inverse = inverse * (2 - x * inverse)',
            '        immut product = lowWord(wordProduct(wide(x, 0), wide(inverse, 0)))',
            '        immut factor = lowWord(wide(2, 0) - wide(product, 0))',
            '        inverse = lowWord(wordProduct(wide(inverse, 0), wide(factor, 0)))',
            '    }',
            '',
            '    return lowWord(wide(0, 0) - wide(inverse, 0))',
            '}',
            '',
            '// The modulus of the big-endian bytes at `bytes` (an odd number).',
            'export function modulusOf(bytes: Address, size: int): Modulus {',
            '    immut count = (size + 7) / 8',
            '    immut limbs = fromBytes(bytes, size, count)',
            '    // R^2 modulo p: 1 doubled 128 n times, each time reduced.',
            '    immut squared = zeroNumber(count)',
            '    setLimb(squared, 0, 1)',
            '',
            '    for i in range(128 * count) {',
            '        immut carry = shiftLeftOne(squared, count)',
            '',
            '        if (carry != 0 or compare(squared, limbs, count) >= 0) { subtractInPlace(squared, limbs, count) }',
            '    }',
            '',
            '    return { count: count, limbs: limbs, inverse: negativeInverse(limb(limbs, 0)), squared: squared, sum: zeroNumber(count), difference: zeroNumber(count) }',
            '}',
            '',
            '// n = 2n: the bit that leaves the top.',
            'function shiftLeftOne(n: Address, count: int): int {',
            '    mut carry = 0',
            '',
            '    for i in range(count) {',
            '        immut value = limb(n, i)',
            '        setLimb(n, i, (value << 1) | carry)',
            '        carry = (value >> 63) & 1',
            '    }',
            '',
            '    return carry',
            '}',
            '',
            '// The memory of a modulus given back.',
            'export function freeModulus(m: Modulus) {',
            '    for each in [m.limbs, m.squared, m.sum, m.difference] {',
            '        free(each)',
            '    }',
            '}',
            '',
            '// -1, 0 or 1 (not in constant time: for the setup and for public numbers).',
            'export function compare(a: Address, b: Address, count: int): int {',
            '    mut i = count - 1',
            '',
            '    while (i >= 0) {',
            '        immut x = wordOf(a, i)',
            '        immut y = wordOf(b, i)',
            '',
            '        if (x != y) { return if (x < y) { -1 } else { 1 } }',
            '',
            '        i -= 1',
            '    }',
            '',
            '    return 0',
            '}',
            '',
            '// a -= b: the borrow out (0 or 1).',
            'export function subtractInPlace(a: Address, b: Address, count: int): int {',
            '    mut borrow: U128 = 0',
            '',
            '    for i in range(count) {',
            '        immut difference = wordOf(a, i) - wordOf(b, i) - borrow',
            '        setLimb(a, i, lowWord(difference))',
            '        borrow = (difference >> 64) & wide(1, 0)',
            '    }',
            '',
            '    return lowWord(borrow)',
            '}',
            '',
            '// a += b: the carry out.',
            'export function addInPlace(a: Address, b: Address, count: int): int {',
            '    mut carry: U128 = 0',
            '',
            '    for i in range(count) {',
            '        immut sum = wordOf(a, i) + wordOf(b, i) + carry',
            '        setLimb(a, i, lowWord(sum))',
            '        carry = sum >> 64',
            '    }',
            '',
            '    return lowWord(carry)',
            '}',
            '',
            '// out = a when `choose` is 1, b when it is 0, with masks.',
            'export function select(out: Address, a: Address, b: Address, count: int, choose: int) {',
            '    immut mask = 0 - choose',
            '',
            '    for i in range(count) {',
            '        setLimb(out, i, (limb(a, i) & mask) | (limb(b, i) & (mask ^ -1)))',
            '    }',
            '}',
            '',
            '// out = a * b / R modulo p (out may be a or b); a and b below p. Through `t` (count + 2 limbs). The',
            '// product by a limb of b and the reduction in one pass ("FIOS"): t = (t + a b_i + m p) / 2^64, m',
            '// chosen so that the low limb is zero; two carries, each below 2^64 (a limb times a limb plus two',
            '// limbs fits 128 bits).',
            'export function multiply(m: Modulus, out: Address, a: Address, b: Address, t: Address) {',
            '    immut count = m.count',
            '    immut p = m.limbs',
            '',
            '    for i in range(count + 2) {',
            '        setLimb(t, i, 0)',
            '    }',
            '',
            '    for i in range(count) {',
            '        immut factor = wordOf(b, i)',
            '        immut first = wordOf(t, 0) + wordProduct(wordOf(a, 0), factor)',
            '        // m = t[0] * (-1/p) modulo 2^64.',
            '        immut reducer = wide(lowWord(wordProduct(first, wide(m.inverse, 0))), 0)',
            '        mut high: U128 = first >> 64',
            '        mut low: U128 = (wide(lowWord(first), 0) + wordProduct(reducer, wordOf(p, 0))) >> 64',
            '',
            '        for j in range(1, count) {',
            '            immut product = wordOf(t, j) + wordProduct(wordOf(a, j), factor) + high',
            '            high = product >> 64',
            '            immut reduced = wide(lowWord(product), 0) + wordProduct(reducer, wordOf(p, j)) + low',
            '            low = reduced >> 64',
            '            setLimb(t, j - 1, lowWord(reduced))',
            '        }',
            '',
            '        // t below 2p: its top limb 0 or 1.',
            '        immut top = wordOf(t, count) + high + low',
            '        setLimb(t, count - 1, lowWord(top))',
            '        setLimb(t, count, lowWord(top >> 64))',
            '    }',
            '',
            '    reduceOnce(m, out, t)',
            '}',
            '',
            '// out = t - p when t (count + 1 limbs, not `m.difference`) is at least p, else t; chosen with a',
            '// mask.',
            'function reduceOnce(m: Modulus, out: Address, t: Address) {',
            '    immut count = m.count',
            '    immut difference = m.difference',
            '    memcpy(difference, t, count * 8)',
            '    immut borrow = subtractInPlace(difference, m.limbs, count)',
            '    // t >= p when the top limb (0 or 1) covers the borrow; t is kept when it does not.',
            '    immut keep = borrow & (limb(t, count) ^ 1)',
            '    select(out, t, difference, count, keep)',
            '}',
            '',
            '// out = a + b modulo p, out = a - b modulo p (a and b below p).',
            'export function addModulo(m: Modulus, out: Address, a: Address, b: Address) {',
            '    immut count = m.count',
            '    immut sum = m.sum',
            '    memcpy(sum, a, count * 8)',
            '    setLimb(sum, count, addInPlace(sum, b, count))',
            '    reduceOnce(m, out, sum)',
            '}',
            '',
            'export function subtractModulo(m: Modulus, out: Address, a: Address, b: Address) {',
            '    immut count = m.count',
            '    immut difference = m.sum',
            '    memcpy(difference, a, count * 8)',
            '    immut borrow = subtractInPlace(difference, b, count)',
            '    // Below zero: p added back (the mask keeps p or makes it zero).',
            '    immut mask = 0 - borrow',
            '    mut carry: U128 = 0',
            '',
            '    for i in range(count) {',
            '        immut total = wordOf(difference, i) + wide(limb(m.limbs, i) & mask, 0) + carry',
            '        setLimb(out, i, lowWord(total))',
            '        carry = total >> 64',
            '    }',
            '}',
            '',
            '// Into the form of Montgomery (a R modulo p), and back out of it.',
            'export function toForm(m: Modulus, out: Address, a: Address, t: Address) {',
            '    multiply(m, out, a, m.squared, t)',
            '}',
            '',
            'export function fromForm(m: Modulus, out: Address, a: Address, t: Address) {',
            '    immut one = zeroNumber(m.count)',
            '    setLimb(one, 0, 1)',
            '    multiply(m, out, a, one, t)',
            '    free(one)',
            '}',
            '',
            '// a below p (the number of the bytes of a signature or a point must be).',
            'export function belowModulus(m: Modulus, a: Address): boolean {',
            '    return compare(a, m.limbs, m.count) < 0',
            '}',
            '',
            '// out = base^exponent modulo p, with base and out in the form of Montgomery; the exponent is the',
            '// big-endian bytes at `exponent` (public: its bits decide the steps).',
            'export function power(m: Modulus, out: Address, base: Address, exponent: Address, size: int, t: Address) {',
            '    immut count = m.count',
            '    immut result = zeroNumber(count)',
            '    // 1 in the form of Montgomery: R modulo p.',
            '    immut one = zeroNumber(count)',
            '    setLimb(one, 0, 1)',
            '    toForm(m, result, one, t)',
            '    free(one)',
            '',
            '    for i in range(size) {',
            '        immut b: byte = read(exponent, i)',
            '        mut bit = 7',
            '',
            '        while (bit >= 0) {',
            '            multiply(m, result, result, result, t)',
            '',
            '            if ((int(b) >> bit) & 1 == 1) { multiply(m, result, result, base, t) }',
            '',
            '            bit -= 1',
            '        }',
            '    }',
            '',
            '    memcpy(out, result, count * 8)',
            '    free(result)',
            '}',
            '',
            '// out = 1 / a modulo a prime p (a^(p - 2)), in the form of Montgomery.',
            'export function invertModulo(m: Modulus, out: Address, a: Address, t: Address) {',
            '    immut count = m.count',
            '    immut exponent = zeroNumber(count)',
            '    memcpy(exponent, m.limbs, count * 8)',
            '    immut two = zeroNumber(count)',
            '    setLimb(two, 0, 2)',
            '    subtractInPlace(exponent, two, count)',
            '    immut bytes = allocate(count * 8)',
            '    toBytes(exponent, count, bytes, count * 8)',
            '    power(m, out, a, bytes, count * 8, t)',
            '    free(bytes)',
            '    free(two)',
            '    free(exponent)',
            '}',
            '',
            '// For C (the tests of the library): base^exponent modulo p, all big-endian bytes of `size` bytes',
            '// (those of p), at `out`.',
            'extern function koji_modular_power(base: Address, exponent: Address, exponentSize: CSize, modulus: Address, size: CSize, out: Address) {',
            '    immut m = modulusOf(modulus, size)',
            '    immut t = zeroNumber(m.count + 2)',
            '    immut a = fromBytes(base, size, m.count)',
            '    immut form = zeroNumber(m.count)',
            '    toForm(m, form, a, t)',
            '    power(m, form, form, exponent, exponentSize, t)',
            '    fromForm(m, a, form, t)',
            '    toBytes(a, m.count, out, size)',
            '',
            '    freeModulus(m)',
            '',
            '    for each in [t, a, form] {',
            '        free(each)',
            '    }',
            '}',
        ].join('\n'))
    }

    if (name == 'koji:chacha') {
        return Some([
            '// `koji:chacha`: the cipher ChaCha20 and the authenticator Poly1305, sealed together as the AEAD',
            '// ChaCha20-Poly1305 of RFC 8439, in the library of the runtime written in Koji (a cipher suite of TLS',
            '// 1.3). Its words are ints below 2^32 (sums masked), and Poly1305 works on numbers of 130 bits in',
            '// five limbs of 26 bits, whose products fit in an int. Nothing depends on the value of a secret:',
            '// no branch, no address (the tag is compared with no early exit).',
            '',
            'import { Address, CInt, CSize, allocate, free, offset, read, write } from \'koji:unsafe\'',
            '',
            'extern function memcpy(target: Address, source: Address, size: CSize): Address',
            'extern function memset(target: Address, value: CInt, size: CSize): Address',
            '',
            'immut mask32 = 0xFFFFFFFF',
            'immut mask26 = 0x3FFFFFF',
            '',
            'function byteAt(bytes: Address, i: int): int {',
            '    immut b: byte = read(bytes, i)',
            '    return int(b)',
            '}',
            '',
            'function putByte(bytes: Address, i: int, value: int) {',
            '    write(bytes, i, byte(value & 0xFF))',
            '}',
            '',
            '// The little-endian word of 32 bits at `at`.',
            'function le32(bytes: Address, at: int): int {',
            '    return byteAt(bytes, at) | (byteAt(bytes, at + 1) << 8) | (byteAt(bytes, at + 2) << 16) | (byteAt(bytes, at + 3) << 24)',
            '}',
            '',
            'function putLe32(bytes: Address, at: int, value: int) {',
            '    putByte(bytes, at, value)',
            '    putByte(bytes, at + 1, value >> 8)',
            '    putByte(bytes, at + 2, value >> 16)',
            '    putByte(bytes, at + 3, value >> 24)',
            '}',
            '',
            'function rotl32(x: int, n: int): int {',
            '    return ((x << n) | (x >> (32 - n))) & mask32',
            '}',
            '',
            '// ChaCha20',
            '',
            '// The quarter round on four words of the state (an address of 16 ints).',
            'function quarter(s: Address, a: int, b: int, c: int, d: int) {',
            '    mut x = wordAt(s, a)',
            '    mut y = wordAt(s, b)',
            '    mut z = wordAt(s, c)',
            '    mut w = wordAt(s, d)',
            '    x = (x + y) & mask32',
            '    w = rotl32(w ^ x, 16)',
            '    z = (z + w) & mask32',
            '    y = rotl32(y ^ z, 12)',
            '    x = (x + y) & mask32',
            '    w = rotl32(w ^ x, 8)',
            '    z = (z + w) & mask32',
            '    y = rotl32(y ^ z, 7)',
            '    write(s, a * 8, x)',
            '    write(s, b * 8, y)',
            '    write(s, c * 8, z)',
            '    write(s, d * 8, w)',
            '}',
            '',
            'function wordAt(words: Address, i: int): int {',
            '    immut word: int = read(words, i * 8)',
            '    return word',
            '}',
            '',
            '// The block of 64 bytes of keystream for `key` (32 bytes), `counter` and `nonce` (12 bytes), at',
            '// `out`, through `state` and `work` (16 ints each).',
            'function block(key: Address, counter: int, nonce: Address, out: Address, state: Address, work: Address) {',
            '    // "expand 32-byte k"',
            '    write(state, 0, 0x61707865)',
            '    write(state, 8, 0x3320646E)',
            '    write(state, 16, 0x79622D32)',
            '    write(state, 24, 0x6B206574)',
            '',
            '    for i in range(8) {',
            '        write(state, (4 + i) * 8, le32(key, i * 4))',
            '    }',
            '',
            '    write(state, 96, counter & mask32)',
            '',
            '    for i in range(3) {',
            '        write(state, (13 + i) * 8, le32(nonce, i * 4))',
            '    }',
            '',
            '    memcpy(work, state, 128)',
            '    mut round = 0',
            '',
            '    while (round < 10) {',
            '        quarter(work, 0, 4, 8, 12)',
            '        quarter(work, 1, 5, 9, 13)',
            '        quarter(work, 2, 6, 10, 14)',
            '        quarter(work, 3, 7, 11, 15)',
            '        quarter(work, 0, 5, 10, 15)',
            '        quarter(work, 1, 6, 11, 12)',
            '        quarter(work, 2, 7, 8, 13)',
            '        quarter(work, 3, 4, 9, 14)',
            '        round += 1',
            '    }',
            '',
            '    for i in range(16) {',
            '        putLe32(out, i * 4, (wordAt(work, i) + wordAt(state, i)) & mask32)',
            '    }',
            '}',
            '',
            '// The `size` bytes at `data` encrypted (or decrypted) at `out`, from the block `counter` on.',
            'export function chacha20(key: Address, counter: int, nonce: Address, data: Address, size: int, out: Address) {',
            '    immut state = allocate(128)',
            '    immut work = allocate(128)',
            '    immut stream = allocate(64)',
            '    mut at = 0',
            '    mut number = counter',
            '',
            '    while (at < size) {',
            '        block(key, number, nonce, stream, state, work)',
            '        immut count = if (size - at < 64) { size - at } else { 64 }',
            '',
            '        for i in range(count) {',
            '            putByte(out, at + i, byteAt(data, at + i) ^ byteAt(stream, i))',
            '        }',
            '',
            '        at += count',
            '        number += 1',
            '    }',
            '',
            '    free(stream)',
            '    free(work)',
            '    free(state)',
            '}',
            '',
            '// Poly1305',
            '',
            '// The tag of 16 bytes of the `size` bytes at `data` with the one-time key `key` (32 bytes), at',
            '// `out`.',
            'export function poly1305(key: Address, data: Address, size: int, out: Address) {',
            '    // r, clamped, in limbs of 26 bits; and the limbs times 5, for the reduction by 2^130 = 5.',
            '    immut r0 = le32(key, 0) & 0x3FFFFFF',
            '    immut r1 = (le32(key, 3) >> 2) & 0x3FFFF03',
            '    immut r2 = (le32(key, 6) >> 4) & 0x3FFC0FF',
            '    immut r3 = (le32(key, 9) >> 6) & 0x3F03FFF',
            '    immut r4 = (le32(key, 12) >> 8) & 0x00FFFFF',
            '    immut s1 = r1 * 5',
            '    immut s2 = r2 * 5',
            '    immut s3 = r3 * 5',
            '    immut s4 = r4 * 5',
            '    mut h0 = 0',
            '    mut h1 = 0',
            '    mut h2 = 0',
            '    mut h3 = 0',
            '    mut h4 = 0',
            '    immut last = allocate(16)',
            '    mut at = 0',
            '',
            '    while (at < size) {',
            '        // A block of 16 bytes and a 1 bit after it; a shorter last block has the 1 right after its',
            '        // bytes, then zeros.',
            '        mut piece = offset(data, at)',
            '        mut high = 1 << 24',
            '',
            '        if (size - at < 16) {',
            '            memset(last, 0, 16)',
            '            memcpy(last, piece, size - at)',
            '            putByte(last, size - at, 1)',
            '            piece = last',
            '            high = 0',
            '        }',
            '',
            '        h0 += le32(piece, 0) & mask26',
            '        h1 += (le32(piece, 3) >> 2) & mask26',
            '        h2 += (le32(piece, 6) >> 4) & mask26',
            '        h3 += (le32(piece, 9) >> 6) & mask26',
            '        h4 += (le32(piece, 12) >> 8) | high',
            '        // h * r, modulo 2^130 - 5.',
            '        immut d0 = h0 * r0 + h1 * s4 + h2 * s3 + h3 * s2 + h4 * s1',
            '        mut d1 = h0 * r1 + h1 * r0 + h2 * s4 + h3 * s3 + h4 * s2',
            '        mut d2 = h0 * r2 + h1 * r1 + h2 * r0 + h3 * s4 + h4 * s3',
            '        mut d3 = h0 * r3 + h1 * r2 + h2 * r1 + h3 * r0 + h4 * s4',
            '        mut d4 = h0 * r4 + h1 * r3 + h2 * r2 + h3 * r1 + h4 * r0',
            '        h0 = d0 & mask26',
            '        d1 += d0 >> 26',
            '        h1 = d1 & mask26',
            '        d2 += d1 >> 26',
            '        h2 = d2 & mask26',
            '        d3 += d2 >> 26',
            '        h3 = d3 & mask26',
            '        d4 += d3 >> 26',
            '        h4 = d4 & mask26',
            '        h0 += (d4 >> 26) * 5',
            '        h1 += h0 >> 26',
            '        h0 = h0 & mask26',
            '        at += 16',
            '    }',
            '',
            '    free(last)',
            '    // The full carry, then h - p when h is at least p (chosen without a branch).',
            '    h2 += h1 >> 26',
            '    h1 = h1 & mask26',
            '    h3 += h2 >> 26',
            '    h2 = h2 & mask26',
            '    h4 += h3 >> 26',
            '    h3 = h3 & mask26',
            '    h0 += (h4 >> 26) * 5',
            '    h4 = h4 & mask26',
            '    h1 += h0 >> 26',
            '    h0 = h0 & mask26',
            '    mut g0 = h0 + 5',
            '    mut g1 = h1 + (g0 >> 26)',
            '    g0 = g0 & mask26',
            '    mut g2 = h2 + (g1 >> 26)',
            '    g1 = g1 & mask26',
            '    mut g3 = h3 + (g2 >> 26)',
            '    g2 = g2 & mask26',
            '    mut g4 = h4 + (g3 >> 26) - (1 << 26)',
            '    g3 = g3 & mask26',
            '    // All ones when g is negative (h below p): keep h.',
            '    immut keep = g4 >> 63',
            '    h0 = (h0 & keep) | (g0 & (keep ^ -1))',
            '    h1 = (h1 & keep) | (g1 & (keep ^ -1))',
            '    h2 = (h2 & keep) | (g2 & (keep ^ -1))',
            '    h3 = (h3 & keep) | (g3 & (keep ^ -1))',
            '    h4 = (h4 & keep) | ((g4 & mask26) & (keep ^ -1))',
            '    // h + s, modulo 2^128, in four words of 32 bits.',
            '    immut w0 = (h0 | (h1 << 26)) & mask32',
            '    immut w1 = ((h1 >> 6) | (h2 << 20)) & mask32',
            '    immut w2 = ((h2 >> 12) | (h3 << 14)) & mask32',
            '    immut w3 = ((h3 >> 18) | (h4 << 8)) & mask32',
            '    mut f = w0 + le32(key, 16)',
            '    putLe32(out, 0, f)',
            '    f = w1 + le32(key, 20) + (f >> 32)',
            '    putLe32(out, 4, f)',
            '    f = w2 + le32(key, 24) + (f >> 32)',
            '    putLe32(out, 8, f)',
            '    f = w3 + le32(key, 28) + (f >> 32)',
            '    putLe32(out, 12, f)',
            '}',
            '',
            '// ChaCha20-Poly1305',
            '',
            '// The tag of the AEAD: Poly1305 with the first 32 bytes of the block 0 as its key, over the',
            '// additional data, the ciphertext (each padded with zeros to 16 bytes) and their sizes.',
            'function tag(key: Address, nonce: Address, aad: Address, aadSize: int, cipher: Address, size: int, out: Address) {',
            '    immut oneTime = allocate(64)',
            '    immut state = allocate(128)',
            '    immut work = allocate(128)',
            '    block(key, 0, nonce, oneTime, state, work)',
            '    free(work)',
            '    free(state)',
            '    immut aadPadded = (aadSize + 15) / 16 * 16',
            '    immut cipherPadded = (size + 15) / 16 * 16',
            '    immut total = aadPadded + cipherPadded + 16',
            '    immut text = allocate(total)',
            '    memset(text, 0, total)',
            '    memcpy(text, aad, aadSize)',
            '    memcpy(offset(text, aadPadded), cipher, size)',
            '',
            '    for i in range(8) {',
            '        putByte(text, aadPadded + cipherPadded + i, aadSize >> (8 * i))',
            '        putByte(text, aadPadded + cipherPadded + 8 + i, size >> (8 * i))',
            '    }',
            '',
            '    poly1305(oneTime, text, total, out)',
            '    free(text)',
            '    free(oneTime)',
            '}',
            '',
            '// Seals the `size` bytes at `data` with `key` (32 bytes) and `nonce` (12 bytes): the ciphertext and',
            '// its tag of 16 bytes at `out` (`size + 16` bytes).',
            'export function seal(key: Address, nonce: Address, aad: Address, aadSize: int, data: Address, size: int, out: Address) {',
            '    chacha20(key, 1, nonce, data, size, out)',
            '    tag(key, nonce, aad, aadSize, out, size, offset(out, size))',
            '}',
            '',
            '// Opens a ciphertext and its tag (`size` bytes, the last 16 the tag): its plaintext at `out`',
            '// (`size - 16` bytes), or false when the tag is not that of the ciphertext (nothing is written).',
            'export function open(key: Address, nonce: Address, aad: Address, aadSize: int, data: Address, size: int, out: Address): boolean {',
            '    if (size < 16) { return false }',
            '',
            '    immut expected = allocate(16)',
            '    tag(key, nonce, aad, aadSize, data, size - 16, expected)',
            '    mut difference = 0',
            '',
            '    for i in range(16) {',
            '        difference = difference | (byteAt(expected, i) ^ byteAt(data, size - 16 + i))',
            '    }',
            '',
            '    free(expected)',
            '',
            '    if (difference != 0) { return false }',
            '',
            '    chacha20(key, 1, nonce, data, size - 16, out)',
            '    return true',
            '}',
            '',
            '// For C (the tests of the library).',
            '',
            'extern function koji_chacha20_poly1305_seal(key: Address, nonce: Address, aad: Address, aadSize: CSize, data: Address, size: CSize, out: Address) {',
            '    seal(key, nonce, aad, aadSize, data, size, out)',
            '}',
            '',
            'extern function koji_chacha20_poly1305_open(key: Address, nonce: Address, aad: Address, aadSize: CSize, data: Address, size: CSize, out: Address): boolean {',
            '    return open(key, nonce, aad, aadSize, data, size, out)',
            '}',
        ].join('\n'))
    }

    if (name == 'koji:closure') {
        return Some([
            '// `koji:closure`: closures, a function with the values it captured, in the library of the runtime',
            '// written in Koji (C calls these functions by their names). A closure is 4 words (runtime/prelude.h,',
            '// which counts its references and reads its code and environment inline): the count of',
            '// references, the code of the function, its environment (a record of the captured values, which',
            '// the generated code gives it as the first argument, or none) and the name of the function.',
            '',
            'import { Address, distance, read, write } from \'koji:unsafe\'',
            'import { cText } from \'koji:core\'',
            '',
            'extern function koji_memory_take(words: int): Address',
            'extern function koji_memory_give(block: Address, words: int)',
            'extern function koji_record_drop(record: Address)',
            '',
            '// A new closure: it takes the caller\'s reference to `environment`.',
            'extern function koji_closure_new(code: Address, environment: Address, name: Address): Address {',
            '    immut closure = koji_memory_take(4)',
            '    write(closure, 0, 1)',
            '    write(closure, 8, code)',
            '    write(closure, 16, environment)',
            '    write(closure, 24, name)',
            '    return closure',
            '}',
            '',
            '// Releases the environment of a closure without references, and frees it.',
            'extern function koji_closure_free(closure: Address) {',
            '    immut environment: Address = read(closure, 16)',
            '    koji_record_drop(environment)',
            '    koji_memory_give(closure, 4)',
            '}',
            '',
            '// `<function double>`.',
            'extern function koji_closure_repr(closure: Address): string {',
            '    immut name: Address = read(closure, 24)',
            '    return `<function ${cText(name)}>`',
            '}',
            '',
            '// The same closure (functions have no other equality).',
            'extern function koji_closure_equal(a: Address, b: Address): boolean {',
            '    return distance(a, b) == 0',
            '}',
        ].join('\n'))
    }

    if (name == 'koji:core') {
        return Some([
            '// `koji:core`: methods of strings written in Koji. The compiler calls the function of a method\'s',
            '// name with the string first (`text.trim()` is `trim(text)`), and the `Location` of the call last',
            '// when it may panic. Programs cannot import it. It has no top-level variables: it is never',
            '// initialized.',
            '',
            'import { Address, CInt, CSize, Location, U128, allocate, blankString, charOfCode, distance, free, leadingZeros, listItems, lowWord, newString, nullAddress, offset, panicAt, read, reserve, setListLength, stringBytes, stringSize, wide, wideToFloat, write } from \'koji:unsafe\'',
            '',
            '// The C library: `memcmp` compares bytes, `memmem` finds bytes among others (the address of the',
            '// first match, or 0).',
            'extern function memcmp(a: Address, b: Address, size: CSize): CInt',
            'extern function memmem(haystack: Address, haystackSize: CSize, needle: Address, needleSize: CSize): Address',
            'extern function strlen(text: Address): CSize',
            'extern function strtod(text: Address, end: Address): float',
            'extern function memcpy(target: Address, source: Address, size: CSize): Address',
            '// A line of the standard input, from the library (std/koji/output.kj).',
            'extern function koji_read_line(prompt: string, here: Location, status: Address): string',
            '// The decimal of a text, from the library (std/koji/decimal.kj).',
            'extern function koji_decimal_parse(text: string, status: Address): decimal',
            '',
            '// Without the white space at both ends (as Unicode defines white space).',
            'export function trim(text: string): string {',
            '    immut bytes = stringBytes(text)',
            '    immut size = stringSize(text)',
            '    immut start = spaceEnd(bytes, 0, size)',
            '    immut end = spaceStart(bytes, start, size)',
            '',
            '    if (start == 0 and end == size) { return text }',
            '',
            '    return copyBytes(bytes, start, end)',
            '}',
            '',
            '// The first byte from `start` that is not white space.',
            'function spaceEnd(bytes: Address, start: int, size: int): int {',
            '    mut at = start',
            '',
            '    while (at < size) {',
            '        immut b: byte = read(bytes, at)',
            '',
            '        if (b < 0x80) {',
            '            if (not isSpace(int(b))) { return at }',
            '',
            '            at += 1',
            '            continue',
            '        }',
            '',
            '        immut width = widthAt(bytes, at)',
            '',
            '        if (not isSpace(codeAt(bytes, at, width))) { return at }',
            '',
            '        at += width',
            '    }',
            '',
            '    return at',
            '}',
            '',
            '// The end of the bytes before `end` without the white space at their end, down to `start`.',
            'function spaceStart(bytes: Address, start: int, end: int): int {',
            '    mut at = end',
            '',
            '    while (at > start) {',
            '        immut b: byte = read(bytes, at - 1)',
            '',
            '        if (b < 0x80) {',
            '            if (not isSpace(int(b))) { return at }',
            '',
            '            at -= 1',
            '            continue',
            '        }',
            '',
            '        mut last = at - 1',
            '',
            '        while (isContinuation(bytes, last)) {',
            '            last -= 1',
            '        }',
            '',
            '        if (not isSpace(codeAt(bytes, last, at - last))) { return at }',
            '',
            '        at = last',
            '    }',
            '',
            '    return at',
            '}',
            '',
            '// A new string of the bytes from `start` to `end` of a string (whole characters, so UTF-8).',
            'function copyBytes(bytes: Address, start: int, end: int): string {',
            '    immut copy = blankString(end - start, end - start)',
            '    memcpy(stringBytes(copy), offset(bytes, start), end - start)',
            '    return copy',
            '}',
            '',
            'function startsWith(text: string, prefix: string): boolean {',
            '    immut size = stringSize(prefix)',
            '',
            '    if (size > stringSize(text)) { return false }',
            '',
            '    return memcmp(stringBytes(text), stringBytes(prefix), size) == 0',
            '}',
            '',
            'function endsWith(text: string, suffix: string): boolean {',
            '    immut size = stringSize(suffix)',
            '    immut start = stringSize(text) - size',
            '',
            '    if (start < 0) { return false }',
            '',
            '    return memcmp(offset(stringBytes(text), start), stringBytes(suffix), size) == 0',
            '}',
            '',
            '// The position of the first `part`, in characters (like indexing and `length()`).',
            'function indexOf(text: string, part: string): Option[int] {',
            '    immut bytes = stringBytes(text)',
            '    immut found = find(text, part, 0)',
            '',
            '    if (found < 0) { return None }',
            '',
            '    mut characters = 0',
            '',
            '    for i in range(found) {',
            '        if (not isContinuation(bytes, i)) { characters += 1 }',
            '    }',
            '',
            '    return Some(characters)',
            '}',
            '',
            '// The parts of `text` between the separators.',
            'function split(text: string, separator: string, here: Location): string[] {',
            '    if (stringSize(separator) == 0) { panicAt(here, \'split() separator cannot be empty\') }',
            '',
            '    immut bytes = stringBytes(text)',
            '    mut parts: string[] = []',
            '    mut start = 0',
            '',
            '    while (true) {',
            '        immut found = find(text, separator, start)',
            '',
            '        if (found < 0) { break }',
            '',
            '        parts.push(newString(offset(bytes, start), found - start))',
            '        start = found + stringSize(separator)',
            '    }',
            '',
            '    parts.push(newString(offset(bytes, start), stringSize(text) - start))',
            '    return parts',
            '}',
            '',
            '// `text` with `new` in the place of each `old`.',
            'function replace(text: string, old: string, new: string, here: Location): string {',
            '    if (stringSize(old) == 0) { panicAt(here, \'replace() needs a non-empty text to replace\') }',
            '',
            '    mut found = find(text, old, 0)',
            '',
            '    if (found < 0) { return text }',
            '',
            '    immut bytes = stringBytes(text)',
            '    mut replaced = \'\'',
            '    mut start = 0',
            '',
            '    while (found >= 0) {',
            '        replaced += newString(offset(bytes, start), found - start)',
            '        replaced += new',
            '        start = found + stringSize(old)',
            '        found = find(text, old, start)',
            '    }',
            '',
            '    replaced += newString(offset(bytes, start), stringSize(text) - start)',
            '    return replaced',
            '}',
            '',
            '// The byte where `part` first is in `text`, from the byte `start`, or -1.',
            'function find(text: string, part: string, start: int): int {',
            '    immut bytes = stringBytes(text)',
            '    immut found = memmem(offset(bytes, start), stringSize(text) - start, stringBytes(part), stringSize(part))',
            '',
            '    // Not found: the address 0, before the bytes.',
            '    immut position = distance(bytes, found)',
            '    return if (position < 0) { -1 } else { position }',
            '}',
            '',
            '// The bytes of UTF-8 that continue a character (`10xxxxxx`).',
            'export function isContinuation(bytes: Address, at: int): boolean {',
            '    immut b: byte = read(bytes, at)',
            '    return (b & 0xC0) == 0x80',
            '}',
            '',
            '// The bytes of the character that starts at `at`.',
            'function widthAt(bytes: Address, at: int): int {',
            '    immut b: byte = read(bytes, at)',
            '',
            '    if (b < 0x80) { return 1 }',
            '',
            '    if (b < 0xE0) { return 2 }',
            '',
            '    if (b < 0xF0) { return 3 }',
            '',
            '    return 4',
            '}',
            '',
            '// The code of the character of `width` bytes at `at`.',
            'function codeAt(bytes: Address, at: int, width: int): int {',
            '    immut first: byte = read(bytes, at)',
            '',
            '    if (width == 1) { return int(first) }',
            '',
            '    mut code = int(first & (0x7F >> byte(width)))',
            '',
            '    for i in range(1, width) {',
            '        immut next: byte = read(bytes, at + i)',
            '        code = (code << 6) | int(next & 0x3F)',
            '    }',
            '',
            '    return code',
            '}',
            '',
            '// White space, as Unicode defines it (`White_Space`).',
            'export function isSpace(code: int): boolean {',
            '    if (code <= 0x20) { return code == 0x20 or (code >= 0x09 and code <= 0x0D) }',
            '',
            '    if (code < 0x85) { return false }',
            '',
            '    if (code < 0x1680) { return code == 0x85 or code == 0xA0 }',
            '',
            '    if (code >= 0x2000 and code <= 0x200A) { return true }',
            '',
            '    return code == 0x1680 or code == 0x2028 or code == 0x2029 or code == 0x202F or code == 0x205F or code == 0x3000',
            '}',
            '',
            '// A string of bytes that may not be UTF-8 (from the system): each invalid sequence becomes',
            '// U+FFFD, as long as the longest start of a valid one (as Unicode recommends).',
            'export function textOf(bytes: Address, size: int): string {',
            '    mut out = \'\'',
            '    mut start = 0',
            '    mut at = 0',
            '',
            '    while (at < size) {',
            '        immut valid = validAt(bytes, at, size)',
            '',
            '        if (valid > 0) {',
            '            at += valid',
            '            continue',
            '        }',
            '',
            '        // `-valid` bytes are not a character.',
            '        if (at > start) { out += newString(offset(bytes, start), at - start) }',
            '',
            '        out += \'�\'',
            '        at -= valid',
            '        start = at',
            '    }',
            '',
            '    if (start == 0) { return newString(bytes, size) }',
            '',
            '    if (at > start) { out += newString(offset(bytes, start), at - start) }',
            '',
            '    return out',
            '}',
            '',
            '// Whether the bytes are UTF-8.',
            'export function isUtf8(bytes: Address, size: int): boolean {',
            '    mut at = 0',
            '',
            '    while (at < size) {',
            '        immut valid = validAt(bytes, at, size)',
            '',
            '        if (valid < 0) { return false }',
            '',
            '        at += valid',
            '    }',
            '',
            '    return true',
            '}',
            '',
            '// The bytes of the valid character at `at`, or minus those of the longest start of one there',
            '// (at least one byte).',
            'function validAt(bytes: Address, at: int, size: int): int {',
            '    immut first = byteAt(bytes, at, size)',
            '',
            '    if (first < 0x80) { return 1 }',
            '',
            '    // The second byte, with its range for the first one (no overlong forms, no surrogates, nothing',
            '    // beyond U+10FFFF).',
            '    mut width = 0',
            '    mut low = 0x80',
            '    mut high = 0xBF',
            '',
            '    if (first >= 0xC2 and first <= 0xDF) { width = 2 }',
            '',
            '    if (first >= 0xE0 and first <= 0xEF) { width = 3 }',
            '',
            '    if (first >= 0xF0 and first <= 0xF4) { width = 4 }',
            '',
            '    if (width == 0) { return -1 }',
            '',
            '    if (first == 0xE0) { low = 0xA0 }',
            '',
            '    if (first == 0xED) { high = 0x9F }',
            '',
            '    if (first == 0xF0) { low = 0x90 }',
            '',
            '    if (first == 0xF4) { high = 0x8F }',
            '',
            '    immut second = byteAt(bytes, at + 1, size)',
            '',
            '    if (second < low or second > high) { return -1 }',
            '',
            '    for i in range(2, width) {',
            '        immut next = byteAt(bytes, at + i, size)',
            '',
            '        if (next < 0x80 or next > 0xBF) { return -i }',
            '    }',
            '',
            '    return width',
            '}',
            '',
            '// The byte at `at`, or -1 past the end.',
            'function byteAt(bytes: Address, at: int, size: int): int {',
            '    if (at >= size) { return -1 }',
            '',
            '    immut b: byte = read(bytes, at)',
            '    return int(b)',
            '}',
            '',
            '// For the modules that call the C library.',
            '',
            '// A copy of `text` as a string of C, to free (`text` has no NUL: see `hasNul`).',
            'export function cString(text: string): Address {',
            '    immut size = stringSize(text)',
            '    immut copy = allocate(size + 1)',
            '    immut bytes = stringBytes(text)',
            '',
            '    for i in range(size) {',
            '        immut b: byte = read(bytes, i)',
            '        write(copy, i, b)',
            '    }',
            '',
            '    immut end: byte = 0',
            '    write(copy, size, end)',
            '    return copy',
            '}',
            '',
            '// A string of C, as text (invalid UTF-8 becomes U+FFFD).',
            'export function cText(address: Address): string {',
            '    return textOf(address, strlen(address))',
            '}',
            '',
            '// Whether `text` has a NUL, which a string of C cannot hold.',
            'export function hasNul(text: string): boolean {',
            '    immut bytes = stringBytes(text)',
            '',
            '    for i in range(stringSize(text)) {',
            '        if (byteAt(bytes, i, stringSize(text)) == 0) { return true }',
            '    }',
            '',
            '    return false',
            '}',
            '',
            '// The characters of a string (`text.chars()`, and `for c in text`).',
            'function chars(text: string): char[] {',
            '    immut bytes = stringBytes(text)',
            '    immut size = stringSize(text)',
            '    mut found: char[] = []',
            '    // A character per byte at most (exact for ASCII), written in place: a word each.',
            '    reserve(found, size)',
            '    mut slot = listItems(found)',
            '    mut count = 0',
            '    mut at = 0',
            '',
            '    while (at < size) {',
            '        immut first: byte = read(bytes, at)',
            '',
            '        if (first < 0x80) {',
            '            write(slot, 0, int(first))',
            '            at += 1',
            '        } else {',
            '            immut width = widthAt(bytes, at)',
            '            write(slot, 0, codeAt(bytes, at, width))',
            '            at += width',
            '        }',
            '',
            '        slot = offset(slot, 8)',
            '        count += 1',
            '    }',
            '',
            '    setListLength(found, count)',
            '    return found',
            '}',
            '',
            '// `char(code)`: the character with that code, or `None` (above U+10FFFF, or a surrogate).',
            'function charOf(code: int): Option[char] {',
            '    if (code < 0 or code > 0x10FFFF or (code >= 0xD800 and code <= 0xDFFF)) { return None }',
            '',
            '    return Some(charOfCode(code))',
            '}',
            '',
            '// The numbers of text (`int(text)`, `float(text)`, `decimal(text)`), with white space around.',
            '',
            '// An optional sign, then decimal digits.',
            'function intOf(text: string): Result[int, ParseError] {',
            '    immut bytes = stringBytes(text)',
            '    immut size = stringSize(text)',
            '    immut start = spaceEnd(bytes, 0, size)',
            '    immut end = spaceStart(bytes, start, size)',
            '    mut at = start',
            '    mut negative = false',
            '',
            '    if (at < end) {',
            '        immut sign: byte = read(bytes, at)',
            '',
            '        if (sign == 43 or sign == 45) {',
            '            negative = sign == 45',
            '            at += 1',
            '        }',
            '    }',
            '',
            '    if (at == end) { return Err(InvalidNumber(text)) }',
            '',
            '    // The digits, while they fit (up to 2^63, for the most negative int).',
            '    mut value = 0',
            '    mut overflow = false',
            '    immut lastDigit = if (negative) { 8 } else { 7 }',
            '',
            '    while (at < end) {',
            '        immut b: byte = read(bytes, at)',
            '',
            '        if (b < 48 or b > 57) { return Err(InvalidNumber(text)) }',
            '',
            '        immut digit = int(b) - 48',
            '',
            '        if (value < -922337203685477580 or (value == -922337203685477580 and digit > lastDigit)) { overflow = true }',
            '',
            '        if (not overflow) {',
            '            // Negative while it is built, so that -2^63 fits.',
            '            value = value * 10 - digit',
            '        }',
            '',
            '        at += 1',
            '    }',
            '',
            '    if (overflow) { return Err(OutOfRange(text)) }',
            '',
            '    return Ok(if (negative) { value } else { -value })',
            '}',
            '',
            '// Decimal notation (as Rust reads floats; no `nan` or `inf`), or hexadecimal after `0x`.',
            'function floatOf(text: string): Result[float, ParseError] {',
            '    immut bytes = stringBytes(text)',
            '    immut size = stringSize(text)',
            '    immut start = spaceEnd(bytes, 0, size)',
            '    immut end = spaceStart(bytes, start, size)',
            '    mut first = start',
            '',
            '    while (first < end and (byteAt(bytes, first, end) == 43 or byteAt(bytes, first, end) == 45)) {',
            '        first += 1',
            '    }',
            '',
            '    if (byteAt(bytes, first, end) == 48 and byteAt(bytes, first + 1, end) == 120) {',
            '        mut code = 0',
            '        // The trimmed text is an argument, which lives while it is read.',
            '        immut value = hexFloat(copyBytes(bytes, start, end), mut code)',
            '',
            '        if (code == 1) { return Err(InvalidNumber(text)) }',
            '',
            '        if (code == 2) { return Err(OutOfRange(text)) }',
            '',
            '        return Ok(value)',
            '    }',
            '',
            '    mut value = float(0)',
            '    immut status = decimalFloat(bytes, start, end, mut value)',
            '',
            '    if (status == 1) { return Err(InvalidNumber(text)) }',
            '',
            '    if (status == 2) { return Err(OutOfRange(text)) }',
            '',
            '    return Ok(value)',
            '}',
            '',
            '// The float of the bytes from `start` to `end` in decimal notation: 0, or 1 when they are not in',
            '// it, or 2 when it is beyond a float. Exact without `strtod` when the digits fit in 2^53 and the',
            '// power of 10 is a float too (Clinger\'s fast path).',
            'function decimalFloat(bytes: Address, start: int, end: int, mut value: float): int {',
            '    mut at = start',
            '    mut negative = false',
            '',
            '    if (at < end and isSign(byteAt(bytes, at, end))) {',
            '        negative = byteAt(bytes, at, end) == 45',
            '        at += 1',
            '    }',
            '',
            '    // The significant digits, while there are at most 18 of them (they fit in an int).',
            '    mut digits = 0',
            '    mut count = 0',
            '    mut lost = false',
            '    // The power of 10 of the last digit kept.',
            '    mut scale = 0',
            '    mut whole = 0',
            '',
            '    while (at < end and isDigit(byteAt(bytes, at, end))) {',
            '        keepDigit(byteAt(bytes, at, end) - 48, mut digits, mut count, mut lost, mut scale, false)',
            '        whole += 1',
            '        at += 1',
            '    }',
            '',
            '    mut fraction = 0',
            '',
            '    if (byteAt(bytes, at, end) == 46) {',
            '        at += 1',
            '',
            '        while (at < end and isDigit(byteAt(bytes, at, end))) {',
            '            keepDigit(byteAt(bytes, at, end) - 48, mut digits, mut count, mut lost, mut scale, true)',
            '            fraction += 1',
            '            at += 1',
            '        }',
            '    }',
            '',
            '    if (whole == 0 and fraction == 0) { return 1 }',
            '',
            '    mut power = 0',
            '',
            '    if (byteAt(bytes, at, end) == 101 or byteAt(bytes, at, end) == 69) {',
            '        at += 1',
            '        mut negativePower = false',
            '',
            '        if (at < end and isSign(byteAt(bytes, at, end))) {',
            '            negativePower = byteAt(bytes, at, end) == 45',
            '            at += 1',
            '        }',
            '',
            '        if (not (at < end and isDigit(byteAt(bytes, at, end)))) { return 1 }',
            '',
            '        while (at < end and isDigit(byteAt(bytes, at, end))) {',
            '            if (power < 100000) { power = power * 10 + byteAt(bytes, at, end) - 48 }',
            '',
            '            at += 1',
            '        }',
            '',
            '        if (negativePower) { power = -power }',
            '    }',
            '',
            '    if (at != end) { return 1 }',
            '',
            '    immut exponent = power + scale',
            '',
            '    if (not lost and digits <= 9007199254740992 and exponent >= -22 and exponent <= 22) {',
            '        immut mantissa = float(digits)',
            '        immut tens = tenTo(if (exponent < 0) { -exponent } else { exponent })',
            '        immut exact = if (exponent < 0) { mantissa / tens } else { mantissa * tens }',
            '        value = if (negative) { -exact } else { exact }',
            '        return 0',
            '    }',
            '',
            '    // `strtod` reads a string of C: a copy, with a 0 at its end.',
            '    immut copy = allocate(end - start + 1)',
            '    memcpy(copy, offset(bytes, start), end - start)',
            '    immut zero: byte = 0',
            '    write(copy, end - start, zero)',
            '    value = strtod(copy, nullAddress())',
            '    free(copy)',
            '    immut largest = float(1.7976931348623157e308)',
            '',
            '    if (value > largest or value < -largest) { return 2 }',
            '',
            '    return 0',
            '}',
            '',
            '// One more digit of a decimal number: kept while there are at most 18 significant ones (and their',
            '// power of 10 follows), or else `lost` when it is not 0.',
            'function keepDigit(digit: int, mut digits: int, mut count: int, mut lost: boolean, mut scale: int, inFraction: boolean) {',
            '    if (count < 18) {',
            '        digits = digits * 10 + digit',
            '',
            '        if (digits != 0) { count += 1 }',
            '',
            '        if (inFraction) { scale -= 1 }',
            '',
            '        return',
            '    }',
            '',
            '    if (digit != 0) { lost = true }',
            '',
            '    if (not inFraction) { scale += 1 }',
            '}',
            '',
            'function isDigit(b: int): boolean {',
            '    return b >= 48 and b <= 57',
            '}',
            '',
            '// 10^n, exactly, for n up to 22.',
            'function tenTo(n: int): float {',
            '    mut result = float(1)',
            '',
            '    for i in range(n) {',
            '        result = result * float(10)',
            '    }',
            '',
            '    return result',
            '}',
            '',
            'function isSign(b: int): boolean {',
            '    return b == 43 or b == 45',
            '}',
            '',
            '// A float written in hexadecimal (`0x1.8p1`, `-0xff`, `0x1p-1074`), rounded to the nearest float',
            '// (half to even) when it has more digits than a float holds. `code` is 1 for a text that is not',
            '// one, 2 for one too large.',
            'function hexFloat(text: string, mut code: int): float {',
            '    immut chars = text.chars()',
            '    mut at = 0',
            '    mut negative = false',
            '',
            '    if (at < chars.length() and chars[at] == \'-\') {',
            '        negative = true',
            '        at += 1',
            '    } else {',
            '        if (at < chars.length() and chars[at] == \'+\') { at += 1 }',
            '    }',
            '',
            '    if (at + 1 >= chars.length() or chars[at] != \'0\' or (chars[at + 1] != \'x\' and chars[at + 1] != \'X\')) {',
            '        code = 1',
            '        return float(0)',
            '    }',
            '',
            '    at += 2',
            '    // The power of 2, after `p`.',
            '    mut end = chars.length()',
            '    mut power = 0',
            '',
            '    for i in range(at, chars.length()) {',
            '        if (end == chars.length() and (chars[i] == \'p\' or chars[i] == \'P\')) { end = i }',
            '    }',
            '',
            '    if (end < chars.length()) {',
            '        match (intOf(text[end + 1..])) {',
            '            Ok(value) => power = if (value < -100000) { -100000 } else { if (value > 100000) { 100000 } else { value } }',
            '            Err(_) => {',
            '                code = 1',
            '                return float(0)',
            '            }',
            '        }',
            '',
            '        // `intOf` takes white space and a `+`, which Rust\'s reading of an int takes too, but not',
            '        // white space.',
            '        if (trim(text[end + 1..]) != text[end + 1..]) {',
            '            code = 1',
            '            return float(0)',
            '        }',
            '    }',
            '',
            '    mut point = end',
            '',
            '    for i in range(at, end) {',
            '        if (point == end and chars[i] == \'.\') { point = i }',
            '    }',
            '',
            '    if (point == at and (point == end or point + 1 == end)) {',
            '        code = 1',
            '        return float(0)',
            '    }',
            '',
            '    // value = mantissa * 2^exponent (+ a nonzero part below the last bit of the mantissa when',
            '    // sticky); the first 30 significant hexadecimal digits are kept exactly.',
            '    mut mantissa: U128 = 0',
            '    mut kept = 0',
            '    mut sticky = false',
            '    mut exponent = power',
            '',
            '    for i in range(at, end) {',
            '        if (i == point) { continue }',
            '',
            '        immut digit = hexValue(chars[i])',
            '',
            '        if (digit < 0) {',
            '            code = 1',
            '            return float(0)',
            '        }',
            '',
            '        immut inFraction = i > point',
            '',
            '        if (kept < 30) {',
            '            if (mantissa != 0 or digit != 0) { kept += 1 }',
            '',
            '            mantissa = (mantissa << 4) | wide(digit, 0)',
            '',
            '            if (inFraction) { exponent -= 4 }',
            '        } else {',
            '            if (digit != 0) { sticky = true }',
            '',
            '            if (not inFraction) { exponent += 4 }',
            '        }',
            '    }',
            '',
            '    immut sign = if (negative) { float(-1) } else { float(1) }',
            '',
            '    if (mantissa == 0) { return sign * float(0) }',
            '',
            '    // The exponent of the leading bit, and the bits a float keeps: 53, fewer when subnormal.',
            '    immut bits = 128 - leadingZeros(mantissa)',
            '    immut leading = exponent + bits - 1',
            '',
            '    if (leading > 1023) {',
            '        code = 2',
            '        return float(0)',
            '    }',
            '',
            '    immut precision = if (leading < -1022) { 53 - (-1022 - leading) } else { 53 }',
            '    immut shift = bits - precision',
            '    mut keptBits = mantissa',
            '    mut scale = exponent',
            '',
            '    if (shift > 0) {',
            '        immut dropped = if (shift >= 128) { mantissa } else { mantissa & ((wide(1, 0) << wide(shift, 0)) - 1) }',
            '        immut half = if (shift > 128) { wide(0, 0) } else { wide(1, 0) << wide(shift - 1, 0) }',
            '        keptBits = if (shift >= 128) { wide(0, 0) } else { mantissa >> wide(shift, 0) }',
            '        immut up = dropped > half or (dropped == half and (sticky or (keptBits & 1) == 1))',
            '',
            '        if (up) { keptBits = keptBits + 1 }',
            '',
            '        scale += shift',
            '    }',
            '',
            '    // Rounded up to 2^1024: too large.',
            '    if (keptBits != 0 and 128 - leadingZeros(keptBits) + scale > 1024) {',
            '        code = 2',
            '        return float(0)',
            '    }',
            '',
            '    // keptBits * 2^scale is a float: exact in two halves.',
            '    return sign * wideToFloat(keptBits) * powerOfTwo(scale / 2) * powerOfTwo(scale - scale / 2)',
            '}',
            '',
            'function hexValue(c: char): int {',
            '    immut code = c.code()',
            '',
            '    if (code >= 48 and code <= 57) { return code - 48 }',
            '',
            '    if (code >= 97 and code <= 102) { return code - 87 }',
            '',
            '    if (code >= 65 and code <= 70) { return code - 55 }',
            '',
            '    return -1',
            '}',
            '',
            '// 2^n by squaring, as the `powi` of C compilers.',
            'function powerOfTwo(n: int): float {',
            '    mut result = float(1)',
            '    mut base = float(2)',
            '    mut left = if (n < 0) { -n } else { n }',
            '',
            '    while (left > 0) {',
            '        if ((left & 1) == 1) { result = result * base }',
            '',
            '        left = left / 2',
            '',
            '        if (left > 0) { base = base * base }',
            '    }',
            '',
            '    return if (n < 0) { float(1) / result } else { result }',
            '}',
            '',
            '// `input()` and `input(prompt)`: a line of the standard input without its line break, or `None`',
            '// at its end.',
            'function readLine(here: Location): Option[string] {',
            '    return readLineAfter(\'\', here)',
            '}',
            '',
            'function readLineAfter(prompt: string, here: Location): Option[string] {',
            '    immut status = allocate(8)',
            '    write(status, 0, 0)',
            '    immut line = koji_read_line(prompt, here, status)',
            '    immut ended: int = read(status, 0)',
            '    free(status)',
            '',
            '    if (ended == 1) { return None }',
            '',
            '    return Some(line)',
            '}',
            '',
            'function decimalOf(text: string): Result[decimal, ParseError] {',
            '    immut status = allocate(8)',
            '    immut value = koji_decimal_parse(text, status)',
            '    immut code: int = read(status, 0)',
            '    free(status)',
            '',
            '    if (code == 1) { return Err(InvalidNumber(text)) }',
            '',
            '    if (code == 2) { return Err(OutOfRange(text)) }',
            '',
            '    return Ok(value)',
            '}',
        ].join('\n'))
    }

    if (name == 'koji:decimal') {
        return Some([
            '// `koji:decimal`: the decimals of the runtime, in the library of the runtime written in Koji (C',
            '// calls these functions by their names).',
            '//',
            '// A value is `coefficient * 10^exponent`, with a coefficient below 10^34 and an exponent from',
            '// -6176 to 6111, in two words of 64 bits: the low one holds the low 64 bits of the coefficient; the',
            '// high one its 49 high bits, then 14 bits of exponent (plus 6176), then the sign. Zero is all zero',
            '// bits. Values are not normalized (`1.50` may be kept as 150e-2): operations skip the work of',
            '// removing trailing zeros, and equality, hashing and text look through them. An operation rounds',
            '// its exact result to 34 digits, half to even; a result too large panics (`decimal overflow`), and',
            '// so does one too small to be anything but zero (`decimal underflow`).',
            '//',
            '// Numbers of 256 bits (products, dividends) are two `U128`: `high` and `low`.',
            '',
            'import { Address, CInt, CSize, Location, U128, allocate, decimalHigh, decimalLow, decimalOf, free, highWord, isNull, leadingZeros, listItems, lowWord, nullAddress, offset, panicAt, read, reserve, setListLength, stringBytes, stringSize, wide, wideToFloat, wordProduct, write } from \'koji:unsafe\'',
            'import { cString, trim } from \'koji:core\'',
            'import { inversePowersOfFive, powersOfFive } from \'koji:ryu\'',
            '',
            '// The C library: floats, and `strtod`, which reads a float from text correctly rounded.',
            'extern function sqrt(x: float): float',
            'extern function memcpy(target: Address, source: Address, size: CSize): Address',
            'extern function memset(target: Address, value: CInt, size: CSize): Address',
            'extern function log(x: float): float',
            'extern function log10(x: float): float',
            'extern function floor(x: float): float',
            'extern function strtod(text: Address, end: Address): float',
            '',
            'immut digitCount = 34',
            '// The zeros after the point, before the first digit, from which a fraction is shown in scientific',
            '// notation.',
            'immut placeHolders = 6',
            'immut minExponent = -6176',
            'immut maxExponent = 6111',
            '',
            '// The bits of the sign, and of the coefficient in the high word.',
            'immut signBit = -9223372036854775807 - 1',
            'immut coefficientBits = (1 << 49) - 1',
            '// The exponent 0, in the high word.',
            'immut exponentZero = 6176 << 49',
            '',
            '// 10^0 to 10^38.',
            'immut powers = tenPowers()',
            '// 2^64 - 1: one word.',
            'immut word = wide(-1, 0)',
            'immut largest = wide(-1, -1)',
            '// 10^(38 + i), for the numbers of 256 bits.',
            'immut widePowersHigh = widePowers(true)',
            'immut widePowersLow = widePowers(false)',
            '',
            '// 10^0 to 10^22: the powers of ten that are floats exactly.',
            'immut exactTens = floatTens()',
            '',
            '// Why a result has no decimal.',
            'immut noLimit = 0',
            'immut overflow = 1',
            'immut underflow = 2',
            '',
            '// The parts of a value.',
            '',
            'function isNegative(value: decimal): boolean {',
            '    return decimalHigh(value) < 0',
            '}',
            '',
            'function coefficientOf(value: decimal): U128 {',
            '    return wide(decimalLow(value), decimalHigh(value) & coefficientBits)',
            '}',
            '',
            'function exponentOf(value: decimal): int {',
            '    return ((decimalHigh(value) >> 49) & 0x3FFF) + minExponent',
            '}',
            '',
            'function isZero(value: decimal): boolean {',
            '    return decimalLow(value) == 0 and (decimalHigh(value) & coefficientBits) == 0',
            '}',
            '',
            'function make(negative: boolean, coefficient: U128, exponent: int): decimal {',
            '    immut sign = if (negative) { signBit } else { 0 }',
            '    return decimalOf(lowWord(coefficient), highWord(coefficient) | ((exponent - minExponent) << 49) | sign)',
            '}',
            '',
            'function zero(): decimal {',
            '    return decimalOf(0, 0)',
            '}',
            '',
            '// 10^34, the first number of 35 digits (a constant for the C compiler).',
            'function tenTo34(): U128 {',
            '    return wide(4003012203950112768, 542101086242752)',
            '}',
            '',
            'function u128(n: int): U128 {',
            '    return wide(n, 0)',
            '}',
            '',
            'function tenPowers(): U128[] {',
            '    mut table: U128[] = [1]',
            '',
            '    for i in range(38) {',
            '        table.push(table[i] * 10)',
            '    }',
            '',
            '    return table',
            '}',
            '',
            '// The high or the low halves of 10^38 to 10^77.',
            'function widePowers(high: boolean): U128[] {',
            '    mut table: U128[] = []',
            '    immut tens = tenPowers()',
            '',
            '    for i in range(39) {',
            '        mut top: U128 = 0',
            '        immut bottom = multiplyWide(tens[38], tens[i], mut top)',
            '        table.push(if (high) { top } else { bottom })',
            '    }',
            '',
            '    // 10^77 = 10^76 * 10',
            '    mut top: U128 = 0',
            '    immut bottom = multiplyWide(tens[38], tens[38], mut top)',
            '    immut low = (bottom & wide(-1, 0)) * 10',
            '    immut middle = (bottom >> 64) * 10 + (low >> 64)',
            '    immut lowHalf = (low & wide(-1, 0)) | ((middle & wide(-1, 0)) << 64)',
            '    immut highHalf = top * 10 + (middle >> 64)',
            '    table.push(if (high) { highHalf } else { lowHalf })',
            '    return table',
            '}',
            '',
            'function maxOf(a: int, b: int): int {',
            '    return if (a > b) { a } else { b }',
            '}',
            '',
            'function minOf(a: int, b: int): int {',
            '    return if (a < b) { a } else { b }',
            '}',
            '',
            '// The number of decimal digits, without dividing: from the number of bits and a table.',
            'function digits(n: U128): int {',
            '    if (n == 0) { return 1 }',
            '',
            '    return nonzeroDigits(n)',
            '}',
            '',
            '// `digits` of a number that is not zero: small, so the compiler inlines it.',
            'function nonzeroDigits(n: U128): int {',
            '    // floor(bits * log10(2)), then one more when n reaches the next power of ten.',
            '    immut guess = ((128 - leadingZeros(n)) * 1233) >> 12',
            '    return if (n >= powers[guess]) { guess + 1 } else { guess }',
            '}',
            '',
            '// Rounding',
            '',
            '// `coefficient * 10^exponent` (plus less than one unit of its last digit when `sticky`) rounded to',
            '// 34 digits, half to even; the coefficient may have up to 39 digits. `limit` tells why there is',
            '// no result.',
            'function round(negative: boolean, coefficient: U128, exponent: int, sticky: boolean, mut limit: int): decimal {',
            '    // Most results: exact, with 34 digits or less, in range.',
            '    if (not sticky and coefficient < tenTo34() and exponent >= minExponent and exponent <= maxExponent) {',
            '        return make(negative and coefficient != 0, coefficient, exponent)',
            '    }',
            '',
            '    return roundSlowly(negative, coefficient, exponent, sticky, mut limit)',
            '}',
            '',
            'function roundSlowly(negative: boolean, coefficient: U128, exponent: int, sticky: boolean, mut limit: int): decimal {',
            '    if (coefficient == 0 and not sticky) { return make(false, 0, maxOf(minExponent, minOf(exponent, maxExponent))) }',
            '',
            '    immut drop = maxOf(maxOf(digits(coefficient) - digitCount, minExponent - exponent), 0)',
            '    mut kept = coefficient',
            '    mut at = exponent',
            '',
            '    if (drop > 0) {',
            '        mut quotient: U128 = 0',
            '        mut up = false',
            '',
            '        // Beyond 38 digits, the rest is below half a unit.',
            '        if (drop < 39) {',
            '            immut unit = powers[drop]',
            '            quotient = coefficient / unit',
            '            immut rest = coefficient - quotient * unit',
            '            immut half = unit >> 1',
            '            up = rest > half or (rest == half and (sticky or (quotient & 1) == 1))',
            '        }',
            '',
            '        kept = if (up) { quotient + 1 } else { quotient }',
            '        at += drop',
            '',
            '        if (kept == tenTo34()) {',
            '            kept = kept / 10',
            '            at += 1',
            '        }',
            '',
            '        if (kept == 0) {',
            '            limit = underflow',
            '            return zero()',
            '        }',
            '    }',
            '',
            '    if (at > maxExponent) {',
            '        // A value with fewer digits can take zeros instead of a larger exponent.',
            '        immut pad = at - maxExponent',
            '',
            '        if (digits(kept) + pad > digitCount) {',
            '            limit = overflow',
            '            return zero()',
            '        }',
            '',
            '        kept = kept * powers[pad]',
            '        at = maxExponent',
            '    }',
            '',
            '    return make(negative, kept, at)',
            '}',
            '',
            '// Whether an exact result needs no rounding: 34 digits or less, in range (most results). Small:',
            '// the compiler inlines it, and the callers make the value at once.',
            'function exact(coefficient: U128, exponent: int): boolean {',
            '    return coefficient < tenTo34() and u128(exponent - minExponent) <= 12287',
            '}',
            '',
            '// `round`, with a panic at `here` when there is no result.',
            'function finish(negative: boolean, coefficient: U128, exponent: int, sticky: boolean, here: Location): decimal {',
            '    mut limit = noLimit',
            '    immut value = round(negative, coefficient, exponent, sticky, mut limit)',
            '    checkLimit(limit, here)',
            '    return value',
            '}',
            '',
            'function checkLimit(limit: int, here: Location) {',
            '    if (limit == overflow) { panicAt(here, \'decimal overflow\') }',
            '',
            '    if (limit == underflow) { panicAt(here, \'decimal underflow\') }',
            '}',
            '',
            '// Numbers of 256 bits',
            '',
            '// `a * b`: its low half, and its high half in `high`.',
            'function multiplyWide(a: U128, b: U128, mut high: U128): U128 {',
            '    immut a0 = a & word',
            '    immut a1 = a >> 64',
            '    immut b0 = b & word',
            '    immut b1 = b >> 64',
            '    immut low = wordProduct(a0, b0)',
            '    immut middle1 = wordProduct(a0, b1)',
            '    immut middle2 = wordProduct(a1, b0)',
            '    immut top = wordProduct(a1, b1)',
            '    immut middle = middle1 + middle2',
            '    immut carry: U128 = if (middle < middle1) { 1 } else { 0 }',
            '    immut sum = low + (middle << 64)',
            '    immut carryLow: U128 = if (sum < low) { 1 } else { 0 }',
            '    high = top + (middle >> 64) + (carry << 64) + carryLow',
            '    return sum',
            '}',
            '',
            '// Whether `a` is below `b` (high halves first).',
            'function wideBelow(aHigh: U128, aLow: U128, bHigh: U128, bLow: U128): boolean {',
            '    if (aHigh != bHigh) { return aHigh < bHigh }',
            '',
            '    return aLow < bLow',
            '}',
            '',
            '// The number of digits of a number of 256 bits, from its number of bits and one comparison.',
            'function wideDigits(high: U128, low: U128): int {',
            '    if (high == 0) { return digits(low) }',
            '',
            '    immut bits = 256 - leadingZeros(high)',
            '    immut guess = (bits * 1233) >> 12',
            '    // 10^guess: guess is from 38 (above 2^128) to 77.',
            '    immut below = wideBelow(high, low, widePowersHigh[guess - 38], widePowersLow[guess - 38])',
            '    return if (below) { guess } else { guess + 1 }',
            '}',
            '',
            '// `n / d` (in `quotientHigh` and `quotientLow`), and `n % d` as the result: Knuth\'s algorithm D',
            '// with digits of 64 bits (the divisor has one or two), so each step of the quotient is one',
            '// division of 128 bits by 64.',
            'function divideWide(high: U128, low: U128, d: U128, mut quotientHigh: U128, mut quotientLow: U128): U128 {',
            '    if ((d >> 64) == 0) {',
            '        // A divisor of one digit: short division, a digit at a time.',
            '        immut n3 = high >> 64',
            '        immut q3 = n3 / d',
            '        mut current = ((n3 - q3 * d) << 64) | (high & word)',
            '        immut q2 = current / d',
            '        current = ((current - q2 * d) << 64) | (low >> 64)',
            '        immut q1 = current / d',
            '        current = ((current - q1 * d) << 64) | (low & word)',
            '        immut q0 = current / d',
            '        quotientHigh = (q3 << 64) | q2',
            '        quotientLow = (q1 << 64) | q0',
            '        return current - q0 * d',
            '    }',
            '',
            '    return divideLong(high, low, d, mut quotientHigh, mut quotientLow)',
            '}',
            '',
            '// `divideWide` for a divisor of two digits (Knuth\'s algorithm D). The dividend is normalized on',
            '// five digits, and each of the three steps gives a digit of the quotient: a dividend with fewer',
            '// digits gives zeros first.',
            'function divideLong(high: U128, low: U128, d: U128, mut quotientHigh: U128, mut quotientLow: U128): U128 {',
            '    if (high == 0 and low < d) {',
            '        quotientHigh = 0',
            '        quotientLow = 0',
            '        return low',
            '    }',
            '',
            '    immut n0 = low & word',
            '    immut n1 = low >> 64',
            '    immut n2 = high & word',
            '    immut n3 = high >> 64',
            '    immut d0 = d & word',
            '    immut d1 = d >> 64',
            '    immut shift = u128(leadingZeros(d1) - 64)',
            '    immut v0 = (d0 << shift) & word',
            '    immut v1 = shiftedLeft(d1, d0, shift)',
            '    mut u4: U128 = if (shift == 0) { 0 } else { n3 >> (64 - shift) }',
            '    mut u3 = shiftedLeft(n3, n2, shift)',
            '    mut u2 = shiftedLeft(n2, n1, shift)',
            '    mut u1 = shiftedLeft(n1, n0, shift)',
            '    mut u0 = (n0 << shift) & word',
            '    immut q2 = knuthStep(mut u4, mut u3, mut u2, v1, v0)',
            '    immut q1 = knuthStep(mut u3, mut u2, mut u1, v1, v0)',
            '    immut q0 = knuthStep(mut u2, mut u1, mut u0, v1, v0)',
            '    quotientHigh = q2',
            '    quotientLow = q0 | (q1 << 64)',
            '',
            '    if (shift == 0) { return u0 | (u1 << 64) }',
            '',
            '    immut restLow = ((u0 >> shift) | (u1 << (64 - shift))) & word',
            '    immut restHigh = ((u1 >> shift) | (u2 << (64 - shift))) & word',
            '    return restLow | (restHigh << 64)',
            '}',
            '',
            '// One step of Knuth\'s algorithm D: the digit of the quotient for the digits `top`, `middle` and',
            '// `bottom` of the dividend, which become those of the remainder.',
            'function knuthStep(mut top: U128, mut middle: U128, mut bottom: U128, v1: U128, v0: U128): U128 {',
            '    immut both = (top << 64) | middle',
            '    mut estimate: U128 = word',
            '    mut remainder: U128 = 0',
            '',
            '    if (top < v1) {',
            '        estimate = both / v1',
            '        remainder = both - wordProduct(estimate, v1)',
            '    } else {',
            '        remainder = both - wordProduct(estimate, v1)',
            '    }',
            '',
            '    // At most two corrections; a remainder of 65 bits means the estimate is right.',
            '    while ((remainder >> 64) == 0 and wordProduct(estimate, v0) > ((remainder << 64) | bottom)) {',
            '        estimate -= 1',
            '        remainder += v1',
            '    }',
            '',
            '    // (top, middle, bottom) -= estimate * (v1, v0)',
            '    immut productLow = wordProduct(estimate, v0)',
            '    immut productHigh = wordProduct(estimate, v1) + (productLow >> 64)',
            '    immut lowDigit = productLow & word',
            '    immut middleDigit = productHigh & word',
            '    immut highDigit = productHigh >> 64',
            '    immut borrowA: U128 = if (bottom < lowDigit) { 1 } else { 0 }',
            '    immut a = (bottom - lowDigit) & word',
            '    immut b1 = (middle - middleDigit) & word',
            '    immut borrowB: U128 = if (middle < middleDigit or b1 < borrowA) { 1 } else { 0 }',
            '    immut b = (b1 - borrowA) & word',
            '    immut c1 = (top - highDigit) & word',
            '    immut borrowC = top < highDigit or c1 < borrowB',
            '    bottom = a',
            '    middle = b',
            '    top = (c1 - borrowB) & word',
            '',
            '    if (not borrowC) { return estimate }',
            '',
            '    // The estimate was one too large: add the divisor back.',
            '    immut sumA = bottom + v0',
            '    immut sumB = middle + v1 + (sumA >> 64)',
            '    bottom = sumA & word',
            '    middle = sumB & word',
            '    top = (top + (sumB >> 64)) & word',
            '    return estimate - 1',
            '}',
            '',
            '// The digit `high` shifted left by `shift` bits, with the bits of `low` that come in.',
            'function shiftedLeft(high: U128, low: U128, shift: U128): U128 {',
            '    if (shift == 0) { return high }',
            '',
            '    return ((high << shift) | (low >> (64 - shift))) & word',
            '}',
            '',
            '// `round` for a coefficient of up to 77 digits: cut to 38 digits (the rest as `sticky`), which',
            '// `round` rounds.',
            'function roundWide(negative: boolean, high: U128, low: U128, exponent: int, sticky: boolean, mut limit: int): decimal {',
            '    if (high == 0) { return round(negative, low, exponent, sticky, mut limit) }',
            '',
            '    // Usually: one division keeps 34 digits, and its remainder rounds them.',
            '    immut drop = wideDigits(high, low) - digitCount',
            '',
            '    if (drop <= 38 and exponent + drop >= minExponent and exponent + drop <= maxExponent) {',
            '        immut unit = powers[drop]',
            '        mut quotientHigh: U128 = 0',
            '        mut quotientLow: U128 = 0',
            '        immut rest = divideWide(high, low, unit, mut quotientHigh, mut quotientLow)',
            '        immut quotient = if (quotientHigh == 0) { quotientLow } else { largest }',
            '        immut half = unit >> 1',
            '        immut up = rest > half or (rest == half and (sticky or (quotient & 1) == 1))',
            '        immut kept = if (up) { quotient + 1 } else { quotient }',
            '',
            '        if (kept < tenTo34()) { return make(negative, kept, exponent + drop) }',
            '',
            '        return round(negative, kept / 10, exponent + drop + 1, false, mut limit)',
            '    }',
            '',
            '    mut cutHigh = high',
            '    mut cutLow = low',
            '    mut at = exponent',
            '    mut cutSticky = sticky',
            '    cut(mut cutHigh, mut cutLow, mut at, mut cutSticky)',
            '    return round(negative, cutLow, at, cutSticky, mut limit)',
            '}',
            '',
            'function finishWide(negative: boolean, high: U128, low: U128, exponent: int, sticky: boolean, here: Location): decimal {',
            '    mut limit = noLimit',
            '    immut value = roundWide(negative, high, low, exponent, sticky, mut limit)',
            '    checkLimit(limit, here)',
            '    return value',
            '}',
            '',
            '// The number with 38 digits at most (in `low`), and whether a nonzero part was cut.',
            'function cut(mut high: U128, mut low: U128, mut exponent: int, mut sticky: boolean) {',
            '    if (high == 0) { return }',
            '',
            '    mut drop = wideDigits(high, low) - 38',
            '',
            '    while (drop > 0) {',
            '        immut step = minOf(drop, 38)',
            '        mut quotientHigh: U128 = 0',
            '        mut quotientLow: U128 = 0',
            '        immut rest = divideWide(high, low, powers[step], mut quotientHigh, mut quotientLow)',
            '        high = quotientHigh',
            '        low = quotientLow',
            '',
            '        if (rest != 0) { sticky = true }',
            '',
            '        exponent += step',
            '        drop -= step',
            '    }',
            '',
            '    if (high != 0) {',
            '        high = 0',
            '        low = largest',
            '    }',
            '}',
            '',
            '// `coefficient * 10^scale` (scale up to 76): its low half, and its high half in `high`.',
            'function scaled(coefficient: U128, scale: int, mut high: U128): U128 {',
            '    if (scale <= 38) { return multiplyWide(coefficient, powers[scale], mut high) }',
            '',
            '    mut firstHigh: U128 = 0',
            '    immut firstLow = multiplyWide(coefficient, powers[38], mut firstHigh)',
            '    // The first product is below 10^72: times 10^(scale - 38) still fits.',
            '    immut power = powers[scale - 38]',
            '',
            '    if (firstHigh == 0) { return multiplyWide(firstLow, power, mut high) }',
            '',
            '    mut aHigh: U128 = 0',
            '    immut aLow = multiplyWide(firstLow, power, mut aHigh)',
            '    mut bHigh: U128 = 0',
            '    immut bLow = multiplyWide(firstHigh, power, mut bHigh)',
            '    // a + b * 2^128',
            '    high = aHigh + bLow',
            '    return aLow',
            '}',
            '',
            '// The nearest float of a number of 256 bits.',
            'function hugeToFloat(high: U128, low: U128): float {',
            '    mut total = wordToFloat(high >> 64)',
            '    total = total * float(18446744073709551616.0) + wordToFloat(high & word)',
            '    total = total * float(18446744073709551616.0) + wordToFloat(low >> 64)',
            '    return total * float(18446744073709551616.0) + wordToFloat(low & word)',
            '}',
            '',
            '// A word, rounded once: its two halves of 32 bits are exact.',
            'function wordToFloat(value: U128): float {',
            '    immut top = lowWord(value >> 32)',
            '    immut bottom = lowWord(value & wide(0xFFFFFFFF, 0))',
            '    return float(top) * float(4294967296) + float(bottom)',
            '}',
            '',
            '// The operations',
            '',
            'extern function koji_decimal_neg(value: decimal): decimal {',
            '    // Zero has no sign.',
            '    if (isZero(value)) { return value }',
            '',
            '    return decimalOf(decimalLow(value), decimalHigh(value) ^ signBit)',
            '}',
            '',
            'extern function koji_decimal_abs(value: decimal): decimal {',
            '    return decimalOf(decimalLow(value), decimalHigh(value) & ~signBit)',
            '}',
            '',
            'extern function koji_decimal_from_int(value: int): decimal {',
            '    if (value >= 0) { return decimalOf(value, exponentZero) }',
            '',
            '    // The magnitude of a negative int, `int.min` too, in 64 bits.',
            '    immut nothing: U128 = 0',
            '    immut magnitude = nothing - wide(value, -1)',
            '    return decimalOf(lowWord(magnitude), exponentZero | signBit)',
            '}',
            '',
            'extern function koji_decimal_add(a: decimal, b: decimal, here: Location): decimal {',
            '    mut limit = noLimit',
            '    immut value = add(a, b, mut limit)',
            '    checkLimit(limit, here)',
            '    return value',
            '}',
            '',
            'extern function koji_decimal_sub(a: decimal, b: decimal, here: Location): decimal {',
            '    mut limit = noLimit',
            '    immut value = add(a, koji_decimal_neg(b), mut limit)',
            '    checkLimit(limit, here)',
            '    return value',
            '}',
            '',
            'function add(a: decimal, b: decimal, mut limit: int): decimal {',
            '    immut ea = exponentOf(a)',
            '    immut eb = exponentOf(b)',
            '    immut na = isNegative(a)',
            '    immut nb = isNegative(b)',
            '    immut ca = coefficientOf(a)',
            '    immut cb = coefficientOf(b)',
            '',
            '    if (ea == eb) {',
            '        // The same exponent (amounts of money, measures): one addition, no alignment.',
            '        if (na == nb) {',
            '            immut sum = ca + cb',
            '',
            '            if (exact(sum, ea)) { return make(na, sum, ea) }',
            '',
            '            return round(na, sum, ea, false, mut limit)',
            '        }',
            '',
            '        if (ca >= cb) { return round(na, ca - cb, ea, false, mut limit) }',
            '',
            '        return round(nb, cb - ca, ea, false, mut limit)',
            '    }',
            '',
            '    if (ca == 0) { return b }',
            '',
            '    if (cb == 0) { return a }',
            '',
            '    // `x` has the larger exponent.',
            '    immut first = ea > eb',
            '    immut nx = if (first) { na } else { nb }',
            '    immut ny = if (first) { nb } else { na }',
            '    immut cx = if (first) { ca } else { cb }',
            '    immut cy = if (first) { cb } else { ca }',
            '    immut ex = if (first) { ea } else { eb }',
            '    immut ey = if (first) { eb } else { ea }',
            '    immut distance = ex - ey',
            '    mut big: U128 = 0',
            '    mut small: U128 = 0',
            '    mut exponent = 0',
            '    mut sticky = false',
            '',
            '    if (distance <= 38 and cx < powers[38 - distance]) {',
            '        // Exact: `x` shifted still fits in 128 bits.',
            '        big = cx * powers[distance]',
            '        small = cy',
            '        exponent = ey',
            '    } else {',
            '        // `y` is far below: `x` with 38 digits, and `y` cut, the rest of it as `sticky`.',
            '        immut shiftX = 38 - nonzeroDigits(cx)',
            '        immut shiftY = distance - shiftX',
            '',
            '        if (shiftY >= 39) {',
            '            sticky = cy != 0',
            '        } else {',
            '            immut unit = powers[shiftY]',
            '            small = cy / unit',
            '            sticky = cy % unit != 0',
            '        }',
            '',
            '        big = cx * powers[shiftX]',
            '        exponent = ex - shiftX',
            '    }',
            '',
            '    // The coefficient of the result, then its sign.',
            '    mut result: U128 = 0',
            '    mut negative = nx',
            '',
            '    if (nx == ny) {',
            '        result = big + small',
            '    } else {',
            '        if (big >= small) {',
            '            immut cutOff: U128 = if (sticky) { 1 } else { 0 }',
            '            result = big - small - cutOff',
            '        } else {',
            '            result = small - big',
            '            negative = ny',
            '            sticky = false',
            '        }',
            '    }',
            '',
            '    if (not sticky and exact(result, exponent)) { return make(negative and result != 0, result, exponent) }',
            '',
            '    return round(negative, result, exponent, sticky, mut limit)',
            '}',
            '',
            'extern function koji_decimal_mul(a: decimal, b: decimal, here: Location): decimal {',
            '    immut negative = isNegative(a) != isNegative(b)',
            '    immut exponent = exponentOf(a) + exponentOf(b)',
            '    immut ca = coefficientOf(a)',
            '    immut cb = coefficientOf(b)',
            '',
            '    if (ca == 0 or cb == 0) { return zero() }',
            '',
            '    // Both below 2^64: the product fits in 128 bits.',
            '    if ((ca >> 64) == 0 and (cb >> 64) == 0) {',
            '        immut product = wordProduct(ca, cb)',
            '',
            '        if (exact(product, exponent)) { return make(negative, product, exponent) }',
            '',
            '        return finish(negative, product, exponent, false, here)',
            '    }',
            '',
            '    mut high: U128 = 0',
            '    immut low = multiplyWide(ca, cb, mut high)',
            '    return finishWide(negative, high, low, exponent, false, here)',
            '}',
            '',
            'extern function koji_decimal_div(a: decimal, b: decimal, here: Location): decimal {',
            '    immut cb = coefficientOf(b)',
            '',
            '    if (cb == 0) { panicAt(here, \'division by zero\') }',
            '',
            '    immut ca = coefficientOf(a)',
            '',
            '    if (ca == 0) { return zero() }',
            '',
            '    immut negative = isNegative(a) != isNegative(b)',
            '    // Scaled so that the quotient has at least 35 digits (one to round with).',
            '    immut scale = maxOf(35 + digits(cb) - digits(ca), 0)',
            '    immut exponent = exponentOf(a) - exponentOf(b) - scale',
            '',
            '    if (digits(ca) + scale <= 38) {',
            '        // A small divisor: one division of 128 bits.',
            '        immut dividend = ca * powers[scale]',
            '        immut quotient = dividend / cb',
            '        immut sticky = dividend - quotient * cb != 0',
            '',
            '        if (not sticky and exact(quotient, exponent)) { return make(negative, quotient, exponent) }',
            '',
            '        return finish(negative, quotient, exponent, sticky, here)',
            '    }',
            '',
            '    mut high: U128 = 0',
            '    immut low = scaled(ca, scale, mut high)',
            '    mut quotientHigh: U128 = 0',
            '    mut quotientLow: U128 = 0',
            '    immut rest = divideWide(high, low, cb, mut quotientHigh, mut quotientLow)',
            '    return finishWide(negative, quotientHigh, quotientLow, exponent, rest != 0, here)',
            '}',
            '',
            '// The remainder of the division truncated toward zero, with the sign of `a`; exact.',
            'extern function koji_decimal_rem(a: decimal, b: decimal, here: Location): decimal {',
            '    immut cb = coefficientOf(b)',
            '',
            '    if (cb == 0) { panicAt(here, \'division by zero\') }',
            '',
            '    immut ca = coefficientOf(a)',
            '',
            '    if (ca == 0) { return zero() }',
            '',
            '    immut ea = exponentOf(a)',
            '    immut eb = exponentOf(b)',
            '    mut rest: U128 = 0',
            '    mut exponent = 0',
            '',
            '    if (ea >= eb) {',
            '        // (a * 10^d) mod b, with products of 256 bits.',
            '        mut power = u128(1) % cb',
            '        mut base = u128(10) % cb',
            '        mut d = ea - eb',
            '',
            '        while (d > 0) {',
            '            if ((d & 1) == 1) { power = multiplyModulo(power, base, cb) }',
            '',
            '            base = multiplyModulo(base, base, cb)',
            '            d = d >> 1',
            '        }',
            '',
            '        rest = multiplyModulo(ca % cb, power, cb)',
            '        exponent = eb',
            '    } else {',
            '        immut d = eb - ea',
            '        // b * 10^d is above a (below 10^34) once it has 35 digits.',
            '        rest = if (d + digits(cb) > 34) { ca } else { ca % (cb * powers[d]) }',
            '        exponent = ea',
            '    }',
            '',
            '    mut limit = noLimit',
            '    immut value = round(isNegative(a), rest, exponent, false, mut limit)',
            '    return if (limit == noLimit) { value } else { zero() }',
            '}',
            '',
            'function multiplyModulo(x: U128, y: U128, modulus: U128): U128 {',
            '    mut high: U128 = 0',
            '    immut low = multiplyWide(x, y, mut high)',
            '    mut quotientHigh: U128 = 0',
            '    mut quotientLow: U128 = 0',
            '    return divideWide(high, low, modulus, mut quotientHigh, mut quotientLow)',
            '}',
            '',
            '// `base ** exponent` for an int exponent: exact, rounded once.',
            'extern function koji_decimal_pow(base: decimal, exponent: int, here: Location): decimal {',
            '    if (exponent == 0) { return koji_decimal_from_int(1) }',
            '',
            '    immut coefficient = coefficientOf(base)',
            '',
            '    if (coefficient == 0) {',
            '        if (exponent < 0) { panicAt(here, \'division by zero\') }',
            '',
            '        return zero()',
            '    }',
            '',
            '    immut negative = isNegative(base) and exponent % 2 != 0',
            '    // Squaring with 38 digits (four more than the result keeps), then one rounding.',
            '    mut result: U128 = 1',
            '    mut resultExponent = 0',
            '    mut resultSticky = false',
            '    mut square = coefficient',
            '    mut squareExponent = exponentOf(base)',
            '    mut squareSticky = false',
            '    // |exponent|, `int.min` too.',
            '    immut nothing: U128 = 0',
            '    mut n = if (exponent > 0) { u128(exponent) } else { nothing - wide(exponent, -1) }',
            '',
            '    while (n > 0) {',
            '        if ((n & 1) == 1) { multiplyKept(mut result, mut resultExponent, mut resultSticky, square, squareExponent, squareSticky) }',
            '',
            '        n = n >> 1',
            '',
            '        if (n > 0) {',
            '            immut factor = square',
            '            immut factorExponent = squareExponent',
            '            immut factorSticky = squareSticky',
            '            multiplyKept(mut square, mut squareExponent, mut squareSticky, factor, factorExponent, factorSticky)',
            '        }',
            '',
            '        immut resultAt = digits(result) + resultExponent',
            '        immut squareAt = digits(square) + squareExponent',
            '',
            '        if (maxOf(resultAt, squareAt) > 2 * (maxExponent + 40)) { panicAt(here, if (exponent > 0) { \'decimal overflow\' } else { \'decimal underflow\' }) }',
            '',
            '        if (minOf(resultAt, squareAt) < 2 * minExponent) { panicAt(here, if (exponent > 0) { \'decimal underflow\' } else { \'decimal overflow\' }) }',
            '    }',
            '',
            '    if (resultSticky) {',
            '        // Not exact in 38 digits: the rounding of each step would add up; e^(n ln x) with 64',
            '        // digits instead.',
            '        immut magnitude = realPower(koji_decimal_abs(base), koji_decimal_from_int(exponent), here)',
            '        return if (negative) { koji_decimal_neg(magnitude) } else { magnitude }',
            '    }',
            '',
            '    if (exponent > 0) { return finish(negative, result, resultExponent, false, here) }',
            '',
            '    // 1 / (coefficient * 10^exponent), the divisor with up to 38 digits.',
            '    immut scale = 35 + digits(result)',
            '    mut high: U128 = 0',
            '    immut low = scaled(1, scale, mut high)',
            '    mut quotientHigh: U128 = 0',
            '    mut quotientLow: U128 = 0',
            '    immut rest = divideWide(high, low, result, mut quotientHigh, mut quotientLow)',
            '    return finishWide(negative, quotientHigh, quotientLow, -resultExponent - scale, rest != 0, here)',
            '}',
            '',
            '// A product kept with 38 digits, for `koji_decimal_pow`.',
            'function multiplyKept(mut coefficient: U128, mut exponent: int, mut sticky: boolean, factor: U128, factorExponent: int, factorSticky: boolean) {',
            '    mut high: U128 = 0',
            '    mut low = multiplyWide(coefficient, factor, mut high)',
            '    mut at = exponent + factorExponent',
            '    mut cutSticky = sticky or factorSticky',
            '    cut(mut high, mut low, mut at, mut cutSticky)',
            '    coefficient = low',
            '    exponent = at',
            '    sticky = cutSticky',
            '}',
            '',
            '// `base ** exponent` with a decimal exponent: an int exponent is exact; another is computed with',
            '// 64 digits and rounded to 34.',
            'extern function koji_decimal_power(base: decimal, exponent: decimal, here: Location): decimal {',
            '    mut fits = true',
            '    immut n = toInt(exponent, 3, mut fits)',
            '',
            '    if (fits and koji_decimal_compare(koji_decimal_from_int(n), exponent) == 0) { return koji_decimal_pow(base, n, here) }',
            '',
            '    if (isZero(base)) {',
            '        if (isNegative(exponent)) { panicAt(here, \'division by zero\') }',
            '',
            '        return zero()',
            '    }',
            '',
            '    if (isNegative(base)) { panicAt(here, `${shown(base)} ** ${shown(exponent)} is not a real number (use math.pow to handle it)`) }',
            '',
            '    return realPower(base, exponent, here)',
            '}',
            '',
            '// The square root, correctly rounded, of a number that is not negative (`math.sqrt`).',
            'extern function koji_decimal_sqrt(value: decimal): decimal {',
            '    immut coefficient = coefficientOf(value)',
            '',
            '    if (coefficient == 0) { return zero() }',
            '',
            '    immut exponent = exponentOf(value)',
            '    // The coefficient with 69 or 70 digits and an even exponent: its root has 35 digits.',
            '    mut shift = 70 - digits(coefficient)',
            '',
            '    if ((exponent - shift) % 2 != 0) { shift -= 1 }',
            '',
            '    mut high: U128 = 0',
            '    immut low = scaled(coefficient, shift, mut high)',
            '    // Newton\'s method from just above the root of a float (53 correct bits): it goes down to the',
            '    // floor of the root.',
            '    immut estimate = floatToU128(sqrt(hugeToFloat(high, low)))',
            '    mut root = estimate + (estimate >> 40) + 2',
            '',
            '    while (true) {',
            '        mut quotientHigh: U128 = 0',
            '        mut quotientLow: U128 = 0',
            '        divideWide(high, low, root, mut quotientHigh, mut quotientLow)',
            '        immut quotient = if (quotientHigh == 0) { quotientLow } else { largest }',
            '        // (root + quotient) / 2, without losing the carry.',
            '        immut next = (root >> 1) + (quotient >> 1) + (root & quotient & 1)',
            '',
            '        if (next >= root) { break }',
            '',
            '        root = next',
            '    }',
            '',
            '    mut squareHigh: U128 = 0',
            '    immut squareLow = multiplyWide(root, root, mut squareHigh)',
            '    immut sticky = squareHigh != high or squareLow != low',
            '    mut limit = noLimit',
            '    immut rounded = round(false, root, (exponent - shift) / 2, sticky, mut limit)',
            '    return if (limit == noLimit) { rounded } else { zero() }',
            '}',
            '',
            '// A float below 2^128 that is an integer, as a U128.',
            'function floatToU128(value: float): U128 {',
            '    immut top = int(value / float(18446744073709551616.0))',
            '    immut rest = value - float(top) * float(18446744073709551616.0)',
            '    // The rest is below 2^64: in two halves, below 2^63 each.',
            '    immut upper = int(rest / float(2))',
            '    immut bottom = int(rest - float(upper) * float(2))',
            '    return (u128(top) << 64) + u128(upper) * 2 + u128(bottom)',
            '}',
            '',
            '// -1, 0 or 1.',
            'extern function koji_decimal_compare(a: decimal, b: decimal): CInt {',
            '    immut ca = coefficientOf(a)',
            '    immut cb = coefficientOf(b)',
            '    immut na = isNegative(a)',
            '    immut nb = isNegative(b)',
            '',
            '    if (ca == 0 and cb == 0) { return 0 }',
            '',
            '    if (ca == 0) { return if (nb) { 1 } else { -1 } }',
            '',
            '    if (cb == 0) { return if (na) { -1 } else { 1 } }',
            '',
            '    if (na != nb) { return if (na) { -1 } else { 1 } }',
            '',
            '    immut ea = exponentOf(a)',
            '    immut eb = exponentOf(b)',
            '    mut magnitude = 0',
            '',
            '    if (ea == eb) {',
            '        magnitude = order(ca, cb)',
            '    } else {',
            '        immut da = nonzeroDigits(ca)',
            '        immut db = nonzeroDigits(cb)',
            '        immut pa = da + ea',
            '        immut pb = db + eb',
            '',
            '        if (pa != pb) {',
            '            magnitude = if (pa < pb) { -1 } else { 1 }',
            '        } else {',
            '            // The same position: both coefficients with 34 digits.',
            '            magnitude = order(ca * powers[digitCount - da], cb * powers[digitCount - db])',
            '        }',
            '    }',
            '',
            '    return if (na) { -magnitude } else { magnitude }',
            '}',
            '',
            'function order(a: U128, b: U128): int {',
            '    if (a < b) { return -1 }',
            '',
            '    return if (a > b) { 1 } else { 0 }',
            '}',
            '',
            '// Without trailing zeros: the same value always gives the same parts.',
            'function normalized(value: decimal): decimal {',
            '    mut coefficient = coefficientOf(value)',
            '',
            '    if (coefficient == 0) { return zero() }',
            '',
            '    mut exponent = exponentOf(value)',
            '',
            '    // Without dividing when the last digit is not zero (most values).',
            '    if (coefficient % 10 != 0) { return value }',
            '',
            '    removeZeros(mut coefficient, mut exponent, 16)',
            '    removeZeros(mut coefficient, mut exponent, 8)',
            '    removeZeros(mut coefficient, mut exponent, 4)',
            '    removeZeros(mut coefficient, mut exponent, 2)',
            '    removeZeros(mut coefficient, mut exponent, 1)',
            '    return make(isNegative(value), coefficient, exponent)',
            '}',
            '',
            '// Removes `step` trailing zeros as long as there are.',
            'function removeZeros(mut coefficient: U128, mut exponent: int, step: int) {',
            '    immut unit = powers[step]',
            '',
            '    while (true) {',
            '        immut quotient = coefficient / unit',
            '',
            '        if (quotient * unit != coefficient) { return }',
            '',
            '        coefficient = quotient',
            '        exponent += step',
            '    }',
            '}',
            '',
            '// A hash that agrees with equality (`1.5` and `1.50` are equal).',
            'extern function koji_decimal_hash(value: decimal): int {',
            '    immut d = normalized(value)',
            '    immut exponent = exponentOf(d)',
            '    immut sign: U128 = if (isNegative(d)) { u128(1) << 127 } else { 0 }',
            '    immut mixed = coefficientOf(d) ^ (wide(exponent, if (exponent < 0) { -1 } else { 0 }) << 113) ^ sign',
            '    immut top = mixed >> 64',
            '    immut rotated = ((top << 29) | (top >> 35)) & word',
            '    return lowWord(mixed & word) ^ lowWord(rotated)',
            '}',
            '',
            '// `int(d)` (mode 3, toward zero), `math.floor` (0), `math.ceil` (1) and `math.round` (2: half away',
            '// from zero).',
            'extern function koji_decimal_to_int(value: decimal, mode: CInt, here: Location): int {',
            '    mut fits = true',
            '    immut n = toInt(value, mode, mut fits)',
            '',
            '    if (not fits) { panicAt(here, `integer overflow: ${shown(value)} does not fit in an int`) }',
            '',
            '    return n',
            '}',
            '',
            '// The integer part by `mode`, with `fits` false when it does not fit in an int. The steps are',
            '// simple choices, which the C compiler makes without branches (the digits are random).',
            'function toInt(value: decimal, mode: int, mut fits: boolean): int {',
            '    immut coefficient = coefficientOf(value)',
            '    immut exponent = exponentOf(value)',
            '    immut negative = isNegative(value)',
            '    mut magnitude: U128 = 0',
            '',
            '    if (exponent >= 0) {',
            '        if (coefficient == 0) { return 0 }',
            '',
            '        if (exponent > 19 or coefficient > largest / powers[exponent]) {',
            '            fits = false',
            '            return 0',
            '        }',
            '',
            '        magnitude = coefficient * powers[exponent]',
            '    } else {',
            '        // Below 10^34 * 10^-39: less than one half.',
            '        immut unit = if (exponent < -38) { largest } else { powers[-exponent] }',
            '        immut whole = if (exponent < -38) { u128(0) } else { coefficient / unit }',
            '        immut rest = coefficient - whole * unit',
            '        // One more for the rounding away from zero: floor of a negative, ceiling of a positive,',
            '        // or nearest from one half.',
            '        immut inexact = rest != 0',
            '        // rest >= unit - unit / 2, from the sign of the difference (both are below 2^127), which',
            '        // the C compiler computes without a jump: the digits are random.',
            '        immut half = ((rest - (unit - (unit >> 1))) >> 127) == 0',
            '        immut floorUp = mode == 0 and negative',
            '        immut ceilingUp = mode == 1 and not negative',
            '        immut nearestUp = mode == 2 and half',
            '        immut up: U128 = if (inexact and (floorUp or ceilingUp or nearestUp)) { 1 } else { 0 }',
            '        magnitude = whole + up',
            '    }',
            '',
            '    immut limit = u128(9223372036854775807)',
            '',
            '    if (negative) {',
            '        if (magnitude > limit + 1) {',
            '            fits = false',
            '            return 0',
            '        }',
            '',
            '        // -magnitude, `int.min` too.',
            '        immut nothing: U128 = 0',
            '        return lowWord(nothing - magnitude)',
            '    }',
            '',
            '    if (magnitude > limit) {',
            '        fits = false',
            '        return 0',
            '    }',
            '',
            '    return lowWord(magnitude)',
            '}',
            '',
            '// In full, as in everyday writing (`10`, `1.5`, `0.001`, `3000000`), without trailing zeros. A',
            '// whole number is in full as long as it fits in the 34 digits a decimal holds; beyond them its',
            '// other digits would be zeros the decimal does not even keep, so it is in scientific notation',
            '// (`1e300`), which shows every digit kept. A fraction that needs many zeros only to hold places,',
            '// six or more after the point before its first digit, is in scientific notation too, as science',
            '// writes it (`1e-7`, `1.602176634e-19`).',
            'extern function koji_string_from_decimal(value: decimal): string {',
            '    return shown(value)',
            '}',
            '',
            'function shown(given: decimal): string {',
            '    immut value = normalized(given)',
            '    immut coefficient = coefficientOf(value)',
            '',
            '    if (coefficient == 0) { return \'0\' }',
            '',
            '    immut sign = if (isNegative(value)) { \'-\' } else { \'\' }',
            '    immut text = string(coefficient)',
            '    immut exponent = exponentOf(value)',
            '    immut position = text.length() + exponent',
            '',
            '    if (-position >= placeHolders or position > digitCount) {',
            '        immut mantissa = if (text.length() > 1) { `${text[..1]}.${text[1..]}` } else { text }',
            '        return `${sign}${mantissa}e${position - 1}`',
            '    }',
            '',
            '    if (exponent >= 0) { return `${sign}${text}${\'0\' * exponent}` }',
            '',
            '    if (position > 0) { return `${sign}${text[..position]}.${text[position..]}` }',
            '',
            '    return `${sign}0.${\'0\' * -position}${text}`',
            '}',
            '',
            '// Floats',
            '',
            '// The tables of Ryu as ints, read from their texts the first time a float needs them: two words',
            '// for each number of 128 bits, its high one first.',
            'mut fives = nullAddress()',
            'mut inverseFives = nullAddress()',
            '',
            '// The shortest decimal that is the same float again (at most 17 digits): exact both ways. Of the',
            '// shortest ones, the nearest to the float (half up, as Rust). By Ulf Adams\' Ryu: the ends of the',
            '// interval of the numbers that read back as the float, and the float, times a power of 5 of 128',
            '// bits (std/koji/ryu.kj), then the digits removed while the ends differ.',
            'extern function koji_decimal_from_float(value: float): decimal {',
            '    immut place = allocate(8)',
            '    write(place, 0, value)',
            '    immut bits: int = read(place, 0)',
            '    free(place)',
            '    immut fraction = bits & ((1 << 52) - 1)',
            '    immut exponentBits = (bits >> 52) & 0x7FF',
            '',
            '    if (fraction == 0 and exponentBits == 0) { return zero() }',
            '',
            '    // value = m2 * 2^e2 (with two more bits, for the ends of the interval).',
            '    immut e2 = if (exponentBits == 0) { 1 - 1023 - 52 - 2 } else { exponentBits - 1023 - 52 - 2 }',
            '    immut m2 = if (exponentBits == 0) { fraction } else { fraction | (1 << 52) }',
            '    // The ends of the interval count when m2 is even.',
            '    immut even = (m2 & 1) == 0',
            '    immut mv = 4 * m2',
            '    // The gap below a power of two is half the one above.',
            '    immut mmShift = if (fraction != 0 or exponentBits <= 1) { 1 } else { 0 }',
            '    // vr, vp and vm: the float and the ends of its interval, times 10^-e10.',
            '    mut vr = 0',
            '    mut vp = 0',
            '    mut vm = 0',
            '    mut e10 = 0',
            '    mut vmTrailingZeros = false',
            '    mut vrTrailingZeros = false',
            '    powersOfFiveRead()',
            '',
            '    if (e2 >= 0) {',
            '        immut q = maxOf(log10OfPowerOf2(e2) - (if (e2 > 3) { 1 } else { 0 }), 0)',
            '        e10 = q',
            '        immut i = -e2 + q + 125 + bitsOfPowerOf5(q) - 1',
            '        vr = timesPower(mv, inverseFives, q, i)',
            '        vp = timesPower(mv + 2, inverseFives, q, i)',
            '        vm = timesPower(mv - 1 - mmShift, inverseFives, q, i)',
            '',
            '        // The digits removed may be zeros only when 5^q divides the numbers.',
            '        if (q <= 21) {',
            '            if (mv % 5 == 0) {',
            '                vrTrailingZeros = factorsOf5(mv) >= q',
            '            } else {',
            '                if (even) {',
            '                    vmTrailingZeros = factorsOf5(mv - 1 - mmShift) >= q',
            '                } else {',
            '                    vp -= if (factorsOf5(mv + 2) >= q) { 1 } else { 0 }',
            '                }',
            '            }',
            '        }',
            '    } else {',
            '        immut q = maxOf(log10OfPowerOf5(-e2) - (if (-e2 > 1) { 1 } else { 0 }), 0)',
            '        e10 = q + e2',
            '        immut i = -e2 - q',
            '        immut j = q - (bitsOfPowerOf5(i) - 125)',
            '        vr = timesPower(mv, fives, i, j)',
            '        vp = timesPower(mv + 2, fives, i, j)',
            '        vm = timesPower(mv - 1 - mmShift, fives, i, j)',
            '',
            '        if (q <= 1) {',
            '            vrTrailingZeros = true',
            '',
            '            if (even) {',
            '                vmTrailingZeros = mmShift == 1',
            '            } else {',
            '                vp -= 1',
            '            }',
            '        } else {',
            '            if (q < 63) { vrTrailingZeros = (mv & ((1 << q) - 1)) == 0 }',
            '        }',
            '    }',
            '',
            '    // The digits removed while the ends differ; the last one decides the rounding.',
            '    mut removed = 0',
            '    mut lastRemoved = 0',
            '    mut output = 0',
            '',
            '    if (vmTrailingZeros or vrTrailingZeros) {',
            '        while (vp / 10 > vm / 10) {',
            '            vmTrailingZeros = vmTrailingZeros and vm % 10 == 0',
            '            vrTrailingZeros = vrTrailingZeros and lastRemoved == 0',
            '            lastRemoved = vr % 10',
            '            vr = vr / 10',
            '            vp = vp / 10',
            '            vm = vm / 10',
            '            removed += 1',
            '        }',
            '',
            '        if (vmTrailingZeros) {',
            '            while (vm % 10 == 0) {',
            '                vrTrailingZeros = vrTrailingZeros and lastRemoved == 0',
            '                lastRemoved = vr % 10',
            '                vr = vr / 10',
            '                vp = vp / 10',
            '                vm = vm / 10',
            '                removed += 1',
            '            }',
            '        }',
            '',
            '        // Exactly half way between two shortest decimals: up, as Rust (Ryu rounds to even).',
            '        immut up = lastRemoved >= 5 or (vr == vm and (not even or not vmTrailingZeros))',
            '        output = vr + (if (up) { 1 } else { 0 })',
            '    } else {',
            '        mut up = false',
            '',
            '        if (vp / 100 > vm / 100) {',
            '            up = vr % 100 >= 50',
            '            vr = vr / 100',
            '            vp = vp / 100',
            '            vm = vm / 100',
            '            removed += 2',
            '        }',
            '',
            '        while (vp / 10 > vm / 10) {',
            '            up = vr % 10 >= 5',
            '            vr = vr / 10',
            '            vp = vp / 10',
            '            vm = vm / 10',
            '            removed += 1',
            '        }',
            '',
            '        output = vr + (if (vr == vm or up) { 1 } else { 0 })',
            '    }',
            '',
            '    mut exponent = e10 + removed',
            '',
            '    while (output % 10 == 0) {',
            '        output = output / 10',
            '        exponent += 1',
            '    }',
            '',
            '    return make(value < 0, u128(output), exponent)',
            '}',
            '',
            'function powersOfFiveRead() {',
            '    if (not isNull(fives)) { return }',
            '',
            '    fives = numbersOf(powersOfFive)',
            '    inverseFives = numbersOf(inversePowersOfFive)',
            '}',
            '',
            'function numbersOf(table: string): Address {',
            '    immut digits = stringBytes(table)',
            '    immut count = stringSize(table) / 16',
            '    immut words = allocate(count * 8)',
            '',
            '    for i in range(count) {',
            '        mut value: U128 = 0',
            '',
            '        for d in range(16) {',
            '            immut b: byte = read(digits, i * 16 + d)',
            '            value = (value << 4) | wide(int(if (b <= 57) { b - 48 } else { b - 87 }), 0)',
            '        }',
            '',
            '        write(words, i * 8, lowWord(value))',
            '    }',
            '',
            '    return words',
            '}',
            '',
            '// m times the number `index` of a table, shifted right by `shift` bits (at least 64).',
            'function timesPower(m: int, table: Address, index: int, shift: int): int {',
            '    immut high: int = read(table, index * 16)',
            '    immut low: int = read(table, index * 16 + 8)',
            '    immut lowProduct = wordProduct(wide(m, 0), wide(low, 0))',
            '    immut highProduct = wordProduct(wide(m, 0), wide(high, 0))',
            '    return lowWord(((lowProduct >> 64) + highProduct) >> u128(shift - 64))',
            '}',
            '',
            '// The bits of 5^e (1 for e = 0), and the digits of 2^e and 5^e less one, for the exponents of',
            '// floats.',
            'function bitsOfPowerOf5(e: int): int {',
            '    return ((e * 1217359) >> 19) + 1',
            '}',
            '',
            'function log10OfPowerOf2(e: int): int {',
            '    return (e * 78913) >> 18',
            '}',
            '',
            'function log10OfPowerOf5(e: int): int {',
            '    return (e * 732923) >> 20',
            '}',
            '',
            '// How many times 5 divides `value` (not 0).',
            'function factorsOf5(value: int): int {',
            '    mut n = value',
            '    mut count = 0',
            '',
            '    while (n % 5 == 0) {',
            '        n = n / 5',
            '        count += 1',
            '    }',
            '',
            '    return count',
            '}',
            '',
            '// The float of a text, correctly rounded (`strtod`): an infinity when it is too large.',
            'function readFloat(text: string): float {',
            '    immut cText = cString(text)',
            '    immut value = strtod(cText, nullAddress())',
            '    free(cText)',
            '    return value',
            '}',
            '',
            '// 10^0 to 10^22, the powers of ten that are floats exactly (`exactTens`).',
            'function floatTens(): float[] {',
            '    mut tens = [float(1)]',
            '',
            '    for i in range(22) {',
            '        tens.push(tens[i] * float(10))',
            '    }',
            '',
            '    return tens',
            '}',
            '',
            '// The nearest float.',
            'extern function koji_decimal_to_float(value: decimal, here: Location): float {',
            '    immut result = decimalToFloat(value)',
            '',
            '    if (not isFinite(result)) { panicAt(here, \'float overflow\') }',
            '',
            '    return result',
            '}',
            '',
            'function decimalToFloat(value: decimal): float {',
            '    immut coefficient = coefficientOf(value)',
            '    immut exponent = exponentOf(value)',
            '',
            '    // Clinger\'s fast path: a coefficient that is a float exactly, times or divided by a power of',
            '    // ten that is one exactly, is one rounding (correct).',
            '    if (coefficient < (u128(1) << 53) and exponent >= -22 and exponent <= 22) {',
            '        immut exact = float(lowWord(coefficient))',
            '        immut scale = exactTens[if (exponent < 0) { -exponent } else { exponent }]',
            '        immut result = if (exponent < 0) { exact / scale } else { exact * scale }',
            '        return if (isNegative(value)) { -result } else { result }',
            '    }',
            '',
            '    // `strtod` of `-<coefficient>e<exponent>`, written as bytes of C.',
            '    immut text = allocate(64)',
            '    mut at = 0',
            '',
            '    if (isNegative(value)) { at = putByte(text, at, 45) }',
            '',
            '    at = putDigits(text, at, coefficient)',
            '    at = putByte(text, at, 101)',
            '',
            '    if (exponent < 0) { at = putByte(text, at, 45) }',
            '',
            '    at = putDigits(text, at, u128(if (exponent < 0) { -exponent } else { exponent }))',
            '    putByte(text, at, 0)',
            '    immut result = strtod(text, nullAddress())',
            '    free(text)',
            '    return result',
            '}',
            '',
            'function putByte(text: Address, at: int, code: int): int {',
            '    write(text, at, byte(code))',
            '    return at + 1',
            '}',
            '',
            '// The decimal digits of `n` at `at`: the position after them.',
            'function putDigits(text: Address, at: int, n: U128): int {',
            '    immut count = digits(n)',
            '    mut rest = n',
            '    mut i = count - 1',
            '',
            '    while (i >= 0) {',
            '        immut quotient = rest / 10',
            '        write(text, at + i, byte(48 + lowWord(rest - quotient * 10)))',
            '        rest = quotient',
            '        i -= 1',
            '    }',
            '',
            '    return at + count',
            '}',
            '',
            '// Not an infinity (a float of the C library may be one; Koji has none).',
            'function isFinite(value: float): boolean {',
            '    immut largestFloat = float(1.7976931348623157e308)',
            '    return value <= largestFloat and value >= -largestFloat',
            '}',
            '',
            '// Text',
            '',
            '// A decimal from text like `-12.5e3` (with white space around), rounded to 34 digits; `status`',
            '// is 0, or 1 when the text is not a number, or 2 when it is out of range.',
            'extern function koji_decimal_parse(text: string, status: Address): decimal {',
            '    mut code = 0',
            '    immut parts = readParts(text, mut code)',
            '',
            '    if (code != 0) {',
            '        write(status, 0, code)',
            '        return zero()',
            '    }',
            '',
            '    write(status, 0, 0)',
            '',
            '    if (parts.magnitude == 0 and not parts.sticky) { return zero() }',
            '',
            '    mut limit = noLimit',
            '    immut value = round(parts.negative, parts.magnitude, parts.exponent, parts.sticky, mut limit)',
            '',
            '    if (limit != noLimit) {',
            '        write(status, 0, 2)',
            '        return zero()',
            '    }',
            '',
            '    return value',
            '}',
            '',
            '// A number read from text: its first 38 significant digits, and whether more nonzero ones follow.',
            'type Parts = {',
            '    negative: boolean',
            '    magnitude: U128',
            '    exponent: int',
            '    sticky: boolean',
            '}',
            '',
            '// The parts of a number written as text, with `code` 1 when it is not one.',
            'function readParts(given: string, mut code: int): Parts {',
            '    immut invalid: Parts = { negative: false, magnitude: 0, exponent: 0, sticky: false }',
            '    immut text = trim(given)',
            '    immut chars = text.chars()',
            '    mut start = 0',
            '    mut negative = false',
            '',
            '    if (chars.length() > 0 and (chars[0] == \'-\' or chars[0] == \'+\')) {',
            '        negative = chars[0] == \'-\'',
            '        start = 1',
            '    }',
            '',
            '    // The digits, the point and the exponent.',
            '    mut powerAt = -1',
            '',
            '    for i in range(start, chars.length()) {',
            '        if (powerAt < 0 and (chars[i] == \'e\' or chars[i] == \'E\')) { powerAt = i }',
            '    }',
            '',
            '    immut numberEnd = if (powerAt < 0) { chars.length() } else { powerAt }',
            '    mut pointAt = -1',
            '',
            '    for i in range(start, numberEnd) {',
            '        if (pointAt < 0 and chars[i] == \'.\') { pointAt = i }',
            '    }',
            '',
            '    immut wholeEnd = if (pointAt < 0) { numberEnd } else { pointAt }',
            '    immut fractionStart = if (pointAt < 0) { numberEnd } else { pointAt + 1 }',
            '',
            '    if (wholeEnd == start and fractionStart >= numberEnd) {',
            '        code = 1',
            '        return invalid',
            '    }',
            '',
            '    if (not allDigits(chars, start, wholeEnd) or not allDigits(chars, fractionStart, numberEnd)) {',
            '        code = 1',
            '        return invalid',
            '    }',
            '',
            '    mut exponent = 0',
            '',
            '    if (powerAt >= 0) {',
            '        mut first = powerAt + 1',
            '        mut minus = false',
            '',
            '        if (first < chars.length() and (chars[first] == \'+\' or chars[first] == \'-\')) {',
            '            minus = chars[first] == \'-\'',
            '            first += 1',
            '        }',
            '',
            '        if (first >= chars.length() or not allDigits(chars, first, chars.length())) {',
            '            code = 1',
            '            return invalid',
            '        }',
            '',
            '        // A huge exponent is out of range anyway.',
            '        mut value = 0',
            '',
            '        for i in range(first, minOf(first + 6, chars.length())) {',
            '            value = value * 10 + (chars[i].code() - 48)',
            '        }',
            '',
            '        if (chars.length() - first > 6) { value = 1000000 }',
            '',
            '        exponent = if (minus) { -value } else { value }',
            '    }',
            '',
            '    // The significant digits (without leading zeros), the first 38 exactly and the rest as sticky.',
            '    mut magnitude: U128 = 0',
            '    mut count = 0',
            '    mut sticky = false',
            '    mut dropped = 0',
            '',
            '    for i in range(start, numberEnd) {',
            '        if (i == wholeEnd) { continue }',
            '',
            '        immut digit = chars[i].code() - 48',
            '        immut inFraction = i > wholeEnd',
            '',
            '        if (magnitude == 0 and digit == 0) {',
            '            if (inFraction) { exponent -= 1 }',
            '',
            '            continue',
            '        }',
            '',
            '        if (count < 38) {',
            '            magnitude = magnitude * 10 + u128(digit)',
            '            count += 1',
            '',
            '            if (inFraction) { exponent -= 1 }',
            '        } else {',
            '            if (digit != 0) { sticky = true }',
            '',
            '            if (not inFraction) { dropped += 1 }',
            '        }',
            '    }',
            '',
            '    return { negative: negative and (magnitude != 0 or sticky), magnitude: magnitude, exponent: exponent + dropped, sticky: sticky }',
            '}',
            '',
            'function allDigits(chars: char[], start: int, end: int): boolean {',
            '    for i in range(start, end) {',
            '        if (chars[i] < \'0\' or chars[i] > \'9\') { return false }',
            '    }',
            '',
            '    return true',
            '}',
            '',
            '// Powers with a fractional exponent: e^(y ln x), with `exp` and `ln` with 64 digits after the',
            '// point, in fixed point on big integers.',
            '',
            '// Big numbers: natural numbers in limbs of base 10^19 (each below 10^19, in the low half of a U128),',
            '// the lowest first, without zero limbs at the end. Dividing by a power of ten drops limbs, and the',
            '// limbs are the digits of the text. The results are new lists of their size, which the operations',
            '// change through the addresses of their limbs.',
            '',
            '// 10^19, the base of the limbs (a constant for the C compiler, which multiplies instead of dividing).',
            'function limbBase(): U128 {',
            '    return wide(-8446744073709551616, 0)',
            '}',
            '',
            'function bigFrom(n: U128): U128[] {',
            '    immut out = zeroWords(3)',
            '    immut limbs = listItems(out)',
            '    putWord(limbs, 0, n % limbBase())',
            '    putWord(limbs, 1, n / limbBase() % limbBase())',
            '    putWord(limbs, 2, n / limbBase() / limbBase())',
            '    return trimmedOwn(out)',
            '}',
            '',
            'function bigCompare(a: U128[], b: U128[]): int {',
            '    if (a.length() != b.length()) { return if (a.length() < b.length()) { -1 } else { 1 } }',
            '',
            '    immut first = listItems(a)',
            '    immut second = listItems(b)',
            '    mut i = a.length() - 1',
            '',
            '    while (i >= 0) {',
            '        immut x = rawWord(first, i, a.length())',
            '        immut y = rawWord(second, i, b.length())',
            '',
            '        if (x != y) { return if (x < y) { -1 } else { 1 } }',
            '',
            '        i -= 1',
            '    }',
            '',
            '    return 0',
            '}',
            '',
            'function bigAdd(a: U128[], b: U128[]): U128[] {',
            '    immut longer = maxOf(a.length(), b.length())',
            '    immut out = zeroWords(longer + 1)',
            '    immut target = listItems(out)',
            '    immut first = listItems(a)',
            '    immut second = listItems(b)',
            '    mut carry: U128 = 0',
            '',
            '    for i in range(longer) {',
            '        mut sum = rawWord(first, i, a.length()) + rawWord(second, i, b.length()) + carry',
            '        carry = 0',
            '',
            '        if (sum >= limbBase()) {',
            '            sum = sum - limbBase()',
            '            carry = 1',
            '        }',
            '',
            '        putWord(target, i, sum)',
            '    }',
            '',
            '    putWord(target, longer, carry)',
            '    return trimmedOwn(out)',
            '}',
            '',
            '// `a - b`, for `a >= b`.',
            'function bigSubtract(a: U128[], b: U128[]): U128[] {',
            '    immut out = zeroWords(a.length())',
            '    immut target = listItems(out)',
            '    immut first = listItems(a)',
            '    immut second = listItems(b)',
            '    mut borrow: U128 = 0',
            '',
            '    for i in range(a.length()) {',
            '        immut current = rawWord(first, i, a.length())',
            '        immut taken = rawWord(second, i, b.length()) + borrow',
            '',
            '        if (current >= taken) {',
            '            putWord(target, i, current - taken)',
            '            borrow = 0',
            '        } else {',
            '            putWord(target, i, current + limbBase() - taken)',
            '            borrow = 1',
            '        }',
            '    }',
            '',
            '    return trimmedOwn(out)',
            '}',
            '',
            'function bigMultiply(a: U128[], b: U128[]): U128[] {',
            '    immut out = zeroWords(a.length() + b.length() + 1)',
            '    immut target = listItems(out)',
            '    immut first = listItems(a)',
            '    immut second = listItems(b)',
            '',
            '    for i in range(a.length()) {',
            '        immut factor = rawWord(first, i, a.length())',
            '        mut carry: U128 = 0',
            '',
            '        for j in range(b.length()) {',
            '            // Below 10^38 + 2 * 10^19: within 128 bits.',
            '            immut current = rawWord(target, i + j, out.length()) + wordProduct(factor, rawWord(second, j, b.length())) + carry',
            '            carry = current / limbBase()',
            '            putWord(target, i + j, current - wordProduct(carry, limbBase()))',
            '        }',
            '',
            '        mut k = i + b.length()',
            '',
            '        while (carry != 0) {',
            '            immut current = rawWord(target, k, out.length()) + carry',
            '            carry = current / limbBase()',
            '            putWord(target, k, current - wordProduct(carry, limbBase()))',
            '            k += 1',
            '        }',
            '    }',
            '',
            '    return trimmedOwn(out)',
            '}',
            '',
            '// `a / divisor` (of 64 bits), toward zero.',
            'function bigDivideSmall(a: U128[], divisor: U128): U128[] {',
            '    immut out = copied(a, 0)',
            '    divideLimbs(listItems(out), out.length(), divisor)',
            '    return trimmedOwn(out)',
            '}',
            '',
            '// The limbs from `limbs` (`count` of them) divided by `divisor` (of 64 bits), toward zero, in place.',
            'function divideLimbs(limbs: Address, count: int, divisor: U128) {',
            '    mut rest: U128 = 0',
            '    mut i = count - 1',
            '',
            '    while (i >= 0) {',
            '        // Below divisor * 10^19: within 128 bits, and the quotient below 10^19.',
            '        immut current = wordProduct(rest, limbBase()) + rawWord(limbs, i, count)',
            '        immut quotient = current / divisor',
            '        rest = current - wordProduct(quotient, divisor)',
            '        putWord(limbs, i, quotient)',
            '        i -= 1',
            '    }',
            '}',
            '',
            '// Times 10^n: n / 19 limbs of zero first, then times 10^(n % 19).',
            'function bigTimesTenTo(a: U128[], n: int): U128[] {',
            '    immut shift = n / 19',
            '    immut out = zeroWords(a.length() + shift + 1)',
            '    immut target = listItems(out)',
            '    memcpy(offset(target, shift * 16), listItems(a), a.length() * 16)',
            '    immut factor = powers[n % 19]',
            '    mut carry: U128 = 0',
            '',
            '    for i in range(shift, out.length()) {',
            '        immut current = wordProduct(rawWord(target, i, out.length()), factor) + carry',
            '        carry = current / limbBase()',
            '        putWord(target, i, current - wordProduct(carry, limbBase()))',
            '    }',
            '',
            '    return trimmedOwn(out)',
            '}',
            '',
            '// Divided by 10^n, toward zero: n / 19 limbs dropped, then divided by 10^(n % 19).',
            'function bigOverTenTo(a: U128[], n: int): U128[] {',
            '    immut dropped = n / 19',
            '',
            '    if (dropped >= a.length()) { return [] }',
            '',
            '    immut out = copied(a, dropped)',
            '    divideLimbs(listItems(out), out.length(), powers[n % 19])',
            '    return trimmedOwn(out)',
            '}',
            '',
            '// The digits of a big number: its highest limb, then the others in 19 digits each.',
            'function bigDigits(a: U128[]): string {',
            '    if (a.length() == 0) { return \'0\' }',
            '',
            '    immut limbs = listItems(a)',
            '    mut text = string(rawWord(limbs, a.length() - 1, a.length()))',
            '    mut i = a.length() - 2',
            '',
            '    while (i >= 0) {',
            '        immut part = string(rawWord(limbs, i, a.length()))',
            '        text += \'0\' * (19 - part.length()) + part',
            '        i -= 1',
            '    }',
            '',
            '    return text',
            '}',
            '',
            '// The limb `i` of the limbs at `limbs` (`count` of them), 0 beyond them.',
            'function rawWord(limbs: Address, i: int, count: int): U128 {',
            '    if (i >= count) { return 0 }',
            '',
            '    immut low: int = read(limbs, i * 16)',
            '    return wide(low, 0)',
            '}',
            '',
            'function putWord(limbs: Address, i: int, value: U128) {',
            '    write(limbs, i * 16, lowWord(value))',
            '    write(limbs, i * 16 + 8, 0)',
            '}',
            '',
            '// A new list with the limbs of `a` from `start`, to change.',
            'function copied(a: U128[], start: int): U128[] {',
            '    immut out = zeroWords(a.length() - start)',
            '    memcpy(listItems(out), offset(listItems(a), start * 16), (a.length() - start) * 16)',
            '    return out',
            '}',
            '',
            '// `limbs` (a list of its own) without the zero limbs at its end.',
            'function trimmedOwn(limbs: U128[]): U128[] {',
            '    immut items = listItems(limbs)',
            '    mut end = limbs.length()',
            '',
            '    while (end > 0 and rawWord(items, end - 1, end) == 0) {',
            '        end -= 1',
            '    }',
            '',
            '    setListLength(limbs, end)',
            '    return limbs',
            '}',
            '',
            '// `n` limbs of zero, in a new list.',
            'function zeroWords(n: int): U128[] {',
            '    mut words: U128[] = []',
            '    reserve(words, n)',
            '    memset(listItems(words), 0, n * 16)',
            '    setListLength(words, n)',
            '    return words',
            '}',
            '',
            '// A signed number with 64 digits after the point.',
            'type Fixed = {',
            '    negative: boolean',
            '    magnitude: U128[]',
            '}',
            '',
            'immut places = 64',
            '',
            '// 1, computed the first time.',
            'mut oneKnown: Fixed[] = []',
            '',
            'function fixedOne(): Fixed {',
            '    if (oneKnown.length() == 0) { oneKnown.push({ negative: false, magnitude: bigTimesTenTo(bigFrom(1), places) }) }',
            '',
            '    return oneKnown[0]',
            '}',
            '',
            'function fixedFromInt(n: int): Fixed {',
            '    immut size = if (n < 0) { u128(-n) } else { u128(n) }',
            '    return { negative: n < 0, magnitude: bigTimesTenTo(bigFrom(size), places) }',
            '}',
            '',
            'function fixedFromDecimal(d: decimal): Fixed {',
            '    immut coefficient = bigFrom(coefficientOf(d))',
            '    immut shift = exponentOf(d) + places',
            '    immut magnitude = if (shift >= 0) { bigTimesTenTo(coefficient, shift) } else { bigOverTenTo(coefficient, -shift) }',
            '    return { negative: isNegative(d) and magnitude.length() > 0, magnitude: magnitude }',
            '}',
            '',
            'function fixedFromFloat(f: float): Fixed {',
            '    return fixedFromDecimal(koji_decimal_from_float(f))',
            '}',
            '',
            'function fixedToFloat(x: Fixed): float {',
            '    immut value = readFloat(`${bigDigits(x.magnitude)}e-${places}`)',
            '    return if (x.negative) { -value } else { value }',
            '}',
            '',
            'function fixedNegate(x: Fixed): Fixed {',
            '    return { negative: not x.negative and x.magnitude.length() > 0, magnitude: x.magnitude }',
            '}',
            '',
            'function fixedAdd(a: Fixed, b: Fixed): Fixed {',
            '    if (a.negative == b.negative) { return { negative: a.negative, magnitude: bigAdd(a.magnitude, b.magnitude) } }',
            '',
            '    if (bigCompare(a.magnitude, b.magnitude) < 0) { return { negative: b.negative, magnitude: bigSubtract(b.magnitude, a.magnitude) } }',
            '',
            '    immut magnitude = bigSubtract(a.magnitude, b.magnitude)',
            '    return { negative: a.negative and magnitude.length() > 0, magnitude: magnitude }',
            '}',
            '',
            'function fixedSubtract(a: Fixed, b: Fixed): Fixed {',
            '    return fixedAdd(a, fixedNegate(b))',
            '}',
            '',
            'function fixedMultiply(a: Fixed, b: Fixed): Fixed {',
            '    immut magnitude = bigOverTenTo(bigMultiply(a.magnitude, b.magnitude), places)',
            '    return { negative: a.negative != b.negative and magnitude.length() > 0, magnitude: magnitude }',
            '}',
            '',
            'function fixedDivideSmall(x: Fixed, n: int): Fixed {',
            '    immut magnitude = bigDivideSmall(x.magnitude, u128(n))',
            '    return { negative: x.negative and magnitude.length() > 0, magnitude: magnitude }',
            '}',
            '',
            '// e^x by its series, for |x| below 3: 1 + x + x^2/2 + ..., each term the one before times x,',
            '// divided by 10^64 and by n toward zero, until a term is 0. In buffers of limbs of 8 bytes that the',
            '// term and the sum change in place, with the same values as `expSeriesLists` (a division by 10^64',
            '// and then by n is one by 10^64 n: floor(floor(q / a) / b) = floor(q / ab)).',
            'function expSeries(x: Fixed): Fixed {',
            '    immut xCount = x.magnitude.length()',
            '',
            '    // |x| below 3 takes 4 limbs, as in every use (`newtonLn`, `realPower`); anything larger, by the',
            '    // lists.',
            '    if (xCount > 4) { return expSeriesLists(x) }',
            '',
            '    immut xLimbs = allocate(4 * 8)',
            '    immut term = allocate(6 * 8)',
            '    immut sum = allocate(6 * 8)',
            '    immut product = allocate(10 * 8)',
            '    immut given = listItems(x.magnitude)',
            '',
            '    for i in range(xCount) {',
            '        setLimb(xLimbs, i, rawWord(given, i, xCount))',
            '    }',
            '',
            '    // 1 is 10^64: 10^7 in the limb of 10^57.',
            '    for i in range(3) {',
            '        setLimb(term, i, 0)',
            '        setLimb(sum, i, 0)',
            '    }',
            '',
            '    setLimb(term, 3, u128(10000000))',
            '    setLimb(sum, 3, u128(10000000))',
            '    mut termCount = 4',
            '    mut sumCount = 4',
            '    mut termNegative = false',
            '    mut sumNegative = false',
            '    mut n = 1',
            '',
            '    while (true) {',
            '        // product = term * x',
            '        immut productCount = termCount + xCount',
            '',
            '        for i in range(productCount) {',
            '            setLimb(product, i, 0)',
            '        }',
            '',
            '        for i in range(termCount) {',
            '            immut factor = limbAt(term, i)',
            '            mut carry: U128 = 0',
            '',
            '            for j in range(xCount) {',
            '                immut current = limbAt(product, i + j) + wordProduct(factor, limbAt(xLimbs, j)) + carry',
            '                carry = current / limbBase()',
            '                setLimb(product, i + j, current - wordProduct(carry, limbBase()))',
            '            }',
            '',
            '            setLimb(product, i + xCount, carry)',
            '        }',
            '',
            '        // term = product / (10^64 n): three limbs dropped, then one division by 10^7 n.',
            '        termCount = if (productCount > 3) { productCount - 3 } else { 0 }',
            '        memcpy(term, offset(product, 24), termCount * 8)',
            '        immut divisor = u128(10000000 * n)',
            '        mut rest: U128 = 0',
            '        mut i = termCount - 1',
            '',
            '        while (i >= 0) {',
            '            immut current = wordProduct(rest, limbBase()) + limbAt(term, i)',
            '            immut quotient = current / divisor',
            '            rest = current - wordProduct(quotient, divisor)',
            '            setLimb(term, i, quotient)',
            '            i -= 1',
            '        }',
            '',
            '        termCount = limbCount(term, termCount)',
            '',
            '        if (termCount == 0) { break }',
            '',
            '        termNegative = termNegative != x.negative',
            '        // sum += term, with their signs.',
            '        immut order = compareLimbs(sum, sumCount, term, termCount)',
            '',
            '        if (sumNegative == termNegative) {',
            '            mut carry: U128 = 0',
            '            immut longer = maxOf(sumCount, termCount)',
            '',
            '            for k in range(longer) {',
            '                mut total = limbOr(sum, k, sumCount) + limbOr(term, k, termCount) + carry',
            '                carry = 0',
            '',
            '                if (total >= limbBase()) {',
            '                    total = total - limbBase()',
            '                    carry = 1',
            '                }',
            '',
            '                setLimb(sum, k, total)',
            '            }',
            '',
            '            sumCount = longer',
            '',
            '            if (carry != 0) {',
            '                setLimb(sum, longer, carry)',
            '                sumCount = longer + 1',
            '            }',
            '        } else {',
            '            // The larger less the smaller, with the sign of the larger (0 is positive).',
            '            immut sumLarger = order >= 0',
            '            immut count = if (sumLarger) { sumCount } else { termCount }',
            '            mut borrow: U128 = 0',
            '',
            '            for k in range(count) {',
            '                immut large = if (sumLarger) { limbAt(sum, k) } else { limbAt(term, k) }',
            '                immut small = (if (sumLarger) { limbOr(term, k, termCount) } else { limbOr(sum, k, sumCount) }) + borrow',
            '',
            '                if (large >= small) {',
            '                    setLimb(sum, k, large - small)',
            '                    borrow = 0',
            '                } else {',
            '                    setLimb(sum, k, large + limbBase() - small)',
            '                    borrow = 1',
            '                }',
            '            }',
            '',
            '            sumCount = limbCount(sum, count)',
            '            sumNegative = if (sumLarger) { sumNegative and sumCount > 0 } else { termNegative }',
            '        }',
            '',
            '        n += 1',
            '    }',
            '',
            '    immut magnitude = zeroWords(sumCount)',
            '    immut target = listItems(magnitude)',
            '',
            '    for k in range(sumCount) {',
            '        putWord(target, k, limbAt(sum, k))',
            '    }',
            '',
            '    free(xLimbs)',
            '    free(term)',
            '    free(sum)',
            '    free(product)',
            '    return { negative: sumNegative, magnitude: magnitude }',
            '}',
            '',
            '// The limbs of 8 bytes of `expSeries`.',
            'function limbAt(limbs: Address, i: int): U128 {',
            '    immut low: int = read(limbs, i * 8)',
            '    return wide(low, 0)',
            '}',
            '',
            '// The limb `i` of a number of `count` limbs, 0 beyond them.',
            'function limbOr(limbs: Address, i: int, count: int): U128 {',
            '    if (i >= count) { return 0 }',
            '',
            '    return limbAt(limbs, i)',
            '}',
            '',
            'function setLimb(limbs: Address, i: int, value: U128) {',
            '    write(limbs, i * 8, lowWord(value))',
            '}',
            '',
            '// The limbs of a number of `count` limbs but its zero limbs at the end.',
            'function limbCount(limbs: Address, count: int): int {',
            '    mut end = count',
            '',
            '    while (end > 0 and limbAt(limbs, end - 1) == 0) {',
            '        end -= 1',
            '    }',
            '',
            '    return end',
            '}',
            '',
            'function compareLimbs(a: Address, aCount: int, b: Address, bCount: int): int {',
            '    if (aCount != bCount) { return if (aCount < bCount) { -1 } else { 1 } }',
            '',
            '    mut i = aCount - 1',
            '',
            '    while (i >= 0) {',
            '        immut x = limbAt(a, i)',
            '        immut y = limbAt(b, i)',
            '',
            '        if (x != y) { return if (x < y) { -1 } else { 1 } }',
            '',
            '        i -= 1',
            '    }',
            '',
            '    return 0',
            '}',
            '',
            '// e^x by its series, on lists: what `expSeries` computes.',
            'function expSeriesLists(x: Fixed): Fixed {',
            '    mut sum = fixedOne()',
            '    mut term = fixedOne()',
            '    mut n = 1',
            '',
            '    while (true) {',
            '        term = fixedDivideSmall(fixedMultiply(term, x), n)',
            '',
            '        if (term.magnitude.length() == 0) { break }',
            '',
            '        sum = fixedAdd(sum, term)',
            '        n += 1',
            '    }',
            '',
            '    return sum',
            '}',
            '',
            '// ln(10), computed the first time.',
            'mut ln10Known: Fixed[] = []',
            '',
            'function ln10(): Fixed {',
            '    if (ln10Known.length() == 0) { ln10Known.push(newtonLn(fixedFromInt(10), log(float(10)))) }',
            '',
            '    return ln10Known[0]',
            '}',
            '',
            '// ln(m) for m from 1 to 10, from a first estimate, by Newton\'s method on e^y = m: y + m e^-y - 1.',
            'function newtonLn(m: Fixed, estimate: float): Fixed {',
            '    mut y = fixedFromFloat(estimate)',
            '',
            '    // Each step doubles the correct digits (16, 32, 64): it ends when a step changes nothing but',
            '    // the last digit, which rounding may move back and forth.',
            '    for step in range(8) {',
            '        immut next = fixedSubtract(fixedAdd(y, fixedMultiply(m, expSeries(fixedNegate(y)))), fixedOne())',
            '        immut change = fixedSubtract(next, y).magnitude',
            '        y = next',
            '',
            '        if (bigCompare(change, bigFrom(1)) <= 0) { break }',
            '    }',
            '',
            '    return y',
            '}',
            '',
            '// `base ** exponent` for a positive base and a fractional exponent: e^(y ln x), rounded to 34',
            '// digits from 64 (correct but for results within 10^-60 of a halfway point).',
            'function realPower(x: decimal, y: decimal, here: Location): decimal {',
            '    // Far out of range, before computing: log10 of the result, from floats.',
            '    immut coefficient = coefficientOf(x)',
            '    immut count = digits(coefficient)',
            '    immut k = exponentOf(x) + count - 1',
            '    immut mantissa = wideToFloat(coefficient) / powerOfFloat(float(10), count - 1)',
            '    mut exponentFloat = decimalToFloat(y)',
            '',
            '    if (not isFinite(exponentFloat)) { exponentFloat = float(1.7976931348623157e308) }',
            '',
            '    immut logarithm = log10(mantissa) + float(k)',
            '',
            '    if (outOfRange(exponentFloat, logarithm, true)) { panicAt(here, \'decimal overflow\') }',
            '',
            '    if (outOfRange(exponentFloat, logarithm, false)) { panicAt(here, \'decimal underflow\') }',
            '',
            '    // ln x = ln(m) + k ln 10, with m from 1 to 10.',
            '    immut m = fixedFromDecimal(make(false, coefficient, 1 - count))',
            '    immut lnM = newtonLn(m, log(fixedToFloat(m)))',
            '    immut lnX = fixedAdd(lnM, fixedMultiply(fixedFromInt(k), ln10()))',
            '    immut t = fixedMultiply(fixedFromDecimal(y), lnX)',
            '    // e^t = 10^n e^r, with r from 0 to ln 10.',
            '    mut n = int(floor(fixedToFloat(t) / float(2.302585092994045684017991454684364)))',
            '    mut r = fixedSubtract(t, fixedMultiply(fixedFromInt(n), ln10()))',
            '',
            '    while (r.negative) {',
            '        n -= 1',
            '        r = fixedAdd(r, ln10())',
            '    }',
            '',
            '    while (bigCompare(r.magnitude, ln10().magnitude) >= 0) {',
            '        n += 1',
            '        r = fixedSubtract(r, ln10())',
            '    }',
            '',
            '    immut value = expSeries(r)',
            '    // The digits of e^r (its value times 10^64), rounded to 34 at the end.',
            '    mut code = 0',
            '    immut parts = readParts(`${bigDigits(value.magnitude)}e${n - places}`, mut code)',
            '',
            '    if (code != 0) { panicAt(here, \'decimal overflow\') }',
            '',
            '    return finish(false, parts.magnitude, parts.exponent, parts.sticky, here)',
            '}',
            '',
            '// Whether `y * logarithm` is above 6200 (`above`) or below -6250, without overflowing a float.',
            'function outOfRange(y: float, logarithm: float, above: boolean): boolean {',
            '    immut largestFloat = float(1.7976931348623157e308)',
            '    immut size = if (logarithm < 0) { -logarithm } else { logarithm }',
            '    immut ySize = if (y < 0) { -y } else { y }',
            '',
            '    // The product is an infinity in floats: its sign tells.',
            '    if (size > float(1) and ySize > largestFloat / size) {',
            '        immut positive = (y > 0) == (logarithm > 0)',
            '        return positive == above',
            '    }',
            '',
            '    immut rough = y * logarithm',
            '    return if (above) { rough > float(6200) } else { rough < float(-6250) }',
            '}',
            '',
            '// x^n by squaring, as the `powi` of C compilers.',
            'function powerOfFloat(x: float, n: int): float {',
            '    mut result = float(1)',
            '    mut base = x',
            '    mut left = n',
            '',
            '    while (true) {',
            '        if ((left & 1) == 1) { result = result * base }',
            '',
            '        left = left / 2',
            '',
            '        if (left == 0) { break }',
            '',
            '        base = base * base',
            '    }',
            '',
            '    return result',
            '}',
        ].join('\n'))
    }

    if (name == 'koji:ecc') {
        return Some([
            '// `koji:ecc`: the curves P-256, P-384 and P-521 of NIST (FIPS 186-4), in the library of the runtime',
            '// written in Koji: Diffie-Hellman on P-256 (a key exchange of TLS 1.3, for the servers without X25519)',
            '// and the verification of ECDSA signatures (certificates and their proofs). On the numbers of koji:bignum,',
            '// in the form of Montgomery. A point is projective (X : Y : Z); it is added by the complete formulas',
            '// of Renes, Costello and Batina (2016, algorithm 4, for a = -3), which have no case apart (the point',
            '// at infinity, a point added to itself), so a secret scalar multiplies with the same steps whatever',
            '// its bits ("double and add always", the sum chosen with a mask).',
            '',
            'import { Address, CInt, CSize, allocate, free, offset, read, stringBytes, stringSize, write } from \'koji:unsafe\'',
            'import { Modulus, addModulo, belowModulus, compare, fromBytes, fromForm, invertModulo, limb, modulusOf, multiply, select, subtractInPlace, subtractModulo, toBytes, toForm, zeroNumber } from \'koji:bignum\'',
            '',
            'extern function memcpy(target: Address, source: Address, size: CSize): Address',
            '',
            '// The parameters, in hexadecimal: p, b, the order n, and the generator (x, y).',
            'immut p256Text = \'\'',
            'immut p384Text = \'\'',
            'immut p521Text = \'\'',
            '',
            '// A curve: its field and its order, b and the generator in the form of Montgomery, the bytes of a',
            '// coordinate, and the eight numbers the formulas of points work in (the library has one thread).',
            'export type Curve = {',
            '    field: Modulus',
            '    order: Modulus',
            '    b: Address',
            '    gx: Address',
            '    gy: Address',
            '    size: int',
            '    work: Address',
            '}',
            '',
            '// The curves, made the first time they are needed (an empty list before).',
            'mut curves: Curve[] = []',
            '',
            '// The curve 0 (P-256), 1 (P-384) or 2 (P-521).',
            'export function curveOf(which: int): Curve {',
            '    if (curves.length() == 0) {',
            '        curves.push(makeCurve(p256Text, 32))',
            '        curves.push(makeCurve(p384Text, 48))',
            '        curves.push(makeCurve(p521Text, 66))',
            '    }',
            '',
            '    return curves[which]',
            '}',
            '',
            'function makeCurve(text: string, size: int): Curve {',
            '    immut bytes = allocate(size * 5)',
            '    immut digits = stringBytes(text)',
            '',
            '    for i in range(size * 5) {',
            '        write(bytes, i, byte(hexDigit(digits, 2 * i) * 16 + hexDigit(digits, 2 * i + 1)))',
            '    }',
            '',
            '    immut field = modulusOf(bytes, size)',
            '    immut order = modulusOf(offset(bytes, 2 * size), size)',
            '    immut t = zeroNumber(field.count + 2)',
            '    immut b = formOf(field, offset(bytes, size), size, t)',
            '    immut gx = formOf(field, offset(bytes, 3 * size), size, t)',
            '    immut gy = formOf(field, offset(bytes, 4 * size), size, t)',
            '    free(t)',
            '    free(bytes)',
            '    return { field: field, order: order, b: b, gx: gx, gy: gy, size: size, work: zeroNumber(8 * (field.count + 1)) }',
            '}',
            '',
            'function hexDigit(digits: Address, at: int): int {',
            '    immut b: byte = read(digits, at)',
            '    return int(if (b <= 57) { b - 48 } else { b - 87 })',
            '}',
            '',
            '// The number of big-endian bytes, in the form of Montgomery of `m`.',
            'function formOf(m: Modulus, bytes: Address, size: int, t: Address): Address {',
            '    immut n = fromBytes(bytes, size, m.count)',
            '    toForm(m, n, n, t)',
            '    return n',
            '}',
            '',
            '// Points: three numbers (X, Y, Z) of `count` limbs each, one after the other.',
            '',
            'function newPoint(count: int): Address {',
            '    return zeroNumber(3 * count + 2)',
            '}',
            '',
            'function coordinate(point: Address, index: int, count: int): Address {',
            '    return offset(point, index * count * 8)',
            '}',
            '',
            '// out = a + b (complete: any points, out may be a or b).',
            'function addPoints(curve: Curve, out: Address, a: Address, b: Address, t: Address) {',
            '    immut f = curve.field',
            '    immut count = f.count',
            '    immut x1 = coordinate(a, 0, count)',
            '    immut y1 = coordinate(a, 1, count)',
            '    immut z1 = coordinate(a, 2, count)',
            '    immut x2 = coordinate(b, 0, count)',
            '    immut y2 = coordinate(b, 1, count)',
            '    immut z2 = coordinate(b, 2, count)',
            '    immut t0 = workNumber(curve, 0)',
            '    immut t1 = workNumber(curve, 1)',
            '    immut t2 = workNumber(curve, 2)',
            '    immut t3 = workNumber(curve, 3)',
            '    immut t4 = workNumber(curve, 4)',
            '    immut x3 = workNumber(curve, 5)',
            '    immut y3 = workNumber(curve, 6)',
            '    immut z3 = workNumber(curve, 7)',
            '    multiply(f, t0, x1, x2, t)',
            '    multiply(f, t1, y1, y2, t)',
            '    multiply(f, t2, z1, z2, t)',
            '    addModulo(f, t3, x1, y1)',
            '    addModulo(f, t4, x2, y2)',
            '    multiply(f, t3, t3, t4, t)',
            '    addModulo(f, t4, t0, t1)',
            '    subtractModulo(f, t3, t3, t4)',
            '    addModulo(f, t4, y1, z1)',
            '    addModulo(f, x3, y2, z2)',
            '    multiply(f, t4, t4, x3, t)',
            '    addModulo(f, x3, t1, t2)',
            '    subtractModulo(f, t4, t4, x3)',
            '    addModulo(f, x3, x1, z1)',
            '    addModulo(f, y3, x2, z2)',
            '    multiply(f, x3, x3, y3, t)',
            '    addModulo(f, y3, t0, t2)',
            '    subtractModulo(f, y3, x3, y3)',
            '    multiply(f, z3, curve.b, t2, t)',
            '    subtractModulo(f, x3, y3, z3)',
            '    addModulo(f, z3, x3, x3)',
            '    addModulo(f, x3, x3, z3)',
            '    subtractModulo(f, z3, t1, x3)',
            '    addModulo(f, x3, t1, x3)',
            '    multiply(f, y3, curve.b, y3, t)',
            '    addModulo(f, t1, t2, t2)',
            '    addModulo(f, t2, t1, t2)',
            '    subtractModulo(f, y3, y3, t2)',
            '    subtractModulo(f, y3, y3, t0)',
            '    addModulo(f, t1, y3, y3)',
            '    addModulo(f, y3, t1, y3)',
            '    addModulo(f, t1, t0, t0)',
            '    addModulo(f, t0, t1, t0)',
            '    subtractModulo(f, t0, t0, t2)',
            '    multiply(f, t1, t4, y3, t)',
            '    multiply(f, t2, t0, y3, t)',
            '    multiply(f, y3, x3, z3, t)',
            '    addModulo(f, y3, y3, t2)',
            '    multiply(f, x3, t3, x3, t)',
            '    subtractModulo(f, x3, x3, t1)',
            '    multiply(f, z3, t4, z3, t)',
            '    multiply(f, t1, t3, t0, t)',
            '    addModulo(f, z3, z3, t1)',
            '    memcpy(coordinate(out, 0, count), x3, count * 8)',
            '    memcpy(coordinate(out, 1, count), y3, count * 8)',
            '    memcpy(coordinate(out, 2, count), z3, count * 8)',
            '}',
            '',
            '// The number `i` (0 to 7) of the curve\'s work space.',
            'function workNumber(curve: Curve, i: int): Address {',
            '    return offset(curve.work, i * (curve.field.count + 1) * 8)',
            '}',
            '',
            '// out = 2 a (complete, out may be a): algorithm 6 of Renes, Costello and Batina (a = -3), 8',
            '// products and 3 squares where the addition takes 12 and 2.',
            'function doublePoint(curve: Curve, out: Address, a: Address, t: Address) {',
            '    immut f = curve.field',
            '    immut count = f.count',
            '    immut x = coordinate(a, 0, count)',
            '    immut y = coordinate(a, 1, count)',
            '    immut z = coordinate(a, 2, count)',
            '    immut t0 = workNumber(curve, 0)',
            '    immut t1 = workNumber(curve, 1)',
            '    immut t2 = workNumber(curve, 2)',
            '    immut t3 = workNumber(curve, 3)',
            '    immut x3 = workNumber(curve, 5)',
            '    immut y3 = workNumber(curve, 6)',
            '    immut z3 = workNumber(curve, 7)',
            '    multiply(f, t0, x, x, t)',
            '    multiply(f, t1, y, y, t)',
            '    multiply(f, t2, z, z, t)',
            '    multiply(f, t3, x, y, t)',
            '    addModulo(f, t3, t3, t3)',
            '    multiply(f, z3, x, z, t)',
            '    addModulo(f, z3, z3, z3)',
            '    multiply(f, y3, curve.b, t2, t)',
            '    subtractModulo(f, y3, y3, z3)',
            '    addModulo(f, x3, y3, y3)',
            '    addModulo(f, y3, x3, y3)',
            '    subtractModulo(f, x3, t1, y3)',
            '    addModulo(f, y3, t1, y3)',
            '    multiply(f, y3, x3, y3, t)',
            '    multiply(f, x3, x3, t3, t)',
            '    addModulo(f, t3, t2, t2)',
            '    addModulo(f, t2, t2, t3)',
            '    multiply(f, z3, curve.b, z3, t)',
            '    subtractModulo(f, z3, z3, t2)',
            '    subtractModulo(f, z3, z3, t0)',
            '    addModulo(f, t3, z3, z3)',
            '    addModulo(f, z3, z3, t3)',
            '    addModulo(f, t3, t0, t0)',
            '    addModulo(f, t0, t3, t0)',
            '    subtractModulo(f, t0, t0, t2)',
            '    multiply(f, t0, t0, z3, t)',
            '    addModulo(f, y3, y3, t0)',
            '    multiply(f, t0, y, z, t)',
            '    addModulo(f, t0, t0, t0)',
            '    multiply(f, z3, t0, z3, t)',
            '    subtractModulo(f, x3, x3, z3)',
            '    multiply(f, z3, t0, t1, t)',
            '    addModulo(f, z3, z3, z3)',
            '    addModulo(f, z3, z3, z3)',
            '    memcpy(coordinate(out, 0, count), x3, count * 8)',
            '    memcpy(coordinate(out, 1, count), y3, count * 8)',
            '    memcpy(coordinate(out, 2, count), z3, count * 8)',
            '}',
            '',
            '// The point at infinity, (0 : 1 : 0), in the form of Montgomery.',
            'function setInfinity(curve: Curve, point: Address, t: Address) {',
            '    immut count = curve.field.count',
            '',
            '    for i in range(3 * count) {',
            '        write(point, i * 8, 0)',
            '    }',
            '',
            '    immut one = zeroNumber(count)',
            '    write(one, 0, 1)',
            '    toForm(curve.field, coordinate(point, 1, count), one, t)',
            '    free(one)',
            '}',
            '',
            '// out = scalar * point, the scalar the big-endian bytes at `scalar` (`size` of them): the same',
            '// steps for every scalar of that size.',
            'function multiplyPoint(curve: Curve, out: Address, scalar: Address, size: int, point: Address, t: Address) {',
            '    immut count = curve.field.count',
            '    immut result = newPoint(count)',
            '    immut sum = newPoint(count)',
            '    setInfinity(curve, result, t)',
            '',
            '    for i in range(size) {',
            '        immut b: byte = read(scalar, i)',
            '        mut bit = 7',
            '',
            '        while (bit >= 0) {',
            '            doublePoint(curve, result, result, t)',
            '            addPoints(curve, sum, result, point, t)',
            '            select(result, sum, result, 3 * count, (int(b) >> bit) & 1)',
            '            bit -= 1',
            '        }',
            '    }',
            '',
            '    memcpy(out, result, 3 * count * 8)',
            '    free(sum)',
            '    free(result)',
            '}',
            '',
            '// The affine coordinates (x = X / Z, y = Y / Z) of a point, out of the form of Montgomery, as bytes',
            '// at `x` and `y`: false for the point at infinity.',
            'function affine(curve: Curve, point: Address, x: Address, y: Address, t: Address): boolean {',
            '    immut f = curve.field',
            '    immut count = f.count',
            '    immut z = coordinate(point, 2, count)',
            '    immut zero = zeroNumber(count)',
            '',
            '    if (compare(z, zero, count) == 0) {',
            '        free(zero)',
            '        return false',
            '    }',
            '',
            '    free(zero)',
            '    immut inverse = zeroNumber(count)',
            '    invertModulo(f, inverse, z, t)',
            '    immut value = zeroNumber(count)',
            '    multiply(f, value, coordinate(point, 0, count), inverse, t)',
            '    fromForm(f, value, value, t)',
            '    toBytes(value, count, x, curve.size)',
            '    multiply(f, value, coordinate(point, 1, count), inverse, t)',
            '    fromForm(f, value, value, t)',
            '    toBytes(value, count, y, curve.size)',
            '    free(value)',
            '    free(inverse)',
            '    return true',
            '}',
            '',
            '// The point of the coordinates (big-endian bytes) when it is on the curve: y^2 = x^3 - 3x + b, both',
            '// below p. Into `point` (projective, Z = 1); false when it is not.',
            'function pointOf(curve: Curve, x: Address, y: Address, point: Address, t: Address): boolean {',
            '    immut f = curve.field',
            '    immut count = f.count',
            '    immut px = fromBytes(x, curve.size, count)',
            '    immut py = fromBytes(y, curve.size, count)',
            '',
            '    if (not belowModulus(f, px) or not belowModulus(f, py)) {',
            '        free(px)',
            '        free(py)',
            '        return false',
            '    }',
            '',
            '    toForm(f, px, px, t)',
            '    toForm(f, py, py, t)',
            '    immut left = zeroNumber(count)',
            '    immut right = zeroNumber(count)',
            '    multiply(f, left, py, py, t)',
            '    multiply(f, right, px, px, t)',
            '    multiply(f, right, right, px, t)',
            '    subtractModulo(f, right, right, px)',
            '    subtractModulo(f, right, right, px)',
            '    subtractModulo(f, right, right, px)',
            '    addModulo(f, right, right, curve.b)',
            '    immut on = compare(left, right, count) == 0',
            '    memcpy(coordinate(point, 0, count), px, count * 8)',
            '    memcpy(coordinate(point, 1, count), py, count * 8)',
            '    immut one = zeroNumber(count)',
            '    write(one, 0, 1)',
            '    toForm(f, coordinate(point, 2, count), one, t)',
            '',
            '    for each in [px, py, left, right, one] {',
            '        free(each)',
            '    }',
            '',
            '    return on',
            '}',
            '',
            'function generator(curve: Curve): Address {',
            '    immut count = curve.field.count',
            '    immut point = newPoint(count)',
            '    immut t = zeroNumber(count + 2)',
            '    memcpy(coordinate(point, 0, count), curve.gx, count * 8)',
            '    memcpy(coordinate(point, 1, count), curve.gy, count * 8)',
            '    immut one = zeroNumber(count)',
            '    write(one, 0, 1)',
            '    toForm(curve.field, coordinate(point, 2, count), one, t)',
            '    free(one)',
            '    free(t)',
            '    return point',
            '}',
            '',
            '// Diffie-Hellman: the public key of a secret scalar (`size` bytes, below n), its uncompressed point',
            '// (04, x, y: 1 + 2 size bytes) at `out`.',
            'export function publicKey(which: int, secret: Address, out: Address) {',
            '    immut curve = curveOf(which)',
            '    immut count = curve.field.count',
            '    immut t = zeroNumber(count + 2)',
            '    immut g = generator(curve)',
            '    immut point = newPoint(count)',
            '    multiplyPoint(curve, point, secret, curve.size, g, t)',
            '    write(out, 0, byte(4))',
            '    affine(curve, point, offset(out, 1), offset(out, 1 + curve.size), t)',
            '    free(point)',
            '    free(g)',
            '    free(t)',
            '}',
            '',
            '// Diffie-Hellman: the shared secret (the x of secret * their point, `size` bytes) at `out`, or false',
            '// when their point (uncompressed, 1 + 2 size bytes) is not on the curve.',
            'export function sharedSecret(which: int, secret: Address, theirs: Address, theirsSize: int, out: Address): boolean {',
            '    immut curve = curveOf(which)',
            '    immut count = curve.field.count',
            '',
            '    if (theirsSize != 1 + 2 * curve.size) { return false }',
            '',
            '    immut first: byte = read(theirs, 0)',
            '',
            '    if (first != 4) { return false }',
            '',
            '    immut t = zeroNumber(count + 2)',
            '    immut point = newPoint(count)',
            '    immut on = pointOf(curve, offset(theirs, 1), offset(theirs, 1 + curve.size), point, t)',
            '    mut good = on',
            '',
            '    if (on) {',
            '        multiplyPoint(curve, point, secret, curve.size, point, t)',
            '        immut y = allocate(curve.size)',
            '        good = affine(curve, point, out, y, t)',
            '        free(y)',
            '    }',
            '',
            '    free(point)',
            '    free(t)',
            '    return good',
            '}',
            '',
            '// Verifies an ECDSA signature (r, s: big-endian bytes of `size` each) of the digest of a message',
            '// (`digestSize` bytes) by the public key (uncompressed point): u1 = e / s, u2 = r / s modulo n, and',
            '// the x of u1 G + u2 Q modulo n must be r.',
            'export function verify(which: int, digest: Address, digestSize: int, r: Address, s: Address, key: Address, keySize: int): boolean {',
            '    immut curve = curveOf(which)',
            '    immut f = curve.field',
            '    immut n = curve.order',
            '    immut count = f.count',
            '',
            '    if (keySize != 1 + 2 * curve.size) { return false }',
            '',
            '    immut first: byte = read(key, 0)',
            '',
            '    if (first != 4) { return false }',
            '',
            '    immut t = zeroNumber(count + 2)',
            '    immut q = newPoint(count)',
            '    mut good = pointOf(curve, offset(key, 1), offset(key, 1 + curve.size), q, t)',
            '    immut rn = fromBytes(r, curve.size, count)',
            '    immut sn = fromBytes(s, curve.size, count)',
            '    immut zero = zeroNumber(count)',
            '',
            '    // 0 < r, s < n',
            '    if (compare(rn, zero, count) == 0 or compare(sn, zero, count) == 0 or not belowModulus(n, rn) or not belowModulus(n, sn)) { good = false }',
            '',
            '    if (good) {',
            '        // e: the leftmost bits of the digest, as many as n has, then below n.',
            '        immut taken = if (digestSize < curve.size) { digestSize } else { curve.size }',
            '        immut e = fromBytes(digest, taken, count)',
            '',
            '        if (not belowModulus(n, e)) { subtractInPlace(e, n.limbs, count) }',
            '',
            '        immut w = zeroNumber(count)',
            '        toForm(n, w, sn, t)',
            '        invertModulo(n, w, w, t)',
            '        immut u1 = zeroNumber(count)',
            '        immut u2 = zeroNumber(count)',
            '        toForm(n, u1, e, t)',
            '        multiply(n, u1, u1, w, t)',
            '        fromForm(n, u1, u1, t)',
            '        toForm(n, u2, rn, t)',
            '        multiply(n, u2, u2, w, t)',
            '        fromForm(n, u2, u2, t)',
            '        immut bytes1 = allocate(curve.size)',
            '        immut bytes2 = allocate(curve.size)',
            '        toBytes(u1, count, bytes1, curve.size)',
            '        toBytes(u2, count, bytes2, curve.size)',
            '        // u1 G + u2 Q in one pass (Shamir\'s trick: public numbers, no need of the same steps for',
            '        // every scalar): a doubling for each bit, and G, Q or G + Q added for the bits set.',
            '        immut g = generator(curve)',
            '        immut b = newPoint(count)',
            '        addPoints(curve, b, g, q, t)',
            '        immut a = newPoint(count)',
            '        setInfinity(curve, a, t)',
            '',
            '        for i in range(curve.size) {',
            '            immut first: byte = read(bytes1, i)',
            '            immut second: byte = read(bytes2, i)',
            '            mut bit = 7',
            '',
            '            while (bit >= 0) {',
            '                doublePoint(curve, a, a, t)',
            '                immut chosen = ((int(first) >> bit) & 1) + 2 * ((int(second) >> bit) & 1)',
            '',
            '                if (chosen == 1) { addPoints(curve, a, a, g, t) }',
            '',
            '                if (chosen == 2) { addPoints(curve, a, a, q, t) }',
            '',
            '                if (chosen == 3) { addPoints(curve, a, a, b, t) }',
            '',
            '                bit -= 1',
            '            }',
            '        }',
            '',
            '        immut x = allocate(curve.size)',
            '        immut y = allocate(curve.size)',
            '',
            '        if (affine(curve, a, x, y, t)) {',
            '            immut xn = fromBytes(x, curve.size, count)',
            '',
            '            if (not belowModulus(n, xn)) { subtractInPlace(xn, n.limbs, count) }',
            '',
            '            good = compare(xn, rn, count) == 0',
            '            free(xn)',
            '        } else {',
            '            good = false',
            '        }',
            '',
            '        for each in [e, w, u1, u2, bytes1, bytes2, g, a, b, x, y] {',
            '            free(each)',
            '        }',
            '    }',
            '',
            '    for each in [t, q, rn, sn, zero] {',
            '        free(each)',
            '    }',
            '',
            '    return good',
            '}',
            '',
            '// For C (the tests of the library).',
            '',
            'extern function koji_ecdh_public(which: CInt, secret: Address, out: Address) {',
            '    publicKey(which, secret, out)',
            '}',
            '',
            'extern function koji_ecdh_shared(which: CInt, secret: Address, theirs: Address, theirsSize: CSize, out: Address): boolean {',
            '    return sharedSecret(which, secret, theirs, theirsSize, out)',
            '}',
            '',
            'extern function koji_ecdsa_verify(which: CInt, digest: Address, digestSize: CSize, r: Address, s: Address, key: Address, keySize: CSize): boolean {',
            '    return verify(which, digest, digestSize, r, s, key, keySize)',
            '}',
        ].join('\n'))
    }

    if (name == 'koji:list') {
        return Some([
            '// `koji:list`: lists, in the library of the runtime written in Koji (C calls these functions by',
            '// their names). A list is a block of 6 words (runtime/prelude.h): its count of references, the type',
            '// of its items (a `KojiElementType`, whose functions retain, release, show, compare and hash an',
            '// item), the words of an item (1, or 2 for a decimal), the address of the items, their number, and',
            '// the words that the block of the items holds. Two variables share a list until one of them changes',
            '// it, which copies it first: a function that changes a list takes the variable that holds it.',
            '',
            'import { Address, CInt, CSize, Location, Never, U128, blankString, distance, lowWord, nullAddress, offset, panicAt, read, stringBytes, stringSize, wide, write } from \'koji:unsafe\'',
            'import { mixed } from \'koji:text\'',
            '',
            '// The blocks of the pool, and the functions of the type of the items (runtime/prelude.h).',
            'extern function koji_memory_take(words: int): Address',
            'extern function koji_memory_give(block: Address, words: int)',
            'extern function koji_memory_resize(block: Address, words: int, newWords: int): Address',
            'extern function koji_element_size(element: Address): int',
            'extern function koji_element_counted(element: Address): boolean',
            'extern function koji_element_retain(element: Address, slot: Address)',
            'extern function koji_element_release(element: Address, slot: Address)',
            'extern function koji_element_repr(element: Address, slot: Address): string',
            'extern function koji_element_equal(element: Address, a: Address, b: Address): boolean',
            'extern function koji_element_orderable(element: Address): boolean',
            'extern function koji_element_compare(element: Address, a: Address, b: Address): CInt',
            'extern function koji_element_hash(element: Address, slot: Address): int',
            'extern function koji_call_before(call: Address, comparison: Address, a: Address, b: Address): boolean',
            'extern function memcpy(target: Address, source: Address, size: CSize): Address',
            'extern function memmove(target: Address, source: Address, size: CSize): Address',
            '',
            '// The words of the block of a list.',
            'immut listWords = 6',
            '',
            'function elementOf(list: Address): Address {',
            '    immut element: Address = read(list, 8)',
            '    return element',
            '}',
            '',
            'function strideOf(list: Address): int {',
            '    immut stride: int = read(list, 16)',
            '    return stride',
            '}',
            '',
            'function itemsOf(list: Address): Address {',
            '    immut items: Address = read(list, 24)',
            '    return items',
            '}',
            '',
            'function lengthOf(list: Address): int {',
            '    immut length: int = read(list, 32)',
            '    return length',
            '}',
            '',
            'function capacityOf(list: Address): int {',
            '    immut capacity: int = read(list, 40)',
            '    return capacity',
            '}',
            '',
            '// The slot of the item at `index`.',
            'function slotOf(list: Address, index: int): Address {',
            '    return offset(itemsOf(list), index * strideOf(list) * 8)',
            '}',
            '',
            '// A new list without items, with room for `count` of them.',
            'export function newList(element: Address, count: int): Address {',
            '    immut stride = if (koji_element_size(element) > 8) { 2 } else { 1 }',
            '    immut list = koji_memory_take(listWords)',
            '    immut words = count * stride',
            '    write(list, 0, 1)',
            '    write(list, 8, element)',
            '    write(list, 16, stride)',
            '    // No block for no items: an address that is not 0, as Rust\'s empty vectors have.',
            '    write(list, 24, if (words > 0) { koji_memory_take(words) } else { offset(nullAddress(), 8) })',
            '    write(list, 32, 0)',
            '    write(list, 40, words)',
            '    return list',
            '}',
            '',
            '// Adds a reference to the items from `start` to `end`.',
            'function retainItems(list: Address, start: int, end: int) {',
            '    immut element = elementOf(list)',
            '',
            '    if (not koji_element_counted(element)) { return }',
            '',
            '    mut index = start',
            '',
            '    while (index < end) {',
            '        koji_element_retain(element, slotOf(list, index))',
            '        index += 1',
            '    }',
            '}',
            '',
            '// A new list with the items of `list`, each with a new reference.',
            'function copied(list: Address): Address {',
            '    immut length = lengthOf(list)',
            '    immut copy = newList(elementOf(list), length)',
            '    memcpy(itemsOf(copy), itemsOf(list), length * strideOf(list) * 8)',
            '    write(copy, 32, length)',
            '    retainItems(copy, 0, length)',
            '    return copy',
            '}',
            '',
            '// The list in `variable`, made its own (copied when another variable shares it).',
            'function unshared(variable: Address): Address {',
            '    immut list: Address = read(variable, 0)',
            '    immut references: int = read(list, 0)',
            '',
            '    if (references == 1) { return list }',
            '',
            '    immut copy = copied(list)',
            '    write(list, 0, references - 1)',
            '    write(variable, 0, copy)',
            '    return copy',
            '}',
            '',
            '// Room for `more` items: the block grows as Rust\'s vectors grow (twice as large, 4 words at least).',
            'function makeRoom(list: Address, more: int) {',
            '    immut needed = (lengthOf(list) + more) * strideOf(list)',
            '    immut capacity = capacityOf(list)',
            '',
            '    if (needed <= capacity) { return }',
            '',
            '    mut grown = capacity * 2',
            '',
            '    if (grown < needed) { grown = needed }',
            '',
            '    if (grown < 4) { grown = 4 }',
            '',
            '    write(list, 24, if (capacity == 0) { koji_memory_take(grown) } else { koji_memory_resize(itemsOf(list), capacity, grown) })',
            '    write(list, 40, grown)',
            '}',
            '',
            '// Puts the item of the generated code at `value` (its bytes, the rest of the slot 0) in `slot`.',
            'function putItem(slot: Address, value: Address, element: Address, stride: int) {',
            '    immut size = koji_element_size(element)',
            '',
            '    if (size == 8) {',
            '        immut word: int = read(value, 0)',
            '        write(slot, 0, word)',
            '        return',
            '    }',
            '',
            '    write(slot, 0, 0)',
            '',
            '    if (stride == 2) { write(slot, 8, 0) }',
            '',
            '    memcpy(slot, value, size)',
            '}',
            '',
            '// The position of `index` in a list of `length` items (`end`: the position after the last one',
            '// too), or a panic.',
            'function position(index: int, length: int, end: boolean, here: Location): int {',
            '    if (index >= 0 and (index < length or (end and index == length))) { return index }',
            '',
            '    panicAt(here, `index ${index} out of range (length ${length})`)',
            '}',
            '',
            'extern function koji_list_new(element: Address, capacity: CSize): Address {',
            '    return newList(element, capacity)',
            '}',
            '',
            '// Releases the items of a list without references and frees it.',
            'extern function koji_list_free(list: Address) {',
            '    immut element = elementOf(list)',
            '    immut length = lengthOf(list)',
            '',
            '    if (koji_element_counted(element)) {',
            '        mut index = 0',
            '',
            '        while (index < length) {',
            '            koji_element_release(element, slotOf(list, index))',
            '            index += 1',
            '        }',
            '    }',
            '',
            '    immut capacity = capacityOf(list)',
            '',
            '    if (capacity > 0) { koji_memory_give(itemsOf(list), capacity) }',
            '',
            '    koji_memory_give(list, listWords)',
            '}',
            '',
            '// The panic of an index out of range (`koji_list_get` of the prelude).',
            'extern function koji_list_index_panic(index: int, length: int, here: Location): Never {',
            '    panicAt(here, `index ${index} out of range (length ${length})`)',
            '}',
            '',
            '// The slot of the item at `index`, to change it (`grid[0][1] = 5` changes the item of `grid[0]`',
            '// in place).',
            'extern function koji_list_slot(variable: Address, index: int, here: Location): Address {',
            '    immut list = unshared(variable)',
            '    return slotOf(list, position(index, lengthOf(list), false, here))',
            '}',
            '',
            '// `items[index] = value`.',
            'extern function koji_list_set(variable: Address, index: int, value: Address, here: Location) {',
            '    immut list = unshared(variable)',
            '    immut slot = slotOf(list, position(index, lengthOf(list), false, here))',
            '    immut element = elementOf(list)',
            '    koji_element_release(element, slot)',
            '    putItem(slot, value, element, strideOf(list))',
            '    koji_element_retain(element, slot)',
            '}',
            '',
            '// `items.push(value)`.',
            'extern function koji_list_push(variable: Address, value: Address) {',
            '    immut list = unshared(variable)',
            '    makeRoom(list, 1)',
            '    immut length = lengthOf(list)',
            '    immut slot = slotOf(list, length)',
            '    immut element = elementOf(list)',
            '    putItem(slot, value, element, strideOf(list))',
            '    write(list, 32, length + 1)',
            '    koji_element_retain(element, slot)',
            '}',
            '',
            '// Room for `more` items in a list that is not shared (`reserve` of `koji:unsafe`).',
            'extern function koji_list_reserve(list: Address, more: int) {',
            '    immut references: int = read(list, 0)',
            '',
            '    if (references == 1 and more > 0) { makeRoom(list, more) }',
            '}',
            '',
            '// `items.insert(index, value)`.',
            'extern function koji_list_insert(variable: Address, index: int, value: Address, here: Location) {',
            '    immut list = unshared(variable)',
            '    immut length = lengthOf(list)',
            '    immut at = position(index, length, true, here)',
            '    makeRoom(list, 1)',
            '    immut stride = strideOf(list)',
            '    immut slot = slotOf(list, at)',
            '    memmove(offset(slot, stride * 8), slot, (length - at) * stride * 8)',
            '    immut element = elementOf(list)',
            '    putItem(slot, value, element, stride)',
            '    write(list, 32, length + 1)',
            '    koji_element_retain(element, slot)',
            '}',
            '',
            '// `items.sort()`: a stable sort of orderable items (merges of runs that double, through a block',
            '// as large as the items).',
            'extern function koji_list_sort(variable: Address) {',
            '    immut list = unshared(variable)',
            '    immut element = elementOf(list)',
            '    immut length = lengthOf(list)',
            '',
            '    if (not koji_element_orderable(element) or length < 2) { return }',
            '',
            '    immut size = strideOf(list) * 8',
            '    immut words = length * strideOf(list)',
            '    immut other = koji_memory_take(words)',
            '    mut source = itemsOf(list)',
            '    mut target = other',
            '    mut width = 1',
            '',
            '    while (width < length) {',
            '        mut start = 0',
            '',
            '        while (start < length) {',
            '            immut middle = minOf(start + width, length)',
            '            immut end = minOf(start + 2 * width, length)',
            '            mut left = start',
            '            mut right = middle',
            '            mut at = start',
            '',
            '            while (at < end) {',
            '                // From the right only when it goes strictly before: equal items keep their order.',
            '                immut fromRight = left >= middle or (right < end and koji_element_compare(element, offset(source, right * size), offset(source, left * size)) < 0)',
            '                immut taken = if (fromRight) { right } else { left }',
            '                memcpy(offset(target, at * size), offset(source, taken * size), size)',
            '',
            '                if (fromRight) {',
            '                    right += 1',
            '                } else {',
            '                    left += 1',
            '                }',
            '',
            '                at += 1',
            '            }',
            '',
            '            start = end',
            '        }',
            '',
            '        immut swapped = source',
            '        source = target',
            '        target = swapped',
            '        width = width * 2',
            '    }',
            '',
            '    // The items in the block of the list, and the other given back.',
            '    if (distance(source, itemsOf(list)) != 0) { memcpy(itemsOf(list), source, length * size) }',
            '',
            '    koji_memory_give(other, words)',
            '}',
            '',
            'function minOf(a: int, b: int): int {',
            '    return if (a < b) { a } else { b }',
            '}',
            '',
            '// `a + b`: a new list.',
            'extern function koji_list_concat(a: Address, b: Address): Address {',
            '    immut lengthA = lengthOf(a)',
            '    immut lengthB = lengthOf(b)',
            '    immut size = strideOf(a) * 8',
            '    immut joined = newList(elementOf(a), lengthA + lengthB)',
            '    memcpy(itemsOf(joined), itemsOf(a), lengthA * size)',
            '    memcpy(offset(itemsOf(joined), lengthA * size), itemsOf(b), lengthB * size)',
            '    write(joined, 32, lengthA + lengthB)',
            '    retainItems(joined, 0, lengthA + lengthB)',
            '    return joined',
            '}',
            '',
            '// `items[start..end]`, where a missing bound is the start or the end of the list.',
            'extern function koji_list_slice(list: Address, hasStart: boolean, start: int, hasEnd: boolean, end: int, here: Location): Address {',
            '    immut length = lengthOf(list)',
            '    immut first = if (hasStart) { start } else { 0 }',
            '    immut last = if (hasEnd) { end } else { length }',
            '',
            '    if (first < 0 or last > length or first > last) { panicAt(here, `slice ${first}..${last} out of range (length ${length})`) }',
            '',
            '    immut count = last - first',
            '    immut part = newList(elementOf(list), count)',
            '    memcpy(itemsOf(part), slotOf(list, first), count * strideOf(list) * 8)',
            '    write(part, 32, count)',
            '    retainItems(part, 0, count)',
            '    return part',
            '}',
            '',
            'extern function koji_list_equal(a: Address, b: Address): boolean {',
            '    if (distance(a, b) == 0) { return true }',
            '',
            '    immut length = lengthOf(a)',
            '',
            '    if (lengthOf(b) != length) { return false }',
            '',
            '    immut element = elementOf(a)',
            '    mut index = 0',
            '',
            '    while (index < length) {',
            '        if (not koji_element_equal(element, slotOf(a, index), slotOf(b, index))) { return false }',
            '',
            '        index += 1',
            '    }',
            '',
            '    return true',
            '}',
            '',
            '// `value in items`.',
            'extern function koji_list_contains(list: Address, value: Address): boolean {',
            '    return koji_list_index_of(list, value) >= 0',
            '}',
            '',
            '// `items.indexOf(value)`: the position of the first equal item, or -1.',
            'extern function koji_list_index_of(list: Address, value: Address): int {',
            '    immut element = elementOf(list)',
            '    immut length = lengthOf(list)',
            '    mut index = 0',
            '',
            '    while (index < length) {',
            '        if (koji_element_equal(element, slotOf(list, index), value)) { return index }',
            '',
            '        index += 1',
            '    }',
            '',
            '    return -1',
            '}',
            '',
            '// The list as written in code: `[1, 2, 3]`, `[\'a\', \'b\']`.',
            'extern function koji_list_repr(list: Address): string {',
            '    immut element = elementOf(list)',
            '    immut length = lengthOf(list)',
            '    mut text = \'[\'',
            '    mut index = 0',
            '',
            '    while (index < length) {',
            '        if (index > 0) { text += \', \' }',
            '',
            '        text += koji_element_repr(element, slotOf(list, index))',
            '        index += 1',
            '    }',
            '',
            '    return text + \']\'',
            '}',
            '',
            '// `items.join(separator)`, for a list of strings: their size first, then their bytes. A slot holds',
            '// the address of a string, whose size is its second word and whose bytes follow its third',
            '// (runtime/prelude.h); the list keeps them alive.',
            'extern function koji_list_join(list: Address, separator: string): string {',
            '    immut length = lengthOf(list)',
            '    immut gap = stringSize(separator)',
            '    mut total = if (length > 0) { gap * (length - 1) } else { 0 }',
            '    mut index = 0',
            '',
            '    while (index < length) {',
            '        immut text: Address = read(slotOf(list, index), 0)',
            '        immut size: int = read(text, 8)',
            '        total += size',
            '        index += 1',
            '    }',
            '',
            '    immut joined = blankString(total, total)',
            '    immut bytes = stringBytes(joined)',
            '    mut at = 0',
            '    index = 0',
            '',
            '    while (index < length) {',
            '        if (index > 0) {',
            '            memcpy(offset(bytes, at), stringBytes(separator), gap)',
            '            at += gap',
            '        }',
            '',
            '        immut text: Address = read(slotOf(list, index), 0)',
            '        immut size: int = read(text, 8)',
            '        memcpy(offset(bytes, at), offset(text, 24), size)',
            '        at += size',
            '        index += 1',
            '    }',
            '',
            '    return joined',
            '}',
            '',
            '// `items.pop()`: copies the last item to `out` (the caller now holds its reference), or false for',
            '// an empty list.',
            'extern function koji_list_pop(variable: Address, out: Address): boolean {',
            '    immut list = unshared(variable)',
            '    immut length = lengthOf(list)',
            '',
            '    if (length == 0) { return false }',
            '',
            '    memcpy(out, slotOf(list, length - 1), koji_element_size(elementOf(list)))',
            '    write(list, 32, length - 1)',
            '    return true',
            '}',
            '',
            '// `items.removeAt(index)`: as `pop`, for the item at `index`; false when `index` is out of range.',
            'extern function koji_list_remove(variable: Address, index: int, out: Address): boolean {',
            '    immut list = unshared(variable)',
            '    immut length = lengthOf(list)',
            '',
            '    if (index < 0 or index >= length) { return false }',
            '',
            '    immut stride = strideOf(list)',
            '    immut slot = slotOf(list, index)',
            '    memcpy(out, slot, koji_element_size(elementOf(list)))',
            '    memmove(slot, offset(slot, stride * 8), (length - index - 1) * stride * 8)',
            '    write(list, 32, length - 1)',
            '    return true',
            '}',
            '',
            '// A hash of the items, in order.',
            'extern function koji_list_hash(list: Address): int {',
            '    immut element = elementOf(list)',
            '    immut length = lengthOf(list)',
            '    mut hash: U128 = 0',
            '    mut index = 0',
            '',
            '    while (index < length) {',
            '        hash = mixed(hash, wide(koji_element_hash(element, slotOf(list, index)), 0))',
            '        index += 1',
            '    }',
            '',
            '    return lowWord(hash)',
            '}',
            '',
            '// `items.sortBy(comparison)`: a stable merge sort, where `call(comparison, a, b)` says whether `a`',
            '// goes before `b`. The halves and the calls of the comparison are those of the runtime in Rust (a',
            '// comparison may print): the first half of a part has its floor half, and an item of the right',
            '// half goes first only when it goes strictly before.',
            'extern function koji_list_sort_by(variable: Address, comparison: Address, call: Address) {',
            '    immut list = unshared(variable)',
            '    immut length = lengthOf(list)',
            '',
            '    if (length < 2) { return }',
            '',
            '    // The positions of the items, sorted, then the items in their order.',
            '    immut order = koji_memory_take(length)',
            '    immut spare = koji_memory_take(length)',
            '',
            '    for i in range(length) {',
            '        write(order, i * 8, i)',
            '    }',
            '',
            '    mergeSort(list, order, spare, 0, length, comparison, call)',
            '    immut size = strideOf(list) * 8',
            '    immut words = length * strideOf(list)',
            '    immut sorted = koji_memory_take(words)',
            '',
            '    for i in range(length) {',
            '        immut position: int = read(order, i * 8)',
            '        memcpy(offset(sorted, i * size), slotOf(list, position), size)',
            '    }',
            '',
            '    koji_memory_give(itemsOf(list), capacityOf(list))',
            '    write(list, 24, sorted)',
            '    write(list, 40, words)',
            '    koji_memory_give(order, length)',
            '    koji_memory_give(spare, length)',
            '}',
            '',
            '// Sorts the positions from `start` to `end` of `order`, through `spare`.',
            'function mergeSort(list: Address, order: Address, spare: Address, start: int, end: int, comparison: Address, call: Address) {',
            '    if (end - start <= 1) { return }',
            '',
            '    immut middle = start + (end - start) / 2',
            '    mergeSort(list, order, spare, start, middle, comparison, call)',
            '    mergeSort(list, order, spare, middle, end, comparison, call)',
            '    mut left = start',
            '    mut right = middle',
            '    mut at = start',
            '',
            '    while (left < middle and right < end) {',
            '        immut a: int = read(order, left * 8)',
            '        immut b: int = read(order, right * 8)',
            '',
            '        if (koji_call_before(call, comparison, slotOf(list, b), slotOf(list, a))) {',
            '            write(spare, at * 8, b)',
            '            right += 1',
            '        } else {',
            '            write(spare, at * 8, a)',
            '            left += 1',
            '        }',
            '',
            '        at += 1',
            '    }',
            '',
            '    while (left < middle) {',
            '        immut a: int = read(order, left * 8)',
            '        write(spare, at * 8, a)',
            '        left += 1',
            '        at += 1',
            '    }',
            '',
            '    while (right < end) {',
            '        immut b: int = read(order, right * 8)',
            '        write(spare, at * 8, b)',
            '        right += 1',
            '        at += 1',
            '    }',
            '',
            '    memcpy(offset(order, start * 8), offset(spare, start * 8), (end - start) * 8)',
            '}',
        ].join('\n'))
    }

    if (name == 'koji:map') {
        return Some([
            '// `koji:map`: maps and sets, in the library of the runtime written in Koji (C calls these functions',
            '// by their names). The entries keep the order in which their keys were added, and a table of',
            '// positions finds a key by its hash (open addressing, at most half full); a set is a map without',
            '// values. Like lists, two variables share a map until one of them changes it.',
            '//',
            '// A map is a block of 9 words: its count of references (first, as the prelude counts them), the',
            '// types of its keys and of its values (none for a set), the address of its entries, their number',
            '// (fifth, as the prelude reads it), the entries the block holds, the address of the table, the',
            '// slots it has (a power of two, or none) and 64 less their bits (the shift of `startOf`). An entry is 5 words: the key and the value in two words',
            '// each (a decimal takes both), and the hash of the key, so that the table is built again without',
            '// hashing the keys. A slot of the table is the position of an entry plus one, or 0 for none.',
            '',
            'import { Address, CInt, CSize, Location, Never, U128, distance, isNull, lowWord, nullAddress, offset, panicAt, read, wide, wordProduct, write } from \'koji:unsafe\'',
            'import { newList } from \'koji:list\'',
            '',
            'extern function koji_memory_take(words: int): Address',
            'extern function koji_memory_give(block: Address, words: int)',
            'extern function koji_memory_resize(block: Address, words: int, newWords: int): Address',
            'extern function koji_element_size(element: Address): int',
            'extern function koji_element_counted(element: Address): boolean',
            'extern function koji_element_retain(element: Address, slot: Address)',
            'extern function koji_element_release(element: Address, slot: Address)',
            'extern function koji_element_repr(element: Address, slot: Address): string',
            'extern function koji_element_equal(element: Address, a: Address, b: Address): boolean',
            'extern function koji_element_hash(element: Address, slot: Address): int',
            'extern function memcpy(target: Address, source: Address, size: CSize): Address',
            'extern function memmove(target: Address, source: Address, size: CSize): Address',
            'extern function memset(target: Address, value: CInt, size: CSize): Address',
            '',
            'immut mapWords = 9',
            'immut entryWords = 5',
            '// A large odd number: the high bits of a hash times it depend on all the bits of the hash (an int',
            '// is its own hash).',
            '// (0x9E3779B97F4A7C15, written as the int of the same bits.)',
            'immut spread = -0x61C8864680B583EB',
            '',
            'function keyType(map: Address): Address {',
            '    immut element: Address = read(map, 8)',
            '    return element',
            '}',
            '',
            'function valueType(map: Address): Address {',
            '    immut element: Address = read(map, 16)',
            '    return element',
            '}',
            '',
            'function entriesOf(map: Address): Address {',
            '    immut entries: Address = read(map, 24)',
            '    return entries',
            '}',
            '',
            'function countOf(map: Address): int {',
            '    immut count: int = read(map, 32)',
            '    return count',
            '}',
            '',
            'function tableOf(map: Address): Address {',
            '    immut table: Address = read(map, 48)',
            '    return table',
            '}',
            '',
            'function slotsOf(map: Address): int {',
            '    immut slots: int = read(map, 56)',
            '    return slots',
            '}',
            '',
            '// The key of the entry `index`; its value is 16 bytes further, and its hash 32.',
            'function entryAt(map: Address, index: int): Address {',
            '    return offset(entriesOf(map), index * entryWords * 8)',
            '}',
            '',
            'function hashAt(map: Address, index: int): int {',
            '    immut hash: int = read(entryAt(map, index), 32)',
            '    return hash',
            '}',
            '',
            'function newMap(key: Address, value: Address): Address {',
            '    immut map = koji_memory_take(mapWords)',
            '    write(map, 0, 1)',
            '    write(map, 8, key)',
            '    write(map, 16, value)',
            '    write(map, 24, nullAddress())',
            '    write(map, 32, 0)',
            '    write(map, 40, 0)',
            '    write(map, 48, nullAddress())',
            '    write(map, 56, 0)',
            '    write(map, 64, 0)',
            '    return map',
            '}',
            '',
            '// Adds a reference to the key and the value of an entry.',
            'function retainEntry(map: Address, index: int) {',
            '    immut entry = entryAt(map, index)',
            '    koji_element_retain(keyType(map), entry)',
            '',
            '    if (not isNull(valueType(map))) { koji_element_retain(valueType(map), offset(entry, 16)) }',
            '}',
            '',
            'function releaseEntry(map: Address, index: int) {',
            '    immut entry = entryAt(map, index)',
            '    koji_element_release(keyType(map), entry)',
            '',
            '    if (not isNull(valueType(map))) { koji_element_release(valueType(map), offset(entry, 16)) }',
            '}',
            '',
            '// A copy of `block` (`words` of them), or none.',
            'function copyBlock(block: Address, words: int): Address {',
            '    if (words == 0) { return nullAddress() }',
            '',
            '    immut copy = koji_memory_take(words)',
            '    memcpy(copy, block, words * 8)',
            '    return copy',
            '}',
            '',
            '// The map in `variable`, made its own (copied when another variable shares it).',
            'function unshared(variable: Address): Address {',
            '    immut map: Address = read(variable, 0)',
            '    immut references: int = read(map, 0)',
            '',
            '    if (references == 1) { return map }',
            '',
            '    immut count = countOf(map)',
            '    immut copy = newMap(keyType(map), valueType(map))',
            '    write(copy, 24, copyBlock(entriesOf(map), count * entryWords))',
            '    write(copy, 32, count)',
            '    write(copy, 40, count)',
            '    write(copy, 48, copyBlock(tableOf(map), slotsOf(map)))',
            '    write(copy, 56, slotsOf(map))',
            '    write(copy, 64, shiftOf(map))',
            '    mut index = 0',
            '',
            '    while (index < count) {',
            '        retainEntry(copy, index)',
            '        index += 1',
            '    }',
            '',
            '    write(map, 0, references - 1)',
            '    write(variable, 0, copy)',
            '    return copy',
            '}',
            '',
            'function shiftOf(map: Address): int {',
            '    immut shift: int = read(map, 64)',
            '    return shift',
            '}',
            '',
            '// The first slot of the table to look at for `hash`: the high bits of the hash times `spread`.',
            'function startOf(hash: int, shift: int, slots: int): int {',
            '    immut product = lowWord(wordProduct(wide(hash, 0), wide(spread, 0)))',
            '    return (product >> shift) & (slots - 1)',
            '}',
            '',
            '// The position of the entry of `key`, or -1.',
            'function find(map: Address, key: Address, hash: int): int {',
            '    immut slots = slotsOf(map)',
            '',
            '    if (slots == 0) { return -1 }',
            '',
            '    immut table = tableOf(map)',
            '    immut element = keyType(map)',
            '    immut entries = entriesOf(map)',
            '    mut slot = startOf(hash, shiftOf(map), slots)',
            '',
            '    while (true) {',
            '        immut position: int = read(table, slot * 8)',
            '',
            '        if (position == 0) { return -1 }',
            '',
            '        immut entry = offset(entries, (position - 1) * entryWords * 8)',
            '        immut found: int = read(entry, 32)',
            '',
            '        if (found == hash and koji_element_equal(element, entry, key)) { return position - 1 }',
            '',
            '        slot = (slot + 1) & (slots - 1)',
            '    }',
            '',
            '    return -1',
            '}',
            '',
            'function positionOf(map: Address, key: Address): int {',
            '    return find(map, key, koji_element_hash(keyType(map), key))',
            '}',
            '',
            '// Puts the entry `index` in the table, which has room for it.',
            'function place(map: Address, index: int) {',
            '    immut slots = slotsOf(map)',
            '    immut table = tableOf(map)',
            '    mut slot = startOf(hashAt(map, index), shiftOf(map), slots)',
            '',
            '    while (true) {',
            '        immut position: int = read(table, slot * 8)',
            '',
            '        if (position == 0) { break }',
            '',
            '        slot = (slot + 1) & (slots - 1)',
            '    }',
            '',
            '    write(table, slot * 8, index + 1)',
            '}',
            '',
            '// The table again, at least twice as large as the entries (8 slots at least).',
            'function rebuild(map: Address) {',
            '    immut count = countOf(map)',
            '    mut slots = 8',
            '    mut shift = 61',
            '',
            '    while (slots < count * 2) {',
            '        slots = slots * 2',
            '        shift -= 1',
            '    }',
            '',
            '    // The same block when it has the same size (after a removal).',
            '    mut table = tableOf(map)',
            '',
            '    if (slotsOf(map) != slots) {',
            '        if (slotsOf(map) > 0) { koji_memory_give(table, slotsOf(map)) }',
            '',
            '        table = koji_memory_take(slots)',
            '    }',
            '',
            '    memset(table, 0, slots * 8)',
            '    write(map, 48, table)',
            '    write(map, 56, slots)',
            '    write(map, 64, shift)',
            '    immut entries = entriesOf(map)',
            '    immut mask = slots - 1',
            '    mut index = 0',
            '',
            '    while (index < count) {',
            '        immut hash: int = read(entries, index * (entryWords * 8) + 32)',
            '        mut slot = startOf(hash, shift, slots)',
            '',
            '        while (true) {',
            '            immut position: int = read(table, slot * 8)',
            '',
            '            if (position == 0) { break }',
            '',
            '            slot = (slot + 1) & mask',
            '        }',
            '',
            '        write(table, slot * 8, index + 1)',
            '        index += 1',
            '    }',
            '}',
            '',
            '// Puts a value of the generated code at `value` (its bytes, the rest of the two words 0) at',
            '// `slot`.',
            'function putValue(slot: Address, value: Address, element: Address) {',
            '    write(slot, 0, 0)',
            '    write(slot, 8, 0)',
            '    memcpy(slot, value, koji_element_size(element))',
            '}',
            '',
            '// Adds an entry, whose key is not in the map (the entries grow as Rust\'s vectors grow).',
            'function add(map: Address, key: Address, value: Address, hash: int) {',
            '    immut count = countOf(map)',
            '    immut capacity: int = read(map, 40)',
            '',
            '    if (count == capacity) {',
            '        immut grown = if (capacity == 0) { 4 } else { capacity * 2 }',
            '        write(map, 24, if (capacity == 0) { koji_memory_take(grown * entryWords) } else { koji_memory_resize(entriesOf(map), capacity * entryWords, grown * entryWords) })',
            '        write(map, 40, grown)',
            '    }',
            '',
            '    immut entry = entryAt(map, count)',
            '    putValue(entry, key, keyType(map))',
            '',
            '    if (isNull(valueType(map))) {',
            '        write(entry, 16, 0)',
            '        write(entry, 24, 0)',
            '    } else {',
            '        putValue(offset(entry, 16), value, valueType(map))',
            '    }',
            '',
            '    write(entry, 32, hash)',
            '    write(map, 32, count + 1)',
            '',
            '    if ((count + 1) * 2 > slotsOf(map)) {',
            '        rebuild(map)',
            '    } else {',
            '        place(map, count)',
            '    }',
            '',
            '    retainEntry(map, count)',
            '}',
            '',
            'function missing(map: Address, key: Address, here: Location): Never {',
            '    panicAt(here, `key ${koji_element_repr(keyType(map), key)} not found`)',
            '}',
            '',
            '// A new empty map (`value` is none for a set).',
            'extern function koji_map_new(key: Address, value: Address): Address {',
            '    return newMap(key, value)',
            '}',
            '',
            '// Releases the entries of a map without references and frees it.',
            'extern function koji_map_free(map: Address) {',
            '    immut count = countOf(map)',
            '    mut index = 0',
            '',
            '    if (koji_element_counted(keyType(map)) or (not isNull(valueType(map)) and koji_element_counted(valueType(map)))) {',
            '        while (index < count) {',
            '            releaseEntry(map, index)',
            '            index += 1',
            '        }',
            '    }',
            '',
            '    immut capacity: int = read(map, 40)',
            '',
            '    if (capacity > 0) { koji_memory_give(entriesOf(map), capacity * entryWords) }',
            '',
            '    if (slotsOf(map) > 0) { koji_memory_give(tableOf(map), slotsOf(map)) }',
            '',
            '    koji_memory_give(map, mapWords)',
            '}',
            '',
            '// `map[key]`: the slot of the value (a panic when the key is missing).',
            'extern function koji_map_get(map: Address, key: Address, here: Location): Address {',
            '    immut index = positionOf(map, key)',
            '',
            '    if (index < 0) { missing(map, key, here) }',
            '',
            '    return offset(entryAt(map, index), 16)',
            '}',
            '',
            '// The slot of the value of `key`, or none (`map.get(key)`).',
            'extern function koji_map_find(map: Address, key: Address): Address {',
            '    immut index = positionOf(map, key)',
            '',
            '    if (index < 0) { return nullAddress() }',
            '',
            '    return offset(entryAt(map, index), 16)',
            '}',
            '',
            '// `key in map`, `set.has(item)`.',
            'extern function koji_map_contains(map: Address, key: Address): boolean {',
            '    return positionOf(map, key) >= 0',
            '}',
            '',
            '// The slot of the value of `key`, to change it in place (`groups[\'a\'].push(1)`).',
            'extern function koji_map_slot(variable: Address, key: Address, here: Location): Address {',
            '    immut map = unshared(variable)',
            '    immut index = positionOf(map, key)',
            '',
            '    if (index < 0) { missing(map, key, here) }',
            '',
            '    return offset(entryAt(map, index), 16)',
            '}',
            '',
            '// `map[key] = value` (adds or replaces), or `set.add(item)` with no value.',
            'extern function koji_map_set(variable: Address, key: Address, value: Address) {',
            '    immut map = unshared(variable)',
            '    immut hash = koji_element_hash(keyType(map), key)',
            '    immut index = find(map, key, hash)',
            '',
            '    if (index < 0) {',
            '        add(map, key, value, hash)',
            '        return',
            '    }',
            '',
            '    immut element = valueType(map)',
            '',
            '    if (isNull(element)) { return }',
            '',
            '    immut slot = offset(entryAt(map, index), 16)',
            '    koji_element_release(element, slot)',
            '    putValue(slot, value, element)',
            '    koji_element_retain(element, slot)',
            '}',
            '',
            '// `map.remove(key)`: copies the value to `out` (the caller now holds it), or false when the key is',
            '// missing. For a set, `out` is ignored.',
            'extern function koji_map_remove(variable: Address, key: Address, out: Address): boolean {',
            '    immut map = unshared(variable)',
            '    immut index = positionOf(map, key)',
            '',
            '    if (index < 0) { return false }',
            '',
            '    immut entry = entryAt(map, index)',
            '    koji_element_release(keyType(map), entry)',
            '',
            '    if (not isNull(valueType(map))) { memcpy(out, offset(entry, 16), koji_element_size(valueType(map))) }',
            '',
            '    immut count = countOf(map)',
            '    unplace(map, index)',
            '    memmove(entry, offset(entry, entryWords * 8), (count - index - 1) * entryWords * 8)',
            '    write(map, 32, count - 1)',
            '    return true',
            '}',
            '',
            '// Takes the entry `index` out of the table: the entries after it in its run move back so that a',
            '// search finds them (linear probing), and the positions after `index` come down by one, as the',
            '// entries do.',
            'function unplace(map: Address, index: int) {',
            '    immut slots = slotsOf(map)',
            '    immut table = tableOf(map)',
            '    immut shift = shiftOf(map)',
            '    immut mask = slots - 1',
            '    immut entries = entriesOf(map)',
            '    mut hole = startOf(hashAt(map, index), shift, slots)',
            '',
            '    while (true) {',
            '        immut position: int = read(table, hole * 8)',
            '',
            '        if (position == index + 1) { break }',
            '',
            '        hole = (hole + 1) & mask',
            '    }',
            '',
            '    mut next = (hole + 1) & mask',
            '',
            '    while (true) {',
            '        immut position: int = read(table, next * 8)',
            '',
            '        if (position == 0) { break }',
            '',
            '        immut hash: int = read(entries, (position - 1) * (entryWords * 8) + 32)',
            '        immut home = startOf(hash, shift, slots)',
            '',
            '        // It may fill the hole when the hole is between its first slot and where it is.',
            '        if (((next - home) & mask) >= ((next - hole) & mask)) {',
            '            write(table, hole * 8, position)',
            '            hole = next',
            '        }',
            '',
            '        next = (next + 1) & mask',
            '    }',
            '',
            '    write(table, hole * 8, 0)',
            '    mut slot = 0',
            '',
            '    while (slot < slots) {',
            '        immut position: int = read(table, slot * 8)',
            '',
            '        if (position > index + 1) { write(table, slot * 8, position - 1) }',
            '',
            '        slot += 1',
            '    }',
            '}',
            '',
            '// The keys (`map.keys()`, the items of a set), or the values (`map.values()`), in the order their',
            '// keys were added.',
            'function column(map: Address, values: boolean): Address {',
            '    immut element = if (values) { valueType(map) } else { keyType(map) }',
            '    immut count = countOf(map)',
            '    immut list = newList(element, count)',
            '    immut stride: int = read(list, 16)',
            '    immut items: Address = read(list, 24)',
            '    mut index = 0',
            '',
            '    while (index < count) {',
            '        immut slot = offset(items, index * stride * 8)',
            '        memcpy(slot, offset(entryAt(map, index), if (values) { 16 } else { 0 }), stride * 8)',
            '        koji_element_retain(element, slot)',
            '        index += 1',
            '    }',
            '',
            '    write(list, 32, count)',
            '    return list',
            '}',
            '',
            'extern function koji_map_keys(map: Address): Address {',
            '    return column(map, false)',
            '}',
            '',
            'extern function koji_map_values(map: Address): Address {',
            '    return column(map, true)',
            '}',
            '',
            '// `Set.from(list)`.',
            'extern function koji_set_from_list(list: Address): Address {',
            '    immut element: Address = read(list, 8)',
            '    immut stride: int = read(list, 16)',
            '    immut items: Address = read(list, 24)',
            '    immut length: int = read(list, 32)',
            '    immut set = newMap(element, nullAddress())',
            '    // The variable that holds the set, which `koji_map_set` takes.',
            '    immut variable = koji_memory_take(1)',
            '    write(variable, 0, set)',
            '    mut index = 0',
            '',
            '    while (index < length) {',
            '        koji_map_set(variable, offset(items, index * stride * 8), nullAddress())',
            '        index += 1',
            '    }',
            '',
            '    immut made: Address = read(variable, 0)',
            '    koji_memory_give(variable, 1)',
            '    return made',
            '}',
            '',
            '// Maps with the same entries, in any order.',
            'extern function koji_map_equal(a: Address, b: Address): boolean {',
            '    if (distance(a, b) == 0) { return true }',
            '',
            '    immut count = countOf(a)',
            '',
            '    if (countOf(b) != count) { return false }',
            '',
            '    immut element = valueType(a)',
            '    mut index = 0',
            '',
            '    while (index < count) {',
            '        immut entry = entryAt(a, index)',
            '        immut other = positionOf(b, entry)',
            '',
            '        if (other < 0) { return false }',
            '',
            '        if (not isNull(element) and not koji_element_equal(element, offset(entry, 16), offset(entryAt(b, other), 16))) { return false }',
            '',
            '        index += 1',
            '    }',
            '',
            '    return true',
            '}',
            '',
            '// A hash that does not depend on the order of the entries: the sum of the hashes of the keys times',
            '// 31 plus the hashes of the values, in 64 bits.',
            'extern function koji_map_hash(map: Address): int {',
            '    immut count = countOf(map)',
            '    immut element = valueType(map)',
            '    immut mask = wide(-1, 0)',
            '    mut total: U128 = 0',
            '    mut index = 0',
            '',
            '    while (index < count) {',
            '        immut entry = entryAt(map, index)',
            '        immut valueHash = if (isNull(element)) { 0 } else { koji_element_hash(element, offset(entry, 16)) }',
            '        total = (total + wordProduct(wide(koji_element_hash(keyType(map), entry), 0), wide(31, 0)) + wide(valueHash, 0)) & mask',
            '        index += 1',
            '    }',
            '',
            '    return lowWord(total)',
            '}',
            '',
            '// `[\'Ana\': 30]`, `[:]` or `Set([\'a\', \'b\'])`.',
            'extern function koji_map_repr(map: Address): string {',
            '    immut count = countOf(map)',
            '    immut element = valueType(map)',
            '',
            '    if (isNull(element)) {',
            '        mut text = \'Set([\'',
            '        mut index = 0',
            '',
            '        while (index < count) {',
            '            if (index > 0) { text += \', \' }',
            '',
            '            text += koji_element_repr(keyType(map), entryAt(map, index))',
            '            index += 1',
            '        }',
            '',
            '        return text + \'])\'',
            '    }',
            '',
            '    if (count == 0) { return \'[:]\' }',
            '',
            '    mut text = \'[\'',
            '    mut index = 0',
            '',
            '    while (index < count) {',
            '        if (index > 0) { text += \', \' }',
            '',
            '        immut entry = entryAt(map, index)',
            '        text += koji_element_repr(keyType(map), entry)',
            '        text += \': \'',
            '        text += koji_element_repr(element, offset(entry, 16))',
            '        index += 1',
            '    }',
            '',
            '    return text + \']\'',
            '}',
        ].join('\n'))
    }

    if (name == 'koji:memory') {
        return Some([
            '// `koji:memory`: the pool, the memory of small values, in the library of the runtime written in Koji',
            '// (C calls these functions by their names). Programs make and drop many small values: taking a',
            '// block from a list of free blocks is much cheaper than `malloc`, and giving it back than `free`.',
            '// One list per size in words of 8 bytes, for blocks of up to 16 words: each free block holds the',
            '// next one in its first word. The prelude takes and gives blocks inline (`koji_pool_take` and',
            '// `koji_pool_give`); an empty list gets a chunk of blocks of its size from the system here, at once.',
            '// Larger blocks come from the system and go back to it.',
            '//',
            '// The heads of the lists are `koji_pool` (runtime/prelude.h), whose word 17 holds the chunks taken,',
            '// each holding the one before in its first word (they are never given back: their blocks are in the',
            '// lists). These functions run before the modules of the library are (`koji_pool_start` first), so',
            '// the module has no top-level variables. With `KOJI_POOL=0` in the environment, every block comes',
            '// from the system and goes back to it, so that valgrind sees each one (the tests run their programs',
            '// so).',
            '',
            'import { Address, CSize, Never, allocate, free, isNull, nullAddress, offset, read, write } from \'koji:unsafe\'',
            '',
            'extern function realloc(block: Address, size: CSize): Address',
            'extern function memcpy(target: Address, source: Address, size: CSize): Address',
            'extern function getenv(name: Address): Address',
            'extern function abort(): Never',
            '// The heads of the lists, and whether the pool is off (runtime/prelude.h).',
            'extern function koji_pool_heads(): Address',
            'extern function koji_pool_is_off(): boolean',
            'extern function koji_pool_switch_off()',
            '',
            '// The bytes of a chunk, cut into blocks of one size when a list is empty.',
            'immut chunk = 8192',
            'immut pooled = 16',
            '',
            '// Reads `KOJI_POOL` from the environment, before anything is allocated (from `koji_init`).',
            'extern function koji_pool_start() {',
            '    immut name = systemBlock(2)',
            '    // "KOJI_POOL", without allocating from the pool: its bytes, then a 0.',
            '    write(name, 0, 0x4F4F505F494A4F4B)',
            '    write(name, 8, 0x4C)',
            '    immut value = getenv(name)',
            '    free(name)',
            '',
            '    if (isNull(value)) { return }',
            '',
            '    immut first: byte = read(value, 0)',
            '    immut second: byte = read(value, 1)',
            '',
            '    if (first == 48 and second == 0) { koji_pool_switch_off() }',
            '}',
            '',
            '// A block of `words` words of the system (8 at least).',
            'function systemBlock(words: int): Address {',
            '    immut block = allocate(if (words > 0) { words * 8 } else { 8 })',
            '',
            '    if (isNull(block)) { abort() }',
            '',
            '    return block',
            '}',
            '',
            '// A block of `words` words when the prelude finds its list empty (or the block is larger than the',
            '// pooled ones, or the pool is off): a new chunk cut into blocks of its size, the first one returned',
            '// and the others in the list.',
            'extern function koji_pool_refill(words: CSize): Address {',
            '    if (words > pooled or koji_pool_is_off()) { return systemBlock(words) }',
            '',
            '    immut size = (if (words > 0) { words } else { 1 }) * 8',
            '    immut count = if (chunk / size > 8) { chunk / size } else { 8 }',
            '    immut taken = systemBlock(1 + size / 8 * count)',
            '    immut heads = koji_pool_heads()',
            '    immut chunks: Address = read(heads, 17 * 8)',
            '    write(taken, 0, chunks)',
            '    write(heads, 17 * 8, taken)',
            '    immut first = offset(taken, 8)',
            '    mut index = count - 1',
            '',
            '    while (index >= 1) {',
            '        immut block = offset(first, index * size)',
            '        immut next: Address = read(heads, words * 8)',
            '        write(block, 0, next)',
            '        write(heads, words * 8, block)',
            '        index -= 1',
            '    }',
            '',
            '    return first',
            '}',
            '',
            '// A block of `words` words, from its list or a new chunk (for the runtime in Rust).',
            'extern function koji_pool_take_block(words: CSize): Address {',
            '    if (words > pooled or koji_pool_is_off()) { return systemBlock(words) }',
            '',
            '    immut heads = koji_pool_heads()',
            '    immut block: Address = read(heads, words * 8)',
            '',
            '    if (isNull(block)) { return koji_pool_refill(words) }',
            '',
            '    immut next: Address = read(block, 0)',
            '    write(heads, words * 8, next)',
            '    return block',
            '}',
            '',
            '// Gives a block larger than the pooled ones (or any block, with the pool off) back to the system.',
            'extern function koji_pool_free(block: Address, words: CSize) {',
            '    free(block)',
            '}',
            '',
            '// The block `block` of `words` words grown or shrunk to `newWords` words, its contents kept: by the',
            '// system when neither size is pooled (it may grow the block in place), the same block for the same',
            '// pooled size, or else a new block and a copy.',
            'extern function koji_pool_resize(block: Address, words: CSize, newWords: CSize): Address {',
            '    immut off = koji_pool_is_off()',
            '',
            '    if (off or (words > pooled and newWords > pooled)) {',
            '        immut grown = realloc(block, if (newWords > 0) { newWords * 8 } else { 8 })',
            '',
            '        if (isNull(grown)) { abort() }',
            '',
            '        return grown',
            '    }',
            '',
            '    if (words == newWords) { return block }',
            '',
            '    immut grown = koji_pool_take_block(newWords)',
            '    memcpy(grown, block, (if (words < newWords) { words } else { newWords }) * 8)',
            '    give(block, words)',
            '    return grown',
            '}',
            '',
            '// `koji_pool_give` of the prelude.',
            'function give(block: Address, words: int) {',
            '    if (words > pooled or koji_pool_is_off()) {',
            '        free(block)',
            '        return',
            '    }',
            '',
            '    immut heads = koji_pool_heads()',
            '    immut next: Address = read(heads, words * 8)',
            '    write(block, 0, next)',
            '    write(heads, words * 8, block)',
            '}',
        ].join('\n'))
    }

    if (name == 'koji:numbers') {
        return Some([
            '// `koji:numbers`: the operators of ints and floats that need more than an expression of C, and the',
            '// text of a float, in the library of the runtime written in Koji (C calls these functions by',
            '// their names).',
            '',
            'import { Location, U128, allocate, decimalHigh, decimalLow, free, lowWord, panicAt, read, truncate, wide, wordProduct, write } from \'koji:unsafe\'',
            '',
            'extern function pow(base: float, exponent: float): float',
            'extern function floor(x: float): float',
            'extern function trunc(x: float): float',
            '// The shortest decimal of a float (std/koji/decimal.kj).',
            'extern function koji_decimal_from_float(value: float): decimal',
            '',
            '// The text of a float, as it is stored: in hexadecimal, `0x1.8p1` for 3.0 (a mantissa in base 16',
            '// and a power of 2), which is also how a float is written in code. Exact, and never mistaken for',
            '// a decimal.',
            'extern function koji_string_from_float(value: float): string {',
            '    immut bits = bitsOf(value)',
            '    immut sign = if (bits < 0) { \'-\' } else { \'\' }',
            '    immut storedExponent = (bits >> 52) & 0x7FF',
            '    immut fraction = bits & ((1 << 52) - 1)',
            '',
            '    // Not numbers of Koji, but a float of C may be one.',
            '    if (storedExponent == 0x7FF) { return if (fraction != 0) { \'NaN\' } else { `${sign}inf` } }',
            '',
            '    if (storedExponent == 0 and fraction == 0) { return `${sign}0x0p0` }',
            '',
            '    // A subnormal number has no leading 1: 0x0.0000000000001p-1022.',
            '    immut lead = if (storedExponent == 0) { 0 } else { 1 }',
            '    immut exponent = if (storedExponent == 0) { -1022 } else { storedExponent - 1023 }',
            '    // The 13 hexadecimal digits of the fraction, without the zeros at the end.',
            '    mut digits = \'\'',
            '',
            '    for i in range(13) {',
            '        digits += hexDigit((fraction >> (4 * (12 - i))) & 0xF)',
            '    }',
            '',
            '    mut end = 13',
            '',
            '    while (end > 0 and digits[end - 1] == \'0\') {',
            '        end -= 1',
            '    }',
            '',
            '    if (end == 0) { return `${sign}0x${lead}p${exponent}` }',
            '',
            '    return `${sign}0x${lead}.${digits[..end]}p${exponent}`',
            '}',
            '',
            'function hexDigit(n: int): string {',
            '    return \'0123456789abcdef\'[n..n + 1]',
            '}',
            '',
            '// The 64 bits of a float, as an int.',
            'function bitsOf(value: float): int {',
            '    immut place = allocate(8)',
            '    write(place, 0, value)',
            '    immut bits: int = read(place, 0)',
            '    free(place)',
            '    return bits',
            '}',
            '',
            '// `base ** exponent` for ints; panics at `here` when there is no int result.',
            'extern function koji_int_pow(base: int, exponent: int, here: Location): int {',
            '    if (base == 0 and exponent < 0) { panicAt(here, \'division by zero\') }',
            '',
            '    if (exponent < 0) { panicAt(here, \'negative exponent with int operands; use a decimal base\') }',
            '',
            '    // As Rust\'s `checked_pow`, whose exponent has 32 bits.',
            '    if (exponent > 4294967295) { panicAt(here, \'integer overflow\') }',
            '',
            '    if (exponent == 0) { return 1 }',
            '',
            '    mut result = 1',
            '    mut square = base',
            '    mut left = exponent',
            '    mut fits = true',
            '',
            '    while (true) {',
            '        if ((left & 1) == 1) {',
            '            result = multiplied(result, square, mut fits)',
            '',
            '            if (not fits) { panicAt(here, \'integer overflow\') }',
            '',
            '            if (left == 1) { return result }',
            '        }',
            '',
            '        left = left >> 1',
            '        square = multiplied(square, square, mut fits)',
            '',
            '        if (not fits) { panicAt(here, \'integer overflow\') }',
            '    }',
            '',
            '    return result',
            '}',
            '',
            '// `a * b`, with `fits` false when it is beyond an int.',
            'function multiplied(a: int, b: int, mut fits: boolean): int {',
            '    immut nothing: U128 = 0',
            '    immut sizeA = if (a < 0) { nothing - wide(a, -1) } else { wide(a, 0) }',
            '    immut sizeB = if (b < 0) { nothing - wide(b, -1) } else { wide(b, 0) }',
            '    immut product = wordProduct(sizeA, sizeB)',
            '    immut negative = (a < 0) != (b < 0)',
            '    immut limit = wide(-9223372036854775807 - 1, 0)',
            '',
            '    if (product > limit or (product == limit and not negative)) {',
            '        fits = false',
            '        return 0',
            '    }',
            '',
            '    return if (negative) { lowWord(nothing - product) } else { lowWord(product) }',
            '}',
            '',
            '// `base ** exponent` for floats, with real numbers only (`0 ** 0` is 1); panics at `here` when',
            '// there is no real result.',
            'extern function koji_float_pow(base: float, exponent: float, here: Location): float {',
            '    if (base < 0 and floor(exponent) != exponent) {',
            '        panicAt(here, `${koji_string_from_float(base)} ** ${koji_string_from_float(exponent)} is not a real number (use math.pow to handle it)`)',
            '    }',
            '',
            '    if (base == 0 and exponent < 0) { panicAt(here, \'division by zero\') }',
            '',
            '    immut result = pow(base, exponent)',
            '    immut largest = float(1.7976931348623157e308)',
            '',
            '    if (result > largest or result < -largest) { panicAt(here, \'float overflow\') }',
            '',
            '    return result',
            '}',
            '',
            '// `int(f)`: the int part of a float, or a panic when it does not fit.',
            'extern function koji_std_float_to_int(value: float, here: Location): int {',
            '    immut whole = trunc(value)',
            '',
            '    if (whole < float(9.2e18) and whole > float(-9.2e18)) { return truncate(whole) }',
            '',
            '    panicAt(here, `integer overflow: ${plainText(whole)} does not fit in an int`)',
            '}',
            '',
            '// A float that is an integer, in full: its shortest digits, then zeros (as Rust shows floats).',
            'function plainText(value: float): string {',
            '    immut shortest = koji_decimal_from_float(value)',
            '    immut high = decimalHigh(shortest)',
            '    immut coefficient = wide(decimalLow(shortest), high & ((1 << 49) - 1))',
            '    immut exponent = ((high >> 49) & 0x3FFF) - 6176',
            '    immut sign = if (high < 0) { \'-\' } else { \'\' }',
            '    return `${sign}${coefficient}${\'0\' * exponent}`',
            '}',
        ].join('\n'))
    }

    if (name == 'koji:output') {
        return Some([
            '// `koji:output`: what a program writes (`print`, `printError`) and reads (`input`), and how it ends',
            '// on a panic or on an error that reached its top level, in the library of the runtime written in',
            '// Koji (C calls these functions by their names). The writes go to the system at once, a line in',
            '// one call, as Rust\'s output flushed at each line did.',
            '',
            'import { Address, CInt, Location, Never, allocate, isNull, locationAddress, newString, nullAddress, offset, read, stringBytes, stringSize, write } from \'koji:unsafe\'',
            'import { cString, cText, isUtf8 } from \'koji:core\'',
            '',
            'extern function writev(fd: CInt, buffers: Address, count: CInt): int',
            'extern function strerror(code: CInt): Address',
            'extern function exit(code: CInt): Never',
            'extern function fdopen(fd: CInt, mode: Address): Address',
            'extern function getline(line: Address, capacity: Address, stream: Address): int',
            'extern function ferror(stream: Address): CInt',
            'extern function clearerr(stream: Address)',
            'extern function koji_system_errno(): CInt',
            '',
            '// Two buffers for `writev` (their addresses and sizes), and a line break.',
            'immut buffers = allocate(32)',
            'immut lineBreak = cString(\'\\n\')',
            'immut readMode = cString(\'r\')',
            '// The standard input, opened when a program first reads it, and the block `getline` fills (its',
            '// address, then its capacity).',
            'mut input = nullAddress()',
            'immut line = zeroed(16)',
            '',
            'function zeroed(size: int): Address {',
            '    immut block = allocate(size)',
            '',
            '    for i in range(size / 8) {',
            '        write(block, i * 8, 0)',
            '    }',
            '',
            '    return block',
            '}',
            '',
            '// `print(text)`.',
            'extern function koji_print(text: string, here: Location) {',
            '    immut code = written(1, text, true)',
            '',
            '    if (code != 0) { end(\'panic\', here, `cannot write output: ${message(code)}`) }',
            '}',
            '',
            '// `printError(text)`, on the standard error.',
            'extern function koji_print_error(text: string, here: Location) {',
            '    immut code = written(2, text, true)',
            '',
            '    if (code != 0) { end(\'panic\', here, `cannot write output: ${message(code)}`) }',
            '}',
            '',
            '// `panic(message)`, and the panics of the library.',
            'extern function koji_std_panic(text: string, here: Location): Never {',
            '    end(\'panic\', here, text)',
            '}',
            '',
            '// The panics of the generated code (overflow, division by zero...), with a text of C.',
            'extern function koji_panic(here: Location, text: Address): Never {',
            '    end(\'panic\', here, cText(text))',
            '}',
            '',
            '// `a << b` or `a >> b` with a shift outside 0..64.',
            'extern function koji_panic_shift(here: Location, amount: int): Never {',
            '    end(\'panic\', here, `invalid shift amount ${amount}`)',
            '}',
            '',
            '// An `Err` or a `None` that reached the top level of the program with `?`.',
            'extern function koji_fail(here: Location, text: string): Never {',
            '    end(\'error\', here, text)',
            '}',
            '',
            '// Ends the program with `panic: main.kj:12: message` (or `error: ...`) on the standard error, and',
            '// the exit code 1.',
            'function end(kind: string, here: Location, text: string): Never {',
            '    written(2, `${kind}: ${cText(locationAddress(here))}: ${text}`, true)',
            '    exit(1)',
            '}',
            '',
            '// Writes the bytes of `text`, and a line break when `ending`, to `fd`: 0, or the error of the',
            '// system (-1 when it wrote nothing).',
            'function written(fd: int, text: string, ending: boolean): int {',
            '    mut at = stringBytes(text)',
            '    mut size = stringSize(text)',
            '    mut breakSize = if (ending) { 1 } else { 0 }',
            '',
            '    while (size + breakSize > 0) {',
            '        mut count = 0',
            '',
            '        if (size > 0) {',
            '            write(buffers, 0, at)',
            '            write(buffers, 8, size)',
            '            count = 1',
            '        }',
            '',
            '        if (breakSize > 0) {',
            '            write(buffers, count * 16, lineBreak)',
            '            write(buffers, count * 16 + 8, 1)',
            '            count += 1',
            '        }',
            '',
            '        immut done = writev(fd, buffers, count)',
            '',
            '        if (done < 0) {',
            '            immut code = koji_system_errno()',
            '',
            '            // Interrupted by a signal: again.',
            '            if (code == 4) { continue }',
            '',
            '            // A standard output that is closed takes everything, as in Rust.',
            '            if (code == 9) { return 0 }',
            '',
            '            return code',
            '        }',
            '',
            '        if (done == 0) { return -1 }',
            '',
            '        if (done >= size) {',
            '            breakSize -= done - size',
            '            size = 0',
            '            continue',
            '        }',
            '',
            '        at = offset(at, done)',
            '        size -= done',
            '    }',
            '',
            '    return 0',
            '}',
            '',
            '// The text of an error of the system, as Rust shows it.',
            'function message(code: int): string {',
            '    if (code == -1) { return \'failed to write whole buffer\' }',
            '',
            '    return `${cText(strerror(code))} (os error ${code})`',
            '}',
            '',
            '// `input(prompt)`: a line of the standard input without its line break; `status` becomes 1 at the',
            '// end of the input.',
            'extern function koji_read_line(prompt: string, here: Location, status: Address): string {',
            '    if (stringSize(prompt) > 0) {',
            '        immut code = written(1, prompt, false)',
            '',
            '        if (code != 0) { end(\'panic\', here, `cannot write output: ${message(code)}`) }',
            '    }',
            '',
            '    if (isNull(input)) { input = fdopen(0, readMode) }',
            '',
            '    // A standard input that is closed is empty, as in Rust.',
            '    if (isNull(input)) {',
            '        write(status, 0, 1)',
            '        return \'\'',
            '    }',
            '',
            '    clearerr(input)',
            '    immut size = getline(line, offset(line, 8), input)',
            '',
            '    if (size < 0) {',
            '        immut code = koji_system_errno()',
            '',
            '        if (ferror(input) != 0 and code != 9) { end(\'panic\', here, `cannot read input: ${message(code)}`) }',
            '',
            '        write(status, 0, 1)',
            '        return \'\'',
            '    }',
            '',
            '    immut bytes: Address = read(line, 0)',
            '',
            '    if (not isUtf8(bytes, size)) { end(\'panic\', here, \'cannot read input: stream did not contain valid UTF-8\') }',
            '',
            '    mut last = size',
            '',
            '    while (last > 0 and isLineEnd(bytes, last - 1)) {',
            '        last -= 1',
            '    }',
            '',
            '    return newString(bytes, last)',
            '}',
            '',
            'function isLineEnd(bytes: Address, at: int): boolean {',
            '    immut b: byte = read(bytes, at)',
            '    return b == 10 or b == 13',
            '}',
        ].join('\n'))
    }

    if (name == 'koji:record') {
        return Some([
            '// `koji:record`: the records (the values of declared types: objects and the variants of sum types,',
            '// `Option` and `Result` among them), in the library of the runtime written in Koji (C calls these',
            '// functions by their names). A record is 3 words, its count of references, its type (a',
            '// `KojiRecordType`) and its variant, then the words of its fields (runtime/prelude.h, which makes',
            '// records, sets and reads their fields and counts their references inline). Two variables share a',
            '// record until one of them changes it.',
            '',
            'import { Address, CSize, U128, distance, isNull, lowWord, offset, read, wide, write } from \'koji:unsafe\'',
            'import { cText } from \'koji:core\'',
            'import { isAlphabetic, isNumeric, mixed } from \'koji:text\'',
            '',
            'extern function koji_memory_take(words: int): Address',
            'extern function koji_memory_give(block: Address, words: int)',
            'extern function koji_element_size(element: Address): int',
            'extern function koji_element_retain(element: Address, slot: Address)',
            'extern function koji_element_release(element: Address, slot: Address)',
            'extern function koji_element_repr(element: Address, slot: Address): string',
            'extern function koji_element_text(element: Address, slot: Address): string',
            'extern function koji_element_equal(element: Address, a: Address, b: Address): boolean',
            'extern function koji_element_hash(element: Address, slot: Address): int',
            'extern function koji_record_words(record: Address): int',
            'extern function koji_record_field_count(record: Address): int',
            'extern function koji_record_field_type(record: Address, index: int): Address',
            'extern function koji_record_field_slot(record: Address, index: int): Address',
            'extern function koji_record_field_name(record: Address, index: int): Address',
            'extern function koji_record_variant_name(record: Address): Address',
            'extern function koji_record_type_name(record: Address): Address',
            'extern function koji_record_opaque(record: Address): boolean',
            'extern function koji_record_shown(record: Address): string',
            'extern function memcpy(target: Address, source: Address, size: CSize): Address',
            '// The text of a string as written in code (std/koji/text.kj).',
            'extern function koji_string_repr(text: string): string',
            '',
            'function tagOf(record: Address): int {',
            '    immut tag: int = read(record, 16)',
            '    return tag',
            '}',
            '',
            '// The record in `variable`, made its own (copied when another variable shares it).',
            'function unshared(variable: Address): Address {',
            '    immut record: Address = read(variable, 0)',
            '    immut references: int = read(record, 0)',
            '',
            '    if (references == 1) { return record }',
            '',
            '    immut words = koji_record_words(record)',
            '    immut copy = koji_memory_take(3 + words)',
            '    immut description: Address = read(record, 8)',
            '    write(copy, 0, 1)',
            '    write(copy, 8, description)',
            '    write(copy, 16, tagOf(record))',
            '    memcpy(offset(copy, 24), offset(record, 24), words * 8)',
            '',
            '    for index in range(koji_record_field_count(copy)) {',
            '        koji_element_retain(koji_record_field_type(copy, index), koji_record_field_slot(copy, index))',
            '    }',
            '',
            '    write(record, 0, references - 1)',
            '    write(variable, 0, copy)',
            '    return copy',
            '}',
            '',
            '// Makes the record in `variable` its own, for the generated code that changes a field in place (it',
            '// calls this only when the record is shared).',
            'extern function koji_record_unshare(variable: Address) {',
            '    unshared(variable)',
            '}',
            '',
            '// The slot of a field, to change what it holds in place (`people[0].tags.push(\'a\')`).',
            'extern function koji_record_slot(variable: Address, index: CSize): Address {',
            '    return koji_record_field_slot(unshared(variable), index)',
            '}',
            '',
            '// `record.field = value`.',
            'extern function koji_record_set(variable: Address, index: CSize, value: Address) {',
            '    immut record = unshared(variable)',
            '    immut field = koji_record_field_type(record, index)',
            '    immut slot = koji_record_field_slot(record, index)',
            '    immut size = koji_element_size(field)',
            '    // Read first: `value` may be inside the old value of the field.',
            '    immut kept = koji_memory_take(2)',
            '    memcpy(kept, value, size)',
            '    koji_element_release(field, slot)',
            '    memcpy(slot, kept, size)',
            '    koji_memory_give(kept, 2)',
            '    koji_element_retain(field, slot)',
            '}',
            '',
            'extern function koji_record_equal(a: Address, b: Address): boolean {',
            '    if (distance(a, b) == 0) { return true }',
            '',
            '    if (tagOf(a) != tagOf(b)) { return false }',
            '',
            '    for index in range(koji_record_field_count(a)) {',
            '        if (not koji_element_equal(koji_record_field_type(a, index), koji_record_field_slot(a, index), koji_record_field_slot(b, index))) { return false }',
            '    }',
            '',
            '    return true',
            '}',
            '',
            '// The value as written in code: `{ x: 1, y: 2 }`, `Some(1)`, `None`.',
            'extern function koji_record_repr(record: Address): string {',
            '    if (koji_record_opaque(record)) { return koji_record_shown(record) }',
            '',
            '    immut count = koji_record_field_count(record)',
            '    immut variant = koji_record_variant_name(record)',
            '',
            '    if (isNull(variant)) {',
            '        if (count == 0) { return \'{}\' }',
            '',
            '        mut text = \'{ \'',
            '',
            '        for index in range(count) {',
            '            if (index > 0) { text += \', \' }',
            '',
            '            immut name = cText(koji_record_field_name(record, index))',
            '            text += if (isIdentifier(name)) { name } else { koji_string_repr(name) }',
            '            text += \': \'',
            '            text += fieldRepr(record, index)',
            '        }',
            '',
            '        return text + \' }\'',
            '    }',
            '',
            '    mut text = cText(variant)',
            '',
            '    if (count == 0) { return text }',
            '',
            '    text += \'(\'',
            '',
            '    for index in range(count) {',
            '        if (index > 0) { text += \', \' }',
            '',
            '        text += fieldRepr(record, index)',
            '    }',
            '',
            '    return text + \')\'',
            '}',
            '',
            'function fieldRepr(record: Address, index: int): string {',
            '    return koji_element_repr(koji_record_field_type(record, index), koji_record_field_slot(record, index))',
            '}',
            '',
            '// A name as code writes it: a letter or `_`, then letters, digits and `_` (as Unicode has them).',
            'function isIdentifier(name: string): boolean {',
            '    mut first = true',
            '',
            '    for c in name {',
            '        immut code = c.code()',
            '        immut allowed = c == \'_\' or isAlphabetic(code) or (not first and isNumeric(code))',
            '',
            '        if (not allowed) { return false }',
            '',
            '        first = false',
            '    }',
            '',
            '    return not first',
            '}',
            '',
            '// The text `print` shows: a readable message for an error of the standard library (`\'x\' is not a',
            '// valid number`), the text of an opaque type, or else the value as written in code.',
            'extern function koji_record_display(record: Address): string {',
            '    if (koji_record_opaque(record)) { return koji_record_shown(record) }',
            '',
            '    immut variant = koji_record_variant_name(record)',
            '',
            '    if (not isNull(variant)) {',
            '        immut typeName = koji_record_type_name(record)',
            '',
            '        if (not isNull(typeName)) {',
            '            immut message = errorMessage(cText(typeName), cText(variant), record)',
            '',
            '            if (message != \'\') { return message }',
            '        }',
            '    }',
            '',
            '    return koji_record_repr(record)',
            '}',
            '',
            '// The message of an error of the standard library, from the texts of its fields, or \'\' for another',
            '// value (`ParseError`, which the compiler declares; the errors of the modules written in Koji have',
            '// `display` methods).',
            'function errorMessage(typeName: string, variant: string, record: Address): string {',
            '    if (typeName != \'ParseError\') { return \'\' }',
            '',
            '    return match (variant) {',
            '        \'InvalidNumber\' => `\'${fieldText(record, 0)}\' is not a valid number`',
            '        \'OutOfRange\' => `\'${fieldText(record, 0)}\' is out of range`',
            '        _ => \'\'',
            '    }',
            '}',
            '',
            '// The text of a field, as `print` shows it (\'\' for a field the variant does not have).',
            'function fieldText(record: Address, index: int): string {',
            '    if (index >= koji_record_field_count(record)) { return \'\' }',
            '',
            '    return koji_element_text(koji_record_field_type(record, index), koji_record_field_slot(record, index))',
            '}',
            '',
            '// A hash of the variant and the fields.',
            'extern function koji_record_hash(record: Address): int {',
            '    mut hash = mixed(0, wide(tagOf(record), 0))',
            '',
            '    for index in range(koji_record_field_count(record)) {',
            '        hash = mixed(hash, wide(koji_element_hash(koji_record_field_type(record, index), koji_record_field_slot(record, index)), 0))',
            '    }',
            '',
            '    return lowWord(hash)',
            '}',
        ].join('\n'))
    }

    if (name == 'koji:roots') {
        return Some([
            '// The certificate authorities of Mozilla\'s list (118 of them), built into the library written in',
            '// Koji for the systems that have none: written by bootstrap/roots.rs (do not edit). For each, the',
            '// size of its subject in 2 bytes, its subject, the size of its key in 2 bytes and its key',
            '// (SubjectPublicKeyInfo), in DER, all in base64 (see std/koji/x509.kj).',
            '//',
            '// COMODO ECC Certification Authority',
            '// NetLock Arany (Class Gold) F\\u0151tan\\xfas\\xedtv\\xe1ny',
            '// Microsec e-Szigno Root CA 2009',
            '// GlobalSign Root CA - R3',
            '// Izenpe.com',
            '// Go Daddy Root Certificate Authority - G2',
            '// Starfield Root Certificate Authority - G2',
            '// Starfield Services Root Certificate Authority - G2',
            '// Certum Trusted Network CA',
            '// TWCA Root Certification Authority',
            '// Security Communication RootCA2',
            '// Actalis Authentication Root CA',
            '// Buypass Class 2 Root CA',
            '// Buypass Class 3 Root CA',
            '// T-TeleSec GlobalRoot Class 3',
            '// D-TRUST Root Class 3 CA 2 2009',
            '// D-TRUST Root Class 3 CA 2 EV 2009',
            '// CA Disig Root R2',
            '// ACCVRAIZ1',
            '// TWCA Global Root CA',
            '// T-TeleSec GlobalRoot Class 2',
            '// QuoVadis Root CA 1 G3',
            '// QuoVadis Root CA 2 G3',
            '// QuoVadis Root CA 3 G3',
            '// DigiCert Assured ID Root G2',
            '// DigiCert Assured ID Root G3',
            '// DigiCert Global Root G2',
            '// DigiCert Global Root G3',
            '// DigiCert Trusted Root G4',
            '// COMODO RSA Certification Authority',
            '// USERTrust RSA Certification Authority',
            '// USERTrust ECC Certification Authority',
            '// GlobalSign ECC Root CA - R5',
            '// IdenTrust Commercial Root CA 1',
            '// IdenTrust Public Sector Root CA 1',
            '// CFCA EV ROOT',
            '// OISTE WISeKey Global Root GB CA',
            '// SZAFIR ROOT CA2',
            '// Certum Trusted Network CA 2',
            '// Hellenic Academic and Research Institutions RootCA 2015',
            '// Hellenic Academic and Research Institutions ECC RootCA 2015',
            '// ISRG Root X1',
            '// AC RAIZ FNMT-RCM',
            '// Amazon Root CA 1',
            '// Amazon Root CA 2',
            '// Amazon Root CA 3',
            '// Amazon Root CA 4',
            '// TUBITAK Kamu SM SSL Kok Sertifikasi - Surum 1',
            '// GDCA TrustAUTH R5 ROOT',
            '// SSL.com Root Certification Authority RSA',
            '// SSL.com Root Certification Authority ECC',
            '// SSL.com EV Root Certification Authority RSA R2',
            '// SSL.com EV Root Certification Authority ECC',
            '// GlobalSign Root CA - R6',
            '// OISTE WISeKey Global Root GC CA',
            '// UCA Global G2 Root',
            '// UCA Extended Validation Root',
            '// Certigna Root CA',
            '// emSign Root CA - G1',
            '// Hongkong Post Root CA 3',
            '// Microsoft ECC Root Certificate Authority 2017',
            '// Microsoft RSA Root Certificate Authority 2017',
            '// e-Szigno Root CA 2017',
            '// certSIGN Root CA G2',
            '// NAVER Global Root Certification Authority',
            '// AC RAIZ FNMT-RCM SERVIDORES SEGUROS',
            '// GlobalSign Root R46',
            '// GlobalSign Root E46',
            '// ANF Secure Server Root CA',
            '// Certum EC-384 CA',
            '// Certum Trusted Root CA',
            '// TunTrust Root CA',
            '// HARICA TLS RSA Root CA 2021',
            '// HARICA TLS ECC Root CA 2021',
            '// Autoridad de Certificacion Firmaprofesional CIF A62634068',
            '// vTrus ECC Root CA',
            '// vTrus Root CA',
            '// ISRG Root X2',
            '// HiPKI Root CA - G1',
            '// GlobalSign ECC Root CA - R4',
            '// GTS Root R1',
            '// GTS Root R3',
            '// GTS Root R4',
            '// Telia Root CA v2',
            '// D-TRUST BR Root CA 1 2020',
            '// D-TRUST EV Root CA 1 2020',
            '// DigiCert TLS ECC P384 Root G5',
            '// DigiCert TLS RSA4096 Root G5',
            '// Certainly Root R1',
            '// Certainly Root E1',
            '// Security Communication ECC RootCA1',
            '// BJCA Global Root CA1',
            '// BJCA Global Root CA2',
            '// Sectigo Public Server Authentication Root E46',
            '// Sectigo Public Server Authentication Root R46',
            '// SSL.com TLS RSA Root CA 2022',
            '// SSL.com TLS ECC Root CA 2022',
            '// Atos TrustedRoot Root CA ECC TLS 2021',
            '// Atos TrustedRoot Root CA RSA TLS 2021',
            '// TrustAsia Global Root CA G3',
            '// TrustAsia Global Root CA G4',
            '// Telekom Security TLS ECC Root 2020',
            '// Telekom Security TLS RSA Root 2023',
            '// TWCA CYBER Root CA',
            '// SecureSign Root CA14',
            '// SecureSign Root CA15',
            '// D-TRUST BR Root CA 2 2023',
            '// TrustAsia TLS ECC Root CA',
            '// TrustAsia TLS RSA Root CA',
            '// D-TRUST EV Root CA 2 2023',
            '// SwissSign RSA TLS Root CA 2022 - 1',
            '// OISTE Server Root ECC G1',
            '// OISTE Server Root RSA G1',
            '// e-Szigno TLS Root CA 2023',
            '// SECOM TLS RSA Root CA 2024',
            '// SECOM TLS ECC Root CA 2024',
            '// Telia EC TLS Root CA v3',
            '// Telia RSA TLS Root CA v3',
            '',
            'export immut rootCount = 118',
            'export immut roots = \'\'',
        ].join('\n'))
    }

    if (name == 'koji:rsa') {
        return Some([
            '// `koji:rsa`: the verification of RSA signatures (RFC 8017), in the library of the runtime written in',
            '// Koji: certificates are signed with PKCS #1 v1.5, and the proof of a server with an RSA key in TLS',
            '// 1.3 with PSS (its salt as long as the digest). The signature to the power e modulo n (koji:bignum),',
            '// then its encoding checked. Everything here is public: no constant time is needed.',
            '',
            'import { Address, CInt, CSize, allocate, free, offset, read, write } from \'koji:unsafe\'',
            'import { compare, freeModulus, fromBytes, fromForm, modulusOf, power, toBytes, toForm, zeroNumber } from \'koji:bignum\'',
            'import { digest, digestSize } from \'koji:sha\'',
            '',
            'extern function memcpy(target: Address, source: Address, size: CSize): Address',
            'extern function memcmp(a: Address, b: Address, size: CSize): CInt',
            'extern function memset(target: Address, value: CInt, size: CSize): Address',
            '',
            'function byteAt(bytes: Address, i: int): int {',
            '    immut b: byte = read(bytes, i)',
            '    return int(b)',
            '}',
            '',
            '// The signature to the power e modulo n, as `size` bytes (those of n) at `out`; false when the',
            '// signature does not have that size or is not below n, or n is not a modulus of RSA (a leading zero',
            '// byte, or even: Montgomery\'s multiplication needs an odd one).',
            'function publicOperation(signature: Address, signatureSize: int, modulus: Address, size: int, exponent: Address, exponentSize: int, out: Address): boolean {',
            '    if (signatureSize != size or size == 0) { return false }',
            '',
            '    if (byteAt(modulus, 0) == 0 or byteAt(modulus, size - 1) & 1 == 0) { return false }',
            '',
            '    immut m = modulusOf(modulus, size)',
            '    immut t = zeroNumber(m.count + 2)',
            '    immut s = fromBytes(signature, size, m.count)',
            '    immut below = compare(s, m.limbs, m.count) < 0',
            '',
            '    if (below) {',
            '        toForm(m, s, s, t)',
            '        power(m, s, s, exponent, exponentSize, t)',
            '        fromForm(m, s, s, t)',
            '        toBytes(s, m.count, out, size)',
            '    }',
            '',
            '    freeModulus(m)',
            '',
            '    for each in [t, s] {',
            '        free(each)',
            '    }',
            '',
            '    return below',
            '}',
            '',
            '// The DER of the DigestInfo of a hash (0 SHA-256, 1 SHA-384, 2 SHA-512), before the digest.',
            'function digestPrefix(hash: int): string {',
            '    return match (hash) {',
            '        0 => \'3031300d060960864801650304020105000420\'',
            '        1 => \'3041300d060960864801650304020205000430\'',
            '        _ => \'3051300d060960864801650304020305000440\'',
            '    }',
            '}',
            '',
            '// PKCS #1 v1.5: 00 01 FF...FF 00, the DigestInfo of the hash and the digest.',
            'export function verifyPkcs1(hash: int, digestBytes: Address, digestSizeGiven: int, signature: Address, signatureSize: int, modulus: Address, size: int, exponent: Address, exponentSize: int): boolean {',
            '    if (digestSizeGiven != digestSize(hash)) { return false }',
            '',
            '    immut decoded = allocate(size)',
            '',
            '    if (not publicOperation(signature, signatureSize, modulus, size, exponent, exponentSize, decoded)) {',
            '        free(decoded)',
            '        return false',
            '    }',
            '',
            '    immut prefix = digestPrefix(hash)',
            '    immut prefixSize = prefix.length() / 2',
            '    immut tailSize = prefixSize + digestSizeGiven',
            '    // At least 8 bytes of FF.',
            '    mut good = size >= tailSize + 11',
            '    immut expected = allocate(size)',
            '',
            '    if (good) {',
            '        memset(expected, 0xFF, size)',
            '        write(expected, 0, byte(0))',
            '        write(expected, 1, byte(1))',
            '        write(expected, size - tailSize - 1, byte(0))',
            '',
            '        for i in range(prefixSize) {',
            '            write(expected, size - tailSize + i, byte(hexValue(prefix, 2 * i) * 16 + hexValue(prefix, 2 * i + 1)))',
            '        }',
            '',
            '        memcpy(offset(expected, size - digestSizeGiven), digestBytes, digestSizeGiven)',
            '        good = memcmp(expected, decoded, size) == 0',
            '    }',
            '',
            '    free(expected)',
            '    free(decoded)',
            '    return good',
            '}',
            '',
            'function hexValue(text: string, at: int): int {',
            '    immut c = text[at]',
            '    return if (c >= \'a\') { c.code() - 87 } else { c.code() - 48 }',
            '}',
            '',
            '// MGF1: `size` bytes of mask from `seed`, xored into `target`.',
            'function maskWith(hash: int, seed: Address, seedSize: int, target: Address, size: int) {',
            '    immut length = digestSize(hash)',
            '    immut input = allocate(seedSize + 4)',
            '    immut block = allocate(length)',
            '    memcpy(input, seed, seedSize)',
            '    mut done = 0',
            '    mut counter = 0',
            '',
            '    while (done < size) {',
            '        for i in range(4) {',
            '            write(input, seedSize + i, byte((counter >> (24 - 8 * i)) & 0xFF))',
            '        }',
            '',
            '        digest(hash, input, seedSize + 4, block)',
            '        mut i = 0',
            '',
            '        while (i < length and done < size) {',
            '            write(target, done, byte(byteAt(target, done) ^ byteAt(block, i)))',
            '            i += 1',
            '            done += 1',
            '        }',
            '',
            '        counter += 1',
            '    }',
            '',
            '    free(block)',
            '    free(input)',
            '}',
            '',
            '// The bits of the number of the big-endian bytes at `bytes`.',
            'function bitLength(bytes: Address, size: int): int {',
            '    for i in range(size) {',
            '        immut b = byteAt(bytes, i)',
            '',
            '        if (b != 0) {',
            '            mut bits = 8',
            '',
            '            while ((b >> (bits - 1)) & 1 == 0) {',
            '                bits -= 1',
            '            }',
            '',
            '            return (size - i - 1) * 8 + bits',
            '        }',
            '    }',
            '',
            '    return 0',
            '}',
            '',
            '// PSS (EMSA-PSS-VERIFY), with MGF1 of the same hash and a salt as long as the digest.',
            'export function verifyPss(hash: int, digestBytes: Address, digestSizeGiven: int, signature: Address, signatureSize: int, modulus: Address, size: int, exponent: Address, exponentSize: int): boolean {',
            '    immut length = digestSize(hash)',
            '',
            '    if (digestSizeGiven != length) { return false }',
            '',
            '    immut decoded = allocate(size)',
            '',
            '    if (not publicOperation(signature, signatureSize, modulus, size, exponent, exponentSize, decoded)) {',
            '        free(decoded)',
            '        return false',
            '    }',
            '',
            '    // The encoded message has the bits of n but one.',
            '    immut emBits = bitLength(modulus, size) - 1',
            '    immut emLength = (emBits + 7) / 8',
            '    immut start = size - emLength',
            '    mut good = emLength >= 2 * length + 2',
            '',
            '    // A leading byte beyond the encoded message is 0.',
            '    if (good and start > 0 and byteAt(decoded, 0) != 0) { good = false }',
            '',
            '    immut em = offset(decoded, start)',
            '',
            '    if (good and byteAt(em, emLength - 1) != 0xBC) { good = false }',
            '',
            '    immut dbSize = emLength - length - 1',
            '    immut topBits = 8 * emLength - emBits',
            '',
            '    if (good and topBits > 0 and (byteAt(em, 0) >> (8 - topBits)) != 0) { good = false }',
            '',
            '    if (good) {',
            '        immut db = allocate(dbSize)',
            '        memcpy(db, em, dbSize)',
            '        maskWith(hash, offset(em, dbSize), length, db, dbSize)',
            '',
            '        if (topBits > 0) { write(db, 0, byte(byteAt(db, 0) & (0xFF >> topBits))) }',
            '',
            '        // Zeros, a 1, then the salt.',
            '        immut zeros = dbSize - length - 1',
            '',
            '        for i in range(zeros) {',
            '            if (byteAt(db, i) != 0) { good = false }',
            '        }',
            '',
            '        if (byteAt(db, zeros) != 1) { good = false }',
            '',
            '        if (good) {',
            '            // H = Hash(8 zeros || mHash || salt)',
            '            immut message = allocate(8 + 2 * length)',
            '            memset(message, 0, 8)',
            '            memcpy(offset(message, 8), digestBytes, length)',
            '            memcpy(offset(message, 8 + length), offset(db, dbSize - length), length)',
            '            immut check = allocate(length)',
            '            digest(hash, message, 8 + 2 * length, check)',
            '            good = memcmp(check, offset(em, dbSize), length) == 0',
            '            free(check)',
            '            free(message)',
            '        }',
            '',
            '        free(db)',
            '    }',
            '',
            '    free(decoded)',
            '    return good',
            '}',
            '',
            '// For C (the tests of the library): `kind` 0 for PKCS #1 v1.5, 1 for PSS.',
            'extern function koji_rsa_verify(kind: CInt, hash: CInt, digestBytes: Address, digestSizeGiven: CSize, signature: Address, signatureSize: CSize, modulus: Address, size: CSize, exponent: Address, exponentSize: CSize): boolean {',
            '    if (kind == 0) { return verifyPkcs1(hash, digestBytes, digestSizeGiven, signature, signatureSize, modulus, size, exponent, exponentSize) }',
            '',
            '    return verifyPss(hash, digestBytes, digestSizeGiven, signature, signatureSize, modulus, size, exponent, exponentSize)',
            '}',
        ].join('\n'))
    }

    if (name == 'koji:ryu') {
        return Some([
            '// The tables of powers of 5 of Ryu (std/koji/decimal.kj): written by bootstrap/ryu.rs (do not',
            '// edit). Records of 32 hexadecimal digits, the high 64 bits of a number of 128 bits first.',
            '',
            '// 5^i in its first 125 bits, for i below 326.',
            'export immut powersOfFive = \'\'',
            '',
            '// 2^(bits of 5^i - 1 + 125) / 5^i + 1, for i below 342.',
            'export immut inversePowersOfFive = \'\'',
        ].join('\n'))
    }

    if (name == 'koji:sha') {
        return Some([
            '// `koji:sha`: the hashes SHA-256, SHA-384 and SHA-512 (FIPS 180-4), HMAC (RFC 2104) and HKDF',
            '// (RFC 5869), in the library of the runtime written in Koji: what TLS 1.3 derives its keys with and',
            '// signatures are made over. On bytes at addresses (`data`, `size`), the digest written at `out`.',
            '// A word of SHA-256 is an int below 2^32 (its sums are masked); one of SHA-512 is the 64 bits of an',
            '// int (its sums wrap through U128, its shifts to the right are logical).',
            '',
            'import { Address, CInt, CSize, U128, allocate, free, isNull, lowWord, nullAddress, offset, read, stringBytes, stringSize, wide, write } from \'koji:unsafe\'',
            '',
            'extern function memcpy(target: Address, source: Address, size: CSize): Address',
            'extern function memset(target: Address, value: CInt, size: CSize): Address',
            '',
            '',
            '// The constants, in hexadecimal: the first 32 (or 64) bits of the fractional parts of the cube roots',
            '// of the first 64 (or 80) primes, and the first values, of their square roots (of the 9th to 16th',
            '// primes for SHA-384).',
            'immut k256Text = \'\'',
            'immut h256Text = \'6a09e667bb67ae853c6ef372a54ff53a510e527f9b05688c1f83d9ab5be0cd19\'',
            'immut k512Text = \'\'',
            'immut h512Text = \'6a09e667f3bcc908bb67ae8584caa73b3c6ef372fe94f82ba54ff53a5f1d36f1510e527fade682d19b05688c2b3e6c1f1f83d9abfb41bd6b5be0cd19137e2179\'',
            'immut h384Text = \'cbbb9d5dc1059ed8629a292a367cd5079159015a3070dd17152fecd8f70e593967332667ffc00b318eb44a8768581511db0c2e0d64f98fa747b5481dbefa4fa4\'',
            '',
            '// The constants as ints, read the first time a hash needs them.',
            'mut k256 = nullAddress()',
            'mut k512 = nullAddress()',
            '',
            '// Ints from groups of `digits` hexadecimal digits of `text`.',
            'function wordsOf(text: string, digits: int): Address {',
            '    immut bytes = stringBytes(text)',
            '    immut count = stringSize(text) / digits',
            '    immut words = allocate(count * 8)',
            '',
            '    for i in range(count) {',
            '        mut value: U128 = 0',
            '',
            '        for d in range(digits) {',
            '            immut b: byte = read(bytes, i * digits + d)',
            '            value = (value << 4) | wide(int(if (b <= 57) { b - 48 } else { b - 87 }), 0)',
            '        }',
            '',
            '        write(words, i * 8, lowWord(value))',
            '    }',
            '',
            '    return words',
            '}',
            '',
            'function wordAt(words: Address, i: int): int {',
            '    immut word: int = read(words, i * 8)',
            '    return word',
            '}',
            '',
            'function byteAt(bytes: Address, i: int): int {',
            '    immut b: byte = read(bytes, i)',
            '    return int(b)',
            '}',
            '',
            'function putByte(bytes: Address, i: int, value: int) {',
            '    write(bytes, i, byte(value & 0xFF))',
            '}',
            '',
            '// SHA-256',
            '',
            'immut mask32 = 0xFFFFFFFF',
            '',
            'function rotr32(x: int, n: int): int {',
            '    return ((x >> n) | (x << (32 - n))) & mask32',
            '}',
            '',
            '// The digest of SHA-256 (32 bytes) of the `size` bytes at `data`, at `out`.',
            'export function sha256(data: Address, size: int, out: Address) {',
            '    if (isNull(k256)) { k256 = wordsOf(k256Text, 8) }',
            '',
            '    immut state = wordsOf(h256Text, 8)',
            '    immut schedule = allocate(64 * 8)',
            '    mut at = 0',
            '',
            '    while (at + 64 <= size) {',
            '        compress256(state, schedule, offset(data, at))',
            '        at += 64',
            '    }',
            '',
            '    // The last bytes, a 1 bit, zeros, and the size in bits on 8 bytes (one block or two).',
            '    immut tail = allocate(128)',
            '    memset(tail, 0, 128)',
            '    memcpy(tail, offset(data, at), size - at)',
            '    putByte(tail, size - at, 0x80)',
            '    immut blocks = if (size - at + 9 > 64) { 2 } else { 1 }',
            '    immut bits = size * 8',
            '',
            '    for i in range(8) {',
            '        putByte(tail, blocks * 64 - 1 - i, (bits >> (8 * i)) & 0xFF)',
            '    }',
            '',
            '    for b in range(blocks) {',
            '        compress256(state, schedule, offset(tail, b * 64))',
            '    }',
            '',
            '    for i in range(8) {',
            '        immut word = wordAt(state, i)',
            '',
            '        for j in range(4) {',
            '            putByte(out, i * 4 + j, word >> (24 - 8 * j))',
            '        }',
            '    }',
            '',
            '    free(tail)',
            '    free(schedule)',
            '    free(state)',
            '}',
            '',
            'function compress256(state: Address, w: Address, block: Address) {',
            '    mut t = 0',
            '',
            '    while (t < 16) {',
            '        write(w, t * 8, (byteAt(block, 4 * t) << 24) | (byteAt(block, 4 * t + 1) << 16) | (byteAt(block, 4 * t + 2) << 8) | byteAt(block, 4 * t + 3))',
            '        t += 1',
            '    }',
            '',
            '    while (t < 64) {',
            '        immut x = wordAt(w, t - 15)',
            '        immut y = wordAt(w, t - 2)',
            '        immut s0 = rotr32(x, 7) ^ rotr32(x, 18) ^ (x >> 3)',
            '        immut s1 = rotr32(y, 17) ^ rotr32(y, 19) ^ (y >> 10)',
            '        write(w, t * 8, (wordAt(w, t - 16) + s0 + wordAt(w, t - 7) + s1) & mask32)',
            '        t += 1',
            '    }',
            '',
            '    mut a = wordAt(state, 0)',
            '    mut b = wordAt(state, 1)',
            '    mut c = wordAt(state, 2)',
            '    mut d = wordAt(state, 3)',
            '    mut e = wordAt(state, 4)',
            '    mut f = wordAt(state, 5)',
            '    mut g = wordAt(state, 6)',
            '    mut h = wordAt(state, 7)',
            '    t = 0',
            '',
            '    while (t < 64) {',
            '        immut big1 = rotr32(e, 6) ^ rotr32(e, 11) ^ rotr32(e, 25)',
            '        immut choice = (e & f) ^ ((e ^ mask32) & g)',
            '        immut first = (h + big1 + choice + wordAt(k256, t) + wordAt(w, t)) & mask32',
            '        immut big0 = rotr32(a, 2) ^ rotr32(a, 13) ^ rotr32(a, 22)',
            '        immut majority = (a & b) ^ (a & c) ^ (b & c)',
            '        immut second = (big0 + majority) & mask32',
            '        h = g',
            '        g = f',
            '        f = e',
            '        e = (d + first) & mask32',
            '        d = c',
            '        c = b',
            '        b = a',
            '        a = (first + second) & mask32',
            '        t += 1',
            '    }',
            '',
            '    write(state, 0, (wordAt(state, 0) + a) & mask32)',
            '    write(state, 8, (wordAt(state, 1) + b) & mask32)',
            '    write(state, 16, (wordAt(state, 2) + c) & mask32)',
            '    write(state, 24, (wordAt(state, 3) + d) & mask32)',
            '    write(state, 32, (wordAt(state, 4) + e) & mask32)',
            '    write(state, 40, (wordAt(state, 5) + f) & mask32)',
            '    write(state, 48, (wordAt(state, 6) + g) & mask32)',
            '    write(state, 56, (wordAt(state, 7) + h) & mask32)',
            '}',
            '',
            '// SHA-512 and SHA-384',
            '',
            '// a + b, in 64 bits.',
            'function add64(a: int, b: int): int {',
            '    return lowWord(wide(a, 0) + wide(b, 0))',
            '}',
            '',
            '// x shifted right by n (1 to 63) bits, zeros coming in.',
            'function shr64(x: int, n: int): int {',
            '    return (x >> n) & (-1 ^ (-1 << (64 - n)))',
            '}',
            '',
            'function rotr64(x: int, n: int): int {',
            '    return shr64(x, n) | (x << (64 - n))',
            '}',
            '',
            '// The digest of SHA-512 (64 bytes) of the `size` bytes at `data`, at `out`.',
            'export function sha512(data: Address, size: int, out: Address) {',
            '    sha512Family(data, size, out, h512Text, 64)',
            '}',
            '',
            '// The digest of SHA-384 (48 bytes): SHA-512 from other first values, its first 48 bytes.',
            'export function sha384(data: Address, size: int, out: Address) {',
            '    sha512Family(data, size, out, h384Text, 48)',
            '}',
            '',
            'function sha512Family(data: Address, size: int, out: Address, first: string, length: int) {',
            '    if (isNull(k512)) { k512 = wordsOf(k512Text, 16) }',
            '',
            '    immut state = wordsOf(first, 16)',
            '    immut schedule = allocate(80 * 8)',
            '    mut at = 0',
            '',
            '    while (at + 128 <= size) {',
            '        compress512(state, schedule, offset(data, at))',
            '        at += 128',
            '    }',
            '',
            '    // The size in bits takes 16 bytes; sizes below 2^61 bytes have 0 in their first 8.',
            '    immut tail = allocate(256)',
            '    memset(tail, 0, 256)',
            '    memcpy(tail, offset(data, at), size - at)',
            '    putByte(tail, size - at, 0x80)',
            '    immut blocks = if (size - at + 17 > 128) { 2 } else { 1 }',
            '    immut bits = size * 8',
            '',
            '    for i in range(8) {',
            '        putByte(tail, blocks * 128 - 1 - i, (bits >> (8 * i)) & 0xFF)',
            '    }',
            '',
            '    for b in range(blocks) {',
            '        compress512(state, schedule, offset(tail, b * 128))',
            '    }',
            '',
            '    for i in range(length) {',
            '        immut word = wordAt(state, i / 8)',
            '        immut place = i % 8',
            '        putByte(out, i, if (place == 7) { word } else { shr64(word, 56 - 8 * place) })',
            '    }',
            '',
            '    free(tail)',
            '    free(schedule)',
            '    free(state)',
            '}',
            '',
            'function be64(block: Address, at: int): int {',
            '    mut value = 0',
            '',
            '    for i in range(8) {',
            '        value = (value << 8) | byteAt(block, at + i)',
            '    }',
            '',
            '    return value',
            '}',
            '',
            'function compress512(state: Address, w: Address, block: Address) {',
            '    mut t = 0',
            '',
            '    while (t < 16) {',
            '        write(w, t * 8, be64(block, 8 * t))',
            '        t += 1',
            '    }',
            '',
            '    while (t < 80) {',
            '        immut x = wordAt(w, t - 15)',
            '        immut y = wordAt(w, t - 2)',
            '        immut s0 = rotr64(x, 1) ^ rotr64(x, 8) ^ shr64(x, 7)',
            '        immut s1 = rotr64(y, 19) ^ rotr64(y, 61) ^ shr64(y, 6)',
            '        write(w, t * 8, add64(add64(wordAt(w, t - 16), s0), add64(wordAt(w, t - 7), s1)))',
            '        t += 1',
            '    }',
            '',
            '    mut a = wordAt(state, 0)',
            '    mut b = wordAt(state, 1)',
            '    mut c = wordAt(state, 2)',
            '    mut d = wordAt(state, 3)',
            '    mut e = wordAt(state, 4)',
            '    mut f = wordAt(state, 5)',
            '    mut g = wordAt(state, 6)',
            '    mut h = wordAt(state, 7)',
            '    t = 0',
            '',
            '    while (t < 80) {',
            '        immut big1 = rotr64(e, 14) ^ rotr64(e, 18) ^ rotr64(e, 41)',
            '        immut choice = (e & f) ^ ((e ^ -1) & g)',
            '        immut first = add64(add64(add64(h, big1), add64(choice, wordAt(k512, t))), wordAt(w, t))',
            '        immut big0 = rotr64(a, 28) ^ rotr64(a, 34) ^ rotr64(a, 39)',
            '        immut majority = (a & b) ^ (a & c) ^ (b & c)',
            '        immut second = add64(big0, majority)',
            '        h = g',
            '        g = f',
            '        f = e',
            '        e = add64(d, first)',
            '        d = c',
            '        c = b',
            '        b = a',
            '        a = add64(first, second)',
            '        t += 1',
            '    }',
            '',
            '    write(state, 0, add64(wordAt(state, 0), a))',
            '    write(state, 8, add64(wordAt(state, 1), b))',
            '    write(state, 16, add64(wordAt(state, 2), c))',
            '    write(state, 24, add64(wordAt(state, 3), d))',
            '    write(state, 32, add64(wordAt(state, 4), e))',
            '    write(state, 40, add64(wordAt(state, 5), f))',
            '    write(state, 48, add64(wordAt(state, 6), g))',
            '    write(state, 56, add64(wordAt(state, 7), h))',
            '}',
            '',
            '// Hashes by number: 0 SHA-256, 1 SHA-384, 2 SHA-512.',
            '',
            'export function digestSize(hash: int): int {',
            '    return match (hash) {',
            '        0 => 32',
            '        1 => 48',
            '        _ => 64',
            '    }',
            '}',
            '',
            'function blockSize(hash: int): int {',
            '    return if (hash == 0) { 64 } else { 128 }',
            '}',
            '',
            'export function digest(hash: int, data: Address, size: int, out: Address) {',
            '    if (hash == 0) {',
            '        sha256(data, size, out)',
            '        return',
            '    }',
            '',
            '    if (hash == 1) {',
            '        sha384(data, size, out)',
            '        return',
            '    }',
            '',
            '    sha512(data, size, out)',
            '}',
            '',
            '// HMAC of `hash` with the key `key` (`keySize` bytes) over the data, at `out` (the size of a digest).',
            'export function hmac(hash: int, key: Address, keySize: int, data: Address, size: int, out: Address) {',
            '    immut block = blockSize(hash)',
            '    immut length = digestSize(hash)',
            '    // A key longer than a block is its digest; then zeros to a block.',
            '    immut padded = allocate(block)',
            '    memset(padded, 0, block)',
            '',
            '    if (keySize > block) {',
            '        digest(hash, key, keySize, padded)',
            '    } else {',
            '        memcpy(padded, key, keySize)',
            '    }',
            '',
            '    // H((K ^ opad) || H((K ^ ipad) || data))',
            '    immut inner = allocate(block + size)',
            '',
            '    for i in range(block) {',
            '        putByte(inner, i, byteAt(padded, i) ^ 0x36)',
            '    }',
            '',
            '    memcpy(offset(inner, block), data, size)',
            '    immut outer = allocate(block + length)',
            '    digest(hash, inner, block + size, offset(outer, block))',
            '',
            '    for i in range(block) {',
            '        putByte(outer, i, byteAt(padded, i) ^ 0x5C)',
            '    }',
            '',
            '    digest(hash, outer, block + length, out)',
            '    free(outer)',
            '    free(inner)',
            '    free(padded)',
            '}',
            '',
            '// HKDF-Extract: the pseudorandom key (the size of a digest) of `salt` and `secret`, at `out`.',
            'export function hkdfExtract(hash: int, salt: Address, saltSize: int, secret: Address, secretSize: int, out: Address) {',
            '    if (saltSize == 0) {',
            '        // No salt is a salt of zeros, the size of a digest.',
            '        immut zeros = allocate(digestSize(hash))',
            '        memset(zeros, 0, digestSize(hash))',
            '        hmac(hash, zeros, digestSize(hash), secret, secretSize, out)',
            '        free(zeros)',
            '        return',
            '    }',
            '',
            '    hmac(hash, salt, saltSize, secret, secretSize, out)',
            '}',
            '',
            '// HKDF-Expand: `length` bytes (at most 255 digests) from the pseudorandom key and `info`, at `out`.',
            'export function hkdfExpand(hash: int, key: Address, keySize: int, info: Address, infoSize: int, length: int, out: Address) {',
            '    immut size = digestSize(hash)',
            '    // T(i) = HMAC(key, T(i - 1) || info || i)',
            '    immut input = allocate(size + infoSize + 1)',
            '    immut block = allocate(size)',
            '    mut previous = 0',
            '    mut done = 0',
            '    mut counter = 1',
            '',
            '    while (done < length) {',
            '        memcpy(input, block, previous)',
            '        memcpy(offset(input, previous), info, infoSize)',
            '        putByte(input, previous + infoSize, counter)',
            '        hmac(hash, key, keySize, input, previous + infoSize + 1, block)',
            '        immut taken = if (length - done < size) { length - done } else { size }',
            '        memcpy(offset(out, done), block, taken)',
            '        done += taken',
            '        previous = size',
            '        counter += 1',
            '    }',
            '',
            '    free(block)',
            '    free(input)',
            '}',
            '',
            '// For C (the tests of the library): the same functions, by their names.',
            '',
            'extern function koji_sha256(data: Address, size: CSize, out: Address) {',
            '    sha256(data, size, out)',
            '}',
            '',
            'extern function koji_sha384(data: Address, size: CSize, out: Address) {',
            '    sha384(data, size, out)',
            '}',
            '',
            'extern function koji_sha512(data: Address, size: CSize, out: Address) {',
            '    sha512(data, size, out)',
            '}',
            '',
            'extern function koji_hmac(hash: CInt, key: Address, keySize: CSize, data: Address, size: CSize, out: Address) {',
            '    hmac(hash, key, keySize, data, size, out)',
            '}',
            '',
            'extern function koji_hkdf(hash: CInt, salt: Address, saltSize: CSize, secret: Address, secretSize: CSize, info: Address, infoSize: CSize, length: CSize, out: Address) {',
            '    immut key = allocate(64)',
            '    hkdfExtract(hash, salt, saltSize, secret, secretSize, key)',
            '    hkdfExpand(hash, key, digestSize(hash), info, infoSize, length, out)',
            '    free(key)',
            '}',
        ].join('\n'))
    }

    if (name == 'koji:start') {
        return Some([
            '// `koji:start`: the start of a program, in the library of the runtime written in Koji (the `main`',
            '// of a program calls `koji_init` first).',
            '',
            'import { Address, CInt } from \'koji:unsafe\'',
            '',
            '// The pool (std/koji/memory.kj), the arguments of `main` (runtime/prelude.h) and the modules of the',
            '// library.',
            'extern function koji_pool_start()',
            'extern function koji_keep_arguments(count: CInt, values: Address)',
            'extern function koji_library_init()',
            '',
            'extern function koji_init(count: CInt, values: Address) {',
            '    koji_pool_start()',
            '    koji_keep_arguments(count, values)',
            '    koji_library_init()',
            '}',
        ].join('\n'))
    }

    if (name == 'koji:text') {
        return Some([
            '// `koji:text`: the strings of the runtime, in the library of the runtime written in Koji (C calls',
            '// these functions by their names). A string is immutable text with a count of references, laid',
            '// out for C (runtime/prelude.h): the count, the length in bytes, the bytes its block holds, then',
            '// the UTF-8 bytes. A function gives a new reference to the string it returns; it reads the strings',
            '// it is given, but those it takes (`take`: the caller gives its reference).',
            '',
            'import { Address, CInt, CSize, Location, U128, allocate, blankString, charOfCode, distance, isNull, lowWord, newString, nullAddress, offset, panicAt, read, setStringSize, stringBytes, stringCapacity, stringReferences, stringSize, wide, wordProduct, write } from \'koji:unsafe\'',
            'import { isContinuation, isSpace, isUtf8, textOf } from \'koji:core\'',
            'import { alphabetic, cased, ignorable, lowerMultiple, lowerSingle, lowercase, numeric, upperMultiple, upperSingle, uppercase } from \'koji:unicode\'',
            '',
            'extern function memcpy(target: Address, source: Address, size: CSize): Address',
            'extern function koji_memory_give(block: Address, words: int)',
            'extern function memcmp(a: Address, b: Address, size: CSize): CInt',
            'extern function memchr(bytes: Address, value: CInt, size: CSize): Address',
            'extern function memmem(haystack: Address, haystackSize: CSize, needle: Address, needleSize: CSize): Address',
            '',
            'extern function koji_string_concat(a: string, b: string): string {',
            '    immut sizeA = stringSize(a)',
            '    immut sizeB = stringSize(b)',
            '    immut joined = blankString(sizeA + sizeB, sizeA + sizeB)',
            '    immut bytes = stringBytes(joined)',
            '    memcpy(bytes, stringBytes(a), sizeA)',
            '    memcpy(offset(bytes, sizeA), stringBytes(b), sizeB)',
            '    return joined',
            '}',
            '',
            '// `a + b`, where the caller gives its reference to `a` (it read `a` for the last time): when no',
            '// one else sees `a`, `b` is added to it in place, and its block grows by doubling, so that a',
            '// string built piece by piece (`text += c`) costs a constant time per piece on average.',
            'extern function koji_string_append(take a: string, b: string): string {',
            '    // The same string on both sides: `b` would change as it is copied.',
            '    if (distance(stringBytes(a), stringBytes(b)) == 0) { return koji_string_concat(a, b) }',
            '',
            '    return appendBytes(a, stringBytes(b), stringSize(b))',
            '}',
            '',
            '// `text + string(c)` where `text` is read for the last time: like `koji_string_append`, without',
            '// a string for the char.',
            'extern function koji_string_append_char(take a: string, c: char): string {',
            '    immut code = validCode(c.code())',
            '    immut size = utf8Size(code)',
            '    immut length = stringSize(a)',
            '',
            '    // In place, as `appendBytes`: the bytes of the char go at the end.',
            '    if (stringReferences(a) == 1 and length + size <= stringCapacity(a)) {',
            '        encode(offset(stringBytes(a), length), code)',
            '        setStringSize(a, length + size)',
            '        return a',
            '    }',
            '',
            '    immut capacity = if (stringReferences(a) == 1) { maxOf(length + size, 2 * length) } else { length + size }',
            '    immut grown = blankString(length + size, capacity)',
            '    memcpy(stringBytes(grown), stringBytes(a), length)',
            '    encode(offset(stringBytes(grown), length), code)',
            '    return grown',
            '}',
            '',
            '// `a` (given up) followed by `size` bytes of UTF-8 at `more`, which are not in `a`.',
            'function appendBytes(take a: string, more: Address, size: int): string {',
            '    immut length = stringSize(a)',
            '',
            '    if (stringReferences(a) == 1 and length + size <= stringCapacity(a)) {',
            '        memcpy(offset(stringBytes(a), length), more, size)',
            '        setStringSize(a, length + size)',
            '        return a',
            '    }',
            '',
            '    // A block of its own: twice as large when it grows in place, the exact size for a shared one.',
            '    immut capacity = if (stringReferences(a) == 1) { maxOf(length + size, 2 * length) } else { length + size }',
            '    immut grown = blankString(length + size, capacity)',
            '    immut bytes = stringBytes(grown)',
            '    memcpy(bytes, stringBytes(a), length)',
            '    memcpy(offset(bytes, length), more, size)',
            '    return grown',
            '}',
            '',
            '// `text * count` (an empty string for a count below 1).',
            'extern function koji_string_repeat(text: string, count: int): string {',
            '    immut size = stringSize(text)',
            '    immut times = maxOf(count, 0)',
            '    immut repeated = blankString(size * times, size * times)',
            '    immut bytes = stringBytes(repeated)',
            '',
            '    for i in range(times) {',
            '        memcpy(offset(bytes, i * size), stringBytes(text), size)',
            '    }',
            '',
            '    return repeated',
            '}',
            '',
            'extern function koji_string_equal(a: string, b: string): boolean {',
            '    immut size = stringSize(a)',
            '',
            '    if (size != stringSize(b)) { return false }',
            '',
            '    return memcmp(stringBytes(a), stringBytes(b), size) == 0',
            '}',
            '',
            '// -1, 0 or 1, comparing the bytes.',
            'extern function koji_string_compare(a: string, b: string): CInt {',
            '    immut sizeA = stringSize(a)',
            '    immut sizeB = stringSize(b)',
            '    immut order = memcmp(stringBytes(a), stringBytes(b), minOf(sizeA, sizeB))',
            '',
            '    if (order != 0) { return if (order < 0) { -1 } else { 1 } }',
            '',
            '    if (sizeA == sizeB) { return 0 }',
            '',
            '    return if (sizeA < sizeB) { -1 } else { 1 }',
            '}',
            '',
            'extern function koji_string_from_int(value: int): string {',
            '    // The magnitude, `int.min` too, and the number of its digits.',
            '    immut nothing: U128 = 0',
            '    immut magnitude = if (value < 0) { nothing - wide(value, -1) } else { wide(value, 0) }',
            '    mut count = 1',
            '    mut limit: U128 = 10',
            '',
            '    while (count < 20 and magnitude >= limit) {',
            '        count += 1',
            '        limit = limit * 10',
            '    }',
            '',
            '    immut sign = if (value < 0) { 1 } else { 0 }',
            '    immut text = blankString(count + sign, count + sign)',
            '    immut bytes = stringBytes(text)',
            '',
            '    if (value < 0) { write(bytes, 0, byte(45)) }',
            '',
            '    // The digits, from the last one.',
            '    mut rest = magnitude',
            '    mut at = count + sign - 1',
            '',
            '    while (at >= sign) {',
            '        immut quotient = rest / 10',
            '        write(bytes, at, byte(48 + lowWord(rest - quotient * 10)))',
            '        rest = quotient',
            '        at -= 1',
            '    }',
            '',
            '    return text',
            '}',
            '',
            'extern function koji_string_from_bool(value: boolean): string {',
            '    return if (value) { \'true\' } else { \'false\' }',
            '}',
            '',
            '// The text of a char (`print`): a code that is no character is U+FFFD.',
            'extern function koji_string_from_char(c: char): string {',
            '    return charText(c.code())',
            '}',
            '',
            '// A char as written in code: `\'a\'`, `\'\\n\'`.',
            'extern function koji_char_repr(c: char): string {',
            '    immut code = c.code()',
            '    return `\'${escaped(code, charText(code))}\'`',
            '}',
            '',
            'function charText(given: int): string {',
            '    immut code = validCode(given)',
            '    immut size = utf8Size(code)',
            '    immut text = blankString(size, size)',
            '    encode(stringBytes(text), code)',
            '    return text',
            '}',
            '',
            '// The text as written in code: in quotes, with `\\\\`, `\\\'`, `\\n`, `\\t` and `\\r` escaped.',
            'extern function koji_string_repr(text: string): string {',
            '    immut bytes = stringBytes(text)',
            '    immut size = stringSize(text)',
            '    mut out = \'\\\'\'',
            '    mut start = 0',
            '',
            '    for i in range(size) {',
            '        immut b: byte = read(bytes, i)',
            '        immut escape = escapeOf(int(b))',
            '',
            '        if (escape == \'\') { continue }',
            '',
            '        if (i > start) { out += newString(offset(bytes, start), i - start) }',
            '',
            '        out += escape',
            '        start = i + 1',
            '    }',
            '',
            '    if (size > start) { out += newString(offset(bytes, start), size - start) }',
            '',
            '    return out + \'\\\'\'',
            '}',
            '',
            '// The escape of a character of code below 128 (`\\n`), or `\'\'`.',
            'function escapeOf(code: int): string {',
            '    return match (code) {',
            '        39 => \'\\\\\\\'\'',
            '        92 => \'\\\\\\\\\'',
            '        10 => \'\\\\n\'',
            '        9 => \'\\\\t\'',
            '        13 => \'\\\\r\'',
            '        _ => \'\'',
            '    }',
            '}',
            '',
            'function escaped(code: int, text: string): string {',
            '    immut escape = if (code < 128) { escapeOf(code) } else { \'\' }',
            '    return if (escape == \'\') { text } else { escape }',
            '}',
            '',
            '// The number of characters (not bytes).',
            'extern function koji_string_length(text: string): int {',
            '    immut bytes = stringBytes(text)',
            '    mut count = 0',
            '',
            '    for i in range(stringSize(text)) {',
            '        immut b: byte = read(bytes, i)',
            '',
            '        if ((b & 0xC0) != 0x80) { count += 1 }',
            '    }',
            '',
            '    return count',
            '}',
            '',
            '// `needle in haystack`.',
            'extern function koji_string_contains(haystack: string, needle: string): boolean {',
            '    return containsText(haystack, needle)',
            '}',
            '',
            '// `c in text`.',
            'extern function koji_string_contains_char(haystack: string, c: char): boolean {',
            '    immut code = validCode(c.code())',
            '',
            '    // A byte: `memchr`.',
            '    if (code < 0x80) { return distance(stringBytes(haystack), memchr(stringBytes(haystack), code, stringSize(haystack))) >= 0 }',
            '',
            '    return containsText(haystack, charText(code))',
            '}',
            '',
            '// The needle is a string, which lives while its bytes are read (the address of the bytes of a',
            '// string does not keep it alive: a string is dropped after its last use).',
            'function containsText(haystack: string, needle: string): boolean {',
            '    if (stringSize(needle) == 0) { return true }',
            '',
            '    immut found = memmem(stringBytes(haystack), stringSize(haystack), stringBytes(needle), stringSize(needle))',
            '    return distance(stringBytes(haystack), found) >= 0',
            '}',
            '',
            '// The hash of the bytes and of their length (`ab` + `c` and `a` + `bc` differ in lists of',
            '// strings): a multiply and a rotation for each 8 bytes. Its low bits are not mixed: a map takes',
            '// the high bits of the hash times a large odd number, which depend on all of them.',
            'extern function koji_string_hash(text: string): int {',
            '    immut bytes = stringBytes(text)',
            '    immut size = stringSize(text)',
            '    mut hash: U128 = 0',
            '    mut at = 0',
            '',
            '    while (at + 8 <= size) {',
            '        immut chunk: int = read(bytes, at)',
            '        hash = mixed(hash, wide(chunk, 0))',
            '        at += 8',
            '    }',
            '',
            '    if (at < size) {',
            '        // The last bytes, little-endian, with zeros after them.',
            '        mut chunk: U128 = 0',
            '        mut i = size - 1',
            '',
            '        while (i >= at) {',
            '            immut b: byte = read(bytes, i)',
            '            chunk = (chunk << 8) | wide(int(b), 0)',
            '            i -= 1',
            '        }',
            '',
            '        hash = mixed(hash, chunk)',
            '    }',
            '',
            '    return lowWord(mixed(hash, wide(size, 0)))',
            '}',
            '',
            '// (rotate_left(hash, 5) ^ word) * K, in 64 bits.',
            'export function mixed(hash: U128, chunk: U128): U128 {',
            '    immut mask = wide(-1, 0)',
            '    immut rotated = ((hash << 5) | (hash >> 59)) & mask',
            '    return wordProduct(rotated ^ chunk, wide(0x517CC1B727220A95, 0)) & mask',
            '}',
            '',
            '// The code of a character: U+FFFD for a code that is none (above U+10FFFF, or a surrogate).',
            'function validCode(code: int): int {',
            '    return if (code < 0 or code > 0x10FFFF or (code >= 0xD800 and code <= 0xDFFF)) { 0xFFFD } else { code }',
            '}',
            '',
            '// The bytes of a character in UTF-8.',
            'function utf8Size(code: int): int {',
            '    if (code < 0x80) { return 1 }',
            '',
            '    if (code < 0x800) { return 2 }',
            '',
            '    return if (code < 0x10000) { 3 } else { 4 }',
            '}',
            '',
            '// The UTF-8 bytes of the character `code` (valid) at `buffer`, and their number.',
            'function encode(buffer: Address, code: int): int {',
            '    if (code < 0x80) {',
            '        write(buffer, 0, byte(code))',
            '        return 1',
            '    }',
            '',
            '    if (code < 0x800) {',
            '        write(buffer, 0, byte(0xC0 | (code >> 6)))',
            '        write(buffer, 1, byte(0x80 | (code & 0x3F)))',
            '        return 2',
            '    }',
            '',
            '    if (code < 0x10000) {',
            '        write(buffer, 0, byte(0xE0 | (code >> 12)))',
            '        write(buffer, 1, byte(0x80 | ((code >> 6) & 0x3F)))',
            '        write(buffer, 2, byte(0x80 | (code & 0x3F)))',
            '        return 3',
            '    }',
            '',
            '    write(buffer, 0, byte(0xF0 | (code >> 18)))',
            '    write(buffer, 1, byte(0x80 | ((code >> 12) & 0x3F)))',
            '    write(buffer, 2, byte(0x80 | ((code >> 6) & 0x3F)))',
            '    write(buffer, 3, byte(0x80 | (code & 0x3F)))',
            '    return 4',
            '}',
            '',
            'function maxOf(a: int, b: int): int {',
            '    return if (a > b) { a } else { b }',
            '}',
            '',
            'function minOf(a: int, b: int): int {',
            '    return if (a < b) { a } else { b }',
            '}',
            '',
            '// `text[index]`: the character at that position (in characters).',
            'extern function koji_std_string_char_at(text: string, index: int, here: Location): char {',
            '    immut bytes = stringBytes(text)',
            '    immut size = stringSize(text)',
            '    immut at = byteOfChar(bytes, size, index)',
            '',
            '    if (index < 0 or at >= size) { panicAt(here, `index ${index} out of range (length ${koji_string_length(text)})`) }',
            '',
            '    return charOfCode(codeAt(bytes, at))',
            '}',
            '',
            '// `text[start..end]` (in characters); a missing bound is the start or the end.',
            'extern function koji_std_string_slice(text: string, hasStart: boolean, start: int, hasEnd: boolean, end: int, here: Location): string {',
            '    immut bytes = stringBytes(text)',
            '    immut size = stringSize(text)',
            '    immut length = koji_string_length(text)',
            '    immut first = if (hasStart) { start } else { 0 }',
            '    immut last = if (hasEnd) { end } else { length }',
            '',
            '    if (first < 0 or last > length or first > last) { panicAt(here, `slice ${first}..${last} out of range (length ${length})`) }',
            '',
            '    immut startByte = byteOfChar(bytes, size, first)',
            '    immut endByte = byteOfChar(bytes, size, last)',
            '    return newString(offset(bytes, startByte), endByte - startByte)',
            '}',
            '',
            '// The byte where the character `index` starts (the size for the end, or past it).',
            'function byteOfChar(bytes: Address, size: int, index: int): int {',
            '    if (index <= 0) { return 0 }',
            '',
            '    mut count = 0',
            '',
            '    for at in range(size) {',
            '        immut b: byte = read(bytes, at)',
            '',
            '        if ((b & 0xC0) != 0x80) {',
            '            if (count == index) { return at }',
            '',
            '            count += 1',
            '        }',
            '    }',
            '',
            '    return size',
            '}',
            '',
            '// The code of the character that starts at `at` (the bytes are UTF-8).',
            'function codeAt(bytes: Address, at: int): int {',
            '    immut first: byte = read(bytes, at)',
            '',
            '    if (first < 0x80) { return int(first) }',
            '',
            '    immut width = if (first < 0xE0) { 2 } else { if (first < 0xF0) { 3 } else { 4 } }',
            '    mut code = int(first & (0x7F >> byte(width)))',
            '',
            '    for i in range(1, width) {',
            '        immut next: byte = read(bytes, at + i)',
            '        code = (code << 6) | int(next & 0x3F)',
            '    }',
            '',
            '    return code',
            '}',
            '',
            '// The methods of strings that need the tables of Unicode (std/koji/unicode.kj, as Rust has them).',
            '// A table is read from its text the first time it is needed.',
            '',
            '// The mappings of upper and lower case: runs of 4 ints (the first and last characters, a stride and',
            '// the character of the first), in order; a negative character `t` is the record -1 - t of the',
            '// table of multiple mappings. And the last run found, as a text keeps to a few alphabets.',
            'mut upperRuns = nullAddress()',
            'mut upperCount = 0',
            'mut upperLast = 0',
            'mut lowerRuns = nullAddress()',
            'mut lowerCount = 0',
            'mut lowerLast = 0',
            '// The tables of ranges (pairs of ints), with their numbers of ranges: `alphabetic`, `numeric`,',
            '// `lowercase`, `uppercase`, `cased` and `ignorable`.',
            'immut rangeTables = zeroed(6 * 16)',
            '',
            'function zeroed(size: int): Address {',
            '    immut block = allocate(size)',
            '',
            '    for i in range(size / 8) {',
            '        write(block, i * 8, 0)',
            '    }',
            '',
            '    return block',
            '}',
            '',
            '// `text.upper()`.',
            'extern function koji_std_string_upper(text: string): string {',
            '    return withCase(text, true)',
            '}',
            '',
            '// `text.lower()`.',
            'extern function koji_std_string_lower(text: string): string {',
            '    return withCase(text, false)',
            '}',
            '',
            '// The upper or the lower case of a text, in a string that grows when a character becomes longer.',
            'function withCase(text: string, upper: boolean): string {',
            '    immut bytes = stringBytes(text)',
            '    immut size = stringSize(text)',
            '    mut capacity = size + 16',
            '    mut out = blankString(capacity, capacity)',
            '    mut place = stringBytes(out)',
            '    mut written = 0',
            '    mut at = 0',
            '',
            '    while (at < size) {',
            '        if (written + 12 > capacity) {',
            '            capacity = capacity * 2',
            '            immut grown = blankString(capacity, capacity)',
            '            memcpy(stringBytes(grown), place, written)',
            '            out = grown',
            '            place = stringBytes(out)',
            '        }',
            '',
            '        immut first: byte = read(bytes, at)',
            '',
            '        if (first < 0x80) {',
            '            write(place, written, asciiCase(first, upper))',
            '            written += 1',
            '            at += 1',
            '            continue',
            '        }',
            '',
            '        immut code = codeAt(bytes, at)',
            '        immut mapped = mappingOf(code, upper)',
            '',
            '        // `Σ` at the end of a word is `ς`.',
            '        if (mapped == 0x3C3 and code == 0x3A3 and not upper and finalSigma(bytes, at, size)) {',
            '            written += encode(offset(place, written), 0x3C2)',
            '        } else {',
            '            written += putMapped(offset(place, written), mapped, upper)',
            '        }',
            '',
            '        at += widthOf(first)',
            '    }',
            '',
            '    setStringSize(out, written)',
            '    return out',
            '}',
            '',
            'function asciiCase(b: byte, upper: boolean): byte {',
            '    if (upper) { return if (b >= 97 and b <= 122) { b - 32 } else { b } }',
            '',
            '    return if (b >= 65 and b <= 90) { b + 32 } else { b }',
            '}',
            '',
            '// Writes the character or the characters of a mapping at `place`: the bytes written.',
            'function putMapped(place: Address, mapped: int, upper: boolean): int {',
            '    if (mapped >= 0) { return encode(place, mapped) }',
            '',
            '    immut many = if (upper) { upperMultiple } else { lowerMultiple }',
            '    immut digits = stringBytes(many)',
            '    immut record = (-1 - mapped) * 25',
            '    mut written = 0',
            '',
            '    for i in range(hexAt(digits, record + 6, 1)) {',
            '        written += encode(offset(place, written), hexAt(digits, record + 7 + i * 6, 6))',
            '    }',
            '',
            '    return written',
            '}',
            '',
            '// The case of a character: a character, or a negative number for several (see `upperRuns`).',
            'function mappingOf(code: int, upper: boolean): int {',
            '    if (upper and isNull(upperRuns)) { upperRuns = decodeRuns(upperSingle, upperMultiple, mut upperCount) }',
            '',
            '    if (not upper and isNull(lowerRuns)) { lowerRuns = decodeRuns(lowerSingle, lowerMultiple, mut lowerCount) }',
            '',
            '    immut runs = if (upper) { upperRuns } else { lowerRuns }',
            '    immut index = runOf(runs, if (upper) { upperCount } else { lowerCount }, code, if (upper) { upperLast } else { lowerLast })',
            '',
            '    if (index < 0) { return code }',
            '',
            '    if (upper) {',
            '        upperLast = index',
            '    } else {',
            '        lowerLast = index',
            '    }',
            '',
            '    immut start: int = read(runs, index * 32)',
            '    immut stride: int = read(runs, index * 32 + 16)',
            '    immut target: int = read(runs, index * 32 + 24)',
            '',
            '    if (target < 0) { return target }',
            '',
            '    if ((code - start) % stride != 0) { return code }',
            '',
            '    return target + code - start',
            '}',
            '',
            '// The run of `code`, or -1: the run `hint` first.',
            'function runOf(runs: Address, count: int, code: int, hint: int): int {',
            '    if (hint < count) {',
            '        immut start: int = read(runs, hint * 32)',
            '        immut end: int = read(runs, hint * 32 + 8)',
            '',
            '        if (code >= start and code <= end) { return hint }',
            '    }',
            '',
            '    // The first run that starts after `code`, and the one before it.',
            '    mut low = 0',
            '    mut high = count',
            '',
            '    while (low < high) {',
            '        immut middle = (low + high) >> 1',
            '        immut start: int = read(runs, middle * 32)',
            '',
            '        if (start <= code) {',
            '            low = middle + 1',
            '        } else {',
            '            high = middle',
            '        }',
            '    }',
            '',
            '    if (low == 0) { return -1 }',
            '',
            '    immut end: int = read(runs, (low - 1) * 32 + 8)',
            '    return if (code <= end) { low - 1 } else { -1 }',
            '}',
            '',
            '// The runs of a table of single mappings (a start, an end, a stride and the character of the start)',
            '// and of multiple mappings (the character, their number and three characters), in order.',
            'function decodeRuns(single: string, many: string, mut count: int): Address {',
            '    immut singleDigits = stringBytes(single)',
            '    immut manyDigits = stringBytes(many)',
            '    immut singles = stringSize(single) / 19',
            '    immut multiples = stringSize(many) / 25',
            '    immut runs = allocate((singles + multiples) * 32)',
            '    mut i = 0',
            '    mut j = 0',
            '    count = 0',
            '',
            '    while (i < singles or j < multiples) {',
            '        immut at = count * 32',
            '',
            '        if (j >= multiples or (i < singles and hexAt(singleDigits, i * 19, 6) < hexAt(manyDigits, j * 25, 6))) {',
            '            write(runs, at, hexAt(singleDigits, i * 19, 6))',
            '            write(runs, at + 8, hexAt(singleDigits, i * 19 + 6, 6))',
            '            write(runs, at + 16, hexAt(singleDigits, i * 19 + 12, 1))',
            '            write(runs, at + 24, hexAt(singleDigits, i * 19 + 13, 6))',
            '            i += 1',
            '        } else {',
            '            immut code = hexAt(manyDigits, j * 25, 6)',
            '            write(runs, at, code)',
            '            write(runs, at + 8, code)',
            '            write(runs, at + 16, 1)',
            '            write(runs, at + 24, -1 - j)',
            '            j += 1',
            '        }',
            '',
            '        count += 1',
            '    }',
            '',
            '    return runs',
            '}',
            '',
            '// Whether the `Σ` at `at` ends a word: after a cased character and before none, the characters',
            '// that case ignores aside (as Rust\'s `to_lowercase`).',
            'function finalSigma(bytes: Address, at: int, size: int): boolean {',
            '    mut before = at',
            '    mut casedBefore = false',
            '',
            '    while (before > 0) {',
            '        mut start = before - 1',
            '',
            '        while (isContinuation(bytes, start)) {',
            '            start -= 1',
            '        }',
            '',
            '        immut code = codeAt(bytes, start)',
            '',
            '        if (not inTable(5, code)) {',
            '            casedBefore = inTable(4, code)',
            '            break',
            '        }',
            '',
            '        before = start',
            '    }',
            '',
            '    if (not casedBefore) { return false }',
            '',
            '    mut after = at + 2',
            '',
            '    while (after < size) {',
            '        immut code = codeAt(bytes, after)',
            '',
            '        if (not inTable(5, code)) { return not inTable(4, code) }',
            '',
            '        immut first: byte = read(bytes, after)',
            '        after += widthOf(first)',
            '    }',
            '',
            '    return true',
            '}',
            '',
            '// The `is...` methods: `test` is 0 `isSpace`, 1 `isNumeric`, 2 `isAlpha`, 3 `isAlphaNumeric`,',
            '// 4 `isUpper`, 5 `isLower`, 6 `isTitle`.',
            'extern function koji_std_string_is(text: string, test: CInt): boolean {',
            '    immut bytes = stringBytes(text)',
            '    immut size = stringSize(text)',
            '',
            '    if (test == 6) { return isTitle(bytes, size) }',
            '',
            '    if (test <= 3 and size == 0) { return false }',
            '',
            '    mut hasCase = false',
            '    mut at = 0',
            '',
            '    while (at < size) {',
            '        immut first: byte = read(bytes, at)',
            '        immut code = if (first < 0x80) { int(first) } else { codeAt(bytes, at) }',
            '        at += widthOf(first)',
            '',
            '        if (test == 0 and not isSpace(code)) { return false }',
            '',
            '        if (test == 1 and not isNumeric(code)) { return false }',
            '',
            '        if (test == 2 and not isAlphabetic(code)) { return false }',
            '',
            '        if (test == 3 and not isAlphabetic(code) and not isNumeric(code)) { return false }',
            '',
            '        if (test == 4) {',
            '            if (isLower(code)) { return false }',
            '',
            '            if (isUpper(code)) { hasCase = true }',
            '        }',
            '',
            '        if (test == 5) {',
            '            if (isUpper(code)) { return false }',
            '',
            '            if (isLower(code)) { hasCase = true }',
            '        }',
            '    }',
            '',
            '    return test <= 3 or hasCase',
            '}',
            '',
            '// Every word starts with an upper case letter, followed by lower case ones (as Python\'s `istitle`).',
            'function isTitle(bytes: Address, size: int): boolean {',
            '    mut hasCase = false',
            '    mut previous = false',
            '    mut at = 0',
            '',
            '    while (at < size) {',
            '        immut first: byte = read(bytes, at)',
            '        immut code = if (first < 0x80) { int(first) } else { codeAt(bytes, at) }',
            '        at += widthOf(first)',
            '',
            '        if (isUpper(code)) {',
            '            if (previous) { return false }',
            '',
            '            previous = true',
            '            hasCase = true',
            '            continue',
            '        }',
            '',
            '        if (isLower(code)) {',
            '            if (not previous) { return false }',
            '',
            '            hasCase = true',
            '            continue',
            '        }',
            '',
            '        previous = false',
            '    }',
            '',
            '    return hasCase',
            '}',
            '',
            'export function isAlphabetic(code: int): boolean {',
            '    if (code < 0x80) { return (code >= 65 and code <= 90) or (code >= 97 and code <= 122) }',
            '',
            '    return inTable(0, code)',
            '}',
            '',
            'export function isNumeric(code: int): boolean {',
            '    if (code < 0x80) { return code >= 48 and code <= 57 }',
            '',
            '    return inTable(1, code)',
            '}',
            '',
            'function isLower(code: int): boolean {',
            '    if (code < 0x80) { return code >= 97 and code <= 122 }',
            '',
            '    return inTable(2, code)',
            '}',
            '',
            'function isUpper(code: int): boolean {',
            '    if (code < 0x80) { return code >= 65 and code <= 90 }',
            '',
            '    return inTable(3, code)',
            '}',
            '',
            '// The bytes of the character whose first byte is `first`.',
            'function widthOf(first: byte): int {',
            '    if (first < 0x80) { return 1 }',
            '',
            '    if (first < 0xE0) { return 2 }',
            '',
            '    return if (first < 0xF0) { 3 } else { 4 }',
            '}',
            '',
            '// Whether `code` is in the table of ranges `id` (see `rangeTables`).',
            'function inTable(id: int, code: int): boolean {',
            '    mut ranges: Address = read(rangeTables, id * 16)',
            '',
            '    if (isNull(ranges)) { ranges = decodeRanges(id) }',
            '',
            '    mut low = 0',
            '    mut high: int = read(rangeTables, id * 16 + 8)',
            '',
            '    while (low < high) {',
            '        immut middle = (low + high) >> 1',
            '        immut start: int = read(ranges, middle * 16)',
            '',
            '        if (code < start) {',
            '            high = middle',
            '            continue',
            '        }',
            '',
            '        immut end: int = read(ranges, middle * 16 + 8)',
            '',
            '        if (code > end) {',
            '            low = middle + 1',
            '            continue',
            '        }',
            '',
            '        return true',
            '    }',
            '',
            '    return false',
            '}',
            '',
            '// The ranges of a table (a start and an end, 6 digits each), as ints.',
            'function decodeRanges(id: int): Address {',
            '    immut table = rangeText(id)',
            '    immut digits = stringBytes(table)',
            '    immut count = stringSize(table) / 12',
            '    immut ranges = allocate(count * 16 + 16)',
            '',
            '    for i in range(count) {',
            '        write(ranges, i * 16, hexAt(digits, i * 12, 6))',
            '        write(ranges, i * 16 + 8, hexAt(digits, i * 12 + 6, 6))',
            '    }',
            '',
            '    write(rangeTables, id * 16, ranges)',
            '    write(rangeTables, id * 16 + 8, count)',
            '    return ranges',
            '}',
            '',
            'function rangeText(id: int): string {',
            '    return match (id) {',
            '        0 => alphabetic',
            '        1 => numeric',
            '        2 => lowercase',
            '        3 => uppercase',
            '        4 => cased',
            '        _ => ignorable',
            '    }',
            '}',
            '',
            '// The number written in `count` hexadecimal digits at `at`.',
            'function hexAt(digits: Address, at: int, count: int): int {',
            '    mut value = 0',
            '',
            '    for i in range(count) {',
            '        immut b: byte = read(digits, at + i)',
            '        value = (value << 4) | int(if (b <= 57) { b - 48 } else { b - 87 })',
            '    }',
            '',
            '    return value',
            '}',
            '',
            '// The block of a string: 3 words (its count of references, its size and the bytes its block holds,',
            '// a multiple of 8), then its bytes, from the pool for a short one (runtime/prelude.h makes them).',
            '',
            '// A new string of the bytes `bytes[..size]` (bytes that are not UTF-8 become U+FFFD).',
            'extern function koji_string_new(bytes: Address, size: CSize): string {',
            '    if (isUtf8(bytes, size)) { return koji_string_from_utf8(bytes, size) }',
            '',
            '    return textOf(bytes, size)',
            '}',
            '',
            '// A new string of the bytes `bytes[..size]`, which are UTF-8 (`newString` of `koji:unsafe`).',
            'extern function koji_string_from_utf8(bytes: Address, size: CSize): string {',
            '    immut text = blankString(size, size)',
            '    memcpy(stringBytes(text), bytes, size)',
            '    return text',
            '}',
            '',
            '// Frees a string without references (the prelude releases strings inline).',
            'extern function koji_string_free(text: Address) {',
            '    immut capacity: int = read(text, 16)',
            '    koji_memory_give(text, 3 + capacity / 8)',
            '}',
        ].join('\n'))
    }

    if (name == 'koji:tls') {
        return Some([
            '// `koji:tls`: the client of TLS 1.3 (RFC 8446), in the library of the runtime written in Koji, for',
            '// `https://` (std/http.kj). Only TLS 1.3, as decided (most servers have it; a few still have only',
            '// TLS 1.2): the key exchange X25519 (or P-256 and P-384, when the server asks for them with a',
            '// HelloRetryRequest); AES-128-GCM, AES-256-GCM and ChaCha20-Poly1305, AES first when the processor has',
            '// its instructions (koji:aes), ChaCha20-Poly1305 alone otherwise; the certificate of the server',
            '// verified by koji:x509 with the authorities of the system or Mozilla\'s list, and its proof',
            '// (CertificateVerify) by its key (ECDSA or RSA-PSS). No resumption, no early data, no certificate of',
            '// the client (an empty one when the server asks). After the handshake, records of up to 16 KB each',
            '// way, KeyUpdate in both directions, and the tickets of the server ignored.',
            '//',
            '// A connection is a handle (an int) for C and std/http.kj: koji_tls_connect on a connected socket,',
            '// koji_tls_send, koji_tls_receive, koji_tls_close, and the text of a problem.',
            '',
            'import { Address, CInt, CSize, allocate, free, isNull, newString, nullAddress, offset, read, stringBytes, stringSize, write } from \'koji:unsafe\'',
            'import { digest, digestSize, hkdfExpand, hkdfExtract, hmac } from \'koji:sha\'',
            'import { x25519, x25519Base } from \'koji:x25519\'',
            'import { publicKey, sharedSecret } from \'koji:ecc\'',
            'import { Algorithm, Authority, Certificate, PublicKey, authoritiesOfPem, certificateOf, now, problemText, trustedAuthorities, verifyChain, verifySignature } from \'koji:x509\'',
            'import aes from \'koji:aes\'',
            'import chacha from \'koji:chacha\'',
            '',
            'extern function memcpy(target: Address, source: Address, size: CSize): Address',
            'extern function memset(target: Address, value: CInt, size: CSize): Address',
            'extern function memcmp(a: Address, b: Address, size: CSize): CInt',
            'extern function strlen(text: Address): CSize',
            'extern function getentropy(buffer: Address, size: CSize): CInt',
            'extern function realloc(block: Address, size: CSize): Address',
            'extern function koji_net_send(fd: int, bytes: Address, size: int): int',
            'extern function koji_net_receive(fd: int, bytes: Address, size: int): int',
            'extern function koji_system_errno(): CInt',
            '',
            '// The problems of a connection: those of koji:x509 (1 to 7) for the certificate, then these, and',
            '// 1000 + n for the alert n sent by the server.',
            'immut badMessage = 20',
            'immut notOffered = 21',
            'immut badRecord = 22',
            'immut closedEarly = 23',
            'immut systemError = 24',
            'immut badProof = 25',
            'immut badFinished = 26',
            'immut noRandom = 27',
            'immut truncated = 28',
            'immut notTls = 29',
            'immut alertBase = 1000',
            '',
            '// The text of a problem.',
            'export function problemMessage(problem: int): string {',
            '    // protocol_version: the server has no TLS 1.3 (some still have only TLS 1.2).',
            '    if (problem == alertBase + 70) { return \'the server does not support TLS 1.3 (the only version of TLS that Koji speaks)\' }',
            '',
            '    if (problem >= alertBase) { return `the server sent the alert ${alertName(problem - alertBase)}` }',
            '',
            '    if (problem < badMessage) { return `invalid certificate: ${problemText(problem)}` }',
            '',
            '    return match (problem) {',
            '        20 => \'the server sent a malformed or unexpected message\'',
            '        21 => \'the server chose a parameter that was not offered\'',
            '        22 => \'a record could not be decrypted\'',
            '        23 => \'the server closed the connection during the handshake\'',
            '        24 => \'the connection failed\'',
            '        25 => \'the proof of the server\\\'s key (CertificateVerify) is invalid\'',
            '        26 => \'the Finished message of the server is invalid\'',
            '        27 => \'the system gave no random bytes\'',
            '        29 => \'the server does not speak TLS (it answered something else)\'',
            '        _ => \'the connection closed without close_notify: the data may be truncated\'',
            '    }',
            '}',
            '',
            'function alertName(description: int): string {',
            '    return match (description) {',
            '        0 => \'close_notify\'',
            '        10 => \'unexpected_message\'',
            '        20 => \'bad_record_mac\'',
            '        22 => \'record_overflow\'',
            '        40 => \'handshake_failure\'',
            '        42 => \'bad_certificate\'',
            '        43 => \'unsupported_certificate\'',
            '        44 => \'certificate_revoked\'',
            '        45 => \'certificate_expired\'',
            '        46 => \'certificate_unknown\'',
            '        47 => \'illegal_parameter\'',
            '        48 => \'unknown_ca\'',
            '        49 => \'access_denied\'',
            '        50 => \'decode_error\'',
            '        51 => \'decrypt_error\'',
            '        70 => \'protocol_version\'',
            '        71 => \'insufficient_security\'',
            '        80 => \'internal_error\'',
            '        86 => \'inappropriate_fallback\'',
            '        90 => \'user_canceled\'',
            '        109 => \'missing_extension\'',
            '        110 => \'unsupported_extension\'',
            '        112 => \'unrecognized_name\'',
            '        113 => \'bad_certificate_status_response\'',
            '        115 => \'unknown_psk_identity\'',
            '        116 => \'certificate_required\'',
            '        120 => \'no_application_protocol\'',
            '        _ => `${description}`',
            '    }',
            '}',
            '',
            'function byteAt(bytes: Address, i: int): int {',
            '    immut b: byte = read(bytes, i)',
            '    return int(b)',
            '}',
            '',
            'function number(bytes: Address, at: int, size: int): int {',
            '    mut value = 0',
            '',
            '    for i in range(size) {',
            '        value = (value << 8) | byteAt(bytes, at + i)',
            '    }',
            '',
            '    return value',
            '}',
            '',
            '// Buffers',
            '',
            '// Bytes that grow: `size` of them at `bytes` (room for `capacity`).',
            'type Buffer = {',
            '    bytes: Address',
            '    size: int',
            '    capacity: int',
            '}',
            '',
            'function newBuffer(capacity: int): Buffer {',
            '    return { bytes: allocate(capacity), size: 0, capacity: capacity }',
            '}',
            '',
            'function reserve(mut b: Buffer, more: int) {',
            '    if (b.size + more > b.capacity) {',
            '        mut capacity = b.capacity * 2',
            '',
            '        while (capacity < b.size + more) {',
            '            capacity *= 2',
            '        }',
            '',
            '        b.bytes = realloc(b.bytes, capacity)',
            '        b.capacity = capacity',
            '    }',
            '}',
            '',
            '// The value in `size` bytes, big-endian.',
            'function putNumber(mut b: Buffer, value: int, size: int) {',
            '    reserve(mut b, size)',
            '',
            '    for i in range(size) {',
            '        write(b.bytes, b.size + i, byte((value >> (8 * (size - 1 - i))) & 0xFF))',
            '    }',
            '',
            '    b.size += size',
            '}',
            '',
            'function putBytes(mut b: Buffer, bytes: Address, size: int) {',
            '    reserve(mut b, size)',
            '    memcpy(offset(b.bytes, b.size), bytes, size)',
            '    b.size += size',
            '}',
            '',
            'function putText(mut b: Buffer, text: string) {',
            '    putBytes(mut b, stringBytes(text), stringSize(text))',
            '}',
            '',
            '// The size, in `size` bytes, of what was written after the place `at` reserved for it.',
            'function patchSize(b: Buffer, at: int, size: int) {',
            '    immut value = b.size - at - size',
            '',
            '    for i in range(size) {',
            '        write(b.bytes, at + i, byte((value >> (8 * (size - 1 - i))) & 0xFF))',
            '    }',
            '}',
            '',
            '// The key schedule',
            '',
            '// HKDF-Expand-Label: `length` bytes of the secret for the label and the context, at `out`.',
            'function expandLabel(hash: int, secret: Address, label: string, context: Address, contextSize: int, length: int, out: Address) {',
            '    mut info = newBuffer(64 + contextSize)',
            '    putNumber(mut info, length, 2)',
            '    putNumber(mut info, 6 + stringSize(label), 1)',
            '    putText(mut info, \'tls13 \')',
            '    putText(mut info, label)',
            '    putNumber(mut info, contextSize, 1)',
            '    putBytes(mut info, context, contextSize)',
            '    hkdfExpand(hash, secret, digestSize(hash), info.bytes, info.size, length, out)',
            '    free(info.bytes)',
            '}',
            '',
            '// Derive-Secret: the label with the digest of the transcript (`transcript`, a digest), at `out`.',
            'function deriveSecret(hash: int, secret: Address, label: string, transcript: Address, out: Address) {',
            '    expandLabel(hash, secret, label, transcript, digestSize(hash), digestSize(hash), out)',
            '}',
            '',
            '// The keys of one direction: the AEAD\'s key and IV, from a traffic secret, and the number of the',
            '// next record.',
            'type Direction = {',
            '    secret: Address',
            '    key: Address',
            '    aesKey: aes.AesKey',
            '    iv: Address',
            '    sequence: int',
            '}',
            '',
            '// The suite chosen: 0x1301 (AES-128-GCM, SHA-256), 0x1302 (AES-256-GCM, SHA-384) or 0x1303',
            '// (ChaCha20-Poly1305, SHA-256).',
            'function hashOfSuite(suite: int): int {',
            '    return if (suite == 0x1302) { 1 } else { 0 }',
            '}',
            '',
            'function keySizeOfSuite(suite: int): int {',
            '    return if (suite == 0x1301) { 16 } else { 32 }',
            '}',
            '',
            '// The keys of a traffic secret (which the direction keeps, for KeyUpdate).',
            'function directionOf(suite: int, secret: Address): Direction {',
            '    immut hash = hashOfSuite(suite)',
            '    immut length = digestSize(hash)',
            '    immut kept = allocate(length)',
            '    memcpy(kept, secret, length)',
            '    immut keySize = keySizeOfSuite(suite)',
            '    immut key = allocate(keySize)',
            '    expandLabel(hash, kept, \'key\', nullAddress(), 0, keySize, key)',
            '    immut iv = allocate(12)',
            '    expandLabel(hash, kept, \'iv\', nullAddress(), 0, 12, iv)',
            '    immut aesKey = if (suite == 0x1303) { aes.emptyKey() } else { aes.keyOf(key, keySize) }',
            '    return { secret: kept, key: key, aesKey: aesKey, iv: iv, sequence: 0 }',
            '}',
            '',
            'function releaseDirection(suite: int, d: Direction) {',
            '    immut length = digestSize(hashOfSuite(suite))',
            '    memset(d.secret, 0, length)',
            '    memset(d.key, 0, keySizeOfSuite(suite))',
            '    free(d.secret)',
            '    free(d.key)',
            '    free(d.iv)',
            '',
            '    if (suite != 0x1303) { aes.release(d.aesKey) }',
            '}',
            '',
            '// The next traffic secret (KeyUpdate).',
            'function updatedDirection(suite: int, d: Direction): Direction {',
            '    immut hash = hashOfSuite(suite)',
            '    immut length = digestSize(hash)',
            '    immut next = allocate(length)',
            '    expandLabel(hash, d.secret, \'traffic upd\', nullAddress(), 0, length, next)',
            '    immut updated = directionOf(suite, next)',
            '    memset(next, 0, length)',
            '    free(next)',
            '    releaseDirection(suite, d)',
            '    return updated',
            '}',
            '',
            '// The nonce of the next record: the IV xored with its number.',
            'function nonceOf(d: Direction, out: Address) {',
            '    memcpy(out, d.iv, 12)',
            '',
            '    for i in range(8) {',
            '        write(out, 4 + i, byte(byteAt(d.iv, 4 + i) ^ ((d.sequence >> (56 - 8 * i)) & 0xFF)))',
            '    }',
            '}',
            '',
            '// Connections',
            '',
            'type Session = {',
            '    fd: int',
            '    suite: int',
            '    // The handshake and then the application keys of each direction (`keyed` once they exist).',
            '    keyed: boolean',
            '    reading: Direction',
            '    writing: Direction',
            '    // A record read: `recordSize` bytes, of which `used` given already (its plaintext, after the',
            '    // type removed).',
            '    record: Address',
            '    recordSize: int',
            '    used: int',
            '    recordType: int',
            '    // Handshake messages read and not yet taken, in order.',
            '    pending: Buffer',
            '    // A CertificateRequest of the server, and its context (answered with no certificate).',
            '    requested: boolean',
            '    requestContext: Buffer',
            '    closed: boolean',
            '    problem: int',
            '}',
            '',
            '// The sessions by handle (handle - 1); `fd` -1 for a free one.',
            'mut sessions: Session[] = []',
            '',
            '// The largest records: 16384 bytes of plaintext, and 256 more when encrypted.',
            'immut largestPlaintext = 16384',
            'immut largestRecord = 16384 + 256',
            '',
            'function noDirection(): Direction {',
            '    return { secret: nullAddress(), key: nullAddress(), aesKey: aes.emptyKey(), iv: nullAddress(), sequence: 0 }',
            '}',
            '',
            'function newSession(fd: int): Session {',
            '    return {',
            '        fd: fd, suite: 0, keyed: false, reading: noDirection(), writing: noDirection(),',
            '        record: allocate(largestRecord + 5), recordSize: 0, used: 0, recordType: 0, pending: newBuffer(4096), requested: false,',
            '        requestContext: newBuffer(16), closed: false, problem: 0',
            '    }',
            '}',
            '',
            '// The input and output of records',
            '',
            '// All the bytes, or false.',
            'function sendAll(fd: int, bytes: Address, size: int): boolean {',
            '    mut done = 0',
            '',
            '    while (done < size) {',
            '        immut put = koji_net_send(fd, offset(bytes, done), size - done)',
            '',
            '        if (put <= 0) { return false }',
            '',
            '        done += put',
            '    }',
            '',
            '    return true',
            '}',
            '',
            '// Exactly `size` bytes: how many came before the connection closed (or -1 for an error).',
            'function receiveExactly(fd: int, bytes: Address, size: int): int {',
            '    mut done = 0',
            '',
            '    while (done < size) {',
            '        immut got = koji_net_receive(fd, offset(bytes, done), size - done)',
            '',
            '        if (got < 0) { return -1 }',
            '',
            '        if (got == 0) { return done }',
            '',
            '        done += got',
            '    }',
            '',
            '    return done',
            '}',
            '',
            '// The last error of the system, for std/http.kj.',
            'mut lastErrno = 0',
            '',
            '// Sends a record of `type` with the `size` bytes at `data` (at most 16384): encrypted once the',
            '// session is keyed. False when the connection failed.',
            'function sendRecord(mut s: Session, kind: int, data: Address, size: int): boolean {',
            '    mut out = newBuffer(size + 32)',
            '    putNumber(mut out, if (s.keyed) { 23 } else { kind }, 1)',
            '    putNumber(mut out, 0x0303, 2)',
            '',
            '    if (s.keyed) {',
            '        // TLSInnerPlaintext: the data and its type; then sealed, with the header as additional data.',
            '        putNumber(mut out, size + 1 + 16, 2)',
            '        immut inner = allocate(size + 1)',
            '        memcpy(inner, data, size)',
            '        write(inner, size, byte(kind))',
            '        immut nonce = allocate(12)',
            '        nonceOf(s.writing, nonce)',
            '        reserve(mut out, size + 1 + 16)',
            '',
            '        if (s.suite == 0x1303) {',
            '            chacha.seal(s.writing.key, nonce, out.bytes, 5, inner, size + 1, offset(out.bytes, 5))',
            '        } else {',
            '            aes.seal(s.writing.aesKey, nonce, out.bytes, 5, inner, size + 1, offset(out.bytes, 5))',
            '        }',
            '',
            '        out.size += size + 1 + 16',
            '        s.writing.sequence += 1',
            '        free(nonce)',
            '        free(inner)',
            '    } else {',
            '        putNumber(mut out, size, 2)',
            '        putBytes(mut out, data, size)',
            '    }',
            '',
            '    immut sent = sendAll(s.fd, out.bytes, out.size)',
            '',
            '    if (not sent) { lastErrno = koji_system_errno() }',
            '',
            '    free(out.bytes)',
            '    return sent',
            '}',
            '',
            '// Sends an alert (best effort: the connection is failing).',
            'function sendAlert(mut s: Session, description: int) {',
            '    immut alert = allocate(2)',
            '    write(alert, 0, byte(2))',
            '    write(alert, 1, byte(description))',
            '    sendRecord(mut s, 21, alert, 2)',
            '    free(alert)',
            '}',
            '',
            '// Reads the next record into `s.record`: its type (the inner type once keyed; ChangeCipherSpec',
            '// records of the handshake skipped), or -1 with `s.problem` set. Its plaintext is `s.recordSize`',
            '// bytes.',
            'function receiveRecord(mut s: Session): int {',
            '    while (true) {',
            '        immut got = receiveExactly(s.fd, s.record, 5)',
            '',
            '        if (got < 0) {',
            '            lastErrno = koji_system_errno()',
            '            s.problem = systemError',
            '            return -1',
            '        }',
            '',
            '        if (got < 5) {',
            '            s.problem = if (got == 0) { closedEarly } else { badMessage }',
            '            return -1',
            '        }',
            '',
            '        immut kind = byteAt(s.record, 0)',
            '        immut size = number(s.record, 3, 2)',
            '',
            '        // Not a record of TLS at all (a server of HTTP answers `HTTP/1.1 ...`): the types of records',
            '        // are 20 to 23 and their versions 3.x.',
            '        if (kind < 20 or kind > 23 or byteAt(s.record, 1) != 3) {',
            '            s.problem = if (s.keyed) { badRecord } else { notTls }',
            '            return -1',
            '        }',
            '',
            '        if (size > largestRecord or (not s.keyed and size > largestPlaintext) or size == 0) {',
            '            s.problem = badRecord',
            '            return -1',
            '        }',
            '',
            '        immut body = receiveExactly(s.fd, offset(s.record, 5), size)',
            '',
            '        if (body < size) {',
            '            if (body < 0) { lastErrno = koji_system_errno() }',
            '',
            '            s.problem = if (body < 0) { systemError } else { closedEarly }',
            '            return -1',
            '        }',
            '',
            '        // ChangeCipherSpec (one byte 1), sent for middleboxes during the handshake: skipped.',
            '        if (kind == 20) {',
            '            if (size != 1 or byteAt(s.record, 5) != 1) {',
            '                s.problem = badMessage',
            '                return -1',
            '            }',
            '        } else {',
            '            if (not s.keyed or kind != 23) {',
            '                if (s.keyed or (kind != 22 and kind != 21)) {',
            '                    s.problem = badMessage',
            '                    return -1',
            '                }',
            '',
            '                // The plaintext moved to the start.',
            '                memcpy(s.record, offset(s.record, 5), size)',
            '                s.recordSize = size',
            '                s.used = 0',
            '                return kind',
            '            }',
            '',
            '            return openRecord(mut s, size)',
            '        }',
            '    }',
            '',
            '    return -1',
            '}',
            '',
            '// The record of `size` bytes after its header, decrypted in place: its inner type.',
            'function openRecord(mut s: Session, size: int): int {',
            '    if (size < 17) {',
            '        s.problem = badRecord',
            '        return -1',
            '    }',
            '',
            '    immut nonce = allocate(12)',
            '    nonceOf(s.reading, nonce)',
            '    immut plain = allocate(size)',
            '    immut good = if (s.suite == 0x1303) {',
            '        chacha.open(s.reading.key, nonce, s.record, 5, offset(s.record, 5), size, plain)',
            '    } else {',
            '        aes.open(s.reading.aesKey, nonce, s.record, 5, offset(s.record, 5), size, plain)',
            '    }',
            '',
            '    free(nonce)',
            '',
            '    if (not good) {',
            '        free(plain)',
            '        s.problem = badRecord',
            '        return -1',
            '    }',
            '',
            '    s.reading.sequence += 1',
            '    // The type: the last byte that is not zero (the zeros after it are padding).',
            '    mut end = size - 16',
            '',
            '    while (end > 0 and byteAt(plain, end - 1) == 0) {',
            '        end -= 1',
            '    }',
            '',
            '    if (end == 0 or end - 1 > largestPlaintext) {',
            '        free(plain)',
            '        s.problem = badRecord',
            '        return -1',
            '    }',
            '',
            '    immut kind = byteAt(plain, end - 1)',
            '    memcpy(s.record, plain, end - 1)',
            '    free(plain)',
            '    s.recordSize = end - 1',
            '    s.used = 0',
            '    return kind',
            '}',
            '',
            '// The handshake',
            '',
            '// The next handshake message (its type, its 3 bytes of size and its body) into `s.pending`, read',
            '// from as many records as it takes: its type, or -1.',
            'function nextMessage(mut s: Session): int {',
            '    while (true) {',
            '        if (s.pending.size >= 4) {',
            '            immut size = number(s.pending.bytes, 1, 3)',
            '',
            '            if (size > 65536) {',
            '                s.problem = badMessage',
            '                return -1',
            '            }',
            '',
            '            if (s.pending.size >= 4 + size) { return byteAt(s.pending.bytes, 0) }',
            '        }',
            '',
            '        immut kind = receiveRecord(mut s)',
            '',
            '        if (kind < 0) { return -1 }',
            '',
            '        if (kind == 21) {',
            '            alertReceived(mut s)',
            '            return -1',
            '        }',
            '',
            '        if (kind != 22) {',
            '            s.problem = badMessage',
            '            return -1',
            '        }',
            '',
            '        putBytes(mut s.pending, s.record, s.recordSize)',
            '    }',
            '',
            '    return -1',
            '}',
            '',
            '// The message taken from `s.pending` (its 4 + size bytes), added to the transcript.',
            'function takeMessage(mut s: Session, mut transcript: Buffer): int {',
            '    immut size = 4 + number(s.pending.bytes, 1, 3)',
            '    putBytes(mut transcript, s.pending.bytes, size)',
            '    memcpy(s.pending.bytes, offset(s.pending.bytes, size), s.pending.size - size)',
            '    s.pending.size -= size',
            '    return size',
            '}',
            '',
            '// An alert in `s.record`: close_notify closes, any other is the problem.',
            'function alertReceived(mut s: Session) {',
            '    if (s.recordSize != 2) {',
            '        s.problem = badMessage',
            '        return',
            '    }',
            '',
            '    immut description = byteAt(s.record, 1)',
            '',
            '    if (description == 0) {',
            '        s.closed = true',
            '        s.problem = closedEarly',
            '    } else {',
            '        s.problem = alertBase + description',
            '    }',
            '}',
            '',
            '// The digest of the transcript so far, at `out`.',
            'function transcriptDigest(hash: int, transcript: Buffer, out: Address) {',
            '    digest(hash, transcript.bytes, transcript.size, out)',
            '}',
            '',
            '// For the tests of the library (koji_tls_test_replay): the random bytes made from a seed (SHA-256 of',
            '// the seed and a counter) instead of the system\'s, and the time fixed; 0 when off.',
            'mut testSeed = 0',
            'mut testCounter = 0',
            'mut testTime = 0',
            '',
            '// The random bytes of the system, or false.',
            'function randomBytes(out: Address, size: int): boolean {',
            '    mut done = 0',
            '',
            '    if (testSeed != 0) {',
            '        immut input = allocate(16)',
            '        immut block = allocate(32)',
            '',
            '        while (done < size) {',
            '            write(input, 0, testSeed)',
            '            write(input, 8, testCounter)',
            '            testCounter += 1',
            '            digest(0, input, 16, block)',
            '            immut part = if (size - done > 32) { 32 } else { size - done }',
            '            memcpy(offset(out, done), block, part)',
            '            done += part',
            '        }',
            '',
            '        free(block)',
            '        free(input)',
            '        return true',
            '    }',
            '',
            '    while (done < size) {',
            '        immut part = if (size - done > 256) { 256 } else { size - done }',
            '',
            '        if (getentropy(offset(out, done), part) != 0) { return false }',
            '',
            '        done += part',
            '    }',
            '',
            '    return true',
            '}',
            '',
            '// The groups: X25519 (0x001D), P-256 (0x0017) and P-384 (0x0018).',
            'function curveOfGroup(group: int): int {',
            '    return if (group == 0x0017) { 0 } else { 1 }',
            '}',
            '',
            'function shareSize(group: int): int {',
            '    return match (group) {',
            '        0x001D => 32',
            '        0x0017 => 65',
            '        _ => 97',
            '    }',
            '}',
            '',
            '// A key share: the secret and the public key of the group.',
            'type Share = {',
            '    group: int',
            '    secret: Address',
            '    public: Address',
            '}',
            '',
            'function newShare(group: int): Share {',
            '    immut secretSize = if (group == 0x0018) { 48 } else { 32 }',
            '    immut secret = allocate(secretSize)',
            '    immut public = allocate(shareSize(group))',
            '    randomBytes(secret, secretSize)',
            '',
            '    if (group == 0x001D) {',
            '        x25519Base(public, secret)',
            '    } else {',
            '        // Below the order n of the curve, whose first bytes are all ones: the top bit cleared.',
            '        write(secret, 0, byte(byteAt(secret, 0) & 0x7F))',
            '        publicKey(curveOfGroup(group), secret, public)',
            '    }',
            '',
            '    return { group: group, secret: secret, public: public }',
            '}',
            '',
            'function releaseShare(share: Share) {',
            '    memset(share.secret, 0, if (share.group == 0x0018) { 48 } else { 32 })',
            '    free(share.secret)',
            '    free(share.public)',
            '}',
            '',
            '// The shared secret of our share and the server\'s public key (`size` bytes at `theirs`), at `out`:',
            '// its size, or 0 when the key is not valid.',
            'function exchange(share: Share, theirs: Address, size: int, out: Address): int {',
            '    if (size != shareSize(share.group)) { return 0 }',
            '',
            '    if (share.group == 0x001D) {',
            '        x25519(out, share.secret, theirs)',
            '        // An all-zero result (a point of small order) is refused (RFC 7748, section 6.1).',
            '        mut any = 0',
            '',
            '        for i in range(32) {',
            '            any = any | byteAt(out, i)',
            '        }',
            '',
            '        return if (any == 0) { 0 } else { 32 }',
            '    }',
            '',
            '    immut curve = curveOfGroup(share.group)',
            '',
            '    if (not sharedSecret(curve, share.secret, theirs, size, out)) { return 0 }',
            '',
            '    return if (curve == 0) { 32 } else { 48 }',
            '}',
            '',
            '// Whether the host is an IP address (no server_name for it).',
            'function isAddress(host: string): boolean {',
            '    if (host.startsWith(\'[\')) { return true }',
            '',
            '    mut digitsAndDots = true',
            '',
            '    for c in host.chars() {',
            '        // A colon only in an IPv6 address.',
            '        if (c == \':\') { return true }',
            '',
            '        if (not ((c >= \'0\' and c <= \'9\') or c == \'.\')) { digitsAndDots = false }',
            '    }',
            '',
            '    return digitsAndDots',
            '}',
            '',
            '// The ClientHello, after its 4 bytes of type and size: the suites (AES first when the processor',
            '// has it), the groups, our share, the algorithms of signatures, the name of the server, and the',
            '// cookie of a HelloRetryRequest.',
            'function clientHello(host: string, random: Address, sessionId: Address, share: Share, cookie: Buffer): Buffer {',
            '    mut m = newBuffer(512)',
            '    putNumber(mut m, 1, 1)',
            '    putNumber(mut m, 0, 3)',
            '    putNumber(mut m, 0x0303, 2)',
            '    putBytes(mut m, random, 32)',
            '    putNumber(mut m, 32, 1)',
            '    putBytes(mut m, sessionId, 32)',
            '    immut suites = if (aes.available()) { [0x1301, 0x1302, 0x1303] } else { [0x1303] }',
            '    putNumber(mut m, 2 * suites.length(), 2)',
            '',
            '    for suite in suites {',
            '        putNumber(mut m, suite, 2)',
            '    }',
            '',
            '    // No compression.',
            '    putNumber(mut m, 0x0100, 2)',
            '    immut extensionsAt = m.size',
            '    putNumber(mut m, 0, 2)',
            '',
            '    if (not isAddress(host)) {',
            '        // server_name: a host_name.',
            '        putNumber(mut m, 0, 2)',
            '        putNumber(mut m, stringSize(host) + 5, 2)',
            '        putNumber(mut m, stringSize(host) + 3, 2)',
            '        putNumber(mut m, 0, 1)',
            '        putNumber(mut m, stringSize(host), 2)',
            '        putText(mut m, host)',
            '    }',
            '',
            '    // supported_versions: TLS 1.3.',
            '    putNumber(mut m, 43, 2)',
            '    putNumber(mut m, 3, 2)',
            '    putNumber(mut m, 2, 1)',
            '    putNumber(mut m, 0x0304, 2)',
            '    // supported_groups.',
            '    putNumber(mut m, 10, 2)',
            '    putNumber(mut m, 8, 2)',
            '    putNumber(mut m, 6, 2)',
            '',
            '    for group in [0x001D, 0x0017, 0x0018] {',
            '        putNumber(mut m, group, 2)',
            '    }',
            '',
            '    // key_share: ours.',
            '    immut size = shareSize(share.group)',
            '    putNumber(mut m, 51, 2)',
            '    putNumber(mut m, size + 6, 2)',
            '    putNumber(mut m, size + 4, 2)',
            '    putNumber(mut m, share.group, 2)',
            '    putNumber(mut m, size, 2)',
            '    putBytes(mut m, share.public, size)',
            '    // signature_algorithms: ECDSA, RSA-PSS (rsae), and PKCS #1 v1.5 for the certificates.',
            '    immut schemes = [0x0403, 0x0503, 0x0603, 0x0804, 0x0805, 0x0806, 0x0401, 0x0501, 0x0601]',
            '    putNumber(mut m, 13, 2)',
            '    putNumber(mut m, 2 * schemes.length() + 2, 2)',
            '    putNumber(mut m, 2 * schemes.length(), 2)',
            '',
            '    for scheme in schemes {',
            '        putNumber(mut m, scheme, 2)',
            '    }',
            '',
            '    // application_layer_protocol_negotiation: HTTP/1.1.',
            '    putNumber(mut m, 16, 2)',
            '    putNumber(mut m, 11, 2)',
            '    putNumber(mut m, 9, 2)',
            '    putNumber(mut m, 8, 1)',
            '    putText(mut m, \'http/1.1\')',
            '',
            '    if (cookie.size > 0) {',
            '        putNumber(mut m, 44, 2)',
            '        putNumber(mut m, cookie.size, 2)',
            '        putBytes(mut m, cookie.bytes, cookie.size)',
            '    }',
            '',
            '    patchSize(m, extensionsAt, 2)',
            '    patchSize(m, 1, 3)',
            '    return m',
            '}',
            '',
            '// A ServerHello read: the suite, the group of the server\'s share and where its key is (or, in a',
            '// HelloRetryRequest, the group asked for and the cookie), `good` false when it is malformed or',
            '// chose what was not offered (`problem`).',
            'type ServerHello = {',
            '    good: boolean',
            '    problem: int',
            '    retry: boolean',
            '    suite: int',
            '    group: int',
            '    keyStart: int',
            '    keySize: int',
            '    cookieStart: int',
            '    cookieSize: int',
            '}',
            '',
            '// SHA-256 of "HelloRetryRequest": the random of a HelloRetryRequest.',
            'immut retryRandom = \'cf21ad74e59a6111be1d8c021e65b891c2a211167abb8c5e079e09e2c8a8339c\'',
            '',
            'function badHello(problem: int): ServerHello {',
            '    return { good: false, problem: problem, retry: false, suite: 0, group: 0, keyStart: 0, keySize: 0, cookieStart: 0, cookieSize: 0 }',
            '}',
            '',
            'function hexValue(text: string, at: int): int {',
            '    immut c = text[at]',
            '    return if (c >= \'a\') { c.code() - 87 } else { c.code() - 48 }',
            '}',
            '',
            '// The ServerHello of `size` bytes at `m` (after its type and size).',
            'function serverHello(m: Address, size: int, sessionId: Address): ServerHello {',
            '    if (size < 38 or number(m, 0, 2) != 0x0303) { return badHello(badMessage) }',
            '',
            '    mut retry = true',
            '',
            '    for i in range(32) {',
            '        if (byteAt(m, 2 + i) != hexValue(retryRandom, 2 * i) * 16 + hexValue(retryRandom, 2 * i + 1)) { retry = false }',
            '    }',
            '',
            '    // The session ID echoed.',
            '    if (byteAt(m, 34) != 32 or size < 35 + 32 + 5 or memcmp(offset(m, 35), sessionId, 32) != 0) { return badHello(notOffered) }',
            '',
            '    mut at = 67',
            '    mut hello = badHello(badMessage)',
            '    hello.retry = retry',
            '    hello.suite = number(m, at, 2)',
            '    immut offered = hello.suite == 0x1303 or (aes.available() and (hello.suite == 0x1301 or hello.suite == 0x1302))',
            '',
            '    if (not offered or byteAt(m, at + 2) != 0) { return badHello(notOffered) }',
            '',
            '    at += 3',
            '    immut end = at + 2 + number(m, at, 2)',
            '',
            '    if (end != size) { return badHello(badMessage) }',
            '',
            '    at += 2',
            '    mut version = 0',
            '',
            '    while (at < end) {',
            '        if (at + 4 > end) { return badHello(badMessage) }',
            '',
            '        immut kind = number(m, at, 2)',
            '        immut length = number(m, at + 2, 2)',
            '        immut start = at + 4',
            '',
            '        if (start + length > end) { return badHello(badMessage) }',
            '',
            '        if (kind == 43) {',
            '            if (length != 2) { return badHello(badMessage) }',
            '',
            '            version = number(m, start, 2)',
            '        }',
            '',
            '        if (kind == 51) {',
            '            if (retry) {',
            '                if (length != 2) { return badHello(badMessage) }',
            '',
            '                hello.group = number(m, start, 2)',
            '            } else {',
            '                if (length < 4 or number(m, start + 2, 2) != length - 4) { return badHello(badMessage) }',
            '',
            '                hello.group = number(m, start, 2)',
            '                hello.keyStart = start + 4',
            '                hello.keySize = length - 4',
            '            }',
            '        }',
            '',
            '        if (kind == 44) {',
            '            if (not retry or length < 3 or number(m, start, 2) != length - 2) { return badHello(badMessage) }',
            '',
            '            hello.cookieStart = start + 2',
            '            hello.cookieSize = length - 2',
            '        }',
            '',
            '        at = start + length',
            '    }',
            '',
            '    if (version != 0x0304) { return badHello(notOffered) }',
            '',
            '    if (hello.group != 0x001D and hello.group != 0x0017 and hello.group != 0x0018) { return badHello(notOffered) }',
            '',
            '    hello.good = true',
            '    hello.problem = 0',
            '    return hello',
            '}',
            '',
            '// The algorithm of a scheme of CertificateVerify and whether the key can use it (the curve of an',
            '// ECDSA scheme is that of the key; RSA-PSS needs an RSA key); `kind` -1 otherwise.',
            'function schemeAlgorithm(scheme: int, key: PublicKey): Algorithm {',
            '    immut none: Algorithm = { kind: -1, hash: 0 }',
            '',
            '    if (key.kind == 1) {',
            '        for i in range(3) {',
            '            if (scheme == [0x0403, 0x0503, 0x0603][i] and key.curve == i) { return { kind: 2, hash: i } }',
            '        }',
            '',
            '        return none',
            '    }',
            '',
            '    for i in range(3) {',
            '        if (scheme == 0x0804 + i and key.kind == 0) { return { kind: 1, hash: i } }',
            '    }',
            '',
            '    return none',
            '}',
            '',
            '// The result of a handshake: the session, or the problem.',
            'type Handshake = {',
            '    session: Session',
            '    problem: int',
            '}',
            '',
            '// The handshake on the connected socket `fd` with `host` (a name or an IP address).',
            'function handshake(fd: int, host: string, authorities: Authority[]): Handshake {',
            '    mut s = newSession(fd)',
            '    immut random = allocate(32)',
            '    immut sessionId = allocate(32)',
            '',
            '    if (not randomBytes(random, 32) or not randomBytes(sessionId, 32)) {',
            '        s.problem = noRandom',
            '        free(random)',
            '        free(sessionId)',
            '        return { session: s, problem: s.problem }',
            '    }',
            '',
            '    mut share = newShare(0x001D)',
            '    mut transcript = newBuffer(8192)',
            '    mut cookie = newBuffer(16)',
            '    mut hello = clientHello(host, random, sessionId, share, cookie)',
            '    putBytes(mut transcript, hello.bytes, hello.size)',
            '    mut sent = sendRecord(mut s, 22, hello.bytes, hello.size)',
            '    free(hello.bytes)',
            '    mut server = badHello(badMessage)',
            '    // The server\'s public key, copied out of its ServerHello.',
            '    mut theirs = newBuffer(128)',
            '    mut retried = false',
            '',
            '    while (sent and s.problem == 0) {',
            '        if (nextMessage(mut s) != 2) {',
            '            if (s.problem == 0) { s.problem = badMessage }',
            '',
            '            break',
            '        }',
            '',
            '        immut messageStart = transcript.size',
            '        immut messageSize = takeMessage(mut s, mut transcript)',
            '        immut m = offset(transcript.bytes, messageStart + 4)',
            '        server = serverHello(m, messageSize - 4, sessionId)',
            '',
            '        if (not server.good) {',
            '            s.problem = server.problem',
            '            break',
            '        }',
            '',
            '        if (not server.retry) {',
            '            // The same suite as the HelloRetryRequest, our group, and nothing more in the record',
            '            // (the keys change after it).',
            '            if ((retried and server.suite != s.suite) or server.group != share.group) {',
            '                s.problem = notOffered',
            '            } else {',
            '                if (s.pending.size != 0) { s.problem = badMessage }',
            '            }',
            '',
            '            putBytes(mut theirs, offset(m, server.keyStart), server.keySize)',
            '            break',
            '        }',
            '',
            '        // A HelloRetryRequest (once, for a group offered and not sent): the transcript starts again',
            '        // from the digest of the first ClientHello, and a new ClientHello with a share of that group.',
            '        if (retried or server.group == share.group) {',
            '            s.problem = notOffered',
            '            break',
            '        }',
            '',
            '        retried = true',
            '        s.suite = server.suite',
            '        immut hash = hashOfSuite(server.suite)',
            '        immut length = digestSize(hash)',
            '        mut restarted = newBuffer(8192)',
            '        putNumber(mut restarted, 254, 1)',
            '        putNumber(mut restarted, length, 3)',
            '        reserve(mut restarted, length)',
            '        digest(hash, transcript.bytes, messageStart, offset(restarted.bytes, restarted.size))',
            '        restarted.size += length',
            '        putBytes(mut restarted, offset(transcript.bytes, messageStart), messageSize)',
            '        cookie.size = 0',
            '',
            '        if (server.cookieSize > 0) { putBytes(mut cookie, offset(m, server.cookieStart), server.cookieSize) }',
            '',
            '        free(transcript.bytes)',
            '        transcript = restarted',
            '        releaseShare(share)',
            '        share = newShare(server.group)',
            '        hello = clientHello(host, random, sessionId, share, cookie)',
            '        putBytes(mut transcript, hello.bytes, hello.size)',
            '        sent = sendRecord(mut s, 22, hello.bytes, hello.size)',
            '        free(hello.bytes)',
            '    }',
            '',
            '    if (not sent and s.problem == 0) { s.problem = systemError }',
            '',
            '    if (s.problem == 0) { keyedHandshake(mut s, mut transcript, server.suite, share, theirs, host, authorities) }',
            '',
            '    releaseShare(share)',
            '    free(transcript.bytes)',
            '    free(cookie.bytes)',
            '    free(theirs.bytes)',
            '    free(random)',
            '    free(sessionId)',
            '',
            '    if (s.problem != 0 and s.problem != closedEarly and s.problem != systemError and s.problem < alertBase) { sendAlert(mut s, alertFor(s.problem)) }',
            '',
            '    return { session: s, problem: s.problem }',
            '}',
            '',
            '// The alert for a problem found here.',
            'function alertFor(problem: int): int {',
            '    if (problem == 2) { return 45 }',
            '',
            '    if (problem == 3) { return 48 }',
            '',
            '    if (problem == 7) { return 43 }',
            '',
            '    if (problem < badMessage) { return 42 }',
            '',
            '    return match (problem) {',
            '        20 => 50',
            '        21 => 47',
            '        22 => 20',
            '        25 => 51',
            '        26 => 51',
            '        _ => 80',
            '    }',
            '}',
            '',
            '// The rest of the handshake, after the ServerHello: the secrets (early, of no key; handshake, of the',
            '// shared secret; master), the server\'s messages, then ours.',
            'function keyedHandshake(mut s: Session, mut transcript: Buffer, suite: int, share: Share, theirs: Buffer, host: string, authorities: Authority[]) {',
            '    s.suite = suite',
            '    immut hash = hashOfSuite(suite)',
            '    immut length = digestSize(hash)',
            '    immut shared = allocate(48)',
            '    immut sharedSize = exchange(share, theirs.bytes, theirs.size, shared)',
            '',
            '    if (sharedSize == 0) {',
            '        free(shared)',
            '        s.problem = notOffered',
            '        return',
            '    }',
            '',
            '    immut zeros = allocate(length)',
            '    memset(zeros, 0, length)',
            '    immut early = allocate(length)',
            '    hkdfExtract(hash, nullAddress(), 0, zeros, length, early)',
            '    immut empty = allocate(length)',
            '    digest(hash, nullAddress(), 0, empty)',
            '    immut derived = allocate(length)',
            '    deriveSecret(hash, early, \'derived\', empty, derived)',
            '    immut handshakeSecret = allocate(length)',
            '    hkdfExtract(hash, derived, length, shared, sharedSize, handshakeSecret)',
            '    memset(shared, 0, 48)',
            '    free(shared)',
            '    immut context = allocate(length)',
            '    transcriptDigest(hash, transcript, context)',
            '    immut clientSecret = allocate(length)',
            '    immut serverSecret = allocate(length)',
            '    deriveSecret(hash, handshakeSecret, \'c hs traffic\', context, clientSecret)',
            '    deriveSecret(hash, handshakeSecret, \'s hs traffic\', context, serverSecret)',
            '    s.reading = directionOf(suite, serverSecret)',
            '    s.writing = directionOf(suite, clientSecret)',
            '    s.keyed = true',
            '    serverFlight(mut s, mut transcript, host, authorities, serverSecret, hash)',
            '',
            '    if (s.problem == 0) {',
            '        // The application secrets, of the transcript up to the server\'s Finished.',
            '        transcriptDigest(hash, transcript, context)',
            '        deriveSecret(hash, handshakeSecret, \'derived\', empty, derived)',
            '        immut master = allocate(length)',
            '        hkdfExtract(hash, derived, length, zeros, length, master)',
            '        immut clientApplication = allocate(length)',
            '        immut serverApplication = allocate(length)',
            '        deriveSecret(hash, master, \'c ap traffic\', context, clientApplication)',
            '        deriveSecret(hash, master, \'s ap traffic\', context, serverApplication)',
            '        clientFlight(mut s, mut transcript, clientSecret, hash)',
            '',
            '        if (s.problem == 0) {',
            '            releaseDirection(suite, s.reading)',
            '            releaseDirection(suite, s.writing)',
            '            s.reading = directionOf(suite, serverApplication)',
            '            s.writing = directionOf(suite, clientApplication)',
            '        }',
            '',
            '        for each in [master, clientApplication, serverApplication] {',
            '            memset(each, 0, length)',
            '            free(each)',
            '        }',
            '    }',
            '',
            '    for each in [zeros, early, empty, derived, handshakeSecret, context, clientSecret, serverSecret] {',
            '        memset(each, 0, length)',
            '        free(each)',
            '    }',
            '}',
            '',
            '// The next message of the handshake when it has the type (else the problem set): the start of its',
            '// body in `transcript` once taken, and its size.',
            'type Taken = {',
            '    good: boolean',
            '    start: int',
            '    size: int',
            '}',
            '',
            'function takeExpected(mut s: Session, mut transcript: Buffer, kind: int): Taken {',
            '    immut next = nextMessage(mut s)',
            '',
            '    if (next != kind) {',
            '        if (s.problem == 0) { s.problem = badMessage }',
            '',
            '        return { good: false, start: 0, size: 0 }',
            '    }',
            '',
            '    immut start = transcript.size',
            '    immut size = takeMessage(mut s, mut transcript)',
            '    return { good: true, start: start + 4, size: size - 4 }',
            '}',
            '',
            '// Whether the bytes are a block of extensions (2 bytes of size, then extensions with 2 bytes of type',
            '// and 2 of size each) filling exactly `size` bytes.',
            'function extensionsGood(m: Address, size: int): boolean {',
            '    if (size < 2 or number(m, 0, 2) != size - 2) { return false }',
            '',
            '    mut at = 2',
            '',
            '    while (at < size) {',
            '        if (at + 4 > size) { return false }',
            '',
            '        at += 4 + number(m, at + 2, 2)',
            '    }',
            '',
            '    return at == size',
            '}',
            '',
            '// EncryptedExtensions, CertificateRequest (perhaps), Certificate, CertificateVerify and Finished.',
            'function serverFlight(mut s: Session, mut transcript: Buffer, host: string, authorities: Authority[], serverSecret: Address, hash: int) {',
            '    immut extensions = takeExpected(mut s, mut transcript, 8)',
            '',
            '    if (not extensions.good) { return }',
            '',
            '    if (not extensionsGood(offset(transcript.bytes, extensions.start), extensions.size)) {',
            '        s.problem = badMessage',
            '        return',
            '    }',
            '',
            '    if (nextMessage(mut s) == 13) {',
            '        // CertificateRequest: its context (answered with no certificate) and its extensions.',
            '        immut request = takeExpected(mut s, mut transcript, 13)',
            '        immut m = offset(transcript.bytes, request.start)',
            '        immut contextSize = if (request.size > 0) { byteAt(m, 0) } else { 0 }',
            '',
            '        if (request.size < 1 + contextSize or not extensionsGood(offset(m, 1 + contextSize), request.size - 1 - contextSize)) {',
            '            s.problem = badMessage',
            '            return',
            '        }',
            '',
            '        s.requested = true',
            '        putBytes(mut s.requestContext, offset(m, 1), contextSize)',
            '    }',
            '',
            '    if (s.problem != 0) { return }',
            '',
            '    immut certificate = takeExpected(mut s, mut transcript, 11)',
            '',
            '    if (not certificate.good) { return }',
            '',
            '    // Certificate: an empty context, then the certificates (3 bytes of size each, and extensions).',
            '    immut m = offset(transcript.bytes, certificate.start)',
            '    immut size = certificate.size',
            '',
            '    if (size < 4 or byteAt(m, 0) != 0 or number(m, 1, 3) != size - 4) {',
            '        s.problem = badMessage',
            '        return',
            '    }',
            '',
            '    mut chain: Certificate[] = []',
            '    mut at = 4',
            '',
            '    while (at < size and s.problem == 0) {',
            '        if (at + 3 > size) {',
            '            s.problem = badMessage',
            '            break',
            '        }',
            '',
            '        immut length = number(m, at, 3)',
            '',
            '        if (length == 0 or at + 3 + length + 2 > size) {',
            '            s.problem = badMessage',
            '            break',
            '        }',
            '',
            '        immut der = allocate(length)',
            '        memcpy(der, offset(m, at + 3), length)',
            '        chain.push(certificateOf(der, length))',
            '        at += 3 + length',
            '        at += 2 + number(m, at, 2)',
            '    }',
            '',
            '    if (s.problem == 0 and (at != size or chain.length() == 0)) { s.problem = badMessage }',
            '',
            '    if (s.problem == 0) { s.problem = verifyChain(chain, authorities, host, if (testTime > 0) { testTime } else { now() }) }',
            '',
            '    if (s.problem == 0) { verifyProof(mut s, mut transcript, chain[0].key, hash) }',
            '',
            '    for c in chain {',
            '        free(c.bytes)',
            '    }',
            '',
            '    if (s.problem != 0) { return }',
            '',
            '    // Finished: the HMAC of the transcript with the server\'s finished key.',
            '    immut length = digestSize(hash)',
            '    immut expected = finishedOf(hash, serverSecret, transcript)',
            '    immut finished = takeExpected(mut s, mut transcript, 20)',
            '',
            '    if (finished.good) {',
            '        mut difference = if (finished.size == length) { 0 } else { 1 }',
            '',
            '        if (difference == 0) {',
            '            for i in range(length) {',
            '                difference = difference | (byteAt(expected, i) ^ byteAt(transcript.bytes, finished.start + i))',
            '            }',
            '        }',
            '',
            '        if (difference != 0) { s.problem = badFinished }',
            '',
            '        // The keys change after it: nothing more in its record.',
            '        if (s.problem == 0 and s.pending.size != 0) { s.problem = badMessage }',
            '    }',
            '',
            '    free(expected)',
            '}',
            '',
            '// The verify_data of a Finished: HMAC of the transcript\'s digest with the finished key of the',
            '// traffic secret (to free).',
            'function finishedOf(hash: int, secret: Address, transcript: Buffer): Address {',
            '    immut length = digestSize(hash)',
            '    immut key = allocate(length)',
            '    expandLabel(hash, secret, \'finished\', nullAddress(), 0, length, key)',
            '    immut context = allocate(length)',
            '    transcriptDigest(hash, transcript, context)',
            '    immut out = allocate(length)',
            '    hmac(hash, key, length, context, length, out)',
            '    memset(key, 0, length)',
            '    free(key)',
            '    free(context)',
            '    return out',
            '}',
            '',
            '// CertificateVerify: the signature by the server\'s key, with a scheme that was offered and fits the',
            '// key, of 64 spaces, the context string, a zero and the transcript\'s digest.',
            'function verifyProof(mut s: Session, mut transcript: Buffer, key: PublicKey, hash: int) {',
            '    immut length = digestSize(hash)',
            '    mut signed = newBuffer(200)',
            '',
            '    for i in range(64) {',
            '        putNumber(mut signed, 0x20, 1)',
            '    }',
            '',
            '    putText(mut signed, \'TLS 1.3, server CertificateVerify\')',
            '    putNumber(mut signed, 0, 1)',
            '    reserve(mut signed, length)',
            '    transcriptDigest(hash, transcript, offset(signed.bytes, signed.size))',
            '    signed.size += length',
            '    immut proof = takeExpected(mut s, mut transcript, 15)',
            '',
            '    if (proof.good) {',
            '        immut m = offset(transcript.bytes, proof.start)',
            '',
            '        if (proof.size < 4 or number(m, 2, 2) != proof.size - 4) {',
            '            s.problem = badMessage',
            '        } else {',
            '            immut algorithm = schemeAlgorithm(number(m, 0, 2), key)',
            '',
            '            if (algorithm.kind < 0) {',
            '                s.problem = notOffered',
            '            } else {',
            '                if (not verifySignature(key, algorithm, signed.bytes, signed.size, offset(m, 4), proof.size - 4)) { s.problem = badProof }',
            '            }',
            '        }',
            '    }',
            '',
            '    free(signed.bytes)',
            '}',
            '',
            '// Ours: ChangeCipherSpec (for middleboxes, since a session ID was sent), an empty Certificate when',
            '// the server asked for one, and Finished.',
            'function clientFlight(mut s: Session, mut transcript: Buffer, clientSecret: Address, hash: int) {',
            '    immut change = allocate(6)',
            '',
            '    for i in range(6) {',
            '        write(change, i, byte([20, 3, 3, 0, 1, 1][i]))',
            '    }',
            '',
            '    immut sent = sendAll(s.fd, change, 6)',
            '    free(change)',
            '',
            '    if (not sent) {',
            '        lastErrno = koji_system_errno()',
            '        s.problem = systemError',
            '        return',
            '    }',
            '',
            '    if (s.requested) {',
            '        mut empty = newBuffer(16)',
            '        putNumber(mut empty, 11, 1)',
            '        putNumber(mut empty, 4 + s.requestContext.size, 3)',
            '        putNumber(mut empty, s.requestContext.size, 1)',
            '        putBytes(mut empty, s.requestContext.bytes, s.requestContext.size)',
            '        putNumber(mut empty, 0, 3)',
            '        putBytes(mut transcript, empty.bytes, empty.size)',
            '        immut good = sendRecord(mut s, 22, empty.bytes, empty.size)',
            '        free(empty.bytes)',
            '',
            '        if (not good) {',
            '            s.problem = systemError',
            '            return',
            '        }',
            '    }',
            '',
            '    immut length = digestSize(hash)',
            '    immut verifyData = finishedOf(hash, clientSecret, transcript)',
            '    mut finished = newBuffer(4 + length)',
            '    putNumber(mut finished, 20, 1)',
            '    putNumber(mut finished, length, 3)',
            '    putBytes(mut finished, verifyData, length)',
            '    free(verifyData)',
            '',
            '    if (not sendRecord(mut s, 22, finished.bytes, finished.size)) { s.problem = systemError }',
            '',
            '    free(finished.bytes)',
            '}',
            '',
            '// After the handshake',
            '',
            '// The messages of the handshake after it, in `s.pending`: NewSessionTicket (ignored) and KeyUpdate',
            '// (the keys of reading updated, and ours too when the server asks). False with the problem set.',
            'function afterHandshake(mut s: Session): boolean {',
            '    while (s.pending.size >= 4) {',
            '        immut size = number(s.pending.bytes, 1, 3)',
            '',
            '        if (s.pending.size < 4 + size) { return true }',
            '',
            '        immut kind = byteAt(s.pending.bytes, 0)',
            '',
            '        if (kind == 24) {',
            '            if (size != 1 or byteAt(s.pending.bytes, 4) > 1) {',
            '                s.problem = badMessage',
            '                return false',
            '            }',
            '',
            '            immut asked = byteAt(s.pending.bytes, 4) == 1',
            '            s.reading = updatedDirection(s.suite, s.reading)',
            '',
            '            if (asked) {',
            '                immut update = allocate(5)',
            '',
            '                for i in range(5) {',
            '                    write(update, i, byte([24, 0, 0, 1, 0][i]))',
            '                }',
            '',
            '                immut sent = sendRecord(mut s, 22, update, 5)',
            '                free(update)',
            '',
            '                if (not sent) {',
            '                    s.problem = systemError',
            '                    return false',
            '                }',
            '',
            '                s.writing = updatedDirection(s.suite, s.writing)',
            '            }',
            '        } else {',
            '            if (kind != 4) {',
            '                s.problem = badMessage',
            '                return false',
            '            }',
            '        }',
            '',
            '        memcpy(s.pending.bytes, offset(s.pending.bytes, 4 + size), s.pending.size - 4 - size)',
            '        s.pending.size -= 4 + size',
            '    }',
            '',
            '    return true',
            '}',
            '',
            '// Up to `size` bytes of application data at `out`: how many, 0 when the server closed the',
            '// connection (close_notify), -1 for a problem (`truncated` when it closed without close_notify).',
            'function receiveData(mut s: Session, out: Address, size: int): int {',
            '    while (s.used >= s.recordSize or s.recordType != 23) {',
            '        if (s.closed) { return 0 }',
            '',
            '        immut kind = receiveRecord(mut s)',
            '',
            '        if (kind < 0) {',
            '            // The connection closed without close_notify: not the end the server meant (an attacker',
            '            // can cut a connection), as rustls takes it; std/http.kj ignores it once a body whose size',
            '            // it knows has come whole.',
            '            if (s.problem == closedEarly) { s.problem = truncated }',
            '',
            '            return -1',
            '        }',
            '',
            '        s.recordType = kind',
            '',
            '        if (kind == 21) {',
            '            alertReceived(mut s)',
            '',
            '            if (s.closed) { return 0 }',
            '',
            '            return -1',
            '        }',
            '',
            '        if (kind == 22) {',
            '            putBytes(mut s.pending, s.record, s.recordSize)',
            '            s.used = s.recordSize',
            '',
            '            if (not afterHandshake(mut s)) { return -1 }',
            '        } else {',
            '            if (kind != 23) {',
            '                s.problem = badMessage',
            '                return -1',
            '            }',
            '        }',
            '    }',
            '',
            '    immut count = if (s.recordSize - s.used < size) { s.recordSize - s.used } else { size }',
            '    memcpy(out, offset(s.record, s.used), count)',
            '    s.used += count',
            '    return count',
            '}',
            '',
            '// The `size` bytes at `data` sent, in records of at most 16384 bytes: false for a problem.',
            'function sendData(mut s: Session, data: Address, size: int): boolean {',
            '    mut done = 0',
            '',
            '    while (done < size) {',
            '        immut part = if (size - done > largestPlaintext) { largestPlaintext } else { size - done }',
            '',
            '        if (not sendRecord(mut s, 23, offset(data, done), part)) {',
            '            s.problem = systemError',
            '            return false',
            '        }',
            '',
            '        done += part',
            '    }',
            '',
            '    return true',
            '}',
            '',
            'function releaseSession(s: Session) {',
            '    if (s.keyed) {',
            '        releaseDirection(s.suite, s.reading)',
            '        releaseDirection(s.suite, s.writing)',
            '    }',
            '',
            '    free(s.record)',
            '    free(s.pending.bytes)',
            '    free(s.requestContext.bytes)',
            '}',
            '',
            '// The interface for C and std/http.kj',
            '',
            '// A new handle for a session (a free one first).',
            'function store(s: Session): int {',
            '    for i in range(sessions.length()) {',
            '        if (sessions[i].fd < 0) {',
            '            sessions[i] = s',
            '            return i + 1',
            '        }',
            '    }',
            '',
            '    sessions.push(s)',
            '    return sessions.length()',
            '}',
            '',
            'function validHandle(handle: int): boolean {',
            '    return handle >= 1 and handle <= sessions.length() and sessions[handle - 1].fd >= 0',
            '}',
            '',
            '// The handshake on the connected socket `fd` for `host`: a handle (1 or more), or 0 with the problem',
            '// at `problem` (an int).',
            'extern function koji_tls_connect(fd: int, host: string, problem: Address): int {',
            '    immut result = handshake(fd, host, trustedAuthorities())',
            '',
            '    if (result.problem != 0) {',
            '        releaseSession(result.session)',
            '        write(problem, 0, result.problem)',
            '        return 0',
            '    }',
            '',
            '    return store(result.session)',
            '}',
            '',
            '// The same for C (the tests of the library): the host a C string, and the authorities those of the',
            '// PEM text at `pem` (`pemSize` bytes; the system\'s, or the built-in ones, when it is -1).',
            'extern function koji_tls_connect_with(fd: int, host: Address, pem: Address, pemSize: int, problem: Address): int {',
            '    immut given = if (pemSize >= 0) { authoritiesOfPem(pem, pemSize) } else { [] }',
            '    immut result = handshake(fd, newString(host, strlen(host)), if (pemSize >= 0) { given } else { trustedAuthorities() })',
            '',
            '    for each in given {',
            '        free(each.bytes)',
            '    }',
            '',
            '    if (result.problem != 0) {',
            '        releaseSession(result.session)',
            '        write(problem, 0, result.problem)',
            '        return 0',
            '    }',
            '',
            '    return store(result.session)',
            '}',
            '',
            '// For C (the tests of the library): the random bytes made from `seed` from now on, and the time',
            '// fixed to `time` (seconds since 1970), so that a recorded session can be replayed.',
            'extern function koji_tls_test_replay(seed: int, time: int) {',
            '    testSeed = seed',
            '    testCounter = 0',
            '    testTime = time',
            '}',
            '',
            '// The `size` bytes sent: `size`, or -1.',
            'extern function koji_tls_send(handle: int, data: Address, size: int): int {',
            '    if (not validHandle(handle)) { return -1 }',
            '',
            '    mut s = sessions[handle - 1]',
            '    immut good = sendData(mut s, data, size)',
            '    sessions[handle - 1] = s',
            '    return if (good) { size } else { -1 }',
            '}',
            '',
            '// Up to `size` bytes received at `out`: how many, 0 at the end, -1 for a problem.',
            'extern function koji_tls_receive(handle: int, out: Address, size: int): int {',
            '    if (not validHandle(handle)) { return -1 }',
            '',
            '    mut s = sessions[handle - 1]',
            '    immut got = receiveData(mut s, out, size)',
            '    sessions[handle - 1] = s',
            '    return got',
            '}',
            '',
            '// The problem of a session, after -1.',
            'extern function koji_tls_problem(handle: int): int {',
            '    return if (validHandle(handle)) { sessions[handle - 1].problem } else { systemError }',
            '}',
            '',
            '// The text of a problem.',
            'extern function koji_tls_message(problem: int): string {',
            '    return problemMessage(problem)',
            '}',
            '',
            '// The error of the system of the last problem `systemError`.',
            'extern function koji_tls_errno(): int {',
            '    return lastErrno',
            '}',
            '',
            '// The session closed (close_notify sent when it is still good) and freed; the socket is the',
            '// caller\'s.',
            'extern function koji_tls_close(handle: int) {',
            '    if (not validHandle(handle)) { return }',
            '',
            '    mut s = sessions[handle - 1]',
            '',
            '    if (s.problem == 0 and not s.closed) {',
            '        immut alert = allocate(2)',
            '        write(alert, 0, byte(1))',
            '        write(alert, 1, byte(0))',
            '        sendRecord(mut s, 21, alert, 2)',
            '        free(alert)',
            '    }',
            '',
            '    releaseSession(s)',
            '    s.fd = -1',
            '    sessions[handle - 1] = s',
            '}',
        ].join('\n'))
    }

    if (name == 'koji:unicode') {
        return Some([
            '// The tables of Unicode 17.0.0 of the library written in Koji, as Rust has them: written by',
            '// bootstrap/unicode.rs (do not edit). Texts of hexadecimal digits in records of a fixed width',
            '// (see std/koji/text.kj).',
            '',
            '// Alphabetic.',
            'export immut alphabetic = \'\'',
            '',
            '// Numeric (the general categories Nd, Nl and No).',
            'export immut numeric = \'\'',
            '',
            '// Lowercase.',
            'export immut lowercase = \'\'',
            '',
            '// Uppercase.',
            'export immut uppercase = \'\'',
            '',
            '// Cased, for the final sigma (when not ignorable).',
            'export immut cased = \'\'',
            '',
            '// Case_Ignorable, for the final sigma.',
            'export immut ignorable = \'\'',
            '',
            '// The lower case of a character, when it is one character.',
            'export immut lowerSingle = \'\'',
            '',
            '// The lower case of a character, when it is two or three.',
            'export immut lowerMultiple = \'0001302000069000307000000\'',
            '',
            '// The upper case of a character, when it is one character.',
            'export immut upperSingle = \'\'',
            '',
            '// The upper case of a character, when it is two or three.',
            'export immut upperMultiple = \'\'',
        ].join('\n'))
    }

    if (name == 'koji:x25519') {
        return Some([
            '// `koji:x25519`: the Diffie-Hellman function X25519 of RFC 7748 (the key exchange of TLS 1.3), in',
            '// the library of the runtime written in Koji. As curve25519-donna (64 bits) computes it: a number',
            '// modulo p = 2^255 - 19 is 5 limbs of 51 bits (ints, at an address of 40 bytes), multiplied through',
            '// U128 (a limb of at most 54 bits times 19 times another, summed five times, fits 128 bits), the',
            '// top of a product folded in times 19 (2^255 = 19). The Montgomery ladder of the RFC swaps its points',
            '// with masks, so that nothing depends on the bits of the secret scalar (no branch, no address).',
            '',
            'import { Address, CSize, U128, allocate, free, lowWord, offset, read, wide, wordProduct, write } from \'koji:unsafe\'',
            '',
            'extern function memcpy(target: Address, source: Address, size: CSize): Address',
            '',
            '// 2^51 - 1.',
            'immut mask = 0x7FFFFFFFFFFFF',
            '',
            'function limb(f: Address, i: int): int {',
            '    immut value: int = read(f, i * 8)',
            '    return value',
            '}',
            '',
            'function setLimb(f: Address, i: int, value: int) {',
            '    write(f, i * 8, value)',
            '}',
            '',
            'function byteAt(bytes: Address, i: int): int {',
            '    immut b: byte = read(bytes, i)',
            '    return int(b)',
            '}',
            '',
            'function newElement(): Address {',
            '    immut f = allocate(40)',
            '',
            '    for i in range(5) {',
            '        setLimb(f, i, 0)',
            '    }',
            '',
            '    return f',
            '}',
            '',
            'function product(a: int, b: int): U128 {',
            '    return wordProduct(wide(a, 0), wide(b, 0))',
            '}',
            '',
            '// o = a + b (limb by limb: below 2^53 when a and b are below 2^52).',
            'function add(o: Address, a: Address, b: Address) {',
            '    for i in range(5) {',
            '        setLimb(o, i, limb(a, i) + limb(b, i))',
            '    }',
            '}',
            '',
            '// o = a - b, as a + 2p - b so that no limb is negative (b\'s limbs below 2^52 - 38: a product\'s).',
            'function subtract(o: Address, a: Address, b: Address) {',
            '    setLimb(o, 0, limb(a, 0) + 0xFFFFFFFFFFFDA - limb(b, 0))',
            '',
            '    for i in range(1, 5) {',
            '        setLimb(o, i, limb(a, i) + 0xFFFFFFFFFFFFE - limb(b, i))',
            '    }',
            '}',
            '',
            '// o = the five sums of products (of up to 128 bits), carried back to limbs of 51 bits (the first a',
            '// little more).',
            'function carry(o: Address, r0: U128, r1: U128, r2: U128, r3: U128, r4: U128) {',
            '    immut s1 = r1 + (r0 >> 51)',
            '    immut s2 = r2 + (s1 >> 51)',
            '    immut s3 = r3 + (s2 >> 51)',
            '    immut s4 = r4 + (s3 >> 51)',
            '    // The carry out of the top (below 2^60) times 19, back into the first limb.',
            '    immut s0 = wide(lowWord(r0) & mask, 0) + wordProduct(s4 >> 51, wide(19, 0))',
            '    setLimb(o, 0, lowWord(s0) & mask)',
            '    setLimb(o, 1, (lowWord(s1) & mask) + lowWord(s0 >> 51))',
            '    setLimb(o, 2, lowWord(s2) & mask)',
            '    setLimb(o, 3, lowWord(s3) & mask)',
            '    setLimb(o, 4, lowWord(s4) & mask)',
            '}',
            '',
            '// o = a * b (o may be a or b).',
            'function multiply(o: Address, a: Address, b: Address) {',
            '    immut a0 = limb(a, 0)',
            '    immut a1 = limb(a, 1)',
            '    immut a2 = limb(a, 2)',
            '    immut a3 = limb(a, 3)',
            '    immut a4 = limb(a, 4)',
            '    immut b0 = limb(b, 0)',
            '    immut b1 = limb(b, 1)',
            '    immut b2 = limb(b, 2)',
            '    immut b3 = limb(b, 3)',
            '    immut b4 = limb(b, 4)',
            '    // The limbs past the top, times 19 (below 2^59).',
            '    immut c1 = b1 * 19',
            '    immut c2 = b2 * 19',
            '    immut c3 = b3 * 19',
            '    immut c4 = b4 * 19',
            '    immut r0 = product(a0, b0) + product(a1, c4) + product(a2, c3) + product(a3, c2) + product(a4, c1)',
            '    immut r1 = product(a0, b1) + product(a1, b0) + product(a2, c4) + product(a3, c3) + product(a4, c2)',
            '    immut r2 = product(a0, b2) + product(a1, b1) + product(a2, b0) + product(a3, c4) + product(a4, c3)',
            '    immut r3 = product(a0, b3) + product(a1, b2) + product(a2, b1) + product(a3, b0) + product(a4, c4)',
            '    immut r4 = product(a0, b4) + product(a1, b3) + product(a2, b2) + product(a3, b1) + product(a4, b0)',
            '    carry(o, r0, r1, r2, r3, r4)',
            '}',
            '',
            '// o = a^2: the products of different limbs taken once, doubled.',
            'function square(o: Address, a: Address) {',
            '    immut a0 = limb(a, 0)',
            '    immut a1 = limb(a, 1)',
            '    immut a2 = limb(a, 2)',
            '    immut a3 = limb(a, 3)',
            '    immut a4 = limb(a, 4)',
            '    immut d0 = 2 * a0',
            '    immut d1 = 2 * a1',
            '    immut d2 = 2 * a2',
            '    immut e3 = 19 * a3',
            '    immut e4 = 19 * a4',
            '    immut r0 = product(a0, a0) + product(d1, e4) + product(2 * a2, e3)',
            '    immut r1 = product(d0, a1) + product(d2, e4) + product(a3, e3)',
            '    immut r2 = product(d0, a2) + product(a1, a1) + product(2 * a3, e4)',
            '    immut r3 = product(d0, a3) + product(d1, a2) + product(a4, e4)',
            '    immut r4 = product(d0, a4) + product(d1, a3) + product(a2, a2)',
            '    carry(o, r0, r1, r2, r3, r4)',
            '}',
            '',
            '// o = a^(2^n): n squarings.',
            'function squareTimes(o: Address, a: Address, n: int) {',
            '    square(o, a)',
            '',
            '    for i in range(n - 1) {',
            '        square(o, o)',
            '    }',
            '}',
            '',
            '// o = a * 121665 ((486662 - 2) / 4, the constant of the ladder).',
            'function multiplySmall(o: Address, a: Address) {',
            '    immut k = wide(121665, 0)',
            '    carry(o, wide(limb(a, 0), 0) * k, wide(limb(a, 1), 0) * k, wide(limb(a, 2), 0) * k, wide(limb(a, 3), 0) * k, wide(limb(a, 4), 0) * k)',
            '}',
            '',
            '// Swaps p and q when `bit` is 1, with a mask: the same operations either way.',
            'function swap(p: Address, q: Address, bit: int) {',
            '    immut m = 0 - bit',
            '',
            '    for i in range(5) {',
            '        immut t = m & (limb(p, i) ^ limb(q, i))',
            '        setLimb(p, i, limb(p, i) ^ t)',
            '        setLimb(q, i, limb(q, i) ^ t)',
            '    }',
            '}',
            '',
            '// o = 1 / z, as z^(p - 2) = z^(2^255 - 21), by the addition chain of curve25519-donna: 254 squarings',
            '// and 11 products.',
            'function invert(o: Address, z: Address) {',
            '    immut z2 = newElement()',
            '    immut z9 = newElement()',
            '    immut z11 = newElement()',
            '    immut z2_5_0 = newElement()',
            '    immut z2_10_0 = newElement()',
            '    immut z2_20_0 = newElement()',
            '    immut z2_50_0 = newElement()',
            '    immut z2_100_0 = newElement()',
            '    immut t = newElement()',
            '    square(z2, z)',
            '    squareTimes(t, z2, 2)',
            '    multiply(z9, t, z)',
            '    multiply(z11, z9, z2)',
            '    square(t, z11)',
            '    multiply(z2_5_0, t, z9)',
            '    squareTimes(t, z2_5_0, 5)',
            '    multiply(z2_10_0, t, z2_5_0)',
            '    squareTimes(t, z2_10_0, 10)',
            '    multiply(z2_20_0, t, z2_10_0)',
            '    squareTimes(t, z2_20_0, 20)',
            '    multiply(t, t, z2_20_0)',
            '    squareTimes(t, t, 10)',
            '    multiply(z2_50_0, t, z2_10_0)',
            '    squareTimes(t, z2_50_0, 50)',
            '    multiply(z2_100_0, t, z2_50_0)',
            '    squareTimes(t, z2_100_0, 100)',
            '    multiply(t, t, z2_100_0)',
            '    squareTimes(t, t, 50)',
            '    multiply(t, t, z2_50_0)',
            '    squareTimes(t, t, 5)',
            '    multiply(o, t, z11)',
            '',
            '    for each in [z2, z9, z11, z2_5_0, z2_10_0, z2_20_0, z2_50_0, z2_100_0, t] {',
            '        free(each)',
            '    }',
            '}',
            '',
            '// The 8 bytes at `at`, little-endian.',
            'function word(bytes: Address, at: int): int {',
            '    mut value = 0',
            '',
            '    for i in range(8) {',
            '        value = value | (byteAt(bytes, at + i) << (8 * i))',
            '    }',
            '',
            '    return value',
            '}',
            '',
            '// The u-coordinate of 32 bytes (little-endian; the top bit ignored, as the RFC asks).',
            'function unpack(o: Address, bytes: Address) {',
            '    immut w0 = word(bytes, 0)',
            '    immut w1 = word(bytes, 8)',
            '    immut w2 = word(bytes, 16)',
            '    immut w3 = word(bytes, 24)',
            '    setLimb(o, 0, w0 & mask)',
            '    setLimb(o, 1, ((w0 >> 51) & 0x1FFF) | ((w1 << 13) & mask))',
            '    setLimb(o, 2, ((w1 >> 38) & 0x3FFFFFF) | ((w2 << 26) & mask))',
            '    setLimb(o, 3, ((w2 >> 25) & 0x7FFFFFFFFF) | ((w3 << 39) & mask))',
            '    setLimb(o, 4, (w3 >> 12) & mask)',
            '}',
            '',
            '// The limbs carried to 51 bits each, the carry out of the top folded in times 19 (`fold`) or dropped.',
            'function carryFull(h: Address, fold: boolean) {',
            '    for i in range(4) {',
            '        setLimb(h, i + 1, limb(h, i + 1) + (limb(h, i) >> 51))',
            '        setLimb(h, i, limb(h, i) & mask)',
            '    }',
            '',
            '    if (fold) { setLimb(h, 0, limb(h, 0) + 19 * (limb(h, 4) >> 51)) }',
            '',
            '    setLimb(h, 4, limb(h, 4) & mask)',
            '}',
            '',
            '// The 32 bytes (little-endian) of a reduced fully modulo p, at `out` (as fcontract of',
            '// curve25519-donna).',
            'function pack(out: Address, a: Address) {',
            '    immut h = newElement()',
            '    memcpy(h, a, 40)',
            '    // Between 0 and 2^255 - 1, carried.',
            '    carryFull(h, true)',
            '    carryFull(h, true)',
            '    // Plus 19: between 19 and 2^255 - 1 whether h was below p or not (then it wrapped past 2^255).',
            '    setLimb(h, 0, limb(h, 0) + 19)',
            '    carryFull(h, true)',
            '    // Plus 2^255 - 19: h + 2^255, whose bit 255 is dropped.',
            '    setLimb(h, 0, limb(h, 0) + 0x8000000000000 - 19)',
            '',
            '    for i in range(1, 5) {',
            '        setLimb(h, i, limb(h, i) + 0x8000000000000 - 1)',
            '    }',
            '',
            '    carryFull(h, false)',
            '    immut h0 = limb(h, 0)',
            '    immut h1 = limb(h, 1)',
            '    immut h2 = limb(h, 2)',
            '    immut h3 = limb(h, 3)',
            '    immut h4 = limb(h, 4)',
            '    immut words = [h0 | (h1 << 51), (h1 >> 13) | (h2 << 38), (h2 >> 26) | (h3 << 25), (h3 >> 39) | (h4 << 12)]',
            '',
            '    for i in range(4) {',
            '        for j in range(8) {',
            '            write(out, 8 * i + j, byte((words[i] >> (8 * j)) & 0xFF))',
            '        }',
            '    }',
            '',
            '    free(h)',
            '}',
            '',
            '// X25519 of the scalar (32 bytes, clamped here) and the u-coordinate of a point (32 bytes), at',
            '// `out` (32 bytes): the ladder of RFC 7748.',
            'export function x25519(out: Address, scalar: Address, point: Address) {',
            '    immut k = allocate(32)',
            '    memcpy(k, scalar, 32)',
            '    write(k, 31, byte((byteAt(scalar, 31) & 127) | 64))',
            '    write(k, 0, byte(byteAt(scalar, 0) & 248))',
            '    immut x1 = newElement()',
            '    unpack(x1, point)',
            '    immut x2 = newElement()',
            '    immut z2 = newElement()',
            '    immut x3 = newElement()',
            '    immut z3 = newElement()',
            '    setLimb(x2, 0, 1)',
            '    memcpy(x3, x1, 40)',
            '    setLimb(z3, 0, 1)',
            '    immut a = newElement()',
            '    immut aa = newElement()',
            '    immut b = newElement()',
            '    immut bb = newElement()',
            '    immut e = newElement()',
            '    immut c = newElement()',
            '    immut d = newElement()',
            '    immut da = newElement()',
            '    immut cb = newElement()',
            '    mut swapped = 0',
            '    mut t = 254',
            '',
            '    while (t >= 0) {',
            '        immut bit = (byteAt(k, t >> 3) >> (t & 7)) & 1',
            '        swapped = swapped ^ bit',
            '        swap(x2, x3, swapped)',
            '        swap(z2, z3, swapped)',
            '        swapped = bit',
            '        add(a, x2, z2)',
            '        square(aa, a)',
            '        subtract(b, x2, z2)',
            '        square(bb, b)',
            '        subtract(e, aa, bb)',
            '        add(c, x3, z3)',
            '        subtract(d, x3, z3)',
            '        multiply(da, d, a)',
            '        multiply(cb, c, b)',
            '        add(x3, da, cb)',
            '        square(x3, x3)',
            '        subtract(z3, da, cb)',
            '        square(z3, z3)',
            '        multiply(z3, z3, x1)',
            '        multiply(x2, aa, bb)',
            '        multiplySmall(z2, e)',
            '        add(z2, z2, aa)',
            '        multiply(z2, z2, e)',
            '        t -= 1',
            '    }',
            '',
            '    swap(x2, x3, swapped)',
            '    swap(z2, z3, swapped)',
            '    invert(z2, z2)',
            '    multiply(x2, x2, z2)',
            '    pack(out, x2)',
            '',
            '    for each in [k, x1, x2, z2, x3, z3, a, aa, b, bb, e, c, d, da, cb] {',
            '        free(each)',
            '    }',
            '}',
            '',
            '// The public key of a secret one: X25519 of the scalar and the base point (u = 9).',
            'export function x25519Base(out: Address, scalar: Address) {',
            '    immut base = allocate(32)',
            '',
            '    for i in range(32) {',
            '        write(base, i, byte(if (i == 0) { 9 } else { 0 }))',
            '    }',
            '',
            '    x25519(out, scalar, base)',
            '    free(base)',
            '}',
            '',
            '// For C (the tests of the library).',
            'extern function koji_x25519(out: Address, scalar: Address, point: Address) {',
            '    x25519(out, scalar, point)',
            '}',
        ].join('\n'))
    }

    if (name == 'koji:x509') {
        return Some([
            '// `koji:x509`: the certificates of TLS (RFC 5280), in the library of the runtime written in Koji:',
            '// their DER read, the chain of a server verified up to an authority, and its name checked (RFC 6125).',
            '// The authorities are those of the system (`SSL_CERT_FILE`, `SSL_CERT_DIR`, else the usual files',
            '// of Linux, macOS and the BSDs), or, when the system has none, those of Mozilla\'s list built into the',
            '// library (koji:roots), as Go does. Of an authority only its subject and its key are used, as in',
            '// rustls (its dates, its constraints and its own signature are not: the system trusts it).',
            '//',
            '// As Go and rustls verify: signatures RSA (PKCS #1 v1.5 and PSS, keys of 2048 to 8192 bits) and',
            '// ECDSA (P-256, P-384 and P-521) with SHA-256, SHA-384 or SHA-512, never SHA-1; the dates of every',
            '// certificate of the chain; basicConstraints (and its length of path), keyUsage and extKeyUsage',
            '// (serverAuth); the name constraints of the intermediates on the DNS names, IP addresses and',
            '// subjects below them; a critical extension not known makes a certificate invalid. The name of the',
            '// server is matched against the DNS names and IP addresses of the certificate (subjectAltName; the',
            '// common name is not used), a wildcard standing for the whole leftmost label.',
            '//',
            '// Everything here is public: nothing needs constant time.',
            '',
            'import { Address, CInt, CSize, allocate, free, isNull, newString, nullAddress, offset, read, stringBytes, stringSize, write } from \'koji:unsafe\'',
            'import { digest, digestSize } from \'koji:sha\'',
            'import { verifyPkcs1, verifyPss } from \'koji:rsa\'',
            'import { verify } from \'koji:ecc\'',
            'import { rootCount, roots } from \'koji:roots\'',
            '',
            'extern function memcpy(target: Address, source: Address, size: CSize): Address',
            'extern function memcmp(a: Address, b: Address, size: CSize): CInt',
            'extern function strlen(text: Address): CSize',
            'extern function getenv(name: Address): Address',
            'extern function fopen(path: Address, mode: Address): Address',
            'extern function fread(target: Address, size: CSize, count: CSize, file: Address): CSize',
            'extern function fclose(file: Address): CInt',
            'extern function opendir(path: Address): Address',
            'extern function readdir(directory: Address): Address',
            'extern function closedir(directory: Address): CInt',
            'extern function koji_directory_entry_name(entry: Address): Address',
            'extern function realloc(block: Address, size: CSize): Address',
            'extern function time(place: Address): int',
            '',
            '// The results of a verification: why a chain is not trusted.',
            'export immut trusted = 0',
            'export immut malformed = 1',
            'export immut expired = 2',
            'export immut unknownIssuer = 3',
            'export immut badSignature = 4',
            'export immut wrongName = 5',
            'export immut notAuthorized = 6',
            'export immut unsupported = 7',
            '',
            '// The message of a result, for the errors of TLS.',
            'export function problemText(problem: int): string {',
            '    return match (problem) {',
            '        0 => \'trusted\'',
            '        1 => \'a certificate is malformed\'',
            '        2 => \'a certificate has expired or is not yet valid\'',
            '        3 => \'the certificate is not signed by a known authority\'',
            '        4 => \'a signature of the certificate chain is invalid\'',
            '        5 => \'the certificate is not valid for this name\'',
            '        6 => \'a certificate is not authorized for this use\'',
            '        _ => \'a certificate uses an algorithm that is not supported\'',
            '    }',
            '}',
            '',
            'function byteAt(bytes: Address, i: int): int {',
            '    immut b: byte = read(bytes, i)',
            '    return int(b)',
            '}',
            '',
            '// DER',
            '',
            '// An element: its tag, where its contents start and where it ends (`good` false when it does not',
            '// fit in the bytes before `limit`, or its length is not in the form of DER).',
            'export type Element = {',
            '    good: boolean',
            '    tag: int',
            '    start: int',
            '    end: int',
            '}',
            '',
            'function badElement(): Element {',
            '    return { good: false, tag: 0, start: 0, end: 0 }',
            '}',
            '',
            '// The element at `at`, within `limit`.',
            'export function element(bytes: Address, at: int, limit: int): Element {',
            '    if (at + 2 > limit) { return badElement() }',
            '',
            '    immut tag = byteAt(bytes, at)',
            '',
            '    // A tag of several bytes (a number of 31 or more) is not used by certificates.',
            '    if (tag & 0x1F == 0x1F) { return badElement() }',
            '',
            '    immut first = byteAt(bytes, at + 1)',
            '',
            '    if (first < 0x80) {',
            '        if (at + 2 + first > limit) { return badElement() }',
            '',
            '        return { good: true, tag: tag, start: at + 2, end: at + 2 + first }',
            '    }',
            '',
            '    // The long form, in as few bytes as it can (and not for a length below 128).',
            '    immut count = first & 0x7F',
            '',
            '    if (count == 0 or count > 3 or at + 2 + count > limit) { return badElement() }',
            '',
            '    if (byteAt(bytes, at + 2) == 0) { return badElement() }',
            '',
            '    mut length = 0',
            '',
            '    for i in range(count) {',
            '        length = (length << 8) | byteAt(bytes, at + 2 + i)',
            '    }',
            '',
            '    if (length < 0x80 or at + 2 + count + length > limit) { return badElement() }',
            '',
            '    return { good: true, tag: tag, start: at + 2 + count, end: at + 2 + count + length }',
            '}',
            '',
            '// The element at `at` when it has the tag, else a bad one.',
            'export function expect(bytes: Address, at: int, limit: int, tag: int): Element {',
            '    immut e = element(bytes, at, limit)',
            '',
            '    if (not e.good or e.tag != tag) { return badElement() }',
            '',
            '    return e',
            '}',
            '',
            '// Whether the contents of an element are the bytes of `hex`.',
            'function contentsAre(bytes: Address, e: Element, hex: string): boolean {',
            '    immut size = hex.length() / 2',
            '',
            '    if (e.end - e.start != size) { return false }',
            '',
            '    for i in range(size) {',
            '        if (byteAt(bytes, e.start + i) != hexValue(hex, 2 * i) * 16 + hexValue(hex, 2 * i + 1)) { return false }',
            '    }',
            '',
            '    return true',
            '}',
            '',
            'function hexValue(text: string, at: int): int {',
            '    immut c = text[at]',
            '    return if (c >= \'a\') { c.code() - 87 } else { c.code() - 48 }',
            '}',
            '',
            '// Whether two runs of bytes are the same.',
            'function sameBytes(a: Address, aStart: int, aSize: int, b: Address, bStart: int, bSize: int): boolean {',
            '    return aSize == bSize and memcmp(offset(a, aStart), offset(b, bStart), aSize) == 0',
            '}',
            '',
            '// The bytes of a positive INTEGER without its leading zero: where they start (its size is then',
            '// `e.end - start`), or -1 when it is negative, empty or not in the form of DER.',
            'function unsignedStart(bytes: Address, e: Element): int {',
            '    if (e.end <= e.start) { return -1 }',
            '',
            '    immut first = byteAt(bytes, e.start)',
            '',
            '    if (first & 0x80 != 0) { return -1 }',
            '',
            '    if (first == 0 and e.end - e.start > 1) {',
            '        // A zero only before a byte whose top bit is set.',
            '        if (byteAt(bytes, e.start + 1) & 0x80 == 0) { return -1 }',
            '',
            '        return e.start + 1',
            '    }',
            '',
            '    return e.start',
            '}',
            '',
            '// Algorithms',
            '',
            '// A way of signing: RSA with PKCS #1 v1.5 (0) or PSS (1), or ECDSA (2), with SHA-256 (0), SHA-384',
            '// (1) or SHA-512 (2); `kind` -1 for one that is not supported.',
            'export type Algorithm = {',
            '    kind: int',
            '    hash: int',
            '}',
            '',
            'function unsupportedAlgorithm(): Algorithm {',
            '    return { kind: -1, hash: 0 }',
            '}',
            '',
            '// The hash of the OID of an element of SHA-2 (2.16.840.1.101.3.4.2.1 to 3), or -1.',
            'function hashOf(bytes: Address, e: Element): int {',
            '    for hash in range(3) {',
            '        if (contentsAre(bytes, e, \'6086480165030402\' + [\'01\', \'02\', \'03\'][hash])) { return hash }',
            '    }',
            '',
            '    return -1',
            '}',
            '',
            '// The hash of an AlgorithmIdentifier of SHA-2 whose parameters are absent or NULL, or -1.',
            'function hashAlgorithmOf(bytes: Address, e: Element): int {',
            '    immut oid = expect(bytes, e.start, e.end, 0x06)',
            '',
            '    if (not oid.good) { return -1 }',
            '',
            '    if (oid.end != e.end and not isDerNull(bytes, oid.end, e.end)) { return -1 }',
            '',
            '    return hashOf(bytes, oid)',
            '}',
            '',
            '// Whether the element at `at` is a NULL that ends at `limit`.',
            'function isDerNull(bytes: Address, at: int, limit: int): boolean {',
            '    immut e = element(bytes, at, limit)',
            '    return e.good and e.tag == 0x05 and e.start == e.end and e.end == limit',
            '}',
            '',
            '// The algorithm of an AlgorithmIdentifier (a SEQUENCE).',
            'export function algorithmOf(bytes: Address, e: Element): Algorithm {',
            '    immut oid = expect(bytes, e.start, e.end, 0x06)',
            '',
            '    if (not oid.good) { return unsupportedAlgorithm() }',
            '',
            '    // sha256, sha384 and sha512WithRSAEncryption: NULL parameters (or none, as some write them).',
            '    for hash in range(3) {',
            '        if (contentsAre(bytes, oid, \'2a864886f70d0101\' + [\'0b\', \'0c\', \'0d\'][hash])) {',
            '            if (oid.end != e.end and not isDerNull(bytes, oid.end, e.end)) { return unsupportedAlgorithm() }',
            '',
            '            return { kind: 0, hash: hash }',
            '        }',
            '    }',
            '',
            '    // ecdsa-with-SHA256, SHA384 and SHA512: no parameters.',
            '    for hash in range(3) {',
            '        if (contentsAre(bytes, oid, \'2a8648ce3d0403\' + [\'02\', \'03\', \'04\'][hash])) {',
            '            if (oid.end != e.end) { return unsupportedAlgorithm() }',
            '',
            '            return { kind: 2, hash: hash }',
            '        }',
            '    }',
            '',
            '    if (contentsAre(bytes, oid, \'2a864886f70d01010a\')) { return pssAlgorithm(bytes, oid.end, e.end) }',
            '',
            '    return unsupportedAlgorithm()',
            '}',
            '',
            '// RSASSA-PSS-params: the hash ([0]), MGF1 with the same hash ([1]), a salt as long as the digest',
            '// ([2]) and the trailer 1 ([3]). The defaults (SHA-1) are not supported.',
            'function pssAlgorithm(bytes: Address, at: int, limit: int): Algorithm {',
            '    immut params = expect(bytes, at, limit, 0x30)',
            '',
            '    if (not params.good or params.end != limit) { return unsupportedAlgorithm() }',
            '',
            '    immut hashPart = expect(bytes, params.start, params.end, 0xA0)',
            '',
            '    if (not hashPart.good) { return unsupportedAlgorithm() }',
            '',
            '    immut hashAlgorithm = expect(bytes, hashPart.start, hashPart.end, 0x30)',
            '',
            '    if (not hashAlgorithm.good or hashAlgorithm.end != hashPart.end) { return unsupportedAlgorithm() }',
            '',
            '    immut hash = hashAlgorithmOf(bytes, hashAlgorithm)',
            '',
            '    if (hash < 0) { return unsupportedAlgorithm() }',
            '',
            '    immut maskPart = expect(bytes, hashPart.end, params.end, 0xA1)',
            '',
            '    if (not maskPart.good) { return unsupportedAlgorithm() }',
            '',
            '    immut mask = expect(bytes, maskPart.start, maskPart.end, 0x30)',
            '',
            '    if (not mask.good or mask.end != maskPart.end) { return unsupportedAlgorithm() }',
            '',
            '    immut mgf = expect(bytes, mask.start, mask.end, 0x06)',
            '',
            '    if (not mgf.good or not contentsAre(bytes, mgf, \'2a864886f70d010108\')) { return unsupportedAlgorithm() }',
            '',
            '    immut maskHash = expect(bytes, mgf.end, mask.end, 0x30)',
            '',
            '    if (not maskHash.good or maskHash.end != mask.end or hashAlgorithmOf(bytes, maskHash) != hash) { return unsupportedAlgorithm() }',
            '',
            '    immut saltPart = expect(bytes, maskPart.end, params.end, 0xA2)',
            '',
            '    if (not saltPart.good) { return unsupportedAlgorithm() }',
            '',
            '    immut salt = expect(bytes, saltPart.start, saltPart.end, 0x02)',
            '',
            '    if (not salt.good or salt.end != saltPart.end or salt.end - salt.start != 1 or byteAt(bytes, salt.start) != digestSize(hash)) { return unsupportedAlgorithm() }',
            '',
            '    // The trailer, when it is there, is 1.',
            '    if (saltPart.end != params.end) {',
            '        immut trailerPart = expect(bytes, saltPart.end, params.end, 0xA3)',
            '',
            '        if (not trailerPart.good or trailerPart.end != params.end) { return unsupportedAlgorithm() }',
            '',
            '        immut trailer = expect(bytes, trailerPart.start, trailerPart.end, 0x02)',
            '',
            '        if (not trailer.good or trailer.end != trailerPart.end or trailer.end - trailer.start != 1 or byteAt(bytes, trailer.start) != 1) { return unsupportedAlgorithm() }',
            '    }',
            '',
            '    return { kind: 1, hash: hash }',
            '}',
            '',
            '// Keys',
            '',
            '// A public key: RSA (`kind` 0: the modulus at `a`, the exponent at `b`) or EC (`kind` 1: the curve,',
            '// 0 for P-256, 1 for P-384 and 2 for P-521, and the uncompressed point at `a`), in `bytes`; `kind` -1 for a key',
            '// that is not supported.',
            'export type PublicKey = {',
            '    kind: int',
            '    curve: int',
            '    bytes: Address',
            '    aStart: int',
            '    aSize: int',
            '    bStart: int',
            '    bSize: int',
            '}',
            '',
            'function unsupportedKey(): PublicKey {',
            '    return { kind: -1, curve: 0, bytes: nullAddress(), aStart: 0, aSize: 0, bStart: 0, bSize: 0 }',
            '}',
            '',
            '// The key of a SubjectPublicKeyInfo (a SEQUENCE).',
            'export function keyOf(bytes: Address, e: Element): PublicKey {',
            '    immut algorithm = expect(bytes, e.start, e.end, 0x30)',
            '',
            '    if (not algorithm.good) { return unsupportedKey() }',
            '',
            '    immut bits = expect(bytes, algorithm.end, e.end, 0x03)',
            '',
            '    // A BIT STRING of whole bytes.',
            '    if (not bits.good or bits.end != e.end or bits.end - bits.start < 2 or byteAt(bytes, bits.start) != 0) { return unsupportedKey() }',
            '',
            '    immut oid = expect(bytes, algorithm.start, algorithm.end, 0x06)',
            '',
            '    if (not oid.good) { return unsupportedKey() }',
            '',
            '    if (contentsAre(bytes, oid, \'2a864886f70d010101\')) {',
            '        if (not isDerNull(bytes, oid.end, algorithm.end)) { return unsupportedKey() }',
            '',
            '        return rsaKeyOf(bytes, bits.start + 1, bits.end)',
            '    }',
            '',
            '    if (contentsAre(bytes, oid, \'2a8648ce3d0201\')) {',
            '        immut curveOid = expect(bytes, oid.end, algorithm.end, 0x06)',
            '',
            '        if (not curveOid.good or curveOid.end != algorithm.end) { return unsupportedKey() }',
            '',
            '        mut curve = -1',
            '',
            '        for i in range(3) {',
            '            if (contentsAre(bytes, curveOid, [\'2a8648ce3d030107\', \'2b81040022\', \'2b81040023\'][i])) { curve = i }',
            '        }',
            '',
            '        immut size = 1 + 2 * coordinateSize(curve)',
            '',
            '        // The point uncompressed (04, x, y); koji:ecc checks that it is on the curve.',
            '        if (curve < 0 or bits.end - bits.start - 1 != size or byteAt(bytes, bits.start + 1) != 4) { return unsupportedKey() }',
            '',
            '        return { kind: 1, curve: curve, bytes: bytes, aStart: bits.start + 1, aSize: size, bStart: 0, bSize: 0 }',
            '    }',
            '',
            '    return unsupportedKey()',
            '}',
            '',
            '// The bytes of a coordinate of the curve 0 (P-256), 1 (P-384) or 2 (P-521).',
            'function coordinateSize(curve: int): int {',
            '    return match (curve) {',
            '        0 => 32',
            '        1 => 48',
            '        _ => 66',
            '    }',
            '}',
            '',
            '// RSAPublicKey: the modulus (2048 to 8192 bits, odd) and the exponent (odd, at least 3, at most 4',
            '// bytes).',
            'function rsaKeyOf(bytes: Address, at: int, limit: int): PublicKey {',
            '    immut sequence = expect(bytes, at, limit, 0x30)',
            '',
            '    if (not sequence.good or sequence.end != limit) { return unsupportedKey() }',
            '',
            '    immut modulus = expect(bytes, sequence.start, sequence.end, 0x02)',
            '',
            '    if (not modulus.good) { return unsupportedKey() }',
            '',
            '    immut exponent = expect(bytes, modulus.end, sequence.end, 0x02)',
            '',
            '    if (not exponent.good or exponent.end != sequence.end) { return unsupportedKey() }',
            '',
            '    immut n = unsignedStart(bytes, modulus)',
            '    immut e = unsignedStart(bytes, exponent)',
            '',
            '    if (n < 0 or e < 0) { return unsupportedKey() }',
            '',
            '    immut nSize = modulus.end - n',
            '    immut eSize = exponent.end - e',
            '',
            '    if (nSize < 256 or nSize > 1024 or byteAt(bytes, n) == 0 or byteAt(bytes, modulus.end - 1) & 1 == 0) { return unsupportedKey() }',
            '',
            '    if (eSize > 4 or byteAt(bytes, exponent.end - 1) & 1 == 0 or (eSize == 1 and byteAt(bytes, e) < 3)) { return unsupportedKey() }',
            '',
            '    return { kind: 0, curve: 0, bytes: bytes, aStart: n, aSize: nSize, bStart: e, bSize: eSize }',
            '}',
            '',
            '// Whether `signature` (`size` bytes; for ECDSA the SEQUENCE of r and s, as certificates and TLS',
            '// write it) signs the `messageSize` bytes at `message` with `key` and `algorithm`.',
            'export function verifySignature(key: PublicKey, algorithm: Algorithm, message: Address, messageSize: int, signature: Address, size: int): boolean {',
            '    if (algorithm.kind < 0 or key.kind < 0) { return false }',
            '',
            '    // The algorithm of the key\'s kind: RSA for RSA, ECDSA for EC.',
            '    if ((key.kind == 0) != (algorithm.kind < 2)) { return false }',
            '',
            '    immut length = digestSize(algorithm.hash)',
            '    immut hashed = allocate(length)',
            '    digest(algorithm.hash, message, messageSize, hashed)',
            '    mut good = false',
            '',
            '    if (algorithm.kind == 0) {',
            '        good = verifyPkcs1(algorithm.hash, hashed, length, signature, size, offset(key.bytes, key.aStart), key.aSize, offset(key.bytes, key.bStart), key.bSize)',
            '    }',
            '',
            '    if (algorithm.kind == 1) {',
            '        good = verifyPss(algorithm.hash, hashed, length, signature, size, offset(key.bytes, key.aStart), key.aSize, offset(key.bytes, key.bStart), key.bSize)',
            '    }',
            '',
            '    if (algorithm.kind == 2) { good = verifyEcdsa(key, hashed, length, signature, size) }',
            '',
            '    free(hashed)',
            '    return good',
            '}',
            '',
            '// ECDSA: the SEQUENCE of the INTEGERs r and s, each at most as long as a coordinate.',
            'function verifyEcdsa(key: PublicKey, hashed: Address, length: int, signature: Address, size: int): boolean {',
            '    immut sequence = expect(signature, 0, size, 0x30)',
            '',
            '    if (not sequence.good or sequence.end != size) { return false }',
            '',
            '    immut r = expect(signature, sequence.start, sequence.end, 0x02)',
            '',
            '    if (not r.good) { return false }',
            '',
            '    immut s = expect(signature, r.end, sequence.end, 0x02)',
            '',
            '    if (not s.good or s.end != sequence.end) { return false }',
            '',
            '    immut rStart = unsignedStart(signature, r)',
            '    immut sStart = unsignedStart(signature, s)',
            '    immut coordinate = coordinateSize(key.curve)',
            '',
            '    if (rStart < 0 or sStart < 0 or r.end - rStart > coordinate or s.end - sStart > coordinate) { return false }',
            '',
            '    // r and s in `coordinate` bytes each (zeros before).',
            '    immut fixed = allocate(2 * coordinate)',
            '',
            '    for i in range(2 * coordinate) {',
            '        write(fixed, i, byte(0))',
            '    }',
            '',
            '    memcpy(offset(fixed, coordinate - (r.end - rStart)), offset(signature, rStart), r.end - rStart)',
            '    memcpy(offset(fixed, 2 * coordinate - (s.end - sStart)), offset(signature, sStart), s.end - sStart)',
            '    immut good = verify(key.curve, hashed, length, fixed, offset(fixed, coordinate), offset(key.bytes, key.aStart), key.aSize)',
            '    free(fixed)',
            '    return good',
            '}',
            '',
            '// Times',
            '',
            '// The seconds since 1970 of a UTCTime (YYMMDDHHMMSSZ: 1950 to 2049) or a GeneralizedTime',
            '// (YYYYMMDDHHMMSSZ), or -1 when it is not in one of these forms (those of DER).',
            'function timeOf(bytes: Address, e: Element): int {',
            '    immut size = e.end - e.start',
            '    immut long = e.tag == 0x18',
            '',
            '    if (not ((e.tag == 0x17 and size == 13) or (long and size == 15))) { return -1 }',
            '',
            '    if (byteAt(bytes, e.end - 1) != 0x5A) { return -1 }',
            '',
            '    for i in range(size - 1) {',
            '        immut c = byteAt(bytes, e.start + i)',
            '',
            '        if (c < 0x30 or c > 0x39) { return -1 }',
            '    }',
            '',
            '    immut digits = if (long) { 4 } else { 2 }',
            '    mut year = number(bytes, e.start, digits)',
            '',
            '    if (not long) { year = if (year < 50) { 2000 + year } else { 1900 + year } }',
            '',
            '    immut at = e.start + digits',
            '    immut month = number(bytes, at, 2)',
            '    immut day = number(bytes, at + 2, 2)',
            '    immut hour = number(bytes, at + 4, 2)',
            '    immut minute = number(bytes, at + 6, 2)',
            '    immut second = number(bytes, at + 8, 2)',
            '',
            '    if (month < 1 or month > 12 or day < 1 or day > daysIn(year, month) or hour > 23 or minute > 59 or second > 59) { return -1 }',
            '',
            '    return ((daysFromCivil(year, month, day) * 24 + hour) * 60 + minute) * 60 + second',
            '}',
            '',
            'function number(bytes: Address, at: int, digits: int): int {',
            '    mut value = 0',
            '',
            '    for i in range(digits) {',
            '        value = value * 10 + byteAt(bytes, at + i) - 0x30',
            '    }',
            '',
            '    return value',
            '}',
            '',
            'function daysIn(year: int, month: int): int {',
            '    if (month == 2) {',
            '        immut leap = (year % 4 == 0 and year % 100 != 0) or year % 400 == 0',
            '        return if (leap) { 29 } else { 28 }',
            '    }',
            '',
            '    return if (month == 4 or month == 6 or month == 9 or month == 11) { 30 } else { 31 }',
            '}',
            '',
            '// The days from 1970-01-01 to a date (Howard Hinnant\'s days_from_civil).',
            'function daysFromCivil(year: int, month: int, day: int): int {',
            '    immut y = if (month <= 2) { year - 1 } else { year }',
            '    immut era = y / 400',
            '    immut yearOfEra = y - era * 400',
            '    immut shifted = if (month > 2) { month - 3 } else { month + 9 }',
            '    immut dayOfYear = (153 * shifted + 2) / 5 + day - 1',
            '    immut dayOfEra = yearOfEra * 365 + yearOfEra / 4 - yearOfEra / 100 + dayOfYear',
            '    return era * 146097 + dayOfEra - 719468',
            '}',
            '',
            '// Certificates',
            '',
            '// A certificate read: where its parts are in `bytes` (`size` bytes, its DER); `problem` is',
            '// `trusted` (0) when it could be read, else why not.',
            'export type Certificate = {',
            '    problem: int',
            '    bytes: Address',
            '    size: int',
            '    tbsStart: int',
            '    tbsSize: int',
            '    algorithm: Algorithm',
            '    signatureStart: int',
            '    signatureSize: int',
            '    issuerStart: int',
            '    issuerSize: int',
            '    subjectStart: int',
            '    subjectSize: int',
            '    notBefore: int',
            '    notAfter: int',
            '    key: PublicKey',
            '    authority: boolean',
            '    // The most intermediates below it (basicConstraints), -1 for no limit.',
            '    pathLength: int',
            '    // The bits of keyUsage (bit 0 digitalSignature, bit 5 keyCertSign: the first bits of the BIT',
            '    // STRING), -1 when it is absent.',
            '    keyUsage: int',
            '    // extKeyUsage: 0 absent, 1 serverAuth (or any) in it, 2 present without it.',
            '    serverAuth: int',
            '    // The GeneralNames of subjectAltName, and the GeneralSubtrees of nameConstraints (permitted and',
            '    // excluded); a size of 0 when absent.',
            '    namesStart: int',
            '    namesSize: int',
            '    permittedStart: int',
            '    permittedSize: int',
            '    excludedStart: int',
            '    excludedSize: int',
            '}',
            '',
            'function badCertificate(problem: int, bytes: Address, size: int): Certificate {',
            '    return {',
            '        problem: problem, bytes: bytes, size: size, tbsStart: 0, tbsSize: 0, algorithm: unsupportedAlgorithm(),',
            '        signatureStart: 0, signatureSize: 0, issuerStart: 0, issuerSize: 0, subjectStart: 0, subjectSize: 0,',
            '        notBefore: 0, notAfter: 0, key: unsupportedKey(), authority: false, pathLength: -1, keyUsage: -1,',
            '        serverAuth: 0, namesStart: 0, namesSize: 0, permittedStart: 0, permittedSize: 0, excludedStart: 0,',
            '        excludedSize: 0',
            '    }',
            '}',
            '',
            '// The certificate of the `size` bytes of DER at `bytes` (which it keeps: they must outlive it).',
            'export function certificateOf(bytes: Address, size: int): Certificate {',
            '    immut outer = expect(bytes, 0, size, 0x30)',
            '',
            '    if (not outer.good or outer.end != size) { return badCertificate(malformed, bytes, size) }',
            '',
            '    immut tbs = expect(bytes, outer.start, outer.end, 0x30)',
            '',
            '    if (not tbs.good) { return badCertificate(malformed, bytes, size) }',
            '',
            '    immut outerAlgorithm = expect(bytes, tbs.end, outer.end, 0x30)',
            '',
            '    if (not outerAlgorithm.good) { return badCertificate(malformed, bytes, size) }',
            '',
            '    immut signature = expect(bytes, outerAlgorithm.end, outer.end, 0x03)',
            '',
            '    if (not signature.good or signature.end != outer.end or signature.end == signature.start or byteAt(bytes, signature.start) != 0) {',
            '        return badCertificate(malformed, bytes, size)',
            '    }',
            '',
            '    mut c = badCertificate(malformed, bytes, size)',
            '    c.tbsStart = outer.start',
            '    c.tbsSize = tbs.end - outer.start',
            '    c.signatureStart = signature.start + 1',
            '    c.signatureSize = signature.end - signature.start - 1',
            '    // version [0]: v3 (2) only, as every certificate of the web is.',
            '    immut version = expect(bytes, tbs.start, tbs.end, 0xA0)',
            '',
            '    if (not version.good) { return c }',
            '',
            '    immut versionNumber = expect(bytes, version.start, version.end, 0x02)',
            '',
            '    if (not versionNumber.good or versionNumber.end != version.end or versionNumber.end - versionNumber.start != 1 or byteAt(bytes, versionNumber.start) != 2) {',
            '        return c',
            '    }',
            '',
            '    immut serial = expect(bytes, version.end, tbs.end, 0x02)',
            '',
            '    if (not serial.good) { return c }',
            '',
            '    immut innerAlgorithm = expect(bytes, serial.end, tbs.end, 0x30)',
            '',
            '    // The algorithm signed and the one outside are the same.',
            '    if (not innerAlgorithm.good or not sameBytes(bytes, innerAlgorithm.start, innerAlgorithm.end - innerAlgorithm.start, bytes, outerAlgorithm.start, outerAlgorithm.end - outerAlgorithm.start)) {',
            '        return c',
            '    }',
            '',
            '    c.algorithm = algorithmOf(bytes, innerAlgorithm)',
            '    immut issuer = expect(bytes, innerAlgorithm.end, tbs.end, 0x30)',
            '',
            '    if (not issuer.good) { return c }',
            '',
            '    c.issuerStart = innerAlgorithm.end',
            '    c.issuerSize = issuer.end - innerAlgorithm.end',
            '    immut validity = expect(bytes, issuer.end, tbs.end, 0x30)',
            '',
            '    if (not validity.good) { return c }',
            '',
            '    immut before = element(bytes, validity.start, validity.end)',
            '',
            '    if (not before.good) { return c }',
            '',
            '    immut after = element(bytes, before.end, validity.end)',
            '',
            '    if (not after.good or after.end != validity.end) { return c }',
            '',
            '    c.notBefore = timeOf(bytes, before)',
            '    c.notAfter = timeOf(bytes, after)',
            '',
            '    if (c.notBefore < 0 or c.notAfter < 0) { return c }',
            '',
            '    immut subject = expect(bytes, validity.end, tbs.end, 0x30)',
            '',
            '    if (not subject.good) { return c }',
            '',
            '    c.subjectStart = validity.end',
            '    c.subjectSize = subject.end - validity.end',
            '    immut keyInfo = expect(bytes, subject.end, tbs.end, 0x30)',
            '',
            '    if (not keyInfo.good) { return c }',
            '',
            '    c.key = keyOf(bytes, keyInfo)',
            '    mut at = keyInfo.end',
            '',
            '    // issuerUniqueID [1] and subjectUniqueID [2], skipped.',
            '    for tag in [0x81, 0xA1, 0x82, 0xA2] {',
            '        immut unique = element(bytes, at, tbs.end)',
            '',
            '        if (unique.good and unique.tag == tag) { at = unique.end }',
            '    }',
            '',
            '    if (at != tbs.end) {',
            '        immut extensions = expect(bytes, at, tbs.end, 0xA3)',
            '',
            '        if (not extensions.good or extensions.end != tbs.end) { return c }',
            '',
            '        immut list = expect(bytes, extensions.start, extensions.end, 0x30)',
            '',
            '        if (not list.good or list.end != extensions.end) { return c }',
            '',
            '        if (not readExtensions(mut c, list)) { return c }',
            '    }',
            '',
            '    c.problem = trusted',
            '    return c',
            '}',
            '',
            '// The extensions of a certificate, into it: false when one is malformed, appears twice, or is',
            '// critical and not known.',
            'function readExtensions(mut c: Certificate, list: Element): boolean {',
            '    immut bytes = c.bytes',
            '    mut at = list.start',
            '    mut seen = 0',
            '',
            '    while (at < list.end) {',
            '        immut extension = expect(bytes, at, list.end, 0x30)',
            '',
            '        if (not extension.good) { return false }',
            '',
            '        at = extension.end',
            '        immut oid = expect(bytes, extension.start, extension.end, 0x06)',
            '',
            '        if (not oid.good) { return false }',
            '',
            '        mut next = oid.end',
            '        mut critical = false',
            '        immut flag = element(bytes, next, extension.end)',
            '',
            '        if (flag.good and flag.tag == 0x01) {',
            '            // DER writes no FALSE: a critical flag is TRUE.',
            '            if (flag.end - flag.start != 1 or byteAt(bytes, flag.start) != 0xFF) { return false }',
            '',
            '            critical = true',
            '            next = flag.end',
            '        }',
            '',
            '        immut value = expect(bytes, next, extension.end, 0x04)',
            '',
            '        if (not value.good or value.end != extension.end) { return false }',
            '',
            '        immut known = extensionIndex(bytes, oid)',
            '',
            '        if (known < 0) {',
            '            if (critical) { return false }',
            '        } else {',
            '            if (seen & (1 << known) != 0) { return false }',
            '',
            '            seen = seen | (1 << known)',
            '',
            '            if (not readExtension(mut c, known, value)) { return false }',
            '        }',
            '    }',
            '',
            '    return true',
            '}',
            '',
            '// The extensions known: basicConstraints, keyUsage, extKeyUsage, subjectAltName, nameConstraints,',
            '// and those that need no checking here (certificatePolicies, the key identifiers): their index, or',
            '// -1.',
            'function extensionIndex(bytes: Address, oid: Element): int {',
            '    immut known = [\'551d13\', \'551d0f\', \'551d25\', \'551d11\', \'551d1e\', \'551d20\', \'551d23\', \'551d0e\']',
            '',
            '    for i in range(known.length()) {',
            '        if (contentsAre(bytes, oid, known[i])) { return i }',
            '    }',
            '',
            '    return -1',
            '}',
            '',
            'function readExtension(mut c: Certificate, known: int, value: Element): boolean {',
            '    immut bytes = c.bytes',
            '    immut inner = element(bytes, value.start, value.end)',
            '',
            '    if (not inner.good or inner.end != value.end) { return false }',
            '',
            '    if (known == 0) {',
            '        // basicConstraints: SEQUENCE { cA BOOLEAN DEFAULT FALSE, pathLenConstraint INTEGER OPTIONAL }',
            '        if (inner.tag != 0x30) { return false }',
            '',
            '        mut at = inner.start',
            '        immut flag = element(bytes, at, inner.end)',
            '',
            '        if (flag.good and flag.tag == 0x01) {',
            '            if (flag.end - flag.start != 1 or byteAt(bytes, flag.start) != 0xFF) { return false }',
            '',
            '            c.authority = true',
            '            at = flag.end',
            '        }',
            '',
            '        if (at < inner.end) {',
            '            immut length = expect(bytes, at, inner.end, 0x02)',
            '',
            '            if (not length.good or length.end != inner.end or not c.authority) { return false }',
            '',
            '            immut start = unsignedStart(bytes, length)',
            '',
            '            if (start < 0 or length.end - start > 1) { return false }',
            '',
            '            c.pathLength = if (length.end == start) { 0 } else { byteAt(bytes, start) }',
            '        }',
            '',
            '        return true',
            '    }',
            '',
            '    if (known == 1) {',
            '        // keyUsage: a BIT STRING of at most 2 bytes of bits.',
            '        if (inner.tag != 0x03 or inner.end - inner.start < 2 or inner.end - inner.start > 3) { return false }',
            '',
            '        mut bits = 0',
            '',
            '        for i in range(inner.end - inner.start - 1) {',
            '            immut b = byteAt(bytes, inner.start + 1 + i)',
            '',
            '            // Bit 0 is the top bit of the first byte.',
            '            for j in range(8) {',
            '                if ((b >> (7 - j)) & 1 == 1) { bits = bits | (1 << (8 * i + j)) }',
            '            }',
            '        }',
            '',
            '        c.keyUsage = bits',
            '        return true',
            '    }',
            '',
            '    if (known == 2) {',
            '        // extKeyUsage: a SEQUENCE of OIDs.',
            '        if (inner.tag != 0x30 or inner.end == inner.start) { return false }',
            '',
            '        c.serverAuth = 2',
            '        mut at = inner.start',
            '',
            '        while (at < inner.end) {',
            '            immut purpose = expect(bytes, at, inner.end, 0x06)',
            '',
            '            if (not purpose.good) { return false }',
            '',
            '            if (contentsAre(bytes, purpose, \'2b06010505070301\') or contentsAre(bytes, purpose, \'551d2500\')) { c.serverAuth = 1 }',
            '',
            '            at = purpose.end',
            '        }',
            '',
            '        return true',
            '    }',
            '',
            '    if (known == 3) {',
            '        // subjectAltName: GeneralNames, checked when a name is matched.',
            '        if (inner.tag != 0x30 or inner.end == inner.start or not generalNamesGood(bytes, inner.start, inner.end)) { return false }',
            '',
            '        c.namesStart = inner.start',
            '        c.namesSize = inner.end - inner.start',
            '        return true',
            '    }',
            '',
            '    if (known == 4) {',
            '        // nameConstraints: SEQUENCE { permittedSubtrees [0], excludedSubtrees [1] }, on a CA.',
            '        if (inner.tag != 0x30 or inner.end == inner.start) { return false }',
            '',
            '        mut at = inner.start',
            '        immut permitted = element(bytes, at, inner.end)',
            '',
            '        if (permitted.good and permitted.tag == 0xA0) {',
            '            if (not subtreesGood(bytes, permitted.start, permitted.end)) { return false }',
            '',
            '            c.permittedStart = permitted.start',
            '            c.permittedSize = permitted.end - permitted.start',
            '            at = permitted.end',
            '        }',
            '',
            '        if (at < inner.end) {',
            '            immut excluded = expect(bytes, at, inner.end, 0xA1)',
            '',
            '            if (not excluded.good or excluded.end != inner.end or not subtreesGood(bytes, excluded.start, excluded.end)) { return false }',
            '',
            '            c.excludedStart = excluded.start',
            '            c.excludedSize = excluded.end - excluded.start',
            '        }',
            '',
            '        return true',
            '    }',
            '',
            '    // certificatePolicies and the key identifiers: well formed is enough.',
            '    return true',
            '}',
            '',
            '// Whether the run of bytes is a run of elements (GeneralName: a context tag each).',
            'function generalNamesGood(bytes: Address, start: int, end: int): boolean {',
            '    mut at = start',
            '',
            '    while (at < end) {',
            '        immut name = element(bytes, at, end)',
            '',
            '        if (not name.good or name.tag & 0x80 == 0) { return false }',
            '',
            '        at = name.end',
            '    }',
            '',
            '    return true',
            '}',
            '',
            '// Whether the run of bytes is a run of GeneralSubtrees: SEQUENCE { base, minimum [0] 0, no maximum }.',
            'function subtreesGood(bytes: Address, start: int, end: int): boolean {',
            '    mut at = start',
            '',
            '    if (start == end) { return false }',
            '',
            '    while (at < end) {',
            '        immut subtree = expect(bytes, at, end, 0x30)',
            '',
            '        if (not subtree.good) { return false }',
            '',
            '        immut base = element(bytes, subtree.start, subtree.end)',
            '',
            '        // The minimum and maximum are never used (RFC 5280): only the base.',
            '        if (not base.good or base.tag & 0x80 == 0 or base.end != subtree.end) { return false }',
            '',
            '        at = subtree.end',
            '    }',
            '',
            '    return true',
            '}',
            '',
            '// Names',
            '',
            '// The lower case of an ASCII byte.',
            'function lower(c: int): int {',
            '    return if (c >= 0x41 and c <= 0x5A) { c + 32 } else { c }',
            '}',
            '',
            '// Whether two runs of ASCII bytes are the same, the case aside.',
            'function sameName(a: Address, aStart: int, aSize: int, b: Address, bStart: int, bSize: int): boolean {',
            '    if (aSize != bSize) { return false }',
            '',
            '    for i in range(aSize) {',
            '        if (lower(byteAt(a, aStart + i)) != lower(byteAt(b, bStart + i))) { return false }',
            '    }',
            '',
            '    return true',
            '}',
            '',
            '// Whether a DNS name of a certificate (`pattern`, perhaps with a wildcard as its leftmost label)',
            '// is the host name (lower case, no dot at the end): `*.example.com` is `a.example.com`, not',
            '// `example.com` nor `a.b.example.com`; a wildcard needs two labels after it.',
            'function dnsMatches(bytes: Address, start: int, size: int, host: Address, hostSize: int): boolean {',
            '    if (size == 0) { return false }',
            '',
            '    if (size > 2 and byteAt(bytes, start) == 0x2A and byteAt(bytes, start + 1) == 0x2E) {',
            '        immut rest = size - 1',
            '        // The labels after the wildcard: at least two.',
            '        mut dots = 0',
            '',
            '        for i in range(1, size) {',
            '            if (byteAt(bytes, start + i) == 0x2E) { dots += 1 }',
            '        }',
            '',
            '        if (dots < 2) { return false }',
            '',
            '        // The host\'s first label, then the same rest.',
            '        mut first = 0',
            '',
            '        while (first < hostSize and byteAt(host, first) != 0x2E) {',
            '            first += 1',
            '        }',
            '',
            '        if (first == 0 or first == hostSize) { return false }',
            '',
            '        return sameName(bytes, start + 1, rest, host, first, hostSize - first)',
            '    }',
            '',
            '    return sameName(bytes, start, size, host, 0, hostSize)',
            '}',
            '',
            '// Whether the certificate names the host: a DNS name (dNSName [2]) for a name, an IP address',
            '// (iPAddress [7]) for an address (`address` its 4 or 16 bytes, `addressSize` 0 for a name).',
            'function namesHost(c: Certificate, host: Address, hostSize: int, address: Address, addressSize: int): boolean {',
            '    immut bytes = c.bytes',
            '    mut at = c.namesStart',
            '    immut end = c.namesStart + c.namesSize',
            '',
            '    while (at < end) {',
            '        immut name = element(bytes, at, end)',
            '        at = name.end',
            '',
            '        if (addressSize == 0 and name.tag == 0x82 and dnsMatches(bytes, name.start, name.end - name.start, host, hostSize)) { return true }',
            '',
            '        if (addressSize > 0 and name.tag == 0x87 and sameBytes(bytes, name.start, name.end - name.start, address, 0, addressSize)) { return true }',
            '    }',
            '',
            '    return false',
            '}',
            '',
            '// Whether a DNS name is within the DNS name of a constraint: the same name or a name under it',
            '// (`example.com` holds `example.com` and `a.example.com`; `.example.com` only names under it; an',
            '// empty constraint holds every name).',
            'function dnsWithin(bytes: Address, start: int, size: int, cBytes: Address, cStart: int, cSize: int): boolean {',
            '    if (cSize == 0) { return true }',
            '',
            '    if (byteAt(cBytes, cStart) == 0x2E) {',
            '        return size > cSize and sameName(bytes, start + size - cSize, cSize, cBytes, cStart, cSize)',
            '    }',
            '',
            '    if (size == cSize) { return sameName(bytes, start, size, cBytes, cStart, cSize) }',
            '',
            '    return size > cSize and byteAt(bytes, start + size - cSize - 1) == 0x2E and sameName(bytes, start + size - cSize, cSize, cBytes, cStart, cSize)',
            '}',
            '',
            '// Whether an IP address (4 or 16 bytes) is within a constraint (the address and its mask: 8 or 32',
            '// bytes).',
            'function addressWithin(bytes: Address, start: int, size: int, cBytes: Address, cStart: int, cSize: int): boolean {',
            '    if (cSize != 2 * size) { return false }',
            '',
            '    for i in range(size) {',
            '        immut mask = byteAt(cBytes, cStart + size + i)',
            '',
            '        if (byteAt(bytes, start + i) & mask != byteAt(cBytes, cStart + i) & mask) { return false }',
            '    }',
            '',
            '    return true',
            '}',
            '',
            '// Whether a Name (a SEQUENCE of RDNs) starts with the RDNs of a constraint\'s Name.',
            'function subjectWithin(bytes: Address, start: int, size: int, cBytes: Address, cStart: int, cSize: int): boolean {',
            '    immut name = expect(bytes, start, start + size, 0x30)',
            '    immut constraint = expect(cBytes, cStart, cStart + cSize, 0x30)',
            '',
            '    if (not name.good or not constraint.good) { return false }',
            '',
            '    mut at = name.start',
            '    mut cAt = constraint.start',
            '',
            '    while (cAt < constraint.end) {',
            '        immut rdn = element(bytes, at, name.end)',
            '        immut cRdn = element(cBytes, cAt, constraint.end)',
            '',
            '        if (not rdn.good or not cRdn.good) { return false }',
            '',
            '        if (not sameBytes(bytes, at, rdn.end - at, cBytes, cAt, cRdn.end - cAt)) { return false }',
            '',
            '        at = rdn.end',
            '        cAt = cRdn.end',
            '    }',
            '',
            '    return true',
            '}',
            '',
            '// One name of a certificate (`kind` 2 DNS, 7 IP address, 4 a subject) against the subtrees of a',
            '// constraint of its kind: within one of them (`any` true) or within none. `unconstrained` when the',
            '// subtrees have none of its kind.',
            'type Within = {',
            '    any: boolean',
            '    unconstrained: boolean',
            '}',
            '',
            'function withinSubtrees(kind: int, bytes: Address, start: int, size: int, cBytes: Address, cStart: int, cSize: int): Within {',
            '    mut result: Within = { any: false, unconstrained: true }',
            '    mut at = cStart',
            '    immut end = cStart + cSize',
            '',
            '    while (at < end) {',
            '        immut subtree = element(cBytes, at, end)',
            '        at = subtree.end',
            '        immut base = element(cBytes, subtree.start, subtree.end)',
            '',
            '        if (base.tag & 0x1F == kind) {',
            '            result.unconstrained = false',
            '            immut inside = match (kind) {',
            '                2 => dnsWithin(bytes, start, size, cBytes, base.start, base.end - base.start)',
            '                7 => addressWithin(bytes, start, size, cBytes, base.start, base.end - base.start)',
            '                _ => subjectWithin(bytes, start, size, cBytes, base.start, base.end - base.start)',
            '            }',
            '',
            '            if (inside) { result.any = true }',
            '        }',
            '    }',
            '',
            '    return result',
            '}',
            '',
            '// Whether one name obeys the constraints of an authority: within a permitted subtree of its kind',
            '// (when there are some) and within no excluded one.',
            'function nameAllowed(kind: int, bytes: Address, start: int, size: int, authority: Certificate): boolean {',
            '    if (authority.permittedSize > 0) {',
            '        immut permitted = withinSubtrees(kind, bytes, start, size, authority.bytes, authority.permittedStart, authority.permittedSize)',
            '',
            '        if (not permitted.unconstrained and not permitted.any) { return false }',
            '    }',
            '',
            '    if (authority.excludedSize > 0) {',
            '        immut excluded = withinSubtrees(kind, bytes, start, size, authority.bytes, authority.excludedStart, authority.excludedSize)',
            '',
            '        if (excluded.any) { return false }',
            '    }',
            '',
            '    return true',
            '}',
            '',
            '// Whether the names of a certificate (its DNS names, its IP addresses and its subject, when it is',
            '// not empty) obey the constraints of an authority above it.',
            'function namesAllowed(c: Certificate, authority: Certificate): boolean {',
            '    if (authority.permittedSize == 0 and authority.excludedSize == 0) { return true }',
            '',
            '    immut bytes = c.bytes',
            '    mut at = c.namesStart',
            '    immut end = c.namesStart + c.namesSize',
            '',
            '    while (at < end) {',
            '        immut name = element(bytes, at, end)',
            '        at = name.end',
            '',
            '        if (name.tag == 0x82 and not nameAllowed(2, bytes, name.start, name.end - name.start, authority)) { return false }',
            '',
            '        if (name.tag == 0x87 and not nameAllowed(7, bytes, name.start, name.end - name.start, authority)) { return false }',
            '',
            '        if (name.tag == 0xA4 and not nameAllowed(4, bytes, name.start, name.end - name.start, authority)) { return false }',
            '    }',
            '',
            '    // The subject, unless empty (a SEQUENCE of nothing: 2 bytes).',
            '    return c.subjectSize <= 2 or nameAllowed(4, bytes, c.subjectStart, c.subjectSize, authority)',
            '}',
            '',
            '// The host, as a name to match: lower case with no dot at the end, or an IP address (IPv4 in dots,',
            '// IPv6 in brackets or not).',
            'type Host = {',
            '    good: boolean',
            '    name: Address',
            '    size: int',
            '    address: Address',
            '    addressSize: int',
            '}',
            '',
            'function hostOf(host: string): Host {',
            '    immut text = stringBytes(host)',
            '    mut size = stringSize(host)',
            '',
            '    if (size > 0 and byteAt(text, size - 1) == 0x2E) { size -= 1 }',
            '',
            '    immut name = allocate(size + 1)',
            '',
            '    for i in range(size) {',
            '        write(name, i, byte(lower(byteAt(text, i))))',
            '    }',
            '',
            '    immut address = allocate(16)',
            '    mut addressSize = 0',
            '',
            '    if (ipv4(name, 0, size, address)) { addressSize = 4 }',
            '',
            '    if (addressSize == 0) {',
            '        immut bracketed = size > 2 and byteAt(name, 0) == 0x5B and byteAt(name, size - 1) == 0x5D',
            '        immut first = if (bracketed) { 1 } else { 0 }',
            '        immut to = if (bracketed) { size - 1 } else { size }',
            '',
            '        if (ipv6(name, first, to, address)) { addressSize = 16 }',
            '    }',
            '',
            '    return { good: size > 0, name: name, size: size, address: address, addressSize: addressSize }',
            '}',
            '',
            'function freeHost(host: Host) {',
            '    free(host.name)',
            '    free(host.address)',
            '}',
            '',
            'function isDigit(c: int): boolean {',
            '    return c >= 0x30 and c <= 0x39',
            '}',
            '',
            'function hexDigit(c: int): int {',
            '    if (isDigit(c)) { return c - 0x30 }',
            '',
            '    if (c >= 0x61 and c <= 0x66) { return c - 87 }',
            '',
            '    return -1',
            '}',
            '',
            '// The 4 bytes of an IPv4 address in dots (four decimal numbers below 256, no leading zeros), at',
            '// `out`.',
            'function ipv4(text: Address, start: int, end: int, out: Address): boolean {',
            '    mut at = start',
            '',
            '    for part in range(4) {',
            '        if (part > 0) {',
            '            if (at >= end or byteAt(text, at) != 0x2E) { return false }',
            '',
            '            at += 1',
            '        }',
            '',
            '        mut value = 0',
            '        mut digits = 0',
            '',
            '        while (at < end and isDigit(byteAt(text, at))) {',
            '            value = value * 10 + byteAt(text, at) - 0x30',
            '            digits += 1',
            '            at += 1',
            '',
            '            if (digits > 3) { return false }',
            '        }',
            '',
            '        if (digits == 0 or value > 255 or (digits > 1 and byteAt(text, at - digits) == 0x30)) { return false }',
            '',
            '        write(out, part, byte(value))',
            '    }',
            '',
            '    return at == end',
            '}',
            '',
            '// The 16 bytes of an IPv6 address (groups of hexadecimal digits, `::` once for zeros, an IPv4',
            '// address at the end), at `out`.',
            'function ipv6(text: Address, start: int, end: int, out: Address): boolean {',
            '    for i in range(16) {',
            '        write(out, i, byte(0))',
            '    }',
            '',
            '    mut at = start',
            '    mut index = 0',
            '    mut gap = -1',
            '',
            '    if (end - start >= 2 and byteAt(text, start) == 0x3A and byteAt(text, start + 1) == 0x3A) {',
            '        gap = 0',
            '        at += 2',
            '    }',
            '',
            '    while (at < end) {',
            '        if (index == 16) { return false }',
            '',
            '        // An IPv4 address in the last 4 bytes.',
            '        immut dotted = index <= 12 and ipv4(text, at, end, offset(out, index))',
            '',
            '        if (dotted) {',
            '            index += 4',
            '            at = end',
            '            break',
            '        }',
            '',
            '        mut value = 0',
            '        mut digits = 0',
            '',
            '        while (at < end and hexDigit(byteAt(text, at)) >= 0) {',
            '            value = value * 16 + hexDigit(byteAt(text, at))',
            '            digits += 1',
            '            at += 1',
            '',
            '            if (digits > 4) { return false }',
            '        }',
            '',
            '        if (digits == 0) { return false }',
            '',
            '        write(out, index, byte(value >> 8))',
            '        write(out, index + 1, byte(value & 0xFF))',
            '        index += 2',
            '',
            '        if (at < end) {',
            '            if (byteAt(text, at) != 0x3A) { return false }',
            '',
            '            at += 1',
            '',
            '            if (at < end and byteAt(text, at) == 0x3A) {',
            '                if (gap >= 0) { return false }',
            '',
            '                gap = index',
            '                at += 1',
            '            } else {',
            '                if (at == end) { return false }',
            '            }',
            '        }',
            '    }',
            '',
            '    if (gap < 0) { return index == 16 }',
            '',
            '    if (index == 16) { return false }',
            '',
            '    // The groups after the gap moved to the end.',
            '    immut moved = index - gap',
            '',
            '    for i in range(moved) {',
            '        immut b: byte = read(out, index - 1 - i)',
            '        write(out, 15 - i, b)',
            '    }',
            '',
            '    for i in range(gap, 16 - moved) {',
            '        write(out, i, byte(0))',
            '    }',
            '',
            '    return true',
            '}',
            '',
            '// Authorities',
            '',
            '// An authority: its subject and its key, in `bytes`.',
            'export type Authority = {',
            '    bytes: Address',
            '    subjectStart: int',
            '    subjectSize: int',
            '    key: PublicKey',
            '}',
            '',
            '// The value of a base64 digit, or -1.',
            'function base64Value(c: int): int {',
            '    if (c >= 0x41 and c <= 0x5A) { return c - 0x41 }',
            '',
            '    if (c >= 0x61 and c <= 0x7A) { return c - 71 }',
            '',
            '    if (isDigit(c)) { return c + 4 }',
            '',
            '    if (c == 0x2B) { return 62 }',
            '',
            '    if (c == 0x2F) { return 63 }',
            '',
            '    return -1',
            '}',
            '',
            '// The bytes of the base64 between `start` and `end` (white space skipped, `=` ends it), at `out`:',
            '// how many.',
            'function unbase64(text: Address, start: int, end: int, out: Address): int {',
            '    mut bits = 0',
            '    mut count = 0',
            '    mut size = 0',
            '',
            '    for i in range(start, end) {',
            '        immut c = byteAt(text, i)',
            '',
            '        if (c == 0x3D) { break }',
            '',
            '        immut value = base64Value(c)',
            '',
            '        if (value >= 0) {',
            '            bits = ((bits << 6) | value) & 0xFFFFFF',
            '            count += 6',
            '',
            '            if (count >= 8) {',
            '                count -= 8',
            '                write(out, size, byte((bits >> count) & 0xFF))',
            '                size += 1',
            '            }',
            '        }',
            '    }',
            '',
            '    return size',
            '}',
            '',
            '// The authority of a certificate, when it can be read and its key is supported.',
            'function addCertificate(mut authorities: Authority[], bytes: Address, size: int) {',
            '    immut c = certificateOf(bytes, size)',
            '',
            '    if (c.problem == trusted and c.key.kind >= 0) {',
            '        authorities.push({ bytes: bytes, subjectStart: c.subjectStart, subjectSize: c.subjectSize, key: c.key })',
            '    } else {',
            '        free(bytes)',
            '    }',
            '}',
            '',
            '// The certificates of PEM text (`size` bytes at `text`), as authorities.',
            'function addPem(mut authorities: Authority[], text: Address, size: int) {',
            '    immut begin = \'-----BEGIN CERTIFICATE-----\'',
            '    immut end = \'-----END CERTIFICATE-----\'',
            '    mut at = 0',
            '',
            '    while (true) {',
            '        immut start = find(text, at, size, begin)',
            '',
            '        if (start < 0) { break }',
            '',
            '        immut stop = find(text, start, size, end)',
            '',
            '        if (stop < 0) { break }',
            '',
            '        immut body = start + begin.length()',
            '        immut der = allocate((stop - body) * 3 / 4 + 3)',
            '        immut length = unbase64(text, body, stop, der)',
            '        addCertificate(mut authorities, der, length)',
            '        at = stop + end.length()',
            '    }',
            '}',
            '',
            '// The authorities of PEM text (each with its own bytes, to free).',
            'export function authoritiesOfPem(text: Address, size: int): Authority[] {',
            '    mut authorities: Authority[] = []',
            '    addPem(mut authorities, text, size)',
            '    return authorities',
            '}',
            '',
            '// Where `part` is in the bytes from `at` to `size`, or -1.',
            'function find(text: Address, at: int, size: int, part: string): int {',
            '    immut length = stringSize(part)',
            '    immut bytes = stringBytes(part)',
            '    mut i = at',
            '',
            '    while (i + length <= size) {',
            '        if (memcmp(offset(text, i), bytes, length) == 0) { return i }',
            '',
            '        i += 1',
            '    }',
            '',
            '    return -1',
            '}',
            '',
            '// A C string of a text (to free).',
            'function cString(text: string): Address {',
            '    immut size = stringSize(text)',
            '    immut out = allocate(size + 1)',
            '    memcpy(out, stringBytes(text), size)',
            '    write(out, size, byte(0))',
            '    return out',
            '}',
            '',
            '// The text of a C string.',
            'function textOfC(text: Address): string {',
            '    return newString(text, strlen(text))',
            '}',
            '',
            '// The contents of the file at `path` (a C string): where (to free) and how many bytes, or a null',
            '// address when it cannot be read.',
            'type Contents = {',
            '    bytes: Address',
            '    size: int',
            '}',
            '',
            'function readFile(path: Address): Contents {',
            '    immut mode = cString(\'rb\')',
            '    immut file = fopen(path, mode)',
            '    free(mode)',
            '',
            '    if (isNull(file)) { return { bytes: nullAddress(), size: 0 } }',
            '',
            '    mut capacity = 65536',
            '    mut bytes = allocate(capacity)',
            '    mut size = 0',
            '',
            '    while (true) {',
            '        if (size == capacity) {',
            '            capacity *= 2',
            '            bytes = realloc(bytes, capacity)',
            '        }',
            '',
            '        immut got = fread(offset(bytes, size), 1, capacity - size, file)',
            '',
            '        if (got == 0) { break }',
            '',
            '        size += got',
            '    }',
            '',
            '    fclose(file)',
            '    return { bytes: bytes, size: size }',
            '}',
            '',
            '// The certificates of the PEM file at `path`: whether it could be read.',
            'function addFile(mut authorities: Authority[], path: string): boolean {',
            '    immut cPath = cString(path)',
            '    immut contents = readFile(cPath)',
            '    free(cPath)',
            '',
            '    if (isNull(contents.bytes)) { return false }',
            '',
            '    addPem(mut authorities, contents.bytes, contents.size)',
            '    free(contents.bytes)',
            '    return true',
            '}',
            '',
            '// The certificates of the files of a directory.',
            'function addDirectory(mut authorities: Authority[], path: string) {',
            '    immut cPath = cString(path)',
            '    immut directory = opendir(cPath)',
            '    free(cPath)',
            '',
            '    if (isNull(directory)) { return }',
            '',
            '    mut names: string[] = []',
            '',
            '    while (true) {',
            '        immut entry = readdir(directory)',
            '',
            '        if (isNull(entry)) { break }',
            '',
            '        immut name = textOfC(koji_directory_entry_name(entry))',
            '',
            '        if (not name.startsWith(\'.\')) { names.push(name) }',
            '    }',
            '',
            '    closedir(directory)',
            '',
            '    for name in names {',
            '        addFile(mut authorities, path + \'/\' + name)',
            '    }',
            '}',
            '',
            '// The value of an environment variable, \'\' when it is not set.',
            'function environment(name: string): string {',
            '    immut cName = cString(name)',
            '    immut value = getenv(cName)',
            '    free(cName)',
            '    return if (isNull(value)) { \'\' } else { textOfC(value) }',
            '}',
            '',
            '// The authorities of the system: `SSL_CERT_FILE`, or the first of the usual files that can be read;',
            '// then the directories of `SSL_CERT_DIR` (separated by `:`), or, when no file could be read, the',
            '// usual directories. As Go reads them (which also reads the usual directories after a file).',
            'function systemAuthorities(): Authority[] {',
            '    mut authorities: Authority[] = []',
            '    immut file = environment(\'SSL_CERT_FILE\')',
            '    immut files = if (file != \'\') { [file] } else {',
            '        [',
            '            // Debian, Ubuntu, Gentoo, Arch',
            '            \'/etc/ssl/certs/ca-certificates.crt\',',
            '            // Fedora, RHEL 6',
            '            \'/etc/pki/tls/certs/ca-bundle.crt\',',
            '            // OpenSUSE',
            '            \'/etc/ssl/ca-bundle.pem\',',
            '            // OpenELEC',
            '            \'/etc/pki/tls/cacert.pem\',',
            '            // CentOS, RHEL 7',
            '            \'/etc/pki/ca-trust/extracted/pem/tls-ca-bundle.pem\',',
            '            // Alpine, macOS, OpenBSD',
            '            \'/etc/ssl/cert.pem\',',
            '            // FreeBSD',
            '            \'/usr/local/etc/ssl/cert.pem\',',
            '            \'/usr/local/share/certs/ca-root-nss.crt\',',
            '            // NetBSD',
            '            \'/etc/openssl/certs/ca-certificates.crt\'',
            '        ]',
            '    }',
            '    mut found = false',
            '',
            '    for each in files {',
            '        if (not found and addFile(mut authorities, each)) { found = true }',
            '    }',
            '',
            '    immut directories = environment(\'SSL_CERT_DIR\')',
            '',
            '    if (directories != \'\') {',
            '        for each in directories.split(\':\') {',
            '            if (each != \'\') { addDirectory(mut authorities, each) }',
            '        }',
            '    } else {',
            '        if (not found) {',
            '            for each in [\'/etc/ssl/certs\', \'/etc/pki/tls/certs\', \'/system/etc/security/cacerts\'] {',
            '                addDirectory(mut authorities, each)',
            '            }',
            '        }',
            '    }',
            '',
            '    return authorities',
            '}',
            '',
            '// The authorities built into the library (koji:roots).',
            'function builtInAuthorities(): Authority[] {',
            '    mut authorities: Authority[] = []',
            '    immut text = stringBytes(roots)',
            '    immut size = stringSize(roots)',
            '    immut bytes = allocate(size * 3 / 4 + 3)',
            '    unbase64(text, 0, size, bytes)',
            '    mut at = 0',
            '',
            '    for i in range(rootCount) {',
            '        immut subjectSize = byteAt(bytes, at) * 256 + byteAt(bytes, at + 1)',
            '        immut subjectStart = at + 2',
            '        immut keyStart = subjectStart + subjectSize',
            '        immut keySize = byteAt(bytes, keyStart) * 256 + byteAt(bytes, keyStart + 1)',
            '        immut keyInfo = element(bytes, keyStart + 2, keyStart + 2 + keySize)',
            '        immut key = keyOf(bytes, keyInfo)',
            '',
            '        if (key.kind >= 0) { authorities.push({ bytes: bytes, subjectStart: subjectStart, subjectSize: subjectSize, key: key }) }',
            '',
            '        at = keyStart + 2 + keySize',
            '    }',
            '',
            '    return authorities',
            '}',
            '',
            '// The authorities, read the first time they are needed (an empty list before), and whether they',
            '// were read.',
            'mut cache: Authority[] = []',
            'mut cacheRead = false',
            '',
            'export function trustedAuthorities(): Authority[] {',
            '    if (not cacheRead) {',
            '        cache = systemAuthorities()',
            '',
            '        if (cache.length() == 0) { cache = builtInAuthorities() }',
            '',
            '        cacheRead = true',
            '    }',
            '',
            '    return cache',
            '}',
            '',
            '// Verification',
            '',
            '// The work of a verification, bounded (a server could send many certificates of the same name).',
            'type Search = {',
            '    chain: Certificate[]',
            '    authorities: Authority[]',
            '    now: int',
            '    // The indexes of the certificates of the path so far (the leaf first).',
            '    path: int[]',
            '    budget: int',
            '    problem: int',
            '}',
            '',
            '// The certificates below which a path can have at most 8 more (as Go limits the intermediates).',
            'immut deepest = 9',
            '',
            '// Whether the certificates of the path obey the name constraints of `authority` (the last of the',
            '// path issued by it).',
            'function pathAllowed(search: Search, authority: Certificate): boolean {',
            '    for index in search.path {',
            '        if (not namesAllowed(search.chain[index], authority)) { return false }',
            '    }',
            '',
            '    return true',
            '}',
            '',
            '// Whether `issuer` signed `c` (a signature costs some budget).',
            'function signedBy(mut search: Search, c: Certificate, key: PublicKey): boolean {',
            '    search.budget -= 1',
            '    return verifySignature(key, c.algorithm, offset(c.bytes, c.tbsStart), c.tbsSize, offset(c.bytes, c.signatureStart), c.signatureSize)',
            '}',
            '',
            'function contains(list: int[], value: int): boolean {',
            '    for each in list {',
            '        if (each == value) { return true }',
            '    }',
            '',
            '    return false',
            '}',
            '',
            '// The worse of two problems (the one that tells more about why no path was found).',
            'function worse(a: int, b: int): int {',
            '    // The rank of each problem: an issuer not found tells the least.',
            '    immut order = [0, 6, 4, 1, 2, 3, 5, 7]',
            '    return if (order[b] > order[a]) { b } else { a }',
            '}',
            '',
            '// Extends the path from its last certificate: to an authority, or through an intermediate of the',
            '// chain; whether a path was found (else `search.problem` tells why not).',
            'function extend(mut search: Search): boolean {',
            '    immut last = search.chain[search.path[search.path.length() - 1]]',
            '',
            '    if (last.algorithm.kind < 0) {',
            '        search.problem = worse(search.problem, unsupported)',
            '        return false',
            '    }',
            '',
            '    for authority in search.authorities {',
            '        if (search.budget <= 0) { return false }',
            '',
            '        if (sameBytes(authority.bytes, authority.subjectStart, authority.subjectSize, last.bytes, last.issuerStart, last.issuerSize)) {',
            '            if (signedBy(mut search, last, authority.key)) { return true }',
            '',
            '            search.problem = worse(search.problem, badSignature)',
            '        }',
            '    }',
            '',
            '    search.problem = worse(search.problem, unknownIssuer)',
            '',
            '    if (search.path.length() >= deepest) { return false }',
            '',
            '    for i in range(1, search.chain.length()) {',
            '        if (search.budget <= 0) { return false }',
            '',
            '        immut c = search.chain[i]',
            '',
            '        if (not contains(search.path, i) and c.problem == trusted and sameBytes(c.bytes, c.subjectStart, c.subjectSize, last.bytes, last.issuerStart, last.issuerSize)) {',
            '            // Below it: the intermediates of the path so far.',
            '            immut below = search.path.length() - 1',
            '            mut problem = trusted',
            '',
            '            if (search.now < c.notBefore or search.now > c.notAfter) { problem = expired }',
            '',
            '            if (not c.authority or (c.keyUsage >= 0 and c.keyUsage & (1 << 5) == 0) or c.serverAuth == 2) { problem = notAuthorized }',
            '',
            '            if (c.pathLength >= 0 and below > c.pathLength) { problem = notAuthorized }',
            '',
            '            if (c.key.kind < 0) { problem = unsupported }',
            '',
            '            if (problem == trusted and not pathAllowed(search, c)) { problem = notAuthorized }',
            '',
            '            if (problem == trusted and not signedBy(mut search, last, c.key)) { problem = badSignature }',
            '',
            '            if (problem == trusted) {',
            '                search.path.push(i)',
            '',
            '                if (extend(mut search)) { return true }',
            '',
            '                search.path.pop()',
            '            } else {',
            '                search.problem = worse(search.problem, problem)',
            '            }',
            '        }',
            '    }',
            '',
            '    return false',
            '}',
            '',
            '// Verifies a chain (the certificates of a server, its own first) for `host` at `now` (seconds since',
            '// 1970) with `authorities`: `trusted` (0) or why not.',
            'export function verifyChain(chain: Certificate[], authorities: Authority[], host: string, now: int): int {',
            '    if (chain.length() == 0) { return malformed }',
            '',
            '    immut leaf = chain[0]',
            '',
            '    if (leaf.problem != trusted) { return leaf.problem }',
            '',
            '    if (now < leaf.notBefore or now > leaf.notAfter) { return expired }',
            '',
            '    // The key of a server signs the handshake (digitalSignature), for the servers (serverAuth).',
            '    if ((leaf.keyUsage >= 0 and leaf.keyUsage & 1 == 0) or leaf.serverAuth == 2) { return notAuthorized }',
            '',
            '    if (leaf.key.kind < 0) { return unsupported }',
            '',
            '    immut name = hostOf(host)',
            '    immut named = name.good and namesHost(leaf, name.name, name.size, name.address, name.addressSize)',
            '    freeHost(name)',
            '',
            '    if (not named) { return wrongName }',
            '',
            '    mut search: Search = { chain: chain, authorities: authorities, now: now, path: [0], budget: 100, problem: trusted }',
            '',
            '    if (extend(mut search)) { return trusted }',
            '',
            '    return if (search.problem == trusted) { unknownIssuer } else { search.problem }',
            '}',
            '',
            '// The seconds since 1970, now.',
            'export function now(): int {',
            '    return time(nullAddress())',
            '}',
            '',
            '// The certificates of the DER at `bytes` one after the other (`size` bytes), each copied.',
            'function chainOf(bytes: Address, size: int): Certificate[] {',
            '    mut chain: Certificate[] = []',
            '    mut at = 0',
            '',
            '    while (at < size) {',
            '        immut e = element(bytes, at, size)',
            '',
            '        if (not e.good) {',
            '            chain.push(badCertificate(malformed, nullAddress(), 0))',
            '            break',
            '        }',
            '',
            '        immut copy = allocate(e.end - at)',
            '        memcpy(copy, offset(bytes, at), e.end - at)',
            '        chain.push(certificateOf(copy, e.end - at))',
            '        at = e.end',
            '    }',
            '',
            '    return chain',
            '}',
            '',
            'function freeChain(chain: Certificate[]) {',
            '    for c in chain {',
            '        if (not isNull(c.bytes)) { free(c.bytes) }',
            '    }',
            '}',
            '',
            '// For C (the tests of the library): the chain (DER certificates one after the other) verified for',
            '// `host` at `now` with the authorities of the PEM text `pem` (`pemSize` bytes; the system\'s and',
            '// then the built-in ones when `pemSize` is -1, the built-in ones when it is -2).',
            'extern function koji_x509_verify(chain: Address, size: CSize, pem: Address, pemSize: int, host: Address, now: int): int {',
            '    immut certificates = chainOf(chain, size)',
            '    mut given: Authority[] = []',
            '',
            '    if (pemSize >= 0) { addPem(mut given, pem, pemSize) }',
            '',
            '    immut chosen = if (pemSize == -1) { trustedAuthorities() } else {',
            '        if (pemSize == -2) { builtInAuthorities() } else { given }',
            '    }',
            '    immut result = verifyChain(certificates, chosen, textOfC(host), now)',
            '    freeChain(certificates)',
            '',
            '    if (pemSize >= 0) {',
            '        for each in given {',
            '            free(each.bytes)',
            '        }',
            '    }',
            '',
            '    return result',
            '}',
            '',
            '// For C: how many authorities the system has (and the built-in list, when -1 is asked for).',
            'extern function koji_x509_authority_count(builtIn: CInt): int {',
            '    if (builtIn == 1) { return builtInAuthorities().length() }',
            '',
            '    return trustedAuthorities().length()',
            '}',
        ].join('\n'))
    }

    return None
}
