// The modules of the standard library written in Koji (std/), which the compiler carries: `import
// json` compiles std/json.kj. Generated: test/stages.rs checks that it is up to date, and rewrites
// it when run with KOJI_UPDATE_STDLIB=1.

export immut kojiModules = ['datetime', 'json', 'path', 'regex', 'time']

// The source of the module `name` of the standard library.
export function stdSource(name: string): Option[string] {
    if (name == 'datetime') {
        return Some([
            '// The `datetime` module: dates and times in UTC, and their text (see',
            '// doc/standard-library/datetime.md). A timestamp is a number of seconds since 0000-01-01 00:00:00',
            '// UTC, the epoch of Koji, in the proleptic Gregorian calendar (see `time`).',
            '',
            'import time',
            'import math',
            '',
            '// The days from 0000-01-01 to 1970-01-01, where the computations of the calendar count from.',
            'immut unixDays = 719528',
            '',
            'export type DateTime = {',
            '    year: int',
            '    month: int',
            '    day: int',
            '    hour: int',
            '    minute: int',
            '    second: int',
            '}',
            '',
            '// `2025-04-20 14:30:00`.',
            'function DateTime.display(self): string {',
            '    return `${padded(self.year, 4)}-${padded(self.month, 2)}-${padded(self.day, 2)} ${padded(self.hour, 2)}:${padded(self.minute, 2)}:${padded(self.second, 2)}`',
            '}',
            '',
            'export type DateError = {',
            '    // The text does not follow the pattern.',
            '    PatternMismatch(text: string, pattern: string)',
            '    // A date that does not exist: `2025-02-30`.',
            '    InvalidDate(text: string)',
            '}',
            '',
            'function DateError.display(self): string {',
            '    return match (self) {',
            '        PatternMismatch(text, pattern) => `\'${text}\' does not match the pattern \'${pattern}\'`',
            '        InvalidDate(text) => `\'${text}\' is not a valid date`',
            '    }',
            '}',
            '',
            '// The current date and time.',
            'export function now(): DateTime {',
            '    return dateOf(math.floor(time.now()))',
            '}',
            '',
            '// The current date: `2025-04-20`.',
            'export function today(): string {',
            '    immut date = now()',
            '    return `${padded(date.year, 4)}-${padded(date.month, 2)}-${padded(date.day, 2)}`',
            '}',
            '',
            '// The date of `timestamp` as `pattern` writes it: `yyyy`, `mm`, `dd`, `hh`, `min` and `ss` (in any',
            '// case) are its parts, any other character stands for itself.',
            'export function format(timestamp: decimal, pattern: string): string {',
            '    immut date = dateOf(math.floor(timestamp))',
            '    mut out = \'\'',
            '',
            '    for token in tokens(pattern) {',
            '        out += match (token) {',
            '            Year => padded(date.year, 4)',
            '            Month => padded(date.month, 2)',
            '            Day => padded(date.day, 2)',
            '            Hour => padded(date.hour, 2)',
            '            Minute => padded(date.minute, 2)',
            '            Second => padded(date.second, 2)',
            '            Text(c) => string(c)',
            '        }',
            '    }',
            '',
            '    return out',
            '}',
            '',
            '// The timestamp of the date that `text` writes as `pattern` does (the parts it leaves out are',
            '// those of 1970-01-01 00:00:00).',
            'export function parse(text: string, pattern: string): Result[int, DateError] {',
            '    immut chars = text.chars()',
            '    mut position = 0',
            '    mut date: DateTime = { year: 1970, month: 1, day: 1, hour: 0, minute: 0, second: 0 }',
            '',
            '    for token in tokens(pattern) {',
            '        match (token) {',
            '            Text(c) => {',
            '                if (position >= chars.length() or chars[position] != c) { return Err(PatternMismatch(text, pattern)) }',
            '',
            '                position += 1',
            '                continue',
            '            }',
            '            _ => {}',
            '        }',
            '',
            '        immut width = if (token == Year) { 4 } else { 2 }',
            '        mut value = 0',
            '',
            '        for i in range(width) {',
            '            if (position >= chars.length() or chars[position] < \'0\' or chars[position] > \'9\') { return Err(PatternMismatch(text, pattern)) }',
            '',
            '            value = value * 10 + (chars[position].code() - 48)',
            '            position += 1',
            '        }',
            '',
            '        match (token) {',
            '            Year => date.year = value',
            '            Month => date.month = value',
            '            Day => date.day = value',
            '            Hour => date.hour = value',
            '            Minute => date.minute = value',
            '            _ => date.second = value',
            '        }',
            '    }',
            '',
            '    if (position != chars.length()) { return Err(PatternMismatch(text, pattern)) }',
            '',
            '    immut valid = date.month >= 1 and date.month <= 12 and date.day >= 1 and date.day <= daysInMonth(date.year, date.month) and date.hour < 24 and date.minute < 60 and date.second < 60',
            '',
            '    if (not valid) { return Err(InvalidDate(text)) }',
            '',
            '    return Ok((daysFromCivil(date.year, date.month, date.day) + unixDays) * 86400 + date.hour * 3600 + date.minute * 60 + date.second)',
            '}',
            '',
            '// The parts of a pattern.',
            'type Token = {',
            '    Year',
            '    Month',
            '    Day',
            '    Hour',
            '    Minute',
            '    Second',
            '    Text(c: char)',
            '}',
            '',
            'function tokens(pattern: string): Token[] {',
            '    immut chars = pattern.chars()',
            '    immut lower = pattern.lower().chars()',
            '    mut found: Token[] = []',
            '    mut i = 0',
            '',
            '    while (i < chars.length()) {',
            '        if (startsWith(lower, i, \'yyyy\')) {',
            '            found.push(Year)',
            '            i += 4',
            '            continue',
            '        }',
            '',
            '        if (startsWith(lower, i, \'min\')) {',
            '            found.push(Minute)',
            '            i += 3',
            '            continue',
            '        }',
            '',
            '        immut two = match (if (i + 1 < lower.length()) { `${lower[i]}${lower[i + 1]}` } else { \'\' }) {',
            '            \'mm\' => Some(Month)',
            '            \'dd\' => Some(Day)',
            '            \'hh\' => Some(Hour)',
            '            \'ss\' => Some(Second)',
            '            _ => None',
            '        }',
            '',
            '        match (two) {',
            '            Some(token) => {',
            '                found.push(token)',
            '                i += 2',
            '            }',
            '            None => {',
            '                found.push(Text(chars[i]))',
            '                i += 1',
            '            }',
            '        }',
            '    }',
            '',
            '    return found',
            '}',
            '',
            'function startsWith(chars: char[], start: int, word: string): boolean {',
            '    mut i = start',
            '',
            '    for c in word {',
            '        if (i >= chars.length() or chars[i] != c) { return false }',
            '',
            '        i += 1',
            '    }',
            '',
            '    return true',
            '}',
            '',
            '// The date and time of `timestamp`.',
            'function dateOf(timestamp: int): DateTime {',
            '    immut days = floorDiv(timestamp, 86400) - unixDays',
            '    immut seconds = timestamp - (days + unixDays) * 86400',
            '    immut civil = civilFromDays(days)',
            '    return { year: civil[0], month: civil[1], day: civil[2], hour: seconds / 3600, minute: seconds % 3600 / 60, second: seconds % 60 }',
            '}',
            '',
            '// The year, month and day of a number of days since 1970-01-01 (Howard Hinnant\'s algorithm).',
            'function civilFromDays(days: int): int[] {',
            '    immut z = days + 719468',
            '    immut era = floorDiv(z, 146097)',
            '    immut doe = z - era * 146097',
            '    immut yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365',
            '    immut y = yoe + era * 400',
            '    immut doy = doe - (365 * yoe + yoe / 4 - yoe / 100)',
            '    immut mp = (5 * doy + 2) / 153',
            '    immut d = doy - (153 * mp + 2) / 5 + 1',
            '    immut m = if (mp < 10) { mp + 3 } else { mp - 9 }',
            '    return [if (m <= 2) { y + 1 } else { y }, m, d]',
            '}',
            '',
            'function daysFromCivil(year: int, month: int, day: int): int {',
            '    immut y = if (month <= 2) { year - 1 } else { year }',
            '    immut era = floorDiv(y, 400)',
            '    immut yoe = y - era * 400',
            '    immut mp = (month + 9) % 12',
            '    immut doy = (153 * mp + 2) / 5 + day - 1',
            '    immut doe = yoe * 365 + yoe / 4 - yoe / 100 + doy',
            '    return era * 146097 + doe - 719468',
            '}',
            '',
            'function daysInMonth(year: int, month: int): int {',
            '    if (month == 2) {',
            '        immut leap = (year % 4 == 0 and year % 100 != 0) or year % 400 == 0',
            '        return if (leap) { 29 } else { 28 }',
            '    }',
            '',
            '    if (month == 4 or month == 6 or month == 9 or month == 11) { return 30 }',
            '',
            '    return 31',
            '}',
            '',
            '// `a / b` rounded down (for a positive `b`).',
            'function floorDiv(a: int, b: int): int {',
            '    immut quotient = a / b',
            '    return if (a % b < 0) { quotient - 1 } else { quotient }',
            '}',
            '',
            '// `n` with zeros before it, `width` characters in all (the sign counts): `-005`.',
            'function padded(n: int, width: int): string {',
            '    if (n < 0) { return `-${padded(-n, width - 1)}` }',
            '',
            '    immut digits = string(n)',
            '    return \'0\' * (width - digits.length()) + digits',
            '}',
        ].join('\n'))
    }

    if (name == 'json') {
        return Some([
            '// The `json` module: JSON text to `Json` values and back (see doc/standard-library/json.md).',
            '',
            '// A JSON value. A number without `.`, `e` or `E` is an `Int`; the others are `Decimal`, exactly as',
            '// written (rounded beyond 34 significant digits).',
            'export type Json = {',
            '    Null',
            '    Bool(value: boolean)',
            '    Int(value: int)',
            '    Decimal(value: decimal)',
            '    String(value: string)',
            '    Array(items: Json[])',
            '    Object(fields: Map[string, Json])',
            '}',
            '',
            '// The fields of an object, in the order they first appear.',
            'export type JsonObject = Map[string, Json]',
            '',
            'export type JsonError = {',
            '    Syntax(message: string, line: int, column: int)',
            '    // An integer too large for an int.',
            '    NumberOutOfRange(text: string, line: int, column: int)',
            '}',
            '',
            'function JsonError.display(self): string {',
            '    return match (self) {',
            '        Syntax(message, line, column) => `invalid JSON at line ${line}, column ${column}: ${message}`',
            '        NumberOutOfRange(text, line, column) => `the number ${text} at line ${line}, column ${column} is too large`',
            '    }',
            '}',
            '',
            '// Why a text is not JSON, and where (a position in its characters).',
            'type Failure = {',
            '    BadSyntax(message: string, position: int)',
            '    BadNumber(text: string, position: int)',
            '}',
            '',
            'type Parser = {',
            '    chars: char[]',
            '    position: int',
            '}',
            '',
            '// The `Json` value that `text` writes.',
            'export function parse(text: string): Result[Json, JsonError] {',
            '    mut parser: Parser = { chars: text.chars(), position: 0 }',
            '',
            '    match (parser.value()) {',
            '        Ok(value) => {',
            '            parser.skipWhitespace()',
            '',
            '            if (parser.position == parser.chars.length()) { return Ok(value) }',
            '',
            '            return Err(located(parser.chars, BadSyntax(\'unexpected character after the JSON value\', parser.position)))',
            '        }',
            '        Err(failure) => return Err(located(parser.chars, failure))',
            '    }',
            '}',
            '',
            '// The error of a failure, with the line and column of its position.',
            'function located(chars: char[], failure: Failure): JsonError {',
            '    immut position = match (failure) {',
            '        BadSyntax(_, at) => at',
            '        BadNumber(_, at) => at',
            '    }',
            '    immut end = if (position < chars.length()) { position } else { chars.length() }',
            '    mut line = 1',
            '    mut column = 1',
            '',
            '    for i in range(end) {',
            '        if (chars[i] == \'\\n\') {',
            '            line += 1',
            '            column = 1',
            '        } else {',
            '            column += 1',
            '        }',
            '    }',
            '',
            '    return match (failure) {',
            '        BadSyntax(message, _) => Syntax(message, line, column)',
            '        BadNumber(text, _) => NumberOutOfRange(text, line, column)',
            '    }',
            '}',
            '',
            'function Parser.syntax(self, message: string): Failure {',
            '    return BadSyntax(message, self.position)',
            '}',
            '',
            '// The character at the position, if there is one.',
            'function Parser.current(self): Option[char] {',
            '    if (self.position < self.chars.length()) { return Some(self.chars[self.position]) }',
            '',
            '    return None',
            '}',
            '',
            'function Parser.at(self, c: char): boolean {',
            '    return self.position < self.chars.length() and self.chars[self.position] == c',
            '}',
            '',
            'function Parser.skipWhitespace(mut self) {',
            '    while (self.position < self.chars.length() and string(self.chars[self.position]).isSpace()) {',
            '        self.position += 1',
            '    }',
            '}',
            '',
            'function Parser.expect(mut self, c: char): Result[void, Failure] {',
            '    self.skipWhitespace()',
            '',
            '    if (not self.at(c)) { return Err(self.syntax(`expected \'${c}\'`)) }',
            '',
            '    self.position += 1',
            '    return Ok()',
            '}',
            '',
            'function Parser.literal(mut self, word: string, value: Json): Result[Json, Failure] {',
            '    for c in word {',
            '        if (not self.at(c)) { return Err(self.syntax(\'invalid literal\')) }',
            '',
            '        self.position += 1',
            '    }',
            '',
            '    return Ok(value)',
            '}',
            '',
            'function Parser.value(mut self): Result[Json, Failure] {',
            '    self.skipWhitespace()',
            '',
            '    immut c = match (self.current()) {',
            '        Some(found) => found',
            '        None => return Err(self.syntax(\'unexpected end of input\'))',
            '    }',
            '',
            '    if (c == \'{\') { return self.object() }',
            '',
            '    if (c == \'[\') { return self.array() }',
            '',
            '    if (c == \'"\') { return Ok(String(self.string()?)) }',
            '',
            '    if (c == \'t\') { return self.literal(\'true\', Bool(true)) }',
            '',
            '    if (c == \'f\') { return self.literal(\'false\', Bool(false)) }',
            '',
            '    if (c == \'n\') { return self.literal(\'null\', Null) }',
            '',
            '    if (c == \'-\' or (c >= \'0\' and c <= \'9\')) { return self.number() }',
            '',
            '    return Err(self.syntax(`unexpected character \'${c}\'`))',
            '}',
            '',
            '// An object; a repeated key keeps its first position and its last value, like a map.',
            'function Parser.object(mut self): Result[Json, Failure] {',
            '    self.position += 1',
            '    mut fields: JsonObject = [:]',
            '    self.skipWhitespace()',
            '',
            '    if (self.at(\'}\')) {',
            '        self.position += 1',
            '        return Ok(Object(fields))',
            '    }',
            '',
            '    while (true) {',
            '        self.skipWhitespace()',
            '        immut key = self.string()?',
            '        self.expect(\':\')?',
            '        fields[key] = self.value()?',
            '        self.skipWhitespace()',
            '',
            '        if (self.at(\',\')) {',
            '            self.position += 1',
            '            continue',
            '        }',
            '',
            '        if (self.at(\'}\')) {',
            '            self.position += 1',
            '            return Ok(Object(fields))',
            '        }',
            '',
            '        return Err(self.syntax("expected \',\' or \'}\'"))',
            '    }',
            '',
            '    return Ok(Object(fields))',
            '}',
            '',
            'function Parser.array(mut self): Result[Json, Failure] {',
            '    self.position += 1',
            '    mut items: Json[] = []',
            '    self.skipWhitespace()',
            '',
            '    if (self.at(\']\')) {',
            '        self.position += 1',
            '        return Ok(Array(items))',
            '    }',
            '',
            '    while (true) {',
            '        items.push(self.value()?)',
            '        self.skipWhitespace()',
            '',
            '        if (self.at(\',\')) {',
            '            self.position += 1',
            '            continue',
            '        }',
            '',
            '        if (self.at(\']\')) {',
            '            self.position += 1',
            '            return Ok(Array(items))',
            '        }',
            '',
            '        return Err(self.syntax("expected \',\' or \']\'"))',
            '    }',
            '',
            '    return Ok(Array(items))',
            '}',
            '',
            'function Parser.number(mut self): Result[Json, Failure] {',
            '    immut start = self.position',
            '    mut text = \'\'',
            '',
            '    while (self.position < self.chars.length() and isNumberChar(self.chars[self.position])) {',
            '        text += string(self.chars[self.position])',
            '        self.position += 1',
            '    }',
            '',
            '    if (not jsonNumber(text)) { return Err(BadSyntax(`invalid number \'${text}\'`, start)) }',
            '',
            '    if (not (\'.\' in text or \'e\' in text or \'E\' in text)) {',
            '        return match (int(text)) {',
            '            Ok(value) => Ok(Int(value))',
            '            Err(_) => Err(BadNumber(text, start))',
            '        }',
            '    }',
            '',
            '    return match (decimal(text)) {',
            '        Ok(value) => Ok(Decimal(value))',
            '        Err(OutOfRange(_)) => Err(BadNumber(text, start))',
            '        Err(_) => Err(BadSyntax(`invalid number \'${text}\'`, start))',
            '    }',
            '}',
            '',
            'function isNumberChar(c: char): boolean {',
            '    return (c >= \'0\' and c <= \'9\') or c == \'-\' or c == \'+\' or c == \'.\' or c == \'e\' or c == \'E\'',
            '}',
            '',
            '// Whether `text` is a number by the grammar of JSON:',
            '// `-? (0 | [1-9][0-9]*) (. [0-9]+)? ([eE] [+-]? [0-9]+)?`.',
            'function jsonNumber(text: string): boolean {',
            '    immut chars = text.chars()',
            '    mut i = 0',
            '',
            '    if (i < chars.length() and chars[i] == \'-\') { i += 1 }',
            '',
            '    immut first = i',
            '    i = digitsFrom(chars, i)',
            '',
            '    if (i == first or (chars[first] == \'0\' and i - first > 1)) { return false }',
            '',
            '    if (i < chars.length() and chars[i] == \'.\') {',
            '        immut fraction = i + 1',
            '        i = digitsFrom(chars, fraction)',
            '',
            '        if (i == fraction) { return false }',
            '    }',
            '',
            '    if (i < chars.length() and (chars[i] == \'e\' or chars[i] == \'E\')) {',
            '        i += 1',
            '',
            '        if (i < chars.length() and (chars[i] == \'+\' or chars[i] == \'-\')) { i += 1 }',
            '',
            '        immut exponent = i',
            '        i = digitsFrom(chars, exponent)',
            '',
            '        if (i == exponent) { return false }',
            '    }',
            '',
            '    return i == chars.length()',
            '}',
            '',
            '// The position after the digits from `start`.',
            'function digitsFrom(chars: char[], start: int): int {',
            '    mut i = start',
            '',
            '    while (i < chars.length() and chars[i] >= \'0\' and chars[i] <= \'9\') {',
            '        i += 1',
            '    }',
            '',
            '    return i',
            '}',
            '',
            'function Parser.string(mut self): Result[string, Failure] {',
            '    if (not self.at(\'"\')) { return Err(self.syntax(\'expected a string\')) }',
            '',
            '    self.position += 1',
            '    mut out = \'\'',
            '',
            '    while (true) {',
            '        immut c = match (self.current()) {',
            '            Some(found) => found',
            '            None => return Err(self.syntax(\'unterminated string\'))',
            '        }',
            '',
            '        if (c == \'"\') {',
            '            self.position += 1',
            '            return Ok(out)',
            '        }',
            '',
            '        if (c != \'\\\\\') {',
            '            out += string(c)',
            '            self.position += 1',
            '            continue',
            '        }',
            '',
            '        self.position += 1',
            '        immut escaped = self.current()',
            '        self.position += 1',
            '',
            '        match (escaped) {',
            '            Some(\'n\') => out += \'\\n\'',
            '            Some(\'t\') => out += \'\\t\'',
            '            Some(\'r\') => out += \'\\r\'',
            '            Some(\'b\') => out += string(charOf(8))',
            '            Some(\'f\') => out += string(charOf(12))',
            '            Some(\'u\') => out += string(self.unicodeEscape()?)',
            '            Some(other) => out += string(other)',
            '            None => return Err(self.syntax(\'unterminated string\'))',
            '        }',
            '    }',
            '',
            '    return Ok(out)',
            '}',
            '',
            '// The character of `\\uXXXX` (the `\\u` read), with the low half of a surrogate pair after it.',
            'function Parser.unicodeEscape(mut self): Result[char, Failure] {',
            '    immut code = self.hex4()?',
            '',
            '    if (code >= 55296 and code < 56320 and self.at(\'\\\\\') and self.position + 1 < self.chars.length() and self.chars[self.position + 1] == \'u\') {',
            '        self.position += 2',
            '        immut low = self.hex4()?',
            '        return Ok(charOf(65536 + (code - 55296) * 1024 + (low - 56320)))',
            '    }',
            '',
            '    return Ok(charOf(code))',
            '}',
            '',
            '// The character with `code`, or U+FFFD if there is none.',
            'function charOf(code: int): char {',
            '    return match (char(code)) {',
            '        Some(c) => c',
            '        None => match (char(65533)) {',
            '            Some(replacement) => replacement',
            '            None => \' \'',
            '        }',
            '    }',
            '}',
            '',
            '// Four hexadecimal digits.',
            'function Parser.hex4(mut self): Result[int, Failure] {',
            '    mut text = \'\'',
            '    mut value = 0',
            '    mut valid = true',
            '',
            '    for i in range(4) {',
            '        if (self.position + i >= self.chars.length()) {',
            '            valid = false',
            '            break',
            '        }',
            '',
            '        immut c = self.chars[self.position + i]',
            '        text += string(c)',
            '',
            '        match (\'0123456789abcdef\'.indexOf(string(c).lower())) {',
            '            Some(digit) => value = value * 16 + digit',
            '            None => valid = false',
            '        }',
            '    }',
            '',
            '    if (not valid) { return Err(self.syntax(`invalid escape \'\\\\u${text}\'`)) }',
            '',
            '    self.position += 4',
            '    return Ok(value)',
            '}',
            '',
            '// The JSON text of `value`. A `Decimal` always has a point or an exponent, so that it is read back',
            '// as a decimal.',
            'export function stringify(value: Json): string {',
            '    mut out = \'\'',
            '    write(value, mut out)',
            '    return out',
            '}',
            '',
            'function write(value: Json, mut out: string) {',
            '    match (value) {',
            '        Null => out += \'null\'',
            '        Bool(flag) => out += string(flag)',
            '        Int(number) => out += string(number)',
            '        Decimal(number) => {',
            '            immut text = string(number)',
            '            out += text',
            '',
            '            if (not (\'.\' in text or \'e\' in text)) { out += \'.0\' }',
            '        }',
            '        String(text) => writeString(text, mut out)',
            '        Array(items) => {',
            '            out += \'[\'',
            '',
            '            for i in range(items.length()) {',
            '                if (i > 0) { out += \',\' }',
            '',
            '                write(items[i], mut out)',
            '            }',
            '',
            '            out += \']\'',
            '        }',
            '        Object(fields) => {',
            '            out += \'{\'',
            '            mut first = true',
            '',
            '            for key in fields.keys() {',
            '                if (not first) { out += \',\' }',
            '',
            '                first = false',
            '                writeString(key, mut out)',
            '                out += \':\'',
            '                write(fields[key], mut out)',
            '            }',
            '',
            '            out += \'}\'',
            '        }',
            '    }',
            '}',
            '',
            '// A string in JSON, with its escapes.',
            'function writeString(text: string, mut out: string) {',
            '    out += \'"\'',
            '',
            '    for c in text {',
            '        if (c == \'"\') {',
            '            out += \'\\\\"\'',
            '        } else {',
            '            if (c == \'\\\\\') {',
            '                out += \'\\\\\\\\\'',
            '            } else {',
            '                out += escape(c)',
            '            }',
            '        }',
            '    }',
            '',
            '    out += \'"\'',
            '}',
            '',
            'function escape(c: char): string {',
            '    if (c == \'\\n\') { return \'\\\\n\' }',
            '',
            '    if (c == \'\\r\') { return \'\\\\r\' }',
            '',
            '    if (c == \'\\t\') { return \'\\\\t\' }',
            '',
            '    immut code = c.code()',
            '',
            '    if (code < 32) { return `\\\\u00${\'0123456789abcdef\'[code / 16]}${\'0123456789abcdef\'[code % 16]}` }',
            '',
            '    return string(c)',
            '}',
            '',
            '// The field `key` of an object, or `None`.',
            'export function get(value: Json, key: string): Option[Json] {',
            '    return match (value) {',
            '        Object(fields) => fields.get(key)',
            '        _ => None',
            '    }',
            '}',
            '',
            'export function asString(value: Json): Option[string] {',
            '    return match (value) {',
            '        String(text) => Some(text)',
            '        _ => None',
            '    }',
            '}',
            '',
            'export function asInt(value: Json): Option[int] {',
            '    return match (value) {',
            '        Int(number) => Some(number)',
            '        _ => None',
            '    }',
            '}',
            '',
            '// The number of a `Decimal`, or of an `Int` (many writers write `3.0` as `3`).',
            'export function asDecimal(value: Json): Option[decimal] {',
            '    return match (value) {',
            '        Decimal(number) => Some(number)',
            '        Int(number) => Some(decimal(number))',
            '        _ => None',
            '    }',
            '}',
            '',
            'export function asBool(value: Json): Option[boolean] {',
            '    return match (value) {',
            '        Bool(flag) => Some(flag)',
            '        _ => None',
            '    }',
            '}',
        ].join('\n'))
    }

    if (name == 'path') {
        return Some([
            '// The `path` module: paths as text, without the disk (see doc/standard-library/path.md). A path is',
            '// a sequence of parts separated by `/`; repeated separators and `.` after the first part count for',
            '// nothing (`a//b/./c` is `a/b/c`), and a path that starts with `/` starts at the root.',
            '',
            '// `base` followed by `part`, with a separator between them; an absolute `part` replaces `base`.',
            'export function join(base: string, part: string): string {',
            '    if (part.startsWith(\'/\')) { return part }',
            '',
            '    if (base == \'\' or base.endsWith(\'/\')) { return base + part }',
            '',
            '    return `${base}/${part}`',
            '}',
            '',
            '// The directory that contains `path`: `.` for a name alone; the root has none.',
            'export function parent(path: string): Option[string] {',
            '    immut chars = path.chars()',
            '    immut end = trimmedEnd(chars, chars.length())',
            '',
            '    if (end == 0 or (end == 1 and chars[0] == \'/\')) { return None }',
            '',
            '    immut start = partStart(chars, end)',
            '    immut before = trimmedEnd(chars, start)',
            '',
            '    if (before == 0) { return Some(\'.\') }',
            '',
            '    return Some(path[..before])',
            '}',
            '',
            '// The last part of `path`, if it is a name (not the root, `.` or `..`).',
            'export function name(path: string): Option[string] {',
            '    immut chars = path.chars()',
            '    immut end = trimmedEnd(chars, chars.length())',
            '',
            '    if (end == 0 or (end == 1 and chars[0] == \'/\')) { return None }',
            '',
            '    immut start = partStart(chars, end)',
            '    immut last = path[start..end]',
            '',
            '    if (last == \'.\' or last == \'..\') { return None }',
            '',
            '    return Some(last)',
            '}',
            '',
            '// The name without its extension (`.bashrc` has none).',
            'export function stem(path: string): Option[string] {',
            '    return match (name(path)) {',
            '        Some(found) => {',
            '            immut dot = lastDot(found)',
            '',
            '            if (dot <= 0) { return Some(found) }',
            '',
            '            Some(found[..dot])',
            '        }',
            '        None => None',
            '    }',
            '}',
            '',
            '// The extension of the name, without the dot (`\'\'` for `a.`).',
            'export function extension(path: string): Option[string] {',
            '    return match (name(path)) {',
            '        Some(found) => {',
            '            immut dot = lastDot(found)',
            '',
            '            if (dot <= 0) { return None }',
            '',
            '            Some(found[dot + 1..])',
            '        }',
            '        None => None',
            '    }',
            '}',
            '',
            '// Whether `path` starts at the root.',
            'export function isAbsolute(path: string): boolean {',
            '    return path.startsWith(\'/\')',
            '}',
            '',
            '// The end of `chars[..end]` without the separators and the `.` parts that end it (but the root,',
            '// and a `.` that starts the path).',
            'function trimmedEnd(chars: char[], end: int): int {',
            '    mut at = end',
            '',
            '    while (at > 0) {',
            '        if (chars[at - 1] == \'/\' and at > 1) {',
            '            at -= 1',
            '            continue',
            '        }',
            '',
            '        if (chars[at - 1] == \'.\' and at > 1 and chars[at - 2] == \'/\') {',
            '            at -= 1',
            '            continue',
            '        }',
            '',
            '        break',
            '    }',
            '',
            '    return at',
            '}',
            '',
            '// Where the part that ends at `end` starts: after the separator before it.',
            'function partStart(chars: char[], end: int): int {',
            '    mut at = end',
            '',
            '    while (at > 0 and chars[at - 1] != \'/\') {',
            '        at -= 1',
            '    }',
            '',
            '    return at',
            '}',
            '',
            '// The position of the last `.` of `text`, or -1.',
            'function lastDot(text: string): int {',
            '    mut found = -1',
            '    mut position = 0',
            '',
            '    for c in text {',
            '        if (c == \'.\') { found = position }',
            '',
            '        position += 1',
            '    }',
            '',
            '    return found',
            '}',
        ].join('\n'))
    }

    if (name == 'regex') {
        return Some([
            '// The `regex` module: regular expressions (see doc/standard-library/regex.md). A pattern is parsed',
            '// into a tree, compiled into a program for a Pike machine (a Thompson automaton run with one',
            '// thread per state), and matched in a time proportional to the length of the text: no',
            '// backtracking. The first match is the leftmost one, and among those the one that the pattern',
            '// prefers (the first branch of `|`, the longest repetition unless it is lazy).',
            '',
            '// A compiled regular expression: built by `compile` only.',
            'export opaque type Regex = {',
            '    pattern: string',
            '    program: Instruction[]',
            '    // The capture groups, the whole match being group 0, and the names of the named ones.',
            '    groups: int',
            '    names: Map[string, int]',
            '    // The program can only match at the start of the text (`^...`, `\\A...`).',
            '    anchored: boolean',
            '    // The instructions that can read the first character of a match, when every match reads one',
            '    // (`prefilter`): a search skips the positions where none of them matches.',
            '    firsts: Instruction[]',
            '    prefilter: boolean',
            '}',
            '',
            '// A match: its text and its positions in characters (`end` excluded).',
            'export type Match = {',
            '    value: string',
            '    start: int',
            '    end: int',
            '}',
            '',
            'export type RegexError = {',
            '    // The syntax is wrong: `(abc`.',
            '    InvalidPattern(pattern: string, message: string)',
            '    // Valid, but not supported: look-around, backreferences.',
            '    Unsupported(pattern: string, message: string)',
            '    // Too large to compile: `a{1000}{1000}`.',
            '    TooLarge(pattern: string)',
            '}',
            '',
            'function RegexError.display(self): string {',
            '    return match (self) {',
            '        InvalidPattern(pattern, message) => `invalid regular expression \'${pattern}\': ${message}`',
            '        Unsupported(pattern, message) => `unsupported regular expression \'${pattern}\': ${message}`',
            '        TooLarge(pattern) => `regular expression \'${pattern}\' is too large`',
            '    }',
            '}',
            '',
            'function Regex.display(self): string {',
            '    return `<regex \'${self.pattern}\'>`',
            '}',
            '',
            '// The tree of a pattern.',
            'type Node = {',
            '    Empty',
            '    // A character, compared without case when `fold`.',
            '    Literal(c: char, fold: boolean)',
            '    // `.`: any character, or any but a line break.',
            '    Dot(all: boolean)',
            '    Set(set: CharClass, fold: boolean)',
            '    Look(kind: int)',
            '    Capture(index: int, inner: Node)',
            '    Concat(items: Node[])',
            '    Alternate(items: Node[])',
            '    // `max` -1 for no limit.',
            '    Repeat(inner: Node, min: int, max: int, greedy: boolean)',
            '}',
            '',
            '// The assertions (`Look`).',
            'immut startText = 0',
            'immut endText = 1',
            'immut startLine = 2',
            'immut endLine = 3',
            'immut wordBoundary = 4',
            'immut notWordBoundary = 5',
            'immut wordStart = 6',
            'immut wordEnd = 7',
            '',
            '// A set of characters (`[a-z]`, `\\d`): ranges of codes, classes of Unicode, and their unions,',
            '// intersections, differences and complements.',
            'type CharClass = {',
            '    Ranges(ranges: CharRange[])',
            '    Category(kind: int)',
            '    Union(items: CharClass[])',
            '    Intersect(left: CharClass, right: CharClass)',
            '    Subtract(left: CharClass, right: CharClass)',
            '    Either(left: CharClass, right: CharClass)',
            '    Complement(inner: CharClass)',
            '}',
            '',
            'type CharRange = {',
            '    low: int',
            '    high: int',
            '}',
            '',
            '// The classes of Unicode (`Category`).',
            'immut digitClass = 0',
            'immut wordClass = 1',
            'immut spaceClass = 2',
            'immut letterClass = 3',
            'immut upperClass = 4',
            'immut lowerClass = 5',
            'immut numberClass = 6',
            '',
            '// The instructions of the machine.',
            'type Instruction = {',
            '    // Consumes a character equal to `c` (without case when `fold`: `c` is lowercase).',
            '    CharIns(c: char, fold: boolean)',
            '    AnyIns(all: boolean)',
            '    SetIns(set: CharClass, fold: boolean)',
            '    // Continues at both, `first` preferred.',
            '    SplitIns(first: int, second: int)',
            '    JumpIns(target: int)',
            '    SaveIns(slot: int)',
            '    LookIns(kind: int)',
            '    MatchIns',
            '}',
            '',
            '// The modes of `(?imsxU)`.',
            'type Flags = {',
            '    fold: boolean',
            '    multiline: boolean',
            '    dotAll: boolean',
            '    extended: boolean',
            '    lazy: boolean',
            '}',
            '',
            'type Parser = {',
            '    pattern: string',
            '    chars: char[]',
            '    position: int',
            '    groups: int',
            '    names: Map[string, int]',
            '}',
            '',
            '// The most instructions a program may have.',
            'immut largest = 500000',
            '',
            '// The regular expression `pattern`, compiled.',
            'export function compile(pattern: string): Result[Regex, RegexError] {',
            '    mut parser: Parser = { pattern: pattern, chars: pattern.chars(), position: 0, groups: 1, names: [:] }',
            '    mut flags: Flags = { fold: false, multiline: false, dotAll: false, extended: false, lazy: false }',
            '    immut tree = parser.alternation(mut flags, 0)?',
            '',
            '    if (parser.position < parser.chars.length()) { return Err(parser.invalid(\'unopened group\')) }',
            '',
            '    if (size(tree) > largest) { return Err(TooLarge(pattern)) }',
            '',
            '    mut program: Instruction[] = [SaveIns(0)]',
            '    emit(tree, mut program)',
            '    program.push(SaveIns(1))',
            '    program.push(MatchIns)',
            '    mut firsts: Instruction[] = []',
            '    immut prefilter = firstInstructions(program, mut firsts)',
            '    return Ok({',
            '        pattern: pattern, program: program, groups: parser.groups, names: parser.names, anchored: startsAnchored(tree),',
            '        firsts: firsts, prefilter: prefilter',
            '    })',
            '}',
            '',
            '// The instructions that read the first character of a match, in `firsts`; false when a match can',
            '// read none (it is empty, or starts with an assertion).',
            'function firstInstructions(program: Instruction[], mut firsts: Instruction[]): boolean {',
            '    mut seen: boolean[] = []',
            '',
            '    for i in range(program.length()) {',
            '        seen.push(false)',
            '    }',
            '',
            '    mut pending = [0]',
            '',
            '    while (true) {',
            '        immut pc = match (pending.pop()) {',
            '            Some(found) => found',
            '            None => break',
            '        }',
            '',
            '        if (seen[pc]) { continue }',
            '',
            '        seen[pc] = true',
            '',
            '        match (program[pc]) {',
            '            JumpIns(target) => pending.push(target)',
            '            SplitIns(first, second) => {',
            '                pending.push(first)',
            '                pending.push(second)',
            '            }',
            '            SaveIns(_) => pending.push(pc + 1)',
            '            LookIns(_) => return false',
            '            MatchIns => return false',
            '            other => firsts.push(other)',
            '        }',
            '    }',
            '',
            '    return true',
            '}',
            '',
            '// Parsing',
            '',
            'function Parser.invalid(self, message: string): RegexError {',
            '    return InvalidPattern(self.pattern, message)',
            '}',
            '',
            'function Parser.unsupported(self, message: string): RegexError {',
            '    return Unsupported(self.pattern, message)',
            '}',
            '',
            'function Parser.done(self): boolean {',
            '    return self.position >= self.chars.length()',
            '}',
            '',
            'function Parser.peek(self): char {',
            '    return self.chars[self.position]',
            '}',
            '',
            'function Parser.at(self, c: char): boolean {',
            '    return self.position < self.chars.length() and self.chars[self.position] == c',
            '}',
            '',
            '// Spaces and `#` comments, in the extended mode `(?x)`.',
            'function Parser.skipExtended(mut self, flags: Flags) {',
            '    if (not flags.extended) { return }',
            '',
            '    while (not self.done()) {',
            '        immut c = self.peek()',
            '',
            '        if (c == \'#\') {',
            '            while (not self.done() and self.peek() != \'\\n\') {',
            '                self.position += 1',
            '            }',
            '',
            '            continue',
            '        }',
            '',
            '        if (not isSpace(c)) { return }',
            '',
            '        self.position += 1',
            '    }',
            '}',
            '',
            '// `a|b|c` until `)` (inside a group, `depth` > 0) or the end.',
            'function Parser.alternation(mut self, mut flags: Flags, depth: int): Result[Node, RegexError] {',
            '    mut branches = [self.concatenation(mut flags, depth)?]',
            '',
            '    while (self.at(\'|\')) {',
            '        self.position += 1',
            '        branches.push(self.concatenation(mut flags, depth)?)',
            '    }',
            '',
            '    if (branches.length() == 1) { return Ok(branches[0]) }',
            '',
            '    return Ok(Alternate(branches))',
            '}',
            '',
            'function Parser.concatenation(mut self, mut flags: Flags, depth: int): Result[Node, RegexError] {',
            '    mut items: Node[] = []',
            '',
            '    while (true) {',
            '        self.skipExtended(flags)',
            '',
            '        if (self.done() or self.at(\'|\')) { break }',
            '',
            '        if (self.at(\')\')) {',
            '            if (depth == 0) { return Err(self.invalid(\'unopened group\')) }',
            '',
            '            break',
            '        }',
            '',
            '        immut c = self.peek()',
            '',
            '        if (c == \'*\' or c == \'+\' or c == \'?\' or c == \'{\') {',
            '            if (items.length() == 0) { return Err(self.invalid(\'repetition operator missing expression\')) }',
            '',
            '            immut last = items.pop()',
            '',
            '            match (last) {',
            '                Some(node) => items.push(self.repetition(node, flags)?)',
            '                None => {}',
            '            }',
            '',
            '            continue',
            '        }',
            '',
            '        match (self.atom(mut flags, depth)?) {',
            '            Some(node) => items.push(node)',
            '            None => {}',
            '        }',
            '    }',
            '',
            '    if (items.length() == 0) { return Ok(Empty) }',
            '',
            '    if (items.length() == 1) { return Ok(items[0]) }',
            '',
            '    return Ok(Concat(items))',
            '}',
            '',
            '// `*`, `+`, `?` or `{n,m}` after `node`, and `?` for a lazy one.',
            'function Parser.repetition(mut self, node: Node, flags: Flags): Result[Node, RegexError] {',
            '    immut c = self.peek()',
            '    self.position += 1',
            '    mut min = 0',
            '    mut max = -1',
            '',
            '    if (c == \'+\') { min = 1 }',
            '',
            '    if (c == \'?\') { max = 1 }',
            '',
            '    if (c == \'{\') {',
            '        min = self.decimal()?',
            '        max = min',
            '',
            '        if (self.at(\',\')) {',
            '            self.position += 1',
            '            max = -1',
            '',
            '            if (not self.at(\'}\')) { max = self.decimal()? }',
            '        }',
            '',
            '        if (not self.at(\'}\')) { return Err(self.invalid(\'unclosed counted repetition\')) }',
            '',
            '        self.position += 1',
            '',
            '        if (max != -1 and min > max) { return Err(self.invalid(\'invalid repetition count range, the start must be <= the end\')) }',
            '    }',
            '',
            '    mut greedy = not flags.lazy',
            '',
            '    if (self.at(\'?\')) {',
            '        self.position += 1',
            '        greedy = not greedy',
            '    }',
            '',
            '    return Ok(Repeat(node, min, max, greedy))',
            '}',
            '',
            'function Parser.decimal(mut self): Result[int, RegexError] {',
            '    mut value = 0',
            '    mut digits = 0',
            '',
            '    while (not self.done() and self.peek() >= \'0\' and self.peek() <= \'9\') {',
            '        value = value * 10 + (self.peek().code() - 48)',
            '        digits += 1',
            '        self.position += 1',
            '',
            '        if (value > 4294967295) { return Err(self.invalid(\'repetition quantifier expects a valid decimal\')) }',
            '    }',
            '',
            '    if (digits == 0) {',
            '        if (self.done()) { return Err(self.invalid(\'unclosed counted repetition\')) }',
            '',
            '        return Err(self.invalid(\'repetition quantifier expects a valid decimal\'))',
            '    }',
            '',
            '    return Ok(value)',
            '}',
            '',
            '// One element: a character, a class, a group, an assertion. `None` for a group that only sets',
            '// flags (`(?i)`).',
            'function Parser.atom(mut self, mut flags: Flags, depth: int): Result[Option[Node], RegexError] {',
            '    immut c = self.peek()',
            '    self.position += 1',
            '',
            '    if (c == \'(\') { return self.group(mut flags, depth) }',
            '',
            '    if (c == \'[\') { return Ok(Some(Set(self.charClass()?, flags.fold))) }',
            '',
            '    if (c == \'.\') { return Ok(Some(Dot(flags.dotAll))) }',
            '',
            '    if (c == \'^\') { return Ok(Some(Look(if (flags.multiline) { startLine } else { startText }))) }',
            '',
            '    if (c == \'$\') { return Ok(Some(Look(if (flags.multiline) { endLine } else { endText }))) }',
            '',
            '    if (c == \'\\\\\') { return Ok(Some(self.escape(flags)?)) }',
            '',
            '    return Ok(Some(literal(c, flags.fold)))',
            '}',
            '',
            'function literal(c: char, fold: boolean): Node {',
            '    if (fold and lowered(c) != uppered(c)) { return Literal(lowered(c), true) }',
            '',
            '    return Literal(c, false)',
            '}',
            '',
            'function Parser.group(mut self, mut flags: Flags, depth: int): Result[Option[Node], RegexError] {',
            '    if (not self.at(\'?\')) {',
            '        immut index = self.groups',
            '        self.groups += 1',
            '        return Ok(Some(Capture(index, self.groupBody(flags, depth)?)))',
            '    }',
            '',
            '    self.position += 1',
            '',
            '    if (self.done()) { return Err(self.invalid(\'unclosed group\')) }',
            '',
            '    immut c = self.peek()',
            '',
            '    if (c == \'=\' or c == \'!\') { return Err(self.unsupported(\'look-around, including look-ahead and look-behind, is not supported\')) }',
            '',
            '    if (c == \'<\' and self.position + 1 < self.chars.length() and (self.chars[self.position + 1] == \'=\' or self.chars[self.position + 1] == \'!\')) {',
            '        return Err(self.unsupported(\'look-around, including look-ahead and look-behind, is not supported\'))',
            '    }',
            '',
            '    if (c == \'P\' and self.position + 1 < self.chars.length() and self.chars[self.position + 1] == \'=\') {',
            '        return Err(self.unsupported(\'backreferences are not supported\'))',
            '    }',
            '',
            '    // `(?P<name>...)` or `(?<name>...)`.',
            '    if (c == \'<\' or (c == \'P\' and self.position + 1 < self.chars.length() and self.chars[self.position + 1] == \'<\')) {',
            '        self.position += if (c == \'P\') { 2 } else { 1 }',
            '        immut name = self.groupName()?',
            '',
            '        if (self.names.has(name)) { return Err(self.invalid(\'duplicate capture group name\')) }',
            '',
            '        immut index = self.groups',
            '        self.groups += 1',
            '        self.names[name] = index',
            '        return Ok(Some(Capture(index, self.groupBody(flags, depth)?)))',
            '    }',
            '',
            '    // Flags, for the rest of the group (`(?i)`) or for a group of their own (`(?i:...)`).',
            '    mut changed = flags',
            '    mut negated = false',
            '',
            '    while (true) {',
            '        if (self.done()) { return Err(self.invalid(\'expected flag but got end of regex\')) }',
            '',
            '        immut flag = self.peek()',
            '        self.position += 1',
            '',
            '        if (flag == \')\') {',
            '            flags = changed',
            '            return Ok(None)',
            '        }',
            '',
            '        if (flag == \':\') { return Ok(Some(self.groupBody(changed, depth)?)) }',
            '',
            '        if (flag == \'-\') {',
            '            negated = true',
            '            continue',
            '        }',
            '',
            '        immut value = not negated',
            '',
            '        match (flag) {',
            '            \'i\' => changed.fold = value',
            '            \'m\' => changed.multiline = value',
            '            \'s\' => changed.dotAll = value',
            '            \'x\' => changed.extended = value',
            '            \'U\' => changed.lazy = value',
            '            \'u\' => {}',
            '            \'R\' => {}',
            '            _ => return Err(self.invalid(\'unrecognized flag\'))',
            '        }',
            '    }',
            '',
            '    return Ok(None)',
            '}',
            '',
            '// The pattern of a group, until its `)`; its flags end with it.',
            'function Parser.groupBody(mut self, flags: Flags, depth: int): Result[Node, RegexError] {',
            '    mut inner = flags',
            '    immut body = self.alternation(mut inner, depth + 1)?',
            '',
            '    if (not self.at(\')\')) { return Err(self.invalid(\'unclosed group\')) }',
            '',
            '    self.position += 1',
            '    return Ok(body)',
            '}',
            '',
            'function Parser.groupName(mut self): Result[string, RegexError] {',
            '    mut name = \'\'',
            '',
            '    while (true) {',
            '        if (self.done()) { return Err(self.invalid(\'unclosed capture group name\')) }',
            '',
            '        immut c = self.peek()',
            '        self.position += 1',
            '',
            '        if (c == \'>\') { break }',
            '',
            '        immut first = name == \'\'',
            '        immut valid = c == \'_\' or isAsciiLetter(c) or (not first and ((c >= \'0\' and c <= \'9\') or c == \'.\' or c == \'[\' or c == \']\'))',
            '',
            '        if (not valid) { return Err(self.invalid(\'invalid capture group character\')) }',
            '',
            '        name += string(c)',
            '    }',
            '',
            '    if (name == \'\') { return Err(self.invalid(\'empty capture group name\')) }',
            '',
            '    return Ok(name)',
            '}',
            '',
            '// After `\\`, outside a class.',
            'function Parser.escape(mut self, flags: Flags): Result[Node, RegexError] {',
            '    if (self.done()) { return Err(self.invalid(\'incomplete escape sequence, reached end of pattern prematurely\')) }',
            '',
            '    immut c = self.peek()',
            '',
            '    if (c >= \'1\' and c <= \'9\') { return Err(self.unsupported(\'backreferences are not supported\')) }',
            '',
            '    match (c) {',
            '        \'b\' => {',
            '            self.position += 1',
            '            return Ok(Look(wordBoundary))',
            '        }',
            '        \'B\' => {',
            '            self.position += 1',
            '            return Ok(Look(notWordBoundary))',
            '        }',
            '        \'A\' => {',
            '            self.position += 1',
            '            return Ok(Look(startText))',
            '        }',
            '        \'z\' => {',
            '            self.position += 1',
            '            return Ok(Look(endText))',
            '        }',
            '        \'<\' => {',
            '            self.position += 1',
            '            return Ok(Look(wordStart))',
            '        }',
            '        \'>\' => {',
            '            self.position += 1',
            '            return Ok(Look(wordEnd))',
            '        }',
            '        _ => {}',
            '    }',
            '',
            '    match (self.classEscape()?) {',
            '        Some(set) => return Ok(Set(set, flags.fold))',
            '        None => {}',
            '    }',
            '',
            '    return Ok(literal(self.escapedChar()?, flags.fold))',
            '}',
            '',
            '// `\\d`, `\\w`, `\\s`, `\\p{...}` and their complements, if the escape is one (after `\\`).',
            'function Parser.classEscape(mut self): Result[Option[CharClass], RegexError] {',
            '    immut c = self.peek()',
            '    immut kind = match (c) {',
            '        \'d\' => digitClass',
            '        \'D\' => digitClass',
            '        \'w\' => wordClass',
            '        \'W\' => wordClass',
            '        \'s\' => spaceClass',
            '        \'S\' => spaceClass',
            '        \'p\' => -1',
            '        \'P\' => -1',
            '        _ => return Ok(None)',
            '    }',
            '    self.position += 1',
            '    immut negated = c == \'D\' or c == \'W\' or c == \'S\' or c == \'P\'',
            '    mut set = Category(kind)',
            '',
            '    if (kind == -1) { set = self.property()? }',
            '',
            '    if (negated) { return Ok(Some(Complement(set))) }',
            '',
            '    return Ok(Some(set))',
            '}',
            '',
            '// `{Letter}` or `L` after `\\p`.',
            'function Parser.property(mut self): Result[CharClass, RegexError] {',
            '    mut name = \'\'',
            '',
            '    if (self.at(\'{\')) {',
            '        self.position += 1',
            '',
            '        while (not self.at(\'}\')) {',
            '            if (self.done()) { return Err(self.invalid(\'Unicode escape not closed\')) }',
            '',
            '            name += string(self.peek())',
            '            self.position += 1',
            '        }',
            '',
            '        self.position += 1',
            '    } else {',
            '        if (self.done()) { return Err(self.invalid(\'Unicode escape not closed\')) }',
            '',
            '        name = string(self.peek())',
            '        self.position += 1',
            '    }',
            '',
            '    immut kind = match (name.lower().replace(\'_\', \'\').replace(\' \', \'\')) {',
            '        \'l\' => letterClass',
            '        \'letter\' => letterClass',
            '        \'alphabetic\' => letterClass',
            '        \'alpha\' => letterClass',
            '        \'lu\' => upperClass',
            '        \'uppercaseletter\' => upperClass',
            '        \'uppercase\' => upperClass',
            '        \'upper\' => upperClass',
            '        \'ll\' => lowerClass',
            '        \'lowercaseletter\' => lowerClass',
            '        \'lowercase\' => lowerClass',
            '        \'lower\' => lowerClass',
            '        \'n\' => numberClass',
            '        \'number\' => numberClass',
            '        \'nd\' => digitClass',
            '        \'decimalnumber\' => digitClass',
            '        \'digit\' => digitClass',
            '        \'whitespace\' => spaceClass',
            '        \'space\' => spaceClass',
            '        _ => -1',
            '    }',
            '',
            '    if (kind == -1) { return Err(self.unsupported(`the Unicode property \'${name}\' is not supported`)) }',
            '',
            '    return Ok(Category(kind))',
            '}',
            '',
            '// The character of an escape that stands for one (after `\\`).',
            'function Parser.escapedChar(mut self): Result[char, RegexError] {',
            '    immut c = self.peek()',
            '    self.position += 1',
            '',
            '    match (c) {',
            '        \'n\' => return Ok(\'\\n\')',
            '        \'t\' => return Ok(\'\\t\')',
            '        \'r\' => return Ok(\'\\r\')',
            '        \'f\' => return Ok(charOf(12))',
            '        \'v\' => return Ok(charOf(11))',
            '        \'a\' => return Ok(charOf(7))',
            '        \'x\' => return self.hexChar(2)',
            '        \'u\' => return self.hexChar(4)',
            '        \'U\' => return self.hexChar(8)',
            '        _ => {}',
            '    }',
            '',
            '    // Any ASCII character that is not a letter or a digit stands for itself.',
            '    immut code = c.code()',
            '',
            '    if (code < 128 and not isAsciiLetter(c) and not (c >= \'0\' and c <= \'9\') and code > 32) { return Ok(c) }',
            '',
            '    if (c == \' \') { return Ok(c) }',
            '',
            '    return Err(self.invalid(\'unrecognized escape sequence\'))',
            '}',
            '',
            '// `\\x41` (`digits` hexadecimal digits) or `\\x{1F600}`.',
            'function Parser.hexChar(mut self, digits: int): Result[char, RegexError] {',
            '    mut text = \'\'',
            '',
            '    if (self.at(\'{\')) {',
            '        self.position += 1',
            '',
            '        while (not self.at(\'}\')) {',
            '            if (self.done()) { return Err(self.invalid(\'unclosed hexadecimal literal\')) }',
            '',
            '            text += string(self.peek())',
            '            self.position += 1',
            '        }',
            '',
            '        self.position += 1',
            '',
            '        if (text == \'\') { return Err(self.invalid(\'empty hexadecimal literal\')) }',
            '    } else {',
            '        for i in range(digits) {',
            '            if (self.done()) { return Err(self.invalid(\'incomplete escape sequence, reached end of pattern prematurely\')) }',
            '',
            '            text += string(self.peek())',
            '            self.position += 1',
            '        }',
            '    }',
            '',
            '    mut value = 0',
            '',
            '    for digit in text {',
            '        match (\'0123456789abcdef\'.indexOf(string(digit).lower())) {',
            '            Some(found) => value = value * 16 + found',
            '            None => return Err(self.invalid(\'invalid hexadecimal digit\'))',
            '        }',
            '',
            '        if (value > 1114111) { return Err(self.invalid(\'hexadecimal literal is not a Unicode scalar value\')) }',
            '    }',
            '',
            '    return match (char(value)) {',
            '        Some(found) => Ok(found)',
            '        None => Err(self.invalid(\'hexadecimal literal is not a Unicode scalar value\'))',
            '    }',
            '}',
            '',
            '// A class `[...]` (after its `[`).',
            'function Parser.charClass(mut self): Result[CharClass, RegexError] {',
            '    mut negated = false',
            '',
            '    if (self.at(\'^\')) {',
            '        self.position += 1',
            '        negated = true',
            '    }',
            '',
            '    mut set = self.classUnion(true)?',
            '',
            '    while (true) {',
            '        if (self.done()) { return Err(self.invalid(\'unclosed character class\')) }',
            '',
            '        if (self.at(\']\')) {',
            '            self.position += 1',
            '            break',
            '        }',
            '',
            '        immut operator = self.classOperator()',
            '',
            '        if (operator == \'\') { return Err(self.invalid(\'unclosed character class\')) }',
            '',
            '        immut right = self.classUnion(false)?',
            '        set = match (operator) {',
            '            \'&&\' => Intersect(set, right)',
            '            \'--\' => Subtract(set, right)',
            '            _ => Either(set, right)',
            '        }',
            '    }',
            '',
            '    if (negated) { return Ok(Complement(set)) }',
            '',
            '    return Ok(set)',
            '}',
            '',
            '// `&&`, `--` or `~~` at the position (read), or `\'\'`.',
            'function Parser.classOperator(mut self): string {',
            '    if (self.position + 1 >= self.chars.length()) { return \'\' }',
            '',
            '    immut pair = `${self.chars[self.position]}${self.chars[self.position + 1]}`',
            '',
            '    if (pair == \'&&\' or pair == \'--\' or pair == \'~~\') {',
            '        self.position += 2',
            '        return pair',
            '    }',
            '',
            '    return \'\'',
            '}',
            '',
            '// The items of a class until `]` or an operator; a `]` first stands for itself.',
            'function Parser.classUnion(mut self, first: boolean): Result[CharClass, RegexError] {',
            '    mut ranges: CharRange[] = []',
            '    mut items: CharClass[] = []',
            '    mut start = first',
            '',
            '    while (true) {',
            '        if (self.done()) { return Err(self.invalid(\'unclosed character class\')) }',
            '',
            '        immut c = self.peek()',
            '',
            '        if (c == \']\' and not start) { break }',
            '',
            '        if (self.position + 1 < self.chars.length()) {',
            '            immut pair = `${c}${self.chars[self.position + 1]}`',
            '',
            '            if ((pair == \'&&\' or pair == \'--\' or pair == \'~~\') and not start) { break }',
            '        }',
            '',
            '        start = false',
            '',
            '        // `[:alpha:]`',
            '        if (c == \'[\' and self.position + 1 < self.chars.length() and self.chars[self.position + 1] == \':\') {',
            '            match (self.posixClass()) {',
            '                Some(set) => {',
            '                    items.push(set)',
            '                    continue',
            '                }',
            '                None => {}',
            '            }',
            '        }',
            '',
            '        if (c == \'[\') {',
            '            self.position += 1',
            '            items.push(self.charClass()?)',
            '            continue',
            '        }',
            '',
            '        immut low = match (self.classChar()?) {',
            '            ClassSet(set) => {',
            '                items.push(set)',
            '                continue',
            '            }',
            '            ClassChar(found) => found',
            '        }',
            '',
            '        // A range `a-z`; a `-` before `]` stands for itself.',
            '        if (self.at(\'-\') and self.position + 1 < self.chars.length() and self.chars[self.position + 1] != \']\' and self.chars[self.position + 1] != \'-\') {',
            '            self.position += 1',
            '',
            '            immut high = match (self.classChar()?) {',
            '                ClassChar(found) => found',
            '                ClassSet(_) => return Err(self.invalid(\'invalid character class range\'))',
            '            }',
            '',
            '            if (high.code() < low.code()) { return Err(self.invalid(\'invalid character class range, the start must be <= the end\')) }',
            '',
            '            ranges.push({ low: low.code(), high: high.code() })',
            '            continue',
            '        }',
            '',
            '        ranges.push({ low: low.code(), high: low.code() })',
            '    }',
            '',
            '    if (items.length() == 0) { return Ok(Ranges(ranges)) }',
            '',
            '    if (ranges.length() > 0) { items.push(Ranges(ranges)) }',
            '',
            '    if (items.length() == 1) { return Ok(items[0]) }',
            '',
            '    return Ok(Union(items))',
            '}',
            '',
            '// A character of a class, or a class escape (`\\d`).',
            'type ClassItem = {',
            '    ClassChar(c: char)',
            '    ClassSet(set: CharClass)',
            '}',
            '',
            'function Parser.classChar(mut self): Result[ClassItem, RegexError] {',
            '    immut c = self.peek()',
            '    self.position += 1',
            '',
            '    if (c != \'\\\\\') { return Ok(ClassChar(c)) }',
            '',
            '    if (self.done()) { return Err(self.invalid(\'incomplete escape sequence, reached end of pattern prematurely\')) }',
            '',
            '    match (self.classEscape()?) {',
            '        Some(set) => return Ok(ClassSet(set))',
            '        None => {}',
            '    }',
            '',
            '    immut escaped = self.peek()',
            '',
            '    if (escaped == \'b\') {',
            '        self.position += 1',
            '        return Ok(ClassChar(charOf(8)))',
            '    }',
            '',
            '    return Ok(ClassChar(self.escapedChar()?))',
            '}',
            '',
            '// `[:alpha:]` (ASCII) at the position, read if it is one.',
            'function Parser.posixClass(mut self): Option[CharClass] {',
            '    mut end = self.position + 2',
            '    mut name = \'\'',
            '',
            '    while (end < self.chars.length() and self.chars[end] != \':\') {',
            '        name += string(self.chars[end])',
            '        end += 1',
            '    }',
            '',
            '    if (end + 1 >= self.chars.length() or self.chars[end + 1] != \']\') { return None }',
            '',
            '    immut negated = name.startsWith(\'^\')',
            '    immut plain = if (negated) { name[1..] } else { name }',
            '    immut ranges: CharRange[] = match (plain) {',
            '        \'alnum\' => [span(\'0\', \'9\'), span(\'A\', \'Z\'), span(\'a\', \'z\')]',
            '        \'alpha\' => [span(\'A\', \'Z\'), span(\'a\', \'z\')]',
            '        \'ascii\' => [{ low: 0, high: 127 }]',
            '        \'blank\' => [span(\'\\t\', \'\\t\'), span(\' \', \' \')]',
            '        \'cntrl\' => [{ low: 0, high: 31 }, { low: 127, high: 127 }]',
            '        \'digit\' => [span(\'0\', \'9\')]',
            '        \'graph\' => [{ low: 33, high: 126 }]',
            '        \'lower\' => [span(\'a\', \'z\')]',
            '        \'print\' => [{ low: 32, high: 126 }]',
            '        \'punct\' => [{ low: 33, high: 47 }, { low: 58, high: 64 }, { low: 91, high: 96 }, { low: 123, high: 126 }]',
            '        \'space\' => [span(\'\\t\', \'\\r\'), span(\' \', \' \')]',
            '        \'upper\' => [span(\'A\', \'Z\')]',
            '        \'word\' => [span(\'0\', \'9\'), span(\'A\', \'Z\'), span(\'_\', \'_\'), span(\'a\', \'z\')]',
            '        \'xdigit\' => [span(\'0\', \'9\'), span(\'A\', \'F\'), span(\'a\', \'f\')]',
            '        _ => return None',
            '    }',
            '    self.position = end + 2',
            '',
            '    if (negated) { return Some(Complement(Ranges(ranges))) }',
            '',
            '    return Some(Ranges(ranges))',
            '}',
            '',
            'function span(low: char, high: char): CharRange {',
            '    return { low: low.code(), high: high.code() }',
            '}',
            '',
            '// Compiling',
            '',
            '// The instructions `node` compiles to (an upper bound, to refuse a pattern too large before',
            '// building it).',
            'function size(node: Node): int {',
            '    return match (node) {',
            '        Empty => 0',
            '        Capture(_, inner) => size(inner) + 2',
            '        Concat(items) => {',
            '            mut total = 0',
            '',
            '            for item in items {',
            '                total += size(item)',
            '',
            '                if (total > largest) { return total }',
            '            }',
            '',
            '            total',
            '        }',
            '        Alternate(items) => {',
            '            mut total = 0',
            '',
            '            for item in items {',
            '                total += size(item) + 2',
            '',
            '                if (total > largest) { return total }',
            '            }',
            '',
            '            total',
            '        }',
            '        Repeat(inner, min, max, _) => {',
            '            immut copies = if (max == -1) { min + 1 } else { max }',
            '            immut one = size(inner) + 2',
            '',
            '            if (copies > 0 and one > (largest + 1) / copies) { return largest + 1 }',
            '',
            '            one * copies',
            '        }',
            '        _ => 1',
            '    }',
            '}',
            '',
            'function emit(node: Node, mut program: Instruction[]) {',
            '    match (node) {',
            '        Empty => {}',
            '        Literal(c, fold) => program.push(CharIns(c, fold))',
            '        Dot(all) => program.push(AnyIns(all))',
            '        Set(set, fold) => program.push(SetIns(set, fold))',
            '        Look(kind) => program.push(LookIns(kind))',
            '        Capture(index, inner) => {',
            '            program.push(SaveIns(index * 2))',
            '            emit(inner, mut program)',
            '            program.push(SaveIns(index * 2 + 1))',
            '        }',
            '        Concat(items) => {',
            '            for item in items {',
            '                emit(item, mut program)',
            '            }',
            '        }',
            '        Alternate(items) => emitAlternation(items, 0, mut program)',
            '        Repeat(inner, min, max, greedy) => {',
            '            for i in range(min) {',
            '                emit(inner, mut program)',
            '            }',
            '',
            '            if (max == -1) {',
            '                emitStar(inner, greedy, mut program)',
            '                return',
            '            }',
            '',
            '            emitOptional(inner, max - min, greedy, mut program)',
            '        }',
            '    }',
            '}',
            '',
            '// `items[index] | items[index + 1] | ...`: each branch preferred to the ones after it.',
            'function emitAlternation(items: Node[], index: int, mut program: Instruction[]) {',
            '    if (index == items.length() - 1) {',
            '        emit(items[index], mut program)',
            '        return',
            '    }',
            '',
            '    immut split = program.length()',
            '    program.push(SplitIns(0, 0))',
            '    emit(items[index], mut program)',
            '    immut jump = program.length()',
            '    program.push(JumpIns(0))',
            '    immut next = program.length()',
            '    emitAlternation(items, index + 1, mut program)',
            '    program[split] = SplitIns(split + 1, next)',
            '    program[jump] = JumpIns(program.length())',
            '}',
            '',
            '// `inner*`.',
            'function emitStar(inner: Node, greedy: boolean, mut program: Instruction[]) {',
            '    immut split = program.length()',
            '    program.push(SplitIns(0, 0))',
            '    emit(inner, mut program)',
            '    program.push(JumpIns(split))',
            '    immut after = program.length()',
            '    program[split] = if (greedy) { SplitIns(split + 1, after) } else { SplitIns(after, split + 1) }',
            '}',
            '',
            '// `(inner(inner(...)?)?)?`, `count` times.',
            'function emitOptional(inner: Node, count: int, greedy: boolean, mut program: Instruction[]) {',
            '    mut splits: int[] = []',
            '',
            '    for i in range(count) {',
            '        splits.push(program.length())',
            '        program.push(SplitIns(0, 0))',
            '        emit(inner, mut program)',
            '    }',
            '',
            '    immut after = program.length()',
            '',
            '    for split in splits {',
            '        program[split] = if (greedy) { SplitIns(split + 1, after) } else { SplitIns(after, split + 1) }',
            '    }',
            '}',
            '',
            '// Whether every match of `node` starts at the start of the text.',
            'function startsAnchored(node: Node): boolean {',
            '    return match (node) {',
            '        Look(kind) => kind == startText',
            '        Capture(_, inner) => startsAnchored(inner)',
            '        Concat(items) => items.length() > 0 and startsAnchored(items[0])',
            '        Alternate(items) => {',
            '            for item in items {',
            '                if (not startsAnchored(item)) { return false }',
            '            }',
            '',
            '            true',
            '        }',
            '        Repeat(inner, min, _, _) => min > 0 and startsAnchored(inner)',
            '        _ => false',
            '    }',
            '}',
            '',
            '// Matching',
            '',
            '// A thread of the machine: where it is in the program, and the positions of the groups so far.',
            'type Thread = {',
            '    pc: int',
            '    slots: int[]',
            '}',
            '',
            '// The slots (start and end of each group, -1 when it did not match) of the first match of the',
            '// program in `chars` from `start`, if there is one.',
            'function Regex.search(self, chars: char[], start: int): Option[int[]] {',
            '    immut count = chars.length()',
            '    mut empty: int[] = []',
            '',
            '    for i in range(self.groups * 2) {',
            '        empty.push(-1)',
            '    }',
            '',
            '    // `seen[pc] == step`: the state is already in the list of the step.',
            '    mut seen: int[] = []',
            '',
            '    for i in range(self.program.length()) {',
            '        seen.push(-1)',
            '    }',
            '',
            '    mut current: Thread[] = []',
            '    mut found: Option[int[]] = None',
            '    mut position = start',
            '    mut step = 0',
            '',
            '    if (self.prefilter and not self.anchored) {',
            '        while (position < count and not self.canStart(chars[position])) {',
            '            position += 1',
            '        }',
            '',
            '        if (position >= count) { return None }',
            '    }',
            '',
            '    while (true) {',
            '        // A new thread at each position, after the others: they started earlier.',
            '        if (found is None and (not self.anchored or position == 0)) {',
            '            self.follow(mut current, mut seen, step, { pc: 0, slots: empty }, chars, position)',
            '        }',
            '',
            '        step += 1',
            '',
            '        // No thread here: the next position, unless a match is found or the text has ended.',
            '        if (current.length() == 0) {',
            '            if (found is Some or position >= count or self.anchored) { break }',
            '',
            '            position += 1',
            '',
            '            // Up to a character that a match can start with.',
            '            if (self.prefilter) {',
            '                while (position < count and not self.canStart(chars[position])) {',
            '                    position += 1',
            '                }',
            '',
            '                if (position >= count) { break }',
            '            }',
            '',
            '            continue',
            '        }',
            '',
            '        mut next: Thread[] = []',
            '',
            '        for thread in current {',
            '            immut instruction = self.program[thread.pc]',
            '',
            '            if (instruction is MatchIns) {',
            '                found = Some(thread.slots)',
            '                // The threads after this one are less preferred.',
            '                break',
            '            }',
            '',
            '            if (position < count and consumes(instruction, chars[position])) {',
            '                self.follow(mut next, mut seen, step, { pc: thread.pc + 1, slots: thread.slots }, chars, position + 1)',
            '            }',
            '        }',
            '',
            '        current = next',
            '',
            '        if (position >= count) { break }',
            '',
            '        position += 1',
            '    }',
            '',
            '    return found',
            '}',
            '',
            '// Adds `thread` to `list`, through the instructions that consume nothing, in the order of',
            '// preference. `seen` and `step` keep each state once per step.',
            'function Regex.follow(self, mut list: Thread[], mut seen: int[], step: int, thread: Thread, chars: char[], position: int) {',
            '    if (seen[thread.pc] == step) { return }',
            '',
            '    // Most often the next instruction reads a character: the thread waits for it.',
            '    if (readsChar(self.program[thread.pc])) {',
            '        seen[thread.pc] = step',
            '        list.push(thread)',
            '        return',
            '    }',
            '',
            '    mut pending: Thread[] = [thread]',
            '',
            '    while (true) {',
            '        immut current = match (pending.pop()) {',
            '            Some(found) => found',
            '            None => break',
            '        }',
            '',
            '        if (seen[current.pc] == step) { continue }',
            '',
            '        seen[current.pc] = step',
            '',
            '        match (self.program[current.pc]) {',
            '            JumpIns(target) => pending.push({ pc: target, slots: current.slots })',
            '            // The first is preferred: it is taken from the stack first.',
            '            SplitIns(first, second) => {',
            '                pending.push({ pc: second, slots: current.slots })',
            '                pending.push({ pc: first, slots: current.slots })',
            '            }',
            '            SaveIns(slot) => {',
            '                mut slots = current.slots',
            '                slots[slot] = position',
            '                pending.push({ pc: current.pc + 1, slots: slots })',
            '            }',
            '            LookIns(kind) => {',
            '                if (holds(kind, chars, position)) { pending.push({ pc: current.pc + 1, slots: current.slots }) }',
            '            }',
            '            _ => list.push(current)',
            '        }',
            '    }',
            '}',
            '',
            'function readsChar(instruction: Instruction): boolean {',
            '    return match (instruction) {',
            '        CharIns(_, _) => true',
            '        AnyIns(_) => true',
            '        SetIns(_, _) => true',
            '        _ => false',
            '    }',
            '}',
            '',
            'function Regex.canStart(self, c: char): boolean {',
            '    for instruction in self.firsts {',
            '        if (consumes(instruction, c)) { return true }',
            '    }',
            '',
            '    return false',
            '}',
            '',
            'function consumes(instruction: Instruction, c: char): boolean {',
            '    return match (instruction) {',
            '        CharIns(expected, fold) => if (fold) { lowered(c) == expected } else { c == expected }',
            '        AnyIns(all) => all or c != \'\\n\'',
            '        SetIns(set, fold) => {',
            '            if (contains(set, c)) { return true }',
            '',
            '            fold and (contains(set, lowered(c)) or contains(set, uppered(c)))',
            '        }',
            '        _ => false',
            '    }',
            '}',
            '',
            'function contains(set: CharClass, c: char): boolean {',
            '    return match (set) {',
            '        Ranges(ranges) => {',
            '            immut code = c.code()',
            '',
            '            for range in ranges {',
            '                if (code >= range.low and code <= range.high) { return true }',
            '            }',
            '',
            '            false',
            '        }',
            '        Category(kind) => inCategory(kind, c)',
            '        Union(items) => {',
            '            for item in items {',
            '                if (contains(item, c)) { return true }',
            '            }',
            '',
            '            false',
            '        }',
            '        Intersect(left, right) => contains(left, c) and contains(right, c)',
            '        Subtract(left, right) => contains(left, c) and not contains(right, c)',
            '        Either(left, right) => contains(left, c) != contains(right, c)',
            '        Complement(inner) => not contains(inner, c)',
            '    }',
            '}',
            '',
            '// The classes of Unicode, by the classifications of strings (exact for ASCII).',
            'function inCategory(kind: int, c: char): boolean {',
            '    immut code = c.code()',
            '',
            '    if (code < 128) {',
            '        return match (kind) {',
            '            0 => c >= \'0\' and c <= \'9\'',
            '            1 => isAsciiLetter(c) or (c >= \'0\' and c <= \'9\') or c == \'_\'',
            '            2 => c == \' \' or (code >= 9 and code <= 13)',
            '            3 => isAsciiLetter(c)',
            '            4 => c >= \'A\' and c <= \'Z\'',
            '            5 => c >= \'a\' and c <= \'z\'',
            '            _ => c >= \'0\' and c <= \'9\'',
            '        }',
            '    }',
            '',
            '    immut text = string(c)',
            '',
            '    return match (kind) {',
            '        0 => text.isNumeric()',
            '        1 => text.isAlphaNumeric()',
            '        2 => text.isSpace()',
            '        3 => text.isAlpha()',
            '        4 => text.isAlpha() and text.isUpper()',
            '        5 => text.isAlpha() and text.isLower()',
            '        _ => text.isNumeric()',
            '    }',
            '}',
            '',
            'function holds(kind: int, chars: char[], position: int): boolean {',
            '    immut count = chars.length()',
            '',
            '    if (kind == startText) { return position == 0 }',
            '',
            '    if (kind == endText) { return position == count }',
            '',
            '    if (kind == startLine) { return position == 0 or chars[position - 1] == \'\\n\' }',
            '',
            '    if (kind == endLine) { return position == count or chars[position] == \'\\n\' }',
            '',
            '    immut before = position > 0 and isWord(chars[position - 1])',
            '    immut after = position < count and isWord(chars[position])',
            '',
            '    if (kind == wordBoundary) { return before != after }',
            '',
            '    if (kind == notWordBoundary) { return before == after }',
            '',
            '    if (kind == wordStart) { return not before and after }',
            '',
            '    return before and not after',
            '}',
            '',
            'function isWord(c: char): boolean {',
            '    return inCategory(wordClass, c)',
            '}',
            '',
            '// The methods',
            '',
            '// Whether the pattern matches anywhere in `input`.',
            'function Regex.test(self, input: string): boolean {',
            '    return self.search(input.chars(), 0) is Some',
            '}',
            '',
            '// The first match.',
            'function Regex.find(self, input: string): Option[Match] {',
            '    immut chars = input.chars()',
            '',
            '    return match (self.search(chars, 0)) {',
            '        Some(slots) => Some(matchOf(chars, slots))',
            '        None => None',
            '    }',
            '}',
            '',
            'function matchOf(chars: char[], slots: int[]): Match {',
            '    return { value: piece(chars, slots[0], slots[1]), start: slots[0], end: slots[1] }',
            '}',
            '',
            '// The text of `chars[start..end]` (from the characters: slicing the string would count them from',
            '// its start each time).',
            'function piece(chars: char[], start: int, end: int): string {',
            '    mut text = \'\'',
            '',
            '    for i in range(start, end) {',
            '        text += string(chars[i])',
            '    }',
            '',
            '    return text',
            '}',
            '',
            '// Every match, one after the other: an empty match right after the end of the previous one is',
            '// skipped.',
            'function Regex.matches(self, chars: char[]): int[][] {',
            '    mut found: int[][] = []',
            '    mut position = 0',
            '    mut lastEnd = -1',
            '',
            '    while (position <= chars.length()) {',
            '        immut slots = match (self.search(chars, position)) {',
            '            Some(slots) => slots',
            '            None => break',
            '        }',
            '',
            '        if (slots[0] == slots[1] and slots[1] == lastEnd) {',
            '            position = slots[1] + 1',
            '            continue',
            '        }',
            '',
            '        found.push(slots)',
            '        position = slots[1]',
            '        lastEnd = slots[1]',
            '    }',
            '',
            '    return found',
            '}',
            '',
            '// Every match.',
            'function Regex.findAll(self, input: string): Match[] {',
            '    mut found: Match[] = []',
            '    immut chars = input.chars()',
            '',
            '    for slots in self.matches(chars) {',
            '        found.push(matchOf(chars, slots))',
            '    }',
            '',
            '    return found',
            '}',
            '',
            '// `input` with its first match replaced by `replacement`: `$1` or `${1}` is the text of a group,',
            '// `$name` or `${name}` that of a named group, `$$` a `$`.',
            'function Regex.replace(self, input: string, replacement: string): string {',
            '    immut chars = input.chars()',
            '',
            '    return match (self.search(chars, 0)) {',
            '        Some(slots) => piece(chars, 0, slots[0]) + self.expand(chars, slots, replacement) + piece(chars, slots[1], chars.length())',
            '        None => input',
            '    }',
            '}',
            '',
            '// `input` with every match replaced by `replacement`.',
            'function Regex.replaceAll(self, input: string, replacement: string): string {',
            '    mut out = \'\'',
            '    mut last = 0',
            '    immut chars = input.chars()',
            '',
            '    for slots in self.matches(chars) {',
            '        for i in range(last, slots[0]) {',
            '            out += string(chars[i])',
            '        }',
            '',
            '        out += self.expand(chars, slots, replacement)',
            '        last = slots[1]',
            '    }',
            '',
            '    for i in range(last, chars.length()) {',
            '        out += string(chars[i])',
            '    }',
            '',
            '    return out',
            '}',
            '',
            '// The pieces of `input` between its matches.',
            'function Regex.split(self, input: string): string[] {',
            '    mut pieces: string[] = []',
            '    mut last = 0',
            '    immut chars = input.chars()',
            '',
            '    for slots in self.matches(chars) {',
            '        pieces.push(piece(chars, last, slots[0]))',
            '        last = slots[1]',
            '    }',
            '',
            '    pieces.push(piece(chars, last, chars.length()))',
            '    return pieces',
            '}',
            '',
            '// `replacement` with its `$` references replaced by the groups of a match.',
            'function Regex.expand(self, input: char[], slots: int[], replacement: string): string {',
            '    immut chars = replacement.chars()',
            '    mut out = \'\'',
            '    mut i = 0',
            '',
            '    while (i < chars.length()) {',
            '        immut c = chars[i]',
            '        i += 1',
            '',
            '        if (c != \'$\' or i >= chars.length()) {',
            '            out += string(c)',
            '            continue',
            '        }',
            '',
            '        if (chars[i] == \'$\') {',
            '            out += \'$\'',
            '            i += 1',
            '            continue',
            '        }',
            '',
            '        mut name = \'\'',
            '',
            '        if (chars[i] == \'{\') {',
            '            mut end = i + 1',
            '',
            '            while (end < chars.length() and chars[end] != \'}\') {',
            '                end += 1',
            '            }',
            '',
            '            if (end >= chars.length()) {',
            '                out += \'$\'',
            '                continue',
            '            }',
            '',
            '            name = replacement[i + 1..end]',
            '            i = end + 1',
            '        } else {',
            '            while (i < chars.length() and (chars[i] == \'_\' or isAsciiLetter(chars[i]) or (chars[i] >= \'0\' and chars[i] <= \'9\'))) {',
            '                name += string(chars[i])',
            '                i += 1',
            '            }',
            '',
            '            if (name == \'\') {',
            '                out += \'$\'',
            '                continue',
            '            }',
            '        }',
            '',
            '        out += self.group(input, slots, name)',
            '    }',
            '',
            '    return out',
            '}',
            '',
            '// The text of the group `name` (a number or a name) of a match, or `\'\'`.',
            'function Regex.group(self, input: char[], slots: int[], name: string): string {',
            '    immut index = match (int(name)) {',
            '        Ok(number) => number',
            '        Err(_) => match (self.names.get(name)) {',
            '            Some(found) => found',
            '            None => return \'\'',
            '        }',
            '    }',
            '',
            '    if (index < 0 or index >= self.groups or slots[index * 2] < 0) { return \'\' }',
            '',
            '    return piece(input, slots[index * 2], slots[index * 2 + 1])',
            '}',
            '',
            '// Characters',
            '',
            'function isAsciiLetter(c: char): boolean {',
            '    return (c >= \'a\' and c <= \'z\') or (c >= \'A\' and c <= \'Z\')',
            '}',
            '',
            'function isSpace(c: char): boolean {',
            '    return inCategory(spaceClass, c)',
            '}',
            '',
            'function lowered(c: char): char {',
            '    if (c >= \'A\' and c <= \'Z\') { return charOf(c.code() + 32) }',
            '',
            '    if (c.code() < 128) { return c }',
            '',
            '    immut text = string(c).lower()',
            '    return if (text.length() == 1) { text.chars()[0] } else { c }',
            '}',
            '',
            'function uppered(c: char): char {',
            '    if (c >= \'a\' and c <= \'z\') { return charOf(c.code() - 32) }',
            '',
            '    if (c.code() < 128) { return c }',
            '',
            '    immut text = string(c).upper()',
            '    return if (text.length() == 1) { text.chars()[0] } else { c }',
            '}',
            '',
            'function charOf(code: int): char {',
            '    return match (char(code)) {',
            '        Some(c) => c',
            '        None => \' \'',
            '    }',
            '}',
        ].join('\n'))
    }

    if (name == 'time') {
        return Some([
            '// The `time` module: the clocks of the system, and pauses (see doc/standard-library/time.md).',
            '// Times are in seconds, as decimals, exact to the nanosecond. A timestamp counts the seconds since',
            '// 0000-01-01 00:00:00 UTC, the epoch of Koji (in the proleptic Gregorian calendar).',
            '',
            'import math',
            'import system',
            'import { Address, CInt, allocate, free, read, write } from \'koji:unsafe\'',
            '',
            '// `int clock_gettime(clockid_t clock, struct timespec *time)` and',
            '// `int nanosleep(const struct timespec *request, struct timespec *remaining)`: a `timespec` is two',
            '// 8-byte words, seconds and nanoseconds.',
            'extern function clock_gettime(clock: CInt, time: Address): CInt',
            'extern function nanosleep(request: Address, remaining: Address): CInt',
            '',
            '// The seconds from 0000-01-01 to 1970-01-01, the epoch of Unix and of the clock of the system',
            '// (719,528 days).',
            'immut unixEpoch = 62167219200',
            '',
            '// The current time: the seconds since 0000-01-01 00:00:00 UTC. It follows the clock of the',
            '// system, which may be set back or forth.',
            'export function now(): decimal {',
            '    return clock(0) + unixEpoch',
            '}',
            '',
            '// A time that only grows, for durations: the difference of two is the time between them.',
            'export function monotonic(): decimal {',
            '    // `CLOCK_MONOTONIC` is 6 on macOS, 1 elsewhere.',
            '    immut id = match (system.os) {',
            '        MacOS => 6',
            '        _ => 1',
            '    }',
            '    return clock(id)',
            '}',
            '',
            '// Pauses for `seconds` (nothing for zero or less).',
            'export function sleep(seconds: decimal) {',
            '    if (seconds <= 0) { return }',
            '',
            '    immut whole = math.floor(seconds)',
            '    immut nanoseconds = math.floor((seconds - whole) * 1000000000)',
            '    immut request = allocate(16)',
            '    immut remaining = allocate(16)',
            '    write(request, 0, whole)',
            '    write(request, 8, nanoseconds)',
            '',
            '    // Interrupted by a signal, it goes on with what remains.',
            '    while (nanosleep(request, remaining) != 0) {',
            '        immut seconds: int = read(remaining, 0)',
            '        immut rest: int = read(remaining, 8)',
            '        write(request, 0, seconds)',
            '        write(request, 8, rest)',
            '    }',
            '',
            '    free(request)',
            '    free(remaining)',
            '}',
            '',
            '// The time of a clock of the system, in seconds.',
            'function clock(id: int): decimal {',
            '    immut time = allocate(16)',
            '    clock_gettime(id, time)',
            '    immut seconds: int = read(time, 0)',
            '    immut nanoseconds: int = read(time, 8)',
            '    free(time)',
            '    return decimal(seconds) + decimal(nanoseconds) / 1000000000',
            '}',
        ].join('\n'))
    }

    return None
}
