// The lexer of the Koji compiler: source text to tokens. `kojic dump tokens` prints the text of
// `dump`.

import { hexFloat, hexInt } from 'decimal.kj'

export type Token = {
    Identifier(name: string)
    Int(value: int)
    // A literal with a point or an exponent (`1.5`, `2e3`): a decimal, as written.
    Decimal(text: string)
    // A float in hexadecimal (`0x1.8p1`), exactly the value it writes, and its text.
    Float(value: float, text: string)
    // A number that cannot be one (`0x1.fffffffffffff8p0` has more digits than a float), and why.
    BadNumber(text: string, reason: string)
    StringLiteral(value: string)
    // The text between backticks, with its escapes and `${...}` (the parser splits it).
    TemplateString(raw: string)
    Boolean(value: boolean)
    Keyword(name: string)
    Symbol(text: string)
    Illegal(character: char)
    End
}

// A token and where it starts.
export type Spanned = {
    token: Token
    line: int
    column: int
}

type Lexer = {
    chars: char[]
    position: int
    line: int
    column: int
}

immut keywords = Set.from([
    'var', 'const', 'let', 'immut', 'mut', 'take', 'type', 'interface', 'import', 'export',
    'from', 'if', 'else', 'for', 'in', 'is', 'while', 'function', 'return', 'async', 'await',
    'match', 'default', 'break', 'continue', 'fallthrough', 'and', 'or', 'not'
])

// Symbols of two or three characters, longest first.
immut longSymbols = [
    '**=', '<<=', '>>=', '**', '*=', '==', '=>', '->', '-=', '>=', '>>', '<=', '<<', '!=', '+=', '%=', '/=', '&=',
    '|=', '^=', '..'
]

immut shortSymbols = '+-*/%&|^~=!<>(){}[],.;:?'

function Lexer.create(source: string): Lexer {
    return { chars: source.chars(), position: 0, line: 1, column: 1 }
}

// Whether there is a character `offset` characters after the current one.
function Lexer.has(self, offset: int): boolean {
    return self.position + offset < self.chars.length()
}

// The character `offset` characters after the current one (there must be one).
function Lexer.at(self, offset: int): char {
    return self.chars[self.position + offset]
}

// Whether the character `offset` characters after the current one is `c`.
function Lexer.is(self, offset: int, c: char): boolean {
    return self.has(offset) and self.at(offset) == c
}

function Lexer.advance(mut self) {
    if (self.has(0)) {
        if (self.at(0) == '\n') {
            self.line += 1
            self.column = 1
        } else {
            self.column += 1
        }
    }

    self.position += 1
}

// The character classes follow Unicode; ASCII characters, the most
// common ones, are classified without building a string.
function isSpace(c: char): boolean {
    if (c.code() < 128) { return c == ' ' or (c.code() >= 9 and c.code() <= 13) }

    return string(c).isSpace()
}

function isAsciiLetter(c: char): boolean {
    return (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z')
}

function isDigit(c: char): boolean {
    return c >= '0' and c <= '9'
}

function startsName(c: char): boolean {
    if (c.code() < 128) { return isAsciiLetter(c) or c == '_' }

    return string(c).isAlpha()
}

function continuesName(c: char): boolean {
    if (c.code() < 128) { return isAsciiLetter(c) or isDigit(c) or c == '_' }

    return string(c).isAlphaNumeric()
}

// Skips whitespace and comments.
function Lexer.skipSpace(mut self) {
    while (true) {
        while (self.has(0) and isSpace(self.at(0))) {
            self.advance()
        }

        immut block = self.is(0, '/') and self.is(1, '*')
        immut line = self.is(0, '/') and self.is(1, '/')

        if (not block and not line) { break }

        if (block) {
            self.advance()
            self.advance()

            while (self.has(0) and not (self.is(0, '*') and self.is(1, '/'))) {
                self.advance()
            }

            if (self.has(0)) {
                self.advance()
                self.advance()
            }
        } else {
            while (self.has(0) and not self.is(0, '\n')) {
                self.advance()
            }

            self.advance()
        }
    }
}

function Lexer.name(mut self): Token {
    mut text = ''

    while (self.has(0) and continuesName(self.at(0))) {
        text += string(self.at(0))
        self.advance()
    }

    if (text == 'true' or text == 'false') { return Boolean(text == 'true') }

    if (text in keywords) { return Keyword(text) }

    return Identifier(text)
}

function Lexer.number(mut self): Token {
    if (self.is(0, '0') and (self.is(1, 'x') or self.is(1, 'X')) and self.has(2) and (isHexDigit(self.at(2)) or self.at(2) == '.')) {
        return self.hexNumber()
    }

    mut text = ''
    mut hasDot = false

    while (self.has(0)) {
        immut c = self.at(0)
        immut dot = c == '.' and not hasDot and self.has(1) and isDigit(self.at(1))

        if (not isDigit(c) and not dot) { break }

        if (dot) { hasDot = true }

        text += string(c)
        self.advance()
    }

    // Exponent: `1e308`, `2.5E-3`.
    mut hasExponent = false

    if (self.is(0, 'e') or self.is(0, 'E')) {
        immut digitAt = if (self.is(1, '+') or self.is(1, '-')) { 2 } else { 1 }

        if (self.has(digitAt) and isDigit(self.at(digitAt))) {
            hasExponent = true

            for i in range(digitAt) {
                text += string(self.at(0))
                self.advance()
            }

            while (self.has(0) and isDigit(self.at(0))) {
                text += string(self.at(0))
                self.advance()
            }
        }
    }

    if (not hasDot and not hasExponent) {
        match (int(text)) {
            Ok(n) => return Int(n)
            Err(_) => {}
        }
    }

    return Decimal(text)
}

function isHexDigit(c: char): boolean {
    return isDigit(c) or string(c).lower() in ['a', 'b', 'c', 'd', 'e', 'f']
}

// `0xff`, an int, or `0x1.8p1`, a float: hexadecimal digits, a point, and a power of 2.
function Lexer.hexNumber(mut self): Token {
    mut text = `${self.at(0)}${self.at(1)}`
    self.advance()
    self.advance()
    mut isFloat = false

    while (self.has(0) and (isHexDigit(self.at(0)) or (self.at(0) == '.' and not isFloat))) {
        if (self.at(0) == '.') { isFloat = true }

        text += string(self.at(0))
        self.advance()
    }

    if (self.is(0, 'p') or self.is(0, 'P')) {
        immut digitAt = if (self.is(1, '+') or self.is(1, '-')) { 2 } else { 1 }

        if (self.has(digitAt) and isDigit(self.at(digitAt))) {
            isFloat = true

            for i in range(digitAt) {
                text += string(self.at(0))
                self.advance()
            }

            while (self.has(0) and isDigit(self.at(0))) {
                text += string(self.at(0))
                self.advance()
            }
        }
    }

    if (isFloat) {
        return match (hexFloat(text)) {
            Ok(value) => Float(value, text)
            Err(reason) => BadNumber(text, reason)
        }
    }

    return match (hexInt(text)) {
        Ok(value) => Int(value)
        Err(reason) => BadNumber(text, reason)
    }
}

// The character with code 0, for the escape `\0`.
export function nul(): string {
    return match (char(0)) {
        Some(c) => string(c)
        None => ''
    }
}

function Lexer.text(mut self, quote: char): Token {
    self.advance()
    mut text = ''

    while (self.has(0)) {
        immut c = self.at(0)

        if (c == quote) {
            self.advance()
            break
        }

        if (c == '\\') {
            self.advance()

            if (self.has(0)) {
                immut escaped = self.at(0)
                text += match (escaped) {
                    'n' => '\n'
                    'r' => '\r'
                    't' => '\t'
                    '0' => nul()
                    _ => string(escaped)
                }
                self.advance()
            }
        } else {
            text += string(c)
            self.advance()
        }
    }

    return StringLiteral(text)
}

function Lexer.template(mut self): Token {
    self.advance()
    mut raw = ''

    while (self.has(0)) {
        immut c = self.at(0)

        if (c == '`') {
            self.advance()
            break
        }

        raw += string(c)
        self.advance()

        if (c == '\\' and self.has(0)) {
            raw += string(self.at(0))
            self.advance()
        }
    }

    return TemplateString(raw)
}

// The characters of each long symbol.
immut longSymbolChars = symbolChars()

function symbolChars(): char[][] {
    mut result: char[][] = []

    for symbol in longSymbols {
        result.push(symbol.chars())
    }

    return result
}

// Whether the text at the current position starts with the characters `parts`.
function Lexer.startsWith(self, parts: char[]): boolean {
    for i in range(parts.length()) {
        if (not self.is(i, parts[i])) { return false }
    }

    return true
}

function Lexer.symbol(mut self): Token {
    for i in range(longSymbols.length()) {
        if (self.startsWith(longSymbolChars[i])) {
            for each in longSymbolChars[i] {
                self.advance()
            }

            return Symbol(longSymbols[i])
        }
    }

    immut c = self.at(0)
    self.advance()

    if (c in shortSymbols) { return Symbol(string(c)) }

    return Illegal(c)
}

function Lexer.token(mut self): Token {
    if (not self.has(0)) { return End }

    immut c = self.at(0)

    if (startsName(c)) { return self.name() }

    if (isDigit(c)) { return self.number() }

    if (c == '"' or c == '\'') { return self.text(c) }

    if (c == '`') { return self.template() }

    return self.symbol()
}

// The tokens of `source`, ending with `End`.
export function tokenize(source: string): Spanned[] {
    mut lexer = Lexer.create(source)
    mut tokens: Spanned[] = []

    while (true) {
        lexer.skipSpace()
        immut line = lexer.line
        immut column = lexer.column
        immut token = lexer.token()
        tokens.push({ token: token, line: line, column: column })

        if (token == End) { break }
    }

    return tokens
}

// A token as `kojic dump tokens` prints it: `Identifier count`, `String 'hi'`, `Symbol +=`.
export function dump(token: Token): string {
    return match (token) {
        Identifier(name) => `Identifier ${name}`
        Int(value) => `Int ${value}`
        Decimal(text) => `Decimal ${text}`
        Float(value, _) => `Float ${value}`
        BadNumber(text, _) => `BadNumber ${text}`
        StringLiteral(value) => `String ${value.debug()}`
        TemplateString(raw) => `Template ${raw.debug()}`
        Boolean(value) => `Boolean ${value}`
        Keyword(name) => `Keyword ${name}`
        Symbol(text) => `Symbol ${text}`
        Illegal(c) => `Illegal ${string(c).debug()}`
        End => 'End'
    }
}
