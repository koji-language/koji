// kojic, the Koji compiler, written in Koji. It has no interpreter: `run` compiles the program and
// runs it. It compiles itself: bootstrap/build.sh builds it from the C it generated for itself.

import file
import path
import system
import time
import { tokenize, dump } from 'lexer.kj'
import parser from 'parser.kj'
import { dumpTypes, check, checkLibrary, sourceError } from 'checker.kj'
import { lower, lowerTests } from 'lower.kj'
import { IrExtern, IrProgram, programText } from 'ir.kj'
import { generateNative } from 'native.kj'
import { inlineSmall, targetPlatform } from 'inline.kj'
import { machArchive } from 'macho.kj'
import { Dylib, dylibIdentity, linkMach, machArchiveObjects, tbdIdentity } from 'machlink.kj'
import { archive, archiveNamed, archiveObjects, linkExecutable, sharedName, sharedSymbols } from 'linker.kj'
import { coffGlobals } from 'coff.kj'
import { linkWindows } from 'pelink.kj'
import { serve } from 'lsp.kj'
import { format } from 'format.kj'
import { initModule, addModule, updateModules } from 'packages.kj'

// The version of Koji: of the language, its standard library and this compiler.
immut version = '0.2.1'

immut usage = [
    `kojic ${version} - the Koji programming language (the compiler written in Koji)`,
    '',
    'Usage:',
    '    kojic run <file.kj> [arguments]   check, compile and run a program',
    '    kojic check <file.kj>             only check syntax and types',
    '    kojic test [file.kj | dir]...     run the tests (`test` blocks) of files (default: .)',
    '    kojic fmt [file.kj | dir]...      write files in the style of Koji (default: .)',
    '        --check                       only list the files that are not, and fail if any',
    '    kojic lsp                         a language server for editors (on stdin and stdout)',
    '    kojic build <file.kj> [options]   compile a program to an executable',
    '        -o <output>                   the executable (default: the file name without .kj)',
    '        --emit ir                     write the intermediate representation instead',
    '        --emit object                 write the object file of the native backend instead',
    '    kojic dump tokens <file.kj>       show the tokens of a file (for comparing compilers)',
    '    kojic dump ast <file.kj>          show the syntax tree of a file',
    '    kojic dump types <file.kj>        show what the checker finds (types, moves...)',
    '    kojic dump ir <file.kj>           show the intermediate representation',
    '    kojic dump inlined <file.kj>      the same, as the native backend gets it (inlined)',
    '    kojic dump inlined library        its IR, as the native backend gets it',
    '    kojic init <module>               make a koji.mod for the module (github.com/ana/agenda)',
    '    kojic add <module>[@version]      require a module, at its latest version or the one given',
    '    kojic update [module]             require the latest versions of the modules (or of one)',
    '    kojic version                     show the version of Koji',
    '    kojic help                        show this message',
    '',
    'To build an executable, kojic needs the runtime library (libkoji_runtime.a): next to kojic,',
    'or where the environment variable KOJI_RUNTIME says. KOJI_TARGET compiles for another platform',
    '(x64, arm64, macos-x64, macos-arm64, windows-x64).'
].join('\n')

// The text of a system error (the one of the runtime).
function ioMessage(error: file.FileError): string {
    return match (error) {
        NotFound(_) => 'No such file or directory (os error 2)'
        PermissionDenied(_) => 'Permission denied (os error 13)'
        IsDirectory(_) => 'Is a directory (os error 21)'
        InvalidUtf8(_) => 'the file is not UTF-8'
        Io(_, message) => message
    }
}

function readSource(name: string): Result[string, file.FileError] {
    immut input = file.open(name, file.Read)?
    return input.read()
}

function writeFile(name: string, text: string): Result[void, string] {
    immut written = match (file.open(name, file.Write)) {
        Ok(output) => output.write(text)
        Err(error) => Err(error)
    }

    return match (written) {
        Ok(_) => Ok()
        Err(error) => Err(`compile error: cannot write '${name}': ${ioMessage(error)}`)
    }
}

// The lines of a text, ending with a line break.
function text(lines: string[]): string {
    return `${lines.join('\n')}\n`
}

// The checked and lowered program in `name`.
function lowered(name: string): Result[IrProgram, string] {
    return lower(check(name)?)
}

// `kojic dump <stage> <file.kj>`: the text each stage gives, as `kojic dump` prints it.
function dumpStage(stage: string, name: string) {
    match (stage) {
        'types' => {
            for line in dumpTypes(name) {
                print(line)
            }

            return
        }
        'ir' => {
            match (lowered(name)) {
                Ok(program) => print(programText(program).join('\n'))
                Err(message) => print(`error: ${message.split('\n')[0]}`)
            }

            return
        }
        // The IR the native backend generates code from: small functions inlined (inline.kj).
        'inlined' => {
            match (lowered(name)) {
                Ok(program) => print(programText(inlineSmall(program)).join('\n'))
                Err(message) => print(`error: ${message.split('\n')[0]}`)
            }

            return
        }
        _ => {}
    }

    immut source = match (readSource(name)) {
        Ok(source) => source
        Err(error) => {
            printError(sourceError(name, error))
            system.exit(1)
        }
    }

    if (stage == 'tokens') {
        for spanned in tokenize(source) {
            print(`${spanned.line}:${spanned.column} ${dump(spanned.token)}`)
        }

        return
    }

    match (parser.parse(source)) {
        Ok(statements) => {
            for statement in statements {
                print(parser.dump(statement))
            }
        }
        Err(message) => print(`error: syntax error: ${message}`)
    }
}

// What `kojic build` writes.
type Build = {
    source: string
    output: string
    // 'executable', 'c' or 'ir'.
    emit: string
}

// The options of `kojic build <file.kj> [-o <output>] [--emit c|ir|object]`.
function buildOptions(args: string[]): Build {
    mut source: Option[string] = None
    mut output: Option[string] = None
    mut emit = 'executable'
    mut i = 0

    while (i < args.length()) {
        immut arg = args[i]
        i += 1

        if (arg == '-o' and i < args.length()) {
            output = Some(args[i])
            i += 1
            continue
        }

        // The native backend (compiler/native.kj): the only one (as before, for scripts).
        if (arg == '--native') {
            emit = 'native'
            continue
        }

        if (arg == '--emit') {
            if (i < args.length() and (args[i] == 'ir' or args[i] == 'object')) {
                emit = args[i]
                i += 1
                continue
            }

            printError(`--emit takes 'ir' or 'object'\n\n${usage}`)

            system.exit(2)
        }

        if (source is None and not arg.startsWith('-')) {
            source = Some(arg)
            continue
        }

        printError(usage)

        system.exit(2)
    }

    immut name = match (source) {
        Some(name) => name
        None => {
            printError(usage)
            system.exit(2)
        }
    }
    immut stem = match (path.stem(name)) {
        Some(stem) => stem
        None => ''
    }
    immut chosen = match (output) {
        Some(chosen) => chosen
        None => match (emit) {
            'ir' => `${stem}.ir`
            _ => stem
        }
    }
    return { source: name, output: chosen, emit: emit }
}

// The libraries of the system that programs link besides the C library: the threads that help
// tasks with the calls that block (in the C library itself on recent systems). The mathematics of
// floats is Koji's own (std/koji/floats.kj).
function systemLibraries(): string[] {
    return ['-lpthread']
}

function variable(name: string, otherwise: string): string {
    return match (system.env(name)) {
        Some(value) => value
        None => otherwise
    }
}

// A new path in the temporary directory, ending with `extension`: named after the time, with a
// number after it if that name is taken.
function temporary(extension: string): string {
    // TMPDIR; on Windows, TEMP or TMP (which have no /tmp).
    immut fallback = if (system.os == system.Windows) { variable('TEMP', variable('TMP', '.')) } else { '/tmp' }
    immut directory = variable('TMPDIR', fallback)
    immut unique = string(time.now()).replace('.', '')
    mut name = path.join(directory, `kojic-${unique}${extension}`)
    mut count = 1

    while (file.exists(name)) {
        name = path.join(directory, `kojic-${unique}-${count}${extension}`)
        count += 1
    }

    return name
}

// The runtime library: where KOJI_RUNTIME says, or next to kojic (`bootstrap/build.sh` puts them
// together).
function runtimeLibrary(): Option[string] {
    match (system.env('KOJI_RUNTIME')) {
        Some(runtime) => return Some(runtime)
        None => {}
    }

    immut directory = match (system.executable()) {
        Some(executable) => path.parent(executable)
        None => None
    }

    return match (directory) {
        Some(folder) => {
            immut library = path.join(folder, 'libkoji_runtime.a')
            if (file.exists(library)) { Some(library) } else { None }
        }
        None => None
    }
}

// The executable of the machine code of the native backend: its object file, linked with the runtime
// by the linker of the system (the C compiler only links: there is no C).
function linkNative(program: IrProgram, output: string): Result[void, string] {
    immut object = match (generateNative(program)) {
        Ok(bytes) => bytes
        Err(message) => return Err(`compile error: ${message}`)
    }
    immut runtime = match (runtimeLibrary()) {
        Some(runtime) => runtime
        None => return Err('compile error: the runtime library (libkoji_runtime.a) is not next to kojic: set KOJI_RUNTIME to its path')
    }

    // Koji's linker (linker.kj, machlink.kj, pelink.kj), with the shared libraries of the blocks
    // `foreign`; the system's (KOJI_CC) when it cannot link the objects (KOJI_LINKER=koji to see
    // why: a library found only as an archive, say), or with KOJI_LINKER=system.
    immut chosen = variable('KOJI_LINKER', '')

    // The libraries it links always (the C library, its mathematics and its threads) may be named.
    mut foreign: string[] = []

    for library in program.libraries {
        if (not (library in ['c', 'm', 'pthread'])) { foreign.push(library) }
    }

    // For macOS, its linker of Mach-O (machlink.kj), with the dynamic libraries of the blocks
    // `foreign` (`foreign 'sqlite3'`: libsqlite3.dylib, its file or its stub in the SDK).
    if (chosen != 'system' and targetPlatform() / 3 == 1) {
        match (linkMachOwn(object, runtime, output, program.externs, foreign)) {
            Ok(_) => return Ok()
            Err(message) => {
                if (chosen == 'koji') { return Err(`compile error: ${message}`) }
            }
        }
    }

    // For Windows, its linker of PE (pelink.kj), the only one: the functions of a block `foreign`
    // from the DLL of its library (`foreign 'user32'`: user32.dll).
    if (targetPlatform() / 3 == 2) {
        mut dlls: Map[string, string] = [:]

        for each in program.externs {
            if (each.library == '' or each.library in ['c', 'm', 'pthread']) { continue }

            dlls[each.symbol] = if (each.library.lower().endsWith('.dll')) { each.library } else { `${each.library}.dll` }
        }

        return linkWindowsOwn(object, runtime, output, dlls)
    }

    if (chosen != 'system' and targetPlatform() / 3 != 1) {
        match (linkOwn(object, runtime, output, foreign)) {
            Ok(_) => return Ok()
            Err(message) => {
                if (chosen == 'koji') { return Err(`compile error: ${message}`) }
            }
        }
    }

    immut objectPath = temporary('.o')

    match (writeBytes(objectPath, object)) {
        Ok(_) => {}
        Err(message) => return Err(message)
    }

    immut linker = variable('KOJI_CC', 'cc')
    mut args = ['-o', output, objectPath, runtime]

    for library in program.libraries {
        args.push(`-l${library}`)
    }

    for library in systemLibraries() {
        args.push(library)
    }

    immut result = system.capture(linker, args)
    file.remove(objectPath)

    return match (result) {
        Ok(run) => if (run.status == 0) { Ok() } else { Err(`compile error: the linker '${linker}' failed:\n${run.stderr.trim()}`) }
        Err(_) => Err(`compile error: cannot run the linker '${linker}' (set KOJI_CC to choose another one)`)
    }
}

// The executable of the object of a program and of the runtime library, by Koji's linker, with the
// libraries of C of the system: the C library and its mathematics (and its threads, on systems
// where they are a library of their own).
// A program for macOS by Koji's linker of Mach-O: the object and those of the archive of the
// runtime, with the dynamic libraries of `foreign` and the functions each gives.
function linkMachOwn(object: byte[], runtime: string, output: string, externs: IrExtern[], foreign: string[]): Result[void, string] {
    immut cpu = if (targetPlatform() == 4) { 0x0100000C } else { 0x01000007 }
    mut libraries: Dylib[] = []
    mut libraryOf: Map[string, int] = [:]

    for name in foreign {
        libraries.push(machLibrary(name, cpu)?)
    }

    for each in externs {
        match (foreign.indexOf(each.library)) {
            Some(index) => libraryOf[`_${each.symbol}`] = index
            None => {}
        }
    }

    immut library = match (file.open(runtime, file.Read)) {
        Ok(opened) => match (opened.readBytes()) {
            Ok(bytes) => bytes
            Err(error) => return Err(`cannot read '${runtime}': ${ioMessage(error)}`)
        }
        Err(error) => return Err(`cannot read '${runtime}': ${ioMessage(error)}`)
    }
    mut objects = [object]

    for member in machArchiveObjects(library)? {
        objects.push(member)
    }

    immut executable = linkMach(objects, libraries, libraryOf)?
    writeBytes(output, executable)?
    return match (file.setPermissions(output, 0x1ED)) {
        Ok(_) => Ok()
        Err(error) => Err(`cannot make '${output}' executable: ${ioMessage(error)}`)
    }
}

// The dynamic library of a block `foreign` for macOS: its file (libsqlite3.dylib, in LIBRARY_PATH
// or where Homebrew and others put them), or its stub in the SDK of macOS for a library of the
// system (libz.tbd), whose file is in the cache of the dynamic loader.
function machLibrary(name: string, cpu: int): Result[Dylib, string] {
    mut directories: string[] = []

    match (system.env('LIBRARY_PATH')) {
        Some(paths) => {
            for each in paths.split(':') {
                if (each != '') { directories.push(each) }
            }
        }
        None => {}
    }

    for directory in directories + ['/opt/homebrew/lib', '/usr/local/lib', '/usr/lib'] {
        immut found = path.join(directory, `lib${name}.dylib`)

        if (not file.exists(found)) { continue }

        match (file.open(found, file.Read)) {
            Ok(opened) => match (opened.readBytes()) {
                Ok(bytes) => match (dylibIdentity(bytes, cpu)) {
                    Some(identity) => return Ok(identity)
                    None => {}
                }
                Err(_) => {}
            }
            Err(_) => {}
        }
    }

    mut sdks: string[] = []

    match (system.env('SDKROOT')) {
        Some(root) => sdks.push(root)
        None => {}
    }

    sdks += ['/Library/Developer/CommandLineTools/SDKs/MacOSX.sdk', '/Applications/Xcode.app/Contents/Developer/Platforms/MacOSX.platform/Developer/SDKs/MacOSX.sdk']

    // Where the tools of Xcode say it is, last (a process: only when the others have no stub).
    if (system.os == system.MacOS) {
        match (system.capture('xcrun', ['--show-sdk-path'])) {
            Ok(found) => if (found.status == 0 and found.stdout.trim() != '') { sdks.push(found.stdout.trim()) }
            Err(_) => {}
        }
    }

    for sdk in sdks {
        immut stub = path.join(sdk, `usr/lib/lib${name}.tbd`)

        if (not file.exists(stub)) { continue }

        match (file.open(stub, file.Read)) {
            Ok(opened) => match (opened.read()) {
                Ok(text) => match (tbdIdentity(text)) {
                    Some(identity) => return Ok(identity)
                    None => {}
                }
                Err(_) => {}
            }
            Err(_) => {}
        }
    }

    return Err(`cannot find the dynamic library of 'foreign \'${name}\'' (lib${name}.dylib)`)
}

function linkWindowsOwn(object: byte[], runtime: string, output: string, dlls: Map[string, string]): Result[void, string] {
    immut library = match (file.open(runtime, file.Read)) {
        Ok(opened) => match (opened.readBytes()) {
            Ok(bytes) => bytes
            Err(error) => return Err(`cannot read '${runtime}': ${ioMessage(error)}`)
        }
        Err(error) => return Err(`cannot read '${runtime}': ${ioMessage(error)}`)
    }
    mut objects = [object]

    for member in archiveObjects(library)? {
        objects.push(member)
    }

    immut executable = match (linkWindows(objects, dlls)) {
        Ok(bytes) => bytes
        Err(message) => return Err(`compile error: ${message}`)
    }
    return writeBytes(output, executable)
}

// The shared library of a block `foreign` (`foreign 'sqlite3'`: libsqlite3.so, in the directories of
// libraries of the system or of LIBRARY_PATH), through the script of the linker it may be (as
// libc.so is): its path, or '' when there is none.
function sharedLibrary(name: string, directories: string[]): string {
    mut all = directories

    match (system.env('LIBRARY_PATH')) {
        Some(paths) => {
            for each in paths.split(':') {
                if (each != '') { all.push(each) }
            }
        }
        None => {}
    }

    for directory in all + ['/usr/local/lib'] {
        immut found = path.join(directory, `lib${name}.so`)

        if (not file.exists(found)) { continue }

        immut bytes = match (file.open(found, file.Read)) {
            Ok(opened) => match (opened.readBytes()) {
                Ok(read) => read
                Err(_) => continue
            }
            Err(_) => continue
        }

        if (bytes.length() >= 4 and bytes[0] == 0x7F and bytes[1] == 0x45) { return found }

        // A script: the first path of a shared library it names.
        match (file.open(found, file.Read)) {
            Ok(opened) => match (opened.read()) {
                Ok(text) => {
                    for word in text.replace('(', ' ').replace(')', ' ').replace('\n', ' ').split(' ') {
                        if (word.startsWith('/') and '.so' in word and file.exists(word)) { return word }
                    }
                }
                Err(_) => {}
            }
            Err(_) => {}
        }
    }

    return ''
}

function linkOwn(object: byte[], runtime: string, output: string, foreign: string[]): Result[void, string] {
    immut library = match (file.open(runtime, file.Read)) {
        Ok(opened) => match (opened.readBytes()) {
            Ok(bytes) => bytes
            Err(error) => return Err(`cannot read '${runtime}': ${ioMessage(error)}`)
        }
        Err(error) => return Err(`cannot read '${runtime}': ${ioMessage(error)}`)
    }
    mut objects = [object]

    for member in archiveObjects(library)? {
        objects.push(member)
    }

    // The libraries, and the symbols they define (found in the directories of libraries of the
    // system).
    mut libraries: string[] = []
    mut provided: Set[string] = Set.from([])
    mut unchecked = false

    for name in ['libc.so.6', 'libpthread.so.0'] {
        mut found = ''

        // Those of arm64 (on another system, those of its tools for arm64), or of x86-64.
        immut directories = if (targetPlatform() == 1) { ['/lib/aarch64-linux-gnu', '/usr/lib/aarch64-linux-gnu', '/usr/aarch64-linux-gnu/lib'] } else { ['/lib/x86_64-linux-gnu', '/usr/lib/x86_64-linux-gnu', '/lib64', '/usr/lib64', '/lib', '/usr/lib'] }

        for directory in directories {
            if (found == '' and file.exists(path.join(directory, name))) { found = path.join(directory, name) }
        }

        // The threads may be in the C library itself (glibc 2.34 and later). Libraries that are
        // not here (those of another processor, when Koji builds for it): named all the same, and
        // the symbols the program needs from them left to the dynamic loader to find.
        if (found == '') {
            if (name != 'libpthread.so.0') {
                libraries.push(name)
                unchecked = true
            }

            continue
        }

        immut bytes = match (file.open(found, file.Read)) {
            Ok(opened) => match (opened.readBytes()) {
                Ok(read) => read
                Err(error) => return Err(`cannot read '${found}': ${ioMessage(error)}`)
            }
            Err(error) => return Err(`cannot read '${found}': ${ioMessage(error)}`)
        }

        for symbol in sharedSymbols(bytes)? {
            provided.add(symbol)
        }

        libraries.push(name)
    }

    // The libraries of the blocks `foreign`, by their names for the dynamic loader.
    immut systemDirectories = if (targetPlatform() == 1) { ['/lib/aarch64-linux-gnu', '/usr/lib/aarch64-linux-gnu', '/usr/aarch64-linux-gnu/lib'] } else { ['/lib/x86_64-linux-gnu', '/usr/lib/x86_64-linux-gnu', '/lib64', '/usr/lib64', '/lib', '/usr/lib'] }

    for name in foreign {
        immut found = sharedLibrary(name, systemDirectories)

        if (found == '') { return Err(`cannot find the shared library of 'foreign \'${name}\'' (lib${name}.so)`) }

        immut bytes = match (file.open(found, file.Read)) {
            Ok(opened) => match (opened.readBytes()) {
                Ok(read) => read
                Err(error) => return Err(`cannot read '${found}': ${ioMessage(error)}`)
            }
            Err(error) => return Err(`cannot read '${found}': ${ioMessage(error)}`)
        }

        for symbol in sharedSymbols(bytes)? {
            provided.add(symbol)
        }

        immut soname = sharedName(bytes)
        immut needed = if (soname != '') { soname } else { match (path.name(found)) {
            Some(file) => file
            None => found
        } }

        if (not (needed in libraries)) { libraries.push(needed) }
    }

    immut executable = linkExecutable(objects, libraries, provided, unchecked)?
    writeBytes(output, executable)?

    return match (file.setPermissions(output, 0x1ED)) {
        Ok(_) => Ok()
        Err(error) => Err(`cannot make '${output}' executable: ${ioMessage(error)}`)
    }
}

function buildLibrary(output: string): Result[void, string] {
    immut checked = checkLibrary()?
    immut lowered = lower(checked)?
    immut object = match (generateNative(lowered)) {
        Ok(bytes) => bytes
        Err(message) => return Err(`compile error: ${message}`)
    }
    // An archive of the object, with the table of its symbols (linker.kj).
    // For macOS, an archive of BSD (its linker reads no other).
    // For Windows, the table of the symbols of its object of COFF.
    if (targetPlatform() / 3 == 2) { return writeBytes(output, archiveNamed([object], [coffGlobals(object)])) }

    return writeBytes(output, if (targetPlatform() / 3 == 1) { machArchive([object]) } else { archive([object]) })
}

function writeBytes(name: string, bytes: byte[]): Result[void, string] {
    return match (writeBytesTo(name, bytes)) {
        Ok(_) => Ok()
        Err(error) => Err(`compile error: cannot write '${name}': ${ioMessage(error)}`)
    }
}

function writeBytesTo(name: string, bytes: byte[]): Result[void, file.FileError] {
    immut out = file.open(name, file.Write)?
    return out.writeBytes(bytes)
}

// Whether the native backend generates the code of this platform.
function nativeHere(): boolean {
    return match (system.os) {
        Linux => system.architecture == system.X64 or system.architecture == system.Arm64
        MacOS => system.architecture == system.X64 or system.architecture == system.Arm64
        Windows => system.architecture == system.X64
        _ => false
    }
}

// The executable of a program, by the backend of the platform.
function executable(program: IrProgram, output: string): Result[void, string] {
    if (not nativeHere()) { return Err('compile error: Koji builds executables for Linux, macOS and Windows on x86-64 and arm64 (Windows on x86-64 only): set KOJI_TARGET to one of them') }

    return linkNative(program, output)
}

// `kojic build`: the executable, the C or the IR of a program.
function build(args: string[]) {
    immut options = buildOptions(args)
    immut program = match (lowered(options.source)) {
        Ok(program) => program
        Err(message) => {
            printError(message)
            system.exit(1)
        }
    }
    immut result = match (options.emit) {
        'ir' => writeFile(options.output, text(programText(program)))
        'native' => linkNative(program, options.output)
        'object' => match (generateNative(program)) {
            Ok(bytes) => writeBytes(options.output, bytes)
            Err(message) => Err(`compile error: ${message}`)
        }
        _ => executable(program, options.output)
    }

    match (result) {
        Ok(_) => {}
        Err(message) => {
            printError(message)
            system.exit(1)
        }
    }
}

// `kojic run <file.kj> [arguments]`: compiles the program to a temporary executable, runs it with
// the arguments and the terminal of kojic, and ends with its exit code.
function runProgram(args: string[]) {
    immut program = match (lowered(args[0])) {
        Ok(program) => program
        Err(message) => {
            printError(message)
            system.exit(1)
        }
    }
    immut built = temporary(if (system.os == system.Windows) { '.exe' } else { '' })

    match (executable(program, built)) {
        Ok(_) => {}
        Err(message) => {
            printError(message)
            system.exit(1)
        }
    }

    immut code = match (system.run(built, args[1..])) {
        Ok(code) => code
        Err(error) => {
            printError(`cannot run the program: ${error}`)
            1
        }
    }
    file.remove(built)
    // A program stopped by a signal has no exit code.
    system.exit(if (code < 0) { 1 } else { code })
}

// The `.kj` files of `name`: itself, or those of a directory and its directories (sorted; those
// whose names start with a dot left out).
function sourceFiles(name: string, mut files: string[]) {
    match (file.list(name)) {
        Ok(entries) => {
            for entry in entries {
                if (entry.startsWith('.')) { continue }

                immut inner = path.join(name, entry)

                if (entry.endsWith('.kj')) {
                    if (file.list(inner) is Err) { files.push(inner) }
                } else {
                    if (file.list(inner) is Ok) { sourceFiles(inner, mut files) }
                }
            }
        }
        Err(_) => files.push(name)
    }
}

// Whether a file has tests: `test 'name' { ... }` at its top level (a syntax error is found when
// it is checked).
function hasTests(source: string): boolean {
    match (parser.parse(source)) {
        Ok(statements) => {
            for statement in statements {
                match (unlocatedDeclaration(statement)) {
                    Some(name) => {
                        if (parser.isTestName(name)) { return true }
                    }
                    None => {}
                }
            }

            return false
        }
        Err(_) => return true
    }
}

// The name of a function declared by a statement.
function unlocatedDeclaration(node: parser.Node): Option[string] {
    return match (node.kind) {
        Located(_, inner) => unlocatedDeclaration(inner)
        FunctionDecl(name, _, _, _, _, _) => Some(name)
        _ => None
    }
}

// The name of a test as written, from the name of its function (`test 'it\'s'` is `it's`).
function testDisplay(name: string): string {
    immut chars = name.chars()
    mut text = ''
    mut i = 6

    while (i < chars.length() - 1) {
        mut c = chars[i]

        if (c == '\\' and i + 1 < chars.length() - 1) {
            i += 1
            c = match (chars[i]) {
                'n' => '\n'
                't' => '\t'
                'r' => '\r'
                other => other
            }
        }

        text += string(c)
        i += 1
    }

    return text
}

// A text indented by four spaces, line by line (the line breaks at its end left out).
function indented(text: string): string {
    mut lines: string[] = []

    mut end = text.length()

    while (end > 0 and (text[end - 1] == '\n' or text[end - 1] == '\r')) {
        end -= 1
    }

    for line in text[..end].split('\n') {
        lines.push(`    ${line}`)
    }

    return lines.join('\n')
}

// Seconds with two decimals (`0.25`).
function secondsText(seconds: decimal): string {
    immut hundredths = int(seconds * 100)
    immut rest = hundredths % 100
    return `${hundredths / 100}.${if (rest < 10) { '0' } else { '' }}${rest}`
}

// `kojic test [paths]`: the tests of each file, each in a process of its own (the file's top-level
// statements first, as an import runs them), so that a failure or a panic stops only its test and
// each one starts from the same state. The output of a test is shown when it fails.
function testCommand(args: string[]) {
    immut started = time.monotonic()
    mut files: string[] = []

    immut paths = if (args.length() == 0) { ['.'] } else { args }

    for each in paths {
        sourceFiles(each, mut files)
    }

    mut passed = 0
    mut failed = 0
    mut broken = 0

    for name in files {
        immut source = match (readSource(name)) {
            Ok(text) => text
            Err(error) => {
                print(`FAIL  ${name}: cannot read it: ${ioMessage(error)}`)
                broken += 1
                continue
            }
        }

        if (not hasTests(source)) { continue }

        immut program = match (check(name)) {
            Ok(checked) => lowerTests(checked)
            Err(message) => Err(message)
        }
        immut lowered = match (program) {
            Ok(found) => found
            Err(message) => {
                print(`FAIL  ${name}\n${indented(message)}`)
                broken += 1
                continue
            }
        }
        immut built = temporary(if (system.os == system.Windows) { '.exe' } else { '' })

        match (executable(lowered, built)) {
            Ok(_) => {}
            Err(message) => {
                print(`FAIL  ${name}\n${indented(message)}`)
                broken += 1
                continue
            }
        }

        for i in range(lowered.tests.length()) {
            immut title = `${name}: ${testDisplay(lowered.tests[i].name)}`

            match (system.capture(built, [string(i)])) {
                Ok(run) => {
                    if (run.status == 0) {
                        print(`ok    ${title}`)
                        passed += 1
                    } else {
                        print(`FAIL  ${title}`)

                        if (run.stderr.trim() != '') { print(indented(run.stderr)) }

                        if (run.stdout.trim() != '') { print(`    output:\n${indented(indented(run.stdout))}`) }

                        if (run.status < 0) { print('    stopped by a signal') }

                        failed += 1
                    }
                }
                Err(error) => {
                    print(`FAIL  ${title}: cannot run it: ${error}`)
                    failed += 1
                }
            }
        }

        file.remove(built)
    }

    immut seconds = time.monotonic() - started
    mut summary = `${passed} passed, ${failed} failed`

    if (broken > 0) { summary += `, ${broken} ${if (broken == 1) { 'file' } else { 'files' }} not built` }

    if (passed + failed + broken == 0) { summary = 'no tests found' }

    print(`\n${summary} (${secondsText(seconds)} s)`)
    system.exit(if (failed + broken > 0) { 1 } else { 0 })
}

// The .kj files of a directory and of the directories in it, but those whose names start with a dot.
function sourcesIn(directory: string): string[] {
    mut found: string[] = []

    match (file.list(directory)) {
        Ok(names) => {
            for name in names {
                if (name.startsWith('.')) { continue }

                immut inner = path.join(directory, name)

                if (name.endsWith('.kj')) {
                    if (file.list(inner) is Err) { found.push(inner) }

                    continue
                }

                if (file.list(inner) is Ok) { found += sourcesIn(inner) }
            }
        }
        Err(_) => {}
    }

    return found
}

function writeSource(name: string, text: string): Result[void, string] {
    return match (file.open(name, file.Write)) {
        Ok(opened) => match (opened.write(text)) {
            Ok(_) => Ok()
            Err(error) => Err(ioMessage(error))
        }
        Err(error) => Err(ioMessage(error))
    }
}

// `kojic fmt [--check] [file.kj | dir]...`: the files written again in the style of Koji (see
// compiler/format.kj), or, with --check, only listed when they are not in it.
function formatCommand(given: string[]) {
    mut check = false
    mut targets: string[] = []

    for arg in given {
        if (arg == '--check') {
            check = true
            continue
        }

        targets.push(arg)
    }

    if (targets.length() == 0) { targets.push('.') }

    mut files: string[] = []

    for target in targets {
        if (target.endsWith('.kj') and file.list(target) is Err) {
            files.push(target)
            continue
        }

        if (file.list(target) is Err) {
            printError(`${target}: no such file or directory`)
            system.exit(1)
        }

        files += sourcesIn(target)
    }

    mut failed = 0
    mut unformatted = 0

    for name in files {
        immut source = match (readSource(name)) {
            Ok(text) => text
            Err(error) => {
                printError(sourceError(name, error))
                failed += 1
                continue
            }
        }
        immut formatted = match (format(source)) {
            Ok(text) => text
            Err(message) => {
                printError(`${name}: ${message}`)
                failed += 1
                continue
            }
        }

        if (formatted == source) { continue }

        unformatted += 1

        if (check) {
            print(name)
            continue
        }

        match (writeSource(name, formatted)) {
            Ok(_) => print(name)
            Err(message) => {
                printError(`${name}: ${message}`)
                failed += 1
            }
        }
    }

    system.exit(if (failed > 0 or (check and unformatted > 0)) { 1 } else { 0 })
}

immut args = system.args()
immut command = if (args.length() > 0) { args[0] } else { '' }

if (command == 'fmt') { formatCommand(args[1..]) }

if (command == 'test') { testCommand(args[1..]) }

// The commands of packages (compiler/packages.kj).
if (command in ['init', 'add', 'update'] and args.length() <= 2 and (args.length() == 2 or command == 'update')) {
    immut done = match (command) {
        'init' => initModule(args[1])
        'add' => addModule(args[1])
        _ => updateModules(if (args.length() == 2) { Some(args[1]) } else { None })
    }

    match (done) {
        Ok(message) => print(message)
        Err(message) => {
            printError(`package error: ${message}`)
            system.exit(1)
        }
    }

    system.exit(0)
}

if (command == 'lsp' and args.length() == 1) { serve() }

if (command == 'build') {
    build(args[1..])
    system.exit(0)
}

// `kojic library -o libkoji_runtime.a`: the runtime library, built natively (see "The library of the
// runtime built by the compiler" in doc/internals.md): the machine code of std/koji/ (but `koji:core`),
// with `koji:prelude` and the code the backend writes for the runtime, alone in an archive.
if (command == 'library' and args.length() == 3 and args[1] == '-o') {
    match (buildLibrary(args[2])) {
        Ok(_) => {}
        Err(message) => {
            printError(message)
            system.exit(1)
        }
    }

    system.exit(0)
}

// The IR of std/koji/ as the native backend gets it (`kojic library`).
if (command == 'dump' and args.length() == 3 and args[1] == 'inlined' and args[2] == 'library') {
    match (checkLibrary()) {
        Ok(program) => match (lower(program)) {
            Ok(lowered) => print(programText(inlineSmall(lowered)).join('\n'))
            Err(message) => printError(message)
        }
        Err(message) => printError(message)
    }

    system.exit(0)
}

if (command == 'dump' and args.length() == 3 and args[1] in ['tokens', 'ast', 'types', 'ir', 'inlined']) {
    dumpStage(args[1], args[2])
    system.exit(0)
}

if (command == 'check' and args.length() == 2) {
    match (check(args[1])) {
        Ok(_) => system.exit(0)
        Err(message) => {
            printError(message)
            system.exit(1)
        }
    }
}

if (args.length() == 1 and command in ['version', '--version', '-V']) {
    print(`kojic ${version}`)
    system.exit(0)
}

if (args.length() == 1 and command in ['help', '--help', '-h']) {
    print(usage)
    system.exit(0)
}

if (command == 'run' and args.length() >= 2) { runProgram(args[1..]) }

if (args.length() == 1 and command.endsWith('.kj')) {
    printError(`use 'kojic run ${command}' to run a program\n\n${usage}`)
    system.exit(2)
}

printError(usage)

system.exit(2)
