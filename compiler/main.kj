// kojic, the Koji compiler, written in Koji. It has no interpreter: `run` compiles the program and
// runs it. It compiles itself: bootstrap/build.sh builds it from the C it generated for itself.

import file
import path
import system
import time
import { tokenize, dump } from 'lexer.kj'
import parser from 'parser.kj'
import { dumpTypes, check, checkLibrary, Program } from 'checker.kj'
import { lower, lowerTests } from 'lower.kj'
import { IrProgram, programText } from 'ir.kj'
import { generate } from 'cgen.kj'
import { generateNative } from 'native.kj'
import { serve } from 'lsp.kj'
import { initModule, addModule, updateModules } from 'packages.kj'

immut usage = [
    'kojic - the Koji programming language (the compiler written in Koji)',
    '',
    'Usage:',
    '    kojic run <file.kj> [arguments]   check, compile and run a program',
    '    kojic check <file.kj>             only check syntax and types',
    '    kojic test [file.kj | dir]...     run the tests (`test` blocks) of files (default: .)',
    '    kojic lsp                         a language server for editors (on stdin and stdout)',
    '    kojic build <file.kj> [options]   compile a program to an executable',
    '        -o <output>                   the executable (default: the file name without .kj)',
    '        --emit c                      write the generated C instead',
    '        --emit ir                     write the intermediate representation instead',
    '        --native                      generate the machine code itself (x86-64 Linux; slower code yet)',
    '    kojic dump tokens <file.kj>       show the tokens of a file (for comparing compilers)',
    '    kojic dump ast <file.kj>          show the syntax tree of a file',
    '    kojic dump types <file.kj>        show what the checker finds (types, moves...)',
    '    kojic dump ir <file.kj>           show the intermediate representation',
    '    kojic dump c <file.kj>            show the generated C',
    '    kojic dump library                show the C of the library of the runtime written in Koji',
    '    kojic init <module>               make a koji.mod for the module (github.com/ana/agenda)',
    '    kojic add <module>[@version]      require a module, at its latest version or the one given',
    '    kojic update [module]             require the latest versions of the modules (or of one)',
    '    kojic help                        show this message',
    '',
    'To build an executable, kojic needs the runtime library (libkoji_runtime.a): next to kojic,',
    'or where the environment variable KOJI_RUNTIME says. KOJI_CC names the C compiler (default: cc).'
].join('\n')

// The text of a system error (the one of the runtime).
function ioMessage(error: file.FileError): string {
    return match (error) {
        NotFound(_) => 'No such file or directory (os error 2)'
        PermissionDenied(_) => 'Permission denied (os error 13)'
        IsDirectory(_) => 'Is a directory (os error 21)'
        InvalidUtf8(_) => 'stream did not contain valid UTF-8'
        Io(_, message) => message
    }
}

function readSource(name: string): Result[string, file.FileError] {
    immut input = file.open(name, file.Read)?
    return input.read()
}

function writeFile(name: string, text: string): Result[void, string] {
    immut written = match (file.open(name, file.Write)) {
        Ok(output) => output.write(text)
        Err(error) => Err(error)
    }

    return match (written) {
        Ok(_) => Ok()
        Err(error) => Err(`compile error: cannot write '${name}': ${ioMessage(error)}`)
    }
}

// The lines of a text, ending with a line break.
function text(lines: string[]): string {
    return `${lines.join('\n')}\n`
}

// The checked and lowered program in `name`.
function lowered(name: string): Result[IrProgram, string] {
    return lower(check(name)?)
}

// `kojic dump <stage> <file.kj>`: the text each stage gives, as `kojic dump` prints it.
function dumpStage(stage: string, name: string) {
    match (stage) {
        'types' => {
            for line in dumpTypes(name) {
                print(line)
            }

            return
        }
        'ir' => {
            match (lowered(name)) {
                Ok(program) => print(programText(program).join('\n'))
                Err(message) => print(`error: ${message.split('\n')[0]}`)
            }

            return
        }
        'c' => {
            match (lowered(name)) {
                Ok(program) => print(generate(program).join('\n'))
                Err(message) => print(`error: ${message.split('\n')[0]}`)
            }

            return
        }
        _ => {}
    }

    immut source = match (readSource(name)) {
        Ok(source) => source
        Err(error) => {
            printError(`cannot read '${name}': ${ioMessage(error)}`)
            system.exit(1)
        }
    }

    if (stage == 'tokens') {
        for spanned in tokenize(source) {
            print(`${spanned.line}:${spanned.column} ${dump(spanned.token)}`)
        }

        return
    }

    match (parser.parse(source)) {
        Ok(statements) => {
            for statement in statements {
                print(parser.dump(statement))
            }
        }
        Err(message) => print(`error: syntax error: ${message}`)
    }
}

// What `kojic build` writes.
type Build = {
    source: string
    output: string
    // 'executable', 'c' or 'ir'.
    emit: string
}

// The options of `kojic build <file.kj> [-o <output>] [--emit c|ir]`.
function buildOptions(args: string[]): Build {
    mut source: Option[string] = None
    mut output: Option[string] = None
    mut emit = 'executable'
    mut i = 0

    while (i < args.length()) {
        immut arg = args[i]
        i += 1

        if (arg == '-o' and i < args.length()) {
            output = Some(args[i])
            i += 1
            continue
        }

        // The native backend (compiler/native.kj): machine code without a C compiler, for what it
        // supports yet.
        if (arg == '--native') {
            emit = 'native'
            continue
        }

        if (arg == '--emit') {
            if (i < args.length() and (args[i] == 'c' or args[i] == 'ir')) {
                emit = args[i]
                i += 1
                continue
            }

            printError(`--emit takes 'c' or 'ir'\n\n${usage}`)

            system.exit(2)
        }

        if (source is None and not arg.startsWith('-')) {
            source = Some(arg)
            continue
        }

        printError(usage)

        system.exit(2)
    }

    immut name = match (source) {
        Some(name) => name
        None => {
            printError(usage)
            system.exit(2)
        }
    }
    immut stem = match (path.stem(name)) {
        Some(stem) => stem
        None => ''
    }
    immut chosen = match (output) {
        Some(chosen) => chosen
        None => match (emit) {
            'c' => `${stem}.c`
            'ir' => `${stem}.ir`
            _ => stem
        }
    }
    return { source: name, output: chosen, emit: emit }
}

// The libraries a program needs from the system besides the C library: the mathematics (`math.h`).
// The libraries of the system that programs link: the mathematics of C, and the threads that help
// tasks with the calls that block (in the C library itself on recent systems).
function systemLibraries(): string[] {
    return ['-lm', '-lpthread']
}

function variable(name: string, otherwise: string): string {
    return match (system.env(name)) {
        Some(value) => value
        None => otherwise
    }
}

// A new path in the temporary directory, ending with `extension`: named after the time, with a
// number after it if that name is taken.
function temporary(extension: string): string {
    immut directory = variable('TMPDIR', '/tmp')
    immut unique = string(time.now()).replace('.', '')
    mut name = path.join(directory, `kojic-${unique}${extension}`)
    mut count = 1

    while (file.exists(name)) {
        name = path.join(directory, `kojic-${unique}-${count}${extension}`)
        count += 1
    }

    return name
}

// The runtime library: where KOJI_RUNTIME says, or next to kojic (`bootstrap/build.sh` puts them
// together).
function runtimeLibrary(): Option[string] {
    match (system.env('KOJI_RUNTIME')) {
        Some(runtime) => return Some(runtime)
        None => {}
    }

    immut directory = match (system.executable()) {
        Some(executable) => path.parent(executable)
        None => None
    }

    return match (directory) {
        Some(folder) => {
            immut library = path.join(folder, 'libkoji_runtime.a')
            if (file.exists(library)) { Some(library) } else { None }
        }
        None => None
    }
}

// Compiles the C of a program to `output` with the system's C compiler, linked with the runtime.
function compileC(source: string, output: string, libraries: string[]): Result[void, string] {
    immut runtime = match (runtimeLibrary()) {
        Some(runtime) => runtime
        None => return Err('compile error: the runtime library (libkoji_runtime.a) is not next to kojic: set KOJI_RUNTIME to its path')
    }
    // A file of its own in the temporary directory, removed after.
    immut c = temporary('.c')
    writeFile(c, source)?
    immut compiler = variable('KOJI_CC', 'cc')
    mut args = ['-O2', '-o', output, c, runtime]

    // The libraries of the foreign blocks, then those of the system.
    for library in libraries {
        args.push(`-l${library}`)
    }

    for library in systemLibraries() {
        args.push(library)
    }

    immut result = system.capture(compiler, args)
    file.remove(c)

    return match (result) {
        Ok(run) => {
            if (run.status == 0) {
                Ok()
            } else {
                Err(`compile error: the C compiler '${compiler}' failed:\n${run.stderr.trim()}`)
            }
        }
        Err(_) => Err(`compile error: cannot run the C compiler '${compiler}' (set KOJI_CC to choose another one)`)
    }
}

// The executable of the machine code of the native backend: its object file, linked with the runtime
// by the linker of the system (the C compiler only links: there is no C).
function linkNative(program: IrProgram, output: string): Result[void, string] {
    immut object = match (generateNative(program)) {
        Ok(bytes) => bytes
        Err(message) => return Err(`compile error: ${message}`)
    }
    immut runtime = match (runtimeLibrary()) {
        Some(runtime) => runtime
        None => return Err('compile error: the runtime library (libkoji_runtime.a) is not next to kojic: set KOJI_RUNTIME to its path')
    }
    immut objectPath = temporary('.o')

    match (writeBytes(objectPath, object)) {
        Ok(_) => {}
        Err(message) => return Err(message)
    }

    immut linker = variable('KOJI_CC', 'cc')
    mut args = ['-o', output, objectPath, runtime]

    for library in program.libraries {
        args.push(`-l${library}`)
    }

    for library in systemLibraries() {
        args.push(library)
    }

    immut result = system.capture(linker, args)
    file.remove(objectPath)

    return match (result) {
        Ok(run) => if (run.status == 0) { Ok() } else { Err(`compile error: the linker '${linker}' failed:\n${run.stderr.trim()}`) }
        Err(_) => Err(`compile error: cannot run the linker '${linker}' (set KOJI_CC to choose another one)`)
    }
}

function writeBytes(name: string, bytes: byte[]): Result[void, string] {
    return match (writeBytesTo(name, bytes)) {
        Ok(_) => Ok()
        Err(error) => Err(`compile error: cannot write '${name}': ${ioMessage(error)}`)
    }
}

function writeBytesTo(name: string, bytes: byte[]): Result[void, file.FileError] {
    immut out = file.open(name, file.Write)?
    return out.writeBytes(bytes)
}

// `kojic build`: the executable, the C or the IR of a program.
function build(args: string[]) {
    immut options = buildOptions(args)
    immut program = match (lowered(options.source)) {
        Ok(program) => program
        Err(message) => {
            printError(message)
            system.exit(1)
        }
    }
    immut result = match (options.emit) {
        'ir' => writeFile(options.output, text(programText(program)))
        'c' => writeFile(options.output, text(generate(program)))
        'native' => linkNative(program, options.output)
        _ => compileC(text(generate(program)), options.output, program.libraries)
    }

    match (result) {
        Ok(_) => {}
        Err(message) => {
            printError(message)
            system.exit(1)
        }
    }
}

// `kojic run <file.kj> [arguments]`: compiles the program to a temporary executable, runs it with
// the arguments and the terminal of kojic, and ends with its exit code.
function runProgram(args: string[]) {
    immut program = match (lowered(args[0])) {
        Ok(program) => program
        Err(message) => {
            printError(message)
            system.exit(1)
        }
    }
    immut executable = temporary('')

    match (compileC(text(generate(program)), executable, program.libraries)) {
        Ok(_) => {}
        Err(message) => {
            printError(message)
            system.exit(1)
        }
    }

    immut code = match (system.run(executable, args[1..])) {
        Ok(code) => code
        Err(error) => {
            printError(`cannot run the program: ${error}`)
            1
        }
    }
    file.remove(executable)
    // A program stopped by a signal has no exit code.
    system.exit(if (code < 0) { 1 } else { code })
}

// The `.kj` files of `name`: itself, or those of a directory and its directories (sorted; those
// whose names start with a dot left out).
function sourceFiles(name: string, mut files: string[]) {
    match (file.list(name)) {
        Ok(entries) => {
            for entry in entries {
                if (entry.startsWith('.')) { continue }

                immut inner = path.join(name, entry)

                if (entry.endsWith('.kj')) {
                    if (file.list(inner) is Err) { files.push(inner) }
                } else {
                    if (file.list(inner) is Ok) { sourceFiles(inner, mut files) }
                }
            }
        }
        Err(_) => files.push(name)
    }
}

// Whether a file has tests: `test 'name' { ... }` at its top level (a syntax error is found when
// it is checked).
function hasTests(source: string): boolean {
    match (parser.parse(source)) {
        Ok(statements) => {
            for statement in statements {
                match (unlocatedDeclaration(statement)) {
                    Some(name) => {
                        if (parser.isTestName(name)) { return true }
                    }
                    None => {}
                }
            }

            return false
        }
        Err(_) => return true
    }
}

// The name of a function declared by a statement.
function unlocatedDeclaration(node: parser.Node): Option[string] {
    return match (node.kind) {
        Located(_, inner) => unlocatedDeclaration(inner)
        FunctionDecl(name, _, _, _, _, _) => Some(name)
        _ => None
    }
}

// The name of a test as written, from the name of its function (`test 'it\'s'` is `it's`).
function testDisplay(name: string): string {
    immut chars = name.chars()
    mut text = ''
    mut i = 6

    while (i < chars.length() - 1) {
        mut c = chars[i]

        if (c == '\\' and i + 1 < chars.length() - 1) {
            i += 1
            c = match (chars[i]) {
                'n' => '\n'
                't' => '\t'
                'r' => '\r'
                other => other
            }
        }

        text += string(c)
        i += 1
    }

    return text
}

// A text indented by four spaces, line by line (the line breaks at its end left out).
function indented(text: string): string {
    mut lines: string[] = []

    mut end = text.length()

    while (end > 0 and (text[end - 1] == '\n' or text[end - 1] == '\r')) {
        end -= 1
    }

    for line in text[..end].split('\n') {
        lines.push(`    ${line}`)
    }

    return lines.join('\n')
}

// Seconds with two decimals (`0.25`).
function secondsText(seconds: decimal): string {
    immut hundredths = int(seconds * 100)
    immut rest = hundredths % 100
    return `${hundredths / 100}.${if (rest < 10) { '0' } else { '' }}${rest}`
}

// `kojic test [paths]`: the tests of each file, each in a process of its own (the file's top-level
// statements first, as an import runs them), so that a failure or a panic stops only its test and
// each one starts from the same state. The output of a test is shown when it fails.
function testCommand(args: string[]) {
    immut started = time.monotonic()
    mut files: string[] = []

    immut paths = if (args.length() == 0) { ['.'] } else { args }

    for each in paths {
        sourceFiles(each, mut files)
    }

    mut passed = 0
    mut failed = 0
    mut broken = 0

    for name in files {
        immut source = match (readSource(name)) {
            Ok(text) => text
            Err(error) => {
                print(`FAIL  ${name}: cannot read it: ${ioMessage(error)}`)
                broken += 1
                continue
            }
        }

        if (not hasTests(source)) { continue }

        immut program = match (check(name)) {
            Ok(checked) => lowerTests(checked)
            Err(message) => Err(message)
        }
        immut lowered = match (program) {
            Ok(found) => found
            Err(message) => {
                print(`FAIL  ${name}\n${indented(message)}`)
                broken += 1
                continue
            }
        }
        immut executable = temporary('')

        match (compileC(text(generate(lowered)), executable, lowered.libraries)) {
            Ok(_) => {}
            Err(message) => {
                print(`FAIL  ${name}\n${indented(message)}`)
                broken += 1
                continue
            }
        }

        for i in range(lowered.tests.length()) {
            immut title = `${name}: ${testDisplay(lowered.tests[i].name)}`

            match (system.capture(executable, [string(i)])) {
                Ok(run) => {
                    if (run.status == 0) {
                        print(`ok    ${title}`)
                        passed += 1
                    } else {
                        print(`FAIL  ${title}`)

                        if (run.stderr.trim() != '') { print(indented(run.stderr)) }

                        if (run.stdout.trim() != '') { print(`    output:\n${indented(indented(run.stdout))}`) }

                        if (run.status < 0) { print('    stopped by a signal') }

                        failed += 1
                    }
                }
                Err(error) => {
                    print(`FAIL  ${title}: cannot run it: ${error}`)
                    failed += 1
                }
            }
        }

        file.remove(executable)
    }

    immut seconds = time.monotonic() - started
    mut summary = `${passed} passed, ${failed} failed`

    if (broken > 0) { summary += `, ${broken} ${if (broken == 1) { 'file' } else { 'files' }} not built` }

    if (passed + failed + broken == 0) { summary = 'no tests found' }

    print(`\n${summary} (${secondsText(seconds)} s)`)
    system.exit(if (failed + broken > 0) { 1 } else { 0 })
}

immut args = system.args()
immut command = if (args.length() > 0) { args[0] } else { '' }

if (command == 'test') { testCommand(args[1..]) }

// The commands of packages (compiler/packages.kj).
if (command in ['init', 'add', 'update'] and args.length() <= 2 and (args.length() == 2 or command == 'update')) {
    immut done = match (command) {
        'init' => initModule(args[1])
        'add' => addModule(args[1])
        _ => updateModules(if (args.length() == 2) { Some(args[1]) } else { None })
    }

    match (done) {
        Ok(message) => print(message)
        Err(message) => {
            printError(`package error: ${message}`)
            system.exit(1)
        }
    }

    system.exit(0)
}

if (command == 'lsp' and args.length() == 1) { serve() }

if (command == 'build') {
    build(args[1..])
    system.exit(0)
}

// The C of std/koji/ (but `koji:core`), which bootstrap/build.sh and build.rs compile into the
// runtime library.
if (command == 'dump' and args.length() == 2 and args[1] == 'library') {
    match (checkLibrary()) {
        Ok(program) => {
            match (lower(program)) {
                Ok(lowered) => print(generate(lowered).join('\n'))
                Err(message) => {
                    printError(message)
                    system.exit(1)
                }
            }
        }
        Err(message) => {
            printError(message)
            system.exit(1)
        }
    }

    system.exit(0)
}

if (command == 'dump' and args.length() == 3 and args[1] in ['tokens', 'ast', 'types', 'ir', 'c']) {
    dumpStage(args[1], args[2])
    system.exit(0)
}

if (command == 'check' and args.length() == 2) {
    match (check(args[1])) {
        Ok(_) => system.exit(0)
        Err(message) => {
            printError(message)
            system.exit(1)
        }
    }
}

if (args.length() == 1 and command in ['help', '--help', '-h']) {
    print(usage)
    system.exit(0)
}

if (command == 'run' and args.length() >= 2) { runProgram(args[1..]) }

if (args.length() == 1 and command.endsWith('.kj')) {
    printError(`use 'kojic run ${command}' to run a program\n\n${usage}`)
    system.exit(2)
}

printError(usage)

system.exit(2)
