// The register allocator of the machine IR (mir.kj): linear scan over the ranges of liveness. Each
// virtual register is alive over a range of positions (its instructions in order, each block's
// terminator after them), from the first to the last where it is alive; the ranges are taken by
// their starts, each given a free register of its class: one that calls keep when its value is
// alive across a call (a register of floats then never: none is kept), else one they do not keep
// first. When none is free, the range of those it could take that ends last is spilled to a slot
// of the frame (this one, if it ends after them all).

import { MValue, MAddress, MCallee, MInstruction, MTerminator, MBlock, MFunctionCode } from 'mir.kj'
import { addBit, removeBit, hasBit, bitMembers, liveness } from 'bits.kj'

// The registers of a processor for the allocator (their numbers for its emitter).
export type RegisterSet = {
    // Of words: those calls keep, those they do not.
    kept: int[]
    free: int[]
    // Of floats (calls keep none).
    floats: int[]
    // The registers of the arguments of words, in order (by the convention).
    arguments: int[]
    // Of words that calls do not keep, which the emitter uses itself for some instructions (see
    // `clobbers`): only for the ranges without one of them.
    limited: int[]
}

export type Allocation = {
    // For each virtual register, its register, or -1 when it is in a slot (`spills`).
    registers: int[]
    // For each virtual register in a slot, its number among the slots of spills, or -1.
    spills: int[]
    spillCount: int
    // The registers calls keep that the function uses (it saves them).
    used: int[]
    // The ranges (positions) of the virtual registers, and where each block starts (see
    // `positionOf`).
    first: int[]
    last: int[]
    blockStarts: int[]
}

// The position of the instruction `index` of a block (its terminator after its instructions): odd
// numbers, the even one before the first being where the values alive into the block start (so
// that one alive across a call that comes first has the call inside its range).
export function positionOf(allocation: Allocation, block: int, index: int): int {
    return allocation.blockStarts[block] + 2 * index
}

// The virtual registers an instruction reads and writes.
export function readOf(instruction: MInstruction): int[] {
    mut found: int[] = []

    match (instruction) {
        MMove(_, value) => valueRegister(value, mut found)
        MLoad(_, at, _) => addressRegisters(at, mut found)
        MStore(at, value, _) => {
            addressRegisters(at, mut found)
            valueRegister(value, mut found)
        }
        MAddressOf(_, at) => addressRegisters(at, mut found)
        MBinary(_, _, left, right, _) => {
            valueRegister(left, mut found)
            valueRegister(right, mut found)
        }
        MUnary(_, _, value, _) => valueRegister(value, mut found)
        MSet(_, _, left, right) => {
            valueRegister(left, mut found)
            valueRegister(right, mut found)
        }
        MCall(callee, args, _) => {
            match (callee) {
                MIndirect(value) => valueRegister(value, mut found)
                _ => {}
            }

            for arg in args {
                valueRegister(arg, mut found)
            }
        }
        MPanicIf(_, left, right, _) => {
            valueRegister(left, mut found)
            valueRegister(right, mut found)
        }
        MPreempt => {}
        MPairs(_, _) => {}
        MMachine(_, _, args) => {
            for value in args {
                valueRegister(value, mut found)
            }
        }
        MRetain(value) => valueRegister(value, mut found)
        MRelease(value, _) => valueRegister(value, mut found)
        MWide(_, _, left, right) => {
            for value in left + right {
                valueRegister(value, mut found)
            }
        }
    }

    return found
}

export function writtenBy(instruction: MInstruction): int[] {
    return match (instruction) {
        MMove(dest, _) => [dest]
        MLoad(dest, _, _) => [dest]
        MAddressOf(dest, _) => [dest]
        MBinary(dest, _, _, _, _) => [dest]
        MUnary(dest, _, _, _) => [dest]
        MSet(dest, _, _, _) => [dest]
        MCall(_, _, results) => results
        MWide(dests, _, _, _) => dests
        MMachine(dests, _, _) => dests
        _ => []
    }
}

export function terminatorReads(terminator: MTerminator): int[] {
    mut found: int[] = []

    match (terminator) {
        MBranch(_, left, right, _, _) => {
            valueRegister(left, mut found)
            valueRegister(right, mut found)
        }
        MReturn(values) => {
            for value in values {
                valueRegister(value, mut found)
            }
        }
        MSwitch(value, _, _) => valueRegister(value, mut found)
        _ => {}
    }

    return found
}

export function successorsOf(terminator: MTerminator): int[] {
    return match (terminator) {
        MJump(target) => [target]
        MBranch(_, _, _, thenBlock, elseBlock) => [thenBlock, elseBlock]
        MSwitch(_, targets, otherwise) => targets + [otherwise]
        _ => []
    }
}

function valueRegister(value: MValue, mut found: int[]) {
    match (value) {
        MReg(id) => found.push(id)
        MImm(_) => {}
    }
}

function addressRegisters(at: MAddress, mut found: int[]) {
    match (at) {
        MBase(base, _) => found.push(base)
        MIndexed(base, index, _, _) => {
            found.push(base)
            found.push(index)
        }
        _ => {}
    }
}

export function allocate(code: MFunctionCode, set: RegisterSet): Allocation {
    immut count = code.floats.length()
    immut blocks = code.blocks.length()
    immut words = (count + 63) / 64
    mut empty: int[] = []

    for word in range(words) {
        empty.push(0)
    }

    // The positions: each instruction, then each terminator (odd numbers, from 1).
    mut blockStarts: int[] = []
    mut position = 1

    for block in code.blocks {
        blockStarts.push(position)
        position += 2 * (block.instructions.length() + 1)
    }

    // Liveness over the blocks: read before written in a block, and written there.
    mut reads: int[][] = []
    mut writes: int[][] = []

    for block in code.blocks {
        mut read = empty
        mut written = empty

        for instruction in block.instructions {
            for id in readOf(instruction) {
                if (not hasBit(written, id)) { addBit(mut read, id) }
            }

            for id in writtenBy(instruction) {
                addBit(mut written, id)
            }
        }

        for id in terminatorReads(block.terminator) {
            if (not hasBit(written, id)) { addBit(mut read, id) }
        }

        reads.push(read)
        writes.push(written)
    }

    mut following: int[][] = []

    for block in code.blocks {
        following.push(successorsOf(block.terminator))
    }

    immut alive = liveness(reads, writes, following, words)
    immut liveIn = alive.into
    immut liveOut = alive.out
    // The values alive across a call (read after it, not written by it): backwards over each
    // block from what is alive out of it. Not the calls of cold blocks: they save the registers
    // alive across them. (A range may hold a call where its value is not alive: a result written
    // on another path, a value read only on another.)
    mut across = empty

    for block in range(blocks) {
        if (block < code.cold.length() and code.cold[block]) { continue }

        mut live = liveOut[block]

        for id in terminatorReads(code.blocks[block].terminator) {
            addBit(mut live, id)
        }

        immut instructions = code.blocks[block].instructions
        mut index = instructions.length() - 1

        while (index >= 0) {
            immut instruction = instructions[index]

            for id in writtenBy(instruction) {
                removeBit(mut live, id)
            }

            match (instruction) {
                MCall(_, _, _) => {
                    for word in range(words) {
                        across[word] = across[word] | live[word]
                    }
                }
                _ => {}
            }

            for id in readOf(instruction) {
                addBit(mut live, id)
            }

            index -= 1
        }
    }

    // The ranges, and the positions of the instructions that use the limited registers.
    mut first: int[] = []
    mut last: int[] = []

    for id in range(count) {
        first.push(-1)
        last.push(-1)
    }

    // Alive into or out of blocks: only the first block where each is alive into one, and the
    // last where it is alive out of one, extend its range (one range a register).
    mut met = empty

    for block in range(blocks) {
        mut fresh = empty
        mut any = false

        for word in range(words) {
            fresh[word] = liveIn[block][word] & ~met[word]

            if (fresh[word] != 0) {
                met[word] = met[word] | fresh[word]
                any = true
            }
        }

        if (any) {
            for id in bitMembers(fresh) {
                extend(mut first, mut last, id, blockStarts[block] - 1)
            }
        }
    }

    met = empty
    mut back = blocks - 1

    while (back >= 0) {
        mut fresh = empty
        mut any = false

        for word in range(words) {
            fresh[word] = liveOut[back][word] & ~met[word]

            if (fresh[word] != 0) {
                met[word] = met[word] | fresh[word]
                any = true
            }
        }

        if (any) {
            for id in bitMembers(fresh) {
                extend(mut first, mut last, id, blockStarts[back] + 2 * code.blocks[back].instructions.length())
            }
        }

        back -= 1
    }

    mut clobbered: int[] = []

    for block in range(blocks) {
        immut start = blockStarts[block]
        immut end = start + 2 * code.blocks[block].instructions.length()
        immut instructions = code.blocks[block].instructions

        for index in range(instructions.length()) {
            immut at = start + 2 * index

            for id in readOf(instructions[index]) {
                extend(mut first, mut last, id, at)
            }

            for id in writtenBy(instructions[index]) {
                extend(mut first, mut last, id, at)
            }

            if (clobbers(instructions[index])) { clobbered.push(at) }
        }

        for id in terminatorReads(code.blocks[block].terminator) {
            extend(mut first, mut last, id, end)
        }
    }

    // The parameters are alive from the start.
    for param in code.params {
        extend(mut first, mut last, param, 0)
    }

    // How much each virtual register is used: its reads and writes, ten times as much in a loop
    // (the blocks from the target of a jump back to the jump), a hundred in a loop in a loop...
    mut depth: int[] = []

    for block in range(blocks) {
        depth.push(0)
    }

    for block in range(blocks) {
        for next in successorsOf(code.blocks[block].terminator) {
            if (next <= block) {
                for inside in range(next, block + 1) {
                    depth[inside] += 1
                }
            }
        }
    }

    mut uses: int[] = []

    for id in range(count) {
        uses.push(0)
    }

    for block in range(blocks) {
        immut weight = if (depth[block] == 0) { 1 } else { if (depth[block] == 1) { 10 } else { if (depth[block] == 2) { 100 } else { 1000 } } }

        for instruction in code.blocks[block].instructions {
            for id in readOf(instruction) {
                uses[id] += weight
            }

            for id in writtenBy(instruction) {
                uses[id] += weight
            }
        }

        for id in terminatorReads(code.blocks[block].terminator) {
            uses[id] += weight
        }
    }

    // Hints: a virtual register first written by a copy of another one (or an operation on it)
    // whose range ends there takes its register, when it is free for it (no move then).
    mut hints: int[] = []

    for id in range(count) {
        hints.push(-1)
    }

    for block in range(blocks) {
        immut instructions = code.blocks[block].instructions

        for index in range(instructions.length()) {
            immut at = blockStarts[block] + 2 * index
            immut pair = match (instructions[index]) {
                MMove(dest, MReg(source)) => [dest, source]
                MBinary(dest, _, MReg(source), _, _) => [dest, source]
                MUnary(dest, _, MReg(source), _) => [dest, source]
                _ => []
            }

            if (pair.length() == 2 and first[pair[0]] == at and last[pair[1]] == at and code.floats[pair[0]] == code.floats[pair[1]]) { hints[pair[0]] = pair[1] }
        }
    }

    // Preferences: a parameter its register of the convention, a value read for the last time by a
    // call the register of its argument there (no move then, when it is free). Words only, and not
    // with values of two words about (they shift the registers).
    mut preferred: int[] = []

    for id in range(count) {
        preferred.push(-1)
    }

    if (code.pairs.length() == 0) {
        mut word = 0

        for param in code.params {
            if (code.floats[param]) { continue }

            if (word < set.arguments.length()) { preferred[param] = set.arguments[word] }

            word += 1
        }
    }

    for block in range(blocks) {
        immut instructions = code.blocks[block].instructions

        for index in range(instructions.length()) {
            immut at = blockStarts[block] + 2 * index
            immut paired = index > 0 and match (instructions[index - 1]) {
                MPairs(_, _) => true
                _ => false
            }

            match (instructions[index]) {
                MCall(callee, args, _) if (not paired) => {
                    match (callee) {
                        MVariadic(_, _) => continue
                        _ => {}
                    }

                    mut word = 0

                    for arg in args {
                        match (arg) {
                            MReg(id) if (code.floats[id]) => continue
                            MReg(id) if (last[id] == at and word < set.arguments.length() and preferred[id] < 0) => preferred[id] = set.arguments[word]
                            _ => {}
                        }

                        word += 1
                    }
                }
                _ => {}
            }
        }
    }

    // For each position, how many instructions that use the limited registers are before it.
    immut clobbersBefore = countsBefore(clobbered, position)

    // The ranges by their starts.
    mut order: int[] = []

    for id in range(count) {
        if (first[id] >= 0) { order.push(id) }
    }

    order.sortBy((a, b) => first[a] < first[b])
    mut registers: int[] = []
    mut spills: int[] = []

    for id in range(count) {
        registers.push(-1)
        spills.push(-1)
    }

    mut spillCount = 0
    // The ranges alive, by register: their virtual registers.
    mut active: int[] = []
    mut used: int[] = []

    for id in order {
        // Those that ended free their registers.
        mut still: int[] = []

        for other in active {
            if (last[other] >= first[id]) { still.push(other) }
        }

        active = still
            // A call strictly inside the range (a call reads its arguments before and writes its
        // results after).
        immut crossing = hasBit(across, id)
        immut limited = if (clobbersBefore[last[id] + 1] > clobbersBefore[first[id]]) { [] } else { set.limited }
        immut candidates = if (code.floats[id]) { if (crossing) { [] } else { set.floats } } else { if (crossing) { set.kept } else { set.free + limited + set.kept } }
        mut chosen = -1
        immut hint = hints[id]

        if (hint >= 0 and registers[hint] >= 0 and registers[hint] in candidates and hint in active) {
            chosen = registers[hint]
            mut kept: int[] = []

            for other in active {
                if (other != hint) { kept.push(other) }
            }

            active = kept
        }

        immut wanted = preferred[id]

        if (chosen < 0 and wanted >= 0 and wanted in candidates) {
            mut taken = false

            for other in active {
                if (registers[other] == wanted) { taken = true }
            }

            if (not taken) { chosen = wanted }
        }

        for register in candidates {
            if (chosen >= 0) { break }

            mut taken = false

            for other in active {
                if (registers[other] == register) { taken = true }
            }

            if (not taken) { chosen = register }
        }

        if (chosen < 0) {
            // The range alive in one of the candidates used the least for its length, spilled if
            // this one is used more.
            mut victim = -1

            for other in active {
                if (registers[other] >= 0 and registers[other] in candidates and code.floats[other] == code.floats[id] and (victim < 0 or lighter(other, victim, uses, first, last))) { victim = other }
            }

            if (victim >= 0 and lighter(victim, id, uses, first, last)) {
                chosen = registers[victim]
                registers[victim] = -1
                spills[victim] = spillCount
                spillCount += 1
                mut kept: int[] = []

                for other in active {
                    if (other != victim) { kept.push(other) }
                }

                active = kept
            }
        }

        if (chosen < 0) {
            spills[id] = spillCount
            spillCount += 1
            continue
        }

        registers[id] = chosen
        active.push(id)

        if (chosen in set.kept and not (chosen in used)) { used.push(chosen) }
    }

    return { registers: registers, spills: spills, spillCount: spillCount, used: used, first: first, last: last, blockStarts: blockStarts }
}

// For each position up to `end`, how many of the positions (in order) are before it.
function countsBefore(positions: int[], end: int): int[] {
    mut counts: int[] = [0]
    mut seen = 0
    mut next = 0

    for at in range(end) {
        if (next < positions.length() and positions[next] == at) {
            seen += 1
            next += 1
        }

        counts.push(seen)
    }

    return counts
}

// Whether the emitter uses the limited registers for an instruction (on x86-64, rdx and r11: a
// division, the arithmetic of 128 bits and the instructions of the processor, a call with two
// results or through an address), so that no range across or at it may have them.
function clobbers(instruction: MInstruction): boolean {
    return match (instruction) {
        MBinary(_, op, _, _, _) => op == 'div' or op == 'rem'
        MWide(_, _, _, _) => true
        MMachine(_, _, _) => true
        MCall(MIndirect(_), _, _) => true
        MCall(_, _, results) => results.length() > 1
        _ => false
    }
}

// Whether `a` is used less than `b` for the length of its range (a / la < b / lb).
function lighter(a: int, b: int, uses: int[], first: int[], last: int[]): boolean {
    return uses[a] * (last[b] - first[b] + 1) < uses[b] * (last[a] - first[a] + 1)
}

function extend(mut first: int[], mut last: int[], id: int, at: int) {
    if (first[id] < 0 or at < first[id]) { first[id] = at }

    if (at > last[id]) { last[id] = at }
}




// The virtual registers in registers that calls do not keep, met in the order of the positions
// where they start, for the registers alive at each call (the positions only grow as the code is
// emitted: see `liveAt`).
export type LiveSweep = {
    order: int[]
    next: int
    active: int[]
    at: int
}

// `free`: the registers calls do not keep among those the allocator gives; `floats`: the first
// register of floats (none is kept).
export function sweepOf(allocation: Allocation, free: int[], floats: int): LiveSweep {
    mut end = 0

    for id in range(allocation.registers.length()) {
        if (allocation.first[id] + 1 > end) { end = allocation.first[id] + 1 }
    }

    mut counts: int[] = []

    for i in range(end + 1) {
        counts.push(0)
    }

    mut chosen: int[] = []

    for id in range(allocation.registers.length()) {
        immut register = allocation.registers[id]

        if (register < 0 or allocation.first[id] < 0) { continue }

        if (register in free or register >= floats) {
            chosen.push(id)
            counts[allocation.first[id] + 1] += 1
        }
    }

    for i in range(end) {
        counts[i + 1] += counts[i]
    }

    mut order: int[] = []

    for id in chosen {
        order.push(0)
    }

    for id in chosen {
        order[counts[allocation.first[id]]] = id
        counts[allocation.first[id]] += 1
    }

    return { order: order, next: 0, active: [], at: -1 }
}

// The registers that calls do not keep and that hold a value alive at `position` (with `across`,
// one alive before it and after it: not one a call there reads for the last time or writes).
export function liveAt(mut sweep: LiveSweep, allocation: Allocation, position: int, across: boolean): int[] {
    // From the start again should a position come before the last.
    if (position < sweep.at) {
        sweep.next = 0
        sweep.active = []
    }

    sweep.at = position

    while (sweep.next < sweep.order.length() and allocation.first[sweep.order[sweep.next]] <= position) {
        sweep.active.push(sweep.order[sweep.next])
        sweep.next += 1
    }

    mut kept: int[] = []
    mut saved: int[] = []

    for id in sweep.active {
        if (allocation.last[id] < position) { continue }

        kept.push(id)

        if (across and (allocation.first[id] >= position or allocation.last[id] <= position)) { continue }

        immut register = allocation.registers[id]

        if (not (register in saved)) { saved.push(register) }
    }

    sweep.active = kept
    return saved
}
