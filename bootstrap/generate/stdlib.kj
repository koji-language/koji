// Writes compiler/stdlib.kj, the sources of the modules of the standard library written in Koji
// (std/*.kj, and the internal ones of std/koji/), which the compiler carries. Run from the root:
//
//     build/kojic run bootstrap/generate/stdlib.kj > compiler/stdlib.kj
//
// test/stages.kj checks that compiler/stdlib.kj is what this writes. (A compiler built before a
// change of std/ carries the modules as they were: build it again after writing this.)

import file
import system

// The names of the .kj files of a directory, without their extension, in order.
function modules(directory: string): string[] {
    mut names: string[] = []

    match (file.list(directory)) {
        Ok(found) => {
            for name in found {
                if (name.endsWith('.kj')) { names.push(name[0..name.length() - 3]) }
            }
        }
        Err(error) => panic(`${directory}: ${error}`)
    }

    return names
}

function readFile(source: string): string {
    return match (file.open(source, file.Read)) {
        Ok(opened) => match (opened.read()) {
            Ok(text) => text
            Err(error) => panic(`${source}: ${error}`)
        }
        Err(error) => panic(`${source}: ${error}`)
    }
}

immut names = modules('std')
mut internal: string[] = []

for name in modules('std/koji') {
    internal.push(`koji:${name}`)
}

mut quoted: string[] = []

for name in names {
    quoted.push(`'${name}'`)
}

mut text = '// The modules of the standard library written in Koji (std/), which the compiler carries: `import\n'
text += '// json` compiles std/json.kj. Generated by bootstrap/generate/stdlib.kj (do not edit), which\n'
text += '// test/stages.kj checks.\n\n'
text += `export immut kojiModules = [${quoted.join(', ')}]\n\n`
// The internal modules (std/koji/), which programs cannot import: `koji:core` is std/koji/core.kj,
// which the compiler calls for some built-in methods.
text += '// The source of the module `name` of the standard library (`koji:core` for an internal one).\n'
text += 'export function stdSource(name: string): Option[string] {\n'

for name in names + internal {
    immut source = if (name.startsWith('koji:')) { `std/koji/${name[5..]}.kj` } else { `std/${name}.kj` }
    text += `    if (name == '${name}') {\n        return Some([\n`
    mut lines = readFile(source).split('\n')

    // The lines of the file: none after its last line break.
    if (lines.length() > 0 and lines[lines.length() - 1] == '') { lines.pop() }

    for line in lines {
        text += `            '${line.replace('\\', '\\\\').replace('\'', '\\\'')}',\n`
    }

    text += '        ].join(\'\\n\'))\n    }\n\n'
}

text += '    return None\n}\n'
system.writeOutput(text)
